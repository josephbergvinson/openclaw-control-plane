+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn source_preserving_turn_allows_host_writes_and_keeps_source_across_bounded_tool_growth()
+-> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let server = responses::start_mock_server().await;
+    let captured = responses::mount_sse_sequence(
+        &server,
+        vec![
+            responses::sse(vec![
+                responses::ev_function_call(
+                    "note-call",
+                    "memory_write",
+                    r#"{"note":"durable note"}"#,
+                ),
+                responses::ev_completed("write-response"),
+            ]),
+            responses::sse(vec![
+                responses::ev_assistant_message("answer", "saved"),
+                responses::ev_completed("final-response"),
+            ]),
+        ],
+    )
+    .await;
+    let test = test_codex()
+        .with_model_info_override("gpt-5.5", |model| {
+            model.truncation_policy = TruncationPolicyConfig::tokens(/*limit*/ 50);
+        })
+        .build_with_auto_env(&server)
+        .await?;
+    let thread = test.thread_manager.start_thread(StartThreadOptions {
+        dynamic_tools: vec![DynamicToolSpec::Function(DynamicToolFunctionSpec {
+            name: "memory_write".into(),
+            description: "Persist one note in the confined fixture.".into(),
+            input_schema: json!({"type":"object","properties":{"note":{"type":"string"}},"required":["note"]}),
+            defer_loading: false,
+        })],
+        ..StartThreadOptions::new(test.config.clone())
+    }).await?.thread;
+    let source =
+        r#"Original detached history and exact tool arguments: {"private":"original evidence"}"#;
+    thread.start_or_steer_turn(source_request(source)).await?;
+    let EventMsg::DynamicToolCallRequest(call) = wait_for_event(&thread, |event| {
+        matches!(event, EventMsg::DynamicToolCallRequest(_))
+    })
+    .await
+    else {
+        unreachable!("predicate guarantees dynamic call");
+    };
+    assert_eq!(
+        (call.tool.as_str(), &call.arguments),
+        ("memory_write", &json!({"note":"durable note"}))
+    );
+    let note = test.cwd_path().join("memory-note.txt");
+    std::fs::write(
+        &note,
+        call.arguments["note"].as_str().expect("note argument"),
+    )?;
+    let output = "new explicitly bounded tool output ".repeat(400);
+    thread
+        .submit(Op::DynamicToolResponse {
+            id: call.call_id,
+            response: DynamicToolResponse {
+                content_items: vec![DynamicToolCallOutputContentItem::InputText {
+                    text: output.clone(),
+                }],
+                success: true,
+            },
+        })
+        .await?;
+    wait_for_event(&thread, |event| matches!(event, EventMsg::TurnComplete(_))).await;
+    assert_eq!(std::fs::read_to_string(note)?, "durable note");
+    let requests = captured.requests();
+    assert_eq!(requests.len(), 2);
+    for (index, request) in requests.iter().enumerate() {
+        let body = request.body_json();
+        assert!(request.body_contains_text(source));
+        let fact: serde_json::Value = serde_json::from_str(
+            body["client_metadata"][FACT_KEY]
+                .as_str()
+                .expect("prepared fact"),
+        )?;
+        assert_eq!(fact["effectsStarted"], index > 0);
+    }
+    let returned_output = requests[1].function_call_output("note-call").to_string();
+    assert!(returned_output.len() < output.len());
+    assert!(!returned_output.contains(&output));
+    Ok(())
+}

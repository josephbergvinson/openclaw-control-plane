+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn source_preserving_websocket_startup_skips_warmup_and_measures_complete_continuation()
+-> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let server = responses::start_websocket_server(vec![vec![
+        vec![
+            responses::ev_response_created("first"),
+            responses::ev_completed("first"),
+        ],
+        vec![
+            responses::ev_response_created("second"),
+            responses::ev_completed("second"),
+        ],
+    ]])
+    .await;
+    let test = test_codex()
+        .with_config(|config| {
+            config
+                .responses_api_metadata
+                .insert(REQUEST_KEY.into(), "1".into());
+        })
+        .build_with_websocket_server(&server)
+        .await?;
+    let source = "complete retained first source ".repeat(100);
+    for text in [source.as_str(), "additional evidence"] {
+        test.codex.start_or_steer_turn(source_request(text)).await?;
+        wait_for_event(&test.codex, |event| {
+            matches!(event, EventMsg::TurnComplete(_))
+        })
+        .await;
+    }
+    let requests = server.single_connection();
+    assert_eq!(requests.len(), 2);
+    let mut pressure = Vec::new();
+    for request in &requests {
+        let body = request.body_json();
+        assert_ne!(body["generate"], false);
+        assert!(body["previous_response_id"].is_null());
+        assert!(body["input"].to_string().contains(source.trim()));
+        let fact: serde_json::Value = serde_json::from_str(
+            body["client_metadata"][FACT_KEY]
+                .as_str()
+                .expect("native fact on every generation"),
+        )?;
+        pressure.push(
+            fact["estimatedRequestTokens"]
+                .as_u64()
+                .expect("native pressure"),
+        );
+    }
+    assert!(
+        requests[1].body_json()["input"]
+            .to_string()
+            .contains("additional evidence")
+    );
+    assert!(pressure[1] > pressure[0]);
+    server.shutdown().await;
+    Ok(())
+}

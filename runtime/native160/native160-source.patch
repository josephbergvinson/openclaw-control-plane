+const REQUEST_KEY: &str = "openclaw_source_preserving_input_v1";
+const FACT_KEY: &str = "openclaw_prepared_input_v1";
+
+fn source_request(text: &str) -> TurnInputRequest {
+    let metadata = HashMap::from([
+        (FACT_KEY.to_owned(), "forged budget".to_owned()),
+        (REQUEST_KEY.to_owned(), "1".to_owned()),
+    ]);
+    TurnInputRequest::user_input(vec![UserInput::Text {
+        text: text.to_owned(),
+        text_elements: Vec::new(),
+    }])
+    .with_responses_metadata(Some(metadata))
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn source_preserving_turn_reports_native_window_and_hook_effects_without_changing_source()
+-> Result<()> {
+    skip_if_no_network!(Ok(()));
+    for with_hook in [false, true] {
+        let server = responses::start_mock_server().await;
+        let captured = responses::mount_sse_once(
+            &server,
+            responses::sse(vec![
+                responses::ev_response_created("source-preserving-response"),
+                responses::ev_assistant_message("answer", "done"),
+                responses::ev_completed("source-preserving-response"),
+            ]),
+        )
+        .await;
+        let test = test_codex()
+            .with_model_info_override("gpt-5.5", |model| {
+                model.context_window = Some(20_000);
+                model.max_context_window = Some(20_000);
+                model.effective_context_window_percent = 95;
+            })
+            .with_pre_build_hook(move |home| {
+                if with_hook {
+                    std::fs::write(home.join("hooks.json"), json!({"hooks":{"UserPromptSubmit":[{"hooks":[{"type":"command","command":"echo native-hook-ran"}]}]}}).to_string()).expect("private fixture hook");
+                }
+            })
+            .with_config(move |config| {
+                if with_hook {
+                    trust_discovered_hooks(config);
+                }
+            })
+            // Command hooks run on the host and require a host-native directory.
+            .build(&server).await?;
+        let source = r#"Retained tool call arguments: {"path":"actual/private/source","value":"keep exactly"}"#;
+        test.codex
+            .start_or_steer_turn(source_request(source))
+            .await?;
+        wait_for_event(&test.codex, |event| {
+            matches!(event, EventMsg::TurnComplete(_))
+        })
+        .await;
+        let body = captured.single_request().body_json();
+        let fact: serde_json::Value = serde_json::from_str(
+            body["client_metadata"][FACT_KEY]
+                .as_str()
+                .expect("native prepared fact"),
+        )?;
+        assert_eq!(
+            (
+                fact["v"].clone(),
+                fact["model"].clone(),
+                fact["provider"].clone()
+            ),
+            (
+                json!(1),
+                json!("gpt-5.5"),
+                json!(test.config.model_provider_id)
+            )
+        );
+        assert_eq!(
+            (
+                fact["usableContextWindow"].clone(),
+                fact["nativeHeadroomTokens"].clone(),
+                fact["effectsStarted"].clone()
+            ),
+            (json!(19_000), json!(1_000), json!(with_hook))
+        );
+        assert!(
+            fact["estimatedRequestTokens"]
+                .as_u64()
+                .is_some_and(|tokens| tokens > 0)
+        );
+        assert!(body["input"].as_array().expect("input").iter().any(|item| {
+            item["content"].as_array().is_some_and(|content| {
+                content
+                    .iter()
+                    .any(|part| part["text"].as_str() == Some(source))
+            })
+        }));
+        assert!(!body.to_string().contains("forged budget"));
+    }
+    Ok(())
+}

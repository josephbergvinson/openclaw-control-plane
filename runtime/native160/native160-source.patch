+use super::*;
+use crate::responses_metadata::filter_extra_metadata;
+use codex_protocol::models::ContentItem;
+use codex_protocol::models::ResponseItem;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+use std::collections::HashMap;
+
+fn model() -> ModelInfo {
+    let mut model = codex_models_manager::bundled_models_response()
+        .expect("bundled catalog")
+        .models
+        .into_iter()
+        .find(|model| model.slug == "gpt-5.5")
+        .expect("bundled test model");
+    model.context_window = Some(20_000);
+    model.max_context_window = Some(20_000);
+    model.effective_context_window_percent = 95;
+    model.used_fallback_model_metadata = false;
+    model
+}
+
+fn metadata() -> CodexResponsesMetadata {
+    let mut metadata = CodexResponsesMetadata::new(
+        "installation".into(),
+        "session".into(),
+        "thread".into(),
+        "window".into(),
+    );
+    metadata.extra.insert(REQUEST_KEY.into(), "1".into());
+    metadata.source_preserving_input = Some(SourcePreservingContext {
+        provider: "configured-provider".into(),
+        effects_started: false,
+    });
+    metadata
+}
+
+fn request() -> ResponsesApiRequest {
+    let tools: std::sync::Arc<serde_json::value::RawValue> = serde_json::value::to_raw_value(
+        &json!([{"type":"function","name":"read","parameters":{"type":"object","properties":{"path":{"type":"string"}}}}]),
+    ).expect("tool schema").into();
+    ResponsesApiRequest {
+        model: "gpt-5.5".into(),
+        instructions: "native instructions".into(),
+        input: vec![ResponseItem::Message {
+            id: None,
+            role: "user".into(),
+            content: vec![ContentItem::InputText {
+                text: "complete source".into(),
+            }],
+            phase: None,
+            internal_chat_message_metadata_passthrough: None,
+        }],
+        tools: Some(tools.into()),
+        tool_choice: "auto".into(),
+        parallel_tool_calls: true,
+        reasoning: None,
+        store: false,
+        stream: true,
+        stream_options: None,
+        include: Vec::new(),
+        service_tier: None,
+        prompt_cache_key: None,
+        text: codex_api::create_text_param_for_request(
+            /*verbosity*/ None,
+            &Some(json!({"type":"object"})),
+            /*output_schema_strict*/ true,
+        ),
+        client_metadata: None,
+        access_programs: None,
+    }
+}
+
+#[test]
+fn native_fact_covers_real_selected_window_and_complete_request_without_rewriting() {
+    let mut request = request();
+    let original = serde_json::to_value(&request).unwrap();
+    prepare_request(&mut request, &model(), &metadata()).unwrap();
+    let fact: serde_json::Value =
+        serde_json::from_str(&request.client_metadata.take().unwrap()[FACT_KEY]).unwrap();
+    assert_eq!(fact["v"], 1);
+    assert_eq!(fact["model"], "gpt-5.5");
+    assert_eq!(fact["provider"], "configured-provider");
+    assert_eq!(fact["usableContextWindow"], 19_000);
+    assert_eq!(fact["nativeHeadroomTokens"], 1_000);
+    assert_eq!(fact["effectsStarted"], false);
+    assert!(fact["estimatedRequestTokens"].as_u64().unwrap() > 0);
+    assert_eq!(serde_json::to_value(request).unwrap(), original);
+}
+
+#[test]
+fn measured_pressure_includes_instructions_and_retained_input_values() {
+    let mut baseline = request();
+    prepare_request(&mut baseline, &model(), &metadata()).unwrap();
+    let baseline_fact: serde_json::Value =
+        serde_json::from_str(&baseline.client_metadata.unwrap()[FACT_KEY]).unwrap();
+    for change in ["instructions", "input", "tools", "schema"] {
+        let mut changed = request();
+        match change {
+            "instructions" => changed.instructions.push_str(&"native policy ".repeat(100)),
+            "input" => changed.input.push(ResponseItem::Message {
+                id: None,
+                role: "user".into(),
+                content: vec![ContentItem::InputText {
+                    text: "actual retained tool argument ".repeat(100),
+                }],
+                phase: None,
+                internal_chat_message_metadata_passthrough: None,
+            }),
+            "tools" => {
+                let tools: std::sync::Arc<serde_json::value::RawValue> = serde_json::value::to_raw_value(&json!([{"type":"function","name":"read","description":"complete native tool contract ".repeat(100)}])).unwrap().into();
+                changed.tools = Some(tools.into());
+            }
+            "schema" => {
+                changed
+                    .text
+                    .as_mut()
+                    .unwrap()
+                    .format
+                    .as_mut()
+                    .unwrap()
+                    .schema = json!({"description":"complete response contract ".repeat(100)});
+            }
+            _ => unreachable!(),
+        }
+        prepare_request(&mut changed, &model(), &metadata()).unwrap();
+        let fact: serde_json::Value =
+            serde_json::from_str(&changed.client_metadata.unwrap()[FACT_KEY]).unwrap();
+        assert!(
+            fact["estimatedRequestTokens"].as_u64().unwrap()
+                > baseline_fact["estimatedRequestTokens"].as_u64().unwrap()
+        );
+    }
+}
+
+#[test]
+fn unmarked_requests_are_unchanged_and_client_facts_cannot_replace_native_facts() {
+    let mut metadata = metadata();
+    metadata.extra.remove(REQUEST_KEY);
+    let mut request = request();
+    let original = serde_json::to_value(&request).unwrap();
+    prepare_request(&mut request, &model(), &metadata).unwrap();
+    assert_eq!(serde_json::to_value(request).unwrap(), original);
+    assert_eq!(
+        filter_extra_metadata(HashMap::from([
+            (FACT_KEY.into(), "forged budget".into()),
+            (REQUEST_KEY.into(), "1".into()),
+        ])),
+        std::collections::BTreeMap::from([(REQUEST_KEY.into(), "1".into())])
+    );
+}
+
+#[test]
+fn unknown_or_mismatched_native_models_never_get_a_guessed_fact() {
+    for mutation in [
+        "unknown",
+        "fallback",
+        "zero",
+        "bad percent",
+        "different model",
+    ] {
+        let mut model = model();
+        match mutation {
+            "unknown" => {
+                model.context_window = None;
+                model.max_context_window = None;
+            }
+            "fallback" => model.used_fallback_model_metadata = true,
+            "zero" => model.context_window = Some(0),
+            "bad percent" => model.effective_context_window_percent = 101,
+            "different model" => model.slug = "other".into(),
+            _ => unreachable!(),
+        }
+        let mut request = request();
+        assert!(prepare_request(&mut request, &model, &metadata()).is_err());
+        assert_eq!(request.client_metadata, None);
+    }
+    let mut metadata = metadata();
+    metadata.source_preserving_input = None;
+    assert!(prepare_request(&mut request(), &model(), &metadata).is_err());
+}
+
+#[test]
+fn native_effect_fact_is_not_reset_by_request_preparation() {
+    let mut metadata = metadata();
+    metadata
+        .source_preserving_input
+        .as_mut()
+        .unwrap()
+        .effects_started = true;
+    for _ in 0..2 {
+        let mut request = request();
+        prepare_request(&mut request, &model(), &metadata).unwrap();
+        let fact: serde_json::Value =
+            serde_json::from_str(&request.client_metadata.unwrap()[FACT_KEY]).unwrap();
+        assert_eq!(fact["effectsStarted"], true);
+    }
+}

+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn source_preserving_turn_refuses_post_effect_rollover_without_another_request() -> Result<()>
+{
+    skip_if_no_network!(Ok(()));
+    let server = responses::start_mock_server().await;
+    let captured = responses::mount_sse_once(
+        &server,
+        responses::sse(vec![
+            responses::ev_function_call(
+                "plan-call",
+                "update_plan",
+                r#"{"plan":[{"step":"retained action","status":"completed"}]}"#,
+            ),
+            responses::ev_completed_with_tokens("acted-response", 1_000),
+        ]),
+    )
+    .await;
+    let test = test_codex()
+        .with_config(|config| {
+            config.update_plan_enabled = true;
+        })
+        .with_model_info_override("gpt-5.5", |model| {
+            model.auto_compact_token_limit = Some(100);
+        })
+        .build_with_auto_env(&server)
+        .await?;
+    let source = "complete original evidence before action";
+    test.codex
+        .start_or_steer_turn(source_request(source))
+        .await?;
+    let EventMsg::PlanUpdate(update) = wait_for_event(&test.codex, |event| {
+        matches!(event, EventMsg::PlanUpdate(_))
+    })
+    .await
+    else {
+        unreachable!()
+    };
+    assert_eq!(update.plan[0].step, "retained action");
+    let EventMsg::Error(error) =
+        wait_for_event(&test.codex, |event| matches!(event, EventMsg::Error(_))).await
+    else {
+        unreachable!()
+    };
+    assert!(error.message.contains("cannot automatically rewrite"));
+    let EventMsg::TurnComplete(completed) = wait_for_event(&test.codex, |event| {
+        matches!(event, EventMsg::TurnComplete(_))
+    })
+    .await
+    else {
+        unreachable!()
+    };
+    assert!(
+        completed.error.is_some(),
+        "the refused turn must finish as failed"
+    );
+    assert!(captured.single_request().body_contains_text(source));
+    assert_eq!(captured.requests().len(), 1);
+    Ok(())
+}

diff --git a/codex-rs/state/tests/copied_store_rehearsal.rs b/codex-rs/state/tests/copied_store_rehearsal.rs
new file mode 100644
index 00000000..ad3712ca
--- /dev/null
+++ b/codex-rs/state/tests/copied_store_rehearsal.rs
@@ -0,0 +1,680 @@
+//! Explicit qualification of copies admitted by the existing snapshot/rehearsal owner.
+//! This test never starts an app-server, reads default homes, or copies/restores state.
+
+use anyhow::Context;
+use anyhow::Result;
+use anyhow::ensure;
+use codex_state::SqliteConfig;
+use codex_state::StateRuntime;
+use codex_state::open_thread_history_db;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use serde::Deserialize;
+use serde::Serialize;
+use sha2::Digest;
+use sha2::Sha256;
+use sqlx::Connection;
+use sqlx::Row;
+use sqlx::SqliteConnection;
+use sqlx::sqlite::SqliteConnectOptions;
+use std::collections::BTreeMap;
+use std::collections::BTreeSet;
+use std::fs;
+use std::fs::File;
+use std::fs::OpenOptions;
+use std::io::Read;
+use std::io::Write;
+use std::path::Path;
+use std::path::PathBuf;
+
+const DESCRIPTOR_ENV: &str = "CODEX_STATE_REHEARSAL_DESCRIPTOR";
+const MAX_DESCRIPTOR_BYTES: u64 = 256 * 1024;
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct Descriptor {
+    schema_version: u32,
+    candidate_source_commit: String,
+    baseline_snapshot: FileReference,
+    native_projection_receipt: FileReference,
+    copied_state_root: PathBuf,
+    copy_identity: PhysicalIdentity,
+    expected_home_ids: BTreeSet<String>,
+    homes: Vec<Home>,
+    receipt_path: PathBuf,
+}
+
+#[derive(Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct FileReference {
+    path: PathBuf,
+    sha256: String,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct ProjectionReceipt {
+    schema_version: u32,
+    operation: String,
+    candidate_source_commit: String,
+    baseline_snapshot: FileReference,
+    result: ProjectionResult,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct ProjectionResult {
+    state_dir: PathBuf,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct Home {
+    id: String,
+    copied_codex_home: PathBuf,
+    copied_sqlite_home: PathBuf,
+    original_codex_home: PathBuf,
+    original_sqlite_home: PathBuf,
+    codex_home_identity: PhysicalIdentity,
+    sqlite_home_identity: PhysicalIdentity,
+    original_codex_home_identity: PhysicalIdentity,
+    original_sqlite_home_identity: PhysicalIdentity,
+    provider_label: String,
+    families: Vec<FamilyInput>,
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, Serialize, PartialEq, Eq, PartialOrd, Ord)]
+enum Family {
+    #[serde(rename = "state_5.sqlite")]
+    State,
+    #[serde(rename = "logs_2.sqlite")]
+    Logs,
+    #[serde(rename = "goals_1.sqlite")]
+    Goals,
+    #[serde(rename = "memories_1.sqlite")]
+    Memories,
+    #[serde(rename = "memories_v2_1.sqlite")]
+    MemoriesV2,
+    #[serde(rename = "queue_1.sqlite")]
+    Queue,
+    #[serde(rename = "thread_history_1.sqlite")]
+    History,
+}
+
+impl Family {
+    const ALL: [Self; 7] = [
+        Self::State,
+        Self::Logs,
+        Self::Goals,
+        Self::Memories,
+        Self::MemoriesV2,
+        Self::Queue,
+        Self::History,
+    ];
+
+    fn filename(self) -> &'static str {
+        match self {
+            Self::State => "state_5.sqlite",
+            Self::Logs => "logs_2.sqlite",
+            Self::Goals => "goals_1.sqlite",
+            Self::Memories => "memories_1.sqlite",
+            Self::MemoriesV2 => "memories_v2_1.sqlite",
+            Self::Queue => "queue_1.sqlite",
+            Self::History => "thread_history_1.sqlite",
+        }
+    }
+
+    fn latest_version(self) -> i64 {
+        match self {
+            Self::State => 58,
+            Self::Logs | Self::Goals | Self::Memories | Self::MemoriesV2 | Self::Queue => 2,
+            Self::History => 7,
+        }
+    }
+
+    fn is_eager(self) -> bool {
+        !matches!(self, Self::MemoriesV2 | Self::History)
+    }
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct FamilyInput {
+    name: Family,
+    existed_in_baseline: bool,
+    files: Vec<FileFact>,
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, PartialEq, Eq, PartialOrd, Ord)]
+enum FileSuffix {
+    #[serde(rename = "main")]
+    Main,
+    #[serde(rename = "-wal")]
+    Wal,
+    #[serde(rename = "-shm")]
+    Shm,
+}
+
+impl FileSuffix {
+    fn value(self) -> &'static str {
+        match self {
+            Self::Main => "",
+            Self::Wal => "-wal",
+            Self::Shm => "-shm",
+        }
+    }
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct FileFact {
+    suffix: FileSuffix,
+    exists: bool,
+    bytes: Option<u64>,
+    sha256: Option<String>,
+    identity: Option<PhysicalIdentity>,
+    mode: Option<u32>,
+}
+
+#[derive(Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct PhysicalIdentity {
+    device: u64,
+    inode: u64,
+    owner_uid: u32,
+}
+
+fn physical_identity(metadata: &fs::Metadata) -> Result<PhysicalIdentity> {
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::MetadataExt;
+        Ok(PhysicalIdentity {
+            device: metadata.dev(),
+            inode: metadata.ino(),
+            owner_uid: metadata.uid(),
+        })
+    }
+    #[cfg(not(unix))]
+    {
+        let _ = metadata;
+        anyhow::bail!("this explicit rehearsal requires Unix physical file identities");
+    }
+}
+
+fn physical_directory(path: &Path, expected: &PhysicalIdentity) -> Result<()> {
+    let metadata = fs::symlink_metadata(path)?;
+    ensure!(
+        metadata.is_dir() && !metadata.file_type().is_symlink(),
+        "directory is not physical"
+    );
+    ensure!(
+        path.is_absolute() && fs::canonicalize(path)? == path,
+        "directory path is not canonical"
+    );
+    ensure!(
+        physical_identity(&metadata)? == *expected,
+        "directory identity changed"
+    );
+    Ok(())
+}
+
+fn confined_path(root: &Path, path: &Path) -> Result<()> {
+    ensure!(
+        path != root && path.starts_with(root),
+        "path escapes admitted copy root"
+    );
+    let parent = path.parent().context("path has no parent")?;
+    ensure!(
+        fs::canonicalize(parent)? == parent,
+        "path has a nonphysical parent"
+    );
+    Ok(())
+}
+
+fn file_sha256(path: &Path) -> Result<String> {
+    let metadata = fs::symlink_metadata(path)?;
+    ensure!(
+        metadata.is_file() && !metadata.file_type().is_symlink(),
+        "hash input is not a physical file"
+    );
+    let mut file = File::open(path)?;
+    ensure!(
+        physical_identity(&file.metadata()?)? == physical_identity(&metadata)?,
+        "hash input identity changed"
+    );
+    let mut hash = Sha256::new();
+    let mut buffer = [0_u8; 64 * 1024];
+    loop {
+        let count = file.read(&mut buffer)?;
+        if count == 0 {
+            break;
+        }
+        hash.update(&buffer[..count]);
+    }
+    Ok(format!("{:x}", hash.finalize()))
+}
+
+fn check_reference(reference: &FileReference) -> Result<()> {
+    ensure!(
+        reference.path.is_absolute(),
+        "owner reference is not absolute"
+    );
+    ensure!(
+        reference.sha256.len() == 64 && reference.sha256.bytes().all(|c| c.is_ascii_hexdigit()),
+        "owner reference hash is malformed"
+    );
+    ensure!(
+        file_sha256(&reference.path)? == reference.sha256,
+        "owner reference bytes changed"
+    );
+    Ok(())
+}
+
+fn check_file_fact(root: &Path, path: &Path, fact: &FileFact) -> Result<()> {
+    confined_path(root, path)?;
+    if !fact.exists {
+        ensure!(
+            fact.bytes.is_none()
+                && fact.sha256.is_none()
+                && fact.identity.is_none()
+                && fact.mode.is_none(),
+            "absent file carries present-file facts"
+        );
+        ensure!(
+            !path.try_exists()? && fs::symlink_metadata(path).is_err(),
+            "baseline-absent file appeared"
+        );
+        return Ok(());
+    }
+    let metadata = fs::symlink_metadata(path)?;
+    ensure!(
+        metadata.is_file() && !metadata.file_type().is_symlink(),
+        "copied database file is not physical"
+    );
+    ensure!(
+        Some(metadata.len()) == fact.bytes,
+        "copied database size changed"
+    );
+    ensure!(
+        fact.identity.as_ref() == Some(&physical_identity(&metadata)?),
+        "copied database identity changed"
+    );
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::MetadataExt;
+        ensure!(
+            metadata.nlink() == 1,
+            "copied database has a shared hard link"
+        );
+        ensure!(
+            Some(metadata.mode()) == fact.mode,
+            "copied database mode changed"
+        );
+    }
+    ensure!(
+        fact.sha256.as_ref() == Some(&file_sha256(path)?),
+        "copied database bytes changed"
+    );
+    Ok(())
+}
+
+fn validate_descriptor(descriptor: &Descriptor) -> Result<()> {
+    ensure!(
+        descriptor.schema_version == 1,
+        "unsupported descriptor schema"
+    );
+    ensure!(
+        descriptor.candidate_source_commit.len() == 40
+            && descriptor
+                .candidate_source_commit
+                .bytes()
+                .all(|c| c.is_ascii_hexdigit()),
+        "source commit is malformed"
+    );
+    check_reference(&descriptor.baseline_snapshot)?;
+    check_reference(&descriptor.native_projection_receipt)?;
+    ensure!(
+        fs::metadata(&descriptor.native_projection_receipt.path)?.len() <= MAX_DESCRIPTOR_BYTES,
+        "native projection receipt is too large"
+    );
+    let projection: ProjectionReceipt =
+        serde_json::from_slice(&fs::read(&descriptor.native_projection_receipt.path)?)?;
+    ensure!(
+        projection.schema_version == 1 && projection.operation == "prepareUpdateCandidateRehearsal",
+        "wrong native projection owner"
+    );
+    ensure!(
+        projection.candidate_source_commit == descriptor.candidate_source_commit
+            && projection.baseline_snapshot == descriptor.baseline_snapshot,
+        "projection baseline/source binding changed"
+    );
+    ensure!(
+        projection.result.state_dir == descriptor.copied_state_root,
+        "projection does not own copied state root"
+    );
+    physical_directory(&descriptor.copied_state_root, &descriptor.copy_identity)?;
+    ensure!(
+        !descriptor.expected_home_ids.is_empty()
+            && descriptor.homes.len() == descriptor.expected_home_ids.len(),
+        "home inventory is incomplete"
+    );
+    let mut ids = BTreeSet::new();
+    let mut homes = BTreeSet::new();
+    let mut originals = Vec::new();
+    for home in &descriptor.homes {
+        ensure!(
+            !home.id.is_empty()
+                && home.id.len() <= 128
+                && home
+                    .id
+                    .bytes()
+                    .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'-' | b'_' | b'.')),
+            "home identifier is not value-free"
+        );
+        ensure!(ids.insert(home.id.clone()), "duplicate home identity");
+        ensure!(
+            !home.provider_label.is_empty(),
+            "original provider label is missing"
+        );
+        for (path, identity) in [
+            (
+                &home.original_codex_home,
+                &home.original_codex_home_identity,
+            ),
+            (
+                &home.original_sqlite_home,
+                &home.original_sqlite_home_identity,
+            ),
+        ] {
+            physical_directory(path, identity)?;
+            ensure!(
+                !path.starts_with(&descriptor.copied_state_root)
+                    && !descriptor.copied_state_root.starts_with(path),
+                "copy root overlaps an original home"
+            );
+            originals.push(path);
+        }
+        for (path, identity) in [
+            (&home.copied_codex_home, &home.codex_home_identity),
+            (&home.copied_sqlite_home, &home.sqlite_home_identity),
+        ] {
+            confined_path(&descriptor.copied_state_root, path)?;
+            physical_directory(path, identity)?;
+            ensure!(
+                !descriptor.receipt_path.starts_with(path),
+                "receipt would modify a copied native home"
+            );
+        }
+        ensure!(
+            homes.insert(home.copied_sqlite_home.clone()),
+            "copied sqlite home is reused"
+        );
+        let families: BTreeSet<_> = home.families.iter().map(|family| family.name).collect();
+        ensure!(
+            families.len() == home.families.len() && families == BTreeSet::from(Family::ALL),
+            "native family inventory is incomplete"
+        );
+        for family in &home.families {
+            ensure!(
+                !family.name.is_eager() || family.existed_in_baseline,
+                "eager native store was absent in baseline"
+            );
+            let suffixes: BTreeSet<_> = family.files.iter().map(|file| file.suffix).collect();
+            ensure!(
+                family.files.len() == 3
+                    && suffixes
+                        == BTreeSet::from([FileSuffix::Main, FileSuffix::Wal, FileSuffix::Shm]),
+                "database sidecar inventory is incomplete"
+            );
+            ensure!(
+                family
+                    .files
+                    .iter()
+                    .any(|file| file.suffix == FileSuffix::Main
+                        && file.exists == family.existed_in_baseline),
+                "main database presence differs from baseline"
+            );
+            ensure!(
+                family.existed_in_baseline || family.files.iter().all(|file| !file.exists),
+                "absent family has a sidecar"
+            );
+            for fact in &family.files {
+                let path = home.copied_sqlite_home.join(format!(
+                    "{}{}",
+                    family.name.filename(),
+                    fact.suffix.value()
+                ));
+                check_file_fact(&descriptor.copied_state_root, &path, fact)?;
+            }
+        }
+    }
+    ensure!(
+        ids == descriptor.expected_home_ids,
+        "copy homes do not match admitted inventory"
+    );
+    for home in &homes {
+        ensure!(
+            originals
+                .iter()
+                .all(|original| !home.starts_with(original) && !original.starts_with(home)),
+            "copied sqlite home overlaps an original"
+        );
+        ensure!(
+            homes.iter().all(
+                |other| home == other || (!home.starts_with(other) && !other.starts_with(home))
+            ),
+            "copied sqlite homes overlap each other"
+        );
+    }
+    confined_path(&descriptor.copied_state_root, &descriptor.receipt_path)?;
+    ensure!(
+        fs::symlink_metadata(&descriptor.receipt_path).is_err(),
+        "rehearsal receipt already exists"
+    );
+    Ok(())
+}
+
+struct StoreSnapshot {
+    migrations: BTreeMap<i64, Vec<u8>>,
+    table_counts: BTreeMap<String, i64>,
+}
+
+async fn read_store(path: &Path) -> Result<StoreSnapshot> {
+    let options = SqliteConnectOptions::new()
+        .filename(path)
+        .read_only(true)
+        .create_if_missing(false);
+    let mut connection = SqliteConnection::connect_with(&options).await?;
+    let result: Result<StoreSnapshot> = async {
+        let integrity: Vec<String> = sqlx::query_scalar("PRAGMA integrity_check").fetch_all(&mut connection).await?;
+        ensure!(integrity == ["ok"], "copied database integrity check failed");
+        let ledger = sqlx::query("SELECT version, checksum, success FROM _sqlx_migrations ORDER BY version").fetch_all(&mut connection).await?;
+        let mut migrations = BTreeMap::new();
+        for row in ledger {
+            ensure!(row.try_get::<bool, _>("success")?, "copied database has an unsuccessful migration");
+            migrations.insert(row.try_get("version")?, row.try_get("checksum")?);
+        }
+        let tables: Vec<String> = sqlx::query_scalar("SELECT name FROM sqlite_schema WHERE type = 'table' AND name NOT LIKE 'sqlite_%' ORDER BY name").fetch_all(&mut connection).await?;
+        let mut table_counts = BTreeMap::new();
+        for table in tables {
+            let quoted = table.replace('"', "\"\"");
+            // Audited identifier from sqlite_schema: every embedded double quote
+            // is doubled above, and the identifier stays inside double quotes.
+            let count = sqlx::query_scalar(sqlx::AssertSqlSafe(format!("SELECT COUNT(*) FROM \"{quoted}\"")))
+                .fetch_one(&mut connection).await?;
+            table_counts.insert(table, count);
+        }
+        Ok(StoreSnapshot { migrations, table_counts })
+    }.await;
+    let closed = connection.close().await;
+    let snapshot = result?;
+    closed?;
+    Ok(snapshot)
+}
+
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+struct FamilyReceipt {
+    family: Family,
+    existed_in_baseline: bool,
+    before_migrations: usize,
+    after_migrations: usize,
+    removed_log_rows: i64,
+    renamed_tables: usize,
+}
+
+async fn migrate_home(home: &Home) -> Result<Vec<FamilyReceipt>> {
+    let mut before = BTreeMap::new();
+    for family in &home.families {
+        if family.existed_in_baseline {
+            before.insert(
+                family.name,
+                read_store(&home.copied_sqlite_home.join(family.name.filename())).await?,
+            );
+        }
+    }
+    let sqlite = SqliteConfig::from_sqlite_home(AbsolutePathBuf::from_absolute_path(
+        &home.copied_sqlite_home,
+    )?);
+    let runtime = StateRuntime::init(sqlite.clone(), home.provider_label.clone()).await?;
+    runtime.close().await;
+    if before.contains_key(&Family::History) {
+        open_thread_history_db(&sqlite).await?.close().await;
+    }
+    let mut receipt = Vec::new();
+    for family in &home.families {
+        let path = home.copied_sqlite_home.join(family.name.filename());
+        let Some(previous) = before.get(&family.name) else {
+            for suffix in ["", "-wal", "-shm"] {
+                let absent = home
+                    .copied_sqlite_home
+                    .join(format!("{}{suffix}", family.name.filename()));
+                ensure!(
+                    !absent.try_exists()? && fs::symlink_metadata(&absent).is_err(),
+                    "lazy native family was manufactured"
+                );
+            }
+            receipt.push(FamilyReceipt {
+                family: family.name,
+                existed_in_baseline: false,
+                before_migrations: 0,
+                after_migrations: 0,
+                removed_log_rows: 0,
+                renamed_tables: 0,
+            });
+            continue;
+        };
+        let current = read_store(&path).await?;
+        ensure!(
+            current
+                .migrations
+                .last_key_value()
+                .map(|(version, _)| *version)
+                == Some(family.name.latest_version()),
+            "native migration did not reach current schema"
+        );
+        for (version, checksum) in &previous.migrations {
+            ensure!(
+                current.migrations.get(version) == Some(checksum),
+                "prior native migration checksum changed"
+            );
+        }
+        let mut removed_log_rows = 0;
+        let mut renamed_tables = 0;
+        for (table, old_count) in &previous.table_counts {
+            // Native state migration 55 renames this table and its type column.
+            // The invoking owner separately checks the corresponding payload projection.
+            let current_table = if family.name == Family::State
+                && table == "thread_artifacts"
+                && !previous.migrations.contains_key(&55)
+                && current.migrations.contains_key(&55)
+            {
+                ensure!(
+                    !current.table_counts.contains_key(table),
+                    "native attachment rename left the old table"
+                );
+                renamed_tables += 1;
+                "thread_attachments"
+            } else {
+                table.as_str()
+            };
+            let new_count = current
+                .table_counts
+                .get(current_table)
+                .context("prior table disappeared outside native rename")?;
+            if table == "_sqlx_migrations" {
+                continue;
+            }
+            if family.name == Family::Logs && table == "logs" {
+                ensure!(
+                    new_count <= old_count,
+                    "native log maintenance added unexpected rows"
+                );
+                removed_log_rows = old_count - new_count;
+            } else if family.name == Family::State && table == "backfill_state" && *old_count == 0 {
+                ensure!(
+                    *new_count == 1,
+                    "native backfill singleton was not initialized"
+                );
+            } else {
+                ensure!(
+                    new_count == old_count,
+                    "native migration changed prior table row count"
+                );
+            }
+        }
+        receipt.push(FamilyReceipt {
+            family: family.name,
+            existed_in_baseline: true,
+            before_migrations: previous.migrations.len(),
+            after_migrations: current.migrations.len(),
+            removed_log_rows,
+            renamed_tables,
+        });
+    }
+    Ok(receipt)
+}
+
+/// Actual copied data and matched restoration remain owned by the invoking rehearsal owner.
+#[tokio::test]
+#[ignore = "requires an explicit descriptor binding existing stopped-snapshot and rehearsal-copy receipts"]
+async fn copied_native_store_migration_rehearsal() -> Result<()> {
+    let descriptor_path =
+        std::env::var_os(DESCRIPTOR_ENV).context("explicit private copy descriptor is required")?;
+    let metadata = fs::symlink_metadata(&descriptor_path)?;
+    ensure!(
+        metadata.is_file()
+            && !metadata.file_type().is_symlink()
+            && metadata.len() <= MAX_DESCRIPTOR_BYTES,
+        "unsafe copy descriptor"
+    );
+    let descriptor: Descriptor = serde_json::from_slice(&fs::read(&descriptor_path)?)?;
+    validate_descriptor(&descriptor)?;
+    let mut homes = Vec::new();
+    for home in &descriptor.homes {
+        homes.push(serde_json::json!({ "homeId": home.id, "families": migrate_home(home).await? }));
+    }
+    let receipt = serde_json::json!({
+        "schemaVersion": 1,
+        "operation": "copiedNativeStoreMigrationRehearsal",
+        "candidateSourceCommit": descriptor.candidate_source_commit,
+        "baselineSnapshotSha256": descriptor.baseline_snapshot.sha256,
+        "nativeProjectionReceiptSha256": descriptor.native_projection_receipt.sha256,
+        "status": "native owner APIs and closed-store integrity checks passed",
+        "allNativeHandlesClosed": true,
+        "logsMaintenance": "native ten-day retention and passive checkpoint; removed-row counts are explicit; full content/retention comparison remains with invoking owner",
+        "proofBoundary": "copied source-owned native stores only; matched restoration, packaged binary, provider behavior and live activation are separate gates",
+        "homes": homes,
+    });
+    let mut options = OpenOptions::new();
+    options.write(true).create_new(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        options.mode(0o600);
+    }
+    let mut output = options.open(&descriptor.receipt_path)?;
+    output.write_all(&serde_json::to_vec_pretty(&receipt)?)?;
+    output.write_all(b"\n")?;
+    output.sync_all()?;
+    Ok(())
+}

diff --git a/codex-rs/core/src/source_preserving_input.rs b/codex-rs/core/src/source_preserving_input.rs
new file mode 100644
index 00000000..0390944c
--- /dev/null
+++ b/codex-rs/core/src/source_preserving_input.rs
@@ -0,0 +1,98 @@
+//! Native facts for source-preserving input on the existing parent-local inference route.
+//! The registered host owns final admission after adding its confidential instructions.
+
+use codex_api::ResponsesApiRequest;
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::Result;
+use codex_protocol::openai_models::ModelInfo;
+use serde::Serialize;
+
+use crate::client_common::estimate_request_tokens;
+use crate::responses_metadata::CodexResponsesMetadata;
+
+pub(crate) const REQUEST_KEY: &str = "openclaw_source_preserving_input_v1";
+pub(crate) const FACT_KEY: &str = "openclaw_prepared_input_v1";
+
+/// Captured by the native turn owner, never reconstructed from client metadata.
+#[derive(Clone, Debug)]
+pub(crate) struct SourcePreservingContext {
+    pub(crate) provider: String,
+    pub(crate) effects_started: bool,
+}
+
+#[derive(Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+struct PreparedInput {
+    v: u8,
+    model: String,
+    provider: String,
+    /// Already excludes model-owned headroom; the host must not subtract it again.
+    usable_context_window: i64,
+    native_headroom_tokens: i64,
+    /// Complete logical native request, including instructions, tools and response schema.
+    estimated_request_tokens: usize,
+    effects_started: bool,
+}
+
+pub(crate) fn requested(metadata: &CodexResponsesMetadata) -> bool {
+    metadata.extra.get(REQUEST_KEY).map(String::as_str) == Some("1")
+}
+
+/// Stamp only the final complete native request, before the host's existing pre-egress check.
+pub(crate) fn prepare_request(
+    request: &mut ResponsesApiRequest,
+    model: &ModelInfo,
+    metadata: &CodexResponsesMetadata,
+) -> Result<()> {
+    if !requested(metadata) {
+        return Ok(());
+    }
+    let context = metadata.source_preserving_input.as_ref().ok_or_else(|| {
+        CodexErr::InvalidRequest("Source-preserving input has no native turn owner".to_owned())
+    })?;
+    let window = model.resolved_context_window();
+    let usable = model.usable_context_window();
+    let (Some(window), Some(usable)) = (window, usable) else {
+        return Err(CodexErr::InvalidRequest(
+            "Source-preserving input requires native model context metadata".to_owned(),
+        ));
+    };
+    if model.used_fallback_model_metadata
+        || window <= 0
+        || usable <= 0
+        || !(1..=100).contains(&model.effective_context_window_percent)
+        || usable > window
+        || request.model != model.slug
+        || context.provider.is_empty()
+    {
+        return Err(CodexErr::InvalidRequest(
+            "Source-preserving input has unavailable or mismatched native model metadata"
+                .to_owned(),
+        ));
+    }
+    let estimated_request_tokens = estimate_request_tokens(request);
+    if estimated_request_tokens == usize::MAX {
+        return Err(CodexErr::InvalidRequest(
+            "Source-preserving input could not measure the complete native request".to_owned(),
+        ));
+    }
+    let fact = PreparedInput {
+        v: 1,
+        model: model.slug.clone(),
+        provider: context.provider.clone(),
+        usable_context_window: usable,
+        native_headroom_tokens: window.saturating_sub(usable),
+        estimated_request_tokens,
+        effects_started: context.effects_started,
+    };
+    request.client_metadata.get_or_insert_default().insert(
+        FACT_KEY.to_owned(),
+        serde_json::to_string(&fact)
+            .map_err(|error| CodexErr::InvalidRequest(error.to_string()))?,
+    );
+    Ok(())
+}
+
+#[cfg(test)]
+#[path = "source_preserving_input_tests.rs"]
+mod tests;

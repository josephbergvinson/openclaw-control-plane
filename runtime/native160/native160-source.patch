+SELECT status, last_watermark, last_success_at
+FROM backfill_state
+WHERE id = 1
+            "#,
+        )
+        .fetch_one(&mut *reader)
+        .await
+        .unwrap();
+        let state = crate::BackfillState::try_from_row(&row).unwrap();
+        assert_eq!(state.status, crate::BackfillStatus::Running);
+        assert_eq!(state.last_success_at, None);
+        assert_eq!(
+            state.last_watermark.as_deref(),
+            Some("sessions/committed.jsonl")
+        );
+        drop(transaction);
+        drop(connection);
+        drop(reader);
+        assert_eq!(runtime.get_thread(id).await.unwrap(), None);
+        assert_eq!(
+            runtime
+                .get_backfill_state()
+                .await
+                .unwrap()
+                .last_watermark
+                .as_deref(),
+            Some("sessions/committed.jsonl")
+        );
+        let _ = tokio::fs::remove_dir_all(home).await;
+    }
 }

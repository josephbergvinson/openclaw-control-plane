+    let test = test_codex()
+        .with_model_info_override("gpt-5.5", |model| {
+            model.context_window = Some(256);
+            model.max_context_window = Some(256);
+            model.effective_context_window_percent = 95;
+        })
+        .build_with_auto_env(&server)
+        .await?;

+            serde_json::to_string(&SessionSource::SubAgent(SubAgentSource::ThreadSpawn {
+                parent_thread_id: parent,
+                depth: 1,
+                agent_path: None,
+                agent_nickname: None,
+                agent_role: None,
+            }))
+            .expect("serialize actual spawn source");
+        spawned.originator = Some("native154-client".to_string());
+        spawned.daybreak_enabled = Some(true);
+        let mut repeated = spawned.clone();
+        repeated.preview = Some(String::new());
+        repeated.title = "Updated derived title".to_string();
+        repeated.archived_at = Some(repeated.updated_at);
+        let mut rows = vec![
+            (stale, "enabled".to_string()),
+            (spawned, "disabled".to_string()),
+            (repeated, "enabled".to_string()),
+        ];
+        for (mut metadata, memory_mode) in rows.clone() {
+            let existing = individual.get_thread(metadata.id).await.ok().flatten();
+            let restore =
+                existing.is_none() || matches!(metadata.history_mode, ThreadHistoryMode::Legacy);
+            if let Some(existing) = existing.as_ref() {
+                metadata.prefer_existing_git_info(existing);
+                metadata.prefer_existing_explicit_title(existing);
+            }
+            individual
+                .upsert_thread(&metadata)
+                .await
+                .expect("individual upsert");
+            if restore {
+                individual
+                    .set_thread_memory_mode(metadata.id, &memory_mode)
+                    .await
+                    .expect("individual memory mode");
+            }
+        }
+        let results = batch
+            .backfill_thread_batch(&mut rows, "sessions/batch-last.jsonl")
+            .await
+            .expect("commit batch");
+        assert_eq!(results.len(), 3);
+        assert!(results.iter().all(Result::is_ok));
+        for id in [parent, child] {
+            assert_eq!(
+                batch.get_thread(id).await.unwrap(),
+                individual.get_thread(id).await.unwrap()
+            );
+            assert_eq!(
+                batch.get_thread_memory_mode(id).await.unwrap(),
+                individual.get_thread_memory_mode(id).await.unwrap()
+            );
+        }
+        assert_eq!(
+            batch.list_thread_spawn_children(parent).await.unwrap(),
+            vec![child]
+        );
+        let state = batch.get_backfill_state().await.unwrap();
+        assert_eq!(state.status, crate::BackfillStatus::Running);
+        assert_eq!(
+            state.last_watermark.as_deref(),
+            Some("sessions/batch-last.jsonl")
+        );
+        assert_eq!(state.last_success_at, None);
+        let _ = tokio::fs::remove_dir_all(home).await;
+        let _ = tokio::fs::remove_dir_all(baseline_home).await;
+    }
+
+    #[tokio::test]
+    async fn backfill_batch_keeps_row_refusals_and_prior_successful_statements() {
+        use crate::runtime::test_support::test_thread_metadata;
+        use codex_protocol::ThreadId;
+        use codex_protocol::protocol::SessionSource;
+        use codex_protocol::protocol::SubAgentSource;
+
+        for stage in ["upsert", "spawn", "memory"] {
+            let home = unique_temp_dir();
+            let runtime = StateRuntime::init(
+                crate::SqliteConfig::new_for_testing(home.as_path().abs()),
+                "test-provider".to_string(),
+            )
+            .await
+            .expect("initialize runtime");
+            let bad_id = ThreadId::new();
+            let good_id = ThreadId::new();
+            let mut bad = test_thread_metadata(&home, bad_id, home.clone());
+            let trigger = match stage {
+                "upsert" => format!(
+                    "CREATE TRIGGER refuse_row BEFORE INSERT ON threads WHEN NEW.id = '{bad_id}' BEGIN SELECT RAISE(ABORT, 'row refused'); END"
+                ),
+                "spawn" => {
+                    bad.source = serde_json::to_string(&SessionSource::SubAgent(
+                        SubAgentSource::ThreadSpawn {
+                            parent_thread_id: ThreadId::new(),
+                            depth: 1,
+                            agent_path: None,
+                            agent_nickname: None,
+                            agent_role: None,
+                        },
+                    ))
+                    .expect("serialize spawn source");
+                    "CREATE TRIGGER refuse_edge BEFORE INSERT ON thread_spawn_edges BEGIN SELECT RAISE(ABORT, 'edge refused'); END".to_string()
+                }
+                "memory" => format!(
+                    "CREATE TRIGGER refuse_memory BEFORE UPDATE OF memory_mode ON threads WHEN NEW.id = '{bad_id}' BEGIN SELECT RAISE(ABORT, 'memory refused'); END"
+                ),
+                _ => unreachable!("only named fixture stages"),
+            };
+            // The SQL contains only fixture constants and a locally generated ThreadId UUID.
+            sqlx::query(sqlx::AssertSqlSafe(trigger))
+                .execute(runtime.pool.as_ref())
+                .await
+                .expect("install refusal trigger");
+            let good = test_thread_metadata(&home, good_id, home.clone());
+            let mut rows = vec![
+                (bad, "disabled".to_string()),
+                (good, "disabled".to_string()),
+            ];
+            let results = runtime
+                .backfill_thread_batch(&mut rows, "sessions/refusal-last.jsonl")
+                .await
+                .expect("commit surviving rows");
+            assert_eq!(results.len(), 2);
+            assert!(results[0].is_err());
+            assert!(results[1].is_ok());
+            assert_eq!(
+                runtime.get_thread(bad_id).await.unwrap().is_some(),
+                stage != "upsert"
+            );
+            assert!(runtime.get_thread(good_id).await.unwrap().is_some());
+            assert_eq!(
+                runtime
+                    .get_thread_memory_mode(good_id)
+                    .await
+                    .unwrap()
+                    .as_deref(),
+                Some("disabled")
+            );
+            if stage != "upsert" {
+                assert_eq!(
+                    runtime
+                        .get_thread_memory_mode(bad_id)
+                        .await
+                        .unwrap()
+                        .as_deref(),
+                    Some("enabled")
+                );
+            }
+            let edges: i64 = sqlx::query_scalar("SELECT COUNT(*) FROM thread_spawn_edges")
+                .fetch_one(runtime.pool.as_ref())
+                .await
+                .unwrap();
+            assert_eq!(edges, 0);
+            assert_eq!(
+                runtime
+                    .get_backfill_state()
+                    .await
+                    .unwrap()
+                    .last_watermark
+                    .as_deref(),
+                Some("sessions/refusal-last.jsonl")
+            );
+            let _ = tokio::fs::remove_dir_all(home).await;
+        }
+    }
+
+    #[tokio::test]
+    async fn backfill_batch_failure_does_not_publish_rows_or_a_new_watermark() {
+        use crate::runtime::test_support::test_thread_metadata;
+        use codex_protocol::ThreadId;
+
+        for fail_checkpoint in [false, true] {
+            let home = unique_temp_dir();
+            let runtime = StateRuntime::init(
+                crate::SqliteConfig::new_for_testing(home.as_path().abs()),
+                "test-provider".to_string(),
+            )
+            .await
+            .expect("initialize runtime");
+            runtime
+                .checkpoint_backfill("sessions/committed.jsonl")
+                .await
+                .expect("seed committed progress");
+            let first_id = ThreadId::new();
+            let last_id = ThreadId::new();
+            let trigger = if fail_checkpoint {
+                "CREATE TRIGGER refuse_checkpoint BEFORE UPDATE OF last_watermark ON backfill_state BEGIN SELECT RAISE(ABORT, 'checkpoint refused'); END".to_string()
+            } else {
+                format!(
+                    "CREATE TRIGGER rollback_batch BEFORE INSERT ON threads WHEN NEW.id = '{first_id}' BEGIN SELECT RAISE(ROLLBACK, 'transaction rolled back'); END"
+                )
+            };
+            // The SQL contains only fixture constants and a locally generated ThreadId UUID.
+            sqlx::query(sqlx::AssertSqlSafe(trigger))
+                .execute(runtime.pool.as_ref())
+                .await
+                .expect("install failure trigger");
+            let mut rows = vec![
+                (
+                    test_thread_metadata(&home, first_id, home.clone()),
+                    "disabled".to_string(),
+                ),
+                (
+                    test_thread_metadata(&home, last_id, home.clone()),
+                    "disabled".to_string(),
+                ),
+            ];
+            assert!(
+                runtime
+                    .backfill_thread_batch(&mut rows, "sessions/uncommitted.jsonl")
+                    .await
+                    .is_err()
+            );
+            for id in [first_id, last_id] {
+                assert_eq!(runtime.get_thread(id).await.unwrap(), None);
+            }
+            let state = runtime.get_backfill_state().await.unwrap();
+            assert_eq!(state.status, crate::BackfillStatus::Running);
+            assert_eq!(
+                state.last_watermark.as_deref(),
+                Some("sessions/committed.jsonl")
+            );
+            assert_eq!(state.last_success_at, None);
+            // Exercise all existing pool slots: an automatically rolled-back connection
+            // must not be reused with a stale SQLx savepoint depth.
+            let mut connections = Vec::new();
+            for _ in 0..5 {
+                let mut connection = runtime.pool.acquire().await.unwrap();
+                let transaction = connection
+                    .begin_with("BEGIN IMMEDIATE")
+                    .await
+                    .expect("healthy pooled transaction");
+                transaction
+                    .rollback()
+                    .await
+                    .expect("release healthy pooled transaction");
+                connections.push(connection);
+            }
+            drop(connections);
+            let _ = tokio::fs::remove_dir_all(home).await;
+        }
+    }
+
+    #[tokio::test]
+    async fn backfill_metadata_and_checkpoint_share_visibility_and_drop_rollback() {
+        use crate::runtime::test_support::test_thread_metadata;
+        use codex_protocol::ThreadId;
+
+        let home = unique_temp_dir();
+        let runtime = StateRuntime::init(
+            crate::SqliteConfig::new_for_testing(home.as_path().abs()),
+            "test-provider".to_string(),
+        )
+        .await
+        .expect("initialize runtime");
+        runtime
+            .checkpoint_backfill("sessions/committed.jsonl")
+            .await
+            .expect("seed progress");
+        let id = ThreadId::new();
+        let metadata = test_thread_metadata(&home, id, home.clone());
+        // Finish both connection setups before holding the writer slot. The visibility
+        // checks below must only read from the other retained connection.
+        let mut reader = runtime.pool.acquire().await.unwrap();
+        let mut connection = runtime.pool.acquire().await.unwrap();
+        let mut transaction = connection.begin_with("BEGIN IMMEDIATE").await.unwrap();
+        runtime
+            .upsert_thread_in_connection(&mut transaction, &metadata)
+            .await
+            .unwrap();
+        runtime
+            .checkpoint_backfill_with_executor(&mut *transaction, "sessions/uncommitted.jsonl")
+            .await
+            .unwrap();
+        assert_eq!(
+            runtime
+                .get_thread_with_executor(&mut *reader, id)
+                .await
+                .unwrap(),
+            None
+        );
+        let row = sqlx::query(
+            r#"
+SELECT status, last_watermark, last_success_at
+FROM backfill_state
+WHERE id = 1
+            "#,
+        )
+        .fetch_one(&mut *reader)
+        .await
+        .unwrap();
+        let state = crate::BackfillState::try_from_row(&row).unwrap();
+        assert_eq!(state.status, crate::BackfillStatus::Running);
+        assert_eq!(state.last_success_at, None);
+        assert_eq!(
+            state.last_watermark.as_deref(),
+            Some("sessions/committed.jsonl")
+        );
+        drop(transaction);
+        drop(connection);
+        drop(reader);
+        assert_eq!(runtime.get_thread(id).await.unwrap(), None);
+        assert_eq!(
+            runtime
+                .get_backfill_state()
+                .await
+                .unwrap()
+                .last_watermark
+                .as_deref(),
+            Some("sessions/committed.jsonl")
+        );
+        let _ = tokio::fs::remove_dir_all(home).await;
+    }
 }

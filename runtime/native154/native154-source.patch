+    /// Apply one ordered rollout metadata batch and its watermark in a single commit.
+    ///
+    /// Normal row errors retain prior successful statements and do not stop later rows,
+    /// matching individual upserts. Nested releases detect transaction-wide rollback before
+    /// another operation can escape into autocommit. A batch/checkpoint error commits nothing.
+    pub async fn backfill_thread_batch(
+        &self,
+        rows: &mut [(crate::ThreadMetadata, String)],
+        watermark: &str,
+    ) -> anyhow::Result<Vec<anyhow::Result<()>>> {
+        self.ensure_backfill_state_row().await?;
+        let mut connection = self.pool.acquire().await?;
+        let result = async {
+            let mut transaction = connection.begin_with("BEGIN IMMEDIATE").await?;
+            let mut outcomes = Vec::with_capacity(rows.len());
+            for (metadata, memory_mode) in rows {
+                let mut step = sqlx::Acquire::begin(&mut transaction).await?;
+                let existing_metadata = self
+                    .get_thread_with_executor(&mut *step, metadata.id)
+                    .await
+                    .ok()
+                    .flatten();
+                step.commit()
+                    .await
+                    .context("backfill metadata read transaction ended")?;
+                // Paginated metadata updates are SQLite-only. Seed missing rows from the rollout,
+                // then keep the current SQLite memory mode and metadata on subsequent rows.
+                let restore_memory_mode_from_rollout = existing_metadata.is_none()
+                    || matches!(metadata.history_mode, ThreadHistoryMode::Legacy);
+                if let Some(existing_metadata) = existing_metadata.as_ref() {
+                    metadata.prefer_existing_git_info(existing_metadata);
+                    metadata.prefer_existing_explicit_title(existing_metadata);
+                }
+
+                let mut step = sqlx::Acquire::begin(&mut transaction).await?;
+                let upsert = self.upsert_thread_in_connection(&mut step, metadata).await;
+                if let Err(release_error) = step.commit().await {
+                    return Err(upsert.err().unwrap_or_else(|| release_error.into()))
+                        .context("backfill upsert transaction ended");
+                }
+                if let Err(err) = upsert {
+                    outcomes.push(Err(err.context(format!(
+                        "failed to upsert rollout {}",
+                        metadata.rollout_path.display(),
+                    ))));
+                    continue;
+                }
+                if restore_memory_mode_from_rollout {
+                    let mut step = sqlx::Acquire::begin(&mut transaction).await?;
+                    let restore = self
+                        .set_thread_memory_mode_with_executor(
+                            &mut *step,
+                            metadata.id,
+                            memory_mode.as_str(),
+                        )
+                        .await;
+                    if let Err(release_error) = step.commit().await {
+                        return Err(restore.err().unwrap_or_else(|| release_error.into()))
+                            .context("backfill memory-mode transaction ended");
+                    }
+                    if let Err(err) = restore {
+                        outcomes.push(Err(err.context(format!(
+                            "failed to restore memory mode for {}",
+                            metadata.rollout_path.display(),
+                        ))));
+                        continue;
+                    }
+                }
+                outcomes.push(Ok(()));
+            }
+            self.checkpoint_backfill_with_executor(&mut *transaction, watermark)
+                .await?;
+            transaction.commit().await?;
+            Ok(outcomes)
+        }
+        .await;
+        match result {
+            Ok(outcomes) => Ok(outcomes),
+            Err(err) => {
+                // SQLite can roll back the whole transaction while SQLx still tracks its
+                // savepoint depth. Never return that failed connection for another batch.
+                match connection.close().await {
+                    Ok(()) => Err(err),
+                    Err(close_error) => Err(err.context(format!(
+                        "failed to close aborted backfill connection: {close_error}",
+                    ))),
+                }
+            }
+        }
+    }

+/** Inspect waiting work without mistaking the exact adopted source for a predecessor. */
+export function inspectFollowupQueueAdmission(
+  key: string,
+  options: { activeSource?: FollowupRun; before?: FollowupRun } = {},
+): { state: "empty" | "steering" | "ready"; excludedActiveSource: boolean } {
+  const queue = getExistingFollowupQueue(key);
+  if (!queue) {
+    return { state: options.before ? "ready" : "empty", excludedActiveSource: false };
+  }
+  const beforeIndex = options.before ? queue.items.indexOf(options.before) : queue.items.length;
+  if (
+    beforeIndex < 0 ||
+    (options.before && queue.items.lastIndexOf(options.before) !== beforeIndex)
+  ) {
+    return { state: "ready", excludedActiveSource: false };
+  }
+  const source = options.activeSource;
+  const excludedActiveSource = Boolean(
+    source &&
+    queue.inFlight.has(source) &&
+    !isFollowupRunAborted(source) &&
+    !queue.activeSummarySources.has(source),
+  );
+  const isCurrentSource = (item: FollowupRun) => excludedActiveSource && item === source;
+  const ready =
+    queue.items.some(
+      (item, index) => index < beforeIndex && !item.steerPending && !isCurrentSource(item),
+    ) ||
+    [...queue.inFlight].some((item) => !isCurrentSource(item)) ||
+    queue.droppedCount > 0;
+  return { state: ready ? "ready" : "steering", excludedActiveSource };

+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+const uploadMocks = vi.hoisted(() => ({
+  discardStagedBrowserProxyUpload: vi.fn(async () => {}),
+  ensureBrowserProxyUploadCleanup: vi.fn(async () => {}),
+  stageBrowserProxyUploadRequest: vi.fn(),
+}));
+
+const controlServiceMocks = vi.hoisted(() => ({
+  createBrowserControlContext: vi.fn(),
+  getBrowserControlState: vi.fn(),
+  startBrowserControlServiceFromConfig: vi.fn(),
+}));
+
+const dispatcherMocks = vi.hoisted(() => ({
+  createBrowserRouteDispatcher: vi.fn(),
+}));
+
+vi.mock("../browser-proxy-upload.js", () => uploadMocks);
+vi.mock("../control-service.js", () => controlServiceMocks);
+vi.mock("../browser/routes/dispatcher.js", () => dispatcherMocks);
+
+import { runBrowserProxyCommand } from "./invoke-browser.js";
+
+describe("host-only browser credentials", () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+  });
+
+  it("rejects typeSecret before starting or dispatching node browser control", async () => {
+    await expect(
+      runBrowserProxyCommand(
+        JSON.stringify({
+          method: "POST",
+          path: "/act",
+          body: {
+            kind: "typeSecret",
+            alias: "account",
+            ref: "e17",
+            targetId: "tab-1",
+            submit: true,
+          },
+        }),
+      ),
+    ).rejects.toThrow("browser.proxy cannot run opaque credentials");
+
+    expect(controlServiceMocks.startBrowserControlServiceFromConfig).not.toHaveBeenCalled();
+    expect(uploadMocks.stageBrowserProxyUploadRequest).not.toHaveBeenCalled();
+    expect(dispatcherMocks.createBrowserRouteDispatcher).not.toHaveBeenCalled();
+  });
+
+  it.each(["account", "", null, 17])(
+    "rejects an HTTP auth alias before node browser startup (%s)",
+    async (alias) => {
+      await expect(
+        runBrowserProxyCommand(
+          JSON.stringify({
+            method: "POST",
+            path: "/set/credentials",
+            body: { alias, targetId: "tab-1" },
+          }),
+        ),
+      ).rejects.toThrow("browser.proxy cannot run opaque credentials");
+      expect(controlServiceMocks.startBrowserControlServiceFromConfig).not.toHaveBeenCalled();
+      expect(uploadMocks.stageBrowserProxyUploadRequest).not.toHaveBeenCalled();
+      expect(dispatcherMocks.createBrowserRouteDispatcher).not.toHaveBeenCalled();
+    },
+  );
+});

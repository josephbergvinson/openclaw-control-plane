+/** Tests the complete prompt facade's control/update guidance across tool surfaces. */
+import { describe, expect, it } from "vitest";
+import { buildAgentSystemPrompt } from "./system-prompt.js";
+
+describe("buildAgentSystemPrompt OpenClaw control", () => {
+  it.each([
+    { gateway: true, promptMode: "full" },
+    { gateway: false, promptMode: "full" },
+    { gateway: true, promptMode: "minimal" },
+    { gateway: false, promptMode: "minimal" },
+  ] as const)(
+    "permits owner-authorized maintenance of the hosting Gateway ($gateway, $promptMode)",
+    ({ gateway, promptMode }) => {
+      const prompt = buildAgentSystemPrompt({
+        workspaceDir: "/tmp/openclaw",
+        promptMode,
+        toolNames: gateway ? ["gateway", "exec"] : ["exec"],
+      });
+      expect(prompt).toContain("For the Gateway hosting this session:");
+      expect(prompt).toContain(
+        "Owner-authorized maintenance may update, replace, stop or restart the Gateway hosting this chat through exec",
+      );
+      expect(prompt).toContain("existing supported activation and drain/handoff route");
+      expect(prompt).toContain("preserve resumable work");
+      expect(prompt).toContain("verify the successor's identity and health");
+      expect(prompt).toContain("then continue the original task");
+      expect(prompt).toContain("not a requirement for a human-operated terminal");
+      expect(prompt).not.toContain("Never run openclaw update");
+      expect(prompt).toContain("For a user-requested update on another host");
+      expect(prompt).toContain("verify the exact target");
+      expect(prompt).toContain("exec/SSH with `openclaw update --yes`");
+      expect(prompt).toContain("existing exec authorization still applies");
+    },
+  );
+
+  it("routes explicit updates through gateway without exposing config writes", () => {
+    const prompt = buildAgentSystemPrompt({
+      workspaceDir: "/tmp/openclaw",
+      toolNames: ["gateway", "exec"],
+    });
+
+    expect(prompt).toContain(
+      "Config read: `gateway` (`config.get|config.schema.lookup`) only when those actions are exposed by its schema. This tool does not expose general config writes or restart.",

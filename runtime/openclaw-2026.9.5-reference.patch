index 0000000000000000000000000000000000000000..28be84532d05c6f1f4ed4c8551c91e85ccc5f0e8
--- /dev/null
+++ b/src/cron/tools-allow-provenance.test.ts
@@ -0,0 +1,152 @@
+import { describe, expect, it } from "vitest";
+import { resolveCronJobMessageActionAuthorityInputs } from "./service/jobs-tool-policy.js";
+import { resolveCronAuthenticatedChannelRequester } from "./tools-allow-provenance.js";
+import type { CronStoredJob } from "./types.js";
+
+function requesterJob(): CronStoredJob {
+  return {
+    id: "private-requester-report",
+    name: "Daily report",
+    enabled: true,
+    createdAtMs: 1,
+    updatedAtMs: 1,
+    schedule: { kind: "every", everyMs: 60_000 },
+    sessionTarget: "isolated",
+    wakeMode: "next-heartbeat",
+    state: {},
+    owner: { agentId: "main", accountId: "work", sessionKey: "agent:main:discord:group:ops" },
+    scheduledToolPolicy: {
+      version: 1,
+      mode: "account",
+      ownerSessionKey: "agent:main:discord:group:ops",
+      ownerAccountId: "work",
+    },
+    payload: { kind: "agentTurn", message: "Read the company report", toolsAllow: ["read"] },
+    delivery: { mode: "none", channel: "slack", accountId: "delivery", to: "channel:report" },
+    toolsAllowProvenance: {
+      version: 1,
+      source: "final-executable-surface",
+      callerOrigin: { kind: "external", channel: "discord" },
+      channelRequester: {
+        version: 1,
+        channel: "discord",
+        accountId: "work",
+        senderId: "requester-a",
+      },
+    },
+  };
+}
+
+describe("cron private requester scope", () => {
+  it.each(["external", "unknown", "absent"] as const)(
+    "retains authenticated credentials with %s origin when message is denied and delivery differs",
+    (origin) => {
+      const job = requesterJob();
+      job.toolsAllowProvenance = {
+        version: 1,
+        source: "final-executable-surface",
+        channelRequester: {
+          version: 1,
+          channel: "discord",
+          accountId: "work",
+          senderId: "requester-a",
+        },
+        ...(origin === "external"
+          ? { callerOrigin: { kind: "external", channel: "discord" } }
+          : origin === "unknown"
+            ? { callerOrigin: { kind: "unknown" } }
+            : {}),
+      };
+      expect(resolveCronAuthenticatedChannelRequester(job)).toEqual({
+        version: 1,
+        channel: "discord",
+        accountId: "work",
+        senderId: "requester-a",
+      });
+      expect(resolveCronJobMessageActionAuthorityInputs(job)).toMatchObject({
+        channelRequester: { channel: "discord", accountId: "work", senderId: "requester-a" },
+        executableRevision: expect.any(String),
+      });
+      expect(job.payload.toolsAllow).toEqual(["read"]);
+    },
+  );
+
+  it.each<{ name: string; mutate: (job: CronStoredJob) => void }>([
+    {
+      name: "no private provenance",
+      mutate: (job) => {
+        delete job.toolsAllowProvenance;
+      },
+    },
+    {
+      name: "legacy unknown origin without a requester",
+      mutate: (job) => {
+        job.toolsAllowProvenance = {
+          version: 1,
+          source: "final-executable-surface",
+          callerOrigin: { kind: "unknown" },
+        };
+      },
+    },
+    {
+      name: "capless legacy policy",
+      mutate: (job) => {
+        delete job.payload.toolsAllow;
+      },
+    },
+    {
+      name: "trusted policy",
+      mutate: (job) => {
+        job.scheduledToolPolicy = { version: 1, mode: "trusted" };
+      },
+    },
+    {
+      name: "changed owner account",
+      mutate: (job) => {
+        job.owner = { ...job.owner, accountId: "other" };
+      },
+    },
+    {
+      name: "changed owner session",
+      mutate: (job) => {
+        job.owner = { ...job.owner, sessionKey: "agent:main:discord:group:other" };
+      },
+    },
+    {
+      name: "different requester account",
+      mutate: (job) => {
+        job.toolsAllowProvenance = {
+          version: 1,
+          source: "authenticated-requester",
+          channelRequester: {
+            version: 1,
+            channel: "discord",
+            accountId: "other",
+            senderId: "requester-a",
+          },
+        };
+      },
+    },
+    {
+      name: "conflicting authenticated origin channel",
+      mutate: (job) => {
+        job.toolsAllowProvenance = {
+          version: 1,
+          source: "authenticated-requester",
+          callerOrigin: { kind: "external", channel: "slack" },
+          channelRequester: {
+            version: 1,
+            channel: "discord",
+            accountId: "work",
+            senderId: "requester-a",
+          },
+        };
+      },
+    },
+  ])("does not infer credentials from $name", ({ mutate }) => {
+    const job = requesterJob();
+    mutate(job);
+    expect(resolveCronAuthenticatedChannelRequester(job)).toBeUndefined();
+    expect(resolveCronJobMessageActionAuthorityInputs(job)).toBeUndefined();
+  });
+});

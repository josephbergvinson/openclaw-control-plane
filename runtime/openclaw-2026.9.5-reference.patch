+      );
+      expect(mocks.admitReply).toHaveBeenCalledOnce();
+      expect(mocks.preflight).toHaveBeenCalledOnce();
+      expect(item.run.config).toBe(input);
+    },
+  );
+
+  it("keeps explicit scoped config and its strict catalog mismatch after reload", async () => {
+    const retained = createConfig(true);
+    const replacement = createConfig(false);
+    const scoped: OpenClawConfig = { ...retained, tools: { allow: ["read"] } };
+    setRuntimeConfigSnapshot(retained, retained);
+    const item = createQueued(scoped);
+    await replaceRuntime(retained, replacement);
+    const turn = await admitted(item);
+    expect(turn.config).toBe(scoped);
+    expect(mocks.resolveSecrets.mock.calls[0]?.[0].config).toBe(scoped);

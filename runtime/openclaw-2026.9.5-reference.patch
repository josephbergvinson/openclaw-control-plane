+import type { TranscriptSessionDescriptor } from "./provider-types.js";
+import { TranscriptsStore } from "./store.js";
+import { summarizeTranscriptsWithModel } from "./summary-model.js";
+import { renderTranscriptsMarkdown } from "./summary.js";
+
+vi.mock("./summary-model.js", () => ({ summarizeTranscriptsWithModel: vi.fn() }));
+
+const dirs = useAutoCleanupTempDirTracker(afterEach);
+const session: TranscriptSessionDescriptor = {
+  sessionId: "synthetic-window",
+  source: { providerId: "manual-transcript" },
+  startedAt: "2026-10-03T10:00:00Z",
+};
+
+beforeEach(() => {
+  vi.mocked(summarizeTranscriptsWithModel).mockReset().mockResolvedValue(undefined);
+});
+
+describe("native capture summary input coverage", () => {
+  it.each([false, true])(
+    "keeps early, middle and final retained recording content (model %s)",
+    async (useModel) => {
+      const stateDir = dirs.make("summary-coverage-");
+      const store = new TranscriptsStore(path.join(stateDir, "transcripts"), {
+        env: { ...process.env, OPENCLAW_STATE_DIR: stateDir },
+      });
+      const readUtterancesForSession = vi
+        .spyOn(store, "readUtterancesForSession")
+        .mockResolvedValue([
+          { text: "Earlier discussion beyond the window." },
+          { text: "Release proposal." },
+          { text: "The proposal remains open." },
+          { text: "Alex will compare costs." },
+        ]);
+      const modeled = {
+        sessionId: session.sessionId,
+        title: "Release options and cost comparison",
+        generatedAt: session.startedAt,
+        participants: [],
+        source: "model" as const,
+        overview: "The release options need a cost comparison.",
+        transcript: [
+          "Earlier discussion beyond the window.",
+          "Release proposal.",
+          "The proposal remains open.",
+          "Alex will compare costs.",
+        ],
+        decisions: [],
+        actionItems: ["Alex will compare costs."],
+        risks: ["Release option remains open."],
+        utteranceCount: 4,
+      };
+      if (useModel) {
+        vi.mocked(summarizeTranscriptsWithModel).mockResolvedValueOnce(modeled);
+      }
+      const summary = await readTranscriptSummary({
+        store,
+        session,
+        cfg: { agents: { defaults: { model: "openai/synthetic-model" } } },
+        config: { ...resolveTranscriptsConfig({}), maxUtterances: 3 },
+      });
+      expect(readUtterancesForSession).toHaveBeenCalledExactlyOnceWith(session);
+      expect(summarizeTranscriptsWithModel).toHaveBeenCalledExactlyOnceWith(
+        expect.objectContaining({
+          utterances: [
+            { text: "Earlier discussion beyond the window." },
+            { text: "Release proposal." },
+            { text: "The proposal remains open." },
+            { text: "Alex will compare costs." },
+          ],
+        }),
+      );
+      expect(summary.coverage).toBeUndefined();
+      expect(summary.transcript).toEqual(modeled.transcript);
+      expect(summary.source).toBe(useModel ? "model" : "heuristic");
+      expect(renderTranscriptsMarkdown(summary)).not.toContain(
+        "summary input omitted some transcript content",
+      );
+    },
+  );
+});

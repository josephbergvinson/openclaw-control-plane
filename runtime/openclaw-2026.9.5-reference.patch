index 0000000000000000000000000000000000000000..0140091b99a7aaf2b52b04055ed08e54ad8ba26c
--- /dev/null
+++ b/src/gateway/session-subagent-private-completion.ts
@@ -0,0 +1,146 @@
+/** Binds a completed child to the preserved transcript of its yielded recovery owner. */
+import { subagentRuns } from "../agents/subagents/registry/subagent-registry-memory.js";
+import { getLatestLiveSubagentRunByChildSessionKey } from "../agents/subagents/registry/subagent-registry-read.js";
+import type { SubagentRunRecord } from "../agents/subagents/registry/subagent-registry.types.js";
+import { isInternalSessionEffectsKey } from "../config/sessions/internal-session-key.js";
+import { loadExactSessionEntry } from "../config/sessions/session-accessor.js";
+import type { TrustedSubagentResume } from "./in-process-subagent-resume.js";
+
+function unavailable(): never {
+  throw new Error("Private completion recovery owner or session changed before continuation.");
+}
+
+/** Only host-owned completion delivery can create this non-serializable admission binding. */
+export function capturePrivateCompletionResume(params: {
+  requesterSessionKey: string;
+  requesterSessionId: string;
+  sourceSessionKey?: string;
+  continuationRunId?: string;
+}): TrustedSubagentResume | undefined {
+  if (!isInternalSessionEffectsKey(params.requesterSessionKey)) {
+    return undefined;
+  }
+  const candidates = [...subagentRuns.values()].filter(
+    (entry) =>
+      (entry.pauseReason === "sessions_yield" || entry.runId === params.continuationRunId) &&
+      entry.execution.transcriptTarget?.sessionKey === params.requesterSessionKey &&
+      entry.execution.transcriptTarget.sessionId === params.requesterSessionId,
+  );
+  const owner = candidates.length === 1 ? candidates[0] : undefined;
+  const target = owner?.execution.transcriptTarget;
+  const child = params.sourceSessionKey
+    ? getLatestLiveSubagentRunByChildSessionKey(params.sourceSessionKey)
+    : undefined;
+  if (
+    !owner ||
+    !target?.agentId ||
+    !target.storePath ||
+    !target.sessionId ||
+    !target.sessionKey ||
+    !child
+  ) {
+    unavailable();
+  }
+  const logical = loadExactSessionEntry({ ...target, sessionKey: owner.childSessionKey })?.entry;
+  const privateEntry = loadExactSessionEntry({ ...target, sessionKey: target.sessionKey! })?.entry;
+  if (!logical || !privateEntry) {
+    unavailable();
+  }
+  const resume: TrustedSubagentResume = Object.freeze({
+    childSessionKey: owner.childSessionKey,
+    childSessionId: logical.sessionId,
+    previousRunId: owner.runId,
+    taskRunId: owner.taskRunId ?? owner.runId,
+    generation: owner.generation,
+    createdAt: owner.createdAt,
+    privateCompletion: Object.freeze({
+      // SAFETY: The guard above verifies every required field; preserve the registry-owned target.
+      transcriptTarget: target as NonNullable<
+        TrustedSubagentResume["privateCompletion"]
+      >["transcriptTarget"],
+      logicalLifecycleRevision: logical.lifecycleRevision,
+      privateLifecycleRevision: privateEntry.lifecycleRevision,
+      childRunId: child.runId,
+      childGeneration: child.generation,
+      childCreatedAt: child.createdAt,
+      childResult: child.completion?.resultText,
+      ...(owner.runId === params.continuationRunId ? { receiptReplay: true as const } : {}),
+    }),
+  });
+  assertPrivateCompletionResumeCurrent(resume);
+  return resume;
+}
+
+/** Revalidates both incarnations and the same completed-child receipt across every await. */
+export function assertPrivateCompletionResumeCurrent(
+  resume: TrustedSubagentResume,
+  successorRunId?: string,
+): SubagentRunRecord {
+  const completion = resume.privateCompletion;
+  if (!completion) {
+    unavailable();
+  }
+  const target = completion.transcriptTarget;
+  const owner = subagentRuns.get(successorRunId ?? resume.previousRunId);
+  const child = subagentRuns.get(completion.childRunId);
+  const logical = loadExactSessionEntry({ ...target, sessionKey: resume.childSessionKey })?.entry;
+  const privateEntry = loadExactSessionEntry({ ...target, sessionKey: target.sessionKey! })?.entry;
+  if (
+    !owner ||
+    !child ||
+    !logical ||
+    !privateEntry ||
+    owner.childSessionKey !== resume.childSessionKey ||
+    (owner.taskRunId ?? owner.runId) !== resume.taskRunId ||
+    owner.killIntent ||
+    owner.killReconciliation ||
+    owner.terminalOwner ||
+    owner.execution.suppressSessionEffects ||
+    owner.execution.transcriptTarget !== target ||
+    ((!successorRunId || completion.receiptReplay) &&
+      ((!completion.receiptReplay &&
+        (owner.pauseReason !== "sessions_yield" || owner.execution.endedAt === undefined)) ||
+        owner.generation !== resume.generation ||
+        owner.createdAt !== resume.createdAt ||
+        owner.cleanupCompletedAt !== undefined)) ||
+    (successorRunId &&
+      !completion.receiptReplay &&
+      (owner.generation ?? 0) <= (resume.generation ?? 0)) ||
+    logical.sessionId !== resume.childSessionId ||
+    logical.lifecycleRevision !== completion.logicalLifecycleRevision ||
+    logical.archivedAt !== undefined ||
+    privateEntry.sessionId !== target.sessionId ||
+    privateEntry.lifecycleRevision !== completion.privateLifecycleRevision ||
+    privateEntry.archivedAt !== undefined ||
+    child.generation !== completion.childGeneration ||
+    child.createdAt !== completion.childCreatedAt ||
+    child.completion?.resultText !== completion.childResult ||
+    child.execution.endedAt === undefined ||
+    child.completionTarget !== "parent" ||
+    child.requesterSessionKey !== target.sessionKey ||
+    child.completionRequesterSessionId !== target.sessionId ||
+    child.suppressCompletionDelivery ||
+    child.killIntent ||
+    child.killReconciliation ||
+    child.execution.suppressSessionEffects
+  ) {
+    unavailable();
+  }
+  return owner;
+}
+
+/** The command and its input recorder share this exact hidden transcript, never the logical one. */
+export function resolvePrivateCompletionTranscript(
+  resume: TrustedSubagentResume,
+  runId?: string,
+  allowUnadopted = false,
+) {
+  const successorRunId = allowUnadopted && runId && !subagentRuns.has(runId) ? undefined : runId;
+  assertPrivateCompletionResumeCurrent(resume, successorRunId);
+  const target = resume.privateCompletion!.transcriptTarget;
+  const entry = loadExactSessionEntry({ ...target, sessionKey: target.sessionKey! })?.entry;
+  if (!entry) {
+    unavailable();
+  }
+  return { ...target, sessionEntry: entry, sessionFile: target.sessionKey };
+}

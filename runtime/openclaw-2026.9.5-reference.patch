+        ),
+      ).resolves.toBe(false);
+
+      if (superseded) {
+        expect(onSettled).toHaveBeenCalledWith(
+          expect.objectContaining({
+            terminalOutcome: expect.objectContaining({ reason: "superseded" }),
+          }),
+        );
+      }
+      if (superseded && settled && !inputCompletionFails) {
+        expect(completeBatch).toHaveBeenCalledExactlyOnceWith(
+          [child],
+          1,
+          expect.objectContaining({
+            delivered: false,
+            terminal: true,
+            disposition: "intentional_non_delivery",
+          }),
+        );
+        expect(child.requesterSettleWake).toBeUndefined();
+        await vi.advanceTimersByTimeAsync(30_001);
+        await expect(maybeWakeRequesterAfterAllChildrenSettled(wakeParams)).resolves.toBe(false);
+      } else {

@@ -0,0 +1,185 @@
+/**
+ * A bound private continuation publishes the original yielded writer's final state.
+ */
+import { describe, expect, it, vi } from "vitest";
+import type { InternalSessionEntry as SessionEntry } from "../config/sessions.js";
+
+const persistenceMocks = vi.hoisted(() => ({
+  loadSessionEntry: vi.fn(),
+  updateSessionEntry: vi.fn(),
+}));
+const loggerMocks = vi.hoisted(() => ({
+  debug: vi.fn(),
+  error: vi.fn(),
+  info: vi.fn(),
+  warn: vi.fn(),
+}));
+
+// Lifecycle projection formats stored failures without initializing provider runtime.
+vi.mock("../plugins/loader-runtime-load.js", () => {
+  throw new Error("Session lifecycle presentation imported plugin runtime ownership");
+});
+
+vi.mock("../config/sessions/session-accessor.js", () => ({
+  patchSessionEntryCore: persistenceMocks.updateSessionEntry,
+  appendSessionTranscriptReport: vi.fn(async () => ({ ok: true, value: undefined })),
+}));
+
+vi.mock("./session-utils.js", () => ({
+  loadSessionEntry: persistenceMocks.loadSessionEntry,
+}));
+
+vi.mock("../logging/subsystem.js", () => ({
+  createSubsystemLogger: () => loggerMocks,
+}));
+
+import {
+  deriveGatewaySessionLifecycleSnapshot,
+  persistGatewaySessionLifecycleEvent,
+} from "./session-lifecycle-state.js";
+import type { SessionListRowContext } from "./session-utils-contracts.js";
+import {
+  projectGatewaySessionActiveRun,
+  projectGatewaySessionRunState,
+} from "./session-utils-display.js";
+
+type UpdateSessionEntry =
+  typeof import("../config/sessions/session-accessor.js").patchSessionEntryCore;
+type LifecycleEvent = Parameters<typeof persistGatewaySessionLifecycleEvent>[0]["event"];
+
+async function persistLifecycle(
+  entry: SessionEntry,
+  event: LifecycleEvent,
+  options: Pick<
+    Parameters<typeof persistGatewaySessionLifecycleEvent>[0],
+    "expectedWriter" | "assertCommitAllowed"
+  > = {},
+): Promise<SessionEntry> {
+  let currentEntry = structuredClone(entry);
+  persistenceMocks.loadSessionEntry.mockReset().mockReturnValue({
+    storePath: "/tmp/sessions.json",
+    canonicalKey: "agent:main:main",
+    entry: currentEntry,
+  });
+  persistenceMocks.updateSessionEntry
+    .mockReset()
+    .mockImplementation(async (...args: Parameters<UpdateSessionEntry>) => {
+      const [, update] = args;
+      const patch = await update(structuredClone(currentEntry), {
+        existingEntry: structuredClone(currentEntry),
+      });
+      if (patch) {
+        currentEntry = { ...currentEntry, ...patch };
+      }
+      return currentEntry;
+    });
+  await persistGatewaySessionLifecycleEvent({
+    sessionKey: "agent:main:main",
+    event,
+    ...options,
+  });
+  return currentEntry;
+}
+
+describe("bound private continuation settles a yielded foreground writer", () => {
+  function present(entry: SessionEntry) {
+    const rowContext = {
+      subagentRuns: {
+        getDisplaySubagentRun: () => undefined,
+        countActiveDescendantRuns: () => 0,
+      },
+    } as unknown as Pick<SessionListRowContext, "subagentRuns">;
+    const { fields } = projectGatewaySessionRunState({
+      key: "agent:main:main",
+      entry,
+      now: 3_000,
+      rowContext,
+    });
+    // Describe without an active context and list with no active execution
+    // share this lifecycle projection; neither infers completion from idle.
+    return {
+      describe: fields,
+      list: { ...fields, ...projectGatewaySessionActiveRun({ active: false }, fields.status) },
+    };
+  }
+  const started: SessionEntry = {
+    sessionId: "yielded-parent",
+    lifecycleRevision: "yield-revision",
+    updatedAt: 1_000,
+    lifecycleRunId: "original-run",
+    status: "running",
+    startedAt: 1_000,
+  };
+  const yieldEvent: LifecycleEvent = {
+    sessionId: started.sessionId,
+    runId: "original-run",
+    ts: 2_000,
+    data: {
+      phase: "end",
+      startedAt: 1_000,
+      endedAt: 2_000,
+      yielded: true,
+      livenessState: "paused",
+      stopReason: "end_turn",
+      status: "ok",
+    },
+  };
+  const completionEvent: LifecycleEvent = {
+    sessionId: started.sessionId,
+    runId: "original-run",
+    clientRunId: "private-continuation",
+    ts: 3_000,
+    data: { phase: "end", startedAt: 1_000, endedAt: 3_000, stopReason: "stop", status: "ok" },
+  };
+  const expectedWriter = {
+    sessionId: started.sessionId,
+    runId: "original-run",
+    lifecycleRevision: "yield-revision",
+  };
+
+  it("retains logical running after yield, then publishes done from the bound final", async () => {
+    const yielded = await persistLifecycle(started, yieldEvent);
+    expect(yielded).toMatchObject({
+      status: "running",
+      lifecycleRunId: "original-run",
+      endedAt: 2_000,
+    });
+    expect(present(yielded).describe.status).toBe("running");
+    expect(present(yielded).list).toMatchObject({ status: "running", hasActiveRun: false });
+    const completed = await persistLifecycle(yielded, completionEvent, { expectedWriter });
+    expect(present(completed).describe.status).toBe("done");
+    expect(present(completed).list).toMatchObject({ status: "done", hasActiveRun: false });
+    // Both list and describe present this exact owner-published lifecycle state.
+    expect(completed).toMatchObject({
+      status: "done",
+      lastRunId: "private-continuation",
+      startedAt: 1_000,
+      endedAt: 3_000,
+      runtimeMs: 2_000,
+    });
+    expect(completed.lifecycleRunId).toBeUndefined();
+    expect(
+      deriveGatewaySessionLifecycleSnapshot({ session: completed, event: completionEvent }),
+    ).toMatchObject({ status: "done", endedAt: 3_000 });
+  });
+
+  it.each([
+    [
+      "new foreground lifecycle owner",
+      { lifecycleRunId: "new-user-run", status: "running", startedAt: 2_500 },
+    ],
+    ["new foreground writer before lifecycle publication", { activeWriterRunId: "new-user-run" }],
+    ["new session incarnation", { sessionId: "replacement-parent" }],
+    ["new lifecycle revision", { lifecycleRevision: "replacement-revision" }],
+  ] as const)("rejects old private settlement after %s", async (_label, change) => {
+    const yielded = await persistLifecycle(started, yieldEvent);
+    const current = { ...yielded, ...change } as SessionEntry;
+    expect(await persistLifecycle(current, completionEvent, { expectedWriter })).toEqual(current);
+  });
+
+  it("cannot project an explicitly yielded continuation as terminal", () => {
+    expect(
+      deriveGatewaySessionLifecycleSnapshot({ session: started, event: yieldEvent }),
+    ).toMatchObject({ status: "running", endedAt: 2_000 });
+  });
+});

+async function runSuspensionFixture(scenario: string): Promise<void> {
+  const queue = createChannelIngressQueue<{ version: 1; rawEvent: string }>({
+    channelId: "test",
+    accountId: "gateway-suspension",
+    stateDir,
+  });
+  let claims = 0;
+  const claimNext = queue.claimNext.bind(queue);
+  queue.claimNext = async (...args) => {
+    const claim = await claimNext(...args);
+    if (claim) {
+      claims += 1;
+    }
+    return claim;
+  };
+  let releasePrune = () => {};
+  const pruneGate = new Promise<void>((resolve) => {
+    releasePrune = resolve;
+  });
+  let markPruneStarted = () => {};
+  const pruneStarted = new Promise<void>((resolve) => {
+    markPruneStarted = resolve;
+  });
+  const racesPrune = scenario === "prepared-prune-race";
+  if (racesPrune) {
+    const prune = queue.prune.bind(queue);
+    queue.prune = async (...args) => {
+      markPruneStarted();
+      await pruneGate;
+      return await prune(...args);
+    };
+  }
+  let deliveries = 0;
+  const activity: boolean[] = [];
+  const ingress = createChannelIngressMonitor<
+    { id: string; text: string },
+    string,
+    { version: 1; rawEvent: string }
+  >({
+    queue,
+    inspect: (raw) => ({ eventId: raw.id, laneKey: "lane:a" }),
+    payload: {
+      storage: "raw-event",
+      version: 1,
+      serialize: (raw) => JSON.stringify(raw),
+      deserialize: (body) => JSON.parse(body) as { id: string; text: string },
+      createClaimError: (kind) => new Error(kind),
+    },
+    deliver: async (_raw, lifecycle) => {
+      await enqueueCommandInLane("session:ingress-suspend-proof", async () => {
+        deliveries += 1;
+        await lifecycle.onAdopted();
+      });
+    },
+    pollIntervalMs: 60_000,
+    retention: { pruneIntervalMs: 60_000 },
+    drain: {
+      adoptionStallTimeoutMs: 5_000,
+      retryPolicy: { baseMs: 1_000, maxMs: 1_000 },
+      resolveNonRetryableFailure: () => null,
+    },
+    onActivityChange: (active) => activity.push(active),
+  });
+  await queue.enqueue(
+    "event-suspend",
+    {
+      version: 1,
+      rawEvent: JSON.stringify({ id: "event-suspend", text: "queued before suspension" }),
+    },
+    { laneKey: "lane:a" },
+  );
+  if (racesPrune) {
+    ingress.start();
+    await pruneStarted;
+  }
+  const lease = tryBeginGatewaySuspendAdmission(() => {});
+  if (!lease) {
+    throw new Error("suspension lease was not acquired");
+  }
+  if (scenario.startsWith("draining-")) {
+    if (!lease.drain()) {
+      throw new Error("suspension did not enter draining");
+    }
+  } else if (scenario.startsWith("prepared-")) {
+    if (!lease.commit()) {
+      throw new Error("suspension did not enter prepared");
+    }
+  } else if (scenario !== "preparing-rollback") {
+    throw new Error(`unknown suspension scenario: ${scenario}`);
+  }
+  const phase = getGatewaySuspendAdmissionPhase();
+  process.send?.({ type: "ingress-fence-closed" });
+  if (racesPrune) {
+    releasePrune();
+  } else {
+    ingress.start();
+  }
+
+  // The parent's deadline owns liveness if retry microtasks starve this turn.
+  await nextTurn();
+  const deliveriesWhileClosed = deliveries;
+  const claimsWhileClosed = claims;
+  const pendingWhileClosed = (await queue.listPending({ limit: "all" })).map((event) => ({
+    id: event.id,
+    attempts: event.attempts,
+  }));
+  const activeRoots = getActiveGatewayRootWorkCount();
+  if (scenario === "prepared-stop" || scenario === "draining-pause") {
+    const idle = ingress.waitForIdle();
+    await (scenario === "prepared-stop" ? ingress.stop() : ingress.pause());
+    await idle;
+  }
+  if (!(scenario === "preparing-rollback" ? lease.rollback() : lease.release())) {
+    throw new Error("suspension did not reopen admission");
+  }
+  await ingress.waitForIdle();
+  const pendingAfterSettlement = (await queue.listPending({ limit: "all" })).map(
+    (event) => event.id,
+  );
+  await ingress.stop();
+  closeOpenClawStateDatabaseForTest();
+  process.send?.({
+    type: "ingress-drain-proof",
+    proof: {
+      phase,
+      activeRoots,
+      deliveriesWhileClosed,
+      claimsWhileClosed,
+      pendingWhileClosed,
+      deliveriesAfterSettlement: deliveries,
+      pendingAfterSettlement,
+      finalActivity: activity.at(-1),
+    },
+  });
+}

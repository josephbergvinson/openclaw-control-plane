+import type {
+  AgentHarnessTaskRecord,
+  AgentHarnessTaskRuntimeScope,
+} from "openclaw/plugin-sdk/agent-harness-task-runtime";
+import { describe, expect, it, vi } from "vitest";
+import {
+  CodexNativeSubagentMonitor,
+  createClient,
+  createRuntime,
+  createRecordedRuntime,
+  createTaskScope,
+  notifyChildStarted,
+  nativeCompletionNotification,
+  registerDetachedChild,
+  directSpawnItem,
+  taskRecord,
+} from "./native-subagent-monitor.test-support.js";
+
+describe("native inline continuation custody", () => {
+  it("does not reopen parent-session input custody in a fresh monitor", async () => {
+    const persisted = taskRecord({
+      childThreadId: "child-thread",
+      status: "succeeded",
+      deliveryStatus: "session_queued",
+      endedAt: Date.now(),
+    });
+    for (let generation = 0; generation < 2; generation++) {
+      const client = createClient();
+      const runtime = createRuntime();
+      runtime.listTaskRecords.mockReturnValue([persisted]);
+      const monitor = new CodexNativeSubagentMonitor(client as never, runtime);
+      await registerDetachedChild(client, monitor);
+      await client.notify(nativeCompletionNotification());
+      expect(runtime.deliverAgentHarnessTaskCompletion).not.toHaveBeenCalled();
+      expect(runtime.setDetachedTaskDeliveryStatusByRunId).not.toHaveBeenCalled();
+      client.close();
+    }
+  });
+
+  it.each(["return", "throw"] as const)(
+    "does not retry or overwrite parent-session custody after an in-flight delivery %s",
+    async (resolution) => {
+      vi.useFakeTimers();
+      try {
+        const client = createClient();
+        const records = new Map<string, AgentHarnessTaskRecord>();
+        const runtime = createRecordedRuntime(records);
+        runtime.deliverAgentHarnessTaskCompletion.mockImplementationOnce(async () => {
+          const persisted = records.get("codex-thread:child-thread");
+          if (!persisted || persisted.runId !== "codex-thread:child-thread") {
+            throw new Error("expected the accepted task record before parent delivery");
+          }
+          records.set(persisted.runId, { ...persisted, deliveryStatus: "session_queued" });
+          if (resolution === "throw") {
+            throw new Error("parent final disposition write failed");
+          }
+          return { delivered: false, path: "none", error: "parent final disposition unresolved" };
+        });
+        const monitor = new CodexNativeSubagentMonitor(client as never, runtime, {
+          completionDeliveryRetryDelaysMs: [10],
+        });
+        await registerDetachedChild(client, monitor);
+        runtime.setDetachedTaskDeliveryStatusByRunId.mockClear();
+        await client.notify(nativeCompletionNotification());
+        await vi.advanceTimersByTimeAsync(100);
+        expect(runtime.deliverAgentHarnessTaskCompletion).toHaveBeenCalledTimes(1);
+        expect(runtime.setDetachedTaskDeliveryStatusByRunId.mock.calls).toEqual([
+          [{ runId: "codex-thread:child-thread", deliveryStatus: "pending" }],
+        ]);
+        expect(records.get("codex-thread:child-thread")?.deliveryStatus).toBe("session_queued");
+        client.close();
+      } finally {
+        vi.useRealTimers();
+      }
+    },
+  );
+
+  it("binds retained completions to the exact spawn turn and publishes siblings before parent settlement", async () => {
+    const client = createClient();
+    const base = createRuntime();
+    const oldScope = createTaskScope("agent:main:cron:job:run:one");
+    const scope = createTaskScope(oldScope.requesterSessionKey);
+    const retained = new Set<string>();
+    const retainContinuation = vi.fn((runId: string, owner: AgentHarnessTaskRuntimeScope) => {
+      expect(owner).toBe(scope);
+      expect(base.createRunningTaskRun).toHaveBeenCalledWith(expect.objectContaining({ runId }));
+      retained.add(runId);
+      return true;
+    });
+    const taskRuntime = base.createAgentHarnessTaskRuntime();
+    base.createAgentHarnessTaskRuntime.mockImplementation(() => ({
+      ...taskRuntime,
+      retainContinuation,
+    }));
+    let settle!: () => void;
+    const final = new Promise<void>((resolve) => {
+      settle = resolve;
+    });
+    base.deliverAgentHarnessTaskCompletion.mockImplementation(async () => {
+      await final;
+      return { delivered: true, path: "direct" };
+    });
+    const runtime = {
+      ...base,
+      getAgentHarnessTaskContinuationStatus: (
+        owner: AgentHarnessTaskRuntimeScope,
+        runId: string,
+      ) => (owner === scope && retained.has(runId) ? ("retained" as const) : undefined),
+    };
+    const monitor = new CodexNativeSubagentMonitor(client as never, runtime);
+    const prior = monitor.registerParent({
+      parentThreadId: "parent-thread",
+      requesterSessionKey: scope.requesterSessionKey,
+      taskRuntimeScope: oldScope,
+    });
+    prior.bindTurn("old-turn");
+    const parent = monitor.registerParent({
+      parentThreadId: "parent-thread",
+      requesterSessionKey: scope.requesterSessionKey,
+      taskRuntimeScope: scope,
+      claimDirectChild: () => () => undefined,
+    });
+    parent.bindTurn("current-turn");
+    for (const child of ["child-one", "child-two"]) {
+      await notifyChildStarted(client, "parent-thread", child);
+      await client.notify({
+        method: "item/completed",
+        params: {
+          threadId: "parent-thread",
+          turnId: "current-turn",
+          item: directSpawnItem("v2", "parent-thread", child),
+        },
+      });
+    }
+    expect(retainContinuation).toHaveBeenCalledTimes(2);
+    await prior.unregister();
+    await parent.unregister();
+    await client.notify(nativeCompletionNotification({ agentPath: "child-one", result: "one" }));
+    await client.notify(nativeCompletionNotification({ agentPath: "child-two", result: "two" }));
+    expect(base.deliverAgentHarnessTaskCompletion).toHaveBeenCalledTimes(2);
+    for (const [request] of base.deliverAgentHarnessTaskCompletion.mock.calls) {
+      expect(request).toMatchObject({ scope });
+    }
+    expect(base.setDetachedTaskDeliveryStatusByRunId).not.toHaveBeenCalledWith(
+      expect.objectContaining({ deliveryStatus: "delivered" }),
+    );
+    settle();
+    await vi.waitFor(() =>
+      expect(
+        base.setDetachedTaskDeliveryStatusByRunId.mock.calls.filter(
+          ([request]) => request.deliveryStatus === "delivered",
+        ),
+      ).toHaveLength(2),
+    );
+    monitor.dispose();
+  });
+
+  it("does not adopt an older owner's child lease through a later duplicate spawn event", async () => {
+    const client = createClient();
+    const runtime = createRuntime();
+    const taskRuntime = runtime.createAgentHarnessTaskRuntime();
+    const retainContinuation = vi.fn(() => true);
+    runtime.createAgentHarnessTaskRuntime.mockImplementation(() => ({
+      ...taskRuntime,
+      retainContinuation,
+    }));
+    const monitor = new CodexNativeSubagentMonitor(client as never, runtime);
+    monitor.registerParent({
+      parentThreadId: "parent-thread",
+      requesterSessionKey: "agent:main:main",
+      taskRuntimeScope: createTaskScope("agent:main:main"),
+    });

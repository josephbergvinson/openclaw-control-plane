+      admission.retireSource();
+      return { taskTrackingMode: "none" };
+    });
+    expect(await prepareAgentRunDispatch(admission.params)).toBeUndefined();
+    expect(admission.io.emitAcceptance).toHaveBeenCalledWith([false, undefined, expect.anything()]);
+    expect(admission.params.context.chatAbortControllers.size).toBe(0);
+  });
+
+  it("prevents execution when the accepted child is cancelled after source cleanup", async () => {
+    const admission = createAdmission();

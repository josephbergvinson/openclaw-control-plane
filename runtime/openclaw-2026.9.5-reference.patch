+    expect(mocks.send).toHaveBeenCalledOnce();
+    expect(mocks.send.mock.calls[0]?.[0].payload.text).toBe("initial command result");
+    expect(service.cron.getJob(job.id)?.state).toMatchObject({
+      lastRunStatus: status,
+      lastDeliveryStatus: "delivered",
+    });
+  });
+
+  it("keeps an opted-in repair with delivery:none private", async () => {
+    const { service, job, marker } = await fixture({ delivery: { mode: "none" } });
+    mocks.agent.mockImplementation(async () => {
+      await fs.writeFile(marker, "restored");
+      return { status: "ok" };
+    });

diff --git a/apps/macos/Sources/OpenClawMacCLI/LocalGatewayAuthIPC.swift b/apps/macos/Sources/OpenClawMacCLI/LocalGatewayAuthIPC.swift
new file mode 100644
index 0000000000000000000000000000000000000000..27e376f4b3716d56026a344d7316d32e50796d3d
--- /dev/null
+++ b/apps/macos/Sources/OpenClawMacCLI/LocalGatewayAuthIPC.swift
@@ -0,0 +1,265 @@
+import Darwin
+import Foundation
+import Security
+import Subprocess
+
+@_silgen_name("csops")
+private func localAuthCSOps(
+    _ pid: pid_t,
+    _ operation: UInt32,
+    _ address: UnsafeMutableRawPointer?,
+    _ size: Int) -> Int32
+
+/// Only a matching signed app (or this boolean-only diagnostic) may own the auth helper.
+/// Process paths, ancestry and code hashes come from the kernel, never request arguments.
+enum LocalGatewayAuthIPC {
+    struct ProcessIdentity {
+        let pid: pid_t
+        let parent: pid_t
+        let startedSeconds: UInt64
+        let startedMicroseconds: UInt64
+        let path: String
+    }
+
+    private static func process(_ pid: pid_t) -> ProcessIdentity? {
+        var info = proc_bsdinfo()
+        let size = Int32(MemoryLayout<proc_bsdinfo>.size)
+        guard proc_pidinfo(pid, PROC_PIDTBSDINFO, 0, &info, size) == size,
+              info.pbi_uid == geteuid()
+        else { return nil }
+        var bytes = [UInt8](repeating: 0, count: 4096)
+        guard proc_pidpath(pid, &bytes, UInt32(bytes.count)) > 0 else { return nil }
+        guard let path = String(bytes: bytes.prefix { $0 != 0 }, encoding: .utf8) else { return nil }
+        return ProcessIdentity(
+            pid: pid,
+            parent: pid_t(info.pbi_ppid),
+            startedSeconds: info.pbi_start_tvsec,
+            startedMicroseconds: info.pbi_start_tvusec,
+            path: path)
+    }
+
+    private static func bundle() -> URL? {
+        guard let own = self.process(getpid()) else { return nil }
+        let executable = URL(fileURLWithPath: own.path).resolvingSymlinksInPath()
+        let bundle = executable.deletingLastPathComponent().deletingLastPathComponent().deletingLastPathComponent()
+        guard executable.lastPathComponent == "openclaw-mac",
+              executable.deletingLastPathComponent().lastPathComponent == "MacOS",
+              bundle.pathExtension == "app"
+        else { return nil }
+        return bundle
+    }
+
+    private static func signedHash(pid: pid_t, expected: URL) -> Data? {
+        var own: SecCode?
+        var ownStatic: SecStaticCode?
+        var ownInformation: CFDictionary?
+        guard SecCodeCopySelf(SecCSFlags(), &own) == errSecSuccess, let own,
+              SecCodeCheckValidity(own, SecCSFlags(), nil) == errSecSuccess,
+              SecCodeCopyStaticCode(own, SecCSFlags(), &ownStatic) == errSecSuccess, let ownStatic,
+              SecCodeCopySigningInformation(ownStatic, SecCSFlags(rawValue: kSecCSSigningInformation), &ownInformation)
+              == errSecSuccess,
+              let ownInformation,
+              let ownTeam = (ownInformation as NSDictionary)[kSecCodeInfoTeamIdentifier] as? String,
+              !ownTeam.isEmpty,
+              let ownCertificates = (ownInformation as NSDictionary)[kSecCodeInfoCertificates] as? [SecCertificate],
+              let ownCertificate = ownCertificates.first
+        else { return nil }
+        var expectedCode: SecStaticCode?
+        var requirement: SecRequirement?
+        var information: CFDictionary?
+        guard SecStaticCodeCreateWithPath(expected as CFURL, SecCSFlags(), &expectedCode) == errSecSuccess,
+              let expectedCode,
+              SecStaticCodeCheckValidity(expectedCode, SecCSFlags(), nil) == errSecSuccess,
+              SecCodeCopyDesignatedRequirement(expectedCode, SecCSFlags(), &requirement) == errSecSuccess,
+              let requirement,
+              SecCodeCopySigningInformation(expectedCode, SecCSFlags(rawValue: kSecCSSigningInformation), &information)
+              == errSecSuccess,
+              let information,
+              (information as NSDictionary)[kSecCodeInfoTeamIdentifier] as? String == ownTeam,
+              let certificates = (information as NSDictionary)[kSecCodeInfoCertificates] as? [SecCertificate],
+              let certificate = certificates.first,
+              SecCertificateCopyData(certificate) as Data == SecCertificateCopyData(ownCertificate) as Data,
+              let identifier = (information as NSDictionary)[kSecCodeInfoIdentifier] as? String,
+              expected.lastPathComponent == "OpenClaw"
+              ? (identifier == "ai.openclaw.mac" || identifier.hasPrefix("ai.openclaw.mac."))
+              : expected.lastPathComponent == "node"
+              ? identifier == "node"
+              : identifier == (ownInformation as NSDictionary)[kSecCodeInfoIdentifier] as? String,
+              let expectedHash = (information as NSDictionary)[kSecCodeInfoUnique] as? Data
+        else { return nil }
+        var guest: SecCode?
+        let attributes = [kSecGuestAttributePid as String: NSNumber(value: pid)] as CFDictionary
+        guard SecCodeCopyGuestWithAttributes(nil, attributes, SecCSFlags(), &guest) == errSecSuccess,
+              let guest,
+              SecCodeCheckValidity(guest, SecCSFlags(), requirement) == errSecSuccess
+        else { return nil }
+        // Same requirement alone could admit a replaced bundle's old mapped executable.
+        var hash = [UInt8](repeating: 0, count: 20)
+        guard hash.withUnsafeMutableBytes({ localAuthCSOps(pid, 5, $0.baseAddress, $0.count) }) == 0,
+              Data(hash) == expectedHash
+        else { return nil }
+        return expectedHash
+    }
+
+    private static func sealedBundle(_ bundle: URL) -> Bool {
+        // A signed interpreter alone does not authenticate the JavaScript it executes.
+        // Validate the containing app's resource seal and bind its signer to this running verifier.
+        var own: SecCode?
+        var ownStatic: SecStaticCode?
+        var ownInformation: CFDictionary?
+        var app: SecStaticCode?
+        var appInformation: CFDictionary?
+        let flags = SecCSFlags(rawValue: kSecCSStrictValidate | kSecCSCheckNestedCode | kSecCSCheckAllArchitectures)
+        guard SecCodeCopySelf(SecCSFlags(), &own) == errSecSuccess, let own,
+              SecCodeCheckValidity(own, SecCSFlags(), nil) == errSecSuccess,
+              SecCodeCopyStaticCode(own, SecCSFlags(), &ownStatic) == errSecSuccess, let ownStatic,
+              SecCodeCopySigningInformation(ownStatic, SecCSFlags(rawValue: kSecCSSigningInformation), &ownInformation)
+              == errSecSuccess,
+              let ownInformation,
+              let ownTeam = (ownInformation as NSDictionary)[kSecCodeInfoTeamIdentifier] as? String,
+              !ownTeam.isEmpty,
+              let ownCertificates = (ownInformation as NSDictionary)[kSecCodeInfoCertificates] as? [SecCertificate],
+              let ownCertificate = ownCertificates.first,
+              SecStaticCodeCreateWithPath(bundle as CFURL, SecCSFlags(), &app) == errSecSuccess, let app,
+              SecStaticCodeCheckValidity(app, flags, nil) == errSecSuccess,
+              SecCodeCopySigningInformation(app, SecCSFlags(rawValue: kSecCSSigningInformation), &appInformation)
+              == errSecSuccess,
+              let appInformation,
+              (appInformation as NSDictionary)[kSecCodeInfoTeamIdentifier] as? String == ownTeam,
+              let certificates = (appInformation as NSDictionary)[kSecCodeInfoCertificates] as? [SecCertificate],
+              let certificate = certificates.first,
+              SecCertificateCopyData(certificate) as Data == SecCertificateCopyData(ownCertificate) as Data,
+              let identifier = (appInformation as NSDictionary)[kSecCodeInfoIdentifier] as? String,
+              identifier == "ai.openclaw.mac" || identifier.hasPrefix("ai.openclaw.mac.")
+        else { return false }
+        return true
+    }
+
+    struct DirectAppParentEnvironment {
+        var bundle: () -> URL?
+        var parentPID: () -> pid_t
+        var process: (pid_t) -> ProcessIdentity?
+        var sealedBundle: (URL) -> Bool
+        var signedHash: (pid_t, URL) -> Data?
+    }
+
+    /// Unlike the Gateway's Node/probe chain, a credential pipe belongs only to
+    /// the actual app that created it. Nothing supplied on stdin grants access.
+    static func directAppParentIdentity() -> String? {
+        self.directAppParentIdentity(environment: .init(
+            bundle: self.bundle,
+            parentPID: { getppid() },
+            process: self.process,
+            sealedBundle: self.sealedBundle,
+            signedHash: { self.signedHash(pid: $0, expected: $1) }))
+    }
+
+    static func directAppParentIdentity(environment: DirectAppParentEnvironment) -> String? {
+        guard let bundle = environment.bundle(),
+              let owner = environment.process(environment.parentPID())
+        else { return nil }
+        let app = bundle.appendingPathComponent("Contents/MacOS/OpenClaw")
+        guard owner.path == app.path,
+              environment.sealedBundle(bundle),
+              let hash = environment.signedHash(owner.pid, app),
+              environment.parentPID() == owner.pid,
+              let current = environment.process(owner.pid),
+              current.path == owner.path,
+              current.startedSeconds == owner.startedSeconds,
+              current.startedMicroseconds == owner.startedMicroseconds
+        else { return nil }
+        return "\(owner.pid):\(owner.startedSeconds):\(owner.startedMicroseconds):" +
+            hash.map { String(format: "%02x", $0) }.joined()
+    }
+
+    static func parentIdentity() -> String? {
+        guard let bundle = self.bundle(),
+              self.sealedBundle(bundle),
+              let helper = self.process(getppid()),
+              let owner = self.process(helper.parent)
+        else { return nil }
+        #if arch(arm64)
+        let architecture = "arm64"
+        #else
+        let architecture = "x86_64"
+        #endif
+        let node = bundle.appendingPathComponent("Contents/Resources/node-worker/\(architecture)/bin/node")
+        let app = bundle.appendingPathComponent("Contents/MacOS/OpenClaw")
+        let probe = bundle.appendingPathComponent("Contents/MacOS/openclaw-mac")
+        guard helper.path == node.resolvingSymlinksInPath().path,
+              self.signedHash(pid: helper.pid, expected: node) != nil,
+              owner.path == app.path || owner.path == probe.path,
+              let hash = self.signedHash(pid: owner.pid, expected: URL(fileURLWithPath: owner.path)),
+              let current = self.process(helper.pid), current.parent == owner.pid,
+              current.startedSeconds == helper.startedSeconds,
+              current.startedMicroseconds == helper.startedMicroseconds,
+              let currentOwner = self.process(owner.pid), currentOwner.path == owner.path,
+              currentOwner.startedSeconds == owner.startedSeconds,
+              currentOwner.startedMicroseconds == owner.startedMicroseconds
+        else { return nil }
+        return "\(owner.pid):\(owner.startedSeconds):\(owner.startedMicroseconds):" +
+            hash.map { String(format: "%02x", $0) }.joined()
+    }
+
+    static func probe() async {
+        var tokenPresent = false
+        var passwordPresent = false
+        do {
+            guard let bundle = self.bundle(), self.sealedBundle(bundle), isatty(STDIN_FILENO) == 0
+            else { throw ProbeError.unavailable }
+            var input = Data()
+            while let chunk = try FileHandle.standardInput.read(upToCount: 4096), !chunk.isEmpty {
+                input.append(chunk)
+                guard input.count <= 32 * 1024 else { throw ProbeError.unavailable }
+            }
+            #if arch(arm64)
+            let architecture = "arm64"
+            #else
+            let architecture = "x86_64"
+            #endif
+            let root = bundle.appendingPathComponent("Contents/Resources/node-worker/\(architecture)")
+            var options = PlatformOptions()
+            options.createSession = true
+            options.teardownSequence = [.send(signal: .kill, toProcessGroup: true, allowedDurationToNextStep: .zero)]
+            var environment: [Environment.Key: String] = [:]
+            for (key, value) in ProcessInfo.processInfo.environment {
+                guard key != "NODE_OPTIONS", key != "NODE_PATH", key != "LD_PRELOAD",
+                      !key.hasPrefix("DYLD_"), let name = Environment.Key(rawValue: key) else { continue }
+                environment[name] = value
+            }
+            environment["OPENCLAW_NO_RESPAWN"] = "1"
+            let configuration = Configuration(
+                executable: .path(.init(root.appendingPathComponent("bin/node").path)),
+                arguments: Arguments([
+                    root.appendingPathComponent("lib/node_modules/openclaw/dist/entry.js").path,
+                    "node", "worker", "--resolve-local-auth",
+                ]),
+                environment: .custom(environment),
+                platformOptions: options)
+            let request = Array(input)
+            let data = try await withThrowingTaskGroup(of: Data.self) { group in
+                group.addTask {
+                    let result = try await Subprocess.run(
+                        configuration, input: .array(request), output: .bytes(limit: 32 * 1024), error: .discarded)
+                    guard result.terminationStatus.isSuccess else { throw ProbeError.unavailable }
+                    return Data(result.standardOutput)
+                }
+                group.addTask {
+                    try await Task.sleep(for: .seconds(60))
+                    throw ProbeError.unavailable
+                }
+                defer { group.cancelAll() }
+                guard let data = try await group.next() else { throw ProbeError.unavailable }
+                return data
+            }
+            let result = try JSONSerialization.jsonObject(with: data) as? [String: Any]
+            tokenPresent = (result?["token"] as? String)?.isEmpty == false
+            passwordPresent = (result?["password"] as? String)?.isEmpty == false
+        } catch {}
+        let ok = tokenPresent || passwordPresent
+        print("{\"ok\":\(ok),\"tokenPresent\":\(tokenPresent),\"passwordPresent\":\(passwordPresent)}")
+        if !ok { exit(1) }
+    }
+
+    private enum ProbeError: Error { case unavailable }
+}
diff --git a/apps/macos/Sources/OpenClawMacCLI/NativeCredentialIPC.swift b/apps/macos/Sources/OpenClawMacCLI/NativeCredentialIPC.swift
new file mode 100644
index 0000000000000000000000000000000000000000..a552b7453a1805a87e99a3b6f42a20c0a197bbbc
--- /dev/null
+++ b/apps/macos/Sources/OpenClawMacCLI/NativeCredentialIPC.swift
@@ -0,0 +1,143 @@
+import Darwin
+import Foundation
+import OpenClawKit
+import OSLog
+import Security
+
+/// A private pipe to the signed app, not an operator credential-export command.
+enum NativeCredentialIPC {
+    enum Diagnostic: String, Sendable {
+        case entryAdmission = "entry_admission"
+        case requestBinding = "request_binding"
+        case parentAdmission = "parent_admission"
+        case directRead = "direct_read"
+        case fallbackAdmission = "fallback_admission"
+        case parentBeforeFallback = "parent_before_fallback"
+        case fallbackRead = "fallback_read"
+        case parentAfterFallback = "parent_after_fallback"
+        case fallbackRevalidation = "fallback_revalidation"
+        case parentBeforeConsume = "parent_before_consume"
+        case delivering
+        case finished
+        case refused
+        case unavailable
+        case cancelled
+        case failed
+    }
+
+    private static let logger = Logger(subsystem: "ai.openclaw.mac", category: "native-credential")
+
+    private static func record(_ diagnostic: Diagnostic) {
+        // Only fixed stages leave this helper; stdout remains the private pipe.
+        self.logger.info("native credential helper: \(diagnostic.rawValue, privacy: .public)")
+    }
+
+    @MainActor
+    struct Environment {
+        var parentIdentity: () -> String?
+        var direct: (NativeCredentialBinding) throws -> Data
+        var preflight: (NativeCredentialBinding) throws -> NativeCredentialSecurityTool.Admission
+        var read: (NativeCredentialSecurityTool.Admission) async throws -> Data
+
+        static let live = Environment(
+            parentIdentity: { LocalGatewayAuthIPC.directAppParentIdentity() },
+            direct: { binding in
+                var value = Data()
+                try NativeCredentialKeychain.withSecret(binding: binding) { value = Data($0.utf8) }
+                return value
+            },
+            preflight: { try NativeCredentialSecurityTool.preflight($0) },
+            read: NativeCredentialSecurityTool.read)
+    }
+
+    static func binding(request: Data, hostID: String) throws -> NativeCredentialBinding {
+        guard request.count <= 4096,
+              let binding = try? JSONDecoder().decode(NativeCredentialBinding.self, from: request)
+        else { throw NativeCredentialError.invalidBinding }
+        try binding.validate()
+        guard binding.hostID.caseInsensitiveCompare(hostID) == .orderedSame else {
+            throw NativeCredentialError.refused
+        }
+        return binding
+    }
+
+    private static func isPipe(_ descriptor: Int32) -> Bool {
+        var info = stat()
+        return fstat(descriptor, &info) == 0 && info.st_mode & S_IFMT == S_IFIFO
+    }
+
+    @MainActor
+    static func withSecret(
+        binding: NativeCredentialBinding,
+        parent: String,
+        environment: Environment = .live,
+        record: (Diagnostic) -> Void = Self.record,
+        consume: (Data) throws -> Void) async throws
+    {
+        record(.parentAdmission)
+        guard environment.parentIdentity() == parent else { throw NativeCredentialError.refused }
+        var value: Data
+        do {
+            record(.directRead)
+            value = try environment.direct(binding)
+        } catch NativeCredentialError.unavailable {
+            record(.fallbackAdmission)
+            let admission = try environment.preflight(binding)
+            record(.parentBeforeFallback)
+            guard environment.parentIdentity() == parent else { throw NativeCredentialError.refused }
+            record(.fallbackRead)
+            value = try await environment.read(admission)
+            do {
+                try Task.checkCancellation()
+                record(.parentAfterFallback)
+                guard environment.parentIdentity() == parent else { throw NativeCredentialError.refused }
+                record(.fallbackRevalidation)
+                guard try environment.preflight(binding) == admission else { throw NativeCredentialError.refused }
+            } catch {
+                value.resetBytes(in: value.startIndex..<value.endIndex)
+                throw error
+            }
+        }
+        defer { value.resetBytes(in: value.startIndex..<value.endIndex) }
+        try Task.checkCancellation()
+        record(.parentBeforeConsume)
+        guard environment.parentIdentity() == parent else { throw NativeCredentialError.refused }
+        record(.delivering)
+        try consume(value)
+    }
+
+    @MainActor
+    static func run() async {
+        do {
+            self.record(.entryAdmission)
+            guard self.isPipe(STDIN_FILENO), self.isPipe(STDOUT_FILENO),
+                  let parent = LocalGatewayAuthIPC.directAppParentIdentity(),
+                  getpgrp() == getpid(), getsid(0) == getpid(),
+                  SecKeychainSetUserInteractionAllowed(false) == errSecSuccess
+            else { throw NativeCredentialError.refused }
+            // The legacy policy is process-wide. This short-lived child has no
+            // concurrent app Keychain operations and never enables UI again.
+            var input = Data()
+            while let chunk = try FileHandle.standardInput.read(upToCount: 4096), !chunk.isEmpty {
+                input.append(chunk)
+                guard input.count <= 4096 else { throw NativeCredentialError.invalidBinding }
+            }
+            self.record(.requestBinding)
+            let binding = try self.binding(request: input, hostID: NativeCredentialHost.identity())
+            try await self.withSecret(binding: binding, parent: parent) { output in
+                try FileHandle.standardOutput.write(contentsOf: output)
+            }
+            self.record(.finished)
+        } catch {
+            // Framework errors and process output must never become model data.
+            if error is CancellationError {
+                self.record(.cancelled)
+            } else if let credentialError = error as? NativeCredentialError {
+                self.record(credentialError == .unavailable ? .unavailable : .refused)
+            } else {
+                self.record(.failed)
+            }
+            exit(1)
+        }
+    }
+}
diff --git a/apps/macos/Sources/OpenClawMacCLI/NativeCredentialSecurityTool.swift b/apps/macos/Sources/OpenClawMacCLI/NativeCredentialSecurityTool.swift
new file mode 100644
index 0000000000000000000000000000000000000000..791ada261470b7c0b30a84cbe85c316df16006e1
--- /dev/null
+++ b/apps/macos/Sources/OpenClawMacCLI/NativeCredentialSecurityTool.swift
@@ -0,0 +1,164 @@
+import Foundation
+import LocalAuthentication
+import OpenClawKit
+import Security
+import Subprocess
+
+/// Compatibility with existing items whose creator ACL trusts Apple's reader.
+/// This never enrolls trust, unlocks a Keychain, or changes a credential.
+enum NativeCredentialSecurityTool {
+    struct Admission: Equatable, Sendable {
+        let alias: String
+        let metadata: Data
+        let metadataText: String
+        let persistentReference: Data
+        let keychainPath: String
+
+        var arguments: [String] {
+            [
+                "find-generic-password", "-g", "-s", NativeCredentialKeychain.service,
+                "-a", self.alias, "-G", self.metadataText, self.keychainPath,
+            ]
+        }
+    }
+
+    static func admit(
+        binding: NativeCredentialBinding,
+        storedMetadata: Data,
+        persistentReference: Data,
+        keychainPath: String,
+        unlocked: Bool,
+        readerTrusted: Bool) throws -> Admission
+    {
+        try binding.validate()
+        let encoder = JSONEncoder()
+        encoder.outputFormatting = [.sortedKeys]
+        guard let metadataText = String(data: storedMetadata, encoding: .utf8),
+              try storedMetadata == (encoder.encode(binding)), !persistentReference.isEmpty,
+              keychainPath.hasPrefix("/"), !keychainPath.utf8.contains(0), unlocked, readerTrusted
+        else { throw NativeCredentialError.unavailable }
+        return Admission(
+            alias: binding.alias,
+            metadata: storedMetadata,
+            metadataText: metadataText,
+            persistentReference: persistentReference,
+            keychainPath: keychainPath)
+    }
+
+    static func preflight(_ binding: NativeCredentialBinding, keychain: SecKeychain? = nil) throws -> Admission {
+        let context = LAContext()
+        context.interactionNotAllowed = true
+        var query: [String: Any] = [
+            kSecClass as String: kSecClassGenericPassword,
+            kSecAttrService as String: NativeCredentialKeychain.service,
+            kSecAttrAccount as String: binding.alias,
+            kSecUseAuthenticationContext as String: context,
+            kSecReturnAttributes as String: true,
+            kSecReturnPersistentRef as String: true,
+            kSecMatchLimit as String: kSecMatchLimitAll,
+        ]
+        // Explicit scope lets disposable OS qualification use the same owner
+        // without changing the user's default Keychain or search list.
+        if let keychain { query[kSecMatchSearchList as String] = [keychain] }
+        var result: CFTypeRef?
+        guard SecItemCopyMatching(query as CFDictionary, &result) == errSecSuccess,
+              let rows = result as? [[String: Any]], rows.count == 1,
+              let row = rows.first,
+              let metadata = row[kSecAttrGeneric as String] as? Data,
+              let reference = row[kSecValuePersistentRef as String] as? Data
+        else { throw NativeCredentialError.unavailable }
+        var item: SecKeychainItem?
+        var keychain: SecKeychain?
+        guard SecKeychainItemCopyFromPersistentReference(reference as CFData, &item) == errSecSuccess,
+              let item,
+              SecKeychainItemCopyKeychain(item, &keychain) == errSecSuccess, let keychain
+        else { throw NativeCredentialError.unavailable }
+        var status: SecKeychainStatus = 0
+        var path = [CChar](repeating: 0, count: 4096)
+        var length = UInt32(path.count)
+        guard SecKeychainGetStatus(keychain, &status) == errSecSuccess,
+              SecKeychainGetPath(keychain, &length, &path) == errSecSuccess,
+              length > 0, Int(length) < path.count,
+              let keychainPath = String(bytes: path.prefix(Int(length)).map { UInt8(bitPattern: $0) }, encoding: .utf8)
+        else { throw NativeCredentialError.unavailable }
+        return try self.admit(
+            binding: binding,
+            storedMetadata: metadata,
+            persistentReference: reference,
+            keychainPath: keychainPath,
+            unlocked: status & UInt32(kSecUnlockStateStatus) != 0,
+            readerTrusted: self.readerTrusted(item))
+    }
+
+    private static func readerTrusted(_ item: SecKeychainItem) throws -> Bool {
+        var reader: SecStaticCode?
+        var requirement: SecRequirement?
+        guard SecStaticCodeCreateWithPath(
+            URL(fileURLWithPath: "/usr/bin/security") as CFURL,
+            SecCSFlags(),
+            &reader) == errSecSuccess,
+            let reader,
+            SecRequirementCreateWithString(
+                #"identifier "com.apple.security" and anchor apple"# as CFString,
+                SecCSFlags(),
+                &requirement) == errSecSuccess,
+            let requirement,
+            SecStaticCodeCheckValidity(reader, SecCSFlags(), requirement) == errSecSuccess
+        else { return false }
+        // Persistent-reference lookup may leave Security's database record
+        // lazy; CopyAccess cannot inspect its ACL until that record is loaded.
+        // A class-only read materializes it without requesting password data.
+        var itemClass: SecItemClass = .genericPasswordItemClass
+        guard SecKeychainItemCopyContent(item, &itemClass, nil, nil, nil) == errSecSuccess,
+              itemClass == .genericPasswordItemClass
+        else { throw NativeCredentialError.unavailable }
+        var access: SecAccess?
+        var list: CFArray?
+        guard SecKeychainItemCopyAccess(item, &access) == errSecSuccess, let access,
+              SecAccessCopyACLList(access, &list) == errSecSuccess,
+              let acls = list as? [SecACL]
+        else { throw NativeCredentialError.unavailable }
+        for acl in acls {
+            guard let authorizations = SecACLCopyAuthorizations(acl) as? [String],
+                  authorizations.contains(kSecACLAuthorizationDecrypt as String) else { continue }
+            var applications: CFArray?
+            var description: CFString?
+            var flags = SecKeychainPromptSelector(rawValue: 0)
+            guard SecACLCopyContents(acl, &applications, &description, &flags) == errSecSuccess,
+                  flags.rawValue == 0, let trusted = applications as? [SecTrustedApplication] else { continue }
+            if trusted.contains(where: { application in
+                var data: CFData?
+                guard SecTrustedApplicationCopyData(application, &data) == errSecSuccess, let data else { return false }
+                let path = (data as Data).prefix { $0 != 0 }
+                // Public SecTrustedApplicationCopyData returns the ACL path.
+                // The fixed reader is independently Apple-signature checked;
+                // Security still evaluates the stored requirement at lookup.
+                return String(bytes: path, encoding: .utf8) == "/usr/bin/security"
+            }) { return true }
+        }
+        return false
+    }
+
+    static func read(_ admission: Admission) async throws -> Data {
+        var options = PlatformOptions()
+        // The signed app's BoundedProcess owns this CLI's entire process group,
+        // including pipe-holding descendants. Do not detach this reader. Its
+        // 90-second deadline/cancellation kills the requesting client. Security
+        // has no no-UI flag: a lock/ACL race can briefly prompt, and OS dialog
+        // cleanup on client death must be qualified on the installed macOS.
+        options.createSession = false
+        options.teardownSequence = [.send(signal: .kill, toProcessGroup: false, allowedDurationToNextStep: .zero)]
+        let configuration = Configuration(
+            executable: .path("/usr/bin/security"),
+            arguments: Arguments(admission.arguments),
+            environment: .custom(["LC_CTYPE": "C", "PATH": "/usr/bin:/bin"]),
+            platformOptions: options)
+        let result = try await Subprocess.run(
+            configuration, input: .none, output: .discarded, error: .bytes(limit: 64 * 1024))
+        var captured = Data(result.standardError)
+        defer { captured.resetBytes(in: captured.startIndex..<captured.endIndex) }
+        guard result.terminationStatus.isSuccess else { throw NativeCredentialError.unavailable }
+        try Task.checkCancellation()
+        return try NativeCredentialSecurityValue.decode(captured)
+    }
+}
diff --git a/apps/macos/Sources/OpenClawMacCLI/NativeCredentialSecurityValue.swift b/apps/macos/Sources/OpenClawMacCLI/NativeCredentialSecurityValue.swift
new file mode 100644
index 0000000000000000000000000000000000000000..495b4c38daba1c89743df02cdcfa514f6b19935d
--- /dev/null
+++ b/apps/macos/Sources/OpenClawMacCLI/NativeCredentialSecurityValue.swift
@@ -0,0 +1,72 @@
+import Foundation
+import OpenClawKit
+
+enum NativeCredentialSecurityValue {
+    /// SecurityTool -w is ambiguous for all-hex text versus non-ASCII bytes.
+    /// Accept only the complete canonical typed -g representation on stderr.
+    static func decode(_ captured: Data) throws -> Data {
+        let prefix = Data("password: ".utf8)
+        guard captured.count <= 64 * 1024, captured.starts(with: prefix), captured.last == 10 else {
+            throw NativeCredentialError.unavailable
+        }
+        let representation = Data(captured.dropFirst(prefix.count).dropLast())
+        var value = Data()
+        if representation.first == 34, representation.last == 34, representation.count >= 2 {
+            value = Data(representation.dropFirst().dropLast())
+        } else if representation.starts(with: Data("0x".utf8)),
+                  let end = representation.firstIndex(of: 32)
+        {
+            let hex = Array(representation.dropFirst(2).prefix(end - 2))
+            guard !hex.isEmpty, hex.count <= 16384, hex.count.isMultiple(of: 2) else {
+                throw NativeCredentialError.unavailable
+            }
+            for offset in stride(from: 0, to: hex.count, by: 2) {
+                guard let high = self.nibble(hex[offset]), let low = self.nibble(hex[offset + 1]) else {
+                    throw NativeCredentialError.unavailable
+                }
+                value.append(high * 16 + low)
+            }
+        } else {
+            throw NativeCredentialError.unavailable
+        }
+        guard !value.isEmpty, value.count <= 8192,
+              let string = String(data: value, encoding: .utf8),
+              !string.unicodeScalars.contains(where: CharacterSet.controlCharacters.contains),
+              self.representation(value) == representation
+        else {
+            value.resetBytes(in: value.startIndex..<value.endIndex)
+            throw NativeCredentialError.unavailable
+        }
+        return value
+    }
+
+    private static func nibble(_ byte: UInt8) -> UInt8? {
+        switch byte {
+        case 48...57: byte - 48
+        case 65...70: byte - 55
+        default: nil
+        }
+    }
+
+    private static func representation(_ value: Data) -> Data {
+        let printable: (UInt8) -> Bool = { (32...126).contains($0) && $0 != 92 }
+        let hasASCII = value.contains(where: printable)
+        var result = Data()
+        if value.contains(where: { !printable($0) }) {
+            result.append(contentsOf: ("0x" + value.map { String(format: "%02X", $0) }.joined()).utf8)
+            result.append(contentsOf: (hasASCII ? "  " : " ").utf8)
+        }
+        if hasASCII {
+            result.append(34)
+            for byte in value {
+                if printable(byte) {
+                    result.append(byte)
+                } else {
+                    result.append(contentsOf: String(format: "\\%03o", byte).utf8)
+                }
+            }
+            result.append(34)
+        }
+        return result
+    }
+}
diff --git a/apps/macos/Sources/OpenClawMacCLI/NativeCredentialsCommand.swift b/apps/macos/Sources/OpenClawMacCLI/NativeCredentialsCommand.swift
new file mode 100644
index 0000000000000000000000000000000000000000..3dbe45faf362ef3529592d0221d50a5dbbb2c0e9
--- /dev/null
+++ b/apps/macos/Sources/OpenClawMacCLI/NativeCredentialsCommand.swift
@@ -0,0 +1,59 @@
+import Foundation
+import OpenClawKit
+import Security
+
+/// Operator-local metadata enrollment. Password entry remains the existing
+/// Keychain enrollment path; no command accepts or prints a password.
+func runNativeCredentials(_ args: [String]) {
+    do {
+        // This CLI process owns no other Keychain work. LAContext alone does not
+        // suppress authentication UI for legacy filesystem Keychain items.
+        guard SecKeychainSetUserInteractionAllowed(false) == errSecSuccess else {
+            throw NativeCredentialError.unavailable
+        }
+        switch args.first {
+        case "list" where args.count == 1:
+            let rows = try NativeCredentialKeychain.bindings()
+            let encoder = JSONEncoder()
+            encoder.outputFormatting = [.prettyPrinted, .sortedKeys]
+            guard let output = try String(data: encoder.encode(rows), encoding: .utf8) else {
+                throw NativeCredentialError.unavailable
+            }
+            print(output)
+        case "bind":
+            let binding = try parseNativeCredentialBinding(
+                Array(args.dropFirst()),
+                hostID: NativeCredentialHost.identity())
+            try NativeCredentialKeychain.bind(binding)
+            print("Native credential binding saved; password and item ACL unchanged.")
+        default:
+            throw NativeCredentialError.invalidBinding
+        }
+    } catch {
+        let code = (error as? NativeCredentialError)?.rawValue ?? "INVALID_ARGUMENTS"
+        fputs("Native credential metadata operation failed: \(code)\n", stderr)
+        exit(1)
+    }
+}
+
+func parseNativeCredentialBinding(_ args: [String], hostID: String) throws -> NativeCredentialBinding {
+    var fields: [String: String] = [:]
+    var bundles: [String] = []
+    var index = 0
+    while index < args.count {
+        let key = args[index]
+        guard ["--alias", "--kind", "--account", "--bundle"].contains(key), index + 1 < args.count else {
+            throw NativeCredentialError.invalidBinding
+        }
+        let value = args[index + 1]
+        if key == "--bundle" {
+            bundles.append(value)
+        } else {
+            guard fields.updateValue(value, forKey: key) == nil else { throw NativeCredentialError.invalidBinding }
+        }
+        index += 2
+    }
+    guard let alias = fields["--alias"], let kind = fields["--kind"].flatMap(NativeCredentialBinding.Kind.init),
+          let account = fields["--account"] else { throw NativeCredentialError.invalidBinding }
+    return try NativeCredentialBinding(alias: alias, kind: kind, account: account, hostID: hostID, bundleIDs: bundles)
+}

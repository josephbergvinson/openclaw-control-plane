+      saveTokens({ refresh: "fixture-refresh", expiresAt: Date.now() + 60_000 });
+      f.runtime.requesterConnect = await requesterConnect();
+      delete f.runtime.requesterConnect.isCurrent;
+      expect(f.capture()()).toBe(false);
+    }, tempOptions);
+  });
+});

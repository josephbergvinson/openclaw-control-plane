+import { AsyncResource } from "node:async_hooks";
+import { expectDefined } from "@openclaw/normalization-core";
+import { afterEach, beforeEach, expect, it, vi } from "vitest";
+import { useAutoCleanupTempDirTracker } from "../../../test/helpers/temp-dir.js";
+import {
+  createOperationalRunInstanceRef,
+  prepareAgentRunAdmission,
+} from "../../agents/admitted-run-context.js";
+import { toToolDefinitions } from "../../agents/agent-tool-definition-adapter.js";
+import { createOpenClawCodingTools } from "../../agents/agent-tools.js";
+import {
+  bindActiveOperatorTurnAuthority,
+  createCronCreatorAuthorityCapability,
+  runWithCronCreatorAuthorityCapability,
+  type CronCreatorAuthorityCapability,
+} from "../../agents/cron-creator-authority-context.js";
+import { resolveTranscriptsTool } from "../../agents/openclaw-tools.transcripts.js";
+import { getInternalToolExecutionPreparer } from "../../agents/runtime/internal-hooks.js";
+import { makeSettledChild } from "../../agents/subagents/announce/subagent-announce.requester-settle-wake.test-support.js";
+import { subagentRuns } from "../../agents/subagents/registry/subagent-registry-memory.js";
+import {
+  markRequesterTurnYieldedInRuns,
+  settleRequesterTurnAfterSessionSpawns,
+} from "../../agents/subagents/registry/subagent-registry-requester-yield.js";
+import { saveSubagentRegistryChangesToSqlite } from "../../agents/subagents/registry/subagent-registry.store.sqlite.js";
+import type { SubagentRunRecord } from "../../agents/subagents/registry/subagent-registry.types.js";
+import {
+  revokeRequesterCronAuthority,
+  withRequesterCronAuthority,
+} from "../../agents/subagents/requester-cron-authority.js";
+import {
+  createAdmittedGatewayToolCallerIdentity,
+  withGatewayToolCallerIdentity,
+} from "../../agents/tools/gateway-caller-context.js";
+import {
+  clearRuntimeConfigSnapshot,
+  getRuntimeConfig,
+  setRuntimeConfigSnapshot,
+} from "../../config/config.js";
+import * as sessionAccessor from "../../config/sessions/session-accessor.js";
+import {
+  clearAgentRunContext,
+  registerAgentRunContext,
+  rotateAgentRunRegistryLifecycleGeneration,
+} from "../../infra/agent-run-registry.js";
+import { cleanupSessionStateForTest } from "../../test-utils/session-state-cleanup.js";
+import {
+  captureGatewayDeviceRevocation,
+  closeGatewayDeviceRevocation,
+  invalidateGatewayDeviceRevocation,
+} from "../device-revocation.js";
+import { createSyntheticPluginRuntimeClient } from "../server-plugin-runtime-client.js";
+import {
+  resolveGatewayCronCreatorAuthorityAdmission,
+  type GatewayCronCreatorAuthorityAdmission,
+} from "./cron-creator-authority-admission.js";
+import type { GatewayClient } from "./types.js";
+
+// Exercise the native admission, persisted yield/rearm, successor scope, and actual
+// transcripts constructor/list owner. No model, socket, capture, or outbound send runs.
+const SESSION = "agent:main:local-operator";
+const SESSION_ID = "original-local-session";
+const DEVICE = "original-local-device";
+const tempDirs = useAutoCleanupTempDirTracker(afterEach);
+let stateDir: string;
+let clientCurrent: boolean;
+let gateway: object;
+let caller: ReturnType<typeof captureGatewayDeviceRevocation>;
+
+beforeEach(() => {
+  stateDir = tempDirs.make("openclaw-local-requester-authority-");
+  vi.stubEnv("OPENCLAW_STATE_DIR", stateDir);
+  setRuntimeConfigSnapshot({
+    agents: { entries: { main: {} } },
+    transcripts: { enabled: true },
+    tools: { allow: ["transcripts", "sessions_yield"] },
+  });
+  sessionAccessor.replaceSessionEntrySync(
+    { sessionKey: SESSION },
+    { sessionId: SESSION_ID, updatedAt: 1, lifecycleRevision: "original" },
+  );
+  clientCurrent = true;
+  gateway = {};
+  caller = captureGatewayDeviceRevocation(
+    gateway,
+    { deviceId: DEVICE, role: "operator" },
+    () => clientCurrent,
+  );
+});
+
+afterEach(async () => {
+  subagentRuns.clear();
+  revokeRequesterCronAuthority(SESSION);
+  caller.release();
+  await cleanupSessionStateForTest({ stateDir });
+  clearRuntimeConfigSnapshot();
+  vi.unstubAllEnvs();
+});
+
+function directClient(
+  kind: "local" | "remote-manager" | "nonlocal" | "unknown" = "local",
+): GatewayClient {
+  const client = createSyntheticPluginRuntimeClient({ scopes: ["operator.admin"] });
+  if (kind !== "unknown") {
+    // These are the existing authenticated connection boundary's native facts.
+    client.internal =
+      kind === "local"
+        ? { isLocalClient: true }
+        : kind === "remote-manager"
+          ? { controlUiAdmin: true }
+          : {};
+  }
+  return client;
+}
+
+function admission(runId: string, client: GatewayClient, child?: SubagentRunRecord) {
+  return resolveGatewayCronCreatorAuthorityAdmission({
+    runId,
+    resolvedSessionKey: SESSION,
+    sessionId: SESSION_ID,
+    client,
+    isCurrent: caller.isCurrent,
+    request: { message: "Finish the original private transcript repair", idempotencyKey: runId },
+    ...(child
+      ? {
+          inputProvenance: {
+            kind: "inter_session" as const,
+            sourceTool: "subagent_settle",
+            sourceSessionKey: child.childSessionKey,
+          },
+        }
+      : {}),
+    hasRestoredCronContinuation: false,
+    isOneShotModelRun: false,
+    isRestartRecoveryResumeRun: false,
+  });
+}
+
+async function inRun<T>(
+  runId: string,
+  admitted: GatewayCronCreatorAuthorityAdmission | undefined,
+  run: (scope?: CronCreatorAuthorityCapability) => Promise<T>,
+): Promise<T> {
+  const owner = prepareAgentRunAdmission({
+    cfg: getRuntimeConfig(),
+    operationalRunInstance: createOperationalRunInstanceRef(runId),
+    facts: {
+      runId,
+      agentId: "main",
+      ingress: { kind: "system", boundary: "native-local-requester-test", state: "present" },
+    },
+  });
+  try {
+    const admittedRun = await owner.admit("gateway", runId);
+    registerAgentRunContext(runId, { sessionKey: SESSION, sessionId: SESSION_ID, agentId: "main" });
+    const execute = (scope?: CronCreatorAuthorityCapability) =>
+      withGatewayToolCallerIdentity(
+        createAdmittedGatewayToolCallerIdentity({
+          agentId: "main",
+          sessionKey: SESSION,
+          admittedRunContext: admittedRun,
+          cronAuthorityCheck: scope?.isCurrent,
+        }),
+        () => run(scope),
+      );
+    if (!admitted) {
+      return await execute();
+    }
+    const scope = expectDefined(
+      createCronCreatorAuthorityCapability(
+        runId,
+        admitted.callerOrigin,
+        admitted.managementEntitlement,
+        admitted.isCurrent,
+      ),
+      "native creator scope",
+    );
+    admitted.bindRunScope?.(scope);
+    return await runWithCronCreatorAuthorityCapability(scope, () => execute(scope));
+  } finally {
+    owner.close();
+    clearAgentRunContext(runId);
+  }
+}
+
+function batch(runId: string) {
+  const child = makeSettledChild({
+    runId: `${runId}-child`,
+    requesterAgentId: "main",
+    requesterSessionKey: SESSION,
+    requesterTurnRunId: runId,
+    requesterSettleWake: undefined,
+    completion: { required: true },
+    completionTarget: "parent",
+  });
+  return { runId, child, runs: new Map([[child.runId, child]]) };
+}
+type Batch = ReturnType<typeof batch>;
+function mark(entry: Batch, fail = false) {
+  return markRequesterTurnYieldedInRuns({
+    requesterSessionKey: SESSION,
+    requesterAgentId: "main",
+    requesterTurnRunId: entry.runId,
+    runs: entry.runs,
+    persistOrThrow: (...ids) => {
+      if (fail) {
+        throw new Error("fixture yield persistence failed");
+      }
+      saveSubagentRegistryChangesToSqlite(entry.runs, ids);
+    },
+  });
+}
+function settle(entry: Batch) {
+  expect(
+    settleRequesterTurnAfterSessionSpawns({
+      requesterSessionKey: SESSION,
+      requesterAgentId: "main",
+      requesterTurnRunId: entry.runId,
+      requesterYielded: true,
+      acceptedSessionSpawns: [
+        {
+          runId: entry.child.runId,
+          childSessionKey: entry.child.childSessionKey,
+          expectsCompletionMessage: true,
+        },
+      ],
+      runs: entry.runs,
+      persistOrThrow: (...ids) => saveSubagentRegistryChangesToSqlite(entry.runs, ids),
+      schedule: () => {},
+    }),
+  ).toBe(true);
+}
+function dispatch<T>(entry: Batch, run: () => Promise<T>, runId = "successor") {
+  return withRequesterCronAuthority(
+    {
+      requesterSessionKey: SESSION,
+      requesterSessionId: SESSION_ID,
+      requesterAgentId: "main",
+      batch: [entry.child],
+      rearmGeneration: entry.child.requesterSettleWake?.rearmGeneration,
+      runId,
+      isCurrent: () => true,
+    },
+    run,
+  );
+}
+function tool(runId: string, name = "transcripts") {
+  // Use the actual published tool assembly with only unrelated surfaces disabled.
+  // No caller-origin flag, sender identity, or owner override is supplied here.
+  return createOpenClawCodingTools({
+    config: getRuntimeConfig(),
+    agentId: "main",
+    sessionKey: SESSION,
+    sessionId: SESSION_ID,
+    runId,
+    onYield: () => {},
+    workspaceDir: stateDir,
+    toolConstructionPlan: {
+      includeBaseCodingTools: false,
+      includeShellTools: false,
+      includeChannelTools: false,
+      includeOpenClawTools: true,
+      includePluginTools: false,
+    },
+  }).find((entry) => entry.name === name);
+}
+async function yielded(kind: Parameters<typeof directClient>[0] = "local") {
+  const entry = batch("original");
+  await inRun(entry.runId, admission(entry.runId, directClient(kind)), async () => {
+    expect(mark(entry)).toBe(1);
+  });
+  settle(entry);
+  caller.release();
+  return entry;
+}
+
+it("retains the original authenticated local operator tool after its run and transport retire", async () => {
+  const entry = batch("original");
+  let originalTool: ReturnType<typeof tool>;
+  await inRun(entry.runId, admission(entry.runId, directClient()), async (scope) => {
+    expect(scope?.callerOrigin).toEqual({ kind: "local" });
+    expect(scope?.managementEntitlement).toBeUndefined();
+    originalTool = expectDefined(tool(entry.runId), "original transcripts tool");
+    await expect(originalTool.execute("original-list", { action: "list" })).resolves.toMatchObject({
+      content: expect.any(Array),
+    });
+    expect(mark(entry)).toBe(1);
+  });
+  await expect(originalTool!.execute("retired-original", { action: "list" })).rejects.toThrow();
+  settle(entry);
+  caller.release();
+  await dispatch(entry, async () => {
+    const resumed = expectDefined(
+      admission("successor", createSyntheticPluginRuntimeClient(), entry.child),
+      "original parent successor admission",
+    );
+    await inRun("successor", resumed, async () => {
+      // The accepted parent owns continuation independently of the settled child outbox.
+      entry.runs.clear();
+      entry.child.requesterSettleWake = undefined;
+      const actual = expectDefined(tool("successor"), "resumed native transcripts tool");
+      expect(actual.name).toBe("transcripts");
+      expect(actual.description).toContain("summarize");
+      await expect(actual.execute("resumed-list", { action: "list" })).resolves.toMatchObject({
+        content: expect.any(Array),
+      });
+      expect(tool("unrelated-run")).toBeUndefined();
+      expect(
+        resolveTranscriptsTool({ transcripts: { enabled: false } }, "main", { runId: "successor" }),
+      ).toBeUndefined();
+    });
+  });
+  expect(caller.isCurrent()).toBe(false);
+});
+
+it("keeps local tools across a second native yield without borrowing the preceding run lifetime", async () => {
+  const first = await yielded();
+  const next = batch("successor");
+  await dispatch(first, async () => {
+    const resumed = expectDefined(
+      admission("successor", createSyntheticPluginRuntimeClient(), first.child),
+      "first successor admission",
+    );
+    await inRun("successor", resumed, async () => {
+      expect(tool("successor")).toBeDefined();
+      expect(mark(next)).toBe(1);
+    });
+  });
+  settle(next);
+  await dispatch(
+    next,
+    async () => {
+      const resumed = expectDefined(
+        admission("second-successor", createSyntheticPluginRuntimeClient(), next.child),
+        "second successor admission",
+      );
+      await inRun("second-successor", resumed, async () => {
+        const actual = expectDefined(tool("second-successor"), "second native tool");
+        await expect(actual.execute("second-list", { action: "list" })).resolves.toMatchObject({
+          content: expect.any(Array),
+        });
+      });
+    },
+    "second-successor",
+  );
+  expect(caller.isCurrent()).toBe(false);
+});
+
+it("retains native operator authority through a constructed yield tool outside its admission context", async () => {
+  const entry = batch("original");
+  entry.runs = subagentRuns;
+  entry.runs.set(entry.child.runId, entry.child);
+  saveSubagentRegistryChangesToSqlite(entry.runs, [entry.child.runId]);
+  const outside = new AsyncResource("local-yield-outside");
+  try {
+    await inRun(entry.runId, admission(entry.runId, directClient()), async () => {
+      const actual = expectDefined(tool(entry.runId, "sessions_yield"), "native yield tool");
+      const definition = expectDefined(toToolDefinitions([actual])[0], "native yield definition");
+      const prepare = expectDefined(
+        getInternalToolExecutionPreparer(definition),
+        "native preparer",
+      );
+      const prepared = await outside.runInAsyncScope(() =>
+        prepare({ toolCallId: "native-yield", args: {} }),
+      );
+      expect(prepared.kind).toBe("ready");
+      if (prepared.kind !== "ready") {
+        throw new Error("native yield must prepare for execution");
+      }
+      const result = await outside
+        .runInAsyncScope(() => prepared.execute())
+        .finally(prepared.dispose);
+      expect(result.details).toMatchObject({ status: "yielded" });
+      expect(entry.child.requesterTurnYielded).toBe(true);
+    });
+    settle(entry);
+    caller.release();
+    await dispatch(entry, async () => {
+      const resumed = expectDefined(
+        admission("successor", createSyntheticPluginRuntimeClient(), entry.child),
+        "outside-callback successor",
+      );
+      await inRun("successor", resumed, async () => expect(tool("successor")).toBeDefined());
+    });
+  } finally {
+    outside.emitDestroy();
+  }
+});
+
+it.each(["remote-manager", "nonlocal", "unknown"] as const)(
+  "does not turn %s into a local operator",
+  async (kind) => {
+    const entry = await yielded(kind);
+    await dispatch(entry, async () => {
+      const resumed = admission("successor", createSyntheticPluginRuntimeClient(), entry.child);
+      expect(resumed?.callerOrigin).not.toEqual({ kind: "local" });
+      await inRun("successor", resumed, async () => {
+        expect(bindActiveOperatorTurnAuthority("successor")).toBeUndefined();
+        expect(tool("successor")).toBeUndefined();
+      });
+    });
+  },
+);
+
+it("keeps the existing channel management entitlement scoped and unknown", async () => {
+  const entry = batch("original");
+  await inRun(
+    entry.runId,
+    {
+      runId: entry.runId,
+      callerOrigin: { kind: "unknown" },
+      managementEntitlement: { source: "channel-owner", isCurrent: () => true },
+    },
+    async () => expect(mark(entry)).toBe(1),
+  );
+  settle(entry);
+  caller.release();
+  await dispatch(entry, async () => {
+    const resumed = expectDefined(
+      admission("successor", createSyntheticPluginRuntimeClient(), entry.child),
+      "channel manager successor",
+    );
+    expect(resumed.callerOrigin).toEqual({ kind: "unknown" });
+    expect(resumed.managementEntitlement?.source).toBe("channel-owner");
+    await inRun("successor", resumed, async () => expect(tool("successor")).toBeUndefined());
+  });
+});
+
+it.each([
+  "device",
+  "auth",
+  "Gateway close",
+  "lifecycle",
+  "reset",
+  "archive",
+  "fresh turn",
+  "cancel",
+] as const)("rejects the retained local operator after %s revocation", async (reason) => {
+  const entry = await yielded();
+  if (reason === "device") {
+    invalidateGatewayDeviceRevocation(gateway, DEVICE, "operator");
+  } else if (reason === "auth") {
+    clientCurrent = false;
+  } else if (reason === "Gateway close") {
+    closeGatewayDeviceRevocation(gateway);
+  } else if (reason === "lifecycle") {
+    rotateAgentRunRegistryLifecycleGeneration();
+  } else if (reason === "reset" || reason === "archive") {
+    sessionAccessor.replaceSessionEntrySync(
+      { sessionKey: SESSION },
+      {
+        sessionId: SESSION_ID,
+        updatedAt: 2,
+        lifecycleRevision: reason === "reset" ? "reset" : "original",
+        ...(reason === "archive" ? { archivedAt: 2 } : {}),
+      },
+    );
+  } else if (reason === "fresh turn") {
+    admission("fresh-user", directClient("nonlocal"));
+  } else {
+    entry.child.killIntent = { requestedAt: 3, reason: "stop", suppressTaskDelivery: true };
+  }
+  await dispatch(entry, async () =>
+    expect(
+      admission("successor", createSyntheticPluginRuntimeClient(), entry.child),
+    ).toBeUndefined(),
+  );
+  expect(caller.isCurrent()).toBe(false);
+});
+
+it.each(["auth", "device", "session reset", "fresh user turn"] as const)(
+  "rechecks %s revocation on an already constructed native tool",
+  async (reason) => {
+    const entry = await yielded();
+    await dispatch(entry, async () => {
+      const resumed = expectDefined(
+        admission("successor", createSyntheticPluginRuntimeClient(), entry.child),
+        "successor admission",
+      );
+      await inRun("successor", resumed, async () => {
+        const actual = expectDefined(tool("successor"), "bound native transcripts tool");
+        await actual.execute("before-revocation", { action: "list" });
+        if (reason === "auth") {
+          clientCurrent = false;
+        } else if (reason === "device") {
+          invalidateGatewayDeviceRevocation(gateway, DEVICE, "operator");
+        } else if (reason === "session reset") {
+          sessionAccessor.replaceSessionEntrySync(
+            { sessionKey: SESSION },
+            { sessionId: SESSION_ID, updatedAt: 2, lifecycleRevision: "reset" },
+          );
+        } else {
+          admission("fresh-user", directClient("nonlocal"));
+        }
+        expect(tool("successor")).toBeUndefined();
+        await expect(actual.execute("after-revocation", { action: "list" })).rejects.toThrow(
+          "no longer active",
+        );
+      });
+    });
+  },
+);
+
+it.each(["wrong parent", "wrong session", "wrong run", "child message"] as const)(
+  "does not lend local operator authority to %s",
+  async (reason) => {
+    const entry = await yielded();
+    await dispatch(entry, async () => {
+      const resumed = resolveGatewayCronCreatorAuthorityAdmission({
+        runId: reason === "wrong run" ? "forged-run" : "successor",
+        resolvedSessionKey: reason === "wrong parent" ? entry.child.childSessionKey : SESSION,
+        sessionId: reason === "wrong session" ? "other-session" : SESSION_ID,
+        client: createSyntheticPluginRuntimeClient(),
+        request: { message: "claims to be the owner", idempotencyKey: "successor" },
+        inputProvenance: {
+          kind: "inter_session",
+          sourceTool: reason === "child message" ? "sessions_send" : "subagent_settle",
+          sourceSessionKey: entry.child.childSessionKey,
+        },
+        hasRestoredCronContinuation: false,
+        isOneShotModelRun: false,
+        isRestartRecoveryResumeRun: false,
+      });
+      expect(resumed).toBeUndefined();
+    });
+    revokeRequesterCronAuthority(SESSION);
+    expect(caller.isCurrent()).toBe(false);
+  },
+);
+
+it("releases a provisional native device hold when yield persistence fails", async () => {
+  const entry = batch("original");
+  await inRun(entry.runId, admission(entry.runId, directClient()), async () =>
+    expect(() => mark(entry, true)).toThrow("persistence failed"),
+  );
+  caller.release();
+  expect(caller.isCurrent()).toBe(false);
+});
+
+it("releases native caller retention when the exact session reader throws before capture commits", async () => {
+  const entry = batch("original");
+  await inRun(entry.runId, admission(entry.runId, directClient()), async () => {
+    const reader = vi
+      .spyOn(sessionAccessor, "loadSessionEntryReadOnly")
+      .mockImplementationOnce(() => {
+        throw new Error("fixture session reader failed");
+      });
+    try {
+      expect(() => mark(entry)).toThrow("session reader failed");
+    } finally {
+      reader.mockRestore();
+    }
+  });
+  caller.release();
+  expect(caller.isCurrent()).toBe(false);
+});
+
+it("does not retain a local label without the original native caller capture", async () => {
+  const entry = batch("original");
+  const direct = expectDefined(admission(entry.runId, directClient()), "direct local admission");
+  await inRun(entry.runId, { ...direct, isCurrent: () => true }, async () =>
+    expect(mark(entry)).toBe(1),
+  );
+  settle(entry);
+  caller.release();
+  await dispatch(entry, async () =>
+    expect(
+      admission("successor", createSyntheticPluginRuntimeClient(), entry.child),
+    ).toBeUndefined(),
+  );
+  expect(caller.isCurrent()).toBe(false);
+});
+
+it("cannot mutate a returned management-only origin into the retained private caller", async () => {
+  const entry = await yielded("remote-manager");
+  await dispatch(entry, async () => {
+    const resumed = expectDefined(
+      admission("successor", createSyntheticPluginRuntimeClient(), entry.child),
+      "remote manager successor",
+    );
+    expect(resumed.callerOrigin).toEqual({ kind: "unknown" });
+    resumed.callerOrigin.kind = "local";
+    const forged = expectDefined(
+      createCronCreatorAuthorityCapability(
+        "successor",
+        resumed.callerOrigin,
+        resumed.managementEntitlement,
+        resumed.isCurrent,
+      ),
+      "tampered returned admission",
+    );
+    await runWithCronCreatorAuthorityCapability(forged, async () => {
+      expect(() => resumed.bindRunScope?.(forged)).toThrow("no longer owns");
+    });
+  });
+});

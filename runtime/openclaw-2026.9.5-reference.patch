+      }).then(
+        (value) => {
+          settled = true;
+          return { value };
+        },
+        (error: unknown) => {
+          settled = true;
+          return { error };
+        },
+      );
+      try {
+        await scheduled.promise;
+        await checkpoint();
+        expect(
+          database.db
+            .prepare(
+              "SELECT needs_rebuild FROM session_transcript_index_state WHERE session_id = ?",
+            )
+            .get(target.sessionId),
+        ).toEqual({ needs_rebuild: 1 });
+        expect(openContinuation).toThrow(SessionTranscriptProjectionUnavailableError);
+        expect(settled).toBe(false);
+
+        if (outcome === "abort") {
+          controller.abort(new Error("external cancellation"));
+          expect(await recovered).toMatchObject({ error: { name: "AbortError" } });
+        } else {
+          if (outcome === "owner-revoked") {
+            ownerActive = false;
+          }
+          releaseWorker.resolve();
+          const result = await recovered;
+          if (outcome === "owner-revoked") {
+            expect(result).toEqual({ error: revoked });
+          } else {
+            expect(result).toEqual({ value: {} });
+            const continuation = openContinuation();
+            expect(continuation.buildSessionContext().messages).toEqual([
+              user,
+              expect.objectContaining({
+                role: "custom",
+                content: expect.stringContaining("Wait for the child result."),
+              }),
+            ]);
+            expect(SessionManager.open(target).getEntries()).toContainEqual(
+              expect.objectContaining({ customType: "retained-state" }),
+            );
+          }
+        }
+      } finally {
+        immediateSpy.mockRestore();
+        releaseWorker.resolve();
+        await recovered;
+        await waitForSessionTranscriptIndexReconcile(databaseOptions);
+        await lifecycle.dispose();
+      }
+    });
+  },
+);

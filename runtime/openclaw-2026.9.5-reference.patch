+                      minRecallCount: 1,
+                      minUniqueQueries: 1,
+                    },
+                  },
+                },
+              },
+            },
+          },
+        },
+      };
+      const on = vi.fn();
+      const logger = { debug: vi.fn(), info: vi.fn(), warn: vi.fn(), error: vi.fn() };
+      const api = { ...createTestPluginApi({ config, logger }), on, logger };
+      let narrativeCount = 0;
+      const complete = vi.fn<Completion>(async (request) => {
+        if (request.extraSystemPrompt?.startsWith("Choose how to incorporate")) {
+          const body = JSON.parse(request.message) as { candidates: Array<{ key: string }> };
+          return {
+            text: JSON.stringify({
+              operations: body.candidates.map(({ key }) => ({
+                candidateKey: key,
+                action: "added",
+                priorEntries: [],
+              })),
+            }),
+          };
+        }
+        return {
+          text: `Diary reflection ${++narrativeCount}: a quiet green cup accompanied the day's plans.`,
+        };
+      });
+      const completionRuntime = { complete };
+      Object.assign(api.runtime, { subagent: completionRuntime });
+      registerShortTermPromotionDreaming(api);
+      const registered = on.mock.calls.find(([name]) => name === "before_agent_reply");
+      if (!registered) {
+        throw new Error("before_agent_reply hook was not registered");
+      }
+      const hook = registered[1] as (
+        event: { cleanedBody: string },
+        context: { agentId: string; trigger: string; workspaceDir: string; sessionKey: string },
+      ) => Promise<unknown>;
+      const context = { agentId: "main", trigger, workspaceDir, sessionKey: "agent:main:main" };
+      // Ordinary text and unowned heartbeat tokens never start a sweep.
+      await expect(hook({ cleanedBody: "hello" }, context)).resolves.toBeUndefined();
+      if (trigger === "heartbeat") {
+        await expect(
+          hook({ cleanedBody: MEMORY_DREAMING_SYSTEM_EVENT_TEXT }, context),
+        ).resolves.toBeUndefined();
+        enqueueSystemEvent(MEMORY_DREAMING_SYSTEM_EVENT_TEXT, {
+          sessionKey: context.sessionKey,
+          contextKey: "cron:test-dreaming",
+        });
+      }
+      expect(complete).not.toHaveBeenCalled();
+      await expect(
+        hook({ cleanedBody: MEMORY_DREAMING_SYSTEM_EVENT_TEXT }, context),
+      ).resolves.toMatchObject({ handled: true });
+      // Detached cron narratives settle through their actual publication path before cleanup.
+      await vi.waitFor(async () => {
+        const diary = await fs.readFile(path.join(workspaceDir, "DREAMS.md"), "utf8");
+        for (const index of [1, 2, 3]) {
+          expect(diary).toContain(`Diary reflection ${index}:`);
+        }
+      });
+      const requests = complete.mock.calls.map(([request]) => request);
+      expect(requests.map((request) => request.model)).toEqual([
+        phaseModels?.light ?? model,
+        phaseModels?.rem ?? model,
+        model,
+        model,
+      ]);
+      expect(complete.mock.contexts.every((receiver) => receiver === completionRuntime)).toBe(true);
+      expect(requests.every((request) => request.timeoutMs === 60_000)).toBe(true);
+      expect(requests).toHaveLength(4); // light, REM, consolidation, deep
+      expect(
+        requests.filter((request) =>
+          request.extraSystemPrompt?.startsWith("Choose how to incorporate"),
+        ),
+      ).toHaveLength(1);
+      expect(
+        requests.map((request) => ({ agentId: request.agentId, thinking: request.thinking })),
+      ).toEqual(expected.map((thinking) => ({ agentId: "main", thinking })));
+      expect(await fs.readFile(path.join(workspaceDir, "MEMORY.md"), "utf8")).toContain(snippet);
+      expect(config.agents?.entries?.main?.thinkingDefault).toBe("ultra");
+      expect(logger.error).not.toHaveBeenCalled();
+    },
+  );
+});

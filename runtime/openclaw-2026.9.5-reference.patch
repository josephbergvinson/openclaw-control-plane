+import type { GatewayRequestHandlerOptions } from "./types.js";
+
+export function backendGatewayClient(): GatewayRequestHandlerOptions["client"] {
+  return {
+    connect: {
+      minProtocol: 1,
+      maxProtocol: 1,
+      client: {
+        id: "gateway-client",
+        version: "test",
+        platform: "test",
+        mode: "backend",
+      },
+      scopes: ["operator.write"],
+    },
+  };
+}
+
+export function cronContinuationGatewayClient(): GatewayRequestHandlerOptions["client"] {
+  const client = backendGatewayClient();
+  if (!client) {
+    throw new Error("expected backend gateway client");
+  }
+  return {
+    ...client,
+    internal: { ...client.internal, cronRunContinuation: true },
+  };
+}

+import { dispatchCronDeliveryMock, runEmbeddedAgentMock } from "./run.test-harness.js";
+
+export function requireEmbeddedAgentCall(index: number): {
+  prompt?: string;
+  suppressNextUserMessagePersistence?: boolean;
+  userTurnTranscriptRecorder?: {

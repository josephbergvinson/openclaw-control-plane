--- /dev/null
+++ b/src/infra/runtime-state-migration.ts
@@ -0,0 +1,273 @@
+// Private offline release entry: native SQLite owners perform every migration.
+import fs from "node:fs";
+import path from "node:path";
+import type { DatabaseSync } from "node:sqlite";
+import {
+  assertDoctorSqliteMaintenancePathsNotAliased,
+  withDoctorSqliteMaintenanceLock,
+} from "../commands/doctor-sqlite-maintenance-lock.js";
+import { containsConfigIncludeDirective, parseConfigJson5 } from "../config/io.read-helpers.js";
+import {
+  resolveConfiguredAgentDatabaseCandidatePaths,
+  resolveConfiguredAgentDatabaseTargets,
+} from "../config/sessions/targets.js";
+import { validateConfigObjectRaw } from "../config/validation-core.js";
+import { normalizeAgentId } from "../routing/session-key.js";
+import { OPENCLAW_AGENT_SCHEMA_VERSION } from "../state/openclaw-agent-db-contract.js";
+import {
+  assertOpenClawAgentDatabaseForMaintenance,
+  assertOpenClawAgentDatabaseOwner,
+  migrateOpenClawAgentDatabaseForMaintenance,
+} from "../state/openclaw-agent-db-maintenance.js";
+import {
+  closeOpenClawAgentDatabasesAsync,
+  withAgentDatabaseMaintenanceLease,
+} from "../state/openclaw-agent-db.js";
+import { OPENCLAW_STATE_SCHEMA_VERSION } from "../state/openclaw-state-db-contract.js";
+import {
+  assertOpenClawStateDatabaseForMaintenance,
+  assertOpenClawStateDatabaseOwner,
+} from "../state/openclaw-state-db-maintenance.js";
+import type { DB as StateDatabase } from "../state/openclaw-state-db.generated.js";
+import {
+  closeOpenClawStateDatabaseByPathAsync,
+  repairOpenClawStateDatabaseSchema,
+} from "../state/openclaw-state-db.js";
+import {
+  resolveOpenClawRegisteredAgentDatabasePath,
+  resolveOpenClawStateSqlitePath,
+} from "../state/openclaw-state-db.paths.js";
+import { clearNodeSqliteKyselyCacheForDatabase } from "./kysely-sync-cache-state.js";
+import { executeSqliteQuerySync, getNodeSqliteKysely } from "./kysely-sync.js";
+import { openNodeSqliteDatabase } from "./node-sqlite.js";
+import { isPathInside } from "./path-guards.js";
+import { resolveSqliteDatabaseFilePaths } from "./sqlite-files.js";
+import { assertSqliteIntegrity } from "./sqlite-integrity.js";
+import { prepareSqliteReadOnlyLocationSync } from "./sqlite-snapshot-source.js";
+import { readSqliteUserVersion } from "./sqlite-user-version.js";
+
+type AgentTarget = { agentId: string; path: string };
+type MigrationStage = "inputs" | "config" | "preflight" | "state" | "agent" | "verify" | "cleanup";
+
+export type RuntimeStateMigrationResult = {
+  schemaVersion: 1;
+  status: "completed";
+  stateSchemaVersion: number;
+  agentSchemaVersion: number;
+  agentDatabaseCount: number;
+};
+
+/** Stage-only failure; native errors may contain config, paths, or credential values. */
+export class RuntimeStateMigrationError extends Error {
+  constructor(public readonly code: MigrationStage) {
+    super(`Runtime state migration failed (${code}).`);
+    this.name = "RuntimeStateMigrationError";
+  }
+}
+
+function readDatabase<T>(pathname: string, read: (db: DatabaseSync) => T): T {
+  const snapshot = prepareSqliteReadOnlyLocationSync(pathname);
+  let db: DatabaseSync | undefined;
+  try {
+    db = openNodeSqliteDatabase(snapshot.location, { readOnly: true });
+    return read(db);
+  } finally {
+    try {
+      if (db) {
+        clearNodeSqliteKyselyCacheForDatabase(db);
+        db.close();
+      }
+    } finally {
+      snapshot.cleanup();
+    }
+  }
+}
+
+function assertOwnedPaths(stateDir: string, paths: readonly string[]): void {
+  for (const pathname of paths) {
+    if (!path.isAbsolute(pathname) || !isPathInside(stateDir, pathname)) {
+      throw new Error("Unowned migration path.");
+    }
+  }
+  assertDoctorSqliteMaintenancePathsNotAliased("runtime migration", paths, [stateDir]);
+}
+
+function assertVersion(db: DatabaseSync, maximum: number, metadataVersion: unknown): void {
+  const version = readSqliteUserVersion(db);
+  if (version < 1 || version > maximum || version !== metadataVersion) {
+    throw new Error("Incompatible migration schema.");
+  }
+}
+
+/**
+ * Called once in an isolated child with the exact reviewed config already installed.
+ * This is not Doctor: no config repair, auth refresh, plugin hooks or services.
+ * Native coordinator lock files may remain in the host's UID-scoped /tmp directory.
+ */
+export async function migrateRuntimeState(params: {
+  stateDir: string;
+  configPath: string;
+}): Promise<RuntimeStateMigrationResult> {
+  let stage: MigrationStage = "inputs";
+  try {
+    const { stateDir, configPath } = params;
+    const env = process.env;
+    if (
+      !path.isAbsolute(stateDir) ||
+      fs.realpathSync(stateDir) !== stateDir ||
+      configPath !== path.join(stateDir, "openclaw.json") ||
+      env.OPENCLAW_STATE_DIR !== stateDir ||
+      env.OPENCLAW_CONFIG_PATH !== configPath ||
+      env.OPENCLAW_LOG_LEVEL !== "silent" ||
+      !env.XDG_CACHE_HOME
+    ) {
+      throw new Error("Migration child selectors differ.");
+    }
+    const statePath = resolveOpenClawStateSqlitePath(env);
+    assertOwnedPaths(stateDir, [
+      configPath,
+      env.XDG_CACHE_HOME,
+      ...resolveSqliteDatabaseFilePaths(statePath),
+    ]);
+    if (!fs.statSync(configPath).isFile() || !fs.statSync(statePath).isFile()) {
+      throw new Error("Existing migration inputs required.");
+    }
+    return await withDoctorSqliteMaintenanceLock({
+      env,
+      operation: "runtime migration",
+      protectedPaths: [configPath, ...resolveSqliteDatabaseFilePaths(statePath)],
+      run: async (authority): Promise<RuntimeStateMigrationResult> => {
+        try {
+          stage = "config";
+          const parsed = parseConfigJson5(fs.readFileSync(configPath, "utf8"));
+          if (!parsed.ok || containsConfigIncludeDirective(parsed.parsed)) {
+            throw new Error("Reviewed single-file config required.");
+          }
+          const validated = validateConfigObjectRaw(parsed.parsed, { env });
+          if (!validated.ok) {
+            throw new Error("Reviewed config is invalid.");
+          }
+          const { config } = validated;
+          stage = "preflight";
+          const registered = readDatabase(statePath, (db): AgentTarget[] => {
+            assertOpenClawStateDatabaseOwner(db, { pathname: statePath });
+            const meta = /* sqlite-allow-raw -- Read-only migration version metadata. */ db
+              .prepare("SELECT schema_version FROM schema_meta WHERE meta_key = 'primary'")
+              .get();
+            assertVersion(db, OPENCLAW_STATE_SCHEMA_VERSION, meta?.schema_version);
+            const query = getNodeSqliteKysely<Pick<StateDatabase, "agent_databases">>(db)
+              .selectFrom("agent_databases")
+              .select(["agent_id", "path"]);
+            return executeSqliteQuerySync(db, query).rows.map((row) => ({
+              agentId: row.agent_id,
+              path: resolveOpenClawRegisteredAgentDatabasePath(statePath, row.path),
+            }));
+          });
+          const candidates = resolveConfiguredAgentDatabaseCandidatePaths(config, { env });
+          assertOwnedPaths(
+            stateDir,
+            [...registered.map((row) => row.path), ...candidates].flatMap(
+              resolveSqliteDatabaseFilePaths,
+            ),
+          );
+          const targets = new Map<string, AgentTarget>();
+          for (const target of [
+            ...registered,
+            ...resolveConfiguredAgentDatabaseTargets(config, {
+              env,
+              registeredDatabases: registered,
+            }),
+          ]) {
+            if (
+              target.agentId !== normalizeAgentId(target.agentId) ||
+              (targets.has(target.path) && targets.get(target.path)?.agentId !== target.agentId)
+            ) {
+              throw new Error("Ambiguous database owner.");
+            }
+            targets.set(target.path, target);
+          }
+          assertOwnedPaths(stateDir, [...targets.keys()].flatMap(resolveSqliteDatabaseFilePaths));
+          for (const candidate of candidates) {
+            if (fs.existsSync(candidate) && !targets.has(candidate)) {
+              throw new Error("Unknown configured database owner.");
+            }
+          }
+          const existing = [...targets.values()].filter((target) => {
+            if (fs.existsSync(target.path)) {
+              if (!fs.statSync(target.path).isFile()) {
+                throw new Error("Database is not regular.");
+              }
+              return true;
+            }
+            if (resolveSqliteDatabaseFilePaths(target.path).some((file) => fs.existsSync(file))) {
+              throw new Error("Orphaned database sidecar.");
+            }
+            return false;
+          });
+          for (const target of existing) {
+            readDatabase(target.path, (db) => {
+              const metadata = assertOpenClawAgentDatabaseOwner(db, {
+                agentId: target.agentId,
+                pathname: target.path,
+              });
+              assertVersion(db, OPENCLAW_AGENT_SCHEMA_VERSION, metadata.schemaVersion);
+            });
+          }
+          authority.assertCurrent();
+          stage = "state";
+          if (repairOpenClawStateDatabaseSchema({ env, path: statePath }).warnings.length > 0) {
+            throw new Error("Native state migration did not finish cleanly.");
+          }
+          stage = "agent";
+          await withAgentDatabaseMaintenanceLease({ env }, async (maintenance) => {
+            try {
+              for (const target of existing) {
+                authority.assertCurrent();
+                await migrateOpenClawAgentDatabaseForMaintenance(
+                  { agentId: target.agentId, pathname: target.path },
+                  maintenance,
+                );
+              }
+            } finally {
+              await closeOpenClawAgentDatabasesAsync();
+            }
+          });
+          await closeOpenClawStateDatabaseByPathAsync(statePath);
+          stage = "verify";
+          readDatabase(statePath, (db) => {
+            assertOpenClawStateDatabaseForMaintenance(db, { pathname: statePath });
+            assertSqliteIntegrity(db, statePath);
+          });
+          for (const target of existing) {
+            readDatabase(target.path, (db) => {
+              assertOpenClawAgentDatabaseForMaintenance(db, {
+                agentId: target.agentId,
+                pathname: target.path,
+              });
+              assertSqliteIntegrity(db, target.path);
+            });
+          }
+          return {
+            schemaVersion: 1,
+            status: "completed",
+            stateSchemaVersion: OPENCLAW_STATE_SCHEMA_VERSION,
+            agentSchemaVersion: OPENCLAW_AGENT_SCHEMA_VERSION,
+            agentDatabaseCount: existing.length,
+          };
+        } finally {
+          // Release cached handles while the native offline lock is still held.
+          const failedStage = stage;
+          stage = "cleanup";
+          try {
+            await closeOpenClawAgentDatabasesAsync();
+          } finally {
+            await closeOpenClawStateDatabaseByPathAsync(statePath);
+          }
+          stage = failedStage;
+        }
+      },
+    });
+  } catch {
+    throw new RuntimeStateMigrationError(stage);
+  }
+}

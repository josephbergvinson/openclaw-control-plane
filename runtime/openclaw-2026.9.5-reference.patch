diff --git a/extensions/discord/src/monitor/listeners.threads.ts b/extensions/discord/src/monitor/listeners.threads.ts
new file mode 100644
index 0000000000000000000000000000000000000000..962b4090954aee93dadf6b99fa043bef452fa147
--- /dev/null
+++ b/extensions/discord/src/monitor/listeners.threads.ts
@@ -0,0 +1,270 @@
+// Thread lifecycle listeners share the same bounded membership and session-close owners.
+import { pruneMapToMaxSize } from "openclaw/plugin-sdk/collection-runtime";
+import type { OpenClawConfig } from "openclaw/plugin-sdk/config-contracts";
+import { danger } from "openclaw/plugin-sdk/runtime-env";
+import { mergeDiscordAccountConfig } from "../accounts.js";
+import {
+  type Client,
+  Guild,
+  GuildCreateListener,
+  ReadyListener,
+  ThreadCreateListener,
+  ThreadDeleteListener,
+  ThreadListSyncListener,
+  ThreadUpdateListener,
+} from "../internal/discord.js";
+import {
+  type DiscordGuildEntryResolved,
+  isDiscordGroupAllowedByPolicy,
+  normalizeDiscordSlug,
+  resolveDiscordChannelConfigWithFallback,
+  resolveDiscordGuildEntry,
+} from "./allow-list.js";
+import { discordEventQueueLog, runDiscordListenerWithSlowLog } from "./listeners.queue.js";
+import type { DiscordLivePolicyReader } from "./live-policy.js";
+import { isThreadArchived } from "./thread-bindings.discord-api.js";
+import { getThreadBindingManager } from "./thread-bindings.manager.js";
+import { closeDiscordThreadSessions } from "./thread-session-close.js";
+
+type Logger = ReturnType<typeof import("openclaw/plugin-sdk/runtime-env").createSubsystemLogger>;
+type GuildCreateEvent = Parameters<GuildCreateListener["handle"]>[0];
+
+type ThreadUpdateEvent = Parameters<ThreadUpdateListener["handle"]>[0];
+const DISCORD_THREAD_REJOIN_CLAIM_MAX_ENTRIES = 10_000;
+
+export class DiscordThreadUpdateListener extends ThreadUpdateListener {
+  private readonly rejoinClaims = new Map<string, symbol>();
+
+  constructor(
+    private readonly params: {
+      cfg: OpenClawConfig;
+      accountId: string;
+      groupPolicy: "open" | "allowlist" | "disabled";
+      guildEntries?: Record<string, DiscordGuildEntryResolved>;
+      readPolicy?: DiscordLivePolicyReader;
+      logger?: Logger;
+    },
+  ) {
+    super();
+  }
+
+  resetGatewaySession(): void {
+    this.rejoinClaims.clear();
+  }
+
+  async handle(data: ThreadUpdateEvent, client: Client) {
+    await runDiscordListenerWithSlowLog({
+      logger: this.params.logger,
+      listener: this.constructor.name,
+      event: this.type,
+      run: async () => {
+        const threadId = "id" in data && typeof data.id === "string" ? data.id : undefined;
+        if (!threadId) {
+          return;
+        }
+        const logger = this.params.logger ?? discordEventQueueLog;
+        if (isThreadArchived(data)) {
+          this.rejoinClaims.delete(threadId);
+          const count = await closeDiscordThreadSessions({
+            cfg: this.params.cfg,
+            threadId,
+          });
+          if (count > 0) {
+            logger.info("Discord thread archived — reset sessions", { threadId, count });
+          }
+          return;
+        }
+        if (this.rejoinClaims.has(threadId)) {
+          return;
+        }
+
+        // Claim before awaiting REST because listener jobs may overlap. Keep the newest claims
+        // bounded across long-lived gateway sessions so ordinary updates cannot grow memory forever.
+        const claim = Symbol(threadId);
+        this.rejoinClaims.set(threadId, claim);
+        pruneMapToMaxSize(this.rejoinClaims, DISCORD_THREAD_REJOIN_CLAIM_MAX_ENTRIES);
+        try {
+          const policy = await this.params.readPolicy?.();
+          const params = { ...this.params, ...policy };
+          const isCurrent = () =>
+            this.rejoinClaims.get(threadId) === claim && policy?.isCurrent() !== false;
+          if (!isCurrent() || !(await this.isThreadAllowed(data, client, params)) || !isCurrent()) {
+            if (this.rejoinClaims.get(threadId) === claim) {
+              this.rejoinClaims.delete(threadId);
+            }
+            return;
+          }
+          await client.rest.put(`/channels/${threadId}/thread-members/@me`);
+          logger.info("Discord active thread — rejoined thread", { threadId });
+        } catch (err) {
+          // An earlier request may settle after archive or READY; only its own claim may reopen retry.
+          if (this.rejoinClaims.get(threadId) === claim) {
+            this.rejoinClaims.delete(threadId);
+          }
+          logger.warn(danger(`discord thread rejoin failed: ${String(err)}`), { threadId });
+        }
+      },
+      onError: (err) => {
+        const logger = this.params.logger ?? discordEventQueueLog;
+        logger.error(danger(`discord thread-update handler failed: ${String(err)}`));
+      },
+    });
+  }
+
+  async reconcile(threads: ThreadUpdateEvent[], guildId: string, client: Client): Promise<void> {
+    // The gateway's active-thread snapshots recover membership missed during downtime.
+    // Joining never synthesizes a MESSAGE_CREATE or replays old user requests.
+    for (const thread of threads) {
+      if (isThreadArchived(thread) || (thread.guild_id && thread.guild_id !== guildId)) {
+        continue;
+      }
+      await this.handle({ ...thread, guild_id: guildId }, client);
+    }
+  }
+
+  private async isThreadAllowed(
+    data: ThreadUpdateEvent,
+    client: Client,
+    params: DiscordThreadUpdateListener["params"],
+  ): Promise<boolean> {
+    const guildId = data.guild_id;
+    if (
+      !guildId ||
+      !data.parent_id ||
+      params.groupPolicy === "disabled" ||
+      params.cfg.channels?.discord?.enabled === false ||
+      mergeDiscordAccountConfig(params.cfg, params.accountId).enabled === false
+    ) {
+      return false;
+    }
+    const guildInfo = resolveDiscordGuildEntry({
+      guild: new Guild<true>(client, guildId),
+      guildId,
+      guildEntries: params.guildEntries,
+    });
+    let channelConfig = resolveDiscordChannelConfigWithFallback({
+      guildInfo,
+      channelId: data.id,
+      channelSlug: "",
+      parentId: data.parent_id,
+      scope: "thread",
+    });
+    if (channelConfig?.allowed === false && !channelConfig.matchKey) {
+      // Prepared allowlists normally resolve IDs; retained name entries need parent metadata.
+      const hasNameEntry = Object.keys(guildInfo?.channels ?? {}).some(
+        (key) => key !== "*" && !/^\d+$/.test(key),
+      );
+      if (hasNameEntry) {
+        const parent = await client.fetchChannel(data.parent_id);
+        channelConfig = resolveDiscordChannelConfigWithFallback({
+          guildInfo,
+          channelId: data.id,
+          channelSlug: "",
+          parentId: data.parent_id,
+          parentName: parent.name ?? undefined,
+          parentSlug: normalizeDiscordSlug(parent.name ?? ""),
+          scope: "thread",
+        });
+      }
+    }
+    if (
+      !isDiscordGroupAllowedByPolicy({
+        groupPolicy: params.groupPolicy,
+        guildAllowlisted: Boolean(guildInfo),
+        channelAllowlistConfigured: Boolean(
+          guildInfo?.channels && Object.keys(guildInfo.channels).length,
+        ),
+        channelAllowed: channelConfig?.allowed !== false,
+      }) ||
+      channelConfig?.allowed === false ||
+      channelConfig?.enabled === false
+    ) {
+      return false;
+    }
+    // Membership delivers no message or tool request. Message preflight remains
+    // the authority owner for the actual sender, regardless of the thread creator.
+    return true;
+  }
+}
+
+export class DiscordThreadCreateListener extends ThreadCreateListener {
+  constructor(private readonly owner: DiscordThreadUpdateListener) {
+    super();
+  }
+  async handle(data: Parameters<ThreadCreateListener["handle"]>[0], client: Client): Promise<void> {
+    await this.owner.handle(data, client);
+  }
+}
+
+export class DiscordThreadListSyncListener extends ThreadListSyncListener {
+  constructor(private readonly owner: DiscordThreadUpdateListener) {
+    super();
+  }
+  async handle(
+    data: Parameters<ThreadListSyncListener["handle"]>[0],
+    client: Client,
+  ): Promise<void> {
+    await this.owner.reconcile(data.threads, data.guild_id, client);
+  }
+}
+
+export class DiscordThreadGuildCreateListener extends GuildCreateListener {
+  constructor(private readonly owner: DiscordThreadUpdateListener) {
+    super();
+  }
+  async handle(data: GuildCreateEvent, client: Client): Promise<void> {
+    if (data.unavailable !== true && "threads" in data) {
+      await this.owner.reconcile(data.threads, data.id, client);
+    }
+  }
+}
+
+export class DiscordThreadReadyListener extends ReadyListener {
+  constructor(private readonly threadUpdateListener: DiscordThreadUpdateListener) {
+    super();
+  }
+
+  handle(): void {
+    this.threadUpdateListener.resetGatewaySession();
+  }
+}
+
+type ThreadDeleteEvent = Parameters<ThreadDeleteListener["handle"]>[0];
+
+export class DiscordThreadDeleteListener extends ThreadDeleteListener {
+  constructor(
+    private cfg: OpenClawConfig,
+    private accountId: string,
+    private logger?: Logger,
+  ) {
+    super();
+  }
+
+  async handle(data: ThreadDeleteEvent) {
+    await runDiscordListenerWithSlowLog({
+      logger: this.logger,
+      listener: this.constructor.name,
+      event: this.type,
+      run: async () => {
+        const threadId = data.id;
+        getThreadBindingManager(this.accountId)?.unbindThread({
+          threadId,
+          reason: "thread-delete",
+          sendFarewell: false,
+        });
+        const count = await closeDiscordThreadSessions({
+          cfg: this.cfg,
+          threadId,
+        });
+        if (count > 0) {
+          const logger = this.logger ?? discordEventQueueLog;
+          logger.info("Discord thread deleted — reset sessions", { threadId, count });
+        }
+      },
+      onError: (err) => {
+        const logger = this.logger ?? discordEventQueueLog;
+        logger.error(danger(`discord thread-delete handler failed: ${String(err)}`));
+      },
+    });
+  }
+}

+import Foundation
+import Testing
+@testable import OpenClaw
+
+/// Pure endpoint construction: no app state, preferences, Keychain, or live Gateway.
+struct GatewayEndpointCredentialSelectionTests {
+    private let reference: [String: String] = ["source": "store", "provider": "default", "id": "GATEWAY_AUTH"]
+
+    @Test func `local token SecretRef reaches the endpoint instead of ambient auth`() throws {
+        let root: [String: Any] = ["gateway": ["mode": "local", "auth": ["mode": "token", "token": self.reference]]]
+        #expect(try GatewayLocalAuthResolver.request(root: root, env: [:]) != nil)
+        let credentials = try GatewayLocalAuthResolver.decode(.init(
+            output: Data(#"{"version":1,"token":"resolved-token"}"#.utf8), terminationStatus: 0))
+        let endpoint = GatewayEndpointStore._testLocalConfig(
+            root: root,
+            env: ["OPENCLAW_GATEWAY_TOKEN": "stale-ambient", "OPENCLAW_GATEWAY_PASSWORD": "stale-password"],
+            port: 18789,
+            resolvedCredentials: credentials)
+        #expect(endpoint.url.absoluteString == "ws://127.0.0.1:18789")
+        #expect(endpoint.token == "resolved-token")
+        #expect(endpoint.password == nil)
+    }
+
+    @Test func `local password SecretRef clears the sibling token`() throws {
+        let root: [String: Any] = ["gateway": ["mode": "local", "auth": [
+            "mode": "password", "password": self.reference, "token": "stale-config-token",
+        ]]]
+        #expect(try GatewayLocalAuthResolver.request(root: root, env: [:]) != nil)
+        let credentials = try GatewayLocalAuthResolver.decode(.init(
+            output: Data(#"{"version":1,"password":"resolved-password"}"#.utf8), terminationStatus: 0))
+        let endpoint = GatewayEndpointStore._testLocalConfig(
+            root: root,
+            env: ["OPENCLAW_GATEWAY_TOKEN": "stale-ambient"],
+            port: 18789,
+            resolvedCredentials: credentials)
+        #expect(endpoint.token == nil)
+        #expect(endpoint.password == "resolved-password")
+    }
+
+    @Test func `local literal auth keeps the existing fast path`() throws {
+        let root: [String: Any] = ["gateway": ["mode": "local", "auth": ["mode": "token", "token": "literal"]]]
+        #expect(try GatewayLocalAuthResolver.request(root: root, env: [:]) == nil)
+        let endpoint = GatewayEndpointStore._testLocalConfig(root: root, env: [:], port: 18789)
+        #expect(endpoint.token == "literal")
+        #expect(endpoint.password == nil)
+    }
+}

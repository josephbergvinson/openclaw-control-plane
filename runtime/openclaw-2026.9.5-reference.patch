diff --git a/src/agents/tool-search.gateway-guidance.test.ts b/src/agents/tool-search.gateway-guidance.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f39ebfbd27aedb7d2232677fc7a6a24ac6722bf9
--- /dev/null
+++ b/src/agents/tool-search.gateway-guidance.test.ts
@@ -0,0 +1,146 @@
+/** Tests finalized gateway guidance through each existing deferred catalog surface. */
+import { expectDefined } from "@openclaw/normalization-core";
+import { describe, expect, it, vi } from "vitest";
+import { finalizeAgentTools } from "./agent-tools.finalize.js";
+import { filterToolsByPolicy } from "./tool-policy-match.js";
+import {
+  applyToolSchemaDirectoryCatalog,
+  applyToolSearchCatalog,
+  buildToolSchemaDirectoryPrompt,
+  createToolSearchCatalogRef,
+  createToolSearchTools,
+  resolveToolSearchCatalogTool,
+} from "./tool-search.js";
+import { jsonResult, type AnyAgentTool } from "./tools/common.js";
+import { createGatewayTool } from "./tools/gateway-tool.js";
+import { createOpenClawDelegateToolsForRun } from "./tools/openclaw-delegate-tool.js";
+
+function fakeTool(name: string, description: string): AnyAgentTool {
+  return {
+    name,
+    label: name,
+    description,
+    parameters: {
+      type: "object",
+      properties: {
+        value: { type: "string" },
+      },
+    },
+    execute: vi.fn(async (_toolCallId, input) => jsonResult({ name, input })),
+  };
+}
+
+describe("Tool Search gateway availability guidance", () => {
+  it.each([
+    {
+      scenario: "delegation was never provided",
+      agentId: "openclaw",
+      denyOpenClaw: false,
+      exec: false,
+      denyExec: false,
+      expected:
+        "Read gateway config/schema. update.run: owner-only update on explicit user request; restart + completion notice automatic. Once accepted, wait for completion rather than starting another update or restart.",
+    },
+    {
+      scenario: "policy removed delegation",
+      agentId: "main",
+      denyOpenClaw: true,
+      exec: false,
+      denyExec: false,
+      expected:
+        "Read gateway config/schema. update.run: owner-only update on explicit user request; restart + completion notice automatic. Once accepted, wait for completion rather than starting another update or restart.",
+    },
+    {
+      scenario: "delegation remains authorized",
+      agentId: "main",
+      denyOpenClaw: false,
+      exec: false,
+      denyExec: false,
+      expected:
+        "Read gateway config/schema. update.run: owner-only update on explicit user request; restart + completion notice automatic. Other system changes: use openclaw tool. Once accepted, wait for completion rather than starting another update or restart.",
+    },
+    {
+      scenario: "shell maintenance remains authorized without delegated controls",
+      agentId: "main",
+      denyOpenClaw: true,
+      exec: true,
+      denyExec: false,
+      expected:
+        "Read gateway config/schema. update.run: owner-only update on explicit user request; restart + completion notice automatic. Once accepted, wait for completion rather than starting another update or restart. Owner-authorized shell maintenance may replace or restart this Gateway when its available controls cannot perform the requested operation.",
+    },
+    {
+      scenario: "policy removed shell maintenance",
+      agentId: "main",
+      denyOpenClaw: false,
+      exec: true,
+      denyExec: true,
+      expected:
+        "Read gateway config/schema. update.run: owner-only update on explicit user request; restart + completion notice automatic. Other system changes: use openclaw tool. Once accepted, wait for completion rather than starting another update or restart.",
+    },
+    {
+      scenario: "both maintenance routes remain authorized",
+      agentId: "main",
+      denyOpenClaw: false,
+      exec: true,
+      denyExec: false,
+      expected:
+        "Read gateway config/schema. update.run: owner-only update on explicit user request; restart + completion notice automatic. Other system changes: use openclaw tool. Once accepted, wait for completion rather than starting another update or restart. Owner-authorized shell maintenance may replace or restart this Gateway when its available controls cannot perform the requested operation.",
+    },
+  ])(
+    "keeps gateway guidance consistent across final and deferred surfaces when $scenario",
+    ({ agentId, denyOpenClaw, exec, denyExec, expected }) => {
+      const authorizedTools = filterToolsByPolicy(
+        [
+          createGatewayTool(),
+          ...createOpenClawDelegateToolsForRun({ sessionAgentId: agentId }),
+          ...(exec ? [fakeTool("exec", "Run shell commands")] : []),
+        ],
+        { deny: [...(denyOpenClaw ? ["openclaw"] : []), ...(denyExec ? ["exec"] : [])] },
+      );
+      const finalizedTools = finalizeAgentTools({
+        tools: authorizedTools,
+        hookContext: {},
+        wrapBeforeToolCallHook: false,
+      });
+      const gateway = expectDefined(
+        finalizedTools.find((tool) => tool.name === "gateway"),
+        "finalized gateway tool",
+      );
+
+      expect(finalizedTools.some((tool) => tool.name === "openclaw")).toBe(
+        expected.includes("openclaw"),
+      );
+      expect(gateway.description).toBe(expected);
+      expect(gateway.description).not.toContain("Never via shell");
+      expect(gateway.description.includes("Owner-authorized shell maintenance")).toBe(
+        exec && !denyExec,
+      );
+
+      for (const mode of ["code", "tools", "directory"] as const) {
+        const catalogRef = createToolSearchCatalogRef();
+        const config = { tools: { toolSearch: { enabled: true, mode } } };
+        const tools = [...createToolSearchTools({ config, catalogRef }), ...finalizedTools];
+
+        if (mode === "directory") {
+          applyToolSchemaDirectoryCatalog({ tools, config, catalogRef });
+        } else {
+          applyToolSearchCatalog({ tools, config, catalogRef });
+        }
+
+        const entry = expectDefined(
+          catalogRef.current?.entries.find((candidate) => candidate.name === "gateway"),
+          `${mode} gateway catalog entry`,
+        );
+
+        expect(entry.description).toBe(expected);
+        expect(entry.tool.description).toBe(expected);
+        expect(buildToolSchemaDirectoryPrompt({ config, catalogRef })).toContain(
+          `- gateway (core): ${expected.slice(0, 80)}`,
+        );
+        expect(resolveToolSearchCatalogTool({ config, catalogRef }, "gateway")?.description).toBe(
+          expected,
+        );
+      }
+    },
+  );
+});

new file mode 100644
index 0000000000000000000000000000000000000000..aa1242f20993686d710d947b60578e51a16d5ac7
--- /dev/null
+++ b/extensions/browser/src/browser/extension-install-owned-launcher.ts
@@ -0,0 +1,147 @@
+import type { Stats } from "node:fs";
+import fs from "node:fs/promises";
+import path from "node:path";
+import { resolveStateDir } from "openclaw/plugin-sdk/state-paths";
+import { assertOwnedPath, type ExtensionInstallDeps } from "./extension-install-layout.js";
+
+export const OWNED_LAUNCHER_MARKER = "# OpenClaw native messaging bootstrap v1";
+
+export function resolveInstallStateDir(deps: ExtensionInstallDeps): string {
+  return path.resolve(deps.stateDir ?? resolveStateDir(deps.env));
+}
+
+export function resolveInstallConfigPath(deps: ExtensionInstallDeps): string | undefined {
+  const env = deps.env ?? process.env;
+  const explicit = env.OPENCLAW_CONFIG_PATH?.trim();
+  return explicit ? resolveStateDir({ ...env, OPENCLAW_STATE_DIR: explicit }) : undefined;
+}
+
+export function shellQuote(value: string): string {
+  return `'${value.replaceAll("'", `'"'"'`)}'`;
+}
+
+export function matchesLegacyInstallContext(content: string, deps: ExtensionInstallDeps): boolean {
+  const prefix = `#!/bin/sh\n${OWNED_LAUNCHER_MARKER}\nexport OPENCLAW_STATE_DIR=${shellQuote(resolveInstallStateDir(deps))}\n`;
+  if (!content.startsWith(prefix)) {
+    return false;
+  }
+  const remaining = content.slice(prefix.length);
+  const defaultConfig = path.join(resolveInstallStateDir(deps), "openclaw.json");
+  const config = resolveInstallConfigPath(deps) ?? defaultConfig;
+  if (!remaining.startsWith("export OPENCLAW_CONFIG_PATH=")) {
+    return config === defaultConfig;
+  }
+  return remaining.startsWith(`export OPENCLAW_CONFIG_PATH=${shellQuote(config)}\n`);
+}
+
+function escapeRegExp(value: string): string {
+  return value.replace(/[.*+?^${}()|[\]\\]/gu, "\\$&");
+}
+
+export function parseOwnedLauncherTargets(params: {
+  content: string;
+  manifestPath: string;
+  launcherPath: string;
+  origins: string[];
+}): string[] | undefined {
+  const quotedValue = String.raw`'(?:[^'\r\n]|'"'"')*'`;
+  const command = [
+    `(${quotedValue})`,
+    `(${quotedValue})`,
+    escapeRegExp(shellQuote("--manifest")),
+    escapeRegExp(shellQuote(params.manifestPath)),
+    escapeRegExp(shellQuote("--launcher")),
+    escapeRegExp(shellQuote(params.launcherPath)),
+    ...params.origins.flatMap((origin) => [
+      escapeRegExp(shellQuote("--expected-origin")),
+      escapeRegExp(shellQuote(origin)),
+    ]),
+  ].join(" ");
+  const pattern = new RegExp(
+    `^#!/bin/sh\\n${escapeRegExp(OWNED_LAUNCHER_MARKER)}\\nexport OPENCLAW_STATE_DIR=${quotedValue}\\n(?:export OPENCLAW_CONFIG_PATH=${quotedValue}\\n)?exec ${command} "\\$@"\\n$`,
+    "u",
+  );
+  // Decode only shellQuote's two target words after the entire ownership grammar matches.
+  return pattern
+    .exec(params.content)
+    ?.slice(1)
+    .map((value) => value.slice(1, -1).replaceAll(`'"'"'`, "'"));
+}
+
+export function parseOwnedLauncherOrigins(params: {
+  content: string;
+  manifestPath: string;
+  launcherPath: string;
+}): string[] | undefined {
+  const origins = [
+    ...params.content.matchAll(/'--expected-origin' '(chrome-extension:\/\/[a-p]{32}\/)'/gu),
+  ].flatMap((match) => (match[1] ? [match[1]] : []));
+  if (
+    origins.length === 0 ||
+    new Set(origins).size !== origins.length ||
+    JSON.stringify(origins) !== JSON.stringify(origins.toSorted())
+  ) {
+    return undefined;
+  }
+  // The inferred words confer ownership only when the entire self-bound grammar matches.
+  return parseOwnedLauncherTargets({ ...params, origins }) ? origins : undefined;
+}
+
+export async function assertPrivateNativeHostFile(
+  target: string,
+  executable: boolean,
+  platform: NodeJS.Platform,
+): Promise<void> {
+  await assertOwnedPath(target, "file");
+  if (platform === "win32") {
+    return;
+  }
+  const mode = (await fs.lstat(target)).mode & 0o777;
+  if ((mode & 0o077) !== 0 || (executable && (mode & 0o100) === 0)) {
+    throw new Error("native host file has unsafe mode");
+  }
+}
+
+export type NativeLauncherSnapshot = {
+  path: string;
+  info: Pick<Stats, "dev" | "ino" | "mode">;
+  content: string;
+};
+
+export async function captureOwnedLauncher(
+  registration: { manifestPath: string; launcherPath: string; extensionIds: string[] },
+  deps: ExtensionInstallDeps,
+): Promise<NativeLauncherSnapshot> {
+  const launcherPath = registration.launcherPath;
+  await assertPrivateNativeHostFile(launcherPath, true, deps.platform ?? process.platform);
+  const info = await fs.lstat(launcherPath);
+  const content = await fs.readFile(launcherPath, "utf8");
+  if (
+    !parseOwnedLauncherTargets({
+      content,
+      manifestPath: registration.manifestPath,
+      launcherPath,
+      origins: registration.extensionIds.map((id) => `chrome-extension://${id}/`),
+    }) ||
+    !matchesLegacyInstallContext(content, deps)
+  ) {
+    throw new Error("registered launcher ownership changed");
+  }
+  return { path: launcherPath, info, content };
+}
+
+export async function assertLauncherUnchanged(
+  snapshot: NativeLauncherSnapshot,
+  deps: ExtensionInstallDeps,
+): Promise<void> {
+  await assertPrivateNativeHostFile(snapshot.path, true, deps.platform ?? process.platform);
+  const info = await fs.lstat(snapshot.path);
+  if (
+    info.dev !== snapshot.info.dev ||
+    info.ino !== snapshot.info.ino ||
+    info.mode !== snapshot.info.mode ||
+    (await fs.readFile(snapshot.path, "utf8")) !== snapshot.content
+  ) {
+    throw new Error("registered launcher changed during cleanup");
+  }
+}

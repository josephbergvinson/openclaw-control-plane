+import { describe, expect, it } from "vitest";
+import {
+  createSubagentRunRecord,
+  type SubagentRunRecordOverrides,
+} from "../../subagent-test-fixtures.test-helpers.js";
+import { hasPendingPrivateSubagentCompletionFromRuns } from "./subagent-registry-queries.js";
+
+const requester = {
+  sessionKey: "agent:main:requester",
+  agentId: "main",
+  sessionId: "parent-current",
+};
+
+function child(overrides: Partial<SubagentRunRecordOverrides> = {}) {
+  return createSubagentRunRecord({
+    runId: "child-run",
+    childSessionKey: "agent:worker:child",
+    createdAt: 1,
+    generation: 1,
+    requesterSessionKey: requester.sessionKey,
+    requesterAgentId: requester.agentId,
+    completionTarget: "parent",
+    completionRequesterSessionId: requester.sessionId,
+    expectsCompletionMessage: true,
+    ...overrides,
+  });
+}
+
+function pending(...runs: ReturnType<typeof child>[]) {
+  return hasPendingPrivateSubagentCompletionFromRuns(
+    new Map(runs.map((run) => [run.runId, run])),
+    requester,
+  );
+}
+
+describe("private completion requester identity", () => {
+  it("pins a live private child and an ended child awaiting delivery", () => {
+    expect(pending(child())).toBe(true);
+    expect(pending(child({ endedAt: 2, delivery: { status: "pending" } }))).toBe(true);
+  });
+
+  it.each(["pending", "dispatching"] as const)(
+    "retains %s requester wake after child delivery and cleanup",
+    (status) => {
+      expect(
+        pending(
+          child({
+            endedAt: 2,
+            cleanupCompletedAt: 3,
+            delivery: { status: "delivered", disposition: "delivered" },
+            requesterSettleWake: { status, attemptCount: 1 },
+          }),
+        ),
+      ).toBe(true);
+    },
+  );
+
+  it.each([
+    { requesterSessionKey: "agent:main:other" },
+    { requesterAgentId: "other" },
+    { completionRequesterSessionId: "old-parent" },
+    { completionTarget: undefined },
+    { completionRequesterSessionId: undefined },
+  ])("does not pin unrelated private completion %j", (overrides) => {
+    expect(pending(child(overrides))).toBe(false);
+  });
+
+  it.each([
+    { suppressCompletionDelivery: true },
+    { suppressAnnounceReason: "killed" as const },
+    { suppressAnnounceReason: "steer-restart" as const },
+    { killReconciliation: { killedAt: 2, supersededAt: 3 } },
+  ])("ignores closed cancellation even with a retained wake %j", (overrides) => {

+  taskExecutorMocks: { setDetachedTaskDeliveryStatusByRunId: ReturnType<typeof vi.fn> };
+  completionDeliveryMocks: { blockSubagentCompletionDelivery: ReturnType<typeof vi.fn> };
+}): void {
+  it.each(["same controller", "restored controller", "restored without parent failure"])(
+    "retains actual parent failure through provisional cancellation with %s",
+    async (boundary) => {
+      const requester = "agent:main:cron:job:run:parent";
+      const completed = createRunEntry({
+        runId: "completed",
+        requesterSessionKey: requester,
+        requesterAgentId: "main",
+        endedAt: 4_000,
+        outcome: { status: "ok" },
+        expectsCompletionMessage: true,
+        completion: { required: true, resultText: "private finding", capturedAt: 4_001 },
+        delivery: { status: "pending" },
+        childSessionKey: "agent:main:subagent:completed",
+      });
+      const pending = createRunEntry({
+        runId: "pending",
+        requesterSessionKey: requester,
+        requesterAgentId: "main",
+        expectsCompletionMessage: true,
+        delivery: { status: "pending" },
+        childSessionKey: "agent:main:subagent:pending",
+      });
+      for (const entry of [completed, pending]) {
+        entry.requesterSettleWake = {
+          status: "pending",
+          attemptCount: 0,
+          requesterYieldBatch: true,
+          batchRunIds: ["completed", "pending"],
+          rearmGeneration: 1,
+          retireAfterSettle: true,
+        };
+      }
+      const tasks = new Map<
+        string,
+        { taskId: string; runId: string; status: string; deliveryStatus: string }
+      >([
+        [
+          "completed",
+          {
+            taskId: "task-completed",
+            runId: "completed",
+            status: "succeeded",
+            deliveryStatus: "pending",
+          },
+        ],
+        [
+          "pending",
+          {
+            taskId: "task-pending",
+            runId: "pending",
+            status: "running",
+            deliveryStatus: "pending",
+          },
+        ],
+      ]);
+      const runs = new Map([
+        [completed.runId, completed],
+        [pending.runId, pending],
+      ]);
+      const externalWake = vi.fn(async () => false);
+      const controller = createLifecycleController({
+        entry: completed,
+        runs,
+        resolveSubagentTask: (entry) => ({
+          lookup: "available",
+          task: tasks.get(entry.runId) as never,
+        }),
+        maybeWakeRequesterAfterAllChildrenSettled: externalWake,
+      });

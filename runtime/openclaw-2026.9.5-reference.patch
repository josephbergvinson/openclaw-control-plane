+    const turn = await admitted(item);
+    expect(readRuntimeConfig).toHaveBeenCalledOnce();
+    expect(mocks.resolveSecrets.mock.calls[0]?.[0].config).toBe(replacement);
+    expect(turn.config).toBe(resolved);
+    expect(turn.queued.run.config).toBe(resolved);
+    setRuntimeConfigSnapshot(retained, retained);
+    expect(turn.queued.run.config).toBe(resolved);
+    expect(mocks.admitReply).toHaveBeenCalledOnce();
+  });
+
+  it("does not retry admission or run work when secret resolution fails", async () => {
+    const retained = createConfig(true);
+    const replacement = createConfig(false);
+    setRuntimeConfigSnapshot(retained, retained);
+    const item = createQueued(retained);

+import path from "node:path";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { createDeferred } from "../../../test/helpers/promise.js";
+import { useAutoCleanupTempDirTracker } from "../../../test/helpers/temp-dir.js";
+import * as runtimeConfig from "../../config/config.js";
+import type { OpenClawConfig } from "../../config/types.openclaw.js";
+import { callGateway } from "../../gateway/call.js";
+import type { GatewayRecoveryRuntime } from "../../gateway/server-instance-runtime.types.js";
+import {
+  getAgentEventLifecycleGeneration,
+  resetAgentEventsForTest,
+} from "../../infra/agent-events.js";
+import { resetGatewayWorkAdmission } from "../../process/gateway-work-admission.js";
+import { cleanupSessionStateForTest } from "../../test-utils/session-state-cleanup.js";
+import { waitForFast } from "../subagent-test-fixtures.test-helpers.js";
+import { isRestartRecoveryDeliveryCurrent } from "./main-session-restart-recovery-delivery.js";
+import {
+  createRecoveryDispatchFixture,
+  discordDeliveryContext,
+  gatewayParams,
+  loadSessionEntry,
+  writeCompletedToolTranscript,
+  writeMainSession,
+} from "./main-session-restart-recovery.test-fixtures.js";
+
+vi.mock("../../gateway/call.js", () => ({
+  callGateway: vi.fn(async () => ({ runId: "run-resumed" })),
+}));
+
+const tempDirs = useAutoCleanupTempDirTracker(afterEach);
+let tmpDir: string;
+let dispatchSettlement = createDeferred();
+const {
+  sendRecoveryNotice,
+  mockRecoveryRuntime,
+  recoverRestartAbortedMainSessions,
+  makeSessionsDir,
+} = createRecoveryDispatchFixture(
+  () => dispatchSettlement,
+  () => tmpDir,
+);
+
+beforeEach(() => {
+  vi.clearAllMocks();
+  dispatchSettlement = createDeferred();
+  vi.mocked(callGateway).mockReset();
+  vi.mocked(callGateway).mockImplementation(async () => ({ runId: "run-resumed" }));
+  resetAgentEventsForTest();
+  resetGatewayWorkAdmission();
+  tmpDir = tempDirs.make("openclaw-recovery-progress-");
+});
+
+afterEach(async () => {
+  dispatchSettlement.resolve();
+  resetGatewayWorkAdmission();
+  await cleanupSessionStateForTest({ stateDir: tmpDir });
+});
+
+describe("main-session restart recovery progress visibility", () => {
+  it.each([
+    { label: "inherited hidden progress", globalProgress: false, visible: false },
+    { label: "inherited visible progress", globalProgress: true, visible: true },
+    {
+      label: "account enables progress",
+      globalProgress: false,
+      accountProgress: true,
+      visible: true,
+    },
+    {
+      label: "account hides progress",
+      globalProgress: true,
+      accountProgress: false,
+      visible: false,
+    },
+  ])(
+    "resumes Discord recovery with $label without gating typing",
+    async ({ globalProgress, accountProgress, visible }) => {
+      const cfg: OpenClawConfig = {
+        channels: {
+          discord: {
+            streaming: { mode: "progress", progress: { toolProgress: globalProgress } },
+            accounts:
+              accountProgress === undefined
+                ? undefined
+                : {
+                    main: {
+                      streaming: {
+                        mode: "progress",
+                        progress: { toolProgress: accountProgress },
+                      },
+                    },
+                  },
+          },
+        },
+      };
+      const runtimeConfigSpy = vi.spyOn(runtimeConfig, "getRuntimeConfig").mockReturnValue(cfg);
+      const stopTyping = vi.fn();
+      const startRecoveryTyping = vi.fn<NonNullable<GatewayRecoveryRuntime["startRecoveryTyping"]>>(
+        () => stopTyping,
+      );
+      try {
+        const sessionsDir = await makeSessionsDir();
+        const storePath = path.join(sessionsDir, "sessions.json");
+        const sessionKey = "agent:main:discord:direct:123";
+        const deliveryContext = { ...discordDeliveryContext, accountId: "main" };
+        await writeMainSession({
+          sessionsDir,
+          sessionKey,
+          deliveryContext,
+        });
+        await writeCompletedToolTranscript(sessionsDir);
+
+        await expect(
+          recoverRestartAbortedMainSessions({
+            cfg,
+            stateDir: tmpDir,
+            gatewayRuntime: { ...mockRecoveryRuntime, startRecoveryTyping },
+          }),
+        ).resolves.toEqual({ started: 1, settled: 0, failed: 0, skipped: 0 });
+        expect(callGateway).toHaveBeenCalledOnce();
+        expect(gatewayParams()).toMatchObject({ sessionKey, deliver: true, channel: "discord" });
+        expect(startRecoveryTyping).toHaveBeenCalledOnce();
+        expect(startRecoveryTyping.mock.calls[0]?.[0].isCurrent(cfg)).toBe(true);
+        const current = loadSessionEntry({ sessionKey, storePath });
+        if (!current) {
+          throw new Error("expected recovered Discord session");
+        }
+        expect(
+          isRestartRecoveryDeliveryCurrent({
+            sessionKey,
+            storePath,
+            sessionId: current.sessionId,
+            recoveryRunId: String(gatewayParams().idempotencyKey),
+            lifecycleGeneration: getAgentEventLifecycleGeneration(),
+            deliveryContext,
+            cfg,
+          }),
+        ).toBe(true);
+        if (visible) {
+          expect(sendRecoveryNotice).toHaveBeenCalledOnce();
+          expect(sendRecoveryNotice.mock.calls[0]?.[0]).toMatchObject({
+            ...deliveryContext,
+            liveOnly: true,
+          });
+          expect(sendRecoveryNotice.mock.calls[0]?.[0].isCurrent?.(cfg)).toBe(true);
+        } else {
+          expect(sendRecoveryNotice).not.toHaveBeenCalled();
+        }
+        dispatchSettlement.resolve();
+        await waitForFast(() => expect(stopTyping).toHaveBeenCalledOnce());
+      } finally {
+        dispatchSettlement.resolve();
+        runtimeConfigSpy.mockRestore();
+      }
+    },
+  );
+
+  it("rechecks Discord progress visibility at the recovery notice send boundary only", async () => {
+    let cfg: OpenClawConfig = {
+      channels: {
+        discord: { streaming: { mode: "progress", progress: { toolProgress: true } } },
+      },
+    };
+    const runtimeConfigSpy = vi
+      .spyOn(runtimeConfig, "getRuntimeConfig")
+      .mockImplementation(() => cfg);
+    const stopTyping = vi.fn();
+    const startRecoveryTyping = vi.fn<NonNullable<GatewayRecoveryRuntime["startRecoveryTyping"]>>(
+      () => stopTyping,
+    );
+    try {
+      const sessionsDir = await makeSessionsDir();
+      const storePath = path.join(sessionsDir, "sessions.json");
+      const sessionKey = "agent:main:discord:direct:123";
+      const deliveryContext = { ...discordDeliveryContext, accountId: "main" };
+      await writeMainSession({ sessionsDir, sessionKey, deliveryContext });
+      await writeCompletedToolTranscript(sessionsDir);
+      await expect(
+        recoverRestartAbortedMainSessions({
+          cfg,
+          stateDir: tmpDir,
+          gatewayRuntime: { ...mockRecoveryRuntime, startRecoveryTyping },
+        }),
+      ).resolves.toEqual({ started: 1, settled: 0, failed: 0, skipped: 0 });
+      expect(sendRecoveryNotice).toHaveBeenCalledOnce();
+      const notice = sendRecoveryNotice.mock.calls[0]?.[0];
+      expect(notice?.isCurrent?.(cfg)).toBe(true);
+      cfg = {
+        channels: {
+          discord: { streaming: { mode: "progress", progress: { toolProgress: false } } },
+        },
+      };
+      expect(notice?.isCurrent?.(cfg)).toBe(false);
+      expect(startRecoveryTyping.mock.calls[0]?.[0].isCurrent(cfg)).toBe(true);
+      const current = loadSessionEntry({ sessionKey, storePath });
+      if (!current) {
+        throw new Error("expected recovered Discord session");
+      }
+      expect(
+        isRestartRecoveryDeliveryCurrent({
+          sessionKey,
+          storePath,
+          sessionId: current.sessionId,
+          recoveryRunId: String(gatewayParams().idempotencyKey),
+          lifecycleGeneration: getAgentEventLifecycleGeneration(),
+          deliveryContext,
+          cfg,
+        }),
+      ).toBe(true);
+      dispatchSettlement.resolve();
+      await waitForFast(() => expect(stopTyping).toHaveBeenCalledOnce());
+      expect(notice?.isCurrent?.(cfg)).toBe(false);
+    } finally {
+      dispatchSettlement.resolve();
+      runtimeConfigSpy.mockRestore();
+    }
+  });
+});

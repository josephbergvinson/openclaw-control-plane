+import { describe, expect, it, vi } from "vitest";
+import { claimSubagentFollowupOwner } from "./subagent-followup-owner.js";
+import {
+  markRequesterTurnYieldedInRuns,
+  settleRequesterTurnAfterSessionSpawns,
+} from "./subagent-registry-requester-yield.js";
+import type { SubagentRunRecord } from "./subagent-registry.types.js";
+
+function fixture() {
+  const entry: SubagentRunRecord = {
+    runId: "followup-execution",
+    taskRunId: "original-task",
+    childSessionKey: "agent:main:dashboard:child",
+    requesterSessionKey: "agent:main:discord:channel:parent",
+    requesterAgentId: "main",
+    requesterDisplayKey: "parent",
+    task: "finish the remaining fix",
+    cleanup: "keep",
+    expectsCompletionMessage: true,
+    createdAt: 2,
+    execution: { status: "running", startedAt: 2 },
+    completion: { required: true },
+    delivery: { status: "pending" },
+  };
+  const runs = new Map([[entry.runId, entry]]);
+  const persistOrThrow = vi.fn();
+  return {
+    entry,
+    runs,
+    persistOrThrow,
+    claim: {
+      runs,
+      persistOrThrow,
+      runId: entry.runId,
+      taskRunId: "original-task",
+      childSessionKey: entry.childSessionKey,
+      requesterSessionKey: entry.requesterSessionKey,
+      requesterAgentId: "main",
+      requesterTurnRunId: "resumed-parent",
+    },
+  };
+}
+
+describe("native child follow-up completion ownership", () => {
+  it("lets the resumed parent yield and receives the same task's later completion", () => {
+    const { entry, claim, runs, persistOrThrow } = fixture();
+    // The initial spawn already completed and woke the parent. Reactivation
+    // has changed execution identity, retaining that original task identity.
+    const completion = claimSubagentFollowupOwner(claim);
+    expect(completion).toEqual({
+      runId: "original-task",
+      childSessionKey: entry.childSessionKey,
+      expectsCompletionMessage: true,
+    });
+    expect(markRequesterTurnYieldedInRuns(claim)).toBe(1);
+    const schedule = vi.fn();
+    expect(
+      settleRequesterTurnAfterSessionSpawns({
+        ...claim,
+        requesterYielded: true,
+        acceptedSessionSpawns: [completion!],
+        schedule,
+      }),
+    ).toBe(true);
+    expect(entry.requesterSettleWake).toMatchObject({
+      requesterYieldBatch: true,
+      batchRunIds: [entry.runId],
+      status: "pending",
+    });
+    expect(entry.requesterTurnRunId).toBeUndefined();
+    expect(schedule).not.toHaveBeenCalled();
+    expect(runs.size).toBe(1);
+    expect(persistOrThrow).toHaveBeenCalledTimes(3);
+  });
+
+  it("releases the current turn on a normal final without stranding child delivery", () => {
+    const { entry, claim } = fixture();
+    entry.requesterSettleWake = {
+      status: "dispatching",
+      attemptCount: 1,
+      rearmGeneration: 1,
+      requesterYieldBatch: true,
+      batchRunIds: [entry.runId],
+    };
+    const completion = claimSubagentFollowupOwner(claim)!;
+    expect(entry.requesterSettleWake).toEqual({
+      status: "pending",
+      attemptCount: 0,
+      rearmGeneration: 2,
+    });
+    entry.execution = { status: "terminal", endedAt: 3 };
+    const schedule = vi.fn();
+    expect(
+      settleRequesterTurnAfterSessionSpawns({
+        ...claim,
+        requesterYielded: false,
+        acceptedSessionSpawns: [completion],
+        schedule,
+      }),
+    ).toBe(true);
+    expect(entry.requesterTurnRunId).toBeUndefined();
+    expect(schedule).toHaveBeenCalledExactlyOnceWith(entry.runId, entry, "settle");
+  });
+
+  it.each([
+    { requesterSessionKey: "agent:other:main" },
+    { requesterAgentId: "other" },
+    { taskRunId: "unrelated-task" },
+    { runId: "superseded-run" },
+  ])("does not transfer a completion to an unrelated owner: %j", (overrides) => {
+    const { entry, claim, persistOrThrow } = fixture();
+    expect(claimSubagentFollowupOwner({ ...claim, ...overrides })).toBeUndefined();
+    expect(entry.requesterTurnRunId).toBeUndefined();
+    expect(persistOrThrow).not.toHaveBeenCalled();
+  });
+
+  it.each([true, false])(
+    "transfers a frozen sibling cohort and settles a resumed parent (yield=%s)",
+    (requesterYielded) => {
+      const { entry, claim, runs, persistOrThrow } = fixture();
+      const previousWake = {
+        status: "dispatching" as const,
+        attemptCount: 1,
+        rearmGeneration: 4,
+        requesterYieldBatch: true as const,
+        batchRunIds: ["old-execution", "sibling-execution", "other-execution"],
+      };
+      const sibling: SubagentRunRecord = {
+        ...entry,
+        runId: "sibling-execution",
+        taskRunId: "sibling-task",
+        childSessionKey: "agent:main:dashboard:sibling",
+        execution: { status: "terminal", endedAt: 3 },
+        requesterSettleWake: structuredClone(previousWake),
+      };
+      const other: SubagentRunRecord = {
+        ...sibling,
+        runId: "other-execution",
+        taskRunId: "other-task",
+        childSessionKey: "agent:main:dashboard:other",
+        requesterAgentId: "other",
+        requesterSettleWake: structuredClone(previousWake),
+      };
+      runs.set(sibling.runId, sibling);
+      runs.set(other.runId, other);
+      const otherBefore = structuredClone(other);
+      const completion = claimSubagentFollowupOwner({
+        ...claim,
+        previousRunId: "old-execution",
+        previousRequesterSettleWake: previousWake,
+      })!;
+      expect(sibling.requesterTurnRunId).toBe(claim.requesterTurnRunId);
+      expect(sibling.requesterSettleWake?.batchRunIds).toEqual(
+        [entry.runId, sibling.runId].toSorted(),
+      );
+      expect(entry.requesterSettleWake?.rearmGeneration).toBeGreaterThan(
+        previousWake.rearmGeneration,
+      );
+      expect(sibling.requesterSettleWake?.rearmGeneration).toBe(
+        entry.requesterSettleWake?.rearmGeneration,
+      );
+      expect(completion.completionSpawns).toEqual([
+        {
+          runId: "original-task",
+          childSessionKey: entry.childSessionKey,
+          expectsCompletionMessage: true,
+        },
+        {
+          runId: "sibling-task",
+          childSessionKey: sibling.childSessionKey,
+          expectsCompletionMessage: true,
+        },
+      ]);
+      if (requesterYielded) {
+        expect(markRequesterTurnYieldedInRuns(claim)).toBe(2);
+      } else {
+        entry.execution = { status: "terminal", endedAt: 4 };
+      }
+      const schedule = vi.fn();
+      expect(
+        settleRequesterTurnAfterSessionSpawns({
+          ...claim,
+          requesterYielded,
+          acceptedSessionSpawns: completion.completionSpawns!,
+          schedule,
+        }),
+      ).toBe(true);
+      expect(entry.requesterTurnRunId).toBeUndefined();
+      expect(sibling.requesterTurnRunId).toBeUndefined();
+      expect(other).toEqual(otherBefore);
+      expect(persistOrThrow.mock.calls[0]).toEqual([entry.runId, sibling.runId]);
+      if (requesterYielded) {
+        expect(schedule).not.toHaveBeenCalled();
+        expect(entry.requesterSettleWake?.batchRunIds).toEqual(
+          [entry.runId, sibling.runId].toSorted(),
+        );
+      } else {
+        expect(schedule).toHaveBeenCalledTimes(2);
+      }
+    },
+  );
+
+  it("rolls back every reclaimed frozen sibling when persistence fails", () => {
+    const { entry, claim, runs, persistOrThrow } = fixture();
+    entry.requesterSettleWake = {
+      status: "dispatching",
+      attemptCount: 1,
+      rearmGeneration: 4,
+      requesterYieldBatch: true,
+      batchRunIds: [entry.runId, "sibling-execution"],
+    };
+    const sibling: SubagentRunRecord = {
+      ...entry,
+      runId: "sibling-execution",
+      taskRunId: "sibling-task",
+      childSessionKey: "agent:main:dashboard:sibling",
+      requesterSettleWake: structuredClone(entry.requesterSettleWake),
+    };
+    runs.set(sibling.runId, sibling);
+    const before = structuredClone([...runs]);
+    persistOrThrow.mockImplementation(() => {
+      throw new Error("disk unavailable");
+    });
+    expect(() => claimSubagentFollowupOwner(claim)).toThrow("disk unavailable");
+    expect(persistOrThrow).toHaveBeenCalledWith(entry.runId, sibling.runId);
+    expect([...runs]).toEqual(before);
+  });
+
+  it("restores the prior pending wake when the owner transfer cannot persist", () => {
+    const { entry, claim, persistOrThrow } = fixture();
+    entry.requesterSettleWake = {
+      status: "pending",
+      attemptCount: 0,
+      requesterYieldBatch: true,
+      batchRunIds: [entry.runId],
+      rearmGeneration: 2,
+    };
+    const before = structuredClone(entry);
+    persistOrThrow.mockImplementation(() => {
+      throw new Error("disk unavailable");
+    });
+    expect(() => claimSubagentFollowupOwner(claim)).toThrow("disk unavailable");
+    expect(entry).toEqual(before);
+  });
+});

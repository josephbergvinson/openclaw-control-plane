diff --git a/extensions/codex/src/app-server/request-cancellation.test-support.ts b/extensions/codex/src/app-server/request-cancellation.test-support.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1f198bb4b159ee4520d26bd8922dc5a4955f8f9f
--- /dev/null
+++ b/extensions/codex/src/app-server/request-cancellation.test-support.ts
@@ -0,0 +1,154 @@
+import process from "node:process";
+import { setImmediate as nextEventLoopTurn } from "node:timers/promises";
+import { createDeferred } from "openclaw/plugin-sdk/extension-shared";
+import { expect, it, vi, type Mock } from "vitest";
+import type {
+  requestCodexAppServerJson as requestJson,
+  withCodexAppServerJsonClient as withJsonClient,
+} from "./request.js";
+import type { getLeasedSharedCodexAppServerClient as getLeasedClient } from "./shared-client.js";
+import { createClientHarness } from "./test-support.js";
+
+export function registerRequestCancellationTests(fixtures: {
+  requestCodexAppServerJson: typeof requestJson;
+  withCodexAppServerJsonClient: typeof withJsonClient;
+  sharedClientMocks: {
+    getSharedCodexAppServerClient: Mock<
+      (...args: Parameters<typeof getLeasedClient>) => Promise<unknown>
+    >;
+    createIsolatedCodexAppServerClient: ReturnType<typeof vi.fn>;
+    releaseLeasedSharedCodexAppServerClient: ReturnType<typeof vi.fn>;
+    retireSharedCodexAppServerClientIfCurrent: ReturnType<typeof vi.fn>;
+  };
+}): void {
+  const { requestCodexAppServerJson, withCodexAppServerJsonClient, sharedClientMocks } = fixtures;
+
+  it("rejects an already-aborted owner before creating its acquisition promise", async () => {
+    const abort = new AbortController();
+    const reason = new DOMException("cancelled before entry", "AbortError");
+    abort.abort(reason);
+    const unhandled: unknown[] = [];
+    const onUnhandled = (error: unknown) => unhandled.push(error);
+    const run = vi.fn(async () => "unexpected");
+    process.on("unhandledRejection", onUnhandled);
+    try {
+      await expect(
+        withCodexAppServerJsonClient({ signal: abort.signal, timeoutMs: 60_000 }, run),
+      ).rejects.toBe(reason);
+      // Deferred imports must not leave a rejected acquisition detached after caller settlement.
+      await nextEventLoopTurn();
+      await nextEventLoopTurn();
+      expect(sharedClientMocks.getSharedCodexAppServerClient).not.toHaveBeenCalled();
+      expect(sharedClientMocks.createIsolatedCodexAppServerClient).not.toHaveBeenCalled();
+      expect(sharedClientMocks.releaseLeasedSharedCodexAppServerClient).not.toHaveBeenCalled();
+      expect(sharedClientMocks.retireSharedCodexAppServerClientIfCurrent).not.toHaveBeenCalled();
+      expect(run).not.toHaveBeenCalled();
+      expect(unhandled).toEqual([]);
+    } finally {
+      process.off("unhandledRejection", onUnhandled);
+    }
+  });
+
+  it("consumes an abort while guarded request imports are pending without acquiring", async () => {
+    const abort = new AbortController();
+    const reason = new DOMException("cancelled during import", "AbortError");
+    const unhandled: unknown[] = [];
+    const onUnhandled = (error: unknown) => unhandled.push(error);
+    process.on("unhandledRejection", onUnhandled);
+    try {
+      const result = requestCodexAppServerJson({
+        method: "thread/list",
+        requestParams: { limit: 1 },
+        timeoutMs: 60_000,
+        signal: abort.signal,
+      });
+      const rejected = expect(result).rejects.toBe(reason);
+      // requestCodexAppServerJson yields to the sandbox import before entering the scoped owner.
+      abort.abort(reason);
+      await rejected;
+      await nextEventLoopTurn();
+      await nextEventLoopTurn();
+      expect(sharedClientMocks.getSharedCodexAppServerClient).not.toHaveBeenCalled();
+      expect(sharedClientMocks.createIsolatedCodexAppServerClient).not.toHaveBeenCalled();
+      expect(sharedClientMocks.retireSharedCodexAppServerClientIfCurrent).not.toHaveBeenCalled();
+      expect(unhandled).toEqual([]);
+    } finally {
+      process.off("unhandledRejection", onUnhandled);
+    }
+  });
+
+  it("cancels an acquisition and releases its late lease without a native write", async () => {
+    const abort = new AbortController();
+    const request = vi.fn(async () => ({ data: [] }));
+    const acquisition = createDeferred<{ request: typeof request }>();
+    const entered = createDeferred<void>();
+    sharedClientMocks.getSharedCodexAppServerClient.mockImplementationOnce(() => {
+      entered.resolve();
+      return acquisition.promise;
+    });
+    const unhandled: unknown[] = [];
+    const onUnhandled = (error: unknown) => unhandled.push(error);
+    process.on("unhandledRejection", onUnhandled);
+    const lateClient = { request };
+    try {
+      const result = requestCodexAppServerJson({
+        method: "thread/list",
+        requestParams: { limit: 1 },
+        timeoutMs: 60_000,
+        signal: abort.signal,
+      });
+      const rejected = expect(result).rejects.toMatchObject({ name: "AbortError" });
+      await entered.promise;
+      const options = sharedClientMocks.getSharedCodexAppServerClient.mock.calls[0]?.[0] as {
+        abandonSignal?: AbortSignal;
+      };
+      abort.abort(new DOMException("operator cancelled discovery", "AbortError"));
+      await rejected;
+      expect(options.abandonSignal?.aborted).toBe(true);
+      acquisition.resolve(lateClient);
+      await vi.waitFor(() =>
+        expect(
+          sharedClientMocks.releaseLeasedSharedCodexAppServerClient,
+        ).toHaveBeenCalledExactlyOnceWith(lateClient),
+      );
+      await nextEventLoopTurn();
+      expect(request).not.toHaveBeenCalled();
+      expect(sharedClientMocks.retireSharedCodexAppServerClientIfCurrent).not.toHaveBeenCalled();
+      expect(unhandled).toEqual([]);
+    } finally {
+      acquisition.resolve(lateClient);
+      process.off("unhandledRejection", onUnhandled);
+    }
+  });
+
+  it("cancels an overloaded catalog request without issuing its queued retry", async () => {
+    vi.useFakeTimers();
+    const harness = createClientHarness({ autoEmitExit: false });
+    const abort = new AbortController();
+    sharedClientMocks.getSharedCodexAppServerClient.mockResolvedValue(harness.client);
+    const result = requestCodexAppServerJson({
+      method: "thread/list",
+      requestParams: { limit: 1 },
+      timeoutMs: 60_000,
+      signal: abort.signal,
+    });
+    const rejected = expect(result).rejects.toMatchObject({ name: "AbortError" });
+    try {
+      const written = JSON.parse(await harness.waitForWrite(0));
+      harness.send({ id: written.id, error: { code: -32001, message: "Server overloaded" } });
+      await vi.advanceTimersByTimeAsync(0);
+      abort.abort(new DOMException("cancelled discovery", "AbortError"));
+      await rejected;
+      await vi.advanceTimersByTimeAsync(1_000);
+      expect(harness.writes).toHaveLength(1);
+      expect(harness.client.getCloseError()).toBeUndefined();
+      expect(
+        sharedClientMocks.releaseLeasedSharedCodexAppServerClient,
+      ).toHaveBeenCalledExactlyOnceWith(harness.client);
+      expect(sharedClientMocks.retireSharedCodexAppServerClientIfCurrent).not.toHaveBeenCalled();
+    } finally {
+      harness.client.close();
+      harness.emitExit();
+    }
+  });
+}

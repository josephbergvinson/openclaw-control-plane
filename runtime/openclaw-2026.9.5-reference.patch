index 0000000000000000000000000000000000000000..18ad9da433538656e36fea49887b8774061800bb
--- /dev/null
+++ b/test/scripts/managed-child-process.admission.test.ts
@@ -0,0 +1,145 @@
+import fs from "node:fs";
+import path from "node:path";
+import { pathToFileURL } from "node:url";
+import { describe, expect, it, vi } from "vitest";
+import { runManagedCommand } from "../../scripts/lib/managed-child-process.mts";
+import { resolveTestNodeExecPath } from "../../src/test-utils/node-process.js";
+import { createDeferred } from "../helpers/promise.js";
+import { createScriptTestHarness } from "./test-helpers.js";
+
+const { createTempDir } = createScriptTestHarness();
+const node = resolveTestNodeExecPath();
+const managedUrl = pathToFileURL(path.resolve("scripts/lib/managed-child-process.mts")).href;
+const tsxUrl = pathToFileURL(path.resolve("scripts/tsx.mjs")).href;
+
+describe.skipIf(process.platform === "win32")("native local check admission", () => {
+  it("refuses a competing process in another checkout before spawning and releases after abort joins", async () => {
+    const root = createTempDir("managed-host-admission-");
+    const admission = path.join(root, "host");
+    const checkouts: readonly [string, string] = [
+      path.join(root, "first"),
+      path.join(root, "second"),
+    ];
+    for (const checkout of checkouts) {
+      fs.mkdirSync(checkout);
+    }
+    const ready = createDeferred();
+    const abort = new AbortController();
+    const first = runManagedCommand({
+      bin: node,
+      args: ["-e", "setInterval(() => {}, 1000)"],
+      cwd: checkouts[0],
+      localCheckAdmission: admission,
+      signal: abort.signal,
+      timeoutMs: 10_000,
+      stdio: "ignore",
+      onReady: () => ready.resolve(),
+    }).catch((error: unknown) => error);
+    try {
+      await Promise.race([
+        ready.promise,
+        first.then((error) => {
+          throw new Error("first check ended before admission", { cause: error });
+        }),
+      ]);
+      const localSpawned = vi.fn();
+      await expect(
+        runManagedCommand({ bin: node, localCheckAdmission: admission, onReady: localSpawned }),
+      ).rejects.toMatchObject({ code: "ELOCAL_CHECK_BUSY" });
+      expect(localSpawned).not.toHaveBeenCalled();
+      const marker = path.join(checkouts[1], "spawned");
+      const contender = path.join(checkouts[1], "contender.mts");
+      fs.writeFileSync(
+        contender,
+        `import { runManagedCommand } from ${JSON.stringify(managedUrl)};
+try {
+  await runManagedCommand({
+    bin: process.execPath,
+    args: ["-e", ${JSON.stringify(`require('node:fs').writeFileSync(${JSON.stringify(marker)}, 'spawned')`)}],
+    localCheckAdmission: ${JSON.stringify(admission)},
+    stdio: "ignore",
+  });
+} catch (error) {
+  console.error(error.code);
+  process.exitCode = 1;
+}
+`,
+      );
+      let output = "";
+      const status = await runManagedCommand({
+        bin: node,
+        args: ["--import", tsxUrl, contender],
+        cwd: checkouts[1],
+        stdio: ["ignore", "pipe", "pipe"],
+        requireProcessTreeExit: true,
+        timeoutMs: 10_000,
+        onReady(child) {
+          child.stderr!.on("data", (chunk) => (output += String(chunk)));
+        },
+      });
+      expect(status, output).toBe(1);
+      expect(output).toContain("ELOCAL_CHECK_BUSY");
+      expect(fs.existsSync(marker)).toBe(false);
+      expect(fs.existsSync(path.join(admission, "owner.json"))).toBe(true);
+    } finally {
+      abort.abort();
+      await expect(first).resolves.toMatchObject({ code: "ABORT_ERR" });
+    }
+    expect(fs.existsSync(path.join(admission, "owner.json"))).toBe(false);
+    await expect(
+      runManagedCommand({
+        bin: node,
+        args: ["-e", ""],
+        localCheckAdmission: admission,
+        stdio: "ignore",
+      }),
+    ).resolves.toBe(0);
+  });
+
+  it("keeps an abandoned lease without relying on PID death or elapsed time", async () => {
+    const directory = createTempDir("managed-abandoned-admission-");
+    const owner = path.join(directory, "owner.json");
+    const bytes = '{"pid":2147483647,"startedAt":"2000-01-01T00:00:00.000Z"}\n';
+    fs.writeFileSync(owner, bytes);
+    const spawned = vi.fn();
+    await expect(
+      runManagedCommand({ bin: node, localCheckAdmission: directory, onReady: spawned }),
+    ).rejects.toMatchObject({ code: "ELOCAL_CHECK_BUSY" });
+    expect(spawned).not.toHaveBeenCalled();
+    expect(fs.readFileSync(owner, "utf8")).toBe(bytes);
+  });
+
+  it("releases a lease when the child could not spawn", async () => {
+    const directory = createTempDir("managed-spawn-admission-");
+    await expect(
+      runManagedCommand({ bin: path.join(directory, "missing"), localCheckAdmission: directory }),
+    ).rejects.toMatchObject({ code: "ENOENT" });
+    expect(fs.existsSync(path.join(directory, "owner.json"))).toBe(false);
+  });
+
+  it("releases after a watchdog joins the terminated native process tree", async () => {
+    const directory = createTempDir("managed-timeout-admission-");
+    await expect(
+      runManagedCommand({
+        bin: node,
+        args: ["-e", "setInterval(() => {}, 1000)"],
+        localCheckAdmission: directory,
+        timeoutMs: 100,
+        timeoutKillGraceMs: 50,
+        stdio: "ignore",
+      }),
+    ).rejects.toMatchObject({ code: "ETIMEDOUT" });
+    expect(fs.existsSync(path.join(directory, "owner.json"))).toBe(false);
+  });
+
+  it("refuses an already canceled check without creating a lease", async () => {
+    const root = createTempDir("managed-canceled-admission-");
+    const directory = path.join(root, "absent");
+    const abort = new AbortController();
+    abort.abort();
+    await expect(
+      runManagedCommand({ bin: node, localCheckAdmission: directory, signal: abort.signal }),
+    ).rejects.toMatchObject({ name: "AbortError" });
+    expect(fs.existsSync(directory)).toBe(false);
+  });
+});

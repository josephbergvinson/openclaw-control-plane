+describe("requester settle transient Gateway admission", () => {
+  it.each([false, true])(
+    "preserves typed pending custody through a serialized preaccept failure (private=%s)",
+    async (privateCompletion) => {
+      const sessionKey = "agent:main:announce-requester";
+      const sessionId = "announce-requester";
+      const preparing = createDeferredCore();
+      const release = createDeferredCore();
+      const appended: string[] = [];

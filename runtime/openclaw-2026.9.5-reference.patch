+  );
+
+  it("preserves a prior next-turn owner's stop without starting discovery", async () => {
+    await withContinuation("prior-stop", async ({ prompt, requests, server }) => {
+      await withTestTimeout(prompt, 2_000, "prior owner stop did not settle");

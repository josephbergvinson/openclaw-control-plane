+/** Natural public commentary stays in the same compositor and provider writer. */
+export const publishDiscordTaskProgress: NonNullable<
+  NonNullable<ChannelPlugin["streaming"]>["publishTaskProgress"]
+> = async (params) => {
+  params.assertCurrent();
+  const target = parseDiscordTarget(params.to, { defaultKind: "channel" });
+  if (target?.kind !== "channel") {
+    return { status: "unsupported" };
+  }
+  const client = createDiscordRestClient(params);
+  if (resolveDiscordPreviewStreamMode(client.account.config) !== "progress") {
+    return { status: "unsupported" };
+  }
+  if (!params.progressRequest) {
+    return { status: "withheld" };
+  }
+  const live = await publishDiscordRequestProgress({
+    scope: {
+      ...params.progressRequest,
+      accountId: client.account.accountId,
+      channelId: params.threadId != null ? String(params.threadId) : target.id,
+      ...(params.threadId != null ? { threadId: String(params.threadId) } : {}),
+    },
+    text: params.text,
+    assertCurrent: () => {
+      if (params.signal.aborted) {
+        throw new Error("Discord progress requester aborted");
+      }
+      params.assertCurrent();
+    },
+  });
+  if (live) {
+    return live;
+  }
+  const progress = await createContinuationProgress(params, client);
+  if (!progress) {
+    return { status: "unsupported" };
+  }
+  try {
+    await progress.replyOptions.onItemEvent?.({
+      kind: "preamble",
+      phase: "end",
+      progressText: params.text,
+    });
+    await progress.finish();
+    // finish flushes the ordinary progress controller; no separate delivery owner is introduced.
+    const messageId = progress.messageId?.();
+    return messageId ? { status: "visible", messageId } : { status: "withheld" };
+  } finally {
+    await progress.cleanup();
+  }
+};

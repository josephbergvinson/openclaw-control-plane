+import { afterEach, describe, expect, it, vi } from "vitest";
+import * as capability from "./message-action-turn-capability.js";
+
+afterEach(() => {
+  vi.useRealTimers();
+});
+
+describe("private supplied-user-source capability", () => {
+  const tuple = {
+    agentId: "main",
+    runId: "provided-cap-run",
+    sessionKey: "agent:main:main",
+    sessionId: "provided-cap-session",
+  };
+
+  it("keeps the body and source callbacks out of public capability and authorization projections", () => {
+    const token = capability.mintMessageActionTurnCapability({
+      ...tuple,
+      providedUserSource: {
+        kind: "dashboard",
+        readText: () => "private-dummy-body",
+        assertCurrent: () => {},
+      },
+    });
+    try {
+      const lookup = { ...tuple, token };
+      const source = capability.readMessageActionTurnProvidedUserSource(lookup);
+      expect(source?.kind).toBe("dashboard");
+      if (source?.kind !== "dashboard") {
+        throw new Error("Expected native private supplied source");
+      }
+      expect(source.readText()).toBe("private-dummy-body");
+      for (const projection of [
+        capability.resolveMessageActionTurnCapability(lookup),
+        capability.resolveMessageActionTurnAuthorization(lookup),
+        source,
+      ]) {
+        expect(JSON.stringify(projection)).not.toContain("private-dummy-body");
+        expect(JSON.stringify(projection)).not.toContain("readText");
+        expect(JSON.stringify(projection)).not.toContain("providedUserSource");
+      }
+    } finally {
+      capability.revokeMessageActionTurnCapability(token);
+    }
+  });
+
+  it("copies frozen native callbacks at mint instead of trusting later mutation of the caller wrapper", () => {
+    let current = true;
+    const originalRead = vi.fn(() => "original-private-dummy");
+    const originalGuard = vi.fn(() => {
+      if (!current) {
+        throw new Error("Original input retired");
+      }
+    });
+    const providedUserSource = {
+      kind: "dashboard" as const,
+      readText: originalRead,
+      assertCurrent: originalGuard,
+    };
+    const token = capability.mintMessageActionTurnCapability({ ...tuple, providedUserSource });
+    try {
+      const source = capability.readMessageActionTurnProvidedUserSource({ ...tuple, token });
+      if (source?.kind !== "dashboard") {
+        throw new Error("Expected native private supplied source");
+      }
+      providedUserSource.readText = vi.fn(() => "replaced-caller-value");
+      providedUserSource.assertCurrent = vi.fn();
+      expect(Object.isFrozen(source)).toBe(true);
+      expect(source.readText()).toBe("original-private-dummy");
+      expect(originalRead).toHaveBeenCalledOnce();
+      current = false;
+      expect(source.readText).toThrow("Original input retired");
+      expect(originalRead).toHaveBeenCalledOnce();
+    } finally {
+      capability.revokeMessageActionTurnCapability(token);
+    }
+  });
+
+  it.each(["revoke", "expire"] as const)(
+    "retires a retained source getter after native %s",
+    (retirement) => {
+      vi.useFakeTimers();
+      vi.setSystemTime(1_000);
+      const read = vi.fn(() => "retired-private-dummy");
+      const token = capability.mintMessageActionTurnCapability({
+        ...tuple,
+        ttlMs: 1_000,
+        providedUserSource: { kind: "dashboard", readText: read, assertCurrent: () => {} },
+      });
+      try {
+        const source = capability.readMessageActionTurnProvidedUserSource({ ...tuple, token });
+        if (source?.kind !== "dashboard") {
+          throw new Error("Expected native private supplied source");
+        }
+        if (retirement === "revoke") {
+          capability.revokeMessageActionTurnCapability(token);
+        } else {
+          vi.setSystemTime(2_000);
+        }
+        expect(source.readText).toThrow();
+        expect(read).not.toHaveBeenCalled();
+        expect(
+          capability.readMessageActionTurnProvidedUserSource({ ...tuple, token }),
+        ).toBeUndefined();
+      } finally {
+        capability.revokeMessageActionTurnCapability(token);
+      }
+    },
+  );
+
+  it.each([
+    { agentId: "other" },
+    { runId: "other" },
+    { sessionKey: "agent:main:other" },
+    { sessionId: "other" },
+  ])(
+    "refuses private-source lookup for a different admitted tuple ($runId $sessionId)",
+    (changed) => {
+      const token = capability.mintMessageActionTurnCapability({
+        ...tuple,
+        providedUserSource: {
+          kind: "dashboard",
+          readText: () => "private-dummy",
+          assertCurrent: () => {},
+        },
+      });
+      try {
+        expect(
+          capability.readMessageActionTurnProvidedUserSource({ ...tuple, token, ...changed }),
+        ).toBeUndefined();
+      } finally {
+        capability.revokeMessageActionTurnCapability(token);
+      }
+    },
+  );
+});

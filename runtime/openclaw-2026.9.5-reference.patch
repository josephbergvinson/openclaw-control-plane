@@ -0,0 +1,134 @@
+import Foundation
+import OpenClawKit
+import Testing
+@testable import OpenClaw
+@testable import OpenClawMacCLI
+
+/// Pure pipe/admission contracts: no Keychain, real process, AX or app state.
+@MainActor
+struct NativeCredentialResolverTests {
+    private func binding() throws -> NativeCredentialBinding {
+        try NativeCredentialBinding(
+            alias: "fixture.password", kind: .macLogin, account: "fixture",
+            hostID: "11111111-1111-4111-8111-111111111111",
+            bundleIDs: ["com.apple.ScreenContinuity"])
+    }
+
+    @Test func `private request rejects malformed oversized and other host bindings`() throws {
+        let binding = try self.binding()
+        let data = try JSONEncoder().encode(binding)
+        #expect(try NativeCredentialIPC.binding(request: data, hostID: binding.hostID) == binding)
+        #expect(throws: NativeCredentialError.refused) {
+            try NativeCredentialIPC.binding(request: data, hostID: "22222222-2222-4222-8222-222222222222")
+        }
+        for invalid in [Data("{}".utf8), Data(repeating: 65, count: 4097)] {
+            #expect(throws: NativeCredentialError.invalidBinding) {
+                try NativeCredentialIPC.binding(request: invalid, hostID: binding.hostID)
+            }
+        }
+    }
+
+    @Test func `resolver consumes a successful private pipe value exactly once`() async throws {
+        let binding = try self.binding()
+        var entries: [String] = []
+        try await NativeCredentialResolver.withSecret(binding, run: { request in
+            let decoded = try JSONDecoder().decode(NativeCredentialBinding.self, from: request)
+            #expect(decoded == binding)
+            return .init(output: Data("synthetic-password".utf8), terminationStatus: 0)
+        }, consume: { entries.append($0) })
+        #expect(entries == ["synthetic-password"])
+    }
+
+    @Test func `failed malformed and oversized child output never reaches the consumer`() async throws {
+        let binding = try self.binding()
+        let results: [BoundedProcessResult] = [
+            .init(output: Data("synthetic-password".utf8), terminationStatus: 1),
+            .init(output: Data(), terminationStatus: 0),
+            .init(output: Data(repeating: 65, count: 8193), terminationStatus: 0),
+            .init(output: Data([0xFF]), terminationStatus: 0),
+            .init(output: Data("synthetic\npassword".utf8), terminationStatus: 0),
+        ]
+        var consumed = false
+        for result in results {
+            await #expect(throws: NativeCredentialError.unavailable) {
+                try await NativeCredentialResolver.withSecret(binding, run: { _ in result }) { _ in consumed = true }
+            }
+        }
+        #expect(!consumed)
+    }
+
+    @Test func `timeout is fixed unavailable and cancellation stays cancellation`() async throws {
+        let binding = try self.binding()
+        var consumed = false
+        await #expect(throws: NativeCredentialError.unavailable) {
+            try await NativeCredentialResolver.withSecret(binding, run: { _ in throw BoundedProcessError.timedOut }) {
+                _ in consumed = true
+            }
+        }
+        await #expect(throws: CancellationError.self) {
+            try await NativeCredentialResolver.withSecret(binding, run: { _ in throw CancellationError() }) {
+                _ in consumed = true
+            }
+        }
+        #expect(!consumed)
+    }
+
+    @Test func `cancellation while awaiting the child refuses its subsequently returned value`() async throws {
+        let binding = try self.binding()
+        let started = AsyncStream.makeStream(of: CheckedContinuation<BoundedProcessResult, Never>.self)
+        var consumed = false
+        let task = Task {
+            try await NativeCredentialResolver.withSecret(binding, run: { _ in
+                await withCheckedContinuation { started.continuation.yield($0) }
+            }) { _ in consumed = true }
+        }
+        var iterator = started.stream.makeAsyncIterator()
+        let release = try #require(await iterator.next())
+        task.cancel()
+        release.resume(returning: .init(output: Data("synthetic-password".utf8), terminationStatus: 0))
+        await #expect(throws: CancellationError.self) { try await task.value }
+        #expect(!consumed)
+        started.continuation.finish()
+    }
+
+    @Test func `direct parent admission excludes shell node probe and changed identity`() {
+        let bundle = URL(fileURLWithPath: "/fixture/OpenClaw.app")
+        let app = bundle.appendingPathComponent("Contents/MacOS/OpenClaw").path
+        for scenario in 0..<7 {
+            var reads = 0
+            let environment = LocalGatewayAuthIPC.DirectAppParentEnvironment(
+                bundle: { bundle },
+                parentPID: { scenario == 6 && reads > 0 ? 202 : 101 },
+                process: { pid in
+                    reads += 1
+                    let path = switch scenario {
+                    case 1: "/bin/zsh"
+                    case 2: bundle.appendingPathComponent("Contents/Resources/node-worker/arm64/bin/node").path
+                    case 3: bundle.appendingPathComponent("Contents/MacOS/openclaw-mac").path
+                    default: app
+                    }
+                    return .init(
+                        pid: pid, parent: 1,
+                        startedSeconds: scenario == 4 && reads > 1 ? 20 : 10,
+                        startedMicroseconds: 5, path: path)
+                },
+                sealedBundle: { _ in true },
+                signedHash: { _, _ in scenario == 5 ? nil : Data([1, 2, 3]) })
+            let result = LocalGatewayAuthIPC.directAppParentIdentity(environment: environment)
+            #expect(scenario == 0 ? result == "101:10:5:010203" : result == nil)
+        }
+    }
+
+    @Test func `invalid helper bundle seal cannot authorize a direct parent`() {
+        var inspectedParentSignature = false
+        let bundle = URL(fileURLWithPath: "/fixture/OpenClaw.app")
+        let result = LocalGatewayAuthIPC.directAppParentIdentity(environment: .init(
+            bundle: { bundle }, parentPID: { 101 },
+            process: { .init(pid: $0, parent: 1, startedSeconds: 10, startedMicroseconds: 5,
+                            path: bundle.appendingPathComponent("Contents/MacOS/OpenClaw").path) },
+            sealedBundle: { _ in false },
+            signedHash: { _, _ in inspectedParentSignature = true; return Data([1]) }))
+        #expect(result == nil)
+        #expect(!inspectedParentSignature)
+    }
+}

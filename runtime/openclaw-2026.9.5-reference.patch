+          () => executeAgentTurn(createMinimalRunAgentTurnParams({ replyOperation, sessionCtx })),
+          { inheritRequestScope: false },
+        );
+
+        expect(result.kind).toBe("success");
+        expect(state.runEmbeddedAgentMock).toHaveBeenCalledOnce();

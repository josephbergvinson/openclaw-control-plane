diff --git a/extensions/codex/src/session-catalog-home-currentness.test.ts b/extensions/codex/src/session-catalog-home-currentness.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1c818d61e68862a4a31c65b0cf2de290a794d6d5
--- /dev/null
+++ b/extensions/codex/src/session-catalog-home-currentness.test.ts
@@ -0,0 +1,222 @@
+import os from "node:os";
+import { createDeferred } from "openclaw/plugin-sdk/extension-shared";
+import { describe, expect, it, vi } from "vitest";
+import type { CodexAppServerClientOptions } from "./app-server/shared-client.js";
+import type { CodexControlRequestOptions } from "./command-rpc.js";
+// The catalog and physical home resolver are real; only the native lease/RPC are mocked.
+import {
+  createCodexSessionCatalogControlFactory,
+  fs,
+  path,
+  tempDirs,
+  pinnedConnectionMocks,
+  commandRpcMocks,
+  idleThread,
+} from "./session-catalog.test-helpers.js";
+
+async function source() {
+  const root = await fs.mkdtemp(path.join(os.tmpdir(), "codex-catalog-home-currentness-"));
+  tempDirs.push(root);
+  const agentDir = path.join(root, "agent");
+  const homeA = path.join(root, "a");
+  const homeB = path.join(root, "b");
+  await Promise.all(
+    [agentDir, homeA, homeB].map((directory) => fs.mkdir(directory, { recursive: true })),
+  );
+  const canonicalA = await fs.realpath(homeA);
+  const canonicalB = await fs.realpath(homeB);
+  const link = path.join(agentDir, "codex-home");
+  await fs.symlink(canonicalA, link, "dir");
+  const config = {
+    agents: { ownership: "explicit" as const, entries: { selected: { agentDir } } },
+  };
+  const owner = createCodexSessionCatalogControlFactory({
+    config,
+    getRuntimeConfig: () => config,
+    getPluginConfig: () => ({ appServer: { homeScope: "agent" } }),
+  });
+  return {
+    owner,
+    captured: await owner.forNode("selected"),
+    canonicalA,
+    canonicalB,
+    async retarget() {
+      await fs.unlink(link);
+      await fs.symlink(canonicalB, link, "dir");
+    },
+  };
+}
+
+describe("catalog source physical currentness", () => {
+  it("admits the captured prepared home and rejects a restored selector's wrong prepared home", async () => {
+    const selected = await source();
+    expect(() => selected.captured.assertCurrent(selected.canonicalA)).not.toThrow();
+    expect(() => selected.captured.assertCurrent(selected.canonicalB)).toThrow(
+      "prepared home changed",
+    );
+    expect(() => selected.captured.assertCurrent(null)).toThrow("prepared home changed");
+    expect(() => selected.captured.assertCurrent()).not.toThrow();
+    expect((await selected.owner.forNode("selected")).sourceHomeId).toBe(
+      selected.captured.sourceHomeId,
+    );
+  });
+
+  it("passes prepared home admission through the ordinary native catalog request", async () => {
+    const selected = await source();
+    let rpcAccepted = false;
+    commandRpcMocks.codexControlRequest.mockImplementationOnce(
+      async (_config, _method, _params, options?: CodexControlRequestOptions) => {
+        options?.assertCurrent?.(selected.canonicalB);
+        rpcAccepted = true;
+        return { data: [] };
+      },
+    );
+    await expect(selected.captured.control.readThread("exact")).rejects.toThrow(
+      "prepared home changed",
+    );
+    expect(rpcAccepted).toBe(false);
+    expect(pinnedConnectionMocks.request).not.toHaveBeenCalled();
+  });
+
+  it("passes prepared home admission through a pinned eligibility acquisition", async () => {
+    const selected = await source();
+    let leaseAccepted = false;
+    pinnedConnectionMocks.getClient.mockImplementationOnce(
+      async (options?: CodexAppServerClientOptions) => {
+        options?.assertCurrent?.(selected.canonicalB);
+        leaseAccepted = true;
+        return pinnedConnectionMocks.client;
+      },
+    );
+    await expect(selected.captured.control.requireEligibleThread("exact")).rejects.toThrow(
+      "prepared home changed",
+    );
+    expect(leaseAccepted).toBe(false);
+    expect(pinnedConnectionMocks.request).not.toHaveBeenCalled();
+    expect(pinnedConnectionMocks.releaseClient).not.toHaveBeenCalled();
+  });
+
+  it("retains the same prepared home on every write in one pinned lease", async () => {
+    const selected = await source();
+    const original = (await selected.owner.homesForAgent("selected"))[0];
+    if (!original) {
+      throw new Error("Expected the captured source home");
+    }
+    const guard = vi.fn((preparedHome?: string | null) => original.assertCurrent(preparedHome));
+    const control = selected.owner.forRequest("selected", { ...original, assertCurrent: guard });
+    let callsAtAcquisition = 0;
+    pinnedConnectionMocks.getClient.mockImplementationOnce(
+      async (options?: CodexAppServerClientOptions) => {
+        options?.assertCurrent?.(selected.canonicalA);
+        callsAtAcquisition = guard.mock.calls.length;
+        return pinnedConnectionMocks.client;
+      },
+    );
+    pinnedConnectionMocks.request.mockImplementation(
+      async (params: { assertCurrent?: () => void }) => {
+        params.assertCurrent?.();
+        return { thread: idleThread({ id: "exact" }) };
+      },
+    );
+    await control.withPinnedConnection(async (pinned) => {
+      await pinned.readThread("exact");
+      await pinned.readThread("exact");
+    });
+    const ongoingChecks = guard.mock.calls.slice(callsAtAcquisition);
+    expect(ongoingChecks.length).toBeGreaterThanOrEqual(5);
+    expect(ongoingChecks.every(([preparedHome]) => preparedHome === selected.canonicalA)).toBe(
+      true,
+    );
+    expect(pinnedConnectionMocks.request).toHaveBeenCalledTimes(2);
+    expect(pinnedConnectionMocks.releaseClient).toHaveBeenCalledExactlyOnceWith(
+      pinnedConnectionMocks.client,
+    );
+  });
+
+  it("retains generation currentness for a remote source without comparing a local prepared home", async () => {
+    const root = await fs.mkdtemp(path.join(os.tmpdir(), "codex-catalog-remote-currentness-"));
+    tempDirs.push(root);
+    const config = {
+      agents: { ownership: "explicit" as const, entries: { selected: { agentDir: root } } },
+    };
+    const owner = createCodexSessionCatalogControlFactory({
+      config,
+      getRuntimeConfig: () => config,
+      getPluginConfig: () => ({
+        appServer: {
+          transport: "websocket",
+          url: "wss://fixture.invalid",
+          authToken: "synthetic-remote-currentness-fixture",
+          homeScope: "agent",
+        },
+      }),
+    });
+    const remote = (await owner.homesForAgent("selected"))[0];
+    if (!remote) {
+      throw new Error("Expected the remote source home");
+    }
+    expect(remote.appServer.connectionClass).toBe("remote");
+    expect(remote.localSessionsRoot).toBeUndefined();
+    expect(() => remote.assertCurrent("/fixture/unused-local-home")).not.toThrow();
+  });
+
+  it("retains a fresh owned home identity when an aliased parent is canonicalized on creation", async () => {
+    const root = await fs.mkdtemp(path.join(os.tmpdir(), "codex-fresh-owned-home-"));
+    tempDirs.push(root);
+    const agentDir = path.join(root, "agent");
+    await fs.mkdir(agentDir);
+    const config = {
+      agents: { ownership: "explicit" as const, entries: { selected: { agentDir } } },
+    };
+    const owner = createCodexSessionCatalogControlFactory({
+      config,
+      getRuntimeConfig: () => config,
+      getPluginConfig: () => ({ appServer: { homeScope: "agent" } }),
+    });
+    const captured = await owner.forNode("selected");
+    const canonicalHome = path.join(await fs.realpath(agentDir), "codex-home");
+    expect(captured.codexHome).toBe(canonicalHome);
+    const requested = (await owner.homesForAgent("selected"))[0]!;
+    expect(requested.appServer.start.homeScope).toBe("agent");
+    expect(requested.appServer.start.env?.CODEX_HOME).toBeUndefined();
+    await fs.mkdir(path.join(agentDir, "codex-home"));
+    expect(() => captured.assertCurrent(canonicalHome)).not.toThrow();
+    expect(() => captured.assertCurrent()).not.toThrow();
+    expect((await owner.forNode("selected")).sourceHomeId).toBe(captured.sourceHomeId);
+  });
+
+  it("rejects a retarget before acquisition and recaptures through the same resolver", async () => {
+    const selected = await source();
+    await selected.retarget();
+    await expect(selected.captured.control.requireEligibleThread("exact")).rejects.toThrow(
+      "home changed",
+    );
+    expect(pinnedConnectionMocks.getClient).not.toHaveBeenCalled();
+    expect(pinnedConnectionMocks.request).not.toHaveBeenCalled();
+    const replacement = await selected.owner.forNode("selected");
+    expect(replacement.codexHome).toBe(selected.canonicalB);
+    expect(replacement.sourceHomeId).not.toBe(selected.captured.sourceHomeId);
+  });
+
+  it("releases a lease acquired after retarget without issuing an eligibility RPC", async () => {
+    const selected = await source();
+    const entered = createDeferred<void>();
+    const lease = createDeferred<typeof pinnedConnectionMocks.client>();
+    pinnedConnectionMocks.getClient.mockImplementationOnce(async () => {
+      entered.resolve();
+      return lease.promise;
+    });
+    const lookup = selected.captured.control.requireEligibleThread("exact");
+    const rejected = expect(lookup).rejects.toThrow("home changed");
+    await entered.promise;
+    await selected.retarget();
+    lease.resolve(pinnedConnectionMocks.client);
+    await rejected;
+    expect(pinnedConnectionMocks.releaseClient).toHaveBeenCalledExactlyOnceWith(
+      pinnedConnectionMocks.client,
+    );
+    expect(pinnedConnectionMocks.request).not.toHaveBeenCalled();
+    const replacement = await selected.owner.forNode("selected");
+    expect(replacement.codexHome).toBe(selected.canonicalB);
+  });
+});

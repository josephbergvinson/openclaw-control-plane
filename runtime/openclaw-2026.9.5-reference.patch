+import { normalizeOptionalString } from "@openclaw/normalization-core/string-coerce";
+import {
+  resolveAdmittedRunActiveAssertion,
+  type AdmittedRunContext,
+} from "../../agents/admitted-run-context.js";
+import type { McpRequesterScopeContext } from "../../agents/mcp-requester-scope.js";
+import { withoutGatewayToolCallerIdentity } from "../../agents/tools/gateway-caller-context.js";
+import { readSessionInputProfileId } from "../../sessions/session-participant-input.js";
+import { resolveGlobalSingleton } from "../../shared/global-singleton.js";
+import { INTERNAL_MESSAGE_CHANNEL } from "../../utils/message-channel-constants.js";
+import {
+  getAdmittedCommandProfileAuthority,
+  getCommandSenderAuthority,
+} from "../command-sender-authority.js";
+import type { MsgContext } from "../templating.js";
+
+const QUEUED_ADMISSION_OWNER_STATE_KEY = Symbol.for("openclaw.queuedAdmissionOwnerState");
+const queuedAdmissionOwnerState = resolveGlobalSingleton(QUEUED_ADMISSION_OWNER_STATE_KEY, () => ({
+  keys: new WeakMap<object, string>(),
+  nextId: 1,
+}));
+
+/** Object identity separates retained lifetimes; it never establishes authority. */
+export function resolveQueuedReplyAdmissionOwnerKey(owner: object): string {
+  let key = queuedAdmissionOwnerState.keys.get(owner);
+  if (!key) {
+    key = `admission:${queuedAdmissionOwnerState.nextId++}`;
+    queuedAdmissionOwnerState.keys.set(owner, key);
+  }
+  return key;
+}
+
+const BIND_REPLY_MCP_ADMISSION = Symbol("openclaw.bindReplyMcpAdmission");
+type ReplyRequesterAssertion = (() => void) & {
+  [BIND_REPLY_MCP_ADMISSION]?: (context: AdmittedRunContext, signal?: AbortSignal) => void;
+};
+
+/** Only the callback minted below can transfer its verified principal to a native run owner. */
+function bindReplyMcpRequesterAdmission(
+  source: McpRequesterScopeContext,
+  context: AdmittedRunContext,
+  signal?: AbortSignal,
+): void {
+  // SAFETY: Only the locally minted assertion carries this module-private admission binder.
+  (source.mcpRequesterScopeAssertCurrent as ReplyRequesterAssertion | undefined)?.[
+    BIND_REPLY_MCP_ADMISSION
+  ]?.(context, signal);
+}
+
+/** Bind the requester before exposing admission to the reply execution owner. */
+export function withReplyMcpRequesterAdmission(
+  source: McpRequesterScopeContext,
+  lifetime: {
+    replyOperation?: { abortSignal?: AbortSignal };
+    opts?: { abortSignal?: AbortSignal };
+  },
+  onAdmitted: (context: AdmittedRunContext) => void,
+): (context: AdmittedRunContext) => void {
+  return (context) => {
+    bindReplyMcpRequesterAdmission(
+      source,
+      context,
+      lifetime.replyOperation?.abortSignal ?? lifetime.opts?.abortSignal,
+    );
+    onAdmitted(context);
+  };
+}
+
+/** Capture the live UI principal without turning a profile into channel sender authority. */
+export function captureReplyMcpRequesterScope(ctx: MsgContext): McpRequesterScopeContext {
+  if (
+    normalizeOptionalString(ctx.SenderId) ||
+    ctx.Provider !== INTERNAL_MESSAGE_CHANNEL ||
+    ctx.InternalTurnSource !== undefined ||
+    (ctx.InputProvenance && ctx.InputProvenance.kind !== "external_user")
+  ) {
+    return {};
+  }
+  const profileId = readSessionInputProfileId(ctx);
+  const authority = getCommandSenderAuthority(ctx);
+  if (!profileId || !authority || authority() !== profileId) {
+    return {};
+  }
+  const admittedProfileAuthority = getAdmittedCommandProfileAuthority(ctx);
+  let admittedContext: AdmittedRunContext | undefined;
+  let assertRunCurrent: (() => void) | undefined;
+  const assertCurrent: ReplyRequesterAssertion = () => {
+    assertRunCurrent?.();
+    // Only an exact admitted execution may omit transport presence. Initial
+    // admission remains live-caller sensitive, and actual profile retirement stays live.
+    const profileAuthority = assertRunCurrent ? admittedProfileAuthority : authority;
+    if (!profileAuthority || withoutGatewayToolCallerIdentity(profileAuthority) !== profileId) {
+      throw new Error("MCP requester profile authority is unavailable");
+    }
+  };
+  assertCurrent[BIND_REPLY_MCP_ADMISSION] = (context, signal) => {
+    if (admittedContext && admittedContext !== context) {
+      throw new Error("MCP requester admitted run owner changed");
+    }
+    const current = resolveAdmittedRunActiveAssertion(context, signal);
+    if (!current || !admittedProfileAuthority) {
+      throw new Error("MCP requester admitted run authority is unavailable");
+    }
+    admittedContext = context;
+    assertRunCurrent = current;
+    assertCurrent();
+  };
+  return {
+    // The UI is its own requester surface even when it opens an external-channel session.
+    // A delivery route's channel account cannot establish the UI caller's credentials.
+    mcpRequesterScope: Object.freeze({
+      requesterSenderId: profileId,
+      messageChannel: INTERNAL_MESSAGE_CHANNEL,
+    }),
+    mcpRequesterScopeAssertCurrent: assertCurrent,
+  };
+}

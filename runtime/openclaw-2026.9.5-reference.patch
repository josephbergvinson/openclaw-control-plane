diff --git a/src/auto-reply/reply/dispatch-acp-attachments.ts b/src/auto-reply/reply/dispatch-acp-attachments.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e356faebd7afe83071b21083f232831024d15b00
--- /dev/null
+++ b/src/auto-reply/reply/dispatch-acp-attachments.ts
@@ -0,0 +1,32 @@
+import type { AcpTurnAttachment } from "../../acp/control-plane/manager.types.js";
+
+export type OrderedAcpAttachment = {
+  attachment: AcpTurnAttachment;
+  sourceIndex?: number;
+  sequence: number;
+};
+
+export function appendOrderedAcpAttachments(params: {
+  entries: OrderedAcpAttachment[];
+  attachments: AcpTurnAttachment[];
+  sourceIndexes?: number[];
+}) {
+  for (const [index, attachment] of params.attachments.entries()) {
+    params.entries.push({
+      attachment,
+      sourceIndex: params.sourceIndexes?.[index],
+      sequence: params.entries.length,
+    });
+  }
+}
+
+export function resolveMergedAcpAttachments(entries: OrderedAcpAttachment[]): AcpTurnAttachment[] {
+  return entries
+    .toSorted((left, right) => {
+      if (left.sourceIndex !== undefined && right.sourceIndex !== undefined) {
+        return left.sourceIndex - right.sourceIndex || left.sequence - right.sequence;
+      }
+      return left.sequence - right.sequence;
+    })
+    .map((entry) => entry.attachment);
+}
diff --git a/src/auto-reply/reply/dispatch-acp-progress.ts b/src/auto-reply/reply/dispatch-acp-progress.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8a7bbec5bd04a7c4a143ea52ced8a3dabc0fd3e8
--- /dev/null
+++ b/src/auto-reply/reply/dispatch-acp-progress.ts
@@ -0,0 +1,50 @@
+import {
+  getAdmittedRunDelegatedAuthority,
+  type AdmittedRunContext,
+} from "../../agents/admitted-run-context.js";
+import { loadSessionEntryReadOnly } from "../../config/sessions/session-accessor.js";
+import {
+  assertAgentRunLifecycleGenerationCurrent,
+  getAgentEventLifecycleGeneration,
+} from "../../infra/agent-events.js";
+import type { ReplyProgressTurn } from "../get-reply-options.types.js";
+import type { FinalizedRuntimeMsgContext } from "../templating.js";
+
+/** ACP captures its admitted request; ingress presentation may seal after execution closes. */
+export function resolveAcpReplyProgressTurn(params: {
+  ctx: FinalizedRuntimeMsgContext;
+  target: { agentId: string; sessionKey: string; storePath: string };
+  sessionId?: string;
+  assertInputCurrent: () => void;
+  getAdmission: () => AdmittedRunContext | undefined;
+}): ReplyProgressTurn | undefined {
+  const { sessionId, target, ctx } = params;
+  const sourceMessageId = ctx.MessageSid;
+  const admission = params.getAdmission();
+  if (
+    !sessionId ||
+    !sourceMessageId ||
+    !admission ||
+    getAdmittedRunDelegatedAuthority(admission) === undefined
+  ) {
+    return undefined;
+  }
+  const lifecycleGeneration = getAgentEventLifecycleGeneration();
+  return {
+    sessionKey: target.sessionKey,
+    sessionId,
+    sourceMessageId,
+    channel: ctx.OriginatingChannel ?? ctx.Provider,
+    to: ctx.OriginatingTo ?? ctx.To,
+    accountId: ctx.AccountId,
+    threadId: ctx.MessageThreadId,
+    assertCurrent: () => {
+      assertAgentRunLifecycleGenerationCurrent(lifecycleGeneration);
+      params.assertInputCurrent();
+      const entry = loadSessionEntryReadOnly(target);
+      if (params.getAdmission() !== admission || entry?.sessionId !== sessionId) {
+        throw new Error("ACP source progress turn was replaced or ended");
+      }
+    },
+  };
+}

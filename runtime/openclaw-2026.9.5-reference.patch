+    const foreground = reserveForeground();
+    startTurn.mockImplementation(async (input) => {
+      input.assertAdmissionCurrent?.();
+      const completedUserMessage = {
+        role: "user",
+        content: "Completed child work is ready for review.",
+        idempotencyKey: input.preflight.request.idempotencyKey + ":user",
+        timestamp: 2,
+      } satisfies UserMessage & { idempotencyKey: string };
+      manager.appendMessage(completedUserMessage);
+      completeTurn(input);
+    });

@@ -0,0 +1,57 @@
+import type { FollowupRun } from "./queue/types.js";
+import type { ReplyOperation } from "./reply-run-registry.contracts.js";
+import {
+  resolveFollowupRunToolAuthorityFingerprint,
+  resolveReplyAutoAuthContextFingerprint,
+} from "./reply-tool-authority.js";
+
+/** Preserve the accepted automatic account while comparing a steered turn. */
+export function resolveFollowupRunSteeringAuthority(
+  followupRun: FollowupRun,
+  activeReplyOperation: ReplyOperation | undefined,
+) {
+  const activeToolAuthorityFingerprint = activeReplyOperation?.toolAuthorityFingerprint;
+  const acceptedAuth = activeReplyOperation?.acceptedAutoAuthProfile;
+  const acceptedAuthMatchesIncoming =
+    acceptedAuth !== undefined &&
+    followupRun.run.authProfileIdSource === "auto" &&
+    followupRun.run.authProfileId === acceptedAuth.acceptedProfileId &&
+    resolveReplyAutoAuthContextFingerprint(followupRun) === acceptedAuth.contextFingerprint &&
+    followupRun.run.provider === activeReplyOperation?.toolAuthorityRoute?.provider &&
+    followupRun.run.model === activeReplyOperation.toolAuthorityRoute.model;
+  // Normalize only the exact auto profile accepted by this attempt. All caller,
+  // account, configuration and tool-policy facts still participate in the hash.
+  const authorityInput = acceptedAuthMatchesIncoming
+    ? {
+        ...followupRun,
+        run: { ...followupRun.run, authProfileId: acceptedAuth.admittedProfileId },
+      }
+    : followupRun;
+  const incomingToolAuthorityFingerprint =
+    resolveFollowupRunToolAuthorityFingerprint(authorityInput);
+  const incomingAuthorityAtActiveRoute = activeReplyOperation?.toolAuthorityRoute
+    ? resolveFollowupRunToolAuthorityFingerprint(
+        authorityInput,
+        activeReplyOperation.toolAuthorityRoute,
+      )
+    : undefined;
+  const hasAuthorityMismatch =
+    activeReplyOperation !== undefined &&
+    activeToolAuthorityFingerprint !== incomingToolAuthorityFingerprint;
+  const hasRouteOnlyAuthorityMismatch =
+    hasAuthorityMismatch &&
+    activeToolAuthorityFingerprint !== undefined &&
+    incomingAuthorityAtActiveRoute === activeToolAuthorityFingerprint;
+  const requiresQueue =
+    (hasAuthorityMismatch && !hasRouteOnlyAuthorityMismatch) ||
+    (acceptedAuth !== undefined &&
+      acceptedAuth.acceptedProfileId !== acceptedAuth.admittedProfileId &&
+      !acceptedAuthMatchesIncoming);
+  return {
+    activeToolAuthorityFingerprint,
+    incomingToolAuthorityFingerprint,
+    hasRouteOnlyAuthorityMismatch,
+    requiresQueue,
+    isToolAuthorityCurrent: acceptedAuthMatchesIncoming ? acceptedAuth.isCurrent : undefined,
+  };
+}

@@ -0,0 +1,60 @@
+import type { OpenClawPluginApi } from "openclaw/plugin-sdk/plugin-entry";
+import { normalizeOptionalString } from "openclaw/plugin-sdk/string-coerce-runtime";
+import type { DetachedLaneCheckpoint } from "./detached-lane-checkpoint.js";
+import type { TrackedLane } from "./detached-lane-runtime.js";
+const DETACHED_LANE_SEND_TIMEOUT_MS = 60_000;
+
+function isProviderSendResult(value: unknown): value is { messageId?: unknown } {
+  return Boolean(value && typeof value === "object" && !Array.isArray(value));
+}
+
+function parseProviderMessageId(value: unknown): string | undefined {
+  if (!isProviderSendResult(value)) {
+    return undefined;
+  }
+  return normalizeOptionalString(value.messageId);
+}
+
+/** Observe the existing progress owner or the explicitly unbound ordinary-send fallback. */
+export async function publishDetachedLaneCheckpoint(params: {
+  api: OpenClawPluginApi;
+  lane: Pick<TrackedLane, "ownerSessionKey" | "taskId" | "runId" | "route">;
+  checkpoint: DetachedLaneCheckpoint;
+  signal: AbortSignal;
+  isCurrent: () => boolean;
+}): Promise<string | undefined> {
+  const { api, lane, checkpoint } = params;
+  const progress = await api.runtime.channel.reply.publishTaskProgress({
+    cfg: api.config,
+    sessionKey: lane.ownerSessionKey,
+    taskId: lane.taskId,
+    runId: lane.runId,
+    text: checkpoint.text,
+    signal: params.signal,
+    isCurrent: params.isCurrent,
+  });
+  if (progress.status === "visible") {
+    return progress.messageId;
+  }
+  if (progress.status !== "unbound") {
+    return undefined;
+  }
+  if (params.signal.aborted || !params.isCurrent()) {
+    return undefined;
+  }
+  return parseProviderMessageId(
+    await api.runtime.gateway.request(
+      "send",
+      {
+        channel: "discord",
+        to: lane.route.to,
+        ...(lane.route.accountId ? { accountId: lane.route.accountId } : {}),
+        ...(lane.route.threadId ? { threadId: lane.route.threadId } : {}),
+        sessionKey: lane.ownerSessionKey,
+        message: checkpoint.text,
+        idempotencyKey: `lane-contract:checkpoint:${lane.runId}:${checkpoint.key}`,
+      },
+      { timeoutMs: DETACHED_LANE_SEND_TIMEOUT_MS },
+    ),
+  );
+}

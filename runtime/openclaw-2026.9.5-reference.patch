diff --git a/apps/macos/Sources/OpenClaw/GatewayLocalAuthResolver.swift b/apps/macos/Sources/OpenClaw/GatewayLocalAuthResolver.swift
new file mode 100644
index 0000000000000000000000000000000000000000..6bb0893be8b800c403a2d18d07950712cae05ae6
--- /dev/null
+++ b/apps/macos/Sources/OpenClaw/GatewayLocalAuthResolver.swift
@@ -0,0 +1,177 @@
+import ConcurrencyExtras
+import Foundation
+import Security
+import Subprocess
+
+/// Resolves the local config's existing SecretRefs through the matching bundled runtime.
+/// The private pipe is memory-only; no credential copy, shell, or diagnostic output is retained.
+enum GatewayLocalAuthResolver {
+    /// One accepted connection's in-memory auth, shared by operator/node RPCs.
+    /// Disconnect retires it; config changes select a new key. No TTL or persistent copy.
+    final class ConnectionCache: @unchecked Sendable {
+        private struct Entry {
+            let id: UUID
+            let key: Data
+            let task: Task<Credentials, Error>
+        }
+
+        private let current = LockIsolated<Entry?>(nil)
+
+        func invalidate() {
+            self.current.withValue {
+                $0?.task.cancel()
+                $0 = nil
+            }
+        }
+
+        func resolve(
+            key: Data,
+            operation: @escaping @Sendable () async throws -> Credentials) async throws -> Credentials
+        {
+            let entry = self.current.withValue { current in
+                if let current, current.key == key { return current }
+                current?.task.cancel()
+                let entry = Entry(id: UUID(), key: key, task: Task { try await operation() })
+                current = entry
+                return entry
+            }
+            let credentials: Credentials
+            do {
+                credentials = try await entry.task.value
+            } catch {
+                self.current.withValue { current in
+                    if current?.id == entry.id { current = nil }
+                }
+                throw error
+            }
+            // A cancelled waiter does not own the operation shared by other consumers.
+            try Task.checkCancellation()
+            guard self.current.withValue({ $0?.id == entry.id }) else { throw CancellationError() }
+            return credentials
+        }
+    }
+
+    private static let connectionCache = ConnectionCache()
+
+    static func invalidate() {
+        self.connectionCache.invalidate()
+    }
+
+    struct Credentials: Decodable, Equatable, Sendable {
+        let version: Int
+        let token: String?
+        let password: String?
+    }
+
+    enum ResolutionError: LocalizedError {
+        case unavailable
+
+        var errorDescription: String? {
+            "Local Gateway credentials could not be resolved. Check the configured SecretRef."
+        }
+    }
+
+    static func request(root: [String: Any], env: [String: String]) throws -> Data? {
+        guard let gateway = root["gateway"] as? [String: Any],
+              gateway["mode"] as? String != "remote",
+              let auth = gateway["auth"] as? [String: Any]
+        else { return nil }
+        let remoteURL = ((gateway["remote"] as? [String: Any])?["url"] as? String)?
+            .trimmingCharacters(in: .whitespacesAndNewlines) ?? ""
+        guard gateway["mode"] as? String == "local" || remoteURL.isEmpty else { return nil }
+        let mode = auth["mode"] as? String
+        guard mode != "none", mode != "trusted-proxy" else { return nil }
+        let tokenIsReference = auth["token"] is [String: Any]
+        let hasToken = tokenIsReference ||
+            (auth["token"] as? String)?.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty == false
+        let hasPassword = auth["password"] is [String: Any] ||
+            (auth["password"] as? String)?.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty == false
+        let usePassword = mode == "password" || (mode != "token" && (
+            (env["OPENCLAW_GATEWAY_PASSWORD"]?.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty == false &&
+                !tokenIsReference) || (!hasToken && hasPassword)))
+        let kind = usePassword ? "password" : "token"
+        // A configured SecretRef is authoritative over ambient credentials.
+        // Literal and environment-string settings retain their native fast paths.
+        let hasReference = auth[kind] is [String: Any]
+        guard hasReference else { return nil }
+        let data = try JSONSerialization.data(withJSONObject: ["version": 1, "auth": auth])
+        guard data.count <= 32 * 1024 else { throw ResolutionError.unavailable }
+        return data
+    }
+
+    static func decode(_ result: BoundedProcessResult) throws -> Credentials {
+        guard result.terminationStatus == 0, result.output.count <= 32 * 1024,
+              let credentials = try? JSONDecoder().decode(Credentials.self, from: result.output),
+              credentials.version == 1,
+              credentials.token?.isEmpty == false || credentials.password?.isEmpty == false
+        else { throw ResolutionError.unavailable }
+        return credentials
+    }
+
+    static func resolve(request: Data, ownerKey: Data, env: [String: String]) async throws -> Credentials {
+        try await self.connectionCache.resolve(key: ownerKey) {
+            try await self.run(request: request, env: env)
+        }
+    }
+
+    static func validateBundleBeforeLaunch() async throws {
+        let bundle = Bundle.main.bundleURL
+        var own: SecCode?
+        var ownStatic: SecStaticCode?
+        var information: CFDictionary?
+        var requirement: SecRequirement?
+        var requirementString: CFString?
+        guard bundle.pathExtension == "app",
+              SecCodeCopySelf(SecCSFlags(), &own) == errSecSuccess, let own,
+              SecCodeCheckValidity(own, SecCSFlags(), nil) == errSecSuccess,
+              SecCodeCopyStaticCode(own, SecCSFlags(), &ownStatic) == errSecSuccess, let ownStatic,
+              SecCodeCopySigningInformation(ownStatic, SecCSFlags(rawValue: kSecCSSigningInformation), &information)
+              == errSecSuccess,
+              let information,
+              let team = (information as NSDictionary)[kSecCodeInfoTeamIdentifier] as? String, !team.isEmpty,
+              SecCodeCopyDesignatedRequirement(ownStatic, SecCSFlags(), &requirement) == errSecSuccess, let requirement,
+              SecRequirementCopyString(requirement, SecCSFlags(), &requirementString) == errSecSuccess,
+              let requirementString
+        else { throw ResolutionError.unavailable }
+        // Validate resources before executing their JavaScript, with a cancellable process deadline.
+        // Later caller proofs recheck the seal; this does not isolate arbitrary concurrent filesystem writes.
+        let result = try await BoundedProcess.run(
+            path: "/usr/bin/codesign",
+            arguments: ["--verify", "--deep", "--strict", "-R", "=\(requirementString)", bundle.path],
+            standardError: .discarded,
+            timeout: 15)
+        guard result.terminationStatus == 0 else { throw ResolutionError.unavailable }
+    }
+
+    private static func run(request: Data, env: [String: String]) async throws -> Credentials {
+        do {
+            let launch = try await CommandResolver.nodeHostWorkerLaunch()
+            guard let executable = launch.command.first else { throw ResolutionError.unavailable }
+            try await self.validateBundleBeforeLaunch()
+            var environment = env
+            environment.merge(launch.environment) { _, bundled in bundled }
+            if let bundledPath = launch.environment["PATH"], let originalPath = env["PATH"] {
+                environment["PATH"] = "\(bundledPath):\(originalPath)"
+            }
+            for key in environment.keys where key == "NODE_OPTIONS" || key == "NODE_PATH" ||
+                key == "LD_PRELOAD" || key.hasPrefix("DYLD_")
+            {
+                environment.removeValue(forKey: key)
+            }
+            environment["OPENCLAW_NO_RESPAWN"] = "1"
+            let result = try await BoundedProcess.run(
+                path: executable,
+                arguments: Array(launch.command.dropFirst()) + ["--resolve-local-auth"],
+                environment: environment,
+                workingDirectory: launch.currentDirectoryURL?.path,
+                standardInput: .array(Array(request)),
+                standardError: .discarded,
+                timeout: 60)
+            return try self.decode(result)
+        } catch is CancellationError {
+            throw CancellationError()
+        } catch {
+            throw ResolutionError.unavailable
+        }
+    }
+}
diff --git a/apps/macos/Sources/OpenClaw/NativeCredentialEntryService.swift b/apps/macos/Sources/OpenClaw/NativeCredentialEntryService.swift
new file mode 100644
index 0000000000000000000000000000000000000000..9d04c9db8fcc44948cea226fcaa5cdc435ed484f
--- /dev/null
+++ b/apps/macos/Sources/OpenClaw/NativeCredentialEntryService.swift
@@ -0,0 +1,794 @@
+import AppKit
+import ApplicationServices
+import Darwin
+import Foundation
+import OpenClawKit
+import Security
+
+/// Reasons describe this bounded observation, never authentication or permission.
+/// Only fixed diagnostics and bounded process identifiers leave the owner;
+/// native form text and fields remain private.
+struct NativeCredentialDiscoveryDiagnostics {
+    enum Reason: String {
+        case focusedWindowUnavailable = "focused_window_unavailable"
+        case axMetadataUnavailable = "ax_metadata_unavailable"
+        case secureFieldNotObserved = "secure_field_not_observed"
+        case secureFieldAmbiguous = "secure_field_ambiguous"
+        case formContextMissing = "form_context_missing"
+        case bindingAbsent = "binding_absent"
+        case bindingUnmatched = "binding_unmatched"
+        case eligible
+    }
+
+    enum BindingRejection: String {
+        case invalidBinding = "invalid_binding"
+        case hostMismatch = "host_mismatch"
+        case ownerNotBound = "owner_not_bound"
+        case accountEvidenceUnmatched = "account_evidence_unmatched"
+    }
+
+    enum FocusedElementStatus: String {
+        case unavailable
+        case metadataUnavailable = "metadata_unavailable"
+        case notSecure = "not_secure"
+        case secure
+    }
+
+    enum FocusedOwnerStatus: String {
+        case pidUnavailable = "pid_unavailable"
+        case applicationUnavailable = "application_unavailable"
+        case unsupported
+        case supported
+    }
+
+    enum WindowLookupSource: String {
+        case applicationFocusedWindow = "application_focused_window"
+        case focusedFieldWindow = "focused_field_window"
+        case focusedFieldParentChain = "focused_field_parent_chain"
+    }
+
+    struct FocusedElementObservation {
+        var elementPresent = false
+        var role: String?
+        var subrole: String?
+        var axReadFailureCount = 0
+
+        mutating func recordAXRead(_ result: AXError) {
+            if result != .success, result != .noValue, result != .attributeUnsupported {
+                self.axReadFailureCount += 1
+            }
+        }
+
+        var status: FocusedElementStatus {
+            if self.axReadFailureCount > 0 || self.elementPresent && self.role == nil {
+                return .metadataUnavailable
+            }
+            guard self.elementPresent else { return .unavailable }
+            return self.role == kAXTextFieldRole && self.subrole == kAXSecureTextFieldSubrole ? .secure : .notSecure
+        }
+    }
+
+    var frontmostOwnerPID: pid_t?
+    var frontmostOwnerBundleID: String?
+    var frontmostOwnerSupported: Bool?
+    var focusedElement: FocusedElementObservation?
+    var focusedOwnerPID: pid_t?
+    var focusedOwnerBundleID: String?
+    var focusedOwnerStatus: FocusedOwnerStatus?
+    var windowLookupSource: WindowLookupSource?
+    var windowLookupAXResult: Int32?
+    var windowLookupElementPresent: Bool?
+    var reason: Reason
+    var observedSecureFieldCount: Int?
+    var axReadFailureCount = 0
+    var focusedSecureFieldMatches: Bool?
+    var formContext: NativeCredentialPromptContext.Diagnostics?
+    var bindingCandidateCount = 0
+    var bindingRejections: [BindingRejection: Int] = [:]
+
+    mutating func recordAXRead(_ result: AXError) {
+        // Optional AX attributes can legitimately have no value/support. Other
+        // failures must not become evidence that a password field is absent.
+        if result != .success, result != .noValue, result != .attributeUnsupported {
+            self.axReadFailureCount += 1
+        }
+    }
+
+    var payload: [String: Any] {
+        var result: [String: Any] = [
+            "reason": self.reason.rawValue,
+            "axReadFailureCount": self.axReadFailureCount,
+            "bindingCandidateCount": self.bindingCandidateCount,
+            "bindingRejections": Dictionary(uniqueKeysWithValues: self.bindingRejections.map { (
+                $0.key.rawValue,
+                $0.value) }),
+        ]
+        if let pid = self.frontmostOwnerPID { result["frontmostOwnerPID"] = Int(pid) }
+        if let bundle = Self.processBundleID(self.frontmostOwnerBundleID) { result["frontmostOwnerBundleID"] = bundle }
+        if let supported = self.frontmostOwnerSupported { result["frontmostOwnerSupported"] = supported }
+        if let observation = self.focusedElement {
+            result["focusedElementStatus"] = observation.status.rawValue
+            result["focusedElementPresent"] = observation.elementPresent
+            result["focusedElementAXReadFailureCount"] = observation.axReadFailureCount
+        }
+        if let pid = self.focusedOwnerPID { result["focusedOwnerPID"] = Int(pid) }
+        if let bundle = Self.processBundleID(self.focusedOwnerBundleID) { result["focusedOwnerBundleID"] = bundle }
+        if let status = self.focusedOwnerStatus { result["focusedOwnerStatus"] = status.rawValue }
+        if let source = self.windowLookupSource { result["windowLookupSource"] = source.rawValue }
+        if let code = self.windowLookupAXResult { result["windowLookupAXResult"] = Int(code) }
+        if let present = self.windowLookupElementPresent { result["windowLookupElementPresent"] = present }
+        if let count = self.observedSecureFieldCount { result["observedSecureFieldCount"] = count }
+        if let matches = self.focusedSecureFieldMatches { result["focusedSecureFieldMatches"] = matches }
+        if let form = self.formContext { result["formContext"] = form.payload }
+        return result
+    }
+
+    private static func processBundleID(_ value: String?) -> String? {
+        // Process identifiers are bounded metadata, never arbitrary native form text.
+        guard let value, value.count <= 320,
+              value.range(of: #"^[A-Za-z0-9][A-Za-z0-9.-]*$"#, options: .regularExpression) != nil
+        else { return nil }
+        return value
+    }
+
+    mutating func recordRejectedBinding(_ binding: NativeCredentialBinding, host: String, bundleID: String) {
+        // Called only after the unchanged authorizes decision rejected a binding.
+        // This classification is not an alternative admission rule.
+        let reason: BindingRejection = if (try? binding.validate()) == nil {
+            .invalidBinding
+        } else if binding.hostID.caseInsensitiveCompare(host) != .orderedSame {
+            .hostMismatch
+        } else if !binding.bundleIDs.contains(bundleID) {
+            .ownerNotBound
+        } else {
+            .accountEvidenceUnmatched
+        }
+        self.bindingRejections[reason, default: 0] += 1
+    }
+}
+
+/// Separate from Peekaboo/CUA observation state: no password is sent to a driver,
+/// clipboard, trajectory recorder, tool response, or ordinary type. The private
+/// credential child returns bytes only through the native host's captured pipe.
+@MainActor
+final class NativeCredentialEntryService {
+    struct Prompt {
+        let bundleID: String
+        let accountEvidence: [String]
+        var selectedUsername: String?
+        let validate: @MainActor () throws -> Void
+        let setSecret: @MainActor (String) throws -> Void
+
+        var purpose: NativeCredentialPromptPurpose {
+            NativeCredentialPromptPurpose.resolve(nativeEvidence: self.accountEvidence)
+        }
+    }
+
+    struct Discovery {
+        let prompts: [Prompt]
+        var diagnostics: NativeCredentialDiscoveryDiagnostics
+    }
+
+    struct Environment {
+        var hostID: @MainActor () throws -> String
+        var bindings: @MainActor () throws -> [NativeCredentialBinding]
+        var prompts: @MainActor () throws -> Discovery
+        var withSecret: @MainActor (NativeCredentialBinding, @MainActor (String) throws -> Void) async throws -> Void
+        var now: @MainActor () -> Date
+        var localAccount: @MainActor () -> String = { NSUserName() }
+
+        static var live: Self {
+            Self(
+                hostID: NativeCredentialHost.identity,
+                bindings: NativeCredentialKeychain.bindings,
+                prompts: NativeCredentialAX.prompts,
+                withSecret: NativeCredentialResolver.withSecret,
+                now: Date.init)
+        }
+    }
+
+    nonisolated static let actionNames = ["credential_prompts", "type_secret"]
+
+    nonisolated static func addingCapabilities(_ descriptor: AnyCodable?) -> AnyCodable? {
+        guard let descriptor,
+              let encoded = try? JSONEncoder().encode(descriptor),
+              var value = (try? JSONSerialization.jsonObject(with: encoded)) as? [String: Any],
+              var actions = value["actions"] as? [String]
+        else { return descriptor }
+        for action in self.actionNames where !actions.contains(action) {
+            actions.append(action)
+        }
+        value["actions"] = actions
+        return AnyCodable(value)
+    }
+
+    private struct Admission {
+        let prompt: Prompt
+        let binding: NativeCredentialBinding
+        let scope: UUID
+        let generation: UInt64
+        let expires: Date
+    }
+
+    private let environment: Environment
+    private var admissions: [String: Admission] = [:]
+
+    init(environment: Environment = .live) {
+        self.environment = environment
+    }
+
+    func perform(
+        _ params: OpenClawComputerActParams,
+        scope: UUID,
+        generation: UInt64,
+        checkAllowed: @escaping @MainActor () throws -> Void) async throws -> OpenClawComputerActResult
+    {
+        try checkAllowed()
+        self.admissions = self.admissions.filter { $0.value.expires > self.environment.now() }
+        switch params.action {
+        case .credentialPrompts:
+            self.admissions = self.admissions.filter { $0.value.scope != scope }
+            let host = try self.environment.hostID()
+            let localAccount = self.environment.localAccount()
+            let bindings = try self.environment.bindings()
+            let discovery = try self.environment.prompts()
+            var diagnostics = discovery.diagnostics
+            try checkAllowed()
+            var rows: [[String: String]] = []
+            for prompt in discovery.prompts.prefix(16) {
+                try prompt.validate()
+                for binding in bindings where params.alias == nil || binding.alias == params.alias {
+                    diagnostics.bindingCandidateCount += 1
+                    guard binding.authorizes(
+                        hostID: host,
+                        bundleID: prompt.bundleID,
+                        accountEvidence: prompt.accountEvidence,
+                        purpose: prompt.purpose,
+                        localAccount: localAccount,
+                        selectedUsername: prompt.selectedUsername)
+                    else {
+                        diagnostics.recordRejectedBinding(binding, host: host, bundleID: prompt.bundleID)
+                        continue
+                    }
+                    let ref = "native-credential:v1:" + UUID().uuidString.lowercased()
+                    self.admissions[ref] = Admission(
+                        prompt: prompt,
+                        binding: binding,
+                        scope: scope,
+                        generation: generation,
+                        expires: self.environment.now().addingTimeInterval(60))
+                    rows.append([
+                        "promptRef": ref,
+                        "alias": binding.alias,
+                        "account": binding.account,
+                        "kind": binding.kind.rawValue,
+                        "bundleId": prompt.bundleID,
+                    ])
+                }
+            }
+            // Bounded state even if many executions probe without closing.
+            if self.admissions.count > 128 { self.admissions.removeAll()
+                throw NativeCredentialError.stalePrompt
+            }
+            if !rows.isEmpty {
+                diagnostics.reason = .eligible
+            } else if !discovery.prompts.isEmpty {
+                diagnostics.reason = diagnostics.axReadFailureCount > 0
+                    ? .axMetadataUnavailable
+                    : (diagnostics.bindingCandidateCount == 0 ? .bindingAbsent : .bindingUnmatched)
+            }
+            return OpenClawComputerActResult(ok: true, details: [
+                "credentialPrompts": AnyCodable(rows),
+                "credentialPromptDiagnostics": AnyCodable(diagnostics.payload),
+            ])
+        case .typeSecret:
+            guard params.text == nil, params.value == nil, params.windowRef == nil, params.elementRef == nil,
+                  let ref = params.promptRef, let alias = params.alias,
+                  let admission = self.admissions.removeValue(forKey: ref),
+                  admission.scope == scope, admission.generation == generation,
+                  admission.binding.alias == alias, admission.expires > self.environment.now()
+            else { throw NativeCredentialError.stalePrompt }
+            // The reference was consumed within its 60s admission lifetime.
+            // Bound the admitted operation separately so sealed-app checks can
+            // finish; current scope, binding and native field are still rechecked.
+            let operationExpires = self.environment.now().addingTimeInterval(120)
+            let validate = {
+                try checkAllowed()
+                guard operationExpires > self.environment.now() else { throw NativeCredentialError.stalePrompt }
+                guard try self.environment.bindings().contains(admission.binding),
+                      try admission.binding.authorizes(
+                          hostID: self.environment.hostID(),
+                          bundleID: admission.prompt.bundleID,
+                          accountEvidence: admission.prompt.accountEvidence,
+                          purpose: admission.prompt.purpose,
+                          localAccount: self.environment.localAccount(),
+                          selectedUsername: admission.prompt.selectedUsername)
+                else { throw NativeCredentialError.refused }
+                try admission.prompt.validate()
+            }
+            try validate()
+            try await self.environment.withSecret(admission.binding) { secret in
+                // Recheck current scope, binding and native field ownership
+                // after awaiting resolution, immediately before AX.
+                try validate()
+                try admission.prompt.setSecret(secret)
+            }
+            return OpenClawComputerActResult(ok: true, effect: .unverifiable, details: [
+                "credentialEntry": AnyCodable("entered"), "authenticationVerified": AnyCodable(false),
+            ])
+        default:
+            throw NativeCredentialError.refused
+        }
+    }
+}
+
+/// Authentication agents may have no AppKit launchDate. Pin the kernel's
+/// process incarnation instead, so missing Launch Services metadata does not
+/// reject their prompts and PID reuse still invalidates an admission.
+struct NativeCredentialProcessIdentity: Equatable {
+    let pid: pid_t
+    let userID: uid_t
+    let startedSeconds: UInt64
+    let startedMicroseconds: UInt64
+
+    static func capture(
+        _ pid: pid_t,
+        read: (pid_t, inout proc_bsdinfo, Int32) -> Int32 = {
+            proc_pidinfo($0, PROC_PIDTBSDINFO, 0, &$1, $2)
+        }) throws -> Self
+    {
+        var info = proc_bsdinfo()
+        let size = Int32(MemoryLayout<proc_bsdinfo>.size)
+        guard pid > 0, read(pid, &info, size) == size,
+              info.pbi_pid == UInt32(pid), info.pbi_start_tvsec > 0,
+              info.pbi_start_tvusec < 1_000_000
+        else { throw NativeCredentialError.refused }
+        return Self(
+            pid: pid,
+            userID: info.pbi_uid,
+            startedSeconds: info.pbi_start_tvsec,
+            startedMicroseconds: info.pbi_start_tvusec)
+    }
+}
+
+/// An OS modal can own the focused secure field while another app remains
+/// frontmost in Launch Services. Focus is not borrowed from a background form.
+enum NativeCredentialPromptFocus {
+    case frontmostApplication
+    case focusedSecureField
+
+    @MainActor
+    static func discover(
+        frontmost: () throws -> NativeCredentialEntryService.Discovery,
+        focused: () throws -> NativeCredentialEntryService.Discovery?) throws -> NativeCredentialEntryService.Discovery
+    {
+        var first = NativeCredentialEntryService.Discovery(
+            prompts: [], diagnostics: .init(reason: .focusedWindowUnavailable))
+        var firstError: NativeCredentialError?
+        do {
+            first = try frontmost()
+            if !first.prompts.isEmpty { return first }
+        } catch let error as NativeCredentialError {
+            firstError = error
+        }
+        if let overlay = try focused() {
+            if !overlay.prompts.isEmpty { return overlay }
+            if let firstError { throw firstError }
+            return overlay
+        }
+        if let firstError { throw firstError }
+        return first
+    }
+
+    func isCurrent(
+        ownerPID: pid_t,
+        frontmostPID: pid_t?,
+        focusedPID: pid_t?,
+        sameFocusedField: Bool,
+        frontmostBundleID: String? = nil) -> Bool
+    {
+        guard ownerPID > 0,
+              !["com.apple.loginwindow", "com.apple.ScreenSaver.Engine", "com.apple.SetupAssistant"]
+                  .contains(frontmostBundleID ?? "")
+        else { return false }
+        switch self {
+        case .frontmostApplication: return frontmostPID == ownerPID
+        case .focusedSecureField: return focusedPID == ownerPID && sameFocusedField
+        }
+    }
+}
+
+@MainActor
+private enum NativeCredentialAX {
+    static func prompts() throws -> NativeCredentialEntryService.Discovery {
+        guard AXIsProcessTrusted(), let app = NSWorkspace.shared.frontmostApplication,
+              !["com.apple.loginwindow", "com.apple.ScreenSaver.Engine", "com.apple.SetupAssistant"]
+                  .contains(app.bundleIdentifier ?? "")
+        else { throw NativeCredentialError.refused }
+        var focusedElement: NativeCredentialDiscoveryDiagnostics.FocusedElementObservation?
+        var focusedOwnerPID: pid_t?
+        var focusedOwnerBundleID: String?
+        var focusedOwnerStatus: NativeCredentialDiscoveryDiagnostics.FocusedOwnerStatus?
+        var discovery = try NativeCredentialPromptFocus.discover(frontmost: {
+            // Safari admission requires the actual system-focused secure field,
+            // not a password field found while inspecting its frontmost window.
+            guard self.supports(app.bundleIdentifier), app.bundleIdentifier != "com.apple.Safari" else {
+                return .init(prompts: [], diagnostics: .init(reason: .focusedWindowUnavailable))
+            }
+            return try self.discover(app, focus: .frontmostApplication, focusedField: nil)
+        }, focused: {
+            // Only the actual system-focused secure element can supply an overlay
+            // owner. Do not enumerate other apps/windows or substitute a web field.
+            guard let field = self.focusedSecureField(onObservation: { focusedElement = $0 }) else { return nil }
+            var pid: pid_t = 0
+            guard AXUIElementGetPid(field, &pid) == .success else {
+                focusedOwnerStatus = .pidUnavailable
+                return nil
+            }
+            focusedOwnerPID = pid
+            guard let owner = NSRunningApplication(processIdentifier: pid) else {
+                focusedOwnerStatus = .applicationUnavailable
+                return nil
+            }
+            focusedOwnerBundleID = owner.bundleIdentifier
+            guard self.supports(owner.bundleIdentifier) else {
+                focusedOwnerStatus = .unsupported
+                return nil
+            }
+            focusedOwnerStatus = .supported
+            return try self.discover(owner, focus: .focusedSecureField, focusedField: field)
+        })
+        discovery.diagnostics.frontmostOwnerPID = app.processIdentifier
+        discovery.diagnostics.frontmostOwnerBundleID = app.bundleIdentifier
+        discovery.diagnostics.frontmostOwnerSupported = self.supports(app.bundleIdentifier)
+        discovery.diagnostics.focusedElement = focusedElement
+        discovery.diagnostics.focusedOwnerPID = focusedOwnerPID
+        discovery.diagnostics.focusedOwnerBundleID = focusedOwnerBundleID
+        discovery.diagnostics.focusedOwnerStatus = focusedOwnerStatus
+        return discovery
+    }
+
+    private static func supports(_ bundleID: String?) -> Bool {
+        guard let bundleID else { return false }
+        return NativeCredentialBinding.supportedBundleIDs(for: .macLogin).contains(bundleID) ||
+            NativeCredentialBinding.supportedBundleIDs(for: .appleAccount).contains(bundleID)
+    }
+
+    private static func focusedSecureField(
+        onObservation: ((NativeCredentialDiscoveryDiagnostics.FocusedElementObservation) -> Void)? = nil)
+        -> AXUIElement?
+    {
+        var observation = NativeCredentialDiscoveryDiagnostics.FocusedElementObservation()
+        defer { onObservation?(observation) }
+        let system = AXUIElementCreateSystemWide()
+        AXUIElementSetMessagingTimeout(system, 0.25)
+        guard let field = self.element(system, kAXFocusedUIElementAttribute, onRead: {
+            observation.recordAXRead($0)
+        }) else { return nil }
+        observation.elementPresent = true
+        AXUIElementSetMessagingTimeout(field, 0.25)
+        observation.role = self.attribute(field, kAXRoleAttribute, onRead: {
+            observation.recordAXRead($0)
+        }) as? String
+        guard observation.role == kAXTextFieldRole else { return nil }
+        observation.subrole = self.attribute(field, kAXSubroleAttribute, onRead: {
+            observation.recordAXRead($0)
+        }) as? String
+        guard observation.subrole == kAXSecureTextFieldSubrole else { return nil }
+        return field
+    }
+
+    private static func discover(
+        _ app: NSRunningApplication, focus: NativeCredentialPromptFocus, focusedField: AXUIElement?) throws
+        -> NativeCredentialEntryService.Discovery
+    {
+        guard let bundleID = app.bundleIdentifier, self.supports(bundleID) else { throw NativeCredentialError.refused }
+        let identity = try NativeCredentialProcessIdentity.capture(app.processIdentifier)
+        try self.checkAppleCode(pid: app.processIdentifier, bundleID: bundleID)
+        let application = AXUIElementCreateApplication(app.processIdentifier)
+        AXUIElementSetMessagingTimeout(application, 1)
+        let lookup = self.locateWindow(
+            application: application, focusedField: focusedField, bundleID: bundleID, ownerPID: app.processIdentifier)
+        let windowDiagnostics = lookup.diagnostics
+        guard let window = lookup.window else {
+            return .init(prompts: [], diagnostics: windowDiagnostics)
+        }
+        let initial = try self.snapshot(window)
+        let resolved = NativeCredentialPromptContext.resolve(initial.nodes, bundleID: bundleID)
+        let secureFields = initial.nodes.indices.filter { initial.nodes[$0].isSecureField }
+        let focusedFieldMatches: Bool? = if let focusedField, secureFields.count == 1,
+                                            let index = secureFields.first
+        {
+            CFEqual(focusedField, initial.elements[index])
+        } else {
+            nil
+        }
+        var diagnostics = NativeCredentialPromptContext.diagnostics(
+            initial.nodes,
+            bundleID: bundleID,
+            resolved: resolved != nil,
+            axReadFailureCount: initial.axReadFailureCount,
+            focusedSecureFieldMatches: focusedFieldMatches)
+        diagnostics.windowLookupSource = windowDiagnostics.windowLookupSource
+        diagnostics.windowLookupAXResult = windowDiagnostics.windowLookupAXResult
+        diagnostics.windowLookupElementPresent = windowDiagnostics.windowLookupElementPresent
+        guard let prompt = resolved else { return .init(prompts: [], diagnostics: diagnostics) }
+        let field = initial.elements[prompt.field]
+        if let focusedField, !CFEqual(focusedField, field) {
+            return .init(prompts: [], diagnostics: diagnostics)
+        }
+        let context = initial.elements[prompt.context]
+        let evidence = prompt.evidence
+        let submit = prompt.submit.map { initial.elements[$0] }
+        let submitTitle = prompt.submit.flatMap { initial.nodes[$0].buttonTitle }
+        let usernameField = prompt.username.map { initial.elements[$0.field] }
+        let usernameLabel = prompt.username.map { initial.elements[$0.label] }
+        let selectedUsername: String? = if let usernameField, let usernameLabel {
+            try self.readUsername(usernameField, label: usernameLabel, window: window)
+        } else {
+            nil
+        }
+        let validate: @MainActor () throws -> Void = {
+            let currentSnapshot = try self.snapshot(window)
+            var windowPID: pid_t = 0
+            var fieldPID: pid_t = 0
+            let currentFocus = focusedField == nil ? nil : self.focusedSecureField()
+            var focusedPID: pid_t = 0
+            if let currentFocus { AXUIElementGetPid(currentFocus, &focusedPID) }
+            guard AXUIElementGetPid(window, &windowPID) == .success, windowPID == app.processIdentifier,
+                  AXUIElementGetPid(field, &fieldPID) == .success, fieldPID == app.processIdentifier,
+                  let current = NSRunningApplication(processIdentifier: app.processIdentifier),
+                  (try? NativeCredentialProcessIdentity.capture(app.processIdentifier)) == identity,
+                  current.bundleIdentifier == bundleID,
+                  focus.isCurrent(
+                      ownerPID: app.processIdentifier,
+                      frontmostPID: NSWorkspace.shared.frontmostApplication?.processIdentifier,
+                      focusedPID: currentFocus == nil ? nil : focusedPID,
+                      sameFocusedField: currentFocus.map { CFEqual($0, field) } ?? false,
+                      frontmostBundleID: NSWorkspace.shared.frontmostApplication?.bundleIdentifier),
+                  let currentWindow = self.locateWindow(
+                      application: application,
+                      focusedField: currentFocus,
+                      bundleID: bundleID,
+                      ownerPID: app.processIdentifier).window,
+                  CFEqual(currentWindow, window),
+                  let currentPrompt = NativeCredentialPromptContext.resolve(currentSnapshot.nodes, bundleID: bundleID),
+                  CFEqual(currentSnapshot.elements[currentPrompt.field], field),
+                  CFEqual(currentSnapshot.elements[currentPrompt.context], context),
+                  currentPrompt.evidence == evidence
+            else { throw NativeCredentialError.stalePrompt }
+            if let submit {
+                guard let currentSubmit = currentPrompt.submit,
+                      CFEqual(currentSnapshot.elements[currentSubmit], submit),
+                      currentSnapshot.nodes[currentSubmit].buttonTitle == submitTitle
+                else { throw NativeCredentialError.stalePrompt }
+            } else if currentPrompt.submit != nil {
+                throw NativeCredentialError.stalePrompt
+            }
+            if let usernameField, let usernameLabel, let selectedUsername {
+                guard let selected = currentPrompt.username,
+                      CFEqual(currentSnapshot.elements[selected.field], usernameField),
+                      CFEqual(currentSnapshot.elements[selected.label], usernameLabel),
+                      try self.readUsername(usernameField, label: usernameLabel, window: window) == selectedUsername
+                else { throw NativeCredentialError.stalePrompt }
+            } else if currentPrompt.username != nil {
+                throw NativeCredentialError.stalePrompt
+            }
+            try self.checkAppleCode(pid: app.processIdentifier, bundleID: bundleID)
+            var settable = DarwinBoolean(false)
+            guard AXUIElementIsAttributeSettable(field, kAXValueAttribute as CFString, &settable) == .success,
+                  settable.boolValue, self.attribute(field, kAXEnabledAttribute) as? Bool == true
+            else { throw NativeCredentialError.refused }
+        }
+        try validate()
+        return .init(prompts: [.init(
+            bundleID: bundleID,
+            accountEvidence: evidence,
+            selectedUsername: selectedUsername,
+            validate: validate,
+            setSecret: { secret in
+                try validate()
+                guard AXUIElementSetAttributeValue(
+                    field,
+                    kAXValueAttribute as CFString,
+                    secret as CFString) == .success
+                else { throw NativeCredentialError.entryFailed }
+            })], diagnostics: diagnostics)
+    }
+
+    private static func readUsername(_ field: AXUIElement, label: AXUIElement, window: AXUIElement) throws -> String {
+        // Read only the labelled username of a resolved administrator form.
+        // Role is checked on both sides of this one non-secret value read;
+        // ordinary snapshotting still never reads editable-field contents.
+        AXUIElementSetMessagingTimeout(field, 0.25)
+        try self.checkOrdinaryUsernameField(field, label: label, window: window)
+        var valueRead = AXError.failure
+        let value = self.attribute(field, kAXValueAttribute, onRead: { valueRead = $0 }) as? String
+        try self.checkOrdinaryUsernameField(field, label: label, window: window)
+        guard [.success, .noValue, .attributeUnsupported].contains(valueRead)
+        else { throw NativeCredentialError.unavailable }
+        guard let value, !value.isEmpty, value.count <= 320,
+              value == value.trimmingCharacters(in: .whitespacesAndNewlines),
+              !value.unicodeScalars.contains(where: CharacterSet.controlCharacters.contains)
+        else { throw NativeCredentialError.refused }
+        return value
+    }
+
+    private static func checkOrdinaryUsernameField(
+        _ field: AXUIElement, label: AXUIElement, window: AXUIElement) throws
+    {
+        var roleRead = AXError.failure
+        var subroleRead = AXError.failure
+        let role = self.attribute(field, kAXRoleAttribute, onRead: { roleRead = $0 }) as? String
+        let subrole = self.attribute(field, kAXSubroleAttribute, onRead: { subroleRead = $0 }) as? String
+        guard roleRead == .success, [.success, .noValue, .attributeUnsupported].contains(subroleRead)
+        else { throw NativeCredentialError.unavailable }
+        guard role == kAXTextFieldRole, subrole != kAXSecureTextFieldSubrole,
+              let currentLabel = self.element(field, kAXTitleUIElementAttribute), CFEqual(currentLabel, label),
+              let currentWindow = self.element(field, kAXWindowAttribute), CFEqual(currentWindow, window),
+              self.attribute(label, kAXRoleAttribute) as? String == kAXStaticTextRole
+        else { throw NativeCredentialError.stalePrompt }
+    }
+
+    private static func locateWindow(
+        application: AXUIElement, focusedField: AXUIElement?, bundleID: String, ownerPID: pid_t)
+        -> (window: AXUIElement?, diagnostics: NativeCredentialDiscoveryDiagnostics)
+    {
+        var diagnostics = NativeCredentialDiscoveryDiagnostics(reason: .focusedWindowUnavailable)
+        let owner = focusedField ?? application
+        let attribute = focusedField == nil ? kAXFocusedWindowAttribute : kAXWindowAttribute
+        diagnostics.windowLookupSource = focusedField == nil ? .applicationFocusedWindow : .focusedFieldWindow
+        var directResult = AXError.success
+        let directWindow = self.element(owner, attribute, onRead: {
+            diagnostics.recordAXRead($0)
+            diagnostics.windowLookupAXResult = $0.rawValue
+            directResult = $0
+        })
+        if directWindow == nil, [.noValue, .attributeUnsupported].contains(directResult),
+           focusedField != nil, bundleID == "com.apple.Safari"
+        {
+            diagnostics.windowLookupSource = .focusedFieldParentChain
+        }
+        let window = NativeCredentialPromptWindow.resolve(
+            direct: (window: directWindow, result: directResult),
+            bundleID: bundleID,
+            focusedField: focusedField,
+            ownerPID: ownerPID,
+            readAncestor: { element, budget in
+                let deadline = ProcessInfo.processInfo.systemUptime + budget
+                let read: (String) -> CFTypeRef? = { name in
+                    let remaining = deadline - ProcessInfo.processInfo.systemUptime
+                    guard remaining > 0 else { return nil }
+                    AXUIElementSetMessagingTimeout(element, Float(min(remaining, 0.1)))
+                    return self.attribute(element, name, onRead: { diagnostics.recordAXRead($0) })
+                }
+                var pid: pid_t = 0
+                guard AXUIElementGetPid(element, &pid) == .success, pid == ownerPID,
+                      let role = read(kAXRoleAttribute) as? String, !role.isEmpty
+                else { return nil }
+                let subrole = role == kAXTextFieldRole ? read(kAXSubroleAttribute) as? String : nil
+                var parent: AXUIElement?
+                if role != kAXWindowRole {
+                    guard let value = read(kAXParentAttribute), CFGetTypeID(value) == AXUIElementGetTypeID()
+                    else { return nil }
+                    parent = unsafeDowncast(value, to: AXUIElement.self)
+                }
+                return .init(role: role, subrole: subrole, ownerPID: pid, parent: parent)
+            },
+            sameElement: { CFEqual($0, $1) },
+            now: { ProcessInfo.processInfo.systemUptime })
+        diagnostics.windowLookupElementPresent = window != nil
+        if diagnostics.axReadFailureCount > 0 { diagnostics.reason = .axMetadataUnavailable }
+        return (window, diagnostics)
+    }
+
+    private static func checkAppleCode(pid: pid_t, bundleID: String) throws {
+        guard bundleID.range(of: #"^com\.apple\.[a-zA-Z0-9.-]+$"#, options: .regularExpression) != nil else {
+            throw NativeCredentialError.refused
+        }
+        var code: SecCode?
+        var requirement: SecRequirement?
+        let attributes = [kSecGuestAttributePid as String: NSNumber(value: pid)] as CFDictionary
+        guard SecCodeCopyGuestWithAttributes(nil, attributes, [], &code) == errSecSuccess, let code,
+              SecRequirementCreateWithString(
+                  "anchor apple and identifier \"\(bundleID)\"" as CFString,
+                  [],
+                  &requirement) == errSecSuccess, let requirement,
+              SecCodeCheckValidity(code, [], requirement) == errSecSuccess else { throw NativeCredentialError.refused }
+    }
+
+    private static func attribute(
+        _ element: AXUIElement, _ name: String, onRead: ((AXError) -> Void)? = nil) -> CFTypeRef?
+    {
+        var value: CFTypeRef?
+        let result = AXUIElementCopyAttributeValue(element, name as CFString, &value)
+        onRead?(result)
+        guard result == .success else { return nil }
+        return value
+    }
+
+    private static func element(
+        _ parent: AXUIElement, _ name: String, onRead: ((AXError) -> Void)? = nil) -> AXUIElement?
+    {
+        guard let value = self.attribute(parent, name, onRead: onRead), CFGetTypeID(value) == AXUIElementGetTypeID()
+        else { return nil }
+        return unsafeDowncast(value, to: AXUIElement.self)
+    }
+
+    private static func snapshot(_ root: AXUIElement) throws -> (
+        elements: [AXUIElement], nodes: [NativeCredentialPromptContext.Node], axReadFailureCount: Int)
+    {
+        let deadline = ProcessInfo.processInfo.systemUptime + 2
+        var elements: [AXUIElement] = []
+        var nodes: [NativeCredentialPromptContext.Node] = []
+        var diagnostics = NativeCredentialDiscoveryDiagnostics(reason: .axMetadataUnavailable)
+        var queue: [(element: AXUIElement, parent: Int?)] = [(root, nil)]
+        var titleElements: [(field: Int, label: AXUIElement)] = []
+        var defaultButtons: [(context: Int, button: AXUIElement)] = []
+        var index = 0
+        while index < queue.count, nodes.count < 512 {
+            let (next, parent) = queue[index]
+            index += 1
+            guard !elements.contains(where: { CFEqual($0, next) }) else { continue }
+            let read: (String) throws -> CFTypeRef? = { name in
+                let remaining = deadline - ProcessInfo.processInfo.systemUptime
+                guard remaining > 0 else { throw NativeCredentialError.unavailable }
+                AXUIElementSetMessagingTimeout(next, Float(min(remaining, 0.25)))
+                return self.attribute(next, name, onRead: { diagnostics.recordAXRead($0) })
+            }
+            // Web content belongs to browser origin policy, even inside an
+            // Apple-signed app. This route enters native secure fields only.
+            let role = try read(kAXRoleAttribute) as? String ?? ""
+            guard role != "AXWebArea" else { continue }
+            let subrole = try read(kAXSubroleAttribute) as? String
+            let identifier = [kAXImageRole, kAXSheetRole].contains(role)
+                ? try read(kAXIdentifierAttribute) as? String : nil
+            var text: [String] = []
+            var buttonTitle: String?
+            if role != kAXTextFieldRole {
+                // Never read values, titles or descriptions from password or
+                // editable text fields, including during a field-type change.
+                let names = role == kAXStaticTextRole
+                    ? [kAXTitleAttribute, kAXDescriptionAttribute, kAXValueAttribute]
+                    : [kAXTitleAttribute, kAXDescriptionAttribute]
+                for name in names {
+                    if let value = try read(name) as? String, !value.isEmpty, value.count <= 2048 {
+                        text.append(value)
+                        if role == kAXButtonRole, buttonTitle == nil { buttonTitle = value }
+                    }
+                }
+            }
+            let nodeIndex = nodes.count
+            if role == kAXTextFieldRole, subrole != kAXSecureTextFieldSubrole,
+               let title = try read(kAXTitleUIElementAttribute), CFGetTypeID(title) == AXUIElementGetTypeID()
+            {
+                titleElements.append((nodeIndex, unsafeDowncast(title, to: AXUIElement.self)))
+            }
+            if role == kAXWindowRole || role == kAXSheetRole || subrole == kAXDialogSubrole,
+               let button = try read(kAXDefaultButtonAttribute), CFGetTypeID(button) == AXUIElementGetTypeID()
+            {
+                defaultButtons.append((nodeIndex, unsafeDowncast(button, to: AXUIElement.self)))
+            }
+            elements.append(next)
+            nodes.append(.init(
+                parent: parent,
+                role: role,
+                subrole: subrole,
+                text: text,
+                identifier: identifier,
+                buttonTitle: buttonTitle))
+            if let children = try read(kAXChildrenAttribute) as? [AXUIElement] {
+                guard children.count <= 512 - queue.count else { throw NativeCredentialError.refused }
+                queue.append(contentsOf: children.map { ($0, nodeIndex) })
+            }
+        }
+        guard index == queue.count else { throw NativeCredentialError.refused }
+        for title in titleElements {
+            nodes[title.field].titleElement = elements.firstIndex { CFEqual($0, title.label) }
+        }
+        for button in defaultButtons {
+            nodes[button.context].defaultButton = elements.firstIndex { CFEqual($0, button.button) }
+        }
+        return (elements, nodes, diagnostics.axReadFailureCount)
+    }
+}
diff --git a/apps/macos/Sources/OpenClaw/NativeCredentialPromptContext.swift b/apps/macos/Sources/OpenClaw/NativeCredentialPromptContext.swift
new file mode 100644
index 0000000000000000000000000000000000000000..a4c46237127c15f97eccced1a6dd5e659bc08da8
--- /dev/null
+++ b/apps/macos/Sources/OpenClaw/NativeCredentialPromptContext.swift
@@ -0,0 +1,368 @@
+import ApplicationServices
+import Foundation
+import OpenClawKit
+
+/// The account must belong to the password form, not an unrelated sidebar or
+/// another sheet in the same app. This policy is independent of live AX reads.
+enum NativeCredentialPromptContext {
+    struct Node {
+        let parent: Int?
+        let role: String
+        let subrole: String?
+        let text: [String]
+        var identifier: String?
+        var titleElement: Int?
+        var buttonTitle: String?
+        var defaultButton: Int?
+
+        var isSecureField: Bool {
+            self.role == kAXTextFieldRole && self.subrole == kAXSecureTextFieldSubrole
+        }
+
+        var isDialog: Bool {
+            self.role == kAXSheetRole || self.subrole == kAXDialogSubrole
+        }
+    }
+
+    struct UsernameControl {
+        let field: Int
+        let label: Int
+    }
+
+    struct Form {
+        let field: Int
+        let context: Int
+        let evidence: [String]
+        var username: UsernameControl?
+        var submit: Int?
+    }
+
+    /// These facts describe the same bounded snapshot used by resolve. They are
+    /// not admission rules and contain no node text, identifiers or field values.
+    struct Diagnostics {
+        enum ContextKind: String { case dialog, ownerWindow = "owner_window" }
+        enum UsernameLabel: String {
+            case noOrdinaryField = "no_ordinary_field"
+            case ambiguousOrdinaryFields = "ambiguous_ordinary_fields"
+            case missing
+            case outsideForm = "outside_form"
+            case notStaticText = "not_static_text"
+            case unrecognized
+            case associated
+        }
+
+        enum DefaultSubmit: String {
+            case missing
+            case outsideForm = "outside_form"
+            case notButton = "not_button"
+            case missingTitle = "missing_title"
+            case nonSubmitButton = "non_submit_button"
+            case associated
+        }
+
+        let contextKind: ContextKind
+        let purpose: NativeCredentialPromptPurpose
+        let ordinaryFieldCount: Int
+        let otherEditorCount: Int
+        let usernameLabel: UsernameLabel
+        let cancelButtonPresent: Bool
+        let defaultSubmit: DefaultSubmit
+
+        var payload: [String: Any] {
+            let purposeName = switch self.purpose {
+            case .accountAuthentication: "account_authentication"
+            case .administratorAuthentication: "administrator_authentication"
+            case .unsupportedAdministratorAuthentication: "unsupported_administrator_authentication"
+            case .unsupportedKeychainAccess: "unsupported_keychain_access"
+            case .loginKeychainAuthentication: "login_keychain_authentication"
+            case .autoFillAuthentication: "autofill_authentication"
+            case .passwordsUnlockAuthentication: "passwords_unlock_authentication"
+            }
+            return [
+                "contextKind": self.contextKind.rawValue,
+                "purpose": purposeName,
+                "ordinaryFieldCount": self.ordinaryFieldCount,
+                "otherEditorCount": self.otherEditorCount,
+                "usernameLabel": self.usernameLabel.rawValue,
+                "cancelButtonPresent": self.cancelButtonPresent,
+                "defaultSubmit": self.defaultSubmit.rawValue,
+            ]
+        }
+    }
+
+    private struct Context {
+        let index: Int
+        let kind: Diagnostics.ContextKind
+        let members: [Int]
+    }
+
+    static func diagnostics(
+        _ nodes: [Node],
+        bundleID: String,
+        resolved: Bool,
+        axReadFailureCount: Int,
+        focusedSecureFieldMatches: Bool? = nil) -> NativeCredentialDiscoveryDiagnostics
+    {
+        let count = nodes.filter(\.isSecureField).count
+        let reason: NativeCredentialDiscoveryDiagnostics.Reason = if axReadFailureCount > 0 {
+            .axMetadataUnavailable
+        } else if count == 0 {
+            .secureFieldNotObserved
+        } else if count > 1 {
+            .secureFieldAmbiguous
+        } else if focusedSecureFieldMatches == false {
+            .formContextMissing
+        } else {
+            resolved ? .bindingUnmatched : .formContextMissing
+        }
+        var result = NativeCredentialDiscoveryDiagnostics(
+            reason: reason,
+            observedSecureFieldCount: count,
+            axReadFailureCount: axReadFailureCount,
+            focusedSecureFieldMatches: focusedSecureFieldMatches)
+        if count == 1, let field = nodes.indices.first(where: { nodes[$0].isSecureField }),
+           let context = self.context(nodes, field: field, bundleID: bundleID)
+        {
+            result.formContext = self.formDiagnostics(nodes, context: context, bundleID: bundleID)
+        }
+        return result
+    }
+
+    static func resolve(_ nodes: [Node], bundleID: String) -> Form? {
+        let fields = nodes.indices.filter { nodes[$0].isSecureField }
+        guard fields.count == 1, let field = fields.first else { return nil }
+        if bundleID == "com.apple.Passwords" {
+            return self.passwordsUnlockContext(nodes, field: field)
+        }
+        if bundleID == "com.apple.Safari" {
+            return self.safariAutoFillContext(nodes, field: field) ??
+                self.safariPasswordsUnlockContext(nodes, field: field)
+        }
+        guard let observed = self.context(nodes, field: field, bundleID: bundleID) else { return nil }
+        let context = observed.index
+        let formMembers = observed.members
+        let evidence = formMembers.flatMap { nodes[$0].text }.sorted()
+        let ordinaryFields = formMembers.filter { nodes[$0].role == kAXTextFieldRole }
+        let controls = formMembers.filter { nodes[$0].role == kAXButtonRole }
+        let controlText = Set(controls.flatMap { nodes[$0].text })
+        let purpose = NativeCredentialPromptPurpose.resolve(nativeEvidence: evidence)
+        if case .administratorAuthentication = purpose {
+            // AXTitleUIElement associates a field with its actual static label.
+            // A nearby label, request-body account, or unlabelled sole field
+            // does not identify the username selected for this authentication.
+            guard bundleID == "com.apple.SecurityAgent", ordinaryFields.count == 1,
+                  let username = ordinaryFields.first, let label = nodes[username].titleElement,
+                  formMembers.contains(label), nodes[label].role == kAXStaticTextRole,
+                  nodes[label].text.contains(where: { self.isUsernameLabel($0) }),
+                  !formMembers.contains(where: { nodes[$0].role == kAXTextAreaRole }),
+                  controls.contains(where: { nodes[$0].buttonTitle == "Cancel" }),
+                  let submit = nodes[context].defaultButton ?? nodes.first?.defaultButton,
+                  controls.contains(submit), let submitTitle = nodes[submit].buttonTitle,
+                  !submitTitle.isEmpty, !["Cancel", "Help", "?"].contains(submitTitle)
+            else { return nil }
+            return Form(
+                field: field,
+                context: context,
+                evidence: evidence,
+                username: .init(field: username, label: label),
+                submit: submit)
+        }
+        if case .unsupportedAdministratorAuthentication = purpose { return nil }
+        if bundleID == "com.apple.SecurityAgent", !ordinaryFields.isEmpty {
+            // An incomplete administrator form must not use a body account
+            // token through the generic authentication route.
+            return nil
+        }
+        if case .loginKeychainAuthentication = purpose {
+            // Keychain access uses one local-password field and native buttons,
+            // not a web/provider editor or text borrowed from another dialog.
+            guard controlText.isSuperset(of: ["Always Allow", "Deny", "Allow"]),
+                  !formMembers.contains(where: {
+                      $0 != field && [kAXTextFieldRole, kAXTextAreaRole].contains(nodes[$0].role)
+                  })
+            else { return nil }
+        }
+        return Form(field: field, context: context, evidence: evidence)
+    }
+
+    private static func context(_ nodes: [Node], field: Int, bundleID: String) -> Context? {
+        var context = nodes[field].parent
+        while let index = context, !nodes[index].isDialog {
+            context = nodes[index].parent
+        }
+        if context == nil {
+            // These dedicated authentication agents can present the form as a
+            // window. System Settings needs a dialog/sheet: its surrounding UI
+            // can show a different account beside an unrelated password form.
+            guard [
+                "com.apple.SecurityAgent",
+                "com.apple.LocalAuthentication.UIAgent",
+                "com.apple.ScreenContinuity",
+            ].contains(bundleID), nodes.first?.role == kAXWindowRole
+            else { return nil }
+            context = 0
+        }
+        guard let context else { return nil }
+        let formMembers = nodes.indices.filter { index in
+            guard !nodes[index].isSecureField else { return false }
+            var ancestor: Int? = index
+            while let current = ancestor {
+                if current == context { return true }
+                // Do not borrow identity from an independent nested dialog.
+                if nodes[current].isDialog { return false }
+                ancestor = nodes[current].parent
+            }
+            return false
+        }
+        return .init(index: context, kind: nodes[context].isDialog ? .dialog : .ownerWindow, members: formMembers)
+    }
+
+    private static func formDiagnostics(_ nodes: [Node], context: Context, bundleID: String) -> Diagnostics {
+        let members = context.members
+        let fields = members.filter { nodes[$0].role == kAXTextFieldRole }
+        let label: Diagnostics.UsernameLabel = if fields.isEmpty {
+            .noOrdinaryField
+        } else if fields.count > 1 {
+            .ambiguousOrdinaryFields
+        } else if let field = fields.first, let label = nodes[field].titleElement {
+            if !members.contains(label) {
+                .outsideForm
+            } else if nodes[label].role != kAXStaticTextRole {
+                .notStaticText
+            } else if nodes[label].text.contains(where: { self.isUsernameLabel($0) }) {
+                .associated
+            } else {
+                .unrecognized
+            }
+        } else {
+            .missing
+        }
+        let defaultButton = nodes[context.index].defaultButton ?? nodes.first?.defaultButton
+        let submit: Diagnostics.DefaultSubmit = if let index = defaultButton {
+            if !members.contains(index) {
+                .outsideForm
+            } else if nodes[index].role != kAXButtonRole {
+                .notButton
+            } else if let title = nodes[index].buttonTitle, !title.isEmpty {
+                ["Cancel", "Help", "?"].contains(title) ? .nonSubmitButton : .associated
+            } else {
+                .missingTitle
+            }
+        } else {
+            .missing
+        }
+        var evidence = members.flatMap { nodes[$0].text }
+        if bundleID == "com.apple.Safari", let identifier = nodes[context.index].identifier {
+            evidence.append(identifier)
+        }
+        return .init(
+            contextKind: context.kind,
+            purpose: NativeCredentialPromptPurpose.resolve(nativeEvidence: evidence),
+            ordinaryFieldCount: fields.count,
+            otherEditorCount: members.filter { nodes[$0].role == kAXTextAreaRole }.count,
+            usernameLabel: label,
+            cancelButtonPresent: members.contains(where: {
+                nodes[$0].role == kAXButtonRole && nodes[$0].buttonTitle == "Cancel"
+            }),
+            defaultSubmit: submit)
+    }
+
+    private static func isUsernameLabel(_ text: String) -> Bool {
+        let label = text.trimmingCharacters(in: .whitespacesAndNewlines).lowercased()
+        return ["name", "name:", "user name", "user name:", "username", "username:"].contains(label)
+    }
+
+    private static func safariAutoFillContext(_ nodes: [Node], field: Int) -> Form? {
+        // Safari hosts both provider editors and the OS AutoFill password
+        // sheet. Its native sheet label and same-form controls identify the
+        // local authentication purpose even when AX omits the body text.
+        var ancestor: Int? = field
+        while let index = ancestor {
+            guard nodes[index].role != "AXWebArea" else { return nil }
+            ancestor = nodes[index].parent
+        }
+        guard let observed = self.context(nodes, field: field, bundleID: "com.apple.Safari"),
+              nodes[observed.index].role == kAXSheetRole,
+              nodes[observed.index].text.contains("AutoFillAuthenticationSheet") ||
+              nodes[observed.index].identifier == "AutoFillAuthenticationSheet",
+              !observed.members.contains(where: {
+                  [kAXTextFieldRole, kAXTextAreaRole].contains(nodes[$0].role)
+              })
+        else { return nil }
+        let controls = observed.members.filter { nodes[$0].role == kAXButtonRole }
+        guard controls.count == 2,
+              let submit = controls.first(where: { nodes[$0].buttonTitle == "Sign In" }),
+              controls.contains(where: { nodes[$0].buttonTitle == "Cancel" })
+        else { return nil }
+        var evidence = observed.members.flatMap { nodes[$0].text }
+        if let identifier = nodes[observed.index].identifier { evidence.append(identifier) }
+        evidence.sort()
+        guard NativeCredentialPromptPurpose.resolve(nativeEvidence: evidence) == .autoFillAuthentication else {
+            return nil
+        }
+        return Form(field: field, context: observed.index, evidence: evidence, submit: submit)
+    }
+
+    private static func passwordsUnlockContext(_ nodes: [Node], field: Int) -> Form? {
+        // Passwords also contains editable vault secrets. Only its observed
+        // locked-view form can request the local Mac login credential.
+        guard nodes.first?.role == kAXWindowRole, nodes.first?.subrole == kAXStandardWindowSubrole,
+              let context = nodes[field].parent,
+              nodes[context].role == kAXGroupRole, nodes[context].subrole == "AXHostingView",
+              !nodes.indices.contains(where: {
+                  $0 != field && [kAXTextFieldRole, kAXTextAreaRole].contains(nodes[$0].role)
+              })
+        else { return nil }
+        var ancestor = nodes[context].parent
+        while let index = ancestor, index != 0 {
+            guard !nodes[index].isDialog else { return nil }
+            ancestor = nodes[index].parent
+        }
+        guard ancestor == 0 else { return nil }
+        guard let account = self.passwordsUnlockAccount(nodes, context: context) else { return nil }
+        return Form(field: field, context: context, evidence: [account])
+    }
+
+    private static func safariPasswordsUnlockContext(_ nodes: [Node], field: Int) -> Form? {
+        var ancestor: Int? = field
+        while let index = ancestor {
+            guard nodes[index].role != "AXWebArea" else { return nil }
+            ancestor = nodes[index].parent
+        }
+        // Safari's Other Passwords view nests a locked Passwords form in a
+        // native sheet. The lock/account labels belong to the field's hosting
+        // group; Unlock and Cancel belong to its enclosing hosting group.
+        guard let observed = self.context(nodes, field: field, bundleID: "com.apple.Safari"),
+              nodes[observed.index].role == kAXSheetRole,
+              let lockedGroup = nodes[field].parent,
+              nodes[lockedGroup].role == kAXGroupRole, nodes[lockedGroup].subrole == "AXHostingView",
+              let controlsGroup = nodes[lockedGroup].parent,
+              nodes[controlsGroup].role == kAXGroupRole, nodes[controlsGroup].subrole == "AXHostingView",
+              nodes[controlsGroup].parent == observed.index,
+              self.passwordsUnlockAccount(nodes, context: lockedGroup) != nil,
+              !observed.members.contains(where: {
+                  [kAXTextFieldRole, kAXTextAreaRole].contains(nodes[$0].role)
+              })
+        else { return nil }
+        let controls = observed.members.filter { nodes[$0].role == kAXButtonRole }
+        guard controls.count == 2,
+              controls.allSatisfy({ nodes[$0].parent == controlsGroup }),
+              let submit = controls.first(where: { nodes[$0].buttonTitle == "Unlock" }),
+              controls.contains(where: { nodes[$0].buttonTitle == "Cancel" })
+        else { return nil }
+        let evidence = observed.members.flatMap { nodes[$0].text }.sorted()
+        guard NativeCredentialPromptPurpose.resolve(nativeEvidence: evidence) == .passwordsUnlockAuthentication else {
+            return nil
+        }
+        return Form(field: field, context: observed.index, evidence: evidence, submit: submit)
+    }
+
+    private static func passwordsUnlockAccount(_ nodes: [Node], context: Int) -> String? {
+        let siblings = nodes.filter { $0.parent == context }
+        let labels = siblings.filter { $0.role == kAXStaticTextRole }.flatMap(\.text)
+        guard siblings.contains(where: { $0.role == kAXImageRole && $0.identifier == "lock.fill" }),
+              labels.contains("Passwords Is Locked")
+        else { return nil }
+        return NativeCredentialPromptPurpose.passwordsUnlockAccount(nativeEvidence: labels)
+    }
+}
diff --git a/apps/macos/Sources/OpenClaw/NativeCredentialPromptWindow.swift b/apps/macos/Sources/OpenClaw/NativeCredentialPromptWindow.swift
new file mode 100644
index 0000000000000000000000000000000000000000..20be320e42bd9580388c139d342eef228e0783bf
--- /dev/null
+++ b/apps/macos/Sources/OpenClaw/NativeCredentialPromptWindow.swift
@@ -0,0 +1,50 @@
+import ApplicationServices
+import Darwin
+import Foundation
+
+/// Pure bounded relationship lookup. Native reads supply only roles, owners and
+/// AX relationships; neither form text nor credential values enter this owner.
+@MainActor
+enum NativeCredentialPromptWindow {
+    struct Ancestor<Element> {
+        let role: String
+        let subrole: String?
+        let ownerPID: pid_t
+        let parent: Element?
+    }
+
+    static func resolve<Element>(
+        direct: (window: Element?, result: AXError),
+        bundleID: String,
+        focusedField: Element?,
+        ownerPID: pid_t,
+        readAncestor: (Element, TimeInterval) -> Ancestor<Element>?,
+        sameElement: (Element, Element) -> Bool,
+        now: () -> TimeInterval) -> Element?
+    {
+        // Preserve the original direct relationship, including all other owners.
+        if let directWindow = direct.window { return directWindow }
+        guard [.noValue, .attributeUnsupported].contains(direct.result), bundleID == "com.apple.Safari",
+              let focusedField, ownerPID > 0
+        else { return nil }
+        let deadline = now() + 1
+        var current = focusedField
+        var visited: [Element] = []
+        for index in 0..<16 {
+            let remaining = deadline - now()
+            guard remaining > 0, !visited.contains(where: { sameElement($0, current) }),
+                  let ancestor = readAncestor(current, remaining),
+                  ancestor.ownerPID == ownerPID, ancestor.role != "AXWebArea", now() < deadline
+            else { return nil }
+            visited.append(current)
+            if index == 0 {
+                guard ancestor.role == kAXTextFieldRole, ancestor.subrole == kAXSecureTextFieldSubrole
+                else { return nil }
+            }
+            if ancestor.role == kAXWindowRole { return current }
+            guard let parent = ancestor.parent else { return nil }
+            current = parent
+        }
+        return nil
+    }
+}
diff --git a/apps/macos/Sources/OpenClaw/NativeCredentialResolver.swift b/apps/macos/Sources/OpenClaw/NativeCredentialResolver.swift
new file mode 100644
index 0000000000000000000000000000000000000000..09cc375555f50cc5f14b5655190795cb7b28bc55
--- /dev/null
+++ b/apps/macos/Sources/OpenClaw/NativeCredentialResolver.swift
@@ -0,0 +1,111 @@
+import Foundation
+import OpenClawKit
+import OSLog
+import Subprocess
+
+/// The only secret-bearing transport is a bounded pipe inside this native host.
+@MainActor
+enum NativeCredentialResolver {
+    enum Diagnostic: String, Sendable {
+        case bundleValidationStarted = "bundle_validation_started"
+        case bundleValidationTimedOut = "bundle_validation_timed_out"
+        case bundleValidationFailed = "bundle_validation_failed"
+        case helperStarted = "helper_started"
+        case helperTimedOut = "helper_timed_out"
+        case helperFailed = "helper_failed"
+        case childFailed = "child_failed"
+        case invalidOutput = "invalid_output"
+        case cancelled
+        case resolved
+    }
+
+    struct ResolutionFailure: Error {
+        let diagnostic: Diagnostic
+    }
+
+    private nonisolated static let logger = Logger(subsystem: "ai.openclaw.mac", category: "native-credential")
+
+    private nonisolated static func record(_ diagnostic: Diagnostic) {
+        // Fixed vocabulary only: never include errors, identifiers or pipe data.
+        self.logger.info("native credential resolver: \(diagnostic.rawValue, privacy: .public)")
+    }
+
+    static func withSecret(
+        _ binding: NativeCredentialBinding,
+        _ consume: @MainActor (String) throws -> Void) async throws
+    {
+        try await self.withSecret(binding, run: self.run, consume: consume)
+    }
+
+    static func withSecret(
+        _ binding: NativeCredentialBinding,
+        run: @Sendable (Data) async throws -> BoundedProcessResult,
+        record: (Diagnostic) -> Void = Self.record,
+        consume: @MainActor (String) throws -> Void) async throws
+    {
+        try binding.validate()
+        let request = try JSONEncoder().encode(binding)
+        var result: BoundedProcessResult
+        do {
+            result = try await run(request)
+        } catch is CancellationError {
+            record(.cancelled)
+            throw CancellationError()
+        } catch let failure as ResolutionFailure {
+            record(failure.diagnostic)
+            throw NativeCredentialError.unavailable
+        } catch BoundedProcessError.timedOut {
+            record(.helperTimedOut)
+            throw NativeCredentialError.unavailable
+        } catch {
+            record(.helperFailed)
+            throw NativeCredentialError.unavailable
+        }
+        defer { result.output.resetBytes(in: result.output.startIndex..<result.output.endIndex) }
+        try Task.checkCancellation()
+        guard result.terminationStatus == 0 else {
+            record(.childFailed)
+            throw NativeCredentialError.unavailable
+        }
+        guard !result.output.isEmpty, result.output.count <= 8192,
+              let secret = String(data: result.output, encoding: .utf8),
+              !secret.unicodeScalars.contains(where: CharacterSet.controlCharacters.contains)
+        else {
+            record(.invalidOutput)
+            throw NativeCredentialError.unavailable
+        }
+        record(.resolved)
+        try consume(secret)
+    }
+
+    private nonisolated static func run(request: Data) async throws -> BoundedProcessResult {
+        let bundle = Bundle.main.bundleURL
+        guard bundle.pathExtension == "app" else { throw NativeCredentialError.unavailable }
+        let executable = bundle.appendingPathComponent("Contents/MacOS/openclaw-mac")
+        self.record(.bundleValidationStarted)
+        do {
+            try await GatewayLocalAuthResolver.validateBundleBeforeLaunch()
+        } catch is CancellationError {
+            throw CancellationError()
+        } catch BoundedProcessError.timedOut {
+            throw ResolutionFailure(diagnostic: .bundleValidationTimedOut)
+        } catch {
+            throw ResolutionFailure(diagnostic: .bundleValidationFailed)
+        }
+        try Task.checkCancellation()
+        var environment = ProcessInfo.processInfo.environment
+        for key in environment.keys where key == "LD_PRELOAD" || key.hasPrefix("DYLD_") {
+            environment.removeValue(forKey: key)
+        }
+        self.record(.helperStarted)
+        // Fallback revalidates the sealed app five times. Installed validation
+        // takes ~13s per proof; keep every proof and bound the whole child at 90s.
+        return try await BoundedProcess.run(
+            path: executable.path,
+            arguments: ["_resolve-native-credential"],
+            environment: environment,
+            standardInput: .array(Array(request)),
+            standardError: .discarded,
+            timeout: 90)
+    }
+}

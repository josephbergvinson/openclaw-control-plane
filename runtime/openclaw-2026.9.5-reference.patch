+    return <T>(run: () => Promise<T>) =>
+      withPluginRuntimeGatewayRequestScope(
+        { context, client: createSyntheticPluginRuntimeClient(), isWebchatConnect: () => false },
+        run,
+      );
+  };
+  const completeTurn = ({
+    preflight,
+    io,
+  }: Parameters<ReturnType<typeof createAgentTurnService>["startTurn"]>[0]) => {
+    const request = preflight.request;
+    io.emitAcceptance([true, { runId: request.idempotencyKey, status: "accepted" }, undefined]);
+    io.emitExecutionStarted?.();
+    io.emitFinal([
+      true,
+      {
+        status: "ok",
+        inputProcessingCompleted: true,
+        result: { payloads: [{ text: "Requester reviewed the completed work." }] },
+      },
+      undefined,

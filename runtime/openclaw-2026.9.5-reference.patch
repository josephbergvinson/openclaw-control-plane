+    connected: true,
+    origin: ORIGIN,
+    role: "",
+    tagName: "button",
+    type: "submit",
+    ...options.submitMetadata,
+  };
+  const ownerFrame = {} as Frame;
+  let passwordFrame = ownerFrame;
+  let submitFrame = ownerFrame;
+
+  const passwordFill = vi.fn(async (value: string) => {
+    if (value === "") {
+      if (options.clearError) {
+        throw options.clearError;
+      }
+      passwordValue = "";
+      return;
+    }
+    passwordValue = value;
+    if (options.fillError) {
+      throw options.fillError;
+    }
+  });
+  const passwordPress = vi.fn(async () => {
+    if (options.pressError) {
+      throw options.pressError;
+    }
+  });
+  const passwordDispose = vi.fn(async () => {});
+  const passwordElement = {
+    evaluate: vi.fn(async () => passwordMetadata),
+    fill: passwordFill,
+    press: passwordPress,
+    ownerFrame: vi.fn(async () => passwordFrame),
+    dispose: passwordDispose,
+  } as unknown as ElementHandle<HTMLInputElement>;
+
+  const submitObservedValues: string[] = [];
+  const submitClick = vi.fn(async () => {
+    submitObservedValues.push(passwordValue);
+    if (options.clickError) {
+      throw options.clickError;
+    }
+  });
+  const submitDispose = vi.fn(async () => {});
+  const submitElement = {
+    evaluate: vi.fn(async () => submitMetadata),
+    click: submitClick,
+    ownerFrame: vi.fn(async () => submitFrame),
+    dispose: submitDispose,
+  } as unknown as ElementHandle<HTMLElement | SVGElement>;
+
+  const close = vi.fn(async () => {
+    closed = true;
+  });
+  const page = {
+    context: () => ({}),
+    url: () => pageUrl,
+    isClosed: () => closed,
+    close,
+  } as unknown as Page;
+  const getPage = vi.fn(async () => page);
+  const resolveElement = vi.fn(async (_page: Page, ref: string) => {
+    if (ref === "e17") {
+      return passwordElement;
+    }
+    if (ref === "e22") {
+      return submitElement;
+    }
+    return null;
+  });
+  const resolutionError = options.resolutionError;
+  const resolveSecret = resolutionError
+    ? vi.fn(async () => {
+        throw resolutionError;
+      })
+    : vi.fn(async () => SENTINEL);

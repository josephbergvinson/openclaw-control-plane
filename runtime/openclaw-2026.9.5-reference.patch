+/** Keep captured and current holds independent, including overlapping allow globs. */
+function composeRequesterConversationPolicy(
+  captured: RequesterToolCallerContext["conversationToolPolicy"],
+  current: GroupToolPolicyConfig | undefined,
+): GroupToolPolicyConfig | undefined {
+  const copy = (policy: NonNullable<typeof captured>): GroupToolPolicyConfig => {
+    const restrictions = policy.allow && readToolAllowlistIntersection(policy.allow);
+    return {
+      allow: policy.allow
+        ? restrictions
+          ? attachToolAllowlistIntersection(
+              [...policy.allow],
+              restrictions.map((list) => Array.from(list)),
+            )
+          : [...policy.allow]
+        : undefined,
+      alsoAllow: policy.alsoAllow ? [...policy.alsoAllow] : undefined,
+      deny: policy.deny ? [...policy.deny] : undefined,
+    };
+  };
+  const normalize = (policy: NonNullable<typeof captured>): GroupToolPolicyConfig => {
+    const copied = copy(policy);
+    const restrictions = copied.allow && readToolAllowlistIntersection(copied.allow);
+    const extra = copied.alsoAllow;
+    if (!restrictions || !extra?.length) {
+      return copied;
+    }
+    // ((A intersect B) union E) equals (A union E) intersect (B union E).
+    // An attached empty restriction extends only to E, unlike ordinary allow: [].
+    const extend = (allow: readonly string[]) => [...new Set([...allow, ...extra])];
+    return {
+      ...copied,
+      allow: attachToolAllowlistIntersection(extend(copied.allow ?? []), restrictions.map(extend)),
+      alsoAllow: undefined,
+    };
+  };
+  if (!captured || !current) {
+    const policy = captured ?? current;
+    return policy ? normalize(policy) : undefined;
+  }
+  const policies = [
+    pickSandboxToolPolicy(normalize(captured)),
+    pickSandboxToolPolicy(normalize(current)),
+  ];
+  const restrictions = policies
+    .flatMap((policy) =>
+      policy?.allow
+        ? (readToolAllowlistIntersection(policy.allow)?.map((list) => Array.from(list)) ??
+          (policy.allow.length > 0 ? [[...policy.allow]] : []))
+        : [],
+    )
+    .filter((list) => !list.some((name) => name.trim() === "*"));
+  return {
+    allow:
+      restrictions.length > 0
+        ? attachToolAllowlistIntersection([...new Set(restrictions.flat())], restrictions)
+        : [captured, current].some((policy) => policy.allow?.some((name) => name.trim() === "*"))

+          };
+          const coldCallCount = nativeCalls.length;
+          expect(nativeCalls.length).toBeGreaterThan(0);
+          expect(nativeCalls.every((call) => !call.databaseOnly)).toBe(true);
+          const entries = (await openState().entries()).map((entry) => entry.value);
+          expect(entries.filter((entry) => entry.kind === "row")).toHaveLength(
+            Math.min(count, acceptanceResidentLimit),
+          );
+          expect(entries.some((entry) => entry.kind === "complete")).toBe(true);
+          if (traceHandshake) {
+            await fs.writeFile(pathForAcceptance.join(traceHandshake, "trace-finished"), "\n", {
+              mode: 0o600,
+            });
+            const until = performance.now() + 20_000;
+            while (true) {
+              try {
+                await fs.access(pathForAcceptance.join(traceHandshake, "trace-stopped"));
+                break;
+              } catch {
+                /* Join the exact root-owned tracer before later native reads. */
+              }
+              if (performance.now() >= until) {
+                throw new Error("Root tracer stop handshake timed out");
+              }
+              await new Promise((resolve) => {
+                setTimeout(resolve, 50);
+              });
+            }
+          }
+          // Native DB-only truth after cold discovery; no filesystem-first baseline
+          // contaminates the above first-list or early-record measurements.
+          const nativeIds: string[] = [];
+          let nativeCursor: string | undefined;
+          const nativeCursors = new Set<string>();
+          do {
+            const page = await client.request<AcceptanceNativePage>(
+              "thread/list",
+              {
+                limit: 64,
+                archived: false,
+                modelProviders: [],
+                useStateDbOnly: true,
+                sortKey: "recency_at",
+                sortDirection: "desc",
+                ...(nativeCursor ? { cursor: nativeCursor } : {}),
+              },
+              { timeoutMs: 60_000, catalogPreview: true },
+            );
+            nativeIds.push(...page.data.map((row) => row.id));
+            nativeCursor = page.nextCursor ?? undefined;
+            if (nativeCursor) {
+              expect(nativeCursors.has(nativeCursor)).toBe(false);
+              nativeCursors.add(nativeCursor);
+            }
+          } while (nativeCursor);
+          expect(nativeIds).toHaveLength(count);
+          expect(new Set(nativeIds).size).toBe(count);
+          const ids = firstPage.sessions.map((row) => row.threadId);
+          let cursor = firstPage.nextCursor;
+          let pages = 1;
+          const cursors = new Set<string>();
+          let secondPage: CodexSessionCatalogPage | undefined;
+          while (cursor) {
+            expect(cursors.has(cursor)).toBe(false);
+            cursors.add(cursor);
+            const page = await control.listPage({ limit: 64, cursor });
+            secondPage ??= page;
+            ids.push(...page.sessions.map((row) => row.threadId));
+            cursor = page.nextCursor;
+            pages++;
+          }
+          expect(ids).toEqual(nativeIds);
+          expect(new Set(ids).size).toBe(count);
+          if (secondPage?.backwardsCursor) {
+            const back = await control.listPage({ limit: 64, cursor: secondPage.backwardsCursor });
+            expect(back.sessions.map((row) => row.threadId)).toEqual(
+              firstPage.sessions.map((row) => row.threadId),
+            );
+          } else {
+            throw new Error("No backwards cursor for an inventory larger than one page");
+          }
+          if (caseName === "overflow") {
+            expect(nativeCalls.slice(coldCallCount).some((call) => call.databaseOnly)).toBe(true);
+          }
+          if (caseName === "recency") {
+            await observeAcceptanceClient(client, {
+              startOptions: source.appServer.start,
+              agentDir: source.agentDir,
+            });
+            const head = firstPage.sessions[0]!;
+            const tail = secondPage!.sessions[0]!;
+            const beforeTitleCalls = nativeCalls.length;
+            for (const row of [head, tail]) {
+              const name = `Real native title ${row.threadId}`;
+              await client.request("thread/name/set", { threadId: row.threadId, name });
+              await acceptanceVi.waitFor(
+                async () => {
+                  const page = await control.listPage({
+                    limit: 64,
+                    ...(row === tail ? { cursor: firstPage.nextCursor } : {}),
+                  });
+                  expect(page.sessions.find((item) => item.threadId === row.threadId)?.name).toBe(
+                    name,
+                  );
+                },
+                { timeout: 10_000 },
+              );
+            }
+            expect(nativeCalls.length).toBe(beforeTitleCalls);
+          }
+          await factory.stop();
+          await closeOpenClawStateDatabaseAsync();
+          restarted = makeFactory();
+          const restartSource = (await restarted.homesForAgent("main"))[0]!;
+          const restartControl = restarted.forRequest("main", restartSource);
+          const beforeRestartCalls = nativeCalls.length;
+          const restartStarted = performance.now();
+          const restored = await restartControl.listPage({ limit: 64 });
+          expect(restored.sessions.map((row) => row.threadId)).toEqual(
+            firstPage.sessions.map((row) => row.threadId),
+          );
+          expect(nativeCalls.length).toBe(beforeRestartCalls);
+          receipt = {
+            ...receipt,
+            status: "passed",
+            firstCallMs,
+            firstCallOutcome: firstError ? "bounded retry" : "data",
+            firstCallRows: first?.sessions.length ?? 0,
+            firstActualDataObservedMs,
+            firstActualDataSinceSpawnMs,
+            firstCallSinceSpawnMs,
+            hydrationSinceSpawnMs,
+            firstDataObservedAt: first?.sessions.length
+              ? "first list"
+              : "first list observed after full hydration",
+            hydrationMs,
+            coldCallCount,
+            coldPhysicalIo,
+            coldCallsFilesystemFirst: true,
+            pages,
+            returnedUniqueRows: new Set(ids).size,
+            nativeOrderMatchesWrapper: true,
+            firstIdsHash: createAcceptanceHash("sha256").update(JSON.stringify(ids)).digest("hex"),
+            restartFirstListMs: performance.now() - restartStarted,
+            restartNativeCalls: 0,
+            observations,
+            titleNotificationsVerified: caseName === "recency",
+            nativeOverflowVerified: caseName === "overflow",
+            performanceBudgetAsserted: budget !== undefined,
+            completePipelineBudgetAsserted: totalBudget !== undefined,
+          };
+        } catch (error) {
+          receipt = {
+            ...receipt,
+            status: "failed",
+            observations,
+            error: error instanceof Error ? error.message : String(error),
+          };
+          throw error;
+        } finally {
+          // Parent-owned isolated test processes are physically joined before the
+          // temporary HOME may be removed by the existing temp-dir tracker.
+          await factory.stop();
+          await restarted?.stop();
+          const nativeCloseResult = await client.closeAndWait();
+          await closeOpenClawStateDatabaseAsync();
+          receipt.nativeChildJoined = nativeCloseResult.exited;
+          receipt.nativeCloseResult = nativeCloseResult;
+          if (!nativeCloseResult.exited) {
+            receipt.status = "failed";
+            receipt.error = "Physical native child exit unverified; disposable root retained";
+          }
+          if (traceHandshake) {
+            // Root must join only its exact tracer on this signal or child exit.
+            await fs.writeFile(pathForAcceptance.join(traceHandshake, "trace-finished"), "\n", {
+              mode: 0o600,
+            });
+          }
+          await fs.writeFile(
+            pathForAcceptance.join(evidenceRoot, `native-${caseName}-${earlyBytes}.private.json`),
+            JSON.stringify(receipt, null, 2) + "\n",
+            { mode: 0o600 },
+          );
+          expect(nativeCloseResult.exited).toBe(true);
+        }
+      } finally {
+        const closed = await client.closeAndWait();
+        if (traceHandshake) {
+          await fs.writeFile(pathForAcceptance.join(traceHandshake, "trace-finished"), "\n", {
+            mode: 0o600,
+          });
+        }
+        expect(closed.exited).toBe(true);
+      }
+    },
+    600_000,
+  );
+}

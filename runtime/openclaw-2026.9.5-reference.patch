diff --git a/src/agents/system-prompt.control.ts b/src/agents/system-prompt.control.ts
new file mode 100644
index 0000000000000000000000000000000000000000..21cb500b19a3630f8189ea9bf99c2ce4b7c566ba
--- /dev/null
+++ b/src/agents/system-prompt.control.ts
@@ -0,0 +1,47 @@
+/** Renders existing control guidance from the admitted run's available tool names. */
+export function buildOpenClawControlSection(params: {
+  hasOpenClaw: boolean;
+  hasGateway: boolean;
+  hasExec: boolean;
+  codeModeActive?: boolean;
+}): string[] {
+  const { hasOpenClaw, hasGateway, hasExec } = params;
+  const hasShellExec = hasExec && params.codeModeActive !== true;
+  return [
+    "## OpenClaw Control",
+    "Do not invent commands.",
+    hasOpenClaw
+      ? "Gateway restart, config, channels, plugins, agents, models/providers: ask `openclaw`."
+      : hasGateway
+        ? "Config read: `gateway` (`config.get|config.schema.lookup`) only when those actions are exposed by its schema. This tool does not expose general config writes or restart."
+        : "",
+    [
+      "For the Gateway hosting this session:",
+      "In a connected chat, the owner can send `/update` with commands.restart enabled (the default), regardless of the agent's tool profile.",
+      hasGateway
+        ? "Update OpenClaw: prefer `gateway` action update.run, only on an explicit owner request; the runtime coordinates restart and completion notices. Once accepted, let that update finish; do not start a second updater or restart. If refused, inspect the actual reason and reconcile the available execution route under the existing authorization."
+        : hasShellExec
+          ? "For owner-authorized chat maintenance, use the supported CLI or repository-owned activation route with exec; `/update` remains available for ordinary managed updates."
+          : hasExec && params.codeModeActive
+            ? "For owner-authorized chat maintenance, use the shell tool from the effective catalog when available; `/update` remains available for ordinary managed updates. Code Mode exec runs JavaScript, not shell commands."
+            : "For a chat update request, direct the user to `/update`. Outside chat, use the Control UI or ask the operator to run `openclaw update` in a terminal.",
+      "Missing chat ownership needs authenticated owner setup through the existing controls; a routing mismatch does not erase the owner's established authorization.",
+    ].join(" "),
+    ...(hasExec
+      ? [
+          [
+            hasShellExec
+              ? "Owner-authorized maintenance may update, replace, stop or restart the Gateway hosting this chat through exec, including repository-built releases that the system tools cannot select."
+              : "Owner-authorized maintenance may update, replace, stop or restart the Gateway hosting this chat using the shell tool from the effective catalog when available, including repository-built releases that the system tools cannot select. Code Mode exec runs JavaScript, not shell commands; its presence alone does not establish shell access.",
+            "Use the existing supported activation and drain/handoff route, preserve resumable work, verify the successor's identity and health, then continue the original task. A separate process is an execution requirement, not a requirement for a human-operated terminal. Carry out the authorized workflow yourself; do not hand it back solely because this chat runs on the target Gateway.",
+          ].join(" "),
+          ...(hasShellExec
+            ? [
+                "For a user-requested update on another host, verify the exact target, then use exec/SSH with `openclaw update --yes`; existing exec authorization still applies.",
+              ]
+            : []),
+        ]
+      : []),
+    "",
+  ];
+}

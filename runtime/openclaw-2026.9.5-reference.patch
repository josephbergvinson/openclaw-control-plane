+import type { OpenClawPluginApi } from "openclaw/plugin-sdk/plugin-entry";
+import { normalizeOptionalString } from "openclaw/plugin-sdk/string-coerce-runtime";
+
+const DETACHED_LANE_MAX_CHECKPOINT_CHARS = 1_600;
+const DETACHED_LANE_CHECKPOINT_GAP_MS = 3 * 60_000;
+const DETACHED_LANE_CHECKPOINT_REQUEST =
+  "A progress checkpoint is due for your ongoing task. At the next safe boundary, write a concise commentary update with the concrete progress or real blocker and your next move, then continue the same task. The existing relay delivers it to the requester. Keep internal IDs, paths, tool details, and this reminder private. Do not send a separate message or start another task.";
+
+export type DetachedLaneCheckpoint = {
+  key: string;
+  text: string;
+};
+
+type BoundTaskRuns = ReturnType<OpenClawPluginApi["runtime"]["tasks"]["runs"]["bindSession"]>;
+type TaskRun = ReturnType<BoundTaskRuns["list"]>[number];
+
+type CheckpointRequestLane = {
+  runId: string;
+  taskId: string;
+  ownerSessionKey: string;
+  pendingCheckpoint?: DetachedLaneCheckpoint;
+  lastCheckpoint: { at: number; key: string };
+  checkpointRequest?: AbortController;
+  checkpointRequestNotBefore?: number;
+};
+
+export function createDetachedLaneCheckpointRequests<Lane extends CheckpointRequestLane>(params: {
+  progressNow: () => number;
+  isDisposed: () => boolean;
+  isCurrentLane: (lane: Lane) => boolean;
+  resolveCurrentLaneTask: (lane: Lane) => Pick<TaskRun, "status"> | undefined;
+  taskRuntime: (sessionKey: string) => Pick<BoundTaskRuns, "queueMessage">;
+  warn: (message: string) => void;
+}) {
+  const { progressNow, isDisposed, isCurrentLane, resolveCurrentLaneTask, taskRuntime, warn } =
+    params;
+  return {
+    requestOverdue(lane: Lane): void {
+      if (
+        lane.checkpointRequest ||
+        lane.pendingCheckpoint ||
+        progressNow() < (lane.checkpointRequestNotBefore ?? 0) ||
+        progressNow() - lane.lastCheckpoint.at < DETACHED_LANE_CHECKPOINT_GAP_MS
+      ) {
+        return;
+      }
+      // Keep one request outstanding until a receipt, lane closure, or a
+      // failed delivery attempt releases it with a separate retry cooldown.
+      const request = new AbortController();
+      lane.checkpointRequest = request;
+      const canInject = () =>
+        !isDisposed() &&
+        !request.signal.aborted &&
+        isCurrentLane(lane) &&
+        !lane.pendingCheckpoint &&
+        lane.checkpointRequest === request &&
+        resolveCurrentLaneTask(lane)?.status === "running";
+      void taskRuntime(lane.ownerSessionKey)
+        .queueMessage({
+          taskId: lane.taskId,
+          runId: lane.runId,
+          message: DETACHED_LANE_CHECKPOINT_REQUEST,
+          queueIdentity: `lane-contract:progress:${lane.runId}:${lane.lastCheckpoint.key}`,
+          signal: request.signal,
+          canInject,
+        })
+        .then((outcome) => {
+          if (!request.signal.aborted && !outcome.queued) {
+            warn(`lane-contract checkpoint request rejected: ${outcome.reason}`);
+          }
+        })
+        .catch(() => {
+          if (!request.signal.aborted) {
+            warn("lane-contract checkpoint request failed");
+          }
+        });
+    },
+    recordReceipt(lane: Lane, checkpoint: DetachedLaneCheckpoint): void {
+      if (lane.pendingCheckpoint === checkpoint) {
+        lane.pendingCheckpoint = undefined;
+      }
+      lane.lastCheckpoint = { at: progressNow(), key: checkpoint.key };
+      lane.checkpointRequest?.abort();
+      lane.checkpointRequest = undefined;
+      lane.checkpointRequestNotBefore = undefined;
+    },
+    recordUnconfirmedAttempt(lane: Lane, checkpoint: DetachedLaneCheckpoint): void {
+      // An ambiguous send may already be visible. Do not replay it or turn
+      // its missing receipt into permanent silence for the rest of the task.
+      if (lane.pendingCheckpoint === checkpoint) {
+        lane.pendingCheckpoint = undefined;
+      }
+      lane.checkpointRequest?.abort();
+      lane.checkpointRequest = undefined;
+      lane.checkpointRequestNotBefore = progressNow() + DETACHED_LANE_CHECKPOINT_GAP_MS;
+    },
+  };
+}
+
+type DetachedLaneProgressEvent = {
+  seq: number;
+  stream: string;
+  data: Record<string, unknown>;
+};
+
+type ActiveCommentary =
+  | { kind: "item"; itemId: string }
+  | { kind: "unkeyed_snapshot"; text: string };
+
+function boundedNaturalCheckpointText(value: unknown): string | undefined {
+  const text = normalizeOptionalString(value)?.replace(/\s+/gu, " ");
+  if (!text || /^(?:checking|working|thinking|looking|on it)[.!…]*$/iu.test(text)) {
+    return undefined;
+  }
+  return text.length <= DETACHED_LANE_MAX_CHECKPOINT_CHARS
+    ? text
+    : `${text.slice(0, DETACHED_LANE_MAX_CHECKPOINT_CHARS - 1)}…`;
+}
+
+export class DetachedLaneCheckpointProjector {
+  private lastEventSeq = 0;
+  private readonly commentaryTextByItem = new Map<string, string>();
+  private readonly completedCommentaryItems = new Set<string>();
+  private readonly completedToolBoundaries = new Set<string>();
+  private activeCommentary?: ActiveCommentary;
+
+  private completeItem(itemId: string): DetachedLaneCheckpoint | undefined {
+    if (this.completedCommentaryItems.has(itemId)) {
+      return undefined;
+    }
+    this.completedCommentaryItems.add(itemId);
+    if (this.activeCommentary?.kind === "item" && this.activeCommentary.itemId === itemId) {
+      this.activeCommentary = undefined;
+    }
+    const text = boundedNaturalCheckpointText(this.commentaryTextByItem.get(itemId));
+    this.commentaryTextByItem.delete(itemId);
+    return text ? { key: `commentary:${itemId}:completed`, text } : undefined;
+  }
+
+  private completeActiveCommentary(
+    toolCallId: string | undefined,
+  ): DetachedLaneCheckpoint | undefined {
+    const active = this.activeCommentary;
+    if (!active) {
+      return undefined;
+    }
+    if (active.kind === "item") {
+      return this.completeItem(active.itemId);
+    }
+    if (!toolCallId || this.completedToolBoundaries.has(toolCallId)) {
+      return undefined;
+    }
+    this.completedToolBoundaries.add(toolCallId);
+    this.activeCommentary = undefined;
+    const text = boundedNaturalCheckpointText(active.text);
+    return text ? { key: `commentary:tool:${toolCallId}:completed`, text } : undefined;
+  }
+
+  projectCheckpoint(event: DetachedLaneProgressEvent): DetachedLaneCheckpoint | undefined {
+    // Agent sequence numbers are run-global; replayed deltas must not be
+    // appended twice to the item-keyed commentary accumulator.
+    if (event.seq <= this.lastEventSeq) {
+      return undefined;
+    }
+    this.lastEventSeq = event.seq;
+
+    if (event.stream === "tool") {
+      if (normalizeOptionalString(event.data.phase) !== "start") {
+        return undefined;
+      }
+      return this.completeActiveCommentary(normalizeOptionalString(event.data.toolCallId));
+    }
+
+    let itemId: string | undefined;
+    let accumulatedText: string | undefined;
+    const completed = event.data.completed === true;
+    if (event.stream === "item") {
+      if (
+        normalizeOptionalString(event.data.kind) !== "preamble" ||
+        normalizeOptionalString(event.data.phase) !== "update"
+      ) {
+        return undefined;
+      }
+      itemId = normalizeOptionalString(event.data.itemId) ?? `item:${event.seq}`;
+      accumulatedText = normalizeOptionalString(event.data.progressText);
+    } else if (event.stream === "assistant") {
+      if (normalizeOptionalString(event.data.phase) !== "commentary") {
+        return undefined;
+      }
+      itemId = normalizeOptionalString(event.data.itemId);
+      if (!itemId) {
+        if (event.data.replace === true && typeof event.data.text === "string") {
+          this.activeCommentary = { kind: "unkeyed_snapshot", text: event.data.text };
+        }
+        return undefined;
+      }
+      if (event.data.replace === true || (completed && typeof event.data.text === "string")) {
+        accumulatedText = typeof event.data.text === "string" ? event.data.text : undefined;
+      } else if (typeof event.data.delta === "string" && event.data.delta.length > 0) {
+        accumulatedText = `${this.commentaryTextByItem.get(itemId) ?? ""}${event.data.delta}`;
+      }
+    }
+    if (!itemId || accumulatedText === undefined) {
+      return undefined;
+    }
+    if (this.completedCommentaryItems.has(itemId)) {
+      return undefined;
+    }
+    this.commentaryTextByItem.set(itemId, accumulatedText);
+    this.activeCommentary = { kind: "item", itemId };
+    if (!completed) {
+      return undefined;
+    }
+    return this.completeItem(itemId);
+  }
+}

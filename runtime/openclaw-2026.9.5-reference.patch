+import { beforeEach, describe, expect, it, vi } from "vitest";
+import type { OpenClawConfig } from "../config/types.js";
+import { resolveSimpleCompletionSelectionForAgent } from "./simple-completion-runtime.js";
+import { prepareUtilityCompletionForAgent } from "./utility-completion.js";
+
+vi.mock("./simple-completion-runtime.js", () => ({
+  resolveSimpleCompletionSelectionForAgent: vi.fn(),
+}));
+
+const MODEL_KEY = "openai/gpt-6-sol";
+
+function utilityConfig(thinking?: unknown): OpenClawConfig {
+  return {
+    agents: {
+      defaults: {
+        model: "openai/gpt-6-astra",
+        thinkingDefault: "max",
+        utilityModel: MODEL_KEY,
+        models: {
+          [MODEL_KEY]: { params: thinking === undefined ? {} : { thinking } },
+        },
+      },
+      entries: { main: { thinkingDefault: "ultra" } },
+    },
+  };
+}
+
+function prepare(cfg: OpenClawConfig) {
+  return prepareUtilityCompletionForAgent({ cfg, agentId: "main", useUtilityModel: true });
+}
+
+beforeEach(() => {
+  vi.mocked(resolveSimpleCompletionSelectionForAgent).mockReset().mockReturnValue({
+    provider: "openai",
+    modelId: "gpt-6-sol",
+    agentDir: "/tmp/utility-agent",
+  });
+});
+
+describe("prepareUtilityCompletionForAgent", () => {
+  it("carries the utility model's configured High without inheriting interactive Max or Ultra", async () => {
+    expect(await prepare(utilityConfig("high"))).toMatchObject({
+      provider: "openai",
+      model: "gpt-6-sol",
+      thinkLevel: "high",
+    });
+  });
+
+  it.each([
+    { thinking: "low", expected: "low" },
+    { thinking: false, expected: "off" },
+  ])("prefers the agent's explicit model setting ($thinking)", async ({ thinking, expected }) => {
+    const cfg = utilityConfig("high");
+    cfg.agents!.entries!.main!.models = { [MODEL_KEY]: { params: { thinking } } };
+    expect(await prepare(cfg)).toHaveProperty("thinkLevel", expected);
+  });
+
+  it("retains the shared model setting when the agent has no thinking override for it", async () => {
+    const cfg = utilityConfig("high");
+    cfg.agents!.entries!.main!.models = { [MODEL_KEY]: { params: { temperature: 0 } } };
+    expect(await prepare(cfg)).toHaveProperty("thinkLevel", "high");
+  });
+
+  it.each([false, "disabled", "none", "extra-high"])(
+    "normalizes explicit model reasoning %s using the existing thinking vocabulary",
+    async (thinking) => {
+      expect(await prepare(utilityConfig(thinking))).toHaveProperty(
+        "thinkLevel",
+        thinking === "extra-high" ? "xhigh" : "off",
+      );
+    },
+  );
+
+  it.each([undefined, "not-a-thinking-level", { type: "enabled" }])(
+    "leaves reasoning unset without a recognized explicit model setting (%s)",
+    async (thinking) => {
+      expect(await prepare(utilityConfig(thinking))).not.toHaveProperty("thinkLevel");
+    },
+  );
+
+  it("preserves selected authentication and strict visible output", async () => {
+    vi.mocked(resolveSimpleCompletionSelectionForAgent).mockReturnValue({
+      provider: "openai",
+      modelId: "gpt-6-sol",
+      profileId: "selected-profile",
+      agentDir: "/tmp/utility-agent",
+    });
+    const cfg = utilityConfig("high");
+    expect(
+      await prepareUtilityCompletionForAgent({
+        cfg,
+        agentId: "main",
+        useUtilityModel: true,
+        preferredProfile: "fallback-profile",
+      }),
+    ).toEqual({
+      config: cfg,
+      provider: "openai",
+      model: "gpt-6-sol",
+      authProfileId: "selected-profile",
+      outputTextPolicy: "strict-visible",
+      agentId: "main",
+      agentDir: "/tmp/utility-agent",
+      thinkLevel: "high",
+    });
+  });
+});

+  refresh?: string;
+  expiresAt?: number;
+  access?: string;
+  scope?: string;
+}) {
+  updateMcpOAuthStore(identity.storeKey, () => ({
+    tokens: {
+      access_token: params.access ?? "fixture-access",
+      token_type: "Bearer",
+      ...(params.refresh ? { refresh_token: params.refresh } : {}),
+      ...(params.scope ? { scope: params.scope } : {}),
+    },
+    ...(params.expiresAt === undefined ? {} : { tokenExpiresAt: params.expiresAt }),
+  }));
+}
+
+describe("prepared MCP steering ownership", () => {
+  it("ignores only catalog generation time, and rejects schema/provenance changes", () => {
+    const f = fixture();
+    const isCurrent = f.capture();
+    expect(isCurrent()).toBe(true);
+    f.state.catalog = { ...f.state.catalog!, generatedAt: 2 };
+    expect(isCurrent()).toBe(true);
+    f.state.catalog.tools[0]!.inputSchema = Type.Object({ account: Type.Number() });
+    expect(isCurrent()).toBe(false);
+    f.state.catalog.tools[0]!.inputSchema = Type.Object({ account: Type.String() });
+    expect(isCurrent()).toBe(true);
+    f.state.catalog.tools[0]!.oauthConnectBootstrap = true;
+    expect(isCurrent()).toBe(false);
+  });
+
+  it("rejects bootstrap/approval metadata or executor replacement despite unchanged names", () => {
+    const f = fixture();
+    const isCurrent = f.capture();
+    setPluginToolMeta(f.tool, {
+      ...f.metadata,
+      mcp: { ...f.metadata.mcp, oauthConnectBootstrap: true },
+    });
+    expect(isCurrent()).toBe(false);
+    setPluginToolMeta(f.tool, f.metadata);
+    expect(isCurrent()).toBe(true);
+    setPluginToolMeta(f.tool, {
+      ...f.metadata,
+      mcp: { ...f.metadata.mcp, codexApproval: { mode: "prompt" } },
+    });

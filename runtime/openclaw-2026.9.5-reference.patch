+import { setImmediate } from "node:timers/promises";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { withPreparedEmbeddedRunToolAuthority } from "../../agents/harness/tool-authority.runtime.js";
+import {
+  createAdmittedGatewayToolCallerIdentity,
+  withGatewayToolCallerIdentity,
+} from "../../agents/tools/gateway-caller-context.js";
+import { buildChannelInboundEventContext } from "../../channels/inbound-event/context.js";
+import { createHostChannelInboundEventContextBuilder } from "../../channels/inbound-event/host-context-builder.js";
+import { readChannelContextGatewayContextResolver } from "../../channels/message-access/admission-evidence.js";
+import { registerChannelIngressHostOwner } from "../../channels/message-access/ingress-host-owner.js";
+import { resolveStableChannelMessageIngress } from "../../channels/message-access/runtime.js";
+import type { OpenClawConfig } from "../../config/types.openclaw.js";
+import type { GatewayRequestContext } from "../../gateway/server-methods/types.js";
+import {
+  bindGatewayContextResolver,
+  getGatewayContextResolver,
+  withPluginRuntimeGatewayContextResolver,
+} from "../../plugins/runtime/gateway-request-scope.js";
+import {
+  createOpenClawTestState,
+  type OpenClawTestState,
+} from "../../test-utils/openclaw-test-state.js";
+import { createCommandTurnContext } from "../command-turn-context.js";
+import { prepareChannelRunAdmission } from "./channel-run-admission.js";
+import { finalizeInboundContext } from "./inbound-context.js";
+import { testing } from "./reply-run-registry.test-support.js";
+import { prepareReplyToolAuthority } from "./reply-tool-authority.js";
+import { admitReplyTurn } from "./reply-turn-admission.js";
+import { initSessionState } from "./session.js";
+
+let state: OpenClawTestState;
+beforeEach(async () => {
+  state = await createOpenClawTestState({ label: "session-gateway-authority" });
+});
+afterEach(async () => {
+  testing.resetReplyRunRegistry();
+  await state.cleanup();
+});
+
+describe("session context Gateway authority through queued admission", () => {
+  it.each(["bound", "retired", "unbound", "retargeted"] as const)(
+    "preserves only the %s inbound owner across the busy reply handoff",
+    async (mode) => {
+      const sessionKey = "agent:main:test:channel:source";
+      const cfg: OpenClawConfig = {
+        agents: { defaults: { workspace: state.workspaceDir } },
+        session: { store: state.statePath("agents", "main", "sessions", "sessions.json") },
+      };
+      const gateway = { getRuntimeConfig: () => cfg } as GatewayRequestContext;
+      const unrelatedGateway = { getRuntimeConfig: () => cfg } as GatewayRequestContext;
+      let live = true;
+      const owner = {
+        channelId: "test",
+        record: {},
+        epoch: {},
+        isLive: () => live,
+        resolveGatewayContext: () => (live ? gateway : undefined),
+      };
+      const dispose = registerChannelIngressHostOwner(owner);
+      try {
+        const ingress = await resolveStableChannelMessageIngress({
+          channelId: "test",
+          accountId: "default",
+          subject: { stableId: "sender" },
+          conversation: { kind: "channel", id: "source" },
+          contextBinding: {
+            agentId: "main",
+            sessionKey,
+            messageId: "correction",
+            inboundEventKind: "user_request",
+          },
+          dmPolicy: "allowlist",
+          groupPolicy: "open",
+          allowFrom: [],
+        });
+        const build = createHostChannelInboundEventContextBuilder(
+          buildChannelInboundEventContext,
+          mode === "unbound" ? undefined : owner,
+        );
+        const ctx = finalizeInboundContext(
+          await build({
+            channel: "test",
+            accountId: "default",
+            messageId: "correction",
+            sender: { id: "sender" },
+            from: "test:channel:source",
+            conversation: { kind: "channel", id: "source" },
+            route: { agentId: "main", routeSessionKey: sessionKey },
+            reply: { to: "test:channel:source" },
+            message: { rawBody: "Use the corrected note." },
+            channelIngress: ingress,
+          }),
+        );
+        expect(readChannelContextGatewayContextResolver(ctx)?.()).toBe(
+          mode === "unbound" ? undefined : gateway,
+        );
+        if (mode === "retargeted") {
+          ctx.CommandTargetSessionKey = "agent:main:test:channel:other";
+          ctx.CommandTurn = createCommandTurnContext("native", { authorized: true });
+        }
+        const initialized = await initSessionState({ ctx, cfg, commandAuthorized: true });
+        expect(initialized.sessionCtx).not.toBe(ctx);
+        expect(initialized.sessionKey).toBe(
+          mode === "retargeted" ? "agent:main:test:channel:other" : sessionKey,
+        );
+        const resolver = readChannelContextGatewayContextResolver(initialized.sessionCtx);
+        const params = {
+          agentId: "main",
+          sessionKey: initialized.sessionKey,
+          sessionId: initialized.sessionId,
+          storePath: initialized.storePath,
+          resetTriggered: false,
+        };
+        const active = await admitReplyTurn({ ...params, kind: "visible" });
+        if (active.status !== "owned") {
+          throw new Error("Expected the initial reply owner");
+        }
+        let settled = false;
+        const pending = admitReplyTurn({
+          ...params,
+          kind: "queued_followup",
+          resolveGatewayContext: resolver,
+        }).then((result) => {
+          settled = true;
+          return result;
+        });
+        await setImmediate();
+        expect(settled).toBe(false);
+        if (mode === "retired") {
+          live = false;
+        }
+        active.operation.complete();
+        const admitted = await pending;
+        if (admitted.status !== "owned") {
+          throw new Error("Expected queued admission after the initial owner settled");
+        }
+        const operation = admitted.operation;
+        const attempt = {
+          ...params,
+          runId: `queued-${mode}`,
+          config: cfg,
+          sessionFile: state.path("transcript.jsonl"),
+          workspaceDir: state.workspaceDir,
+          provider: "openai",
+          modelId: "test-model",
+          senderIsOwner: false,
+          messageChannel: "test",
+          messageProvider: "test",
+        };
+        operation.bindToolAuthoritySnapshot(
+          prepareReplyToolAuthority({ run: { ...attempt, model: attempt.modelId } }),
+        );
+        const admission = prepareChannelRunAdmission({
+          cfg,
+          runId: attempt.runId,
+          agentId: params.agentId,
+          ingressKind: "channel",
+          boundary: "queued-session-context-test",
+          onAdmitted: (context) =>
+            bindGatewayContextResolver(
+              context,
+              getGatewayContextResolver(operation) ?? (() => undefined),
+            ),
+        });
+        const execute = vi.fn(async () => "executed once");
+        try {
+          const context = await admission.admit("embedded");
+          const caller = createAdmittedGatewayToolCallerIdentity({
+            admittedRunContext: context,
+            agentId: params.agentId,
+            sessionKey: params.sessionKey,
+          });
+          const result = withPluginRuntimeGatewayContextResolver(
+            () => unrelatedGateway,
+            () =>
+              withGatewayToolCallerIdentity(caller, () =>
+                withPreparedEmbeddedRunToolAuthority(
+                  { admittedRunContext: context, replyOperation: operation },
+                  { ...attempt, toolAuthorityFingerprint: "prepared" },
+                  undefined,
+                  execute,
+                ),
+              ),
+          );
+          if (mode === "bound") {
+            await expect(result).resolves.toBe("executed once");
+            expect(caller?.gatewayContextResolver?.()).toBe(gateway);
+            expect(execute).toHaveBeenCalledOnce();
+          } else {
+            await expect(result).rejects.toThrow(
+              "embedded tool authority lost its source execution claim",
+            );
+            expect(execute).not.toHaveBeenCalled();
+          }
+        } finally {
+          admission.close();
+          operation.complete();
+        }
+      } finally {
+        dispose();
+      }
+    },
+  );
+});

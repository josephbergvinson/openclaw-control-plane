+    sessionKey: "agent:main:discord:channel:synthetic",
+    delivery: { mode: "announce", channel: "discord", to: "synthetic" },
+    payload: {
+      kind: "command",
+      argv,
+      timeoutSeconds: 30,
+      toolsAllow: ["read", "exec", "process"],
+      repair: {

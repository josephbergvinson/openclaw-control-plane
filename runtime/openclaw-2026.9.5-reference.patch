+import path from "node:path";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { loadDiscordNativeGoalTestHarness } from "../extensions/discord/test-api.js";
+import { setReplyPayloadMetadata } from "../src/auto-reply/reply-payload.js";
+import { loadSessionEntry, replaceSessionEntry } from "../src/config/sessions/session-accessor.js";
+import * as outboundDelivery from "../src/infra/outbound/deliver.js";
+import {
+  installDeliveryQueueTmpDirHooks,
+  loadPendingDeliveries,
+} from "../src/infra/outbound/delivery-queue.test-helpers.js";
+import {
+  initializeGlobalHookRunner,
+  resetGlobalHookRunner,
+} from "../src/plugins/hook-runner-global.js";
+import { addTestHook } from "../src/plugins/hooks.test-helpers.js";
+import { createEmptyPluginRegistry } from "../src/plugins/registry.js";
+import { resetPluginRuntimeStateForTest, setActivePluginRegistry } from "../src/plugins/runtime.js";
+import { createTestRegistry } from "../src/test-utils/channel-plugins.js";
+
+const {
+  ChannelType,
+  dispatchDiscordNativeAgentReply,
+  buildDiscordNativeCommandContext,
+  createMockCommandInteraction,
+  createDiscordOutboundHoisted,
+  installDiscordOutboundModuleSpies,
+  resetDiscordOutboundMocks,
+  loadDiscordPlugin,
+} = await loadDiscordNativeGoalTestHarness();
+const outbound = createDiscordOutboundHoisted();
+await installDiscordOutboundModuleSpies(outbound);
+const { discordPlugin } = await loadDiscordPlugin();
+
+describe("native Discord goal final custody", () => {
+  const fixture = installDeliveryQueueTmpDirHooks();
+  beforeEach(() => {
+    vi.stubEnv("OPENCLAW_STATE_DIR", fixture.tmpDir());
+    resetDiscordOutboundMocks(outbound);
+    setActivePluginRegistry(
+      createTestRegistry([{ pluginId: "discord", source: "test", plugin: discordPlugin }]),
+    );
+  });
+  afterEach(() => {
+    resetGlobalHookRunner();
+    resetPluginRuntimeStateForTest();
+    setActivePluginRegistry(createEmptyPluginRegistry());
+    vi.unstubAllEnvs();
+  });
+
+  it.each([
+    { commandName: "goal", hook: "none", chunks: false },
+    { commandName: "goal", hook: "rewrite", chunks: true },
+    { commandName: "goal", hook: "cancel", chunks: false },
+    { commandName: "status", hook: "rewrite", chunks: false },
+    { commandName: "status", hook: "cancel", chunks: false },
+    { commandName: "goal", hook: "unsupported", chunks: false },
+  ] as const)(
+    "keeps real custody and interaction hooks for $commandName/$hook (chunks=$chunks)",
+    async ({ commandName, hook, chunks }) => {
+      const sessionKey = "agent:main:discord:channel:123456";
+      const sourceKey = "agent:main:discord:slash:owner";
+      const storePath = path.join(fixture.tmpDir(), "sessions.json");
+      const finalText = "native-goal-final-custody-check";
+      const visibleText = chunks
+        ? "Verified final result. ".repeat(210).trim()
+        : "Verified final result.";
+      const hookRegistry = createEmptyPluginRegistry();
+      const sending = vi.fn(async ({ content }: { content: string }) => {
+        if (content !== finalText) {
+          return undefined;
+        }
+        return hook === "cancel"
+          ? { cancel: true }
+          : hook === "rewrite"
+            ? { content: visibleText }
+            : undefined;
+      });
+      addTestHook({
+        registry: hookRegistry,
+        pluginId: "test-hook",
+        hookName: "message_sending",
+        handler: sending,
+      });
+      initializeGlobalHookRunner(hookRegistry);
+      const identity = {
+        deliveryId: "goal-final",
+        intentId: "goal-intent",
+        sessionId: "goal-session",
+        sessionKey,
+        storePath,
+      };
+      await replaceSessionEntry(
+        { sessionKey, storePath },
+        {
+          sessionId: identity.sessionId,
+          updatedAt: Date.now(),
+          pendingFinalDelivery: {
+            kind: "replayable",
+            text: finalText,
+            intentId: identity.intentId,
+            createdAt: Date.now(),
+            deliveries: [{ id: identity.deliveryId, state: "prepared" }],
+          },
+        },
+      );
+      const final = setReplyPayloadMetadata(
+        { text: finalText },
+        { pendingFinalDeliveryCompletion: identity },
+      );
+      const interaction = createMockCommandInteraction({
+        channelType: ChannelType.GuildText,
+        channelId: "123456",
+        guildId: "987654",
+      });
+      interaction.responseState = "deferred";
+      const logError = vi.fn();
+      const unsupported =
+        hook === "unsupported"
+          ? vi
+              .spyOn(outboundDelivery, "resolveOutboundDurableFinalDeliverySupport")
+              .mockResolvedValue({ ok: false, reason: "missing_outbound_handler" })
+          : undefined;
+      const result = await dispatchDiscordNativeAgentReply({
+        commandName,
+        cfg: { session: { store: storePath }, channels: { discord: { token: "test-token" } } },
+        discordConfig: {},
+        accountId: "default",
+        interaction: interaction as unknown as Parameters<
+          typeof dispatchDiscordNativeAgentReply
+        >[0]["interaction"],
+        ctxPayload: buildDiscordNativeCommandContext({

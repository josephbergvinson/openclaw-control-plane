@@ -0,0 +1,70 @@
+import type { summarizeInStages } from "../compaction.js";
+import {
+  buildStructuredFallbackSummary,
+  wrapUntrustedInstructionBlock,
+} from "./compaction-safeguard-quality.js";
+
+type SummaryParams = Parameters<typeof summarizeInStages>[0];
+
+/** Generate independent history and split-prefix summaries under one cancellation owner. */
+export async function summarizeCompactionAttempt(params: {
+  summarize: typeof summarizeInStages;
+  commonParams: Omit<
+    SummaryParams,
+    "messages" | "summaryPrompt" | "customInstructions" | "previousSummary"
+  >;
+  messagesToSummarize: SummaryParams["messages"];
+  turnPrefixMessages: SummaryParams["messages"];
+  structuredInstructions: string;
+  bodyGenerationBudget: string;
+  splitTurnGenerationBudget: string;
+  customInstructions: string;
+  correctiveInstructions: string;
+  previousSummary: string | undefined;
+}): Promise<{ historySummary: string; splitTurnSummary: string | undefined }> {
+  const historyPromise =
+    params.messagesToSummarize.length > 0
+      ? params.summarize({
+          ...params.commonParams,
+          messages: params.messagesToSummarize,
+          summaryPrompt: { kind: "custom", instructions: params.structuredInstructions },
+          customInstructions: [params.bodyGenerationBudget, params.correctiveInstructions]
+            .filter(Boolean)
+            .join("\n\n"),
+          previousSummary: params.previousSummary,
+        })
+      : Promise.resolve(buildStructuredFallbackSummary(params.previousSummary));
+  const prefixPromise = (async () => {
+    if (params.turnPrefixMessages.length === 0) {
+      return undefined;
+    }
+    const splitTurnFocus = wrapUntrustedInstructionBlock(
+      "Additional context from /compact",
+      params.customInstructions,
+    );
+    return await params.summarize({
+      ...params.commonParams,
+      messages: params.turnPrefixMessages,
+      summaryPrompt: { kind: "turn-prefix" },
+      customInstructions: [
+        params.splitTurnGenerationBudget,
+        splitTurnFocus,
+        params.correctiveInstructions,
+      ]
+        .filter(Boolean)
+        .join("\n\n"),
+      previousSummary: undefined,
+    });
+  })();
+  // A failed request does not release its peer: both retain the original caller
+  // signal and must settle before the owner can finalize or return an error.
+  const [historyResult, prefixResult] = await Promise.allSettled([historyPromise, prefixPromise]);
+  params.commonParams.signal.throwIfAborted();
+  if (historyResult.status === "rejected") {
+    throw historyResult.reason;
+  }
+  if (prefixResult.status === "rejected") {
+    throw prefixResult.reason;
+  }
+  return { historySummary: historyResult.value, splitTurnSummary: prefixResult.value };
+}
diff --git a/src/agents/agent-hooks/compaction-safeguard-tool-failures.ts b/src/agents/agent-hooks/compaction-safeguard-tool-failures.ts

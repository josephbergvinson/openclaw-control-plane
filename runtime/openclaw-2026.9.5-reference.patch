+        let diagnostics = try #require(result.details?["credentialPromptDiagnostics"]?.value as? [String: Any])
+        #expect(diagnostics["reason"] as? String == "eligible")
+        #expect(diagnostics["axReadFailureCount"] as? Int == 1)
+        #expect(harness.discoveryCalls == 1)
+        #expect(harness.secretReads == 0)
+        let ref = try #require(row["promptRef"])
+        _ = try await harness.fill(ref)

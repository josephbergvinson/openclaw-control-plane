diff --git a/src/gateway/server-methods/agent.run-context-lifetime.test.ts b/src/gateway/server-methods/agent.run-context-lifetime.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c3724a83e0e6d235653389a215c3e2711fc56594
--- /dev/null
+++ b/src/gateway/server-methods/agent.run-context-lifetime.test.ts
@@ -0,0 +1,195 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { createDeferred } from "../../../test/helpers/promise.js";
+import * as runRegistry from "../../infra/agent-run-registry.js";
+import { listTaskRecords } from "../../tasks/runtime-internal.js";
+import {
+  configureTaskRegistryMaintenance,
+  reconcileTaskLookupToken,
+  resetTaskRegistryMaintenanceRuntimeForTests,
+} from "../../tasks/task-registry.maintenance.js";
+import {
+  describe1AfterEach1,
+  describe1BeforeEach0,
+  getAgentTestMocks,
+  invokeAgent,
+  makeContext,
+  operatorWriteCliClient,
+  prime,
+  requireValue,
+  waitForAssertion,
+} from "./agent.test-harness.js";
+
+const registry = await vi.importActual<typeof runRegistry>("../../infra/agent-run-registry.js");
+const readRunContext = registry.getAgentRunContext;
+const mocks = getAgentTestMocks();
+const sessionKey = "agent:main:main";
+
+describe("Gateway admitted run context lifetime", () => {
+  beforeEach(async () => {
+    await describe1BeforeEach0();
+    registry.resetAgentRunRegistryForTest();
+    mocks.lifecycleGeneration = registry.getAgentRunLifecycleGeneration();
+    mocks.registerAgentRunContext.mockImplementation(registry.claimAgentRunContext);
+    mocks.clearAgentRunContext.mockImplementation(registry.clearAgentRunContext);
+    vi.spyOn(runRegistry, "getAgentRunContext").mockImplementation(readRunContext);
+    prime();
+  });
+
+  afterEach(async () => {
+    vi.restoreAllMocks();
+    resetTaskRegistryMaintenanceRuntimeForTests();
+    registry.resetAgentRunRegistryForTest();
+    await describe1AfterEach1();
+  });
+
+  async function holdCommand(runId: string) {
+    // Required preflight runs inside the admitted command, before its first agent event.
+    const command = createDeferred<{
+      payloads: Array<{ text: string }>;
+      meta: { durationMs: number };
+    }>();
+    mocks.agentCommand.mockImplementationOnce(() => command.promise);
+    const context = makeContext();
+    const respond = await invokeAgent(
+      { message: "continue retained work", sessionKey, idempotencyKey: runId },
+      { context, client: operatorWriteCliClient() },
+    );
+    const entry = requireValue(
+      context.chatAbortControllers.get(runId),
+      "admitted controller missing",
+    );
+    const finish = async (failure = false) => {
+      if (failure) {
+        command.reject(new Error("required compaction failed"));
+      } else {
+        command.resolve({ payloads: [{ text: "completed" }], meta: { durationMs: 1 } });
+      }
+      await waitForAssertion(() => expect(respond.mock.calls.length).toBeGreaterThan(1));
+    };
+    return { context, entry, finish };
+  }
+
+  it.each([false, true])(
+    "retains quiet preflight through sweeping and releases on failure=%s",
+    async (failure) => {
+      const runId = `quiet-preflight-${failure}`;
+      const held = await holdCommand(runId);
+      const clock = vi.spyOn(Date, "now").mockReturnValue(Date.now() + 31 * 60_000);
+      try {
+        registry.sweepStaleRunContexts();
+        configureTaskRegistryMaintenance({ runtimeAuthoritative: true });
+        const task = requireValue(
+          listTaskRecords().find((row) => row.runId === runId),
+          "tracked task missing",
+        );
+        expect(reconcileTaskLookupToken(task.taskId)?.status).toBe("running");
+        expect(registry.getAgentRunContext(runId)).toBeDefined();
+      } finally {
+        clock.mockRestore();
+        await held.finish(failure);
+      }
+      expect(held.context.chatAbortControllers.has(runId)).toBe(false);
+      expect(registry.getAgentRunContext(runId)).toBeUndefined();
+    },
+  );
+
+  it("releases the claim when preparation rejects before acceptance", async () => {
+    const preparedRuntime = await import("../../agents/prepared-model-runtime.js");
+    vi.mocked(preparedRuntime.acquireAgentRunPreparedModelRuntime).mockRejectedValueOnce(
+      new Error("published runtime unavailable"),
+    );
+    const runId = "preaccept-failure";
+    const context = makeContext();
+    const respond = await invokeAgent(
+      { message: "continue", sessionKey, idempotencyKey: runId },
+      { context, client: operatorWriteCliClient() },
+    );
+    expect(respond).toHaveBeenCalledWith(
+      false,
+      undefined,
+      expect.objectContaining({ code: "UNAVAILABLE" }),
+    );
+    expect(mocks.agentCommand).not.toHaveBeenCalled();
+    expect(context.chatAbortControllers.has(runId)).toBe(false);
+    expect(registry.getAgentRunContext(runId)).toBeUndefined();
+  });
+
+  it("rejects a competing exclusive owner without evicting its context", async () => {
+    const runId = "exclusive-owner";
+    const claim = registry.claimAgentRunContext(
+      runId,
+      { sessionKey, lifecycleGeneration: mocks.lifecycleGeneration },
+      {
+        trackOwner: true,
+        ownsContext: true,
+        exclusive: true,
+        protectFromSweep: true,
+      },
+    );
+    const owner = registry.getAgentRunContext(runId);
+    const context = makeContext();
+    try {
+      const respond = await invokeAgent(
+        { message: "continue", sessionKey, idempotencyKey: runId },
+        { context, client: operatorWriteCliClient() },
+      );
+      expect(respond.mock.calls[0]?.[0]).toBe(false);
+      expect(context.addChatRun).not.toHaveBeenCalled();
+      expect(mocks.agentCommand).not.toHaveBeenCalled();
+      expect(context.chatAbortControllers.has(runId)).toBe(false);
+      expect(registry.getAgentRunContext(runId)).toBe(owner);
+    } finally {
+      if (claim) {
+        registry.releaseAgentRunContext(runId, claim);
+      }
+    }
+  });
+
+  it("retains the claim until deferred terminal persistence removes its controller", async () => {
+    const runId = "terminal-persistence";
+    const held = await holdCommand(runId);
+    const persistence = createDeferred();
+    held.entry.projectSessionTerminalPersistence = persistence.promise;
+    try {
+      await held.finish();
+      const clock = vi.spyOn(Date, "now").mockReturnValue(Date.now() + 31 * 60_000);
+      try {
+        registry.sweepStaleRunContexts();
+        expect(registry.getAgentRunContext(runId)).toBeDefined();
+        expect(held.entry.registrationCleanupRequested).toBe(true);
+      } finally {
+        clock.mockRestore();
+      }
+    } finally {
+      persistence.resolve();
+      await waitForAssertion(() =>
+        expect(held.context.chatAbortControllers.has(runId)).toBe(false),
+      );
+    }
+    expect(registry.getAgentRunContext(runId)).toBeUndefined();
+  });
+
+  it("releases only its claim and cannot clear a recycled run context", async () => {
+    const runId = "shared-owner";
+    const held = await holdCommand(runId);
+    const sibling = requireValue(
+      registry.claimAgentRunContext(runId, {}, { trackOwner: true }),
+      "sibling claim missing",
+    );
+    const removed = held.entry.onRemoved;
+    await held.finish();
+    expect(registry.getAgentRunContext(runId)).toBeDefined();
+    registry.releaseAgentRunContext(runId, sibling);
+    expect(registry.getAgentRunContext(runId)).toBeUndefined();
+    const successor = registry.claimAgentRunContext(
+      runId,
+      { sessionKey: "agent:main:successor" },
+      { trackOwner: true, ownsContext: true },
+    );
+    removed?.();
+    expect(registry.getAgentRunContext(runId)?.sessionKey).toBe("agent:main:successor");
+    if (successor) {
+      registry.releaseAgentRunContext(runId, successor);
+    }
+  });
+});

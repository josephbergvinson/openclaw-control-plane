+    CREATE TABLE IF NOT EXISTS config_machine_state (
+      state_key TEXT NOT NULL PRIMARY KEY,
+      value_json TEXT NOT NULL,
+      updated_at_ms INTEGER NOT NULL
+    ) STRICT;
+  `);
+  if (recordOwnership) {
+    db.prepare(
+      "INSERT INTO config_machine_state (state_key, value_json, updated_at_ms) VALUES (?, ?, ?)",
+    ).run("auth.sharedStore", JSON.stringify({ location: "state-db" }), 100);
+  }
+  db.prepare(
+    "INSERT INTO config_machine_state (state_key, value_json, updated_at_ms) VALUES (?, ?, ?)",
+  ).run("authProfiles.state", stateJson, 100);
+  if (storeJson !== undefined) {
+    db.prepare(
+      "INSERT INTO config_machine_state (state_key, value_json, updated_at_ms) VALUES (?, ?, ?)",
+    ).run("authProfiles.store", storeJson, 100);
+  }
+  return db;
+}
+
+function createAgentAuthStateDatabase(
+  stateDir: string,
+  stateJson: string,
+  agentId: string,
+  storeJson?: string,
+): DatabaseSync {
+  const agentDir = path.join(stateDir, "agents", agentId, "agent");
+  fs.mkdirSync(agentDir, { recursive: true });
+  const db = new DatabaseSync(path.join(agentDir, "openclaw-agent.sqlite"));
+  db.exec(`
+    PRAGMA user_version = ${OPENCLAW_AGENT_SCHEMA_VERSION};
+    CREATE TABLE schema_meta (
+      meta_key TEXT NOT NULL PRIMARY KEY,
+      role TEXT NOT NULL,
+      schema_version INTEGER NOT NULL,
+      agent_id TEXT
+    ) STRICT;
+    CREATE TABLE auth_profile_state (
+      state_key TEXT NOT NULL PRIMARY KEY,
+      state_json TEXT NOT NULL,
+      updated_at INTEGER NOT NULL
+    ) STRICT;
+  `);
+  db.prepare(
+    "INSERT INTO schema_meta (meta_key, role, schema_version, agent_id) VALUES (?, ?, ?, ?)",
+  ).run("primary", "agent", OPENCLAW_AGENT_SCHEMA_VERSION, agentId);
+  db.prepare(
+    "INSERT INTO auth_profile_state (state_key, state_json, updated_at) VALUES (?, ?, ?)",
+  ).run("primary", stateJson, 100);
+  if (storeJson !== undefined) {
+    db.exec(`
+      CREATE TABLE auth_profile_store (
+        store_key TEXT NOT NULL PRIMARY KEY,
+        store_json TEXT NOT NULL,
+        updated_at INTEGER NOT NULL
+      ) STRICT;
+    `);
+    db.prepare(
+      "INSERT INTO auth_profile_store (store_key, store_json, updated_at) VALUES (?, ?, ?)",
+    ).run("primary", storeJson, 100);
+  }
+  return db;
+}
+
+function usableOpenAIProfiles(): Record<string, unknown> {
+  return Object.fromEntries(
+    openAIProfileOrder.map((profileId, index) => [
+      profileId,
+      {
+        type: "oauth",
+        provider: "openai",
+        access: `private-access-${index}`,
+        refresh: `private-refresh-${index}`,
+        email: `private-profile-${index}@example.test`,
+      },
+    ]),
+  );
+}
+
+function authProfileStoreJson(profiles: Record<string, unknown> = usableOpenAIProfiles()): string {
+  return JSON.stringify({ version: 1, profiles });
+}
+
+function insertRow(params: {
+  db: DatabaseSync;
+  file: ExecApprovalsFile;
+  raw?: string;
+  key?: string;
+  projectionOverrides?: Partial<ReturnType<typeof projectionValues>>;
+  updatedAt?: number;
+}): void {
+  const projections = {
+    ...projectionValues(params.file),
+    ...params.projectionOverrides,
+  };
+  params.db
+    .prepare(
+      `INSERT INTO exec_approvals_config (
+        config_key, raw_json, socket_path, has_socket_token,
+        default_security, default_ask, default_ask_fallback,
+        auto_allow_skills, agent_count, allowlist_count, updated_at_ms
+      ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
+    )
+    .run(
+      params.key ?? "current",
+      params.raw ?? `${JSON.stringify(params.file, null, 2)}\n`,
+      projections.socket_path,
+      projections.has_socket_token,
+      projections.default_security,
+      projections.default_ask,
+      projections.default_ask_fallback,
+      projections.auto_allow_skills,
+      projections.agent_count,
+      projections.allowlist_count,
+      params.updatedAt ?? 100,
+    );
+}
+
+function policy(overrides: Partial<ExecApprovalsFile> = {}): ExecApprovalsFile {
+  return {
+    version: 1,
+    socket: {
+      path: resolveExecApprovalsSocketPath(),
+      token: "private-socket-token",
+    },
+    defaults: {
+      security: "full",
+      ask: "off",
+      askFallback: "full",
+      autoAllowSkills: true,
+    },
+    agents: {
+      main: {
+        security: "full",
+        ask: "off",
+        askFallback: "full",
+        autoAllowSkills: true,
+        allowlist: [
+          {
+            id: "private-rule-id",
+            pattern: "/private/bin/first",
+            argPattern: "--private-argument",
+            source: "allow-always",
+            commandText: "private command text",
+            lastUsedAt: 10,
+            lastUsedCommand: "private last command",
+            lastResolvedPath: "/private/resolved/path",
+          },
+          { id: "private-rule-id-2", pattern: "/private/bin/second" },
+        ],
+      },
+    },
+    ...overrides,
+  };
+}
+
+function requireDefaults(file: ExecApprovalsFile): ExecApprovalsDefaults {
+  if (!file.defaults) {
+    throw new Error("missing test defaults");
+  }
+  return file.defaults;
+}
+
+function requireMainAgent(file: ExecApprovalsFile): ExecApprovalsAgent {
+  const agent = file.agents?.main;
+  if (!agent) {
+    throw new Error("missing test main agent");
+  }
+  return agent;
+}
+
+function requireFirstRule(file: ExecApprovalsFile) {
+  const rule = requireMainAgent(file).allowlist?.[0];
+  if (!rule) {
+    throw new Error("missing test allowlist rule");
+  }
+  return rule;
+}
+
+function requireStateDir() {
+  const stateDir = process.env.OPENCLAW_STATE_DIR;
+  if (!stateDir) {
+    throw new Error("missing test state dir");
+  }
+  return stateDir;
+}
+
+function fileMetadata(stat: fs.Stats) {
+  const { dev, ino, mode, nlink, uid, gid, size, mtimeMs } = stat;
+  return { dev, ino, mode, nlink, uid, gid, size, mtimeMs };
+}
+
+function inspectState(legacyPath = resolveExecApprovalsPath()) {
+  return inspectExecApprovalsState({ stateDir: requireStateDir(), legacyPath });
+}

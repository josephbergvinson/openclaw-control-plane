+  beginSessionWorkAdmission,
+  consumeSessionWorkAdmissionHandoff,
+  getSessionWorkAdmissionOwnerRelease,
+  isCompetingSessionWorkAdmissionActive,
+  runExclusiveSessionLifecycleMutation,

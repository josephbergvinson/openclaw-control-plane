--- /dev/null
+++ b/src/agents/subagents/registry/subagent-registry-cron-yield-failure.ts
@@ -0,0 +1,124 @@
+import { isDeepStrictEqual } from "node:util";
+/** Durable failed-parent binding shared by cancellation and child recovery admission. */
+import { isRecord } from "@openclaw/normalization-core/record-coerce";
+import { isCronSessionKey, parseAgentSessionKey } from "../../../routing/session-key.js";
+import { readTaskBackingInstance } from "../../../tasks/task-backing-authority.js";
+import { isProvisionalSubagentKillTask } from "../../../tasks/task-cancellation-state.js";
+import type { TaskRecord } from "../../../tasks/task-registry.types.js";
+import { SUBAGENT_ENDED_REASON_KILLED } from "./subagent-lifecycle-events.js";
+import type { CronRequesterFailure, SubagentRunRecord } from "./subagent-registry.types.js";
+import { compareSubagentRunGeneration } from "./subagent-run-generation.js";
+
+/** Native task cancellation is final without a child reply to capture. */
+export function isFinalizedCronChildCancellation(
+  entry: SubagentRunRecord,
+  task: TaskRecord | undefined,
+): boolean {
+  const backing = readTaskBackingInstance(task?.detail);
+  return Boolean(
+    task &&
+    task.runtime === "subagent" &&
+    task.status === "cancelled" &&
+    task.deliveryStatus === "not_applicable" &&
+    !isProvisionalSubagentKillTask(task) &&
+    task.runId === (entry.taskRunId ?? entry.runId) &&
+    task.childSessionKey === entry.childSessionKey &&
+    backing?.runtime === "subagent" &&
+    backing.generation === entry.generation &&
+    typeof task.endedAt === "number" &&
+    entry.execution.status === "terminal" &&
+    typeof entry.execution.endedAt === "number" &&
+    entry.endedReason === SUBAGENT_ENDED_REASON_KILLED &&
+    !entry.killIntent &&
+    !entry.killReconciliation,
+  );
+}
+
+function isCronRequesterFailureOutcome(value: unknown): value is CronRequesterFailure["outcome"] {
+  return (
+    isRecord(value) &&
+    (value.error === undefined || typeof value.error === "string") &&
+    (value.disposition === undefined ||
+      (typeof value.disposition === "string" &&
+        [
+          "session_queued",
+          "intentional_non_delivery",
+          "retryable",
+          "ambiguous",
+          "permanent_failure",
+        ].includes(value.disposition))) &&
+    value.delivered === false &&
+    value.path === "none"
+  );
+}
+
+export function getCronRequesterFailureBatch(
+  runs: ReadonlyMap<string, SubagentRunRecord>,
+  anchor: SubagentRunRecord,
+): SubagentRunRecord[] | undefined {
+  const failure = anchor.requesterSettleWake?.cronRequesterFailure;
+  if (
+    !isRecord(failure) ||
+    typeof failure.requesterSessionKey !== "string" ||
+    !isCronSessionKey(failure.requesterSessionKey) ||
+    typeof failure.requesterAgentId !== "string" ||
+    (failure.rearmGeneration !== undefined &&
+      (!Number.isSafeInteger(failure.rearmGeneration) || failure.rearmGeneration < 0)) ||
+    !Array.isArray(failure.children) ||
+    failure.children.length === 0 ||
+    !failure.children.every(
+      (child) =>
+        isRecord(child) &&
+        typeof child.runId === "string" &&
+        typeof child.childSessionKey === "string" &&
+        typeof child.createdAt === "number" &&
+        Number.isFinite(child.createdAt) &&
+        (child.taskRunId === undefined || typeof child.taskRunId === "string") &&
+        (child.generation === undefined ||
+          (typeof child.generation === "number" && Number.isFinite(child.generation))),
+    ) ||
+    !isCronRequesterFailureOutcome(failure.outcome) ||
+    runs.get(anchor.runId) !== anchor
+  ) {
+    return undefined;
+  }
+  const entries: SubagentRunRecord[] = [];
+  for (const child of failure.children) {
+    const entry = runs.get(child.runId);
+    if (
+      !entry ||
+      entry.taskRunId !== child.taskRunId ||
+      entry.childSessionKey !== child.childSessionKey ||
+      entry.generation !== child.generation ||
+      entry.createdAt !== child.createdAt ||
+      entry.requesterSessionKey !== failure.requesterSessionKey ||
+      (entry.requesterAgentId ?? parseAgentSessionKey(entry.requesterSessionKey)?.agentId) !==
+        failure.requesterAgentId ||
+      entry.killReconciliation?.supersededAt !== undefined ||
+      !isDeepStrictEqual(entry.requesterSettleWake?.cronRequesterFailure, failure) ||
+      [...runs.values()].some(
+        (candidate) =>
+          candidate !== entry &&
+          candidate.childSessionKey === entry.childSessionKey &&
+          compareSubagentRunGeneration(candidate, entry) > 0,
+      )
+    ) {
+      return undefined;
+    }
+    entries.push(entry);
+  }
+  const runIds = entries.map((entry) => entry.runId).toSorted();
+  if (
+    !entries.includes(anchor) ||
+    new Set(runIds).size !== entries.length ||
+    entries.some(
+      (entry) =>
+        entry.requesterSettleWake?.requesterYieldBatch !== true ||
+        entry.requesterSettleWake.rearmGeneration !== failure.rearmGeneration ||
+        !isDeepStrictEqual(entry.requesterSettleWake.batchRunIds, runIds),
+    )
+  ) {
+    return undefined;
+  }
+  return entries;
+}
diff --git a/src/agents/subagents/registry/subagent-registry-cron-yield.test.ts b/src/agents/subagents/registry/subagent-registry-cron-yield.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6a164797be9dcddbe03461e1cd3ddf576411012b
--- /dev/null
+++ b/src/agents/subagents/registry/subagent-registry-cron-yield.test.ts
@@ -0,0 +1,252 @@
+/** Native SQLite publication and cancellation preserve the captured cron batch. */
+import { expect, it, vi } from "vitest";
+import { getRuntimeConfig } from "../../../config/config.js";
+import { findTaskByRunId } from "../../../tasks/task-registry.js";
+import * as control from "./subagent-control.js";
+import { killAllControlledSubagentRuns, resolveSubagentController } from "./subagent-control.js";
+import { useSubagentControlFixture } from "./subagent-control.test-support.js";
+import { getCronRequesterFailureBatch } from "./subagent-registry-cron-yield-failure.js";
+import { PROVISIONAL_KILL_RECONCILIATION_MS } from "./subagent-registry-helpers.js";
+import { subagentRuns } from "./subagent-registry-memory.js";
+import { persistSubagentRunsToDiskOrThrow } from "./subagent-registry-state.js";
+import {
+  claimCronRequesterYieldBatch,
+  registerSubagentRun,
+  replaceSubagentRunAfterSteerCore,
+  resumeSubagentRun,
+} from "./subagent-registry.js";
+import { writeSubagentSessionEntry } from "./subagent-registry.persistence.test-support.js";
+import { loadSubagentRegistryFromSqlite } from "./subagent-registry.store.sqlite.js";
+import { testing } from "./subagent-registry.test-helpers.js";
+
+const fixture = useSubagentControlFixture();
+const requester = "agent:main:cron:job:run:parent";
+async function createBatch() {
+  const childSessionKey = "agent:main:subagent:cron-child";
+  await writeSubagentSessionEntry({
+    stateDir: fixture.stateDir,
+    agentId: "main",
+    sessionKey: childSessionKey,
+    defaultSessionId: "cron-child-session",
+  });
+  registerSubagentRun({
+    runId: "child",
+    childSessionKey,
+    requesterSessionKey: requester,
+    requesterAgentId: "main",
+    requesterDisplayKey: requester,
+    task: "Read the requested source",
+    cleanup: "keep",
+    expectsCompletionMessage: true,
+  });
+  const entry = subagentRuns.get("child")!;
+  entry.requesterSettleWake = {
+    status: "pending",
+    attemptCount: 0,
+    requesterYieldBatch: true,
+    batchRunIds: [entry.runId],
+    rearmGeneration: 1,
+  };
+  persistSubagentRunsToDiskOrThrow(subagentRuns, [entry.runId]);
+  const accepted = {
+    requesterSessionKey: requester,
+    requesterAgentId: "main",
+    acceptedSessionSpawns: [
+      { runId: entry.runId, childSessionKey, expectsCompletionMessage: true },
+    ],
+  };
+  const batch = claimCronRequesterYieldBatch(accepted);
+  return { entry, batch, accepted };
+}
+
+it.each(["continuation", "operator steer", "rearm before continuation"] as const)(
+  "follows only the native committed requester continuation: %s",
+  async (boundary) => {
+    const { entry, batch } = await createBatch();
+    try {
+      if (boundary === "rearm before continuation") {
+        entry.requesterSettleWake!.rearmGeneration = 2;
+        persistSubagentRunsToDiskOrThrow(subagentRuns, [entry.runId]);
+      }
+      expect(
+        replaceSubagentRunAfterSteerCore({
+          previousRunId: entry.runId,
+          nextRunId: "successor",
+          expected: entry,
+          preserveRequesterSettleWake: boundary !== "operator steer",
+          persistenceFailure: "throw",
+        }),
+      ).toBe(true);
+      const successor = subagentRuns.get("successor")!;
+      expect(loadSubagentRegistryFromSqlite().get("successor")?.generation).toBe(
+        successor.generation,
+      );
+      expect(findTaskByRunId(entry.runId)?.detail).toMatchObject({
+        generation: successor.generation,
+      });
+      if (boundary === "continuation") {
+        expect(batch.resolveChildren()).toEqual([
+          {
+            runId: "successor",
+            childSessionKey: entry.childSessionKey,
+            expectsCompletionMessage: true,
+          },
+        ]);
+        batch.assertCurrent();
+      } else {
+        expect(() => batch.resolveChildren()).toThrow("ownership changed");
+      }
+    } finally {
+      batch.release();
+    }
+  },
+);
+
+it.each(["unchanged", "same-row rearm", "committed successor"] as const)(
+  "rechecks the captured parent after asynchronous beforeKill: %s",
+  async (boundary) => {
+    const { entry, batch } = await createBatch();
+    const cfg = getRuntimeConfig();
+    let crossedAwait = false;
+    try {
+      const pending = killAllControlledSubagentRuns({
+        cfg,
+        controller: resolveSubagentController({ cfg, agentSessionKey: requester, agentId: "main" }),
+        runs: [entry],
+        assertCurrent: () => batch.assertCurrent(),
+        suppressTaskDelivery: true,
+        beforeKill: async () => {
+          await Promise.resolve();
+          crossedAwait = true;
+          if (boundary === "same-row rearm") {
+            entry.requesterSettleWake!.rearmGeneration = 2;
+          }
+          if (boundary === "committed successor") {
+            expect(
+              replaceSubagentRunAfterSteerCore({
+                previousRunId: entry.runId,
+                nextRunId: "successor",
+                expected: entry,
+                persistenceFailure: "throw",
+              }),
+            ).toBe(true);
+          }
+          return true;
+        },
+      });
+      const result = await pending.catch((error: unknown) => ({
+        status: "error",
+        killed: 0,
+        error,
+      }));
+      expect(crossedAwait).toBe(true);
+      expect(result.killed).toBe(boundary === "unchanged" ? 1 : 0);
+      if (boundary !== "unchanged") {
+        expect(findTaskByRunId(entry.runId)?.status).toBe("running");
+        expect(
+          subagentRuns.get(boundary === "committed successor" ? "successor" : "child")?.killIntent,
+        ).toBeUndefined();
+      }
+    } finally {
+      batch.release();
+    }
+  },
+);
+
+it("restores persisted failed-parent cancellation before any kill intent and finishes native reconciliation", async () => {
+  const { entry, batch } = await createBatch();
+  const stopBeforeKill = vi
+    .spyOn(control, "killAllControlledSubagentRuns")
+    .mockRejectedValueOnce(new Error("interrupted before kill"));
+  await expect(
+    batch.abandon({
+      delivered: false,
+      path: "none",
+      disposition: "ambiguous",
+      error: "Actual parent failure",
+    }),
+  ).rejects.toThrow("interrupted before kill");
+  batch.release();
+  stopBeforeKill.mockRestore();
+  const restored = loadSubagentRegistryFromSqlite().get(entry.runId)!;
+  expect(restored).not.toBe(entry);
+  expect(restored.killIntent).toBeUndefined();
+  expect(restored.killReconciliation).toBeUndefined();
+  subagentRuns.set(restored.runId, restored);
+  expect(getCronRequesterFailureBatch(subagentRuns, restored)).toEqual([restored]);
+  resumeSubagentRun(restored.runId, "restore");
+  await vi.waitFor(() => expect(findTaskByRunId(restored.runId)?.status).toBe("cancelled"));
+  const killedAt = restored.killReconciliation!.killedAt;
+  vi.spyOn(Date, "now").mockReturnValue(killedAt + PROVISIONAL_KILL_RECONCILIATION_MS + 1);
+  await testing.sweepOnceForTests();
+  await vi.waitFor(() =>
+    expect(subagentRuns.get(restored.runId)?.requesterSettleWake).toBeUndefined(),
+  );
+  expect(loadSubagentRegistryFromSqlite().get(restored.runId)?.requesterSettleWake).toBeUndefined();
+  expect(findTaskByRunId(restored.runId)?.deliveryStatus).toBe("not_applicable");
+  expect(fixture.gateway.mock.calls.every(([request]) => request.method === "agent.wait")).toBe(
+    true,
+  );
+});
+
+it.each([
+  undefined,
+  null,
+  {},
+  { children: null },
+  { children: [null] },
+  { children: [], outcome: null },
+  "matching malformed generation",
+])(
+  "does not treat malformed persisted optional failure metadata as cancellation authority: %j",
+  async (malformed) => {
+    const { entry, batch } = await createBatch();
+    try {
+      entry.requesterSettleWake!.cronRequesterFailure =
+        malformed === "matching malformed generation"
+          ? {
+              requesterSessionKey: requester,
+              requesterAgentId: "main",
+              rearmGeneration: "1" as never,
+              children: [
+                {
+                  runId: entry.runId,
+                  taskRunId: entry.taskRunId,
+                  childSessionKey: entry.childSessionKey,
+                  generation: entry.generation,
+                  createdAt: entry.createdAt,
+                },
+              ],
+              outcome: { delivered: false, path: "none", error: "Actual failure" },
+            }
+          : (malformed as never);
+      if (malformed === "matching malformed generation") {
+        entry.requesterSettleWake!.rearmGeneration = "1" as never;
+      }
+      persistSubagentRunsToDiskOrThrow(subagentRuns, [entry.runId]);
+      const restored = loadSubagentRegistryFromSqlite().get(entry.runId)!;
+      subagentRuns.set(restored.runId, restored);
+      expect(getCronRequesterFailureBatch(subagentRuns, restored)).toBeUndefined();
+      expect(findTaskByRunId(restored.runId)?.status).toBe("running");
+    } finally {
+      batch.release();
+    }
+  },
+);
+
+it("retains the captured accepted owner when the caller mutates its result object", async () => {
+  const { batch, accepted, entry } = await createBatch();
+  try {
+    accepted.requesterSessionKey = "agent:main:cron:other:run:other";
+    accepted.acceptedSessionSpawns[0]!.childSessionKey = "agent:main:subagent:other";
+    expect(batch.resolveChildren()).toEqual([
+      {
+        runId: entry.runId,
+        childSessionKey: entry.childSessionKey,
+        expectsCompletionMessage: true,
+      },
+    ]);
+  } finally {
+    batch.release();
+  }
+});
diff --git a/src/agents/subagents/registry/subagent-registry-cron-yield.ts b/src/agents/subagents/registry/subagent-registry-cron-yield.ts
new file mode 100644
index 0000000000000000000000000000000000000000..cf43758b8cd6c3c9319fe6a17d1d974af2445f22
--- /dev/null
+++ b/src/agents/subagents/registry/subagent-registry-cron-yield.ts
@@ -0,0 +1,197 @@
+import { isCronSessionKey } from "../../../routing/session-key.js";
+/** Captures the native child batch owned by one still-admitted cron parent. */
+import type { AcceptedSessionSpawn } from "../../accepted-session-spawn.js";
+import { resolveSubagentRequesterAgentId } from "../../subagent-requester-owner.js";
+import type { SubagentAnnounceDeliveryResult } from "../announce/subagent-announce-dispatch.js";
+import type { SubagentLifecycleWakeContext } from "./subagent-registry-lifecycle-context.js";
+import {
+  completeRequesterSettleWakeBatch,
+  isCurrentRequesterSettleWakeBatch,
+  resumeCronRequesterFailure,
+} from "./subagent-registry-lifecycle-wake.js";
+import { subagentRuns } from "./subagent-registry-memory.js";
+import type { CronRequesterFailure } from "./subagent-registry.types.js";
+
+export type CronRequesterYieldBatch = {
+  children: readonly AcceptedSessionSpawn[];
+  assertCurrent(): void;
+  resolveChildren(): readonly AcceptedSessionSpawn[];
+  release(): void;
+  settle(outcome: SubagentAnnounceDeliveryResult): void;
+  abandon(outcome: SubagentAnnounceDeliveryResult): Promise<void>;
+};
+
+export type ClaimCronRequesterYieldBatchParams = {
+  requesterSessionKey: string;
+  requesterAgentId: string;
+  acceptedSessionSpawns: readonly AcceptedSessionSpawn[];
+};
+
+export function claimCronRequesterYieldBatch(
+  context: SubagentLifecycleWakeContext,
+  params: ClaimCronRequesterYieldBatchParams,
+): CronRequesterYieldBatch {
+  const { requesterSessionKey, requesterAgentId } = params;
+  const children = params.acceptedSessionSpawns
+    .filter((child) => child.expectsCompletionMessage === true)
+    .map(({ runId, childSessionKey }) => ({
+      runId,
+      childSessionKey,
+      expectsCompletionMessage: true,
+    }));
+  if (
+    !isCronSessionKey(requesterSessionKey) ||
+    children.length === 0 ||
+    new Set(children.map((child) => child.runId)).size !== children.length
+  ) {
+    throw new Error("Invalid cron requester yield batch");
+  }
+  const cfg = context.options.getRuntimeConfig();
+  const entries = children.map((child) => {
+    const matches = [...context.options.runs.values()].filter(
+      (entry) =>
+        (entry.runId === child.runId || entry.taskRunId === child.runId) &&
+        entry.childSessionKey === child.childSessionKey &&
+        entry.requesterSessionKey === requesterSessionKey &&
+        resolveSubagentRequesterAgentId(cfg, entry) === requesterAgentId &&
+        entry.expectsCompletionMessage === true,
+    );
+    if (matches.length !== 1) {
+      throw new Error("Cron requester yield child owner is missing or ambiguous");
+    }
+    return matches[0]!;
+  });
+  if (entries.some((entry) => entry.requesterSettleWake?.cronRequesterFailure)) {
+    throw new Error("Cron requester batch already has a failed owner");
+  }
+  const capturedRunIds = entries.map((entry) => entry.runId);
+  const capturedTaskRunIds = entries.map((entry) => entry.taskRunId);
+  const capturedGenerations = entries.map((entry) => entry.generation);
+  const capturedCreatedAt = entries.map((entry) => entry.createdAt);
+  let runIds = capturedRunIds.toSorted();
+  const continuations = entries.map((entry) =>
+    subagentRuns.captureRequesterYieldContinuation(entry),
+  );
+  const release = () => continuations.forEach((scope) => scope.release());
+  const generation = entries[0]?.requesterSettleWake?.rearmGeneration;
+  let settled = false;
+  const assertCurrent = (visibleFinalDelivered = false) => {
+    for (const [index, scope] of continuations.entries()) {
+      const current = scope.observation.entry;
+      if (!current) {
+        release();
+        throw new Error("Cron requester yield continuation ownership changed");
+      }
+      if (current !== entries[index]) {
+        entries[index] = current;
+        capturedRunIds[index] = current.runId;
+        capturedTaskRunIds[index] = current.taskRunId;
+        capturedGenerations[index] = scope.observation.generation;
+        capturedCreatedAt[index] = scope.observation.createdAt;
+      }
+    }
+    runIds = capturedRunIds.toSorted();
+    if (
+      settled ||
+      !isCurrentRequesterSettleWakeBatch(context, entries, generation, visibleFinalDelivered) ||
+      entries.some((entry, index) => {
+        const state = entry.requesterSettleWake;
+        return (
+          entry.runId !== capturedRunIds[index] ||
+          entry.taskRunId !== capturedTaskRunIds[index] ||
+          entry.generation !== capturedGenerations[index] ||
+          entry.createdAt !== capturedCreatedAt[index] ||
+          context.newerGenerationOwnsSession(entry) ||
+          entry.childSessionKey !== children[index]!.childSessionKey ||
+          entry.requesterSessionKey !== requesterSessionKey ||
+          resolveSubagentRequesterAgentId(cfg, entry) !== requesterAgentId ||
+          state?.requesterYieldBatch !== true ||
+          state.batchRunIds?.length !== runIds.length ||
+          !state.batchRunIds.every((runId, i) => runId === runIds[i])
+        );
+      })
+    ) {
+      release();
+      throw new Error("Cron requester yield batch ownership changed");
+    }
+  };

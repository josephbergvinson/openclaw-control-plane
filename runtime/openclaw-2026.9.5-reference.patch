new file mode 100644
index 0000000000000000000000000000000000000000..708e08f9888ebaa25f31c40e232b08451fafc610
--- /dev/null
+++ b/src/auto-reply/reply/agent-runner-yielded-maintenance.test.ts
@@ -0,0 +1,209 @@
+import path from "node:path";
+import { afterEach, expect, it, vi } from "vitest";
+import { createDeferred } from "../../../test/helpers/promise.js";
+import { useAutoCleanupTempDirTracker } from "../../../test/helpers/temp-dir.js";
+import { waitForSessionMaintenance } from "../../agents/session-maintenance/coordinator.js";
+import { loadSessionEntry, replaceSessionEntry } from "../../config/sessions/session-accessor.js";
+import type { InternalSessionEntry } from "../../config/sessions/types.js";
+import { createEmptyPluginRegistry } from "../../plugins/registry-empty.js";
+import { withPluginRuntimeRegistryScope } from "../../plugins/runtime/gateway-request-scope.js";
+import { closeOpenClawAgentDatabasesAsync } from "../../state/openclaw-agent-db.js";
+import type {
+  runMemoryFlushIfNeeded,
+  runSessionCompactionIfNeeded,
+} from "./agent-runner-memory.js";
+import { finalizeReplyAgentRun } from "./agent-runner-result.js";
+import type { FinalizeReplyAgentRunInput } from "./agent-runner-result.types.js";
+import { createReplyOperation, retainReplyOperationUntilComplete } from "./reply-run-registry.js";
+import { createMockFollowupRun, createMockTypingController } from "./test-helpers.js";
+import { createTypingSignaler } from "./typing-mode.js";
+
+const memory = vi.hoisted(() => ({
+  flush: vi.fn<typeof runMemoryFlushIfNeeded>(),
+  compact: vi.fn<typeof runSessionCompactionIfNeeded>(),
+}));
+vi.mock("./agent-runner-memory.js", () => ({
+  runMemoryFlushIfNeeded: memory.flush,
+  runSessionCompactionIfNeeded: memory.compact,
+}));
+const tempDirs = useAutoCleanupTempDirTracker((cleanup) =>
+  afterEach(async () => {
+    for (const dir of tempDirs.dirs) {
+      await closeOpenClawAgentDatabasesAsync(dir);
+    }
+    cleanup();
+  }),
+);
+afterEach(() => vi.clearAllMocks());
+
+async function fixture() {
+  const root = tempDirs.make("reply-yielded-maintenance-");
+  const storePath = path.join(root, "openclaw-agent.sqlite");
+  const sessionKey = "agent:main:yielded-maintenance";
+  const entry: InternalSessionEntry = {
+    sessionId: "yielded-session",
+    lifecycleRevision: "yield-generation",
+    updatedAt: 1,
+    modelProvider: "openai",
+    model: "gpt-6-astra",
+  };
+  await replaceSessionEntry({ storePath, sessionKey }, entry);
+  const cfg = { session: { store: storePath } };
+  const followupRun = createMockFollowupRun({
+    run: {
+      sessionKey,
+      sessionId: entry.sessionId,
+      agentId: "main",
+      agentDir: root,
+      workspaceDir: root,
+      config: cfg,
+      provider: "openai",
+      model: "gpt-6-astra",
+      thinkLevel: "max",
+      timeoutMs: 600_000,
+    },
+  });
+  const operation = createReplyOperation({
+    sessionId: entry.sessionId,
+    sessionKey,
+    resetTriggered: false,
+  });
+  operation.setPhase("running");
+  retainReplyOperationUntilComplete(operation);
+  const context: FinalizeReplyAgentRunInput = {
+    activeIsNewSession: false,
+    activeSessionEntry: entry,
+    activeSessionStore: { [sessionKey]: entry },
+    blockReplyPipeline: null,
+    blockStreamingEnabled: false,
+    cfg,
+    commandBody: "Have a child prepare the result",
+    defaultModel: "gpt-6-astra",
+    followupRun,
+    isHeartbeat: false,
+    pendingToolTasks: new Set(),
+    preflightCompactionApplied: false,
+    queueKey: sessionKey,
+    replyMediaContext: { normalizePayload: async (payload) => payload },
+    replyOperation: operation,
+    replyRouteThreadId: undefined,
+    replyToChannel: undefined,
+    replyToMode: "off",
+    resolvedBlockStreamingBreak: "message_end",
+    resolvedQueue: { mode: "followup" },
+    resolvedVerboseLevel: "off",
+    returnWithQueuedFollowupDrain: (value) => value,
+    runFollowupTurn: async () => {},
+    execution: {
+      kind: "settled",
+      status: "ok",
+      result: {
+        payloads: [],
+        meta: {
+          durationMs: 1,
+          yielded: true,
+          finalAssistantRawText: "NO_REPLY",
+          agentMeta: {
+            sessionId: entry.sessionId,
+            agentHarnessId: "openclaw",
+            provider: "openai",
+            model: "gpt-6-astra",
+          },
+        },
+      },
+      resolved: { provider: "openai", model: "gpt-6-astra" },
+      fallback: { exhausted: false, attempts: [] },
+      maintenanceAuthProfile: {},
+      autoCompactionCount: 0,
+      didLogHeartbeatStrip: false,
+    },
+    runId: "yielded-run",
+    runStartedAt: Date.now(),
+    sessionCtx: {},
+    sessionKey,
+    shouldInjectGroupIntro: false,
+    storePath,
+    typingSignals: createTypingSignaler({
+      typing: createMockTypingController(),
+      mode: "never",
+      isHeartbeat: false,
+    }),
+  };
+  memory.flush.mockImplementation(async (params) => ({
+    sessionEntry: params.sessionEntry,
+    outcome: "completed",
+  }));
+  memory.compact.mockImplementation(async (params) => params.sessionEntry);
+  return { context, operation, sessionKey, storePath };
+}
+
+it.each(["silent yield", "visible yield", "completed reply"] as const)(
+  "schedules %s once only after the actual reply owner settles",
+  async (kind) => {
+    const f = await fixture();
+    const settled = createDeferred();
+    if (kind !== "silent yield") {
+      f.context.execution.result.payloads = [{ text: "The child is preparing the result." }];
+      f.context.execution.result.meta.finalAssistantRawText = undefined;
+    }
+    if (kind === "completed reply") {
+      f.context.execution.result.meta.yielded = undefined;
+    }
+    try {
+      await withPluginRuntimeRegistryScope(createEmptyPluginRegistry(), () =>
+        finalizeReplyAgentRun(f.context),
+      );
+      expect(memory.flush).not.toHaveBeenCalled();
+      f.operation.completeWithAfterClearBarrier(settled.promise, 1);
+      await new Promise((resolve) => {
+        setTimeout(resolve, 5);
+      });
+      expect(memory.flush).not.toHaveBeenCalled();
+      const deliveredEntry = loadSessionEntry({ storePath: f.storePath, sessionKey: f.sessionKey });
+      expect(deliveredEntry).toBeDefined();
+      await replaceSessionEntry(
+        { storePath: f.storePath, sessionKey: f.sessionKey },
+        { ...deliveredEntry!, pendingFinalDelivery: undefined },
+      );
+      settled.resolve();
+      await f.operation.ownerSettlement;
+      await waitForSessionMaintenance(f.sessionKey);
+      expect(memory.flush).toHaveBeenCalledOnce();
+      expect(memory.compact).toHaveBeenCalledOnce();
+      expect(memory.flush.mock.calls[0]?.[0].followupRun.run).toMatchObject({
+        model: "gpt-6-astra",
+        thinkLevel: "max",
+        senderIsOwner: false,
+      });
+    } finally {
+      settled.resolve();
+      f.operation.complete();
+      await waitForSessionMaintenance(f.sessionKey);
+    }
+  },
+);
+
+it("keeps a silent yield behind an existing pending final delivery", async () => {
+  const f = await fixture();
+  await withPluginRuntimeRegistryScope(createEmptyPluginRegistry(), () =>
+    finalizeReplyAgentRun(f.context),
+  );
+  await replaceSessionEntry(
+    { storePath: f.storePath, sessionKey: f.sessionKey },
+    {
+      ...loadSessionEntry({ storePath: f.storePath, sessionKey: f.sessionKey })!,
+      pendingFinalDelivery: {
+        kind: "replayable",
+        text: "An earlier answer is still in delivery",
+        createdAt: Date.now(),
+      },
+    },
+  );
+  f.operation.complete();
+  await f.operation.ownerSettlement;
+  await waitForSessionMaintenance(f.sessionKey);
+  expect(memory.flush).not.toHaveBeenCalled();
+  expect(
+    loadSessionEntry({ storePath: f.storePath, sessionKey: f.sessionKey })?.pendingFinalDelivery,
+  ).toMatchObject({ text: "An earlier answer is still in delivery" });
+});

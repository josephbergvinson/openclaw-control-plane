new file mode 100644
index 0000000000000000000000000000000000000000..4eade86c967d870afd82c52b92bd1fb492a25b08
--- /dev/null
+++ b/src/agents/tools/subagents-tool.retained-result.test.ts
@@ -0,0 +1,120 @@
+import { afterEach, expect, it } from "vitest";
+import { createSubagentTaskBackingDetail } from "../../tasks/task-backing-records.js";
+import { getTaskById, resetTaskRegistryForTests } from "../../tasks/task-registry-query.js";
+import { configureTaskRegistryRuntime } from "../../tasks/task-registry.store.js";
+import type { TaskRecord } from "../../tasks/task-registry.types.js";
+import { createInMemoryTaskRegistryStore } from "../../test-utils/task-registry-store.js";
+import { resetSubagentRegistryForTests } from "../subagents/registry/subagent-registry.test-helpers.js";
+import { createSubagentsTool } from "./subagents-tool.js";
+
+afterEach(() => {
+  resetSubagentRegistryForTests({ persist: false });
+  resetTaskRegistryForTests();
+});
+
+function retainedTask(overrides: Partial<TaskRecord> = {}): TaskRecord {
+  return {
+    taskId: "canonical-child-task",
+    runId: "child-execution-run",
+    runtime: "subagent",
+    ownerKey: "agent:main:main",
+    requesterSessionKey: "agent:main:main",
+    requesterAgentId: "main",
+    childSessionKey: "agent:main:subagent:deleted-child",
+    scopeKind: "session",
+    task: "Prepare three creative examples",
+    status: "succeeded",
+    deliveryStatus: "pending",
+    notifyPolicy: "done_only",
+    createdAt: Date.now() - 1_000,
+    endedAt: Date.now(),
+    progressSummary: "Three retained examples, including the concrete production directions.",
+    detail: createSubagentTaskBackingDetail(1),
+    ...overrides,
+  };
+}
+
+it("returns the exact retained terminal result to a later steering turn after child cleanup", async () => {
+  const selected = retainedTask();
+  configureTaskRegistryRuntime({
+    store: createInMemoryTaskRegistryStore({
+      tasks: new Map([[selected.taskId, selected]]),
+      deliveryStates: new Map(),
+    }),
+  });
+  const tool = createSubagentsTool({
+    agentSessionKey: selected.ownerKey,
+    config: {},
+  });
+  const listed = await tool.execute("discover", { action: "list" });
+  expect.soft(listed.details).toMatchObject({
+    tasks: [
+      { taskId: selected.taskId, runId: selected.runId, childSessionKey: selected.childSessionKey },
+    ],
+  });
+  const result = await tool.execute("read-result", {
+    action: "wait",
+    taskIds: [selected.taskId],
+    timeoutSeconds: 0,
+  });
+  expect(result.details).toMatchObject({
+    reason: "completed",
+    completed: [selected.taskId],
+    tasks: [{ taskId: selected.taskId, progressSummary: selected.progressSummary }],
+  });
+  expect(getTaskById(selected.taskId)?.deliveryStatus).toBe("pending");
+});
+
+it("does not turn a retained terminal child into authority over its later descendants", async () => {
+  const selected = retainedTask();
+  const descendant = retainedTask({
+    taskId: "later-private-task",
+    runtime: "cli",
+    ownerKey: selected.childSessionKey!,
+    requesterSessionKey: selected.childSessionKey!,
+    childSessionKey: undefined,
+    progressSummary: "PRIVATE_RESULT",
+  });
+  const tool = createSubagentsTool({
+    agentSessionKey: selected.ownerKey,
+    config: {},
+    listTasks: () => [selected, descendant],
+  });
+  const result = await tool.execute("read-descendant", {
+    action: "wait",
+    taskIds: [descendant.taskId],
+    timeoutSeconds: 0,
+  });
+  expect(result.details).toMatchObject({
+    reason: "unavailable",
+    tasks: [],
+    unavailable: [descendant.taskId],
+  });
+  expect(JSON.stringify(result.details)).not.toContain("PRIVATE_RESULT");
+});
+
+it.each(["wrong owner", "wrong agent", "still running"])(
+  "does not read an unowned retained result: %s",
+  async (condition) => {
+    const selected = retainedTask({

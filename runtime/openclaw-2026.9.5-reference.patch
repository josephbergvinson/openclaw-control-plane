+            deliver: hookMode !== "undelivered",
+            channel: "discord",
+            to: "channel:source",
+            accountId: "work",
+            threadId: "thread-source",
+            ...(hookMode === "internal" ? { sessionEffects: "internal" } : {}),
+            ...(hookMode === "heartbeat" ? { bootstrapContextRunKind: "heartbeat" } : {}),
+            ...(hookMode === "tool_only" ? { sourceReplyDeliveryMode: "message_tool_only" } : {}),
+            ...(hookMode === "ordinary"
+              ? {}
+              : {
+                  inputProvenance: {
+                    kind: "inter_session",
+                    sourceChannel: "internal",
+                    sourceTool: "subagent_settle",
+                  },
+                }),
+          },
+          runtime,
+        );
+        await getLastEmbeddedCall()?.onAgentEvent?.({
+          stream: "item",
+          data: {
+            kind: "preamble",
+            itemId: "late-commentary",
+            phase: "end",
+            progressText: "Late callback.",
+          },
+        });
+        expect(hook).toHaveBeenCalledTimes(visible ? 1 : 0);
+        expect(clearTyping).toHaveBeenCalledTimes(typingVisible ? 1 : 0);
+        expect(deliverAgentCommandResult).toHaveBeenCalledTimes(1);
+        expect(vi.mocked(deliverAgentCommandResult).mock.calls[0]?.[0].payloads).toEqual([
+          { text: "Calendar checked." },
+        ]);
+      });
+    },
+  );
+
+  it.each([
+    { mode: "instant", activity: "none", direct: false },
+    { mode: "never", activity: "text", direct: false },
+    { mode: "message", activity: "none", direct: false },
+    { mode: "message", activity: "text", direct: false },
+    { mode: "thinking", activity: "none", direct: false },
+    { mode: "thinking", activity: "reasoning", direct: false },
+    { mode: undefined, activity: "none", direct: false },
+    { mode: undefined, activity: "execution", direct: false },
+    { mode: undefined, activity: "none", direct: true },
+  ] as const)(
+    "respects continuation typing mode $mode with $activity activity (direct=$direct)",
+    async ({ mode, activity, direct }) => {
+      await withTempHome(async (home) => {
+        const cfg = mockConfig(home, path.join(home, "sessions.json"), { typingMode: mode });
+        cfg.channels = { discord: { streaming: { mode: "off" } } };
+        const sendText = vi.fn(async () => ({ channel: "discord", messageId: "unused" }));
+        const sendTyping = vi.fn(async () => {});
+        const clearTyping = vi.fn(async () => {});
+        const plugin = createOutboundTestPlugin({
+          id: "discord",
+          outbound: { ...createDirectOutboundTestAdapter({ channel: "discord" }), sendText },
+        });
+        plugin.heartbeat = { sendTyping, clearTyping };
+        installThinkingTestProviders([{ pluginId: "discord", source: "test", plugin }]);
+        const immediate = mode === "instant" || (mode === undefined && direct);
+        const active = mode !== "never" && (immediate || activity !== "none");
+        vi.mocked(runEmbeddedAgent).mockImplementationOnce(async (params) => {
+          await params.onAgentEvent?.({ stream: "lifecycle", data: { phase: "start" } });
+          params.onExecutionPhase?.({ phase: "context_assembled" });
+          await params.onAgentEvent?.({ stream: "assistant", data: { text: "NO_REPLY" } });
+          await params.onAgentEvent?.({
+            stream: "item",
+            data: { kind: "preamble", phase: "update", progressText: "Hidden commentary." },
+          });
+          expect(sendTyping).toHaveBeenCalledTimes(immediate ? 1 : 0);
+          if (activity === "text") {
+            await params.onReasoningStream?.({ text: "Reasoning alone is not a message." });
+            expect(sendTyping).toHaveBeenCalledTimes(immediate ? 1 : 0);
+            await params.onAgentEvent?.({
+              stream: "assistant",
+              data: { text: "Calendar checked." },
+            });
+          } else if (activity === "reasoning") {
+            await params.onReasoningStream?.({ text: "Checking the calendar source." });
+          } else if (activity === "execution") {
+            params.onExecutionPhase?.({ phase: "model_call_started" });
+          }
+          expect(sendTyping).toHaveBeenCalledTimes(active ? 1 : 0);
+          expect(sendText).not.toHaveBeenCalled();
+          return createDefaultAgentResult({ payloads: [{ text: "Calendar checked." }] }) as never;
+        });
+        await agentCommand(
+          {

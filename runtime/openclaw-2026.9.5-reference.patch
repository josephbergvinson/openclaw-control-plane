diff --git a/src/agents/model-fallback.quota-continuation.e2e.test.ts b/src/agents/model-fallback.quota-continuation.e2e.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5e78613bc863e37b279090b13c17faa28e5b91f5
--- /dev/null
+++ b/src/agents/model-fallback.quota-continuation.e2e.test.ts
@@ -0,0 +1,186 @@
+// Keeps committed work on the same transcript while rotating authorized quota-limited accounts.
+import fs from "node:fs/promises";
+import path from "node:path";
+import { beforeAll, beforeEach, describe, expect, it, vi } from "vitest";
+import { wrapRunWithTestPreparedAdmission } from "./admitted-run-context.test-support.js";
+import { ensureAuthProfileStore, saveAuthProfileStore } from "./auth-profiles/store-runtime.js";
+import type {
+  EmbeddedRunAttemptParams,
+  EmbeddedRunAttemptResult,
+} from "./embedded-agent-runner/run/types.js";
+import { resetFallbackSkipCacheForTest } from "./fallback-skip-cache.test-support.js";
+import { installRunEmbeddedMocks } from "./model-fallback.run-embedded.e2e.test-fixtures.js";
+import {
+  makeModelFallbackConfig,
+  withModelFallbackWorkspace,
+  writeFallbackMultiProfileAuthStore,
+} from "./model-fallback.run-embedded.e2e.test-support.js";
+import {
+  buildEmbeddedRunnerAssistant,
+  makeEmbeddedRunnerAttempt,
+} from "./test-helpers/embedded-agent-runner-e2e-fixtures.js";
+
+const runEmbeddedAttemptMock = vi.fn<(params: unknown) => Promise<EmbeddedRunAttemptResult>>();
+const suspendSessionMock = vi.hoisted(() => vi.fn().mockResolvedValue(undefined));
+const { computeBackoffMock, sleepWithAbortMock } = vi.hoisted(() => ({
+  computeBackoffMock: vi.fn(() => 321),
+  sleepWithAbortMock: vi.fn(async (_ms: number, _abortSignal?: AbortSignal) => undefined),
+}));
+vi.mock("./models-config.js", () => ({
+  ensureOpenClawModelsJson: vi.fn(async () => ({ wrote: false })),
+}));
+
+type ProductionRunEmbeddedAgent = typeof import("./embedded-agent-runner/run.js").runEmbeddedAgent;
+let runEmbeddedAgent: (
+  params: Omit<Parameters<ProductionRunEmbeddedAgent>[0], "admittedRunContext">,
+) => ReturnType<ProductionRunEmbeddedAgent>;
+type EmbeddedAttemptParams = EmbeddedRunAttemptParams;
+
+beforeAll(async () => {
+  installRunEmbeddedMocks({
+    runEmbeddedAttemptMock,
+    suspendSessionMock,
+    computeBackoffMock,
+    sleepWithAbortMock,
+  });
+  runEmbeddedAgent = wrapRunWithTestPreparedAdmission(
+    (await import("./embedded-agent-runner/run.js")).runEmbeddedAgent,
+  );
+});
+
+beforeEach(() => {
+  resetFallbackSkipCacheForTest();
+  runEmbeddedAttemptMock.mockReset();
+  suspendSessionMock.mockClear();
+  computeBackoffMock.mockClear();
+  sleepWithAbortMock.mockClear();
+});
+
+describe("quota continuation through the embedded runner", () => {
+  it.each([
+    "backup succeeds",
+    "profiles exhausted",
+    "user pinned",
+    "remaining profiles cooling down",
+    "prompt failures exhaust",
+  ])("continues quota-limited work after one committed mutation: %s", async (outcome) => {
+    await withModelFallbackWorkspace(async ({ agentDir, workspaceDir }) => {
+      await writeFallbackMultiProfileAuthStore(agentDir, { openAiProfileCount: 3 });
+      if (outcome === "remaining profiles cooling down") {
+        const store = ensureAuthProfileStore(agentDir, { syncExternalCli: false });
+        for (const profileId of ["openai:p2", "openai:p3"]) {
+          store.usageStats ??= {};
+          store.usageStats[profileId] = {
+            disabledUntil: Date.now() + 60_000,
+            disabledReason: "rate_limit",
+          };
+        }
+        saveAuthProfileStore(store, agentDir);
+      }
+      const artifact = path.join(workspaceDir, "committed-operation.txt");
+      let writes = 0;
+      const toolCall = buildEmbeddedRunnerAssistant({
+        stopReason: "toolUse",
+        content: [{ type: "toolCall", id: "one-write", name: "write", arguments: {} }],
+      });
+      runEmbeddedAttemptMock.mockImplementation(async (params) => {
+        const attempt = params as EmbeddedAttemptParams;
+        const first = runEmbeddedAttemptMock.mock.calls.length === 1;
+        if (first) {
+          expect(attempt.prompt).toBe("Apply exactly one mutation, then report.");
+          await fs.appendFile(artifact, "committed once\n");
+          writes += 1;
+        } else {
+          expect(attempt.prompt).toContain(
+            "Continue the current task from the existing transcript",
+          );
+          expect(attempt.suppressNextUserMessagePersistence).toBe(true);
+          expect(await fs.readFile(artifact, "utf8")).toBe("committed once\n");
+        }
+        expect(attempt.provider).toBe("openai");
+        expect(attempt.modelId).toBe("mock-1");
+        const success = outcome === "backup succeeds" && attempt.authProfileId === "openai:p3";
+        const promptFailure = outcome === "prompt failures exhaust" && !first;
+        const assistant = buildEmbeddedRunnerAssistant({
+          stopReason: success ? "stop" : "error",
+          content: success ? [{ type: "text", text: "Verified one committed mutation." }] : [],
+          errorMessage: success ? undefined : "Codex error: The usage limit has been reached",
+        });
+        return makeEmbeddedRunnerAttempt({
+          sessionIdUsed: attempt.sessionId,
+          assistantTexts: success ? ["Verified one committed mutation."] : [],
+          lastAssistant: assistant,
+          currentAttemptAssistant: promptFailure ? undefined : assistant,
+          ...(promptFailure
+            ? {
+                terminal: {
+                  kind: "failed" as const,
+                  source: "prompt" as const,
+                  error: new Error("Codex error: The usage limit has been reached"),
+                },
+              }
+            : {}),
+          messagesSnapshot: [
+            { role: "user", content: "Apply exactly one mutation, then report.", timestamp: 1 },
+            toolCall,
+            {
+              role: "toolResult",
+              toolCallId: "one-write",
+              toolName: "write",
+              isError: false,
+              content: [{ type: "text", text: "committed once" }],
+              timestamp: 2,
+            },
+            assistant,
+          ],
+          toolMetas: first
+            ? [{ toolCallId: "one-write", toolName: "write", replaySafe: false, isError: false }]
+            : [],
+          itemLifecycle: first
+            ? { startedCount: 1, completedCount: 1, activeCount: 0 }
+            : { startedCount: 0, completedCount: 0, activeCount: 0 },
+          replayMetadata: { hadPotentialSideEffects: true, replaySafe: false },
+          currentAttemptReplayMetadata: { hadPotentialSideEffects: first, replaySafe: !first },
+        });
+      });
+      const result = await runEmbeddedAgent({
+        sessionId: `quota-${outcome}`,
+        sessionKey: `agent:test:quota-${outcome}`,
+        workspaceDir,
+        agentDir,
+        config: makeModelFallbackConfig(),
+        prompt: "Apply exactly one mutation, then report.",
+        provider: "openai",
+        model: "mock-1",
+        authProfileId: "openai:p1",
+        authProfileIdSource: outcome === "user pinned" ? "user" : "auto",
+        timeoutMs: 5000,
+        runId: `run:quota-${outcome}`,
+        enqueue: async (task) => task(),
+      });
+      expect(writes).toBe(1);
+      expect(await fs.readFile(artifact, "utf8")).toBe("committed once\n");
+      expect(
+        runEmbeddedAttemptMock.mock.calls.map(
+          ([params]) => (params as EmbeddedAttemptParams).authProfileId,
+        ),
+      ).toEqual(
+        outcome === "user pinned" || outcome === "remaining profiles cooling down"
+          ? ["openai:p1"]
+          : ["openai:p1", "openai:p2", "openai:p3"],
+      );
+      expect(result.meta.replayInvalid).toBe(true);
+      if (outcome === "backup succeeds") {
+        expect(result.payloads?.[0]?.text).toBe("Verified one committed mutation.");
+        expect(result.meta.error).toBeUndefined();
+      } else {
+        expect(result.payloads).toContainEqual(
+          expect.objectContaining({
+            isError: true,
+            text: "Agent couldn't generate a response. Note: some tool actions may have already been executed — please verify before retrying.",
+          }),
+        );
+      }
+    });
+  });
+});

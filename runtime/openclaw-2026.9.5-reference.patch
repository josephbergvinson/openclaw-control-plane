new file mode 100644
index 0000000000000000000000000000000000000000..577883b4573de2ceec591a9a8dabf01c2e47a09a
--- /dev/null
+++ b/extensions/codex/src/app-server/dynamic-tool-session-spawns.ts
@@ -0,0 +1,49 @@
+import {
+  asOptionalRecord,
+  normalizeOptionalString,
+} from "openclaw/plugin-sdk/string-coerce-runtime";
+
+function normalizeAcceptedSessionSpawn(result: unknown): {
+  runId: string;
+  childSessionKey: string;
+  expectsCompletionMessage?: boolean;
+} | null {
+  const details = asOptionalRecord(asOptionalRecord(result)?.details);
+  if (!details || details.status !== "accepted") {
+    return null;
+  }
+  const runId =
+    normalizeOptionalString(details.completionRunId) ?? normalizeOptionalString(details.runId);
+  const childSessionKey = normalizeOptionalString(details.childSessionKey);
+  return runId && childSessionKey
+    ? {
+        runId,
+        childSessionKey,
+        ...(details.expectsCompletionMessage === true ? { expectsCompletionMessage: true } : {}),
+      }
+    : null;
+}
+
+export function normalizeAcceptedSessionSpawnResults(
+  result: unknown,
+  includeCompletionSpawns: boolean,
+) {
+  const primary = normalizeAcceptedSessionSpawn(result);
+  if (!primary) {
+    return [];
+  }
+  if (!includeCompletionSpawns || primary.expectsCompletionMessage !== true) {
+    return [primary];
+  }
+  const details = asOptionalRecord(asOptionalRecord(result)?.details);
+  const completions = new Map([[primary.runId, primary]]);
+  for (const raw of Array.isArray(details?.completionSpawns) ? details.completionSpawns : []) {
+    const member = normalizeAcceptedSessionSpawn({
+      details: { ...asOptionalRecord(raw), status: "accepted" },
+    });
+    if (member?.expectsCompletionMessage === true && !completions.has(member.runId)) {
+      completions.set(member.runId, member);
+    }
+  }
+  return [...completions.values()];
+}

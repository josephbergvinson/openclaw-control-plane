index 0000000000000000000000000000000000000000..35f3d7aa01c689eaf554a2db84b800185ebe4890
--- /dev/null
+++ b/src/agents/compaction-summary-planning.ts
@@ -0,0 +1,32 @@
+import {
+  CHARS_PER_TOKEN_ESTIMATE,
+  estimateStringChars,
+} from "@openclaw/normalization-core/cjk-chars";
+import { serializeConversation } from "../../packages/agent-core/src/harness/compaction/utils.js";
+import { convertToLlm } from "../../packages/agent-core/src/harness/messages.js";
+import type { AgentMessage } from "./runtime/index.js";
+
+/** Charge the existing summary projection, without changing persisted or replay messages. */
+export function estimateSummaryMessageTokens(messages: AgentMessage[]): number[] {
+  return messages.map((message) => {
+    const text = serializeConversation(convertToLlm([message]));
+    // Per-message serialization conservatively retains every omission notice.
+    // The joining delimiter is charged even to the last nonempty message.
+    return text ? Math.ceil(estimateStringChars(`${text}\n\n`) / CHARS_PER_TOKEN_ESTIMATE) : 0;
+  });
+}
+
+/** Scalar estimates cross the worker boundary alongside the corresponding message indexes. */
+export function validateMessageTokenEstimates(
+  messages: AgentMessage[],
+  estimates: readonly number[],
+): void {
+  if (!Array.isArray(estimates) || estimates.length !== messages.length) {
+    throw new Error("compaction planning token estimates must match every message");
+  }
+  for (const value of estimates) {
+    if (!Number.isSafeInteger(value) || value < 0) {
+      throw new Error("compaction planning token estimates must match every message");
+    }
+  }
+}
diff --git a/src/agents/compaction.stage-concurrency.test.ts b/src/agents/compaction.stage-concurrency.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..766748fb915f92dece93a4b45f34dabcbabcaa61
--- /dev/null
+++ b/src/agents/compaction.stage-concurrency.test.ts
@@ -0,0 +1,345 @@
+import type { StreamFn } from "openclaw/plugin-sdk/agent-core";
+import { createAssistantMessageEventStream, type Model } from "openclaw/plugin-sdk/llm";
+import { describe, expect, it, vi } from "vitest";
+import { summarizeInStages } from "./compaction.js";
+import { makeAgentAssistantMessage } from "./test-helpers/agent-message-fixtures.js";
+
+// Keep the real summary generator and stream composition without importing the
+// unrelated session lifecycle exported by this compatibility barrel.
+vi.mock("./sessions/index.js", async () => {
+  const { generateSummary } = await import("./sessions/compaction/compaction.js");
+  return { generateSummary };
+});
+
+const model: Model = {
+  id: "summary-model",
+  name: "Summary model",
+  api: "openai-chatgpt-responses",
+  provider: "openai",
+  baseUrl: "https://example.test",
+  reasoning: true,
+  input: ["text"],
+  cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+  contextWindow: 200_000,
+  maxTokens: 16_384,
+};
+
+function controlledSummary() {
+  const calls: Array<{
+    prompt: string;
+    signal: AbortSignal;
+    complete: (summary: string) => void;
+    fail: (message?: string) => void;
+    cancelWhenAborted: () => void;
+  }> = [];
+  const controller = new AbortController();
+  const streamFn: StreamFn = (selected, context, options) => {
+    expect(selected).toBe(model);
+    const signal = options?.signal;
+    if (!signal) {
+      throw new Error("Expected a compaction cancellation signal");
+    }
+    expect(options?.reasoning).toBe("max");
+    const stream = createAssistantMessageEventStream();
+    calls.push({
+      prompt: JSON.stringify(context),
+      signal,
+      complete(summary) {
+        stream.push({
+          type: "done",
+          reason: "stop",
+          message: makeAgentAssistantMessage({ content: [{ type: "text", text: summary }] }),
+        });
+        stream.end();
+      },
+      fail(message = "request timed out") {
+        stream.push({
+          type: "error",
+          reason: "error",
+          error: makeAgentAssistantMessage({
+            content: [],
+            stopReason: "error",
+            errorMessage: message,
+          }),
+        });
+        stream.end();
+      },
+      cancelWhenAborted() {
+        const cancel = () => {
+          stream.push({
+            type: "error",
+            reason: "aborted",
+            error: makeAgentAssistantMessage({
+              content: [],
+              stopReason: "aborted",
+              errorMessage: "peer request aborted",
+            }),
+          });
+          stream.end();
+        };
+        if (signal.aborted) {
+          cancel();
+        } else {
+          signal.addEventListener("abort", cancel, { once: true });
+        }
+      },
+    });
+    return stream;
+  };
+  const messages = Array.from({ length: 4 }, (_, index) => ({
+    role: "user" as const,
+    content: `stage_${index + 1}: ${"x".repeat(500)}`,
+    timestamp: index + 1,
+  }));
+  const original = JSON.stringify(messages);
+  const operation = summarizeInStages({
+    messages,
+    model,
+    apiKey: "test-key",
+    signal: controller.signal,
+    reserveTokens: 1_000,
+    maxChunkTokens: 200,
+    contextWindow: 200_000,
+    parts: 4,
+    thinkingLevel: "max",
+    streamFn,
+  });
+  // Attach immediately so the failure and abort cases cannot leak a rejection.
+  const settled = operation.then(
+    (value) => ({ status: "fulfilled" as const, value }),
+    (reason: unknown) => ({ status: "rejected" as const, reason }),
+  );
+  function call(index: number) {
+    const selected = calls[index];
+    if (!selected) {
+      throw new Error(`Expected accepted summary call ${index}`);
+    }
+    return selected;
+  }
+  return { calls, call, controller, messages, original, operation, settled };
+}
+
+describe("independent compaction summary stages", () => {
+  it("measures the five-call history path with the same provider work", async () => {
+    let calls = 0;
+    let active = 0;
+    let maxActive = 0;
+    const streamFn: StreamFn = () => {
+      const stream = createAssistantMessageEventStream();
+      const call = ++calls;
+      active += 1;
+      maxActive = Math.max(maxActive, active);
+      setTimeout(() => {
+        active -= 1;
+        stream.push({
+          type: "done",
+          reason: "stop",
+          message: makeAgentAssistantMessage({
+            content: [{ type: "text", text: `summary_${call}` }],
+          }),
+        });
+        stream.end();
+      }, 100);
+      return stream;
+    };
+    const started = performance.now();
+    await summarizeInStages({
+      messages: Array.from({ length: 4 }, (_, index) => ({
+        role: "user" as const,
+        content: "x".repeat(32_800),
+        timestamp: index + 1,
+      })),
+      model,
+      apiKey: "test-key",
+      signal: new AbortController().signal,
+      reserveTokens: 1_000,
+      maxChunkTokens: 18_000,
+      contextWindow: 200_000,
+      thinkingLevel: "max",
+      streamFn,
+    });
+    console.info(
+      JSON.stringify({
+        historyProviderCalls: calls,
+        maxActive,
+        elapsedMs: performance.now() - started,
+      }),
+    );
+    expect(calls).toBe(5);
+    expect(active).toBe(0);
+  });
+
+  it("runs at most two stages together and merges in transcript order", async () => {
+    const fixture = controlledSummary();
+    try {
+      await expect.poll(() => fixture.calls.length, { timeout: 2_000 }).toBe(2);
+      expect(fixture.calls[0]?.prompt).toContain("stage_1:");
+      expect(fixture.calls[1]?.prompt).toContain("stage_2:");
+      fixture.call(1).complete("second stage");
+      await new Promise((resolve) => {
+        setImmediate(resolve);
+      });
+      expect(fixture.calls).toHaveLength(2);
+      fixture.call(0).complete("first stage");
+      await expect.poll(() => fixture.calls.length).toBe(4);
+      fixture.call(3).complete("fourth stage");
+      fixture.call(2).complete("third stage");
+      await expect.poll(() => fixture.calls.length).toBe(5);
+      const merge = fixture.call(4);
+      expect(merge.prompt.indexOf("first stage")).toBeLessThan(
+        merge.prompt.indexOf("second stage"),
+      );
+      expect(merge.prompt.indexOf("second stage")).toBeLessThan(
+        merge.prompt.indexOf("third stage"),
+      );
+      expect(merge.prompt.indexOf("third stage")).toBeLessThan(
+        merge.prompt.indexOf("fourth stage"),
+      );
+      merge.complete("all stages merged");
+      await expect(fixture.operation).resolves.toBe("all stages merged");
+      expect(JSON.stringify(fixture.messages)).toBe(fixture.original);
+    } finally {
+      fixture.controller.abort();
+      for (const call of fixture.calls) {
+        call.complete("cleanup");
+      }
+      await fixture.settled;
+    }
+  });
+
+  it("settles an accepted peer before surfacing failure without starting later stages", async () => {
+    const fixture = controlledSummary();
+    let returned = false;
+    void fixture.settled.then(() => {
+      returned = true;
+    });
+    try {
+      await expect.poll(() => fixture.calls.length, { timeout: 2_000 }).toBe(2);
+      fixture.call(0).fail();
+      await new Promise((resolve) => {
+        setImmediate(resolve);
+      });
+      expect(returned).toBe(false);
+      expect(fixture.call(1).signal.aborted).toBe(true);
+      expect(fixture.controller.signal.aborted).toBe(false);
+      expect(fixture.calls).toHaveLength(2);
+      fixture.call(1).complete("completed peer");
+      await expect(fixture.operation).rejects.toThrow("request timed out");
+      expect(fixture.calls).toHaveLength(2);
+      expect(JSON.stringify(fixture.messages)).toBe(fixture.original);
+    } finally {
+      fixture.controller.abort();
+      for (const call of fixture.calls) {
+        call.complete("cleanup");
+      }
+      await fixture.settled;
+    }
+  });
+
+  it.each([0, 1])(
+    "cancels a stalled peer after stage %i fails and preserves the failure",
+    async (failedIndex) => {
+      const fixture = controlledSummary();
+      try {
+        await expect.poll(() => fixture.calls.length, { timeout: 2_000 }).toBe(2);
+        const peer = fixture.call(1 - failedIndex);
+        peer.cancelWhenAborted();
+        const errorMessage = `provider stage ${failedIndex + 1} timed out`;
+        fixture.call(failedIndex).fail(errorMessage);
+        await expect.poll(() => peer.signal.aborted).toBe(true);
+        await expect(fixture.operation).rejects.toBe(peer.signal.reason);
+        await expect(fixture.operation).rejects.toHaveProperty("code", "summarization_failed");
+        await expect(fixture.operation).rejects.toThrow(errorMessage);
+        expect(fixture.controller.signal.aborted).toBe(false);
+        expect(fixture.calls).toHaveLength(2);
+        expect(JSON.stringify(fixture.messages)).toBe(fixture.original);
+      } finally {
+        fixture.controller.abort();
+        for (const call of fixture.calls) {
+          call.complete("cleanup");
+        }
+        await fixture.settled;
+      }
+    },
+  );
+
+  it("cancels a peer in retry backoff after another stage fails", async () => {
+    const fixture = controlledSummary();
+    try {
+      await expect.poll(() => fixture.calls.length, { timeout: 2_000 }).toBe(2);
+      const peer = fixture.call(1);
+      peer.fail("temporary peer error");
+      await new Promise((resolve) => {
+        setImmediate(resolve);
+      });
+      expect(peer.signal.aborted).toBe(false);
+      fixture.call(0).fail();
+      await expect.poll(() => peer.signal.aborted).toBe(true);
+      await expect(fixture.operation).rejects.toBe(peer.signal.reason);
+      await expect(fixture.operation).rejects.toHaveProperty("code", "summarization_failed");
+      await expect(fixture.operation).rejects.toThrow("request timed out");
+      expect(fixture.controller.signal.aborted).toBe(false);
+      expect(fixture.calls).toHaveLength(2);
+      expect(JSON.stringify(fixture.messages)).toBe(fixture.original);
+    } finally {
+      fixture.controller.abort();
+      for (const call of fixture.calls) {
+        call.complete("cleanup");
+      }
+      await fixture.settled;
+    }
+  });
+
+  it("retains caller cancellation and drains both accepted stages before returning", async () => {
+    const fixture = controlledSummary();
+    let returned = false;
+    void fixture.settled.then(() => {
+      returned = true;
+    });
+    try {
+      await expect.poll(() => fixture.calls.length, { timeout: 2_000 }).toBe(2);
+      const reason = new Error("caller stopped compaction");
+      fixture.controller.abort(reason);
+      for (const call of fixture.calls) {
+        expect(call.signal.aborted).toBe(true);
+        expect(call.signal.reason).toBe(reason);
+      }
+      fixture.call(1).complete("late peer");
+      await new Promise((resolve) => {
+        setImmediate(resolve);
+      });
+      expect(returned).toBe(false);
+      fixture.call(0).complete("late first stage");
+      await expect(fixture.operation).rejects.toBe(reason);
+      expect(fixture.calls).toHaveLength(2);
+      expect(JSON.stringify(fixture.messages)).toBe(fixture.original);
+    } finally {
+      fixture.controller.abort();
+      for (const call of fixture.calls) {
+        call.complete("cleanup");
+      }
+      await fixture.settled;
+    }
+  });
+
+  it("preserves a caller abort while draining a peer after a terminal failure", async () => {
+    const fixture = controlledSummary();
+    try {
+      await expect.poll(() => fixture.calls.length, { timeout: 2_000 }).toBe(2);
+      fixture.call(0).fail();
+      await expect.poll(() => fixture.call(1).signal.aborted).toBe(true);
+      const reason = new Error("caller stopped failed compaction cleanup");
+      fixture.controller.abort(reason);
+      fixture.call(1).complete("completed peer cleanup");
+      await expect(fixture.operation).rejects.toBe(reason);
+      expect(fixture.calls).toHaveLength(2);
+      expect(JSON.stringify(fixture.messages)).toBe(fixture.original);
+    } finally {
+      fixture.controller.abort();
+      for (const call of fixture.calls) {
+        call.complete("cleanup");
+      }
+      await fixture.settled;
+    }
+  });
+});

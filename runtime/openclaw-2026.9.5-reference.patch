index 0000000000000000000000000000000000000000..9a4820657c84855e8c4e761878b780cdbdd1dcf8
--- /dev/null
+++ b/extensions/browser/src/browser/session-tab-registry.completion.test.ts
@@ -0,0 +1,253 @@
+import type { BrowserTaskCompletionCleanup } from "openclaw/plugin-sdk/browser-maintenance";
+import {
+  createPluginStateSyncKeyedStoreForTests,
+  resetPluginStateStoreForTests,
+} from "openclaw/plugin-sdk/plugin-state-test-runtime";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { useAutoCleanupTempDirTracker } from "../../test-support.js";
+import { setBrowserStateRuntime } from "../browser-runtime-state.js";
+import { volatileTabsBySession } from "./session-tab-process-state.js";
+import {
+  closeTrackedBrowserTabsForSessions,
+  touchSessionBrowserTab,
+  trackSessionBrowserTab,
+} from "./session-tab-registry.js";
+import { durableOwnership } from "./session-tab-registry.sqlite.test-helpers.js";
+
+const dirs = useAutoCleanupTempDirTracker(afterEach);
+const sessionKey = "agent:main:main";
+function openStore() {
+  return createPluginStateSyncKeyedStoreForTests("browser", {
+    namespace: "browser.session-tabs",
+    maxEntries: 5_000,
+    overflowPolicy: "reject-new",
+  });
+}
+function track(
+  targetId: string,
+  extra: Partial<Parameters<typeof trackSessionBrowserTab>[0]> = {},
+) {
+  trackSessionBrowserTab({
+    sessionKey,
+    targetId,
+    profile: "work",
+    ownership: durableOwnership(targetId),
+    now: 10,
+    ...extra,
+  });
+}
+function completion(isCurrent = () => true): BrowserTaskCompletionCleanup {
+  return { completedAt: 20, isCurrent };
+}
+function gate() {
+  let resolve!: () => void;
+  const promise = new Promise<void>((done) => {
+    resolve = done;
+  });
+  return { promise, resolve };
+}
+function clearProcessTabs() {
+  for (const name of [
+    "volatile",
+    "volatile-cleanup",
+    "active-durable-keys",
+    "cold-native-activity",
+    "interaction-storage-keys",
+    "exact-interaction-storage-keys",
+    "volatile-aliases",
+    "exact-volatile-aliases",
+  ]) {
+    Reflect.deleteProperty(globalThis, Symbol.for(`openclaw.browser.session-tabs.${name}`));
+  }
+}
+
+describe("ordinary completion uses exact revocable tracked tab ownership", () => {
+  beforeEach(() => {
+    vi.stubEnv("OPENCLAW_STATE_DIR", dirs.make("browser-completion-"));
+    resetPluginStateStoreForTests();
+    clearProcessTabs();
+    setBrowserStateRuntime({ sessionTabs: openStore(), dashboardOperations: new Map() });
+  });
+  afterEach(() => {
+    openStore().clear();
+    clearProcessTabs();
+    resetPluginStateStoreForTests();
+    vi.unstubAllEnvs();
+  });
+
+  it("closes only task-owned old tabs, preserving user, other-session and dashboard tabs", async () => {
+    track("opened-by-agent");
+    track("other-session", { sessionKey: "agent:other:main" });
+    track("new-turn-tab", { now: 30 });
+    track("recently-reused");
+    touchSessionBrowserTab({ sessionKey, targetId: "recently-reused", profile: "work", now: 30 });
+    for (const state of ["active", "stopped"] as const) {
+      track(`dashboard-${state}`, {
+        dashboard: {
+          name: "control",
+          sessionKey,
+          instanceId: state,
+          url: "http://localhost/control",
+          state,
+        },
+      });
+    }
+    const closed: string[] = [];
+    await expect(
+      closeTrackedBrowserTabsForSessions({
+        sessionKeys: [sessionKey],
+        taskCompletion: completion(),
+        closeTab: async (tab) => {
+          closed.push(tab.targetId);
+        },
+      }),
+    ).resolves.toBe(1);
+    expect(closed).toEqual(["opened-by-agent"]);
+    // A user tab never registered by action:open is absent from every cleanup dispatch.
+    expect(closed).not.toContain("already-open-user-tab");
+    expect(openStore().entries()).toHaveLength(5);
+  });
+
+  it.each(["followup", "touch"] as const)(
+    "revokes a durable close during preparation: %s",
+    async (change) => {
+      track("prepared-target");
+      const entered = gate();
+      const release = gate();
+      let current = true;
+      const effects: string[] = [];
+      const pending = closeTrackedBrowserTabsForSessions({
+        sessionKeys: [sessionKey],
+        taskCompletion: completion(() => current),
+        closeDurableTab: async (tab, { shouldClose }) => {
+          entered.resolve();
+          await release.promise;
+          if (!shouldClose()) {
+            return { status: "cancelled" };
+          }
+          effects.push(tab.nativeTargetId);
+          return { status: "closed" };
+        },
+      });
+      await entered.promise;
+      if (change === "followup") {
+        current = false;
+      } else {
+        touchSessionBrowserTab({
+          sessionKey,
+          targetId: "prepared-target",
+          profile: "work",
+          now: 10,
+        });
+      }
+      release.resolve();
+      await expect(pending).resolves.toBe(0);
+      expect(effects).toEqual([]);
+      expect(openStore().entries()[0]?.value).not.toHaveProperty("cleanupAttemptToken");
+      await expect(
+        closeTrackedBrowserTabsForSessions({ sessionKeys: [sessionKey], closeTab: async () => {} }),
+      ).resolves.toBe(1);
+    },
+  );
+
+  it("does not adopt tabs opened while an older close is pending", async () => {
+    track("old-target");
+    const entered = gate();
+    const release = gate();
+    const closed: string[] = [];
+    const pending = closeTrackedBrowserTabsForSessions({
+      sessionKeys: [sessionKey],
+      taskCompletion: completion(),
+      closeTab: async (tab) => {
+        entered.resolve();
+        await release.promise;
+        closed.push(tab.targetId);
+      },
+    });
+    await entered.promise;
+    track("successor-target", { now: 30 });
+    release.resolve();
+    await expect(pending).resolves.toBe(1);
+    expect(closed).toEqual(["old-target"]);
+    expect(openStore().entries()).toHaveLength(1);
+  });
+
+  it("does not leave a task's unguarded retry after Browser becomes unavailable", async () => {
+    const clock = vi.spyOn(Date, "now").mockReturnValue(20);
+    try {
+      track("offline-target");
+      const closeDurableTab = vi.fn(async () => ({
+        status: "unavailable" as const,
+        reason: "target-close-failed" as const,
+      }));
+      await expect(
+        closeTrackedBrowserTabsForSessions({
+          sessionKeys: [sessionKey],
+          taskCompletion: completion(),
+          closeDurableTab,
+        }),
+      ).resolves.toBe(0);
+      expect(openStore().entries()[0]?.value).not.toHaveProperty("cleanupAttemptToken");
+      await closeTrackedBrowserTabsForSessions({ sessionKeys: [sessionKey], closeDurableTab });
+      expect(openStore().entries()[0]?.value).toHaveProperty("cleanupKind", "lifecycle");
+      closeDurableTab.mockClear();
+      await closeTrackedBrowserTabsForSessions({
+        sessionKeys: [sessionKey],
+        taskCompletion: completion(),
+        closeDurableTab,
+      });
+      expect(closeDurableTab).not.toHaveBeenCalled();
+      expect(openStore().entries()[0]?.value).toHaveProperty("cleanupKind", "lifecycle");
+    } finally {
+      clock.mockRestore();
+    }
+  });
+
+  it.each(["followup", "touch"] as const)(
+    "revokes the volatile route at actual node dispatch: %s",
+    async (change) => {
+      const entered = gate();
+      const release = gate();
+      let current = true;
+      const effect = vi.fn();
+      const route = {
+        kind: "node-proxy" as const,
+        nodeId: "fixture-node",
+        closeTarget: async ({ assertCurrent }: { assertCurrent?: () => void }) => {
+          entered.resolve();
+          await release.promise;
+          assertCurrent?.();
+          effect();
+          return { status: "closed" as const };
+        },
+      };
+      trackSessionBrowserTab({
+        sessionKey,
+        targetId: "volatile-target",
+        route,
+        profile: "work",
+        now: 10,
+      });
+      const pending = closeTrackedBrowserTabsForSessions({
+        sessionKeys: [sessionKey],
+        taskCompletion: completion(() => current),
+      });
+      await entered.promise;
+      if (change === "followup") {
+        current = false;
+      } else {
+        touchSessionBrowserTab({
+          sessionKey,
+          targetId: "volatile-target",
+          route,
+          profile: "work",
+          now: 10,
+        });
+      }
+      release.resolve();
+      await expect(pending).resolves.toBe(0);
+      expect(effect).not.toHaveBeenCalled();
+      expect(volatileTabsBySession().get(sessionKey)?.size).toBe(1);
+    },
+  );
+});

diff --git a/src/security/audit-model-classification.ts b/src/security/audit-model-classification.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c5f01337245c724c6cf7405d89349e0332925f2a
--- /dev/null
+++ b/src/security/audit-model-classification.ts
@@ -0,0 +1,29 @@
+export const LEGACY_MODEL_PATTERNS: Array<{ id: string; re: RegExp; label: string }> = [
+  { id: "openai.gpt35", re: /\bgpt-3\.5\b/i, label: "GPT-3.5 family" },
+  { id: "anthropic.claude2", re: /\bclaude-(instant|2)\b/i, label: "Claude 2/Instant family" },
+  { id: "openai.gpt4_legacy", re: /\bgpt-4-(0314|0613)\b/i, label: "Legacy GPT-4 snapshots" },
+];
+
+export const WEAK_TIER_MODEL_PATTERNS: Array<{ id: string; re: RegExp; label: string }> = [
+  { id: "anthropic.haiku", re: /\bhaiku\b/i, label: "Haiku tier (smaller model)" },
+];
+
+export function isGptModel(id: string): boolean {
+  return /\bgpt-/i.test(id);
+}
+
+export function isGpt5OrHigher(id: string): boolean {
+  const match = /\bgpt-(\d+)(?:\b|[.-])/i.exec(id);
+  return match !== null && Number(match[1]) >= 5;
+}
+
+export function isClaudeModel(id: string): boolean {
+  return /\bclaude-/i.test(id);
+}
+
+export function isClaude45OrHigher(id: string): boolean {
+  // Match claude-*-4-5+, claude-*-45+, claude-*4.5+, or future 5.x+ majors.
+  return /\bclaude-[^\s/]*?(?:-4-?(?:[5-9]|[1-9]\d)\b|4\.(?:[5-9]|[1-9]\d)\b|-[5-9](?:\b|[.-]))/i.test(
+    id,
+  );
+}

diff --git a/extensions/discord/src/monitor/message-handler.progress-checkpoint.ts b/extensions/discord/src/monitor/message-handler.progress-checkpoint.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4097fe8b571d668dcc343ad9bc65cb293e3e0c8e
--- /dev/null
+++ b/extensions/discord/src/monitor/message-handler.progress-checkpoint.ts
@@ -0,0 +1,147 @@
+// A long foreground turn keeps completed public checkpoints as separate Discord messages.
+const CHECKPOINT_INTERVAL_MS = 180_000;
+
+type PublicProgress = {
+  text: string;
+  itemId?: string;
+  complete: boolean;
+  source: "preamble" | "narration";
+};
+
+export function createDiscordProgressCheckpoint(params: {
+  active: boolean;
+  messageId: () => string | undefined;
+  canRotate: () => boolean;
+  flush: () => Promise<void>;
+  seal: () => Promise<void>;
+  rotate: () => void;
+  resetContent: () => void;
+}) {
+  let generation = 0;
+  let closed = false;
+  let rotating = false;
+  let createdAt: number | undefined;
+  let tail: Promise<unknown> = Promise.resolve();
+  const currentItems = new Set<string>();
+  const retiredItems = new Set<string>();
+  const completedTexts = new Set<string>();
+  const heldItems = new Set<string>();
+  let idlessItem = 0;
+  let idlessText = "";
+
+  const itemKey = (progress: PublicProgress) => {
+    if (progress.source === "narration") {
+      return `narration:${progress.text}`;
+    }
+    if (progress.itemId) {
+      return `preamble:${progress.itemId}`;
+    }
+    if (
+      progress.text &&
+      (!idlessText ||
+        !(progress.text.startsWith(idlessText) || idlessText.startsWith(progress.text)))
+    ) {
+      idlessItem += 1;
+    }
+    idlessText = progress.text;
+    return `preamble:idless:${idlessItem}`;
+  };
+
+  const enqueue = (publish: (isCurrent: () => boolean) => Promise<boolean>) => {
+    const owner = generation;
+    const isCurrent = () => !closed && owner === generation;
+    const run = tail.catch(() => {}).then(() => (isCurrent() ? publish(isCurrent) : false));
+    tail = run;
+    return run;
+  };
+
+  return {
+    run(publish: () => Promise<boolean>) {
+      return params.active ? enqueue(() => publish()) : publish();
+    },
+    get rotating() {
+      return rotating;
+    },
+    noteMessageCreated() {
+      createdAt = Date.now();
+    },
+    cancel() {
+      closed = true;
+      generation += 1;
+    },
+    beginTurn() {
+      closed = false;
+      generation += 1;
+      createdAt = undefined;
+      currentItems.clear();
+      retiredItems.clear();
+      completedTexts.clear();
+      heldItems.clear();
+      idlessItem = 0;
+      idlessText = "";
+    },
+    publish(progress: PublicProgress, publish: () => Promise<boolean>): Promise<boolean> {
+      if (!params.active) {
+        return publish();
+      }
+      return enqueue(async (isCurrent) => {
+        const key = itemKey(progress);
+        // A late update/retraction cannot replay an item sealed into an earlier checkpoint.
+        if (retiredItems.has(key)) {
+          return false;
+        }
+        if (progress.text && completedTexts.has(progress.text) && !currentItems.has(key)) {
+          return false;
+        }
+        const fresh = Boolean(progress.text) && !completedTexts.has(progress.text);
+        const due =
+          createdAt !== undefined &&
+          Date.now() - createdAt >= CHECKPOINT_INTERVAL_MS &&
+          Boolean(params.messageId()) &&
+          params.canRotate();
+        // Hold a new streaming item until its public completion boundary. Its prefix must not
+        // first appear in the retiring card and then be repeated in the new notification.
+        if (due && fresh && !currentItems.has(key) && !progress.complete) {
+          heldItems.add(key);
+        }
+        if (heldItems.has(key) && !progress.complete && progress.text) {
+          return false;
+        }
+        heldItems.delete(key);
+        if (due && fresh && !currentItems.has(key) && progress.complete) {
+          rotating = true;
+          try {
+            await params.flush();
+            if (!isCurrent()) {
+              return false;
+            }
+            await params.seal();
+            if (!isCurrent()) {
+              return false;
+            }
+            params.rotate();
+            params.resetContent();
+            for (const item of currentItems) {
+              retiredItems.add(item);
+            }
+            currentItems.clear();
+            createdAt = undefined;
+          } finally {
+            rotating = false;
+          }
+        }
+        if (!isCurrent()) {
+          return false;
+        }
+        const visible = await publish();
+        if (isCurrent() && progress.text) {
+          currentItems.add(key);

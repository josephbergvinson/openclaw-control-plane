@@ -0,0 +1,245 @@
+import fs from "node:fs/promises";
+import path from "node:path";
+import { afterEach, beforeAll, describe, expect, it, vi } from "vitest";
+import { RequestClient } from "../extensions/discord/src/internal/discord.js";
+import { deliverDiscordReply } from "../extensions/discord/src/monitor/reply-delivery.js";
+import { createMessageTool } from "../src/agents/tools/message-tool-execution.js";
+import { selectDeliverableSessionsReply } from "../src/agents/tools/sessions-send-tokens.js";
+import { setReplyPayloadMetadata } from "../src/auto-reply/reply-payload.js";
+import { createReplyDispatcher } from "../src/auto-reply/reply/reply-dispatcher.js";
+import { HEARTBEAT_TOKEN } from "../src/auto-reply/tokens.js";
+import type { ReplyPayload } from "../src/auto-reply/types.js";
+import type { ChannelPlugin } from "../src/channels/plugins/types.public.js";
+import { clearRuntimeConfigSnapshot, setRuntimeConfigSnapshot } from "../src/config/config.js";
+import type { OpenClawConfig } from "../src/config/types.openclaw.js";
+import { createEmptyPluginRegistry } from "../src/plugins/registry.js";
+import { resetPluginRuntimeStateForTest, setActivePluginRegistry } from "../src/plugins/runtime.js";
+import { loadBundledPluginFacade } from "../src/test-utils/bundled-plugin-public-surface.js";
+import { createTestRegistry } from "../src/test-utils/channel-plugins.js";
+import { withOpenClawTestState } from "../src/test-utils/openclaw-test-state.js";
+
+const channelId = "100000000000000002";
+const target = `channel:${channelId}`;
+const token = "synthetic-discord-token";
+let discordPlugin: ChannelPlugin;
+
+beforeAll(async () => {
+  ({ discordPlugin } = await loadBundledPluginFacade<{ discordPlugin: ChannelPlugin }>({
+    pluginId: "discord",
+    artifactBasename: "api.js",
+  }));
+});
+
+afterEach(() => {
+  vi.unstubAllGlobals();
+  resetPluginRuntimeStateForTest();
+  setActivePluginRegistry(createEmptyPluginRegistry());
+  clearRuntimeConfigSnapshot();
+});
+
+async function withDelivery(
+  run: (fixture: {
+    cfg: OpenClawConfig;
+    rest: RequestClient;
+    workspace: string;
+    posts: Array<{ content?: string; attachments?: unknown[] }>;
+  }) => Promise<void>,
+) {
+  await withOpenClawTestState({ prefix: "ordinary-reply-sentinels-" }, async (state) => {
+    const cfg: OpenClawConfig = {
+      agents: { defaults: { workspace: state.workspaceDir } },
+      channels: { discord: { enabled: true, token } },
+    };
+    await state.writeConfig(cfg);
+    setRuntimeConfigSnapshot(cfg, cfg);
+    setActivePluginRegistry(
+      createTestRegistry([{ pluginId: "discord", source: "test", plugin: discordPlugin }]),
+    );
+    const posts: Array<{ content?: string; attachments?: unknown[] }> = [];
+    const fetchControlled: typeof fetch = async (input, init) => {
+      const url = new URL(input instanceof Request ? input.url : String(input));
+      const method = init?.method ?? "GET";
+      if (method === "GET" && url.pathname === `/api/v10/channels/${channelId}`) {
+        return Response.json({ id: channelId, type: 0, name: "fixture" });
+      }
+      if (method === "POST" && url.pathname === `/api/v10/channels/${channelId}/messages`) {
+        const body = init?.body;
+        let payload: unknown;
+        if (typeof body === "string") {
+          payload = JSON.parse(body);
+        } else if (body instanceof FormData) {
+          const json = body.get("payload_json");
+          if (typeof json !== "string") {
+            throw new Error("Expected media payload JSON");
+          }
+          payload = JSON.parse(json);
+          expect(body.get("files[0]")).toBeInstanceOf(Blob);
+        } else {
+          throw new Error("Expected controlled Discord message payload");
+        }
+        if (typeof payload !== "object" || payload === null) {
+          throw new Error("Expected a message object");
+        }
+        posts.push(payload);
+        return Response.json({ id: String(1000 + posts.length), channel_id: channelId });
+      }
+      throw new Error(`Unexpected controlled Discord request: ${method} ${url.pathname}`);
+    };
+    vi.stubGlobal("fetch", fetchControlled);
+    const rest = new RequestClient(token, {
+      queueRequests: false,
+      fetch: fetchControlled,
+    });
+    await run({ cfg, rest, workspace: state.workspaceDir, posts });
+  });
+}
+
+async function dispatch(
+  fixture: Parameters<Parameters<typeof withDelivery>[0]>[0],
+  payload: ReplyPayload,
+  options: {
+    responsePrefix?: string;
+    transformReplyPayload?: (p: ReplyPayload) => ReplyPayload;
+  } = {},
+) {
+  const onSkip = vi.fn();
+  const onError = vi.fn();
+  const delivered = vi.fn(async (reply: ReplyPayload, info: { kind: "tool" | "block" | "final" }) =>
+    deliverDiscordReply({
+      cfg: fixture.cfg,
+      rest: fixture.rest,
+      token,
+      target,
+      accountId: "default",
+      textLimit: 2000,
+      replies: [reply],
+      kind: info.kind,
+      mediaLocalRoots: [fixture.workspace],
+    }),
+  );
+  const dispatcher = createReplyDispatcher({ deliver: delivered, onSkip, onError, ...options });
+  const accepted = dispatcher.sendFinalReply(payload);
+  dispatcher.markComplete();
+  await dispatcher.waitForIdle();
+  expect(onError).not.toHaveBeenCalled();
+  return { accepted, delivered, onSkip };
+}
+
+describe("ordinary completion tokens through the real Discord delivery owner", () => {
+  it.each(["REPLY_SKIP", "ANNOUNCE_SKIP"])(
+    "withholds the exact ordinary final %s",
+    async (text) => {
+      await withDelivery(async (fixture) => {

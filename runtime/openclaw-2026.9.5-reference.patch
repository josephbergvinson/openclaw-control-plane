+import { describe, expect, it } from "vitest";
+import {
+  convertProviderResponsesMessages,
+  convertResponsesMessages,
+} from "../transports/openai-responses-replay-messages-internal.js";
+import type { AssistantMessage, Context, Model } from "../types.js";
+import { createZeroUsage } from "../usage.test-support.js";
+import { shortHash } from "../utils/hash.js";
+
+const model: Model<"openai-chatgpt-responses"> = {
+  id: "gpt-6-astra",
+  name: "GPT-6 Astra",
+  api: "openai-chatgpt-responses",
+  provider: "openai",
+  baseUrl: "https://chatgpt.com/backend-api",
+  reasoning: true,
+  input: ["text"],
+  cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+  contextWindow: 272000,
+  maxTokens: 8192,
+};
+
+function fixture(names: string[]): Context {
+  const assistant: AssistantMessage = {
+    role: "assistant",
+    api: model.api,
+    provider: model.provider,
+    model: "gpt-5.6-sol",
+    usage: createZeroUsage(),
+    stopReason: "toolUse",
+    timestamp: 0,
+    content: names.map((name, index) => ({
+      type: "toolCall",
+      id: `call_fixture_${index}`,
+      name,
+      arguments: { fixture: true },
+    })),
+  };
+  return {
+    messages: [
+      { role: "user", content: "Synthetic completed lookup", timestamp: 0 },
+      assistant,
+      ...names.map((toolName, index) => ({
+        role: "toolResult" as const,
+        toolCallId: `call_fixture_${index}`,
+        toolName,
+        isError: false,
+        content: [{ type: "text" as const, text: "Synthetic lookup complete" }],
+        timestamp: 1,
+      })),
+    ],
+  };
+}
+
+describe.each([
+  ["provider", convertProviderResponsesMessages],
+  ["transport", convertResponsesMessages],
+] as const)("%s legacy tool name replay", (_label, convert) => {
+  const project = (context: Context) => convert(model, context, new Set(["openai"]));
+
+  it("repairs dotted legacy names without changing call/result identity or saved history", () => {
+    const context = fixture(["linear.get_user", "linear.get_workspace", "linear.get_issue"]);
+    const original = JSON.stringify(context);
+    const wire = project(context);
+    const calls = wire.filter((item) => item.type === "function_call");
+    const results = wire.filter((item) => item.type === "function_call_output");
+    expect(calls).toHaveLength(3);
+    expect(calls.every((call) => /^[a-zA-Z0-9_-]{1,64}$/.test(call.name))).toBe(true);
+    expect(results.map((result) => result.call_id)).toEqual(calls.map((call) => call.call_id));
+    expect(calls.map((call) => call.arguments)).toEqual(Array(3).fill('{"fixture":true}'));
+    expect(JSON.stringify(context)).toBe(original);
+    expect(project(context)).toEqual(wire);
+  });
+
+  it("keeps valid names unchanged and separates ambiguous punctuation and reserved aliases", () => {
+    const legacy = "linear.get_user";
+    const reserved = `linear_get_user__legacy_${shortHash(legacy)}`;
+    const names = [legacy, "linear:get_user", "linear_get_user", reserved, legacy];
+    const context = fixture(names);
+    const calls = project(context).filter((item) => item.type === "function_call");
+    expect(calls[2]?.name).toBe("linear_get_user");
+    expect(calls[3]?.name).toBe(reserved);
+    expect(calls[0]?.name).toBe(calls[4]?.name);
+    expect(new Set(calls.slice(0, 4).map((call) => call.name)).size).toBe(4);
+  });
+
+  it("reserves current tool declarations and bounds empty, Unicode and overlong legacy names", () => {
+    const legacy = "linear.get_user";
+    const reserved = `linear_get_user__legacy_${shortHash(legacy)}`;
+    const context = fixture([legacy, "", "工具", "a".repeat(65), "a".repeat(64)]);
+    context.tools = [
+      { name: reserved, description: "Current tool", parameters: { type: "object" } },
+    ];
+    const calls = project(context).filter((item) => item.type === "function_call");
+    expect(calls).toHaveLength(5);
+    expect(calls.every((call) => /^[a-zA-Z0-9_-]{1,64}$/.test(call.name))).toBe(true);
+    expect(calls[0]?.name).not.toBe(reserved);
+    expect(calls[4]?.name).toBe("a".repeat(64));
+    expect(new Set(calls.map((call) => call.name)).size).toBe(5);
+  });
+});

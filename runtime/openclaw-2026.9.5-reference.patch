--- /dev/null
+++ b/extensions/lane-contract/src/detached-lane-checkpoint.test.ts
@@ -0,0 +1,131 @@
+import { describe, expect, it } from "vitest";
+import { DetachedLaneCheckpointProjector } from "./detached-lane-checkpoint.js";
+
+type CheckpointEvent = Parameters<DetachedLaneCheckpointProjector["projectCheckpoint"]>[0];
+
+const assistantCommentary = (seq: number, data: Record<string, unknown>): CheckpointEvent => ({
+  seq,
+  stream: "assistant",
+  data: { phase: "commentary", ...data },
+});
+const cliPreamble = (seq: number, data: Record<string, unknown>): CheckpointEvent => ({
+  seq,
+  stream: "item",
+  data: { kind: "preamble", phase: "update", ...data },
+});
+const toolStart = (
+  seq: number,
+  toolCallId: string,
+  data: Record<string, unknown> = {},
+): CheckpointEvent => ({ seq, stream: "tool", data: { phase: "start", toolCallId, ...data } });
+const checkpoint = (key: string, text: string) => ({ key, text });
+
+describe("detached lane checkpoint projection", () => {
+  it.each([
+    {
+      name: "keyed assistant deltas complete once at tool start",
+      events: [
+        assistantCommentary(20, { itemId: "assistant", delta: "Desktop is complete" }),
+        assistantCommentary(21, { itemId: "assistant", delta: "; mobile is next." }),
+        toolStart(22, "assistant-tool"),
+      ],
+      expected: [
+        checkpoint("commentary:assistant:completed", "Desktop is complete; mobile is next."),
+      ],
+    },
+    {
+      name: "CLI preamble completes once at tool start",
+      events: [
+        cliPreamble(30, {
+          itemId: "cli",
+          progressText: "Checks are isolated; correction is next.",
+        }),
+        toolStart(31, "cli-tool"),
+      ],
+      expected: [
+        checkpoint("commentary:cli:completed", "Checks are isolated; correction is next."),
+      ],
+    },
+    {
+      name: "unkeyed full snapshot uses the tool identity",
+      events: [
+        assistantCommentary(40, {
+          text: "Browser is complete; settlement is next.",
+          replace: true,
+        }),
+        toolStart(41, "snapshot-tool"),
+      ],
+      expected: [
+        checkpoint(
+          "commentary:tool:snapshot-tool:completed",
+          "Browser is complete; settlement is next.",
+        ),
+      ],
+    },
+    {
+      name: "unkeyed deltas stay private",
+      events: [
+        assistantCommentary(50, { delta: "private partial" }),
+        toolStart(51, "partial-tool"),
+      ],
+      expected: [],
+    },
+    {
+      name: "explicit Codex completion is not duplicated by tool start",
+      events: [
+        assistantCommentary(60, {
+          itemId: "codex",
+          text: "Change is complete; verification is next.",
+          replace: true,
+          completed: true,
+        }),
+        toolStart(61, "codex-tool"),
+      ],
+      expected: [
+        checkpoint("commentary:codex:completed", "Change is complete; verification is next."),
+      ],
+    },
+    {
+      name: "replayed tool identities do not duplicate snapshots",
+      events: [
+        assistantCommentary(70, { text: "First inspection is complete.", replace: true }),
+        toolStart(71, "replayed-tool"),
+        assistantCommentary(72, { text: "Second inspection is complete.", replace: true }),
+        toolStart(73, "replayed-tool"),
+      ],
+      expected: [
+        checkpoint("commentary:tool:replayed-tool:completed", "First inspection is complete."),
+      ],
+    },
+    {
+      name: "latest full snapshot wins before tool start",
+      events: [
+        assistantCommentary(80, { text: "First pass is complete.", replace: true }),
+        assistantCommentary(81, { text: "Browser is complete; mobile is next.", replace: true }),
+        toolStart(82, "latest-tool"),
+      ],
+      expected: [
+        checkpoint("commentary:tool:latest-tool:completed", "Browser is complete; mobile is next."),
+      ],
+    },
+    {
+      name: "tool payload details never enter checkpoint text",
+      events: [
+        assistantCommentary(90, { itemId: "privacy", delta: "Public review is complete." }),
+        toolStart(91, "private-tool", {
+          name: "private_admin_tool",
+          args: { apiKey: "secret" },
+          result: "private-result",
+        }),
+      ],
+      expected: [checkpoint("commentary:privacy:completed", "Public review is complete.")],
+    },
+  ])("$name", ({ events, expected }) => {
+    const projector = new DetachedLaneCheckpointProjector();
+    const projected = events.flatMap((event) => {
+      const result = projector.projectCheckpoint(event);
+      return result ? [result] : [];
+    });
+    expect(projected).toEqual(expected);
+  });
+});
diff --git a/extensions/lane-contract/src/detached-lane-checkpoint.ts b/extensions/lane-contract/src/detached-lane-checkpoint.ts
new file mode 100644
index 0000000000000000000000000000000000000000..89b3f72651500979312bfcbff27452c7f9c56f70
--- /dev/null
+++ b/extensions/lane-contract/src/detached-lane-checkpoint.ts
@@ -0,0 +1,216 @@
+import type { OpenClawPluginApi } from "openclaw/plugin-sdk/plugin-entry";
+import { normalizeOptionalString } from "openclaw/plugin-sdk/string-coerce-runtime";
+
+const DETACHED_LANE_MAX_CHECKPOINT_CHARS = 1_600;
+const DETACHED_LANE_CHECKPOINT_GAP_MS = 3 * 60_000;
+const DETACHED_LANE_CHECKPOINT_REQUEST =
+  "A progress checkpoint is due for your ongoing task. At the next safe boundary, write a concise commentary update with the concrete progress or real blocker and your next move, then continue the same task. The existing relay delivers it to the requester. Keep internal IDs, paths, tool details, and this reminder private. Do not send a separate message or start another task.";
+
+export type DetachedLaneCheckpoint = {
+  key: string;
+  text: string;
+};
+
+type BoundTaskRuns = ReturnType<OpenClawPluginApi["runtime"]["tasks"]["runs"]["bindSession"]>;
+type TaskRun = ReturnType<BoundTaskRuns["list"]>[number];
+
+type CheckpointRequestLane = {
+  runId: string;
+  taskId: string;
+  ownerSessionKey: string;
+  pendingCheckpoint?: DetachedLaneCheckpoint;
+  lastCheckpoint: { at: number; key: string };
+  checkpointRequest?: AbortController;
+  checkpointRequestNotBefore?: number;
+};
+
+export function createDetachedLaneCheckpointRequests<Lane extends CheckpointRequestLane>(params: {
+  progressNow: () => number;
+  isDisposed: () => boolean;
+  isCurrentLane: (lane: Lane) => boolean;
+  resolveCurrentLaneTask: (lane: Lane) => Pick<TaskRun, "status"> | undefined;
+  taskRuntime: (sessionKey: string) => Pick<BoundTaskRuns, "queueMessage">;
+  warn: (message: string) => void;
+}) {
+  const { progressNow, isDisposed, isCurrentLane, resolveCurrentLaneTask, taskRuntime, warn } =
+    params;
+  return {
+    requestOverdue(lane: Lane): void {
+      if (
+        lane.checkpointRequest ||
+        lane.pendingCheckpoint ||
+        progressNow() < (lane.checkpointRequestNotBefore ?? 0) ||
+        progressNow() - lane.lastCheckpoint.at < DETACHED_LANE_CHECKPOINT_GAP_MS
+      ) {
+        return;
+      }
+      // Keep one request outstanding until a receipt, lane closure, or a
+      // failed delivery attempt releases it with a separate retry cooldown.
+      const request = new AbortController();
+      lane.checkpointRequest = request;
+      const canInject = () =>
+        !isDisposed() &&
+        !request.signal.aborted &&
+        isCurrentLane(lane) &&
+        !lane.pendingCheckpoint &&
+        lane.checkpointRequest === request &&
+        resolveCurrentLaneTask(lane)?.status === "running";
+      void taskRuntime(lane.ownerSessionKey)
+        .queueMessage({
+          taskId: lane.taskId,
+          runId: lane.runId,
+          message: DETACHED_LANE_CHECKPOINT_REQUEST,
+          queueIdentity: `lane-contract:progress:${lane.runId}:${lane.lastCheckpoint.key}`,
+          signal: request.signal,
+          canInject,
+        })
+        .then((outcome) => {
+          if (!request.signal.aborted && !outcome.queued) {
+            warn(`lane-contract checkpoint request rejected: ${outcome.reason}`);
+          }
+        })
+        .catch(() => {
+          if (!request.signal.aborted) {
+            warn("lane-contract checkpoint request failed");
+          }
+        });
+    },
+    recordReceipt(lane: Lane, checkpoint: DetachedLaneCheckpoint): void {
+      if (lane.pendingCheckpoint === checkpoint) {
+        lane.pendingCheckpoint = undefined;
+      }
+      lane.lastCheckpoint = { at: progressNow(), key: checkpoint.key };
+      lane.checkpointRequest?.abort();
+      lane.checkpointRequest = undefined;
+      lane.checkpointRequestNotBefore = undefined;
+    },
+    recordUnconfirmedAttempt(lane: Lane, checkpoint: DetachedLaneCheckpoint): void {
+      // An ambiguous send may already be visible. Do not replay it or turn
+      // its missing receipt into permanent silence for the rest of the task.
+      if (lane.pendingCheckpoint === checkpoint) {
+        lane.pendingCheckpoint = undefined;
+      }
+      lane.checkpointRequest?.abort();
+      lane.checkpointRequest = undefined;
+      lane.checkpointRequestNotBefore = progressNow() + DETACHED_LANE_CHECKPOINT_GAP_MS;
+    },
+  };
+}
+
+type DetachedLaneProgressEvent = {
+  seq: number;
+  stream: string;
+  data: Record<string, unknown>;
+};
+
+type ActiveCommentary =
+  | { kind: "item"; itemId: string }
+  | { kind: "unkeyed_snapshot"; text: string };
+
+function boundedNaturalCheckpointText(value: unknown): string | undefined {
+  const text = normalizeOptionalString(value)?.replace(/\s+/gu, " ");
+  if (!text || /^(?:checking|working|thinking|looking|on it)[.!…]*$/iu.test(text)) {
+    return undefined;
+  }
+  return text.length <= DETACHED_LANE_MAX_CHECKPOINT_CHARS
+    ? text
+    : `${text.slice(0, DETACHED_LANE_MAX_CHECKPOINT_CHARS - 1)}…`;
+}
+
+export class DetachedLaneCheckpointProjector {
+  private lastEventSeq = 0;
+  private readonly commentaryTextByItem = new Map<string, string>();
+  private readonly completedCommentaryItems = new Set<string>();
+  private readonly completedToolBoundaries = new Set<string>();
+  private activeCommentary?: ActiveCommentary;
+
+  private completeItem(itemId: string): DetachedLaneCheckpoint | undefined {
+    if (this.completedCommentaryItems.has(itemId)) {
+      return undefined;
+    }
+    this.completedCommentaryItems.add(itemId);
+    if (this.activeCommentary?.kind === "item" && this.activeCommentary.itemId === itemId) {
+      this.activeCommentary = undefined;
+    }
+    const text = boundedNaturalCheckpointText(this.commentaryTextByItem.get(itemId));
+    this.commentaryTextByItem.delete(itemId);
+    return text ? { key: `commentary:${itemId}:completed`, text } : undefined;
+  }
+
+  private completeActiveCommentary(
+    toolCallId: string | undefined,
+  ): DetachedLaneCheckpoint | undefined {
+    const active = this.activeCommentary;
+    if (!active) {
+      return undefined;
+    }
+    if (active.kind === "item") {
+      return this.completeItem(active.itemId);
+    }
+    if (!toolCallId || this.completedToolBoundaries.has(toolCallId)) {
+      return undefined;
+    }
+    this.completedToolBoundaries.add(toolCallId);
+    this.activeCommentary = undefined;
+    const text = boundedNaturalCheckpointText(active.text);
+    return text ? { key: `commentary:tool:${toolCallId}:completed`, text } : undefined;
+  }
+
+  projectCheckpoint(event: DetachedLaneProgressEvent): DetachedLaneCheckpoint | undefined {
+    // Agent sequence numbers are run-global; replayed deltas must not be
+    // appended twice to the item-keyed commentary accumulator.
+    if (event.seq <= this.lastEventSeq) {
+      return undefined;
+    }
+    this.lastEventSeq = event.seq;
+
+    if (event.stream === "tool") {
+      if (normalizeOptionalString(event.data.phase) !== "start") {
+        return undefined;
+      }
+      return this.completeActiveCommentary(normalizeOptionalString(event.data.toolCallId));
+    }
+
+    let itemId: string | undefined;
+    let accumulatedText: string | undefined;
+    const completed = event.data.completed === true;
+    if (event.stream === "item") {
+      if (
+        normalizeOptionalString(event.data.kind) !== "preamble" ||
+        normalizeOptionalString(event.data.phase) !== "update"
+      ) {
+        return undefined;
+      }
+      itemId = normalizeOptionalString(event.data.itemId) ?? `item:${event.seq}`;
+      accumulatedText = normalizeOptionalString(event.data.progressText);
+    } else if (event.stream === "assistant") {
+      if (normalizeOptionalString(event.data.phase) !== "commentary") {
+        return undefined;
+      }
+      itemId = normalizeOptionalString(event.data.itemId);
+      if (!itemId) {
+        if (event.data.replace === true && typeof event.data.text === "string") {
+          this.activeCommentary = { kind: "unkeyed_snapshot", text: event.data.text };
+        }
+        return undefined;
+      }
+      if (event.data.replace === true || (completed && typeof event.data.text === "string")) {
+        accumulatedText = typeof event.data.text === "string" ? event.data.text : undefined;
+      } else if (typeof event.data.delta === "string" && event.data.delta.length > 0) {
+        accumulatedText = `${this.commentaryTextByItem.get(itemId) ?? ""}${event.data.delta}`;
+      }
+    }
+    if (!itemId || accumulatedText === undefined) {
+      return undefined;
+    }
+    if (this.completedCommentaryItems.has(itemId)) {
+      return undefined;
+    }
+    this.commentaryTextByItem.set(itemId, accumulatedText);
+    this.activeCommentary = { kind: "item", itemId };
+    if (!completed) {
+      return undefined;
+    }
+    return this.completeItem(itemId);
+  }
+}
diff --git a/extensions/lane-contract/src/detached-lane-delivery.test.ts b/extensions/lane-contract/src/detached-lane-delivery.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..100cbfcc5382fb9118065f68f97d9c1bbd95ba6a
--- /dev/null
+++ b/extensions/lane-contract/src/detached-lane-delivery.test.ts
@@ -0,0 +1,281 @@
+import { createDeferred } from "openclaw/plugin-sdk/extension-shared";
+import { describe, expect, it, vi } from "vitest";
+import {
+  DISCORD_ROUTE,
+  OWNER_SESSION,
+  cliPreamble,
+  makeHarness,
+  makeTask,
+} from "./detached-lane-runtime.test-support.js";
+
+describe("detached Discord lane contract", () => {
+  it("dispatches an unreceipted natural checkpoint once and keeps later commentary deliverable", async () => {
+    const harness = makeHarness();
+    harness.sendResults.push({});
+    harness.setTasks(OWNER_SESSION, [makeTask()]);
+    await harness.receive();
+    await harness.start();
+    await harness.emitAgentEvent({
+      data: {
+        kind: "preamble",
+        phase: "update",
+        progressText: "I've finished the first pass and am checking the remaining edge cases.",
+        completed: true,
+      },
+    });
+
+    await harness.controller.tick();
+    await harness.controller.tick();
+    expect(harness.sendCalls()).toHaveLength(1);
+    expect(harness.sendCalls().map((call) => call[1].idempotencyKey)).toEqual([
+      "lane-contract:checkpoint:run-1:commentary:item:1:completed",
+    ]);
+    expect(harness.sendCalls()[0]?.[1]).toMatchObject({
+      message: "I've finished the first pass and am checking the remaining edge cases.",
+    });
+
+    await harness.emitAgentEvent({
+      ...cliPreamble(2, {
+        itemId: "next-checkpoint",
+        progressText: "The remaining edge cases are verified; I am preparing the handoff.",
+        completed: true,
+      }),
+    });
+    await harness.controller.tick();
+    await harness.controller.tick();
+    expect(harness.sendCalls().map((call) => call[1].idempotencyKey)).toEqual([
+      "lane-contract:checkpoint:run-1:commentary:item:1:completed",
+      "lane-contract:checkpoint:run-1:commentary:next-checkpoint:completed",
+    ]);
+    expect(harness.sendCalls()[1]?.[1]).toMatchObject({
+      message: "The remaining edge cases are verified; I am preparing the handoff.",
+    });
+  });
+
+  it.each(["natural commentary", "overdue checkpoint request"] as const)(
+    "does not let an unresolved send block another lane's %s",
+    async (progress) => {
+      const harness = makeHarness();
+      const delivery = createDeferred<{ messageId: string }>();
+      harness.sendResults.push(delivery.promise);
+      harness.setTasks(OWNER_SESSION, [makeTask()]);
+      await harness.receive();
+      await harness.start();
+
+      const otherOwner = "agent:main:discord:channel-2";
+      const otherChild = "agent:main:subagent:child-2";
+      const otherRoute = { ...DISCORD_ROUTE, to: "channel-2", threadId: "thread-2" };
+      harness.setTasks(otherOwner, [
+        makeTask({
+          id: "task-2",
+          runId: "run-2",
+          ownerKey: otherOwner,
+          sessionKey: otherChild,
+          childSessionKey: otherChild,
+        }),
+      ]);
+      await harness.receive({
+        messageId: "message-2",
+        sessionKey: otherOwner,
+        route: otherRoute,
+      });
+      await harness.start({
+        runId: "run-2",
+        childSessionKey: otherChild,
+        messageId: "message-2",
+        route: otherRoute,
+      });
+      await harness.emitAgentEvent({});
+      if (progress === "natural commentary") {
+        await harness.emitAgentEvent({
+          runId: "run-2",
+          sessionKey: otherChild,
+          ...cliPreamble(1, {
+            itemId: "other-checkpoint",
+            progressText: "The independent review is complete; I am checking its final notes.",
+            completed: true,
+          }),
+        });
+      } else {
+        harness.setNow(180_000);
+      }
+
+      const tick = harness.controller.tick();
+      try {
+        await vi.waitFor(
+          () => {
+            expect(harness.sendCalls()[0]?.[1]).toMatchObject({
+              to: DISCORD_ROUTE.to,
+              idempotencyKey: "lane-contract:checkpoint:run-1:commentary:item:1:completed",
+            });
+            if (progress === "natural commentary") {
+              expect(harness.sendCalls()[1]?.[1]).toMatchObject({
+                to: otherRoute.to,
+                message: "The independent review is complete; I am checking its final notes.",
+                idempotencyKey:
+                  "lane-contract:checkpoint:run-2:commentary:other-checkpoint:completed",
+              });
+            } else {
+              expect(harness.queueMessage).toHaveBeenCalledWith(
+                expect.objectContaining({ taskId: "task-2", runId: "run-2" }),
+              );
+            }
+          },
+          { timeout: 1_000, interval: 10 },
+        );
+      } finally {
+        delivery.resolve({ messageId: "provider-first-checkpoint" });
+        await tick;
+        harness.controller.dispose();
+      }
+    },
+  );
+
+  it.each(["unconfirmed", "rejected"] as const)(
+    "preserves newer pending commentary when an earlier send is %s",
+    async (outcome) => {
+      const harness = makeHarness();
+      const delivery = createDeferred<unknown>();
+      harness.sendResults.push(delivery.promise);
+      harness.setTasks(OWNER_SESSION, [makeTask()]);
+      await harness.receive();
+      await harness.start();
+      await harness.emitAgentEvent({});
+      const tick = harness.controller.tick();
+      try {
+        await vi.waitFor(() => expect(harness.sendCalls()).toHaveLength(1), {
+          timeout: 1_000,
+          interval: 10,
+        });
+        await harness.emitAgentEvent({
+          ...cliPreamble(2, {
+            itemId: "newer-checkpoint",
+            progressText: "The final checks passed; I am preparing the release notes.",
+            completed: true,
+          }),
+        });
+        expect(harness.sendCalls()).toHaveLength(1);
+
+        if (outcome === "unconfirmed") {
+          delivery.resolve({});
+        } else {
+          delivery.reject(new Error("send observation rejected"));
+        }
+        await tick;
+        await vi.waitFor(
+          async () => {
+            await harness.controller.tick();
+            expect(harness.sendCalls().map((call) => call[1].idempotencyKey)).toEqual([
+              "lane-contract:checkpoint:run-1:commentary:item:1:completed",
+              "lane-contract:checkpoint:run-1:commentary:newer-checkpoint:completed",
+            ]);
+          },
+          { timeout: 1_000, interval: 10 },
+        );
+        await harness.controller.tick();
+        expect(harness.sendCalls()).toHaveLength(2);
+        expect(harness.sendCalls()[1]?.[1]).toMatchObject({
+          message: "The final checks passed; I am preparing the release notes.",
+        });
+      } finally {
+        delivery.resolve({});
+        await tick;
+        harness.controller.dispose();
+      }
+    },
+  );
+
+  it.each(["dispose", "task identity loss"] as const)(
+    "does not revive a lane when its held send settles after %s",
+    async (change) => {
+      const harness = makeHarness();
+      const delivery = createDeferred<{ messageId: string }>();
+      harness.sendResults.push(delivery.promise);
+      harness.setTasks(OWNER_SESSION, [makeTask()]);
+      await harness.receive();
+      await harness.start();
+      await harness.emitAgentEvent({});
+      const tick = harness.controller.tick();
+      try {
+        await vi.waitFor(() => expect(harness.sendCalls()).toHaveLength(1), {
+          timeout: 1_000,
+          interval: 10,
+        });
+        await harness.emitAgentEvent({
+          ...cliPreamble(2, {
+            itemId: "queued-checkpoint",
+            progressText: "The review is complete; I am collecting the final evidence.",
+            completed: true,
+          }),
+        });
+        if (change === "dispose") {
+          harness.controller.dispose();
+        } else {
+          harness.setTasks(OWNER_SESSION, []);
+        }
+
+        delivery.resolve({ messageId: "provider-late-checkpoint" });
+        await harness.gatewayRequest.mock.results[0]?.value;
+        await tick;
+        harness.setTasks(OWNER_SESSION, [makeTask()]);
+        await harness.controller.tick();
+        await harness.emitAgentEvent({ seq: 3 });
+        harness.setNow(600_000);
+        await harness.controller.tick();
+
+        expect(harness.sendCalls().map((call) => call[1].idempotencyKey)).toEqual([
+          "lane-contract:checkpoint:run-1:commentary:item:1:completed",
+        ]);
+        expect(harness.queueMessage).not.toHaveBeenCalled();
+        expect(harness.registeredTool(harness.toolContext())).toBeNull();
+      } finally {
+        delivery.resolve({ messageId: "provider-late-checkpoint" });
+        await tick;
+        harness.controller.dispose();
+      }
+    },
+  );
+
+  it("waits out an unconfirmed send cooldown without replacing the last confirmed receipt", async () => {
+    const harness = makeHarness();
+    harness.setTasks(OWNER_SESSION, [makeTask()]);
+    await harness.receive();
+    await harness.start();
+    harness.setNow(10_000);
+    await harness.emitAgentEvent({});
+    await harness.controller.tick();
+    await harness.controller.tick();
+    harness.setNow(190_000);
+    await harness.controller.tick();
+    expect(harness.queueMessage).toHaveBeenCalledOnce();
+    const firstCue = harness.queueMessage.mock.calls[0]?.[0];
+
+    harness.setNow(200_000);
+    harness.sendResults.push({});
+    await harness.emitAgentEvent({
+      ...cliPreamble(2, {
+        itemId: "unconfirmed-checkpoint",
+        progressText: "The integration review is complete; I am checking the final packaging.",
+        completed: true,
+      }),
+    });
+    await harness.controller.tick();
+    await harness.controller.tick();
+    expect(firstCue?.signal.aborted).toBe(true);
+
+    harness.setNow(379_999);
+    await harness.controller.tick();
+    expect(harness.queueMessage).toHaveBeenCalledOnce();
+    harness.setNow(380_000);
+    await harness.controller.tick();
+    expect(harness.queueMessage).toHaveBeenCalledTimes(2);
+    expect(harness.queueMessage.mock.calls[1]?.[0]).toMatchObject({
+      queueIdentity: "lane-contract:progress:run-1:commentary:item:1:completed",
+    });
+    expect(harness.sendCalls().map((call) => call[1].idempotencyKey)).toEqual([
+      "lane-contract:checkpoint:run-1:commentary:item:1:completed",
+      "lane-contract:checkpoint:run-1:commentary:unconfirmed-checkpoint:completed",
+    ]);
+    harness.controller.dispose();
+  });
+});
diff --git a/extensions/lane-contract/src/detached-lane-runtime.test-support.ts b/extensions/lane-contract/src/detached-lane-runtime.test-support.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1533524f0afa32aa231e449eb72af39d5eebee2d
--- /dev/null
+++ b/extensions/lane-contract/src/detached-lane-runtime.test-support.ts
@@ -0,0 +1,267 @@
+import type { AnyAgentTool } from "openclaw/plugin-sdk/channel-entry-contract";
+import type {
+  OpenClawPluginApi,
+  OpenClawPluginToolContext,
+} from "openclaw/plugin-sdk/plugin-entry";
+import { createTestPluginApi } from "openclaw/plugin-sdk/plugin-test-api";
+import { expect, vi } from "vitest";
+import type { DetachedLaneCheckpointProjector } from "./detached-lane-checkpoint.js";
+import { registerDetachedLaneContract } from "./detached-lane-runtime.js";
+
+export type BoundTaskRuns = ReturnType<
+  OpenClawPluginApi["runtime"]["tasks"]["runs"]["bindSession"]
+>;
+type TaskRun = ReturnType<BoundTaskRuns["list"]>[number];
+type HookHandler = (event: unknown, ctx: unknown) => unknown;
+type AgentEventSubscription = Parameters<OpenClawPluginApi["registerAgentEventSubscription"]>[0];
+type RuntimeLifecycle = Parameters<OpenClawPluginApi["registerRuntimeLifecycle"]>[0];
+type ToolFactory = (
+  ctx: OpenClawPluginToolContext,
+) => AnyAgentTool | AnyAgentTool[] | null | undefined;
+
+export const OWNER_SESSION = "agent:main:discord:channel-1";
+export const CHILD_SESSION = "agent:main:subagent:child-1";
+const OWNER_SENDER = "discord-owner-1";
+type DiscordRoute = Readonly<{
+  channel: "discord";
+  to: string;
+  accountId: string;
+  threadId: string;
+}>;
+export const DISCORD_ROUTE: DiscordRoute = {
+  channel: "discord",
+  to: "channel-1",
+  accountId: "account-1",
+  threadId: "thread-1",
+};
+type CheckpointEvent = Parameters<DetachedLaneCheckpointProjector["projectCheckpoint"]>[0];
+
+export const assistantCommentary = (
+  seq: number,
+  data: Record<string, unknown>,
+): CheckpointEvent => ({
+  seq,
+  stream: "assistant",
+  data: { phase: "commentary", ...data },
+});
+export const cliPreamble = (seq: number, data: Record<string, unknown>): CheckpointEvent => ({
+  seq,
+  stream: "item",
+  data: { kind: "preamble", phase: "update", ...data },
+});
+export const toolStart = (
+  seq: number,
+  toolCallId: string,
+  data: Record<string, unknown> = {},
+): CheckpointEvent => ({ seq, stream: "tool", data: { phase: "start", toolCallId, ...data } });
+
+export function makeTask(overrides: Partial<TaskRun> = {}): TaskRun {
+  return {
+    id: "task-1",
+    runtime: "subagent",
+    sessionKey: CHILD_SESSION,
+    ownerKey: OWNER_SESSION,
+    scope: "session",
+    childSessionKey: CHILD_SESSION,
+    runId: "run-1",
+    title: "prepare the release",
+    status: "running",
+    deliveryStatus: "pending",
+    notifyPolicy: "done_only",
+    createdAt: 1,
+    startedAt: 2,
+    ...overrides,
+  };
+}
+
+export function makeHarness(options: { maxAttachmentBytes?: number } = {}) {
+  const hooks = new Map<string, HookHandler>();
+  const tasksByOwner = new Map<string, TaskRun[]>();
+  const sendResults: unknown[] = [];
+  const registerTool = vi.fn<OpenClawPluginApi["registerTool"]>();
+  const registerAgentEventSubscription =
+    vi.fn<OpenClawPluginApi["registerAgentEventSubscription"]>();
+  const registerRuntimeLifecycle = vi.fn<OpenClawPluginApi["registerRuntimeLifecycle"]>();
+  const warn = vi.fn();
+  const queueMessage = vi.fn<BoundTaskRuns["queueMessage"]>().mockResolvedValue({ queued: true });
+  const gatewayRequest = vi.fn(async (method: string, _params: Record<string, unknown>) => {
+    if (method === "send") {
+      return sendResults.length > 0
+        ? sendResults.shift()
+        : { messageId: `provider-${gatewayRequest.mock.calls.length}` };
+    }
+    return { status: "accepted" };
+  });
+  let now = 0;
+
+  const bindSession = (params: { sessionKey: string }): BoundTaskRuns => ({
+    sessionKey: params.sessionKey,
+    get: (taskId) => tasksByOwner.get(params.sessionKey)?.find((task) => task.id === taskId),
+    list: () => [...(tasksByOwner.get(params.sessionKey) ?? [])],
+    findLatest: () => tasksByOwner.get(params.sessionKey)?.at(-1),
+    resolve: (token) =>
+      tasksByOwner
+        .get(params.sessionKey)
+        ?.find((task) => task.id === token || task.runId === token),
+    cancel: async () => ({ found: false, cancelled: false }),
+    queueMessage,
+  });
+  const api = createTestPluginApi({
+    runtime: {
+      gateway: { request: gatewayRequest },
+      tasks: { runs: { bindSession } },
+    } as unknown as OpenClawPluginApi["runtime"],
+    logger: { info: vi.fn(), warn, error: vi.fn(), debug: vi.fn() },
+    on: ((hookName: string, handler: HookHandler) => {
+      hooks.set(hookName, handler);
+    }) as OpenClawPluginApi["on"],
+    registerTool,
+    registerAgentEventSubscription,
+    registerRuntimeLifecycle,
+  });
+  const controller = registerDetachedLaneContract(api, {
+    schedule: false,
+    now: () => now,
+    ...options,
+  });
+
+  const emitHook = async (name: string, event: unknown, ctx: unknown = {}) => {
+    const handler = hooks.get(name);
+    expect(handler, `hook ${name}`).toBeDefined();
+    await handler?.(event, ctx);
+  };
+  const receive = async (
+    params: {
+      messageId?: string;
+      sessionKey?: string;
+      content?: string;
+      route?: typeof DISCORD_ROUTE;
+      media?: Array<{ path?: string; contentType?: string }>;
+      mediaStagingPending?: boolean;
+    } = {},
+  ) => {
+    const route = params.route ?? DISCORD_ROUTE;
+    await emitHook(
+      "message_received",
+      {
+        from: "owner",
+        content: params.content ?? "start detached work",
+        messageId: params.messageId ?? "message-1",
+        senderId: OWNER_SENDER,
+        threadId: route.threadId,
+        media: params.media,
+        mediaStagingPending: params.mediaStagingPending,
+      },
+      {
+        channelId: route.channel,
+        accountId: route.accountId,
+        conversationId: route.to,
+        sessionKey: params.sessionKey ?? OWNER_SESSION,
+      },
+    );
+  };
+  const start = async (
+    params: {
+      runId?: string;
+      childSessionKey?: string;
+      messageId?: string;
+      route?: typeof DISCORD_ROUTE;
+      requesterSessionKey?: string;
+    } = {},
+  ) => {
+    const route = params.route ?? DISCORD_ROUTE;
+    await emitHook(
+      "subagent_progress",
+      {
+        phase: "started",
+        runId: params.runId ?? "run-1",
+        childSessionKey: params.childSessionKey ?? CHILD_SESSION,
+        requester: {
+          ...route,
+          messageId: params.messageId ?? "message-1",
+        },
+      },
+      {
+        requesterSessionKey: params.requesterSessionKey ?? "agent:proxy:sandbox",
+      },
+    );
+  };
+  const subscription = (): AgentEventSubscription => {
+    const value = registerAgentEventSubscription.mock.calls[0]?.[0];
+    expect(value).toBeDefined();
+    return value as AgentEventSubscription;
+  };
+  const emitAgentEvent = async (event: {
+    runId?: string;
+    sessionKey?: string;
+    seq?: number;
+    stream?: string;
+    data?: Record<string, unknown>;
+  }) => {
+    const sessionKey = Object.hasOwn(event, "sessionKey") ? event.sessionKey : CHILD_SESSION;
+    await subscription().handle(
+      {
+        runId: event.runId ?? "run-1",
+        ...(sessionKey ? { sessionKey } : {}),
+        seq: event.seq ?? 1,
+        stream: event.stream ?? "item",
+        ts: now,
+        data:
+          event.data ??
+          ({
+            kind: "preamble",
+            phase: "update",
+            progressText: "I've finished the first pass and am checking the remaining edge cases.",
+            completed: true,
+          } as const),
+      },
+      {
+        getRunContext: () => undefined,
+        setRunContext: () => undefined,
+        clearRunContext: () => undefined,
+      },
+    );
+  };
+  const registeredTool = (ctx: OpenClawPluginToolContext): AnyAgentTool | null => {
+    const registration = registerTool.mock.calls[0]?.[0];
+    expect(typeof registration).toBe("function");
+    const tool = (registration as ToolFactory)(ctx);
+    expect(Array.isArray(tool)).toBe(false);
+    return (tool ?? null) as AnyAgentTool | null;
+  };
+  const toolContext = (overrides: Partial<OpenClawPluginToolContext> = {}) => ({
+    messageChannel: "discord",
+    sessionKey: "agent:sandbox:proxy",
+    deliveryContext: DISCORD_ROUTE,
+    requesterSenderId: OWNER_SENDER,
+    senderIsOwner: true,
+    ...overrides,
+  });
+  const sendCalls = () => gatewayRequest.mock.calls.filter(([method]) => method === "send");
+  const steerCalls = () =>
+    gatewayRequest.mock.calls.filter(([method]) => method === "sessions.steer");
+
+  return {
+    controller,
+    emitAgentEvent,
+    emitHook,
+    gatewayRequest,
+    queueMessage,
+    lifecycle: () => registerRuntimeLifecycle.mock.calls[0]?.[0] as RuntimeLifecycle,
+    receive,
+    registeredTool,
+    sendCalls,
+    sendResults,
+    setNow: (value: number) => {
+      now = value;
+    },
+    setTasks: (owner: string, tasks: TaskRun[]) => {
+      tasksByOwner.set(owner, tasks);
+    },
+    start,
+    steerCalls,
+    subscription,
+    toolContext,
+    warn,
+  };
+}

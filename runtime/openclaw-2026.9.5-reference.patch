diff --git a/extensions/active-memory/index.search-snippet.test-support.ts b/extensions/active-memory/index.search-snippet.test-support.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ce8f624af18320b4f1949d860ac52e95b79a50c8
--- /dev/null
+++ b/extensions/active-memory/index.search-snippet.test-support.ts
@@ -0,0 +1,215 @@
+import { createDeferred } from "openclaw/plugin-sdk/extension-shared";
+import type { SessionTranscriptTargetParams } from "openclaw/plugin-sdk/session-transcript-runtime";
+import { expect, it, vi } from "vitest";
+import type { ToolEvidenceHarness } from "./index.tool-evidence.test-support.js";
+import * as recallRun from "./recall-run.js";
+import * as recall from "./recall.js";
+
+// Reuse the registered hook's existing provider and real SDK SQLite fixture.
+export function registerSearchSnippetTimeoutTests(harness: ToolEvidenceHarness): void {
+  const {
+    testing,
+    hoisted,
+    runEmbeddedAgent,
+    registerPluginConfig,
+    seedSession,
+    writeRuntimeTranscript,
+    waitForAbort,
+    runPromptBuild,
+    requirePrependContext,
+    getInfoLines,
+  } = harness;
+  const unpairedSurrogate =
+    /[\uD800-\uDBFF](?![\uDC00-\uDFFF])|(?<![\uD800-\uDBFF])[\uDC00-\uDFFF]/;
+
+  it.each([
+    "callback",
+    "transcript",
+    "ordered",
+    "large",
+    "unknown",
+    "failed",
+    "unavailable",
+    "denied",
+    "parent-abort",
+    "closed-authority",
+  ] as const)("preserves search snippet timeout evidence for %s", async (mode) => {
+    vi.useFakeTimers({ toFake: ["Date", "setTimeout", "clearTimeout"] });
+    testing.setMinimumTimeoutMsForTests(1);
+    testing.setSetupGraceTimeoutMsForTests(0);
+    testing.setTimeoutPartialDataGraceMsForTests(50);
+    registerPluginConfig({ timeoutMs: 100, logging: true });
+    const sessionRuntime = await vi.importActual<
+      typeof import("openclaw/plugin-sdk/session-store-runtime")
+    >("openclaw/plugin-sdk/session-store-runtime");
+    const transcriptRuntime = await vi.importActual<
+      typeof import("openclaw/plugin-sdk/session-transcript-runtime")
+    >("openclaw/plugin-sdk/session-transcript-runtime");
+    hoisted.patchSessionEntry.mockImplementationOnce(sessionRuntime.patchSessionEntry);
+    hoisted.cleanupSessionLifecycleArtifacts.mockImplementationOnce(
+      sessionRuntime.cleanupSessionLifecycleArtifacts,
+    );
+    const parent = new AbortController();
+    if (mode === "parent-abort") {
+      const resolveRecall = recall.maybeResolveActiveRecall;
+      vi.spyOn(recall, "maybeResolveActiveRecall").mockImplementation((params) =>
+        resolveRecall({
+          ...params,
+          abortSignal: AbortSignal.any([
+            ...(params.abortSignal ? [params.abortSignal] : []),
+            parent.signal,
+          ]),
+        }),
+      );
+    }
+    const run = vi.spyOn(recallRun, "runRecallSubagent");
+    const sessionKey = `agent:main:search-snippet-${mode}`;
+    seedSession(sessionKey, `s-search-snippet-${mode}`, 0);
+    const written = createDeferred<SessionTranscriptTargetParams>();
+    runEmbeddedAgent.mockImplementationOnce(
+      async (params: {
+        sessionTarget: SessionTranscriptTargetParams;
+        abortSignal?: AbortSignal;
+        onAgentToolResult?: (event: {
+          toolName: string;
+          result: unknown;
+          isError: boolean;
+        }) => void;
+      }) => {
+        const snippet =
+          mode === "large"
+            ? `Selected model remains Sol 6.1 at Maximum. ${"🎉".repeat(18_000)}TAIL`
+            : "Selected model remains Sol 6.1 at Maximum.";
+        const results =
+          mode === "unknown"
+            ? [{ opaque: "PUBLIC_UNKNOWN_SHAPE", snippet: 42 }]
+            : mode === "ordered"
+              ? [
+                  { path: "memory/first.md", snippet: "First ranked candidate." },
+                  { path: "memory/second.md", snippet: "Second ranked candidate." },
+                ]
+              : [
+                  {
+                    path: "memory/decision.md",
+                    startLine: 32,
+                    endLine: 36,
+                    score: 0.7001361191272735,
+                    vectorScore: 0.5716230273246765,
+                    textScore: 0.8604869493109811,
+                    snippet,
+                    source: "memory",
+                  },
+                ];
+        const content = [{ type: "text", text: JSON.stringify({ results }, null, 2) }];
+        const result = { content, details: { text: "PRIVATE_RUNTIME_DETAILS" } };
+        if (mode !== "transcript") {
+          params.onAgentToolResult?.({
+            toolName: "memory_search",
+            result,
+            isError: mode === "failed",
+          });
+        }
+        const records: Parameters<typeof writeRuntimeTranscript>[0] =
+          mode === "callback"
+            ? []
+            : [
+                {
+                  message: {
+                    role: "toolResult",
+                    toolName: "memory_search",
+                    ...result,
+                    isError: mode === "failed",
+                  },
+                },
+              ];
+        if (mode === "unavailable") {
+          const unavailable = { content: [{ type: "text", text: '{"disabled":true}' }] };
+          params.onAgentToolResult?.({
+            toolName: "memory_search",
+            result: unavailable,
+            isError: false,
+          });
+          records.push({
+            message: {
+              role: "toolResult",
+              toolName: "memory_search",
+              content: unavailable.content,
+              isError: false,
+            },
+          });
+        }
+        written.resolve(await writeRuntimeTranscript(records, params.sessionTarget));
+        return await waitForAbort(params.abortSignal);
+      },
+    );
+    let authorityActive = true;
+    const resultPromise = runPromptBuild(
+      { prompt: `Which model did I choose? search snippet ${mode}` },
+      {
+        sessionKey,
+        toolAuthority: {
+          fingerprint: `search-snippet-${mode}`,
+          allows: (tool: string) => mode !== "denied" || tool !== "memory_search",
+          assertActive: () => {
+            if (!authorityActive) {
+              throw new Error("turn authority closed");
+            }
+          },
+        },
+      },
+    );
+    const target = await written.promise;
+    if (mode === "closed-authority") {
+      authorityActive = false;
+    }
+    if (mode === "parent-abort") {
+      parent.abort(new Error("owner cancelled recall"));
+    }
+    try {
+      await vi.advanceTimersByTimeAsync(100);
+      const result = await resultPromise;
+      if (["failed", "unavailable", "denied", "parent-abort", "closed-authority"].includes(mode)) {
+        expect(result).toBeUndefined();
+      } else {
+        const context = requirePrependContext(result);
+        expect(context).toContain("Retrieved memory_search result:");
+        expect(context).not.toContain("PRIVATE_RUNTIME_DETAILS");
+        if (mode === "unknown") {
+          expect(context).toContain("PUBLIC_UNKNOWN_SHAPE");
+        } else if (mode === "ordered") {
+          expect(context).toContain("First ranked candidate.");
+          expect(context).toContain("Second ranked candidate.");
+          expect(context.indexOf("First ranked")).toBeLessThan(context.indexOf("Second ranked"));
+          expect(context).toContain("memory/first.md");
+          expect(context).toContain("memory/second.md");
+        } else {
+          expect(context).toContain("Selected model remains Sol 6.1 at Maximum.");
+          if (mode !== "large") {
+            expect(context).toContain("memory/decision.md");
+          }
+          expect(context).not.toContain("vectorScore");
+          expect(context).not.toContain("textScore");
+          expect(context).not.toContain("TAIL");
+        }
+        const size = Number(
+          /done status=timeout_partial.*summaryChars=(\d+)/.exec(getInfoLines())?.[1],
+        );
+        expect(size).toBeGreaterThan(0);
+        expect(size).toBeLessThanOrEqual(220);
+        const settled = await Promise.allSettled(run.mock.results.map(({ value }) => value));
+        const error = settled[0]?.status === "rejected" ? settled[0].reason : undefined;
+        expect(error?.activeMemoryPartialData.memoryToolText.length).toBeLessThanOrEqual(32_000);
+        expect(error?.activeMemoryPartialData.memoryToolText).not.toMatch(unpairedSurrogate);
+        expect(error?.activeMemoryPartialData.memoryToolText).not.toContain(
+          "PRIVATE_RUNTIME_DETAILS",
+        );
+      }
+      expect(runEmbeddedAgent).toHaveBeenCalledOnce();
+    } finally {
+      // Parent cancellation can return before the child finally joins cleanup.
+      await Promise.allSettled(run.mock.results.map(({ value }) => value));
+    }
+    expect(sessionRuntime.getSessionEntry(target)).toBeUndefined();
+    expect(await transcriptRuntime.readSessionTranscriptEvents(target)).toEqual([]);
+  });
+}

@@ -0,0 +1,774 @@
+import { rm, writeFile } from "node:fs/promises";
+import path from "node:path";
+import { createDeferred } from "openclaw/plugin-sdk/extension-shared";
+import { useAutoCleanupTempDirTracker } from "openclaw/plugin-sdk/test-env";
+import { afterEach, describe, expect, it } from "vitest";
+import {
+  type BoundTaskRuns,
+  CHILD_SESSION,
+  DISCORD_ROUTE,
+  OWNER_SESSION,
+  assistantCommentary,
+  cliPreamble,
+  makeHarness,
+  makeTask,
+  toolStart,
+} from "./detached-lane-runtime.test-support.js";
+
+const tempDirs = useAutoCleanupTempDirTracker(afterEach);
+
+describe("detached Discord lane contract", () => {
+  it("requests one overdue checkpoint and delivers the child's normal commentary through its relay", async () => {
+    const harness = makeHarness();
+    harness.setTasks(OWNER_SESSION, [makeTask()]);
+    await harness.receive();
+    await harness.start();
+    harness.setNow(179_999);
+    await harness.controller.tick();
+    expect(harness.queueMessage).not.toHaveBeenCalled();
+    harness.setNow(180_000);
+    await harness.controller.tick();
+    expect(harness.queueMessage).toHaveBeenCalledOnce();
+    const cue = harness.queueMessage.mock.calls[0]?.[0];
+    expect(cue).toMatchObject({ taskId: "task-1", runId: "run-1" });
+    expect(cue?.canInject()).toBe(true);
+    expect(harness.sendCalls()).toHaveLength(0);
+    expect(harness.steerCalls()).toHaveLength(0);
+
+    harness.setNow(600_000);
+    await harness.emitAgentEvent({ ...toolStart(1, "browser-1", { name: "browser" }) });
+    await harness.controller.tick();
+    expect(harness.queueMessage).toHaveBeenCalledOnce();
+    await harness.emitAgentEvent({
+      ...cliPreamble(2, {
+        itemId: "real-checkpoint",
+        progressText: "The desktop swap quote works. I am checking the mobile layout next.",
+      }),
+    });
+    await harness.emitAgentEvent({ ...toolStart(3, "browser-2", { name: "browser" }) });
+    expect(cue?.canInject()).toBe(false);
+    await harness.controller.tick();
+    expect(harness.sendCalls()).toHaveLength(1);
+    expect(harness.sendCalls()[0]?.[1]).toMatchObject({
+      message: "The desktop swap quote works. I am checking the mobile layout next.",
+      idempotencyKey: "lane-contract:checkpoint:run-1:commentary:real-checkpoint:completed",
+    });
+    expect(harness.gatewayRequest).toHaveBeenCalledWith(
+      "send",
+      expect.objectContaining({
+        idempotencyKey: "lane-contract:checkpoint:run-1:commentary:real-checkpoint:completed",
+      }),
+      { timeoutMs: 60_000 },
+    );
+    expect(cue?.signal.aborted).toBe(true);
+    harness.setNow(780_000);
+    await harness.controller.tick();
+    expect(harness.queueMessage).toHaveBeenCalledTimes(2);
+  });
+
+  it.each(["terminal", "replacement", "detach"] as const)(
+    "withdraws an outstanding checkpoint request when its lane is %s",
+    async (change) => {
+      const harness = makeHarness();
+      harness.setTasks(OWNER_SESSION, [makeTask()]);
+      await harness.receive();
+      await harness.start();
+      harness.setNow(180_000);
+      await harness.controller.tick();
+      const cue = harness.queueMessage.mock.calls[0]?.[0];
+      expect(cue?.canInject()).toBe(true);
+      if (change === "terminal") {
+        harness.setTasks(OWNER_SESSION, [makeTask({ status: "succeeded" })]);
+      } else if (change === "replacement") {
+        harness.setTasks(OWNER_SESSION, [makeTask({ runId: "replacement-run" })]);
+      } else {
+        harness.controller.dispose();
+      }
+      expect(cue?.canInject()).toBe(false);
+      await harness.controller.tick();
+      expect(cue?.signal.aborted).toBe(true);
+      expect(harness.queueMessage).toHaveBeenCalledOnce();
+      expect(harness.sendCalls()).toHaveLength(0);
+    },
+  );
+
+  it("observes rejected checkpoint injection without retrying the same visibility gap", async () => {
+    const harness = makeHarness();
+    const delivery = createDeferred<Awaited<ReturnType<BoundTaskRuns["queueMessage"]>>>();
+    harness.queueMessage.mockReturnValue(delivery.promise);
+    harness.setTasks(OWNER_SESSION, [makeTask()]);
+    await harness.receive();
+    await harness.start();
+    harness.setNow(180_000);
+    await harness.controller.tick();
+    await Promise.resolve();
+    harness.setNow(360_000);
+    await harness.controller.tick();
+    expect(harness.queueMessage).toHaveBeenCalledOnce();
+    delivery.resolve({ queued: false, reason: "compacting" });
+    await Promise.resolve();
+    await harness.controller.tick();
+    expect(harness.queueMessage).toHaveBeenCalledOnce();
+    expect(harness.warn).toHaveBeenCalledWith(
+      "lane-contract checkpoint request rejected: compacting",
+    );
+    expect(harness.sendCalls()).toHaveLength(0);
+  });
+
+  it.each(["subagent", "acp"] as const)(
+    "silently joins a %s run through the exact inbound owner despite proxy hook custody",
+    async (runtime) => {
+      const harness = makeHarness();
+      harness.setTasks(OWNER_SESSION, [makeTask({ runtime })]);
+      await harness.receive();
+
+      await harness.start({ requesterSessionKey: "agent:unrelated:proxy" });
+      await harness.start({ requesterSessionKey: "agent:another:proxy" });
+      await harness.emitHook(
+        "subagent_spawned",
+        {
+          runId: "run-1",
+          childSessionKey: CHILD_SESSION,
+          agentId: "main",
+          mode: "run",
+          threadRequested: false,
+          requester: DISCORD_ROUTE,
+        },
+        { requesterSessionKey: "agent:proxy:sandbox" },
+      );
+
+      expect(harness.sendCalls()).toHaveLength(0);
+    },
+  );
+
+  it("reconciles a split plugin generation into the root lane and relays natural progress", async () => {
+    const root = makeHarness();
+    const modelGeneration = makeHarness();
+    root.setNow(100);
+    modelGeneration.setNow(100);
+    await root.receive();
+    const task = makeTask({ createdAt: 101 });
+    root.setTasks(OWNER_SESSION, [task]);
+    modelGeneration.setTasks(OWNER_SESSION, [task]);
+
+    await modelGeneration.start({ requesterSessionKey: OWNER_SESSION });
+    expect(modelGeneration.sendCalls()).toHaveLength(0);
+
+    root.setNow(101);
+    await root.emitAgentEvent({
+      runId: "parent-run",
+      sessionKey: OWNER_SESSION,
+      stream: "lifecycle",
+      data: { phase: "end" },
+    });
+    expect(root.sendCalls()).toHaveLength(0);
+    expect(root.registeredTool(root.toolContext())).toBeNull();
+
+    await root.emitAgentEvent({ seq: 7 });
+    await root.controller.tick();
+    expect(root.sendCalls()[0]?.[1]).toMatchObject({
+      message: "I've finished the first pass and am checking the remaining edge cases.",
+      idempotencyKey: "lane-contract:checkpoint:run-1:commentary:item:7:completed",
+    });
+
+    root.setNow(10_000_000);
+    await root.controller.tick();
+    expect(root.sendCalls()).toHaveLength(1);
+
+    await root.emitHook("agent_end", {}, { sessionKey: OWNER_SESSION });
+    await root.controller.tick();
+    expect(root.sendCalls()).toHaveLength(1);
+  });
+
+  it("reconciles silently at parent agent end before clearing the inbound turn", async () => {
+    const root = makeHarness();
+    root.setNow(200);
+    await root.receive();
+    root.setTasks(OWNER_SESSION, [makeTask({ createdAt: 201 })]);
+    root.setNow(201);
+
+    await root.emitHook("agent_end", {}, { sessionKey: OWNER_SESSION });
+    await root.controller.tick();
+
+    expect(root.sendCalls()).toHaveLength(0);
+  });
+
+  it("releases a completed split lane so the next inbound turn can reconcile", async () => {
+    const root = makeHarness();
+    root.setNow(600);
+    await root.receive({ messageId: "message-1" });
+    const firstTask = makeTask({ createdAt: 601 });
+    root.setTasks(OWNER_SESSION, [firstTask]);
+    root.setNow(601);
+    await root.controller.tick();
+    expect(root.sendCalls()).toHaveLength(0);
+
+    firstTask.status = "succeeded";
+    firstTask.deliveryStatus = "delivered";
+    await root.controller.tick();
+
+    root.setNow(700);
+    await root.receive({ messageId: "message-2" });
+    const secondTask = makeTask({
+      id: "task-2",
+      runId: "run-2",
+      childSessionKey: "agent:main:subagent:child-2",
+      createdAt: 701,
+    });
+    root.setTasks(OWNER_SESSION, [firstTask, secondTask]);
+    root.setNow(701);
+    await root.controller.tick();
+
+    await root.emitAgentEvent({
+      runId: "run-2",
+      sessionKey: "agent:main:subagent:child-2",
+      seq: 2,
+    });
+    await root.controller.tick();
+    expect(root.sendCalls()).toHaveLength(1);
+    expect(root.sendCalls()[0]?.[1]).toMatchObject({
+      idempotencyKey: "lane-contract:checkpoint:run-2:commentary:item:2:completed",
+    });
+  });
+
+  it("fails closed for stale tasks, multiple fresh tasks, and overlapping inbound turns", async () => {
+    const stale = makeHarness();
+    stale.setNow(300);
+    await stale.receive();
+    stale.setTasks(OWNER_SESSION, [makeTask({ createdAt: 299 })]);
+    await stale.controller.tick();
+    expect(stale.sendCalls()).toHaveLength(0);
+
+    const multiple = makeHarness();
+    multiple.setNow(400);
+    await multiple.receive();
+    multiple.setTasks(OWNER_SESSION, [
+      makeTask({ createdAt: 401 }),
+      makeTask({ id: "task-duplicate", runId: "run-2", createdAt: 402 }),
+    ]);
+    multiple.setNow(402);
+    await multiple.controller.tick();
+    expect(multiple.sendCalls()).toHaveLength(0);
+
+    const overlapping = makeHarness();
+    overlapping.setNow(500);
+    await overlapping.receive({ messageId: "message-1" });
+    overlapping.setNow(501);
+    await overlapping.receive({ messageId: "message-2" });
+    const blockedTask = makeTask({ createdAt: 502 });
+    overlapping.setTasks(OWNER_SESSION, [blockedTask]);
+    overlapping.setNow(502);
+    await overlapping.controller.tick();
+    expect(overlapping.sendCalls()).toHaveLength(0);
+
+    await overlapping.emitAgentEvent({
+      runId: "parent-run",
+      sessionKey: OWNER_SESSION,
+      stream: "lifecycle",
+      data: { phase: "end" },
+    });
+    blockedTask.status = "succeeded";
+    blockedTask.deliveryStatus = "delivered";
+    overlapping.setNow(600);
+    await overlapping.receive({ messageId: "message-3" });
+    overlapping.setTasks(OWNER_SESSION, [
+      blockedTask,
+      makeTask({
+        id: "task-3",
+        runId: "run-3",
+        childSessionKey: "agent:main:subagent:child-3",
+        createdAt: 601,
+      }),
+    ]);
+    overlapping.setNow(601);
+    await overlapping.controller.tick();
+    await overlapping.emitAgentEvent({
+      runId: "run-3",
+      sessionKey: "agent:main:subagent:child-3",
+      seq: 3,
+    });
+    await overlapping.controller.tick();
+    expect(overlapping.sendCalls()[0]?.[1]).toMatchObject({
+      idempotencyKey: "lane-contract:checkpoint:run-3:commentary:item:3:completed",
+    });
+  });
+
+  it("fails closed for foreground, mismatched, and ambiguous identities", async () => {
+    const harness = makeHarness();
+    harness.setTasks(OWNER_SESSION, [makeTask({ runtime: "cron" })]);
+    await harness.receive();
+    await harness.start();
+    await harness.start({ messageId: "wrong-message" });
+    await harness.start({
+      route: { ...DISCORD_ROUTE, threadId: "other-thread" },
+    });
+    expect(harness.sendCalls()).toHaveLength(0);
+
+    harness.setTasks(OWNER_SESSION, [makeTask()]);
+    const otherOwner = "agent:other:discord:channel-1";
+    harness.setTasks(otherOwner, [makeTask({ ownerKey: otherOwner, id: "task-2" })]);
+    await harness.receive({ sessionKey: otherOwner });
+    await harness.start();
+    expect(harness.sendCalls()).toHaveLength(0);
+  });
+
+  it("keeps a bound lane silent until meaningful natural commentary exists", async () => {
+    const harness = makeHarness();
+    harness.setTasks(OWNER_SESSION, [makeTask()]);
+    await harness.receive();
+    await harness.start();
+    await harness.start();
+    await harness.emitAgentEvent({
+      sessionKey: undefined,
+      data: { phase: "result", isError: false, result: "private child output" },
+    });
+
+    await harness.controller.tick();
+    await harness.controller.tick();
+    expect(harness.sendCalls()).toHaveLength(0);
+  });

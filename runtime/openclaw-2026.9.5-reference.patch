+/** Ordinary completion retains the session; its tab cleanup remains revocable. */
+export async function cleanupBrowserSessionsForTaskCompletion(params: {
+  cfg: OpenClawConfig;
+  sessionKey: string | undefined;
+  storePath: string | undefined;
+  agentId?: string;
+  runId: string;
+  lifecycleGeneration: string;
+  expectedSession: Pick<InternalSessionEntry, "sessionId" | "lifecycleRevision">;
+  completedAt: number;
+  queueKey?: string;
+  activeQueueSource?: FollowupRun;
+  isCurrent: () => boolean;
+  onWarn?: (message: string) => void;
+  onError?: (error: unknown) => void;
+}): Promise<void> {
+  if (
+    isBrowserCleanupDisabled(params.cfg) ||
+    params.cfg.browser?.tabCleanup?.enabled === false ||
+    !params.sessionKey?.trim() ||
+    !params.storePath ||
+    !params.isCurrent()
+  ) {
+    return;
+  }
+  const sessionKey = params.sessionKey.trim();
+  await runBestEffortCleanup({
+    cleanup: async () => {
+      const [sessions, keys, events, runs, replies, queue, children] = await Promise.all([
+        import("./config/sessions/session-accessor.js"),
+        import("./sessions/session-key-utils.js"),
+        import("./infra/agent-events.js"),
+        import("./agents/embedded-agent-runner/runs.js"),
+        import("./auto-reply/reply/reply-run-registry.js"),
+        import("./auto-reply/reply/queue/state.js"),
+        import("./agents/subagents/registry/subagent-registry-read.js"),
+      ]);
+      if (
+        keys.isSubagentSessionKey(sessionKey) ||
+        keys.isCronSessionKey(sessionKey) ||
+        keys.isAcpSessionKey(sessionKey)
+      ) {
+        return;
+      }
+      const isCurrent = () => {
+        const hasPendingFollowup = [
+          sessionKey,
+          params.expectedSession.sessionId,
+          params.queueKey,
+        ].some((key) => {
+          if (!key) {
+            return false;
+          }
+          const pending = queue.getExistingFollowupQueue(key);
+          if (!pending) {
+            return false;
+          }
+          const admission = queue.inspectFollowupQueueAdmission(key, {
+            activeSource: params.activeQueueSource,
+          });
+          const isFinishingSource = (item: FollowupRun) =>
+            admission.excludedActiveSource &&
+            item === params.activeQueueSource &&
+            !item.steerPending;
+          // Admission readiness intentionally hides parked steers. Completion
+          // must preserve every retained input, including waiting/injecting work.
+          return (
+            pending.items.some((item) => !isFinishingSource(item)) ||
+            [...pending.inFlight].some((item) => !isFinishingSource(item)) ||
+            pending.droppedCount > 0
+          );
+        });
+        if (
+          !params.isCurrent() ||
+          events.getAgentEventLifecycleGeneration() !== params.lifecycleGeneration ||
+          hasPendingFollowup ||
+          replies.replyRunRegistry.get(sessionKey) ||
+          children.hasDescendantRunAwaitingSettle(sessionKey, undefined, params.agentId) ||
+          children.hasPendingRequesterYieldContinuation(sessionKey, params.agentId)
+        ) {
+          return false;
+        }
+        const entry: InternalSessionEntry | undefined = sessions.loadSessionEntryReadOnly({
+          storePath: params.storePath,
+          sessionKey,
+          agentId: params.agentId,
+          readConsistency: "latest",
+        });
+        if (
+          !entry ||
+          entry.sessionId !== params.expectedSession.sessionId ||
+          entry.lifecycleRevision !== params.expectedSession.lifecycleRevision ||
+          // The admitted writer, rather than a possibly stale presentation
+          // snapshot, owns this completion. Unknown legacy owners stay intact.
+          entry.activeWriterRunId !== params.runId ||
+          (entry.lifecycleRunId !== undefined && entry.lifecycleRunId !== params.runId) ||
+          (entry.lastInteractionAt !== undefined && entry.lastInteractionAt > params.completedAt) ||
+          (entry.goal && entry.goal.status !== "complete") ||
+          entry.pendingFinalDelivery ||
+          entry.pendingDeliveryNotice ||
+          entry.restartRecoveryDeliveryRunId ||
+          entry.mainRestartRecovery
+        ) {
+          return false;
+        }
+        const active = runs.resolveActiveEmbeddedRunOwner(entry.sessionId);
+        return !active || active.runId === params.runId;
+      };
+      if (!isCurrent()) {
+        return;
+      }
+      await closeTrackedBrowserTabsForSessions({
+        sessionKeys: [sessionKey],
+        taskCompletion: { completedAt: params.completedAt, isCurrent },
+        onWarn: params.onWarn,
+      });
+    },
+    onError: params.onError,
+  });
+}
+
 function isBrowserCleanupDisabled(cfg: OpenClawConfig | undefined): boolean {
   return cfg?.browser?.enabled === false || cfg?.plugins?.entries?.browser?.enabled === false;
 }
diff --git a/src/browser-task-completion-cleanup.test.ts b/src/browser-task-completion-cleanup.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5e3196684f3e4878f4be53fe7620d022392de16b
--- /dev/null
+++ b/src/browser-task-completion-cleanup.test.ts
@@ -0,0 +1,225 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import {
+  clearFollowupQueue,
+  getFollowupQueue,
+  inspectFollowupQueueAdmission,
+} from "./auto-reply/reply/queue/state.js";
+import { createMockFollowupRun } from "./auto-reply/reply/test-helpers.js";
+import { cleanupBrowserSessionsForTaskCompletion } from "./browser-lifecycle-cleanup.js";
+import type { InternalSessionEntry, SessionGoalStatus } from "./config/sessions/types.js";
+import type { BrowserTaskCompletionCleanup } from "./plugin-sdk/browser-maintenance.js";
+
+const owner = vi.hoisted(() => ({
+  entry: undefined as InternalSessionEntry | undefined,
+  generation: "current",
+  activeRunId: undefined as string | undefined,
+  reply: false,
+  descendants: false,
+  continuation: false,
+}));
+const close = vi.hoisted(() =>
+  vi.fn(
+    async (_params: {
+      sessionKeys: Array<string | undefined>;
+      taskCompletion?: BrowserTaskCompletionCleanup;
+    }) => 0,
+  ),
+);
+vi.mock("./plugin-sdk/browser-maintenance.js", () => ({
+  closeTrackedBrowserTabsForSessions: close,
+}));
+vi.mock("./config/sessions/session-accessor.js", () => ({
+  loadSessionEntryReadOnly: () => owner.entry,
+}));
+vi.mock("./infra/agent-events.js", () => ({
+  getAgentEventLifecycleGeneration: () => owner.generation,
+}));
+vi.mock("./agents/embedded-agent-runner/runs.js", () => ({
+  resolveActiveEmbeddedRunOwner: () =>
+    owner.activeRunId ? { runId: owner.activeRunId } : undefined,
+}));
+vi.mock("./auto-reply/reply/reply-run-registry.js", () => ({
+  replyRunRegistry: { get: () => owner.reply },
+}));
+vi.mock("./agents/subagents/registry/subagent-registry-read.js", () => ({
+  hasDescendantRunAwaitingSettle: () => owner.descendants,
+  hasPendingRequesterYieldContinuation: () => owner.continuation,
+}));
+
+function request() {
+  return {
+    cfg: {},
+    sessionKey: "agent:main:primary",
+    storePath: "/fixture/openclaw-agent.sqlite",
+    agentId: "main",
+    runId: "finished",
+    lifecycleGeneration: "current",
+    expectedSession: { sessionId: "session", lifecycleRevision: "revision" },
+    completedAt: 20,
+    isCurrent: () => true,
+  };
+}
+
+function queuedSource() {
+  const source = createMockFollowupRun();
+  const queue = getFollowupQueue(request().sessionKey, { mode: "followup", cap: 10 });
+  // The drain deliberately retains its in-flight source in items through delivery.
+  queue.items.push(source);
+  queue.inFlight.add(source);
+  return { source, queue };
+}
+
+describe("ordinary browser task completion ownership", () => {
+  beforeEach(() => {
+    clearFollowupQueue(request().sessionKey);
+    vi.clearAllMocks();
+    Object.assign(owner, {
+      entry: {
+        ...request().expectedSession,
+        activeWriterRunId: "finished",
+        lastInteractionAt: 10,
+        updatedAt: 20,
+      },
+      generation: "current",
+      activeRunId: undefined,
+      reply: false,
+      descendants: false,
+      continuation: false,
+    });
+  });
+  afterEach(() => clearFollowupQueue(request().sessionKey));
+
+  it("passes a still-revocable exact terminal owner to tracked cleanup", async () => {
+    await cleanupBrowserSessionsForTaskCompletion(request());
+    expect(close).toHaveBeenCalledOnce();
+    const completion = close.mock.calls[0]?.[0].taskCompletion;
+    expect(completion?.completedAt).toBe(20);
+    expect(completion?.isCurrent()).toBe(true);
+    owner.entry = { ...owner.entry!, activeWriterRunId: "followup" };
+    expect(completion?.isCurrent()).toBe(false);
+  });
+
+  it.each([
+    "active",
+    "paused",
+    "blocked",
+    "usage_limited",
+    "budget_limited",
+  ] satisfies SessionGoalStatus[])("preserves an unfinished %s goal", async (status) => {
+    owner.entry!.goal = {
+      schemaVersion: 1,
+      id: "goal",
+      objective: "finish the project",
+      status,
+      createdAt: 1,
+      updatedAt: 1,
+      tokenStart: 0,
+      tokensUsed: 0,
+      continuationTurns: 0,
+    };
+    await cleanupBrowserSessionsForTaskCompletion(request());
+    expect(close).not.toHaveBeenCalled();
+  });
+
+  it.each(["reply", "descendants", "continuation"] as const)(
+    "preserves work still owned by %s",
+    async (field) => {
+      owner[field] = true;
+      await cleanupBrowserSessionsForTaskCompletion(request());
+      expect(close).not.toHaveBeenCalled();
+    },
+  );
+
+  it.each([
+    { sessionId: "replacement" },
+    { lifecycleRevision: "replacement" },
+    { activeWriterRunId: "replacement" },
+    { activeWriterRunId: undefined },
+    { lifecycleRunId: "replacement" },
+    { lastInteractionAt: 21 },
+    { restartRecoveryDeliveryRunId: "recovery" },
+    { pendingFinalDelivery: { kind: "transport-only" as const, createdAt: 20 } },
+  ])("refuses a changed or unsettled durable owner: %j", async (patch) => {
+    owner.entry = { ...owner.entry!, ...patch };
+    await cleanupBrowserSessionsForTaskCompletion(request());
+    expect(close).not.toHaveBeenCalled();
+  });
+
+  it("lets the exact last queued source finish, but revokes for any other queued work", async () => {
+    const { source, queue } = queuedSource();
+    await cleanupBrowserSessionsForTaskCompletion({
+      ...request(),
+      activeQueueSource: source,
+    });
+    expect(close).toHaveBeenCalledOnce();
+    const completion = close.mock.calls[0]?.[0].taskCompletion;
+    expect(completion?.isCurrent()).toBe(true);
+    queue.items.push(createMockFollowupRun());
+    expect(completion?.isCurrent()).toBe(false);
+  });
+
+  it("does not mistake a different queued source for its own finishing turn", async () => {
+    queuedSource();
+    await cleanupBrowserSessionsForTaskCompletion({
+      ...request(),
+      activeQueueSource: createMockFollowupRun(),
+    });
+    expect(close).not.toHaveBeenCalled();
+  });
+
+  it.each(["waiting", "injecting"] as const)(
+    "preserves a parked %s steer beside the finishing source",
+    async (phase) => {
+      const { source, queue } = queuedSource();
+      queue.items.push(
+        createMockFollowupRun({
+          steerPending: { phase, predecessor: Promise.resolve(false), settle: vi.fn() },
+        }),
+      );
+      expect(inspectFollowupQueueAdmission(request().sessionKey, { activeSource: source })).toEqual(
+        { state: "steering", excludedActiveSource: true },
+      );
+      await cleanupBrowserSessionsForTaskCompletion({ ...request(), activeQueueSource: source });
+      expect(close).not.toHaveBeenCalled();
+    },
+  );
+
+  it.each(["in-flight", "overflow", "summary", "aborted"] as const)(
+    "preserves another queue obligation: %s",
+    async (kind) => {
+      const { source, queue } = queuedSource();
+      if (kind === "in-flight") {
+        queue.inFlight.add(createMockFollowupRun());
+      }
+      if (kind === "overflow") {
+        queue.droppedCount = 1;
+      }
+      if (kind === "summary") {
+        queue.activeSummarySources.add(source);
+      }
+      if (kind === "aborted") {
+        source.abortSignal = AbortSignal.abort();
+      }
+      await cleanupBrowserSessionsForTaskCompletion({ ...request(), activeQueueSource: source });
+      expect(close).not.toHaveBeenCalled();
+    },
+  );
+
+  it("revokes after lazy preparation if the Gateway rotates or another run starts", async () => {
+    await cleanupBrowserSessionsForTaskCompletion(request());
+    const completion = close.mock.calls[0]?.[0].taskCompletion;
+    owner.generation = "replacement";
+    expect(completion?.isCurrent()).toBe(false);
+    owner.generation = "current";
+    owner.activeRunId = "followup";
+    expect(completion?.isCurrent()).toBe(false);

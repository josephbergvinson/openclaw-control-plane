+import { makeRuntime } from "./agent-bundle-mcp-harness.test-support.js";
+import { materializeBundleMcpToolsForRun } from "./agent-bundle-mcp-materialize.js";
+import { estimateToolResultTextChars } from "./embedded-agent-runner/tool-result-text-budget.js";
+import { consumeMcpCodeModeGuestResult } from "./mcp-content.js";
+import { installSessionToolResultGuard } from "./session-tool-result-guard.js";
+import { SessionManager } from "./sessions/index.js";
+import { createReadTool } from "./sessions/tools/read.js";
+import type { ReadToolDetails, ReadToolInput } from "./sessions/tools/tool-contracts.js";
+import { makeAgentAssistantMessage } from "./test-helpers/agent-message-fixtures.js";
+
+const outputTempDirs = useAutoCleanupTempDirTracker(afterEach);
+
+describe("MCP output preservation", () => {
+  const syntheticResult = (): CallToolResult => {
+    const structuredContent = {
+      proofs: [
+        { asset: "synthetic", quantity: "90071992547409930001", evidence: "x".repeat(80_000) },
+      ],
+      coverage: { complete: false, through: "1790919068.985635104" },
+    };
+    return {
+      content: [{ type: "text", text: JSON.stringify(structuredContent) }],
+      structuredContent,
+    };
+  };
+  const execute = async (
+    workspaceDir: string,
+    result = syntheticResult(),
+    options: { assertCurrent?: () => void; signal?: AbortSignal } = {},
+  ) => {
+    const runtime = makeRuntime({ sessionId: "output-custody", requesterSenderId: "requester" });
+    runtime.callTool = async () => result;
+    runtime.workspaceDir = workspaceDir;
+    const materialized = await materializeBundleMcpToolsForRun({
+      runtime,
+      contextWindowTokens: 272_000,
+      assertCurrent: options.assertCurrent,
+    });
+    return await materialized.tools[0]!.execute("spill-probe", {}, options.signal, undefined);
+  };
+  const outputPath = (result: Awaited<ReturnType<typeof execute>>) => {
+    const details = result.details as { fullOutputPath?: string };
+    expect(details.fullOutputPath).toBeTypeOf("string");
+    return details.fullOutputPath!;
+  };
+
+  it("preserves exact full received output before the existing cap and reads every native page", async () => {
+    const workspace = outputTempDirs.make("openclaw-mcp-output-");
+    const raw = syntheticResult();
+    const result = await execute(workspace, raw);
+    const file = outputPath(result);
+    expect(path.dirname(file)).toBe(path.join(workspace, ".openclaw", "tmp"));
+    expect(statSync(file).mode & 0o777).toBe(0o600);
+    expect(
+      result.content.reduce(
+        (sum, block) => sum + (block.type === "text" ? estimateToolResultTextChars(block.text) : 0),
+        0,
+      ),
+    ).toBeLessThanOrEqual(64_000);
+    expect(result.content.at(-1)).toMatchObject({
+      type: "text",
+      text: expect.stringContaining(`Full output: ${file}`),
+    });
+    const full = readFileSync(file, "utf8");
+    expect(full).toContain("EXTERNAL_UNTRUSTED_CONTENT");
+    const body = full.split("\n---\n")[1]!.split("\n<<<END_EXTERNAL_UNTRUSTED_CONTENT")[0]!;
+    expect(JSON.parse(body)).toEqual(raw);
+
+    const manager = SessionManager.inMemory();
+    installSessionToolResultGuard(manager, { maxToolResultChars: 64_000 });
+    manager.appendMessage(
+      makeAgentAssistantMessage({
+        content: [
+          { type: "toolCall", id: "spill-probe", name: "bundleProbe__bundle_probe", arguments: {} },
+        ],
+        stopReason: "toolUse",
+      }),
+    );
+    manager.appendMessage({
+      ...result,
+      role: "toolResult",
+      toolCallId: "spill-probe",
+      toolName: "bundleProbe__bundle_probe",
+      isError: false,
+      timestamp: 1,
+    });
+    const persisted = manager
+      .getEntries()
+      .find((entry) => entry.type === "message" && entry.message.role === "toolResult");
+    expect(persisted).toMatchObject({
+      message: {
+        content: result.content,
+        details: { fullOutputPath: file, spillTruncated: false, persistedDetailsTruncated: true },
+      },
+    });
+    expect(consumeMcpCodeModeGuestResult(result)).toEqual(raw);
+
+    const reader = createReadTool(workspace, { maxBytes: 4_096 });
+    let args: ReadToolInput = { path: file };
+    let reconstructed = "";
+    let pages = 0;
+    for (; pages < 100; pages += 1) {
+      const page = await reader.execute(`read-${pages}`, args, undefined, undefined);
+      const details = page.details as ReadToolDetails;
+      expect(
+        page.content[0]?.type === "text" && Buffer.byteLength(page.content[0].text, "utf8"),
+      ).toBeLessThanOrEqual(4_096);
+      if (details.kind !== "text" && details.kind !== "truncated") {
+        throw new Error("Expected a native text page.");
+      }
+      reconstructed += details.content;
+      if (details.kind === "text") {
+        break;
+      }
+      const { kind, ...continuation } = details.continuation;
+      if (kind === "line") {
+        reconstructed += "\n";
+      }
+      args = { path: file, ...continuation };
+    }
+    expect(pages).toBeGreaterThan(1);
+    expect(pages).toBeLessThan(100);
+    expect(reconstructed).toBe(full);
+  });
+
+  it("masks credentials and excludes private MCP metadata from the preserved artifact", async () => {
+    const workspace = outputTempDirs.make("openclaw-mcp-output-redaction-");
+    const raw = syntheticResult();
+    raw._meta = { authorization: "private-mcp-metadata-sentinel" };
+    raw.structuredContent = { ...raw.structuredContent, password: "synthetic-secret-value" };
+    raw.content = [{ type: "text", text: JSON.stringify(raw.structuredContent) }];
+    const result = await execute(workspace, raw);
+    const full = readFileSync(outputPath(result), "utf8");
+    expect(full.includes("synthetic-secret-value")).toBe(false);
+    expect(full.includes("private-mcp-metadata-sentinel")).toBe(false);
+    expect(full).toContain("90071992547409930001");
+    expect(full).toContain("1790919068.985635104");
+  });
+
+  it("cleans only the new output when requester authority is revoked after the awaited write", async () => {
+    const workspace = outputTempDirs.make("openclaw-mcp-output-revoked-");
+    const directory = path.join(workspace, ".openclaw", "tmp");
+    mkdirSync(directory, { recursive: true });
+    writeFileSync(path.join(directory, "other-task.log"), "keep existing custody");
+    await expect(
+      execute(workspace, syntheticResult(), {
+        assertCurrent: () => {
+          if (readdirSync(directory).some((name) => name.startsWith("openclaw-mcp-output-"))) {
+            throw new Error("requester revoked");
+          }
+        },
+      }),
+    ).rejects.toThrow("requester revoked");
+    expect(readdirSync(directory)).toEqual(["other-task.log"]);
+    expect(readFileSync(path.join(directory, "other-task.log"), "utf8")).toBe(
+      "keep existing custody",
+    );
+  });
+
+  it("does not create output after cancellation", async () => {
+    const workspace = outputTempDirs.make("openclaw-mcp-output-aborted-");
+    const abort = new AbortController();
+    abort.abort(new Error("cancelled before preservation"));
+    await expect(execute(workspace, syntheticResult(), { signal: abort.signal })).rejects.toThrow(
+      "cancelled before preservation",
+    );
+    expect(readdirSync(workspace)).toEqual([]);
+  });
+
+  it("cleans the new output when cancellation arrives after the awaited write", async () => {
+    const workspace = outputTempDirs.make("openclaw-mcp-output-write-abort-");
+    const directory = path.join(workspace, ".openclaw", "tmp");
+    mkdirSync(directory, { recursive: true });
+    const abort = new AbortController();
+    await expect(
+      execute(workspace, syntheticResult(), {
+        signal: abort.signal,
+        assertCurrent: () => {
+          if (readdirSync(directory).some((name) => name.startsWith("openclaw-mcp-output-"))) {
+            abort.abort(new Error("cancelled after write"));
+            abort.signal.throwIfAborted();
+          }
+        },
+      }),
+    ).rejects.toThrow("cancelled after write");
+    expect(readdirSync(directory)).toEqual([]);
+  });
+
+  it("does not adopt a replacement runtime workspace after the MCP read", async () => {
+    const admitted = outputTempDirs.make("openclaw-mcp-output-admitted-");
+    const replacement = outputTempDirs.make("openclaw-mcp-output-replacement-");
+    const runtime = makeRuntime({ sessionId: "output-custody", requesterSenderId: "requester" });
+    runtime.workspaceDir = admitted;
+    runtime.callTool = async () => {
+      runtime.workspaceDir = replacement;
+      return syntheticResult();
+    };
+    const materialized = await materializeBundleMcpToolsForRun({
+      runtime,
+      contextWindowTokens: 272_000,
+    });
+    await expect(
+      materialized.tools[0]!.execute("workspace-drift", {}, undefined, undefined),
+    ).rejects.toThrow("admitted MCP output workspace changed");
+    expect(readdirSync(admitted)).toEqual([]);
+    expect(readdirSync(replacement)).toEqual([]);
+  });
+
+  it("refuses a missing absolute workspace instead of selecting another storage context", async () => {
+    await expect(execute("")).rejects.toThrow("admitted absolute workspace");
+    await expect(execute("relative-company-workspace")).rejects.toThrow(
+      "admitted absolute workspace",
+    );
+  });
+
+  it("does not claim preservation or fall back when the admitted output root cannot be written", async () => {
+    const workspace = outputTempDirs.make("openclaw-mcp-output-write-failure-");
+    writeFileSync(path.join(workspace, ".openclaw"), "existing non-directory");
+    await expect(execute(workspace)).rejects.toThrow();
+    expect(readdirSync(workspace)).toEqual([".openclaw"]);
+    expect(readFileSync(path.join(workspace, ".openclaw"), "utf8")).toBe("existing non-directory");
+  });
+});

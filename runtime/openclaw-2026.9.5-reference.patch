index 0000000000000000000000000000000000000000..300ab3d8f60f0933d1e9f4d03518228291faa36a
--- /dev/null
+++ b/src/agents/command/requester-presentation.ts
@@ -0,0 +1,68 @@
+import type { ChannelProgressRequest } from "../../channels/plugins/types.core.js";
+import {
+  normalizeDeliveryContext,
+  type DeliveryContext,
+} from "../../utils/delivery-context.shared.js";
+
+/** In-process authority retained by an explicitly yielded original requester. */
+export type RequesterPresentation = {
+  runId: string;
+  sessionKey: string;
+  sessionId: string;
+  source: DeliveryContext;
+  progressRequest?: ChannelProgressRequest;
+  assertCurrent: () => void;
+};
+
+/** Settlement owns the live assertion; the presentation carries only agreed progress facts. */
+export function createRequesterPresentation(
+  params: Omit<RequesterPresentation, "progressRequest"> & {
+    progressRows: Parameters<typeof resolveRequesterProgressRequest>[0]["rows"];
+  },
+): RequesterPresentation {
+  const { progressRows, ...presentation } = params;
+  return {
+    ...presentation,
+    progressRequest: resolveRequesterProgressRequest({
+      sessionKey: params.sessionKey,
+      sessionId: params.sessionId,
+      source: params.source,
+      rows: progressRows,
+    }),
+  };
+}
+
+/** A coalesced settlement can reuse progress only when every child names the same request. */
+export function resolveRequesterProgressRequest(params: {
+  sessionKey: string;
+  sessionId: string;
+  source: DeliveryContext;
+  rows: ReadonlyArray<{
+    completionRequesterSessionId?: string;
+    progressOrigin?: DeliveryContext & { messageId?: string | number };
+  }>;
+}): ChannelProgressRequest | undefined {
+  const sources = params.rows.map((row) => ({
+    sessionId: row.completionRequesterSessionId,
+    messageId:
+      row.progressOrigin?.messageId == null ? undefined : String(row.progressOrigin.messageId),
+    source: normalizeDeliveryContext(row.progressOrigin),
+  }));
+  const first = sources[0];
+  if (
+    !first?.messageId ||
+    first.sessionId !== params.sessionId ||
+    !first.source?.channel ||
+    !first.source.to ||
+    JSON.stringify(first.source) !== JSON.stringify(normalizeDeliveryContext(params.source)) ||
+    !sources.every((source) => JSON.stringify(source) === JSON.stringify(first))
+  ) {
+    return undefined;
+  }
+  return {
+    sessionKey: params.sessionKey,
+    sessionId: params.sessionId,
+    sourceMessageId: first.messageId,
+    requestGeneration: first.messageId,
+  };
+}

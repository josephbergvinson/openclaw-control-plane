+        if focused {
+            diagnostics.focusedOwnerPID = 42
+            diagnostics.focusedOwnerBundleID = "com.example.Unenrolled"
+            diagnostics.focusedOwnerStatus = .unsupported
+        }
+        if lookup {
+            diagnostics.windowLookupSource = .focusedFieldWindow
+            diagnostics.windowLookupAXResult = -25212
+            diagnostics.windowLookupElementPresent = false

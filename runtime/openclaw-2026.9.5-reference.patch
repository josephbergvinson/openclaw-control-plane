+                      ...(phaseModels ? { execution: { model: phaseModels.light } } : {}),
+                    },
+                    rem: {
+                      enabled: true,
+                      ...(phaseModels ? { execution: { model: phaseModels.rem } } : {}),
+                    },
+                    deep: {

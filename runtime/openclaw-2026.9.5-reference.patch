+  const root = await fs.mkdtemp(path.join(os.tmpdir(), prefix));
+  tempDirs.push(root);
+  await withEnvAsync({ OPENCLAW_STATE_DIR: root }, () => run(root));
+}
+
+beforeEach(() => {
+  externalAuthTesting.setResolveExternalAuthProfilesForTest(() => []);
+  clearRuntimeAuthProfileStoreSnapshots();
+});
+afterEach(async () => {
+  externalAuthTesting.resetResolveExternalAuthProfilesForTest();
+  clearRuntimeAuthProfileStoreSnapshots();
+  for (const stateDir of tempDirs) {
+    await cleanupSessionStateForTest({ stateDir });
+  }
+  closeOpenClawStateDatabaseForTest();
+  await Promise.all(tempDirs.splice(0).map((dir) => fs.rm(dir, { recursive: true, force: true })));
+});
+
+describe("durable OAuth settlement root ownership", () => {
+  it.each(["admitted", "unrooted"] as const)(
+    "retains a late refresh in durable storage before another caller reuses its token family (%s)",
+    async (admission) => {
+      await withOAuthTempRoot("oauth-manager-late-refresh-", async (tempRoot) => {
+        const agentDir = path.join(tempRoot, "agents", "main", "agent");
+        await fs.mkdir(agentDir, { recursive: true });
+        const profileId = "openai:work";
+        const expired = createCredential({
+          access: "expired-access",
+          refresh: "consumed-refresh",
+          expires: Date.now() - 60_000,
+          accountId: "work-account",
+        });
+        const rotated = createCredential({
+          access: "late-rotated-access",
+          refresh: "late-rotated-refresh",
+          expires: Date.now() + 600_000,
+          accountId: "work-account",
+        });
+        saveAuthProfileStore({ version: 1, profiles: { [profileId]: expired } }, agentDir, {
+          filterExternalAuthProfiles: false,
+        });
+        const started = createDeferredCore();
+        const providerResult = createDeferredCore<OAuthCredential>();
+        const attemptedRefreshTokens: string[] = [];
+        const manager = createOAuthManager({
+          buildApiKey: async (_provider, credential) => credential.access,
+          refreshCredential: async (credential) => {
+            attemptedRefreshTokens.push(credential.refresh);
+            if (attemptedRefreshTokens.length > 1) {
+              throw new Error("synthetic refresh token already consumed");
+            }
+            started.resolve();
+            return await providerResult.promise;
+          },
+          readBootstrapCredential: () => null,
+          canRefreshCredential: async () => true,
+        });
+        const resolve = () =>
+          manager.resolveOAuthAccess({
+            store: ensureAuthProfileStoreWithoutExternalProfiles(agentDir),
+            profileId,
+            credential: expired,
+            agentDir,
+          });
+
+        vi.useFakeTimers({ toFake: ["setTimeout", "clearTimeout", "Date"] });
+        try {
+          const resolveCaller = (origin: string) =>
+            (admission === "admitted"
+              ? runWithGatewayIndependentRootWorkAdmission(resolve, origin)
+              : resolve()
+            ).catch((error: unknown) => error);
+          const first = resolveCaller("oauth:first");
+          await started.promise;
+          await vi.advanceTimersByTimeAsync(OAUTH_REFRESH_CALL_TIMEOUT_MS);
+          expect(await first).toBeInstanceOf(OAuthManagerRefreshError);
+          // The caller returned, but the one provider settlement still belongs to drain.
+          expect(getActiveGatewayRootWorkCount()).toBe(admission === "admitted" ? 1 : 0);
+          const observer = resolveCaller("oauth:observer");
+          let observed: unknown;
+          void observer.then((result) => {
+            observed = result;
+          });
+          providerResult.resolve(rotated);
+          await vi.waitFor(() =>
+            expect(observed).toMatchObject({ apiKey: rotated.access, credential: rotated }),
+          );
+
+          // Read the durable owner, not the caller's captured or published snapshot.
+          expect(loadPersistedAuthProfileStore(agentDir)?.profiles[profileId]).toMatchObject(
+            rotated,
+          );
+          expect(attemptedRefreshTokens).toEqual([expired.refresh]);
+          expect(getActiveGatewayRootWorkCount()).toBe(0);
+        } finally {
+          providerResult.resolve(rotated);
+          await resolve().catch(() => undefined);
+          vi.useRealTimers();
+          resetGatewayWorkAdmission();
+        }
+      });
+    },
+  );
+});

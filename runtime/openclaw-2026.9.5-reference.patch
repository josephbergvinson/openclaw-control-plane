+  if (!isRecord(message) || !Array.isArray(message.content)) {
+    throw new Error("SYNTHETIC_TOOL_RESULT_SHAPE");
+  }
+  expect(message.isError, JSON.stringify(message)).toBe(false);
+  return message.content;
+}
+
+export function readToolResult(messages: readonly unknown[], toolCallId: string): unknown {
+  const content = readNativeToolResultContent(messages, toolCallId);
+  const text = content
+    .filter((block) => isRecord(block) && block.type === "text" && typeof block.text === "string")
+    .map((block) => (isRecord(block) ? block.text : ""))
+    .join("\n");
+  return JSON.parse(text) as unknown;
+}
+
+export function readCandidate(result: unknown, name: string): string {
+  if (!Array.isArray(result)) {
+    throw new Error("SYNTHETIC_SEARCH_RESULT_SHAPE");
+  }
+  const candidate = expectDefined(
+    result.find((entry) => isRecord(entry) && entry.name === name),
+    `native ${name} search candidate`,
+  );
+  if (!isRecord(candidate) || typeof candidate.id !== "string") {
+    throw new Error("SYNTHETIC_SEARCH_CANDIDATE_SHAPE");
+  }
+  return candidate.id;
+}
+
+export function hasUserMarker(messages: readonly unknown[], marker: string): boolean {
+  return messages.some((entry) => {
+    if (!isRecord(entry) || entry.role !== "user") {
+      return false;
+    }
+    if (typeof entry.content === "string") {
+      return entry.content.includes(marker);
+    }
+    return (
+      Array.isArray(entry.content) &&
+      entry.content.some(
+        (block) =>
+          isRecord(block) &&
+          block.type === "text" &&
+          typeof block.text === "string" &&
+          block.text.includes(marker),
+      )
+    );
+  });
+}
+
+export function readWrappedResult(result: unknown, id: string, name: string) {
+  if (!isRecord(result) || !isRecord(result.tool) || !isRecord(result.result)) {
+    throw new Error("SYNTHETIC_CALLED_TOOL_RESULT_SHAPE");
+  }
+  expect(result.tool.id).toBe(id);
+  expect(result.tool.name).toBe(name);
+  return result.result;
+}
+
+export function assertStatusResult(result: unknown, id: string) {
+  const body = readWrappedResult(result, id, "transcripts");
+  expect(isRecord(body.details)).toBe(true);
+  if (!isRecord(body.details)) {
+    throw new Error("SYNTHETIC_TRANSCRIPTS_STATUS_SHAPE");
+  }
+  expect(Array.isArray(body.details.providers)).toBe(true);
+  expect(Array.isArray(body.details.active)).toBe(true);
+  expect(Array.isArray(body.details.pendingFinalization)).toBe(true);
+}
+
+export function emitReply(
+  stream: ReturnType<typeof createAssistantMessageEventStream>,
+  model: Model,
+  content: AssistantMessage["content"],
+  errorMessage?: string,
+) {
+  const toolUse = content.some((block) => block.type === "toolCall");
+  const message: AssistantMessage = {
+    role: "assistant",
+    content,
+    api: model.api,
+    provider: model.provider,
+    model: model.id,
+    stopReason: errorMessage ? "error" : toolUse ? "toolUse" : "stop",
+    ...(errorMessage ? { errorCode: "SYNTHETIC_NATIVE_BOUNDARY", errorMessage } : {}),
+    timestamp: Date.now(),
+    usage: {
+      input: 1,
+      output: 1,
+      cacheRead: 0,
+      cacheWrite: 0,
+      totalTokens: 2,
+      cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+    },
+  };
+  if (errorMessage) {
+    stream.push({ type: "error", reason: "error", error: message });
+  } else {
+    stream.push({ type: "done", reason: toolUse ? "toolUse" : "stop", message });
+  }
+  stream.end();
+}

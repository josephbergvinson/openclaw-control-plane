+      for (const entry of entries) {
+        entry.requesterSettleWake = {
+          ...entry.requesterSettleWake!,
+          cronRequesterFailure: failure,
+        };
+      }
+      try {
+        context.options.persistOrThrow(...capturedRunIds);
+      } catch (error) {
+        entries.forEach((entry, index) => {
+          entry.requesterSettleWake = previousStates[index];
+        });
+        throw error;
+      }
+      try {
+        settled = await resumeCronRequesterFailure(context, entries[0]!);
+      } finally {
+        release();
+      }
+    },
+  };

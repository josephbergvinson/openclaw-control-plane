index 0000000000000000000000000000000000000000..44a8a27124ce491e5d9e8bd5bdf5724868703c5d
--- /dev/null
+++ b/src/auto-reply/reply/agent-runner-progress.ts
@@ -0,0 +1,98 @@
+import {
+  getAdmittedRunDelegatedAuthority,
+  type AdmittedRunContext,
+  type PreparedAgentRunAdmission,
+} from "../../agents/admitted-run-context.js";
+import { assertAgentRunLifecycleGenerationCurrent } from "../../infra/agent-events.js";
+import type { ReplyProgressTurn } from "../get-reply-options.types.js";
+import type { AgentTurnParams } from "./agent-runner-execution.types.js";
+import { resolveFollowupAbortSignal } from "./queue/types.js";
+import {
+  markReplyOperationExecutionStarted,
+  resolveActiveReplyOperationForSessionId,
+} from "./reply-run-registry.js";
+
+type ProgressTurnParams = Pick<
+  AgentTurnParams,
+  "replyOperation" | "sessionKey" | "getActiveSessionEntry" | "opts"
+> & {
+  followupRun: Pick<
+    AgentTurnParams["followupRun"],
+    | "messageId"
+    | "originatingChannel"
+    | "originatingTo"
+    | "originatingAccountId"
+    | "originatingThreadId"
+    | "abortSignal"
+    | "queueAbortSignal"
+  > & { run: Pick<AgentTurnParams["followupRun"]["run"], "sessionId"> };
+};
+
+/** Capture admitted request facts; its presentation outlives model execution settlement. */
+function resolveReplyProgressTurn(
+  params: ProgressTurnParams,
+  admission: PreparedAgentRunAdmission,
+  context: AdmittedRunContext | undefined,
+): ReplyProgressTurn | undefined {
+  const sessionId = params.followupRun.run.sessionId;
+  const sourceMessageId = params.followupRun.messageId;
+  const operation = params.replyOperation;
+  if (
+    !operation ||
+    !operation.lifecycleGeneration ||
+    !params.sessionKey ||
+    !sessionId ||
+    !sourceMessageId ||
+    !context ||
+    getAdmittedRunDelegatedAuthority(context) === undefined
+  ) {
+    return undefined;
+  }
+  const sourceAbort = resolveFollowupAbortSignal(params.followupRun);
+  const lifecycleGeneration = operation.lifecycleGeneration;
+  return {
+    sessionKey: params.sessionKey,
+    sessionId,
+    sourceMessageId,
+    channel: params.followupRun.originatingChannel,
+    to: params.followupRun.originatingTo,
+    accountId: params.followupRun.originatingAccountId,
+    threadId: params.followupRun.originatingThreadId,
+    assertCurrent: () => {
+      assertAgentRunLifecycleGenerationCurrent(lifecycleGeneration);
+      admission.assertSourceCurrent();
+      params.opts?.abortSignal?.throwIfAborted();
+      sourceAbort?.throwIfAborted();
+      const activeOperation = resolveActiveReplyOperationForSessionId(sessionId);
+      // The dispatcher can release its operation before the ingress handler seals
+      // its yielded card. Only model/tool authority ends with prepared admission.
+      if (
+        operation.abortSignal.aborted ||
+        (activeOperation !== undefined && activeOperation !== operation) ||
+        (activeOperation === undefined && operation.result?.kind !== "completed") ||
+        operation.staleExpiryReason !== undefined ||
+        params.getActiveSessionEntry()?.sessionId !== sessionId
+      ) {
+        throw new Error("Source progress turn was replaced or aborted");
+      }
+    },
+  };
+}
+
+/** The admitted execution boundary supplies source progress without changing final custody. */
+export function notifyReplyProgressTurn(
+  runId: string,
+  params: ProgressTurnParams,
+  admission: PreparedAgentRunAdmission,
+  context: AdmittedRunContext | undefined,
+): void {
+  if (params.replyOperation) {
+    markReplyOperationExecutionStarted(params.replyOperation);
+  }
+  params.opts?.onAgentRunStart?.(
+    runId,
+    context?.executionIdentityToken,
+    undefined,

new file mode 100644
index 0000000000000000000000000000000000000000..1fd84f0e84b2a4710ae8004e26a68a8b75af2a2a
--- /dev/null
+++ b/src/channels/source-progress.ts
@@ -0,0 +1,85 @@
+import { prepareCurrentRunDelivery } from "../agents/command/session-helpers.js";
+import { resolveSessionStorePathCore } from "../config/sessions/paths.js";
+import { loadSessionEntryReadOnly } from "../config/sessions/session-accessor.js";
+import type { OpenClawConfig } from "../config/types.openclaw.js";
+import { resolveAgentIdFromSessionKey } from "../routing/session-key.js";
+import { resolveSendPolicy } from "../sessions/send-policy.js";
+import type { DeliveryContext } from "../utils/delivery-context.shared.js";
+import { getChannelPlugin } from "./plugins/index.js";
+import type { ChannelProgressRequest } from "./plugins/types.core.js";
+
+/** Callers prove current source authority; the channel alone owns its visible progress. */
+export async function publishChannelSourceProgress(params: {
+  cfg: OpenClawConfig;
+  agentId?: string;
+  sessionKey: string;
+  sessionId?: string;
+  source: DeliveryContext & { channel: string; to: string };
+  progressRequest?: ChannelProgressRequest;
+  text: string;
+  signal: AbortSignal;
+  assertCurrent: () => void;
+}): Promise<{ status: "visible"; messageId: string } | { status: "unbound" | "withheld" }> {
+  const agentId = params.agentId ?? resolveAgentIdFromSessionKey(params.sessionKey);
+  const storePath = resolveSessionStorePathCore(params.cfg.session?.store, { agentId });
+  const readEntry = () =>
+    loadSessionEntryReadOnly({ sessionKey: params.sessionKey, agentId, storePath });
+  const assertCurrent = () => {
+    params.assertCurrent();
+    const entry = readEntry();
+    if (
+      params.signal.aborted ||
+      (params.sessionId !== undefined && entry?.sessionId !== params.sessionId) ||
+      resolveSendPolicy({
+        cfg: params.cfg,
+        entry,
+        sessionKey: params.sessionKey,
+        channel: params.source.channel,
+      }) === "deny"
+    ) {
+      throw new Error("Channel source progress authority changed");
+    }
+  };
+  assertCurrent();
+  const plugin = getChannelPlugin(params.source.channel);
+  if (!plugin) {
+    return { status: "withheld" };
+  }
+  const adapter = plugin.streaming?.publishTaskProgress;
+  if (!adapter) {
+    return { status: "unbound" };
+  }
+  const delivery = await prepareCurrentRunDelivery({
+    cfg: params.cfg,
+    agentId,
+    currentSessionKey: params.sessionKey,
+    sessionEntry: readEntry(),
+    opts: {
+      message: params.text,
+      deliver: true,
+      replyChannel: params.source.channel,
+      replyTo: params.source.to,
+      replyAccountId: params.source.accountId,
+      threadId: params.source.threadId,
+    },
+  });
+  assertCurrent();
+  if (!delivery?.context.to || delivery.context.channel !== params.source.channel) {
+    return { status: "withheld" };
+  }
+  const result = await adapter({
+    cfg: params.cfg,
+    to: delivery.context.to,
+    accountId: delivery.context.accountId,
+    threadId: delivery.context.threadId,
+    progressRequest: params.progressRequest,
+    text: params.text,
+    signal: params.signal,
+    assertCurrent,
+  });
+  assertCurrent();
+  if (result.status === "unsupported") {
+    return { status: "unbound" };
+  }
+  return result.status === "visible" ? result : { status: "withheld" };
+}

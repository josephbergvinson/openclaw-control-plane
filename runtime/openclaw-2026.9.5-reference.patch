new file mode 100644
index 0000000000000000000000000000000000000000..c0b4025f7afe352eff4e61b621c29c26d9f33073
--- /dev/null
+++ b/src/gateway/server.private-recovery-completion.test.ts
@@ -0,0 +1,199 @@
+/** Real Gateway admission, task adoption, and durable receipts for a hidden recovery parent. */
+import path from "node:path";
+import { expectDefined } from "@openclaw/normalization-core/expect";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import type { AgentCommandOpts } from "../agents/command/types.js";
+import {
+  preparePrivateCompletionAgentCall,
+  runAnnounceAgentCall,
+} from "../agents/subagents/announce/subagent-announce-completion-delivery.js";
+import { subagentRuns } from "../agents/subagents/registry/subagent-registry-memory.js";
+import { markSubagentRunPausedAfterYield } from "../agents/subagents/registry/subagent-registry-run-pause.js";
+import { persistSubagentRunsToDiskOrThrow } from "../agents/subagents/registry/subagent-registry-state.js";
+import { registerSubagentRun } from "../agents/subagents/registry/subagent-registry.js";
+import { loadTranscriptEventsSync } from "../config/sessions/session-accessor.js";
+import { closeOpenClawAgentDatabasesForTest } from "../state/openclaw-agent-db.js";
+import { startGatewayServerHarness, type GatewayServerHarness } from "./server.e2e-ws-harness.js";
+import { resolvePrivateCompletionTranscript } from "./session-subagent-private-completion.js";
+import { loadSessionEntry } from "./session-utils.js";
+import {
+  agentCommandMock,
+  installGatewayTestHooks,
+  prepareGatewayReplyRuntimeForTest,
+  testState,
+  writeSessionStore,
+} from "./test-helpers.js";
+
+describe("yielded private recovery completion", () => {
+  let harness: GatewayServerHarness;
+  let kernel: Awaited<ReturnType<(typeof import("./server-kernel.js"))["createGatewayKernel"]>>;
+  let storePath: string;
+  const logical = "agent:main:subagent:recovered-receipt-parent";
+  const privateKey = "agent:main:internal-session-effects:recovered-receipt-parent";
+  const childKey = "agent:main:subagent:recovered-receipt-child";
+  const priorRun = "recovered-receipt-parent";
+  const nextRun = "announce:recovered-receipt-child";
+  const marker = "Synthetic child result for hidden recovery only";
+  async function start() {
+    const module = await import("./server-kernel.js");
+    const create = module.createGatewayKernel;
+    const capture = vi.spyOn(module, "createGatewayKernel").mockImplementation(async (...args) => {
+      kernel = await create(...args);
+      return kernel;
+    });
+    try {
+      harness = await startGatewayServerHarness();
+    } finally {
+      capture.mockRestore();
+    }
+  }
+  installGatewayTestHooks({ scope: "suite", setup: start, cleanup: async () => harness?.close() });
+  beforeEach(async () => {
+    storePath = path.join(
+      process.env.OPENCLAW_STATE_DIR!,
+      "agents",
+      "main",
+      "sessions",
+      "sessions.json",
+    );
+    testState.sessionStorePath = storePath;
+    await writeSessionStore({
+      entries: {
+        [logical]: { sessionId: "logical-recovered-parent", updatedAt: Date.now() },
+        [privateKey]: { sessionId: "private-recovered-parent", updatedAt: Date.now() },
+        [childKey]: { sessionId: "private-recovered-child", updatedAt: Date.now() },
+      },
+    });
+    agentCommandMock.mockReset();
+    await prepareGatewayReplyRuntimeForTest();
+    registerSubagentRun({
+      runId: priorRun,
+      childSessionKey: logical,
+      requesterSessionKey: "agent:main:main",
+      requesterDisplayKey: "agent:main:main",
+      task: "Complete original research",
+      cleanup: "keep",
+      expectsCompletionMessage: true,
+      queued: true,
+      completionTarget: "parent",
+      completionRequesterSessionId: "operator-id",
+    });
+    const owner = subagentRuns.get(priorRun)!;
+    owner.execution.transcriptTarget = {
+      agentId: "main",
+      sessionKey: privateKey,
+      sessionId: "private-recovered-parent",
+      storePath,
+    };
+    markSubagentRunPausedAfterYield({ entry: owner });
+    registerSubagentRun({
+      runId: "recovered-receipt-child",
+      childSessionKey: childKey,
+      requesterSessionKey: privateKey,
+      controllerSessionKey: privateKey,
+      requesterDisplayKey: privateKey,
+      task: "Resolve exact source identity",
+      cleanup: "keep",
+      expectsCompletionMessage: true,
+      queued: true,
+      completionTarget: "parent",
+      completionRequesterSessionId: "private-recovered-parent",
+    });
+    const child = subagentRuns.get("recovered-receipt-child")!;
+    child.execution = {
+      status: "terminal",
+      startedAt: Date.now() - 10,
+      endedAt: Date.now(),
+      outcome: { status: "ok" },
+    };
+    child.completion = { required: true, resultText: marker };
+    persistSubagentRunsToDiskOrThrow(subagentRuns, [priorRun, child.runId]);
+  });
+  function privateTranscript() {
+    return loadTranscriptEventsSync({
+      agentId: "main",
+      sessionKey: privateKey,
+      sessionId: "private-recovered-parent",
+      storePath,
+    });
+  }
+  function dispatch(message = marker) {
+    const prepared = preparePrivateCompletionAgentCall(
+      {
+        sessionKey: privateKey,
+        expectedExistingSessionId: "private-recovered-parent",
+        idempotencyKey: nextRun,
+        message,
+        deliver: false,
+        sourceReplyDeliveryMode: "automatic",
+        inputProvenance: {
+          kind: "inter_session",
+          sourceTool: "subagent_announce",
+          sourceSessionKey: childKey,
+        },
+      },
+      true,
+      childKey,
+    );
+    return runAnnounceAgentCall({
+      ...prepared,
+      privateCompletion: true,
+      expectFinal: true,
+      isExecutionAllowed: () => true,
+      resolveGatewayContext: () => kernel.gatewayRequestContext,
+    });
+  }
+  it("consumes once in the preserved private transcript and reconciles a lost acknowledgement after restart", async () => {
+    let processingCount = 0;
+    agentCommandMock.mockImplementationOnce(async (input) => {
+      const opts = input as AgentCommandOpts;
+      expect(opts.deliver).toBe(false);
+      expect(opts.sessionId).toBe("logical-recovered-parent");
+      const resume = expectDefined(
+        opts.privateCompletionResume,
+        "Expected private recovery authority",
+      );
+      const target = resolvePrivateCompletionTranscript(resume, nextRun);
+      expect(target.sessionId).toBe("private-recovered-parent");
+      expect(target.sessionKey).toBe(privateKey);
+      expect(subagentRuns.has(priorRun)).toBe(false);
+      expect(subagentRuns.get(nextRun)?.taskRunId).toBe(priorRun);
+      expect(
+        await expectDefined(
+          opts.userTurnTranscriptRecorder,
+          "Expected private recovery input recorder",
+        ).persistApproved(),
+      ).toMatchObject({
+        appended: true,
+      });
+      processingCount += 1;
+      return { payloads: [{ text: "NO_REPLY", mediaUrl: null }], meta: { durationMs: 1 } };
+    });
+    expect(await dispatch()).toMatchObject({ status: "ok", inputProcessingCompleted: true });
+    expect(processingCount).toBe(1);
+    const committed = privateTranscript();
+    expect(JSON.stringify(committed)).toContain(marker);
+    expect(
+      JSON.stringify(
+        loadTranscriptEventsSync({
+          agentId: "main",
+          sessionKey: logical,
+          sessionId: "logical-recovered-parent",
+          storePath,
+        }),
+      ),
+    ).not.toContain(marker);
+    expect(loadSessionEntry(privateKey).entry).toBeUndefined();
+    const priorDedupe = kernel.gatewayRequestContext.dedupe;
+    await harness.close();
+    closeOpenClawAgentDatabasesForTest();
+    await start();
+    await prepareGatewayReplyRuntimeForTest({ force: true });
+    expect(kernel.gatewayRequestContext.dedupe).not.toBe(priorDedupe);
+    expect(await dispatch()).toMatchObject({ status: "ok", inputProcessingCompleted: true });
+    expect(processingCount).toBe(1);
+    expect(agentCommandMock).toHaveBeenCalledOnce();
+    expect(privateTranscript()).toEqual(committed);
+    await expect(dispatch("changed result cannot reuse the receipt")).rejects.toThrow("conflicts");
+  });
+});

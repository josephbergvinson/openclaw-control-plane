diff --git a/src/plugins/runtime/runtime-task-progress.test.ts b/src/plugins/runtime/runtime-task-progress.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..325cf1f234834b474602b16c9f5cebf4477c557a
--- /dev/null
+++ b/src/plugins/runtime/runtime-task-progress.test.ts
@@ -0,0 +1,215 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import type { ChannelStreamingAdapter } from "../../channels/plugins/types.core.js";
+const owners = vi.hoisted(() => ({
+  task: vi.fn(),
+  row: vi.fn(),
+  entry: vi.fn(),
+  plugin: vi.fn(),
+  preflight: vi.fn(),
+  policy: vi.fn(),
+}));
+vi.mock("../../tasks/task-owner-access.js", () => ({ getTaskByIdForOwner: owners.task }));
+vi.mock("../../agents/subagents/registry/subagent-registry.js", () => ({
+  getSubagentRunByRunId: owners.row,
+}));
+vi.mock("../../config/sessions/session-accessor.js", () => ({
+  loadSessionEntryReadOnly: owners.entry,
+}));
+vi.mock("../../channels/plugins/index.js", () => ({ getChannelPlugin: owners.plugin }));
+vi.mock("../../agents/command/session-helpers.js", () => ({
+  prepareCurrentRunDelivery: owners.preflight,
+}));
+vi.mock("../../sessions/send-policy.js", () => ({ resolveSendPolicy: owners.policy }));
+import { publishTaskProgress } from "./runtime-task-progress.js";
+
+beforeEach(() => vi.resetAllMocks());
+function setup() {
+  const sessionKey = "agent:main:discord:channel:123";
+  const source = {
+    channel: "discord",
+    to: "channel:123",
+    accountId: "default",
+    threadId: "456",
+    messageId: "900",
+  };
+  const row = {
+    requesterSessionKey: sessionKey,
+    requesterAgentId: "main",
+    childSessionKey: "agent:main:subagent:child",
+    completionRequesterSessionId: "incarnation",
+    progressOrigin: source,
+    generation: 1,
+    createdAt: 100,
+  };
+  const task = {
+    runId: "run",
+    requesterAgentId: "main",
+    childSessionKey: row.childSessionKey,
+    status: "running",
+    deliveryStatus: "pending",
+  };
+  const entry = { sessionId: "incarnation" };
+  const controller = new AbortController();
+  const adapter = vi.fn<NonNullable<ChannelStreamingAdapter["publishTaskProgress"]>>(
+    async (params) => {
+      params.assertCurrent();
+      return { status: "visible" as const, messageId: "1001" };
+    },
+  );
+  owners.task.mockReturnValue(task);
+  owners.row.mockReturnValue(row);
+  owners.entry.mockReturnValue(entry);
+  owners.plugin.mockReturnValue({ streaming: { publishTaskProgress: adapter } });
+  owners.preflight.mockResolvedValue({ context: source });
+  owners.policy.mockReturnValue("allow");
+  const params = {
+    cfg: {},
+    sessionKey,
+    taskId: "task",
+    runId: "run",
+    text: "The saved login worked.",
+    signal: controller.signal,
+    isCurrent: () => true,
+  };
+  return { row, task, entry, controller, adapter, source, params };
+}
+
+describe("task progress registered owner", () => {
+  it("derives the private original locator and validates normal delivery before entering the channel", async () => {
+    const h = setup();
+    await expect(publishTaskProgress(h.params)).resolves.toEqual({
+      status: "visible",
+      messageId: "1001",
+    });
+    expect(owners.task).toHaveBeenCalledWith({
+      taskId: "task",
+      callerOwnerKey: h.params.sessionKey,
+      config: h.params.cfg,
+    });
+    expect(owners.preflight).toHaveBeenCalledWith(
+      expect.objectContaining({
+        opts: {
+          message: h.params.text,
+          deliver: true,
+          replyChannel: "discord",

@@ -0,0 +1,181 @@
+import { sha256HexPrefixCore } from "@openclaw/normalization-core/node-crypto";
+import { isRecord } from "@openclaw/normalization-core/record-coerce";
+import { truncateUtf16Safe } from "@openclaw/normalization-core/utf16-slice";
+import { createToolCallOccurrenceQueue } from "../../../packages/agent-core/src/harness/session/tool-result-pairing.js";
+import { stripOutboundTargetKindPrefix } from "../../infra/outbound/channel-target-prefix.js";
+import { redactSensitiveText } from "../../logging/redact.js";
+import { normalizeAcceptedSessionSpawnResult } from "../accepted-session-spawn.js";
+import { collectTextContentBlocks } from "../content-blocks.js";
+import type { AgentMessage } from "../runtime/index.js";
+import { extractToolCallsFromAssistant } from "../tool-call-id.js";
+
+const MAX_TOOL_FAILURES = 8;
+
+const MAX_TOOL_FAILURE_CHARS = 240;
+
+const MAX_TOOL_FAILURE_CONTEXT_CHARS = 240;
+
+type ToolFailure = {
+  toolCallId: string;
+  toolName: string;
+  summary: string;
+  meta?: string;
+  observedAt?: string;
+  context?: string;
+};
+
+function formatToolFailureMeta(details: unknown): string | undefined {
+  if (!details || typeof details !== "object") {
+    return undefined;
+  }
+  const status = "status" in details ? details.status : undefined;
+  const exitCode = "exitCode" in details ? details.exitCode : undefined;
+  return (
+    [
+      typeof status === "string" && status ? `status=${status}` : "",
+      typeof exitCode === "number" && Number.isFinite(exitCode) ? `exitCode=${exitCode}` : "",
+    ]
+      .filter(Boolean)
+      .join(" ") || undefined
+  );
+}
+
+function formatToolFailureContext(input: unknown): string | undefined {
+  if (!isRecord(input)) {
+    return undefined;
+  }
+  // Only bounded routing atoms belong in diagnostics, never commands, message
+  // bodies, URLs, headers, or arbitrary argument objects.
+  const parts: string[] = [];
+  let chars = 0;
+  for (const key of [
+    "action",
+    "channel",
+    "target",
+    "to",
+    "guildId",
+    "channelId",
+    "threadId",
+    "messageId",
+    "accountId",
+    "workspaceId",
+    "projectId",
+  ]) {
+    const value = input[key];
+    if (
+      typeof value !== "string" ||
+      !/^[A-Za-z0-9_.:-]{1,80}$/.test(value) ||
+      redactSensitiveText(value, { mode: "tools" }) !== value
+    ) {
+      continue;
+    }
+    const resource =
+      key === "target" || key === "to" ? stripOutboundTargetKindPrefix(value) : value;
+    if (URL.canParse(resource)) {
+      continue;
+    }
+    const part = `${key}=${value}`;
+    if (chars + part.length + 1 <= MAX_TOOL_FAILURE_CONTEXT_CHARS) {
+      parts.push(part);
+      chars += part.length + 1;
+    }
+  }
+  return parts.join(" ") || undefined;
+}
+
+export function collectToolFailures(messages: AgentMessage[]): ToolFailure[] {
+  const failures: ToolFailure[] = [];
+  const seen = new Set<string>();
+  const calls = createToolCallOccurrenceQueue<{ name?: string; input: unknown }>();
+
+  for (const message of messages) {
+    if (message.role === "assistant") {
+      const callIds = new Set(extractToolCallsFromAssistant(message).map((call) => call.id));
+      if (callIds.size === 0) {
+        continue;
+      }
+      for (const block of message.content) {
+        if (isRecord(block) && typeof block.id === "string" && callIds.has(block.id)) {
+          calls.add(block.id, {
+            name: typeof block.name === "string" ? block.name : undefined,
+            input: block.arguments ?? block.input,
+          });
+        }
+      }
+      continue;
+    }
+    if (message.role !== "toolResult") {
+      continue;
+    }
+    const toolResult = message;
+    const toolCallId = typeof toolResult.toolCallId === "string" ? toolResult.toolCallId : "";
+    const call = calls.claim(toolCallId);
+    if (!toolResult.isError) {
+      continue;
+    }
+    // Accepted sessions_spawn launches are successes, not failures, even when a legacy
+    // transcript persisted them with isError:true. Mirror the observer's detection
+    // (toolName + accepted child-run identity, see embedded-agent-subscribe.handlers.tools)
+    // so only real failures stay in the summary and non-spawn tools are never matched by shape.
+    if (
+      typeof toolResult.toolName === "string" &&
+      toolResult.toolName.trim() === "sessions_spawn" &&
+      normalizeAcceptedSessionSpawnResult(toolResult)
+    ) {
+      continue;
+    }
+    // A reused provider ID is another observation when backed by a new call.
+    // Only deduplicate repeated result records without a matching occurrence.
+    if (!toolCallId || (seen.has(toolCallId) && !call)) {
+      continue;
+    }
+    seen.add(toolCallId);
+
+    const toolName =
+      typeof toolResult.toolName === "string" && toolResult.toolName.trim()
+        ? toolResult.toolName
+        : "tool";
+    const meta = formatToolFailureMeta(toolResult.details);
+    const failureText =
+      collectTextContentBlocks(toolResult.content).join("\n").replace(/\s+/g, " ").trim() ||
+      (meta ? "failed" : "failed (no output)");
+    const summary =
+      failureText.length > MAX_TOOL_FAILURE_CHARS
+        ? `${truncateUtf16Safe(failureText, MAX_TOOL_FAILURE_CHARS - 3)}...`
+        : failureText;
+    const observed = new Date(message.timestamp);
+    failures.push({
+      toolCallId,
+      toolName,
+      summary,
+      meta,
+      observedAt: Number.isFinite(observed.getTime()) ? observed.toISOString() : undefined,
+      context: call?.name === toolName ? formatToolFailureContext(call.input) : undefined,
+    });
+  }
+
+  return failures;
+}
+
+export function formatToolFailuresSection(failures: ToolFailure[]): string {
+  if (failures.length === 0) {
+    return "";
+  }
+  const lines = failures
+    .slice(-MAX_TOOL_FAILURES)
+    .toReversed()
+    .map((failure) => {
+      const meta = failure.meta ? ` (${failure.meta})` : "";
+      const callId =
+        /^[A-Za-z0-9_|:.-]{1,160}$/.test(failure.toolCallId) &&
+        redactSensitiveText(failure.toolCallId, { mode: "tools" }) === failure.toolCallId
+          ? failure.toolCallId
+          : `sha256:${sha256HexPrefixCore(failure.toolCallId, 16)}`;
+      const context = failure.context ? ` ${failure.context}` : "";
+      return `- ${failure.toolName}${meta}: ${failure.summary} [${failure.observedAt ?? "time unknown"} call=${callId}${context}]`;
+    });
+  if (failures.length > MAX_TOOL_FAILURES) {
+    lines.push(`- ...and ${failures.length - MAX_TOOL_FAILURES} more`);
+  }
+  return `\n\n## Tool Failures\nHistorical observations, newest first; not current availability.\n${lines.join("\n")}`;
+}

@@ -0,0 +1,105 @@
+import { isRecord } from "@openclaw/normalization-core/record-coerce";
+
+/** Host-observed completed native batch, bound to the ordinary final that consumes it. */
+export type RequesterSettleFinalClaim = {
+  sourceRunId: string;
+  requesterSessionKey: string;
+  requesterAgentId: string;
+  sessionId: string;
+  lifecycleRevision?: string;
+  rearmGeneration: number;
+  children: Array<{
+    runId: string;
+    taskId: string;
+    taskRunId: string;
+    childSessionKey: string;
+    generation: number;
+    taskGeneration: number;
+    deliveryGeneration?: number;
+    createdAt: number;
+    endedAt: number;
+    resultHash: string;
+  }>;
+};
+
+/** Fail closed at the existing session-store boundary; never truncate a batch claim. */
+export function normalizeRequesterSettleFinalClaims(
+  value: unknown,
+): RequesterSettleFinalClaim[] | undefined {
+  if (!Array.isArray(value) || value.length === 0 || value.length > 32) {
+    return undefined;
+  }
+  const string = (v: unknown): v is string =>
+    typeof v === "string" && v.length > 0 && v === v.trim();
+  const number = (v: unknown): v is number =>
+    typeof v === "number" && Number.isSafeInteger(v) && v >= 0;
+  const claims: RequesterSettleFinalClaim[] = [];
+  for (const item of value) {
+    if (
+      !isRecord(item) ||
+      ![item.sourceRunId, item.requesterSessionKey, item.requesterAgentId, item.sessionId].every(
+        string,
+      ) ||
+      !number(item.rearmGeneration) ||
+      (item.lifecycleRevision !== undefined && !string(item.lifecycleRevision)) ||
+      !Array.isArray(item.children) ||
+      item.children.length === 0 ||
+      item.children.length > 32
+    ) {
+      return undefined;
+    }
+    const children: RequesterSettleFinalClaim["children"] = [];
+    for (const child of item.children) {
+      if (
+        !isRecord(child) ||
+        ![child.runId, child.taskId, child.taskRunId, child.childSessionKey].every(string) ||
+        !number(child.generation) ||
+        !number(child.taskGeneration) ||
+        !number(child.createdAt) ||
+        !number(child.endedAt) ||
+        (child.deliveryGeneration !== undefined && !number(child.deliveryGeneration)) ||
+        typeof child.resultHash !== "string" ||
+        !/^[a-f0-9]{64}$/.test(child.resultHash)
+      ) {
+        return undefined;
+      }
+      children.push({
+        // SAFETY: The string predicate above validates this exact child field.
+        runId: child.runId as string,
+        // SAFETY: The string predicate above validates this exact child field.
+        taskId: child.taskId as string,
+        // SAFETY: The string predicate above validates this exact child field.
+        taskRunId: child.taskRunId as string,
+        // SAFETY: The string predicate above validates this exact child field.
+        childSessionKey: child.childSessionKey as string,
+        generation: child.generation,
+        taskGeneration: child.taskGeneration,
+        createdAt: child.createdAt,
+        endedAt: child.endedAt,
+        ...(child.deliveryGeneration !== undefined
+          ? { deliveryGeneration: child.deliveryGeneration }
+          : {}),
+        resultHash: child.resultHash,
+      });
+    }
+    if (new Set(children.map((c) => c.runId)).size !== children.length) {
+      return undefined;
+    }
+    claims.push({
+      // SAFETY: The string predicate above validates this exact claim field.
+      sourceRunId: item.sourceRunId as string,
+      // SAFETY: The string predicate above validates this exact claim field.
+      requesterSessionKey: item.requesterSessionKey as string,
+      // SAFETY: The string predicate above validates this exact claim field.
+      requesterAgentId: item.requesterAgentId as string,
+      // SAFETY: The string predicate above validates this exact claim field.
+      sessionId: item.sessionId as string,
+      rearmGeneration: item.rearmGeneration,
+      ...(item.lifecycleRevision !== undefined
+        ? { lifecycleRevision: item.lifecycleRevision }
+        : {}),
+      children,
+    });
+  }
+  return claims;
+}

+import type { SessionPermissionMode } from "../../packages/gateway-protocol/src/schema/sessions-row.js";
+import type { OpenClawConfig } from "../config/types.openclaw.js";
+import type { InputProvenance } from "../sessions/input-provenance.js";
+
+/** Resolve only from the admission owner's authenticated identity, never prompt or route text. */
+export function resolveOwnerPermissionMode(params: {
+  cfg: OpenClawConfig | undefined;
+  permissionMode?: SessionPermissionMode;
+  senderIsOwner: boolean;
+  internalTurn?: boolean;
+  inputProvenance?: InputProvenance;
+  spawnedBy?: string | null;
+}): SessionPermissionMode | undefined {
+  if (params.permissionMode !== undefined) {
+    return params.permissionMode;
+  }
+  if (
+    !params.senderIsOwner ||
+    params.internalTurn ||
+    params.spawnedBy ||
+    (params.inputProvenance !== undefined && params.inputProvenance.kind !== "external_user")
+  ) {
+    return undefined;
+  }
+  return params.cfg?.agents?.defaults?.ownerPermissionMode;
+}

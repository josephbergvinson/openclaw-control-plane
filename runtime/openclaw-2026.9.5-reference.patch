+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { loadDiscordThreadReceiptTestHarness } from "../extensions/discord/test-api.js";
+import { readEmbeddedMessageDeliveryFact } from "../src/agents/embedded-agent-message-delivery.js";
+import { isDeliveredMessageToolOnlySourceReplyResult } from "../src/agents/embedded-agent-message-tool-source-reply.js";

+import { describe, expect, it, vi } from "vitest";
+import { SessionManager } from "../../sessions/session-manager.js";
+import { preserveCompletionForVisibleTurn } from "./completion-preemption.js";
+
+describe("completion custody before visible-turn preemption", () => {
+  it.each([
+    "subagent_announce",
+    "subagent_settle",
+    "image_generate",
+    "video_generate",
+    "music_generate",
+    "agent_harness_task",
+  ])("preserves an unsubmitted %s result as hidden data exactly once", async (sourceTool) => {
+    const manager = SessionManager.inMemory();
+    const preserve = preserveCompletionForVisibleTurn(
+      {
+        runId: "completion",
+        prompt: "Original result with /tmp/finished.png",
+        inputProvenance: {
+          kind: "inter_session",
+          sourceTool,
+          sourceSessionKey: "source:completion",
+        },
+      },
+      manager,
+    )!;
+    expect(await preserve(() => true)).toBe(true);
+    const first = manager.buildSessionContext().messages;
+    expect(first).toHaveLength(1);
+    expect(first[0]).toMatchObject({
+      role: "custom",
+      display: false,
+      details: {
+        fragments: expect.arrayContaining([
+          { kind: "conversation-data", text: "Original result with /tmp/finished.png" },
+        ]),
+      },
+    });
+    await preserve(() => true);
+    expect(manager.buildSessionContext().messages).toHaveLength(1);
+  });
+
+  it("rejects an event whose source differs from its admitted provenance", () => {
+    expect(
+      preserveCompletionForVisibleTurn(
+        {
+          runId: "completion",
+          prompt: "Result",
+          inputProvenance: {
+            kind: "inter_session",
+            sourceTool: "subagent_announce",
+            sourceSessionKey: "expected-child",
+          },
+          internalEvents: [
+            {
+              type: "task_completion",
+              source: "subagent",
+              childSessionKey: "different-child",
+              childSessionId: "child",
+              announceType: "subagent task",
+              taskLabel: "Research",
+              status: "ok",
+              statusLabel: "completed",
+              result: "Saved",
+              replyInstruction: "Reply",
+            },
+          ],
+        },
+        SessionManager.inMemory(),
+      ),
+    ).toBeUndefined();
+  });
+
+  it("preserves receipts and does not duplicate an already recorded result", async () => {
+    const manager = SessionManager.inMemory();
+    manager.appendCustomMessageEntry("openclaw.runtime-context", "existing result", false, {
+      fragments: [{ kind: "conversation-data", text: "Existing completion" }],
+    });
+    manager.appendMessage({ role: "user", content: "Existing tool receipt", timestamp: 1 });
+    const preserve = preserveCompletionForVisibleTurn(
+      {
+        runId: "completion",
+        prompt: "Existing completion",
+        inputProvenance: {
+          kind: "inter_session",
+          sourceTool: "subagent_settle",
+          sourceSessionKey: "child",
+        },
+      },
+      manager,
+    )!;
+    await preserve(() => true);
+    expect(manager.buildSessionContext().messages).toHaveLength(2);
+  });
+
+  it("does not transfer custody after replacement or a failed durable write", async () => {
+    const manager = SessionManager.inMemory();
+    const preserve = preserveCompletionForVisibleTurn(
+      {
+        runId: "completion",
+        prompt: "Result",
+        inputProvenance: {
+          kind: "inter_session",
+          sourceTool: "subagent_settle",
+          sourceSessionKey: "child",
+        },
+      },
+      manager,
+    )!;
+    expect(await preserve(() => false)).toBe(false);
+    expect(manager.buildSessionContext().messages).toHaveLength(0);
+    vi.spyOn(manager, "appendCustomMessageEntry").mockImplementation(() => {
+      throw new Error("disk failure");
+    });
+    await expect(preserve(() => true)).rejects.toThrow("disk failure");
+    expect(manager.buildSessionContext().messages).toHaveLength(0);
+  });
+});

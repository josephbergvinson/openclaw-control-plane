+import { createDeferred } from "openclaw/plugin-sdk/extension-shared";
+import { describe, expect, it, vi } from "vitest";
+import {
+  DISCORD_ROUTE,
+  OWNER_SESSION,
+  cliPreamble,
+  makeHarness,
+  makeTask,
+} from "./detached-lane-runtime.test-support.js";
+
+describe("detached Discord lane contract", () => {
+  it("dispatches an unreceipted natural checkpoint once and keeps later commentary deliverable", async () => {
+    const harness = makeHarness();
+    harness.sendResults.push({});
+    harness.setTasks(OWNER_SESSION, [makeTask()]);
+    await harness.receive();
+    await harness.start();
+    await harness.emitAgentEvent({
+      data: {
+        kind: "preamble",
+        phase: "update",
+        progressText: "I've finished the first pass and am checking the remaining edge cases.",
+        completed: true,
+      },
+    });
+
+    await harness.controller.tick();
+    await harness.controller.tick();
+    expect(harness.sendCalls()).toHaveLength(1);
+    expect(harness.sendCalls().map((call) => call[1].idempotencyKey)).toEqual([
+      "lane-contract:checkpoint:run-1:commentary:item:1:completed",
+    ]);
+    expect(harness.sendCalls()[0]?.[1]).toMatchObject({
+      message: "I've finished the first pass and am checking the remaining edge cases.",
+    });
+
+    await harness.emitAgentEvent({
+      ...cliPreamble(2, {
+        itemId: "next-checkpoint",
+        progressText: "The remaining edge cases are verified; I am preparing the handoff.",
+        completed: true,
+      }),
+    });
+    await harness.controller.tick();
+    await harness.controller.tick();
+    expect(harness.sendCalls().map((call) => call[1].idempotencyKey)).toEqual([
+      "lane-contract:checkpoint:run-1:commentary:item:1:completed",
+      "lane-contract:checkpoint:run-1:commentary:next-checkpoint:completed",
+    ]);
+    expect(harness.sendCalls()[1]?.[1]).toMatchObject({
+      message: "The remaining edge cases are verified; I am preparing the handoff.",
+    });
+  });
+
+  it.each(["natural commentary", "overdue checkpoint request"] as const)(
+    "does not let an unresolved send block another lane's %s",
+    async (progress) => {
+      const harness = makeHarness();
+      const delivery = createDeferred<{ messageId: string }>();
+      harness.sendResults.push(delivery.promise);
+      harness.setTasks(OWNER_SESSION, [makeTask()]);
+      await harness.receive();
+      await harness.start();
+
+      const otherOwner = "agent:main:discord:channel-2";
+      const otherChild = "agent:main:subagent:child-2";
+      const otherRoute = { ...DISCORD_ROUTE, to: "channel-2", threadId: "thread-2" };
+      harness.setTasks(otherOwner, [
+        makeTask({
+          id: "task-2",
+          runId: "run-2",
+          ownerKey: otherOwner,
+          sessionKey: otherChild,
+          childSessionKey: otherChild,
+        }),
+      ]);
+      await harness.receive({
+        messageId: "message-2",
+        sessionKey: otherOwner,
+        route: otherRoute,
+      });
+      await harness.start({
+        runId: "run-2",
+        childSessionKey: otherChild,
+        messageId: "message-2",
+        route: otherRoute,
+      });
+      await harness.emitAgentEvent({});
+      if (progress === "natural commentary") {
+        await harness.emitAgentEvent({
+          runId: "run-2",
+          sessionKey: otherChild,
+          ...cliPreamble(1, {
+            itemId: "other-checkpoint",
+            progressText: "The independent review is complete; I am checking its final notes.",
+            completed: true,
+          }),
+        });
+      } else {
+        harness.setNow(180_000);
+      }
+
+      const tick = harness.controller.tick();
+      try {
+        await vi.waitFor(
+          () => {
+            expect(harness.sendCalls()[0]?.[1]).toMatchObject({
+              to: DISCORD_ROUTE.to,
+              idempotencyKey: "lane-contract:checkpoint:run-1:commentary:item:1:completed",
+            });
+            if (progress === "natural commentary") {
+              expect(harness.sendCalls()[1]?.[1]).toMatchObject({
+                to: otherRoute.to,
+                message: "The independent review is complete; I am checking its final notes.",
+                idempotencyKey:
+                  "lane-contract:checkpoint:run-2:commentary:other-checkpoint:completed",
+              });
+            } else {
+              expect(harness.queueMessage).toHaveBeenCalledWith(
+                expect.objectContaining({ taskId: "task-2", runId: "run-2" }),
+              );
+            }
+          },
+          { timeout: 1_000, interval: 10 },
+        );
+      } finally {
+        delivery.resolve({ messageId: "provider-first-checkpoint" });
+        await tick;
+        harness.controller.dispose();
+      }
+    },
+  );
+
+  it.each(["unconfirmed", "rejected"] as const)(
+    "preserves newer pending commentary when an earlier send is %s",
+    async (outcome) => {
+      const harness = makeHarness();
+      const delivery = createDeferred<unknown>();
+      harness.sendResults.push(delivery.promise);
+      harness.setTasks(OWNER_SESSION, [makeTask()]);
+      await harness.receive();
+      await harness.start();
+      await harness.emitAgentEvent({});
+      const tick = harness.controller.tick();
+      try {
+        await vi.waitFor(() => expect(harness.sendCalls()).toHaveLength(1), {
+          timeout: 1_000,
+          interval: 10,
+        });
+        await harness.emitAgentEvent({
+          ...cliPreamble(2, {
+            itemId: "newer-checkpoint",
+            progressText: "The final checks passed; I am preparing the release notes.",
+            completed: true,
+          }),
+        });
+        expect(harness.sendCalls()).toHaveLength(1);
+
+        if (outcome === "unconfirmed") {
+          delivery.resolve({});
+        } else {
+          delivery.reject(new Error("send observation rejected"));
+        }
+        await tick;
+        await vi.waitFor(
+          async () => {
+            await harness.controller.tick();
+            expect(harness.sendCalls().map((call) => call[1].idempotencyKey)).toEqual([
+              "lane-contract:checkpoint:run-1:commentary:item:1:completed",
+              "lane-contract:checkpoint:run-1:commentary:newer-checkpoint:completed",
+            ]);
+          },
+          { timeout: 1_000, interval: 10 },
+        );
+        await harness.controller.tick();
+        expect(harness.sendCalls()).toHaveLength(2);
+        expect(harness.sendCalls()[1]?.[1]).toMatchObject({
+          message: "The final checks passed; I am preparing the release notes.",
+        });
+      } finally {
+        delivery.resolve({});
+        await tick;
+        harness.controller.dispose();
+      }
+    },
+  );
+
+  it.each(["dispose", "task identity loss"] as const)(
+    "does not revive a lane when its held send settles after %s",
+    async (change) => {
+      const harness = makeHarness();
+      const delivery = createDeferred<{ messageId: string }>();
+      harness.sendResults.push(delivery.promise);
+      harness.setTasks(OWNER_SESSION, [makeTask()]);
+      await harness.receive();
+      await harness.start();
+      await harness.emitAgentEvent({});
+      const tick = harness.controller.tick();
+      try {
+        await vi.waitFor(() => expect(harness.sendCalls()).toHaveLength(1), {
+          timeout: 1_000,
+          interval: 10,
+        });
+        await harness.emitAgentEvent({
+          ...cliPreamble(2, {
+            itemId: "queued-checkpoint",
+            progressText: "The review is complete; I am collecting the final evidence.",
+            completed: true,
+          }),
+        });
+        if (change === "dispose") {
+          harness.controller.dispose();
+        } else {
+          harness.setTasks(OWNER_SESSION, []);
+        }
+
+        delivery.resolve({ messageId: "provider-late-checkpoint" });
+        await harness.gatewayRequest.mock.results[0]?.value;
+        await tick;
+        harness.setTasks(OWNER_SESSION, [makeTask()]);
+        await harness.controller.tick();
+        await harness.emitAgentEvent({ seq: 3 });
+        harness.setNow(600_000);
+        await harness.controller.tick();
+
+        expect(harness.sendCalls().map((call) => call[1].idempotencyKey)).toEqual([
+          "lane-contract:checkpoint:run-1:commentary:item:1:completed",
+        ]);
+        expect(harness.queueMessage).not.toHaveBeenCalled();
+        expect(harness.registeredTool(harness.toolContext())).toBeNull();
+      } finally {
+        delivery.resolve({ messageId: "provider-late-checkpoint" });
+        await tick;
+        harness.controller.dispose();
+      }
+    },
+  );
+
+  it("waits out an unconfirmed send cooldown without replacing the last confirmed receipt", async () => {
+    const harness = makeHarness();
+    harness.setTasks(OWNER_SESSION, [makeTask()]);
+    await harness.receive();
+    await harness.start();
+    harness.setNow(10_000);
+    await harness.emitAgentEvent({});
+    await harness.controller.tick();
+    await harness.controller.tick();
+    harness.setNow(190_000);
+    await harness.controller.tick();
+    expect(harness.queueMessage).toHaveBeenCalledOnce();
+    const firstCue = harness.queueMessage.mock.calls[0]?.[0];
+
+    harness.setNow(200_000);
+    harness.sendResults.push({});
+    await harness.emitAgentEvent({
+      ...cliPreamble(2, {
+        itemId: "unconfirmed-checkpoint",
+        progressText: "The integration review is complete; I am checking the final packaging.",
+        completed: true,
+      }),
+    });
+    await harness.controller.tick();
+    await harness.controller.tick();
+    expect(firstCue?.signal.aborted).toBe(true);
+
+    harness.setNow(379_999);
+    await harness.controller.tick();
+    expect(harness.queueMessage).toHaveBeenCalledOnce();
+    harness.setNow(380_000);
+    await harness.controller.tick();
+    expect(harness.queueMessage).toHaveBeenCalledTimes(2);
+    expect(harness.queueMessage.mock.calls[1]?.[0]).toMatchObject({
+      queueIdentity: "lane-contract:progress:run-1:commentary:item:1:completed",
+    });
+    expect(harness.sendCalls().map((call) => call[1].idempotencyKey)).toEqual([
+      "lane-contract:checkpoint:run-1:commentary:item:1:completed",
+      "lane-contract:checkpoint:run-1:commentary:unconfirmed-checkpoint:completed",
+    ]);
+    harness.controller.dispose();
+  });
+});

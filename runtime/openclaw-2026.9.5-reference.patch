+          });
+        },
+      },
+      behavior: { kind: "command-rpc", hasCommittedSideEffect: currentAttemptCommittedMedia },
+      sessionOverride: { kind: "preserve" },
+      abortSignal: params.abortSignal,
+      runCandidate: async (providerOverride, modelOverride, runOptions) => {

+} from "../src/agents/subagents/announce/subagent-announce.requester-settle-fixture.test-support.js";
+import { maybeWakeRequesterAfterAllChildrenSettled } from "../src/agents/subagents/announce/subagent-announce.requester-settle-wake.js";
+import {
+  completeBatchSpy,
+  deliverSpy,
+  makeSettledChild,
+} from "../src/agents/subagents/announce/subagent-announce.requester-settle-wake.test-support.js";
+import { readToolResultDetails } from "../src/agents/tool-result-error.js";
+import { createMessageTool } from "../src/agents/tools/message-tool-execution.js";
+import {
+  mintMessageActionTurnCapability,
+  revokeMessageActionTurnCapability,
+} from "../src/gateway/message-action-turn-capability.js";
+import type { MessageActionResult } from "../src/infra/outbound/message-action-contracts.js";
+import { createEmptyPluginRegistry } from "../src/plugins/registry.js";
+import { resetPluginRuntimeStateForTest, setActivePluginRegistry } from "../src/plugins/runtime.js";
+import { createTestRegistry } from "../src/test-utils/channel-plugins.js";
+
+const { ChannelType, sendMessageDiscord, makeDiscordRest, loadDiscordPlugin } =
+  await loadDiscordThreadReceiptTestHarness();
+const { discordPlugin } = await loadDiscordPlugin();
+const channelId = "123456789012345678";
+const otherChannelId = "223456789012345678";
+const requester = `agent:main:discord:channel:${channelId}`;
+const cfg = { channels: { discord: { token: "test-token" } } };
+const capabilityTokens: string[] = [];
+
+beforeEach(() => {
+  setActivePluginRegistry(
+    createTestRegistry([{ pluginId: "discord", source: "test", plugin: discordPlugin }]),
+  );
+});
+afterEach(() => {
+  for (const token of capabilityTokens.splice(0)) {
+    revokeMessageActionTurnCapability(token);
+  }
+  resetPluginRuntimeStateForTest();
+  setActivePluginRegistry(createEmptyPluginRegistry());
+});
+
+async function sendFinal(
+  options: {
+    target?: string;
+    currentThread?: string;
+    accountId?: string;
+    final?: boolean;
+    dryRun?: boolean;
+    partial?: boolean;
+    channelType?: number;
+  } = {},
+) {
+  const target = options.target ?? channelId;
+  const { rest, getMock, postMock } = makeDiscordRest();
+  getMock.mockResolvedValue({ id: target, type: options.channelType ?? ChannelType.PublicThread });
+  postMock.mockResolvedValue({ id: "visible-final", channel_id: target });
+  const runId = "requester-yield-1";
+  const sessionId = "requester-session";
+  const toolContext = {
+    currentChannelProvider: "discord",
+    currentChannelId: channelId,
+    currentThreadTs: options.currentThread ?? channelId,
+    currentSourceTurnId: "source-turn-1",
+  };
+  const capability = mintMessageActionTurnCapability({
+    agentId: "main",
+    runId,
+    sessionId,
+    sessionKey: requester,
+    requesterAccountId: "default",
+    toolContext,
+  });
+  capabilityTokens.push(capability);
+  const runMessageAction = vi.fn<
+    NonNullable<NonNullable<Parameters<typeof createMessageTool>[0]>["runMessageAction"]>
+  >(async () => {
+    // Only transport is substituted. The real Discord producer supplies receipt metadata.
+    const result = await sendMessageDiscord(`channel:${target}`, "Child completed.", { cfg, rest });
+    const sendResult = {
+      channel: "discord",
+      to: target,
+      via: "direct" as const,
+      mediaUrl: null,
+      result: { channel: "discord" as const, ...result },
+      deliveryStatus: options.partial ? ("partial_failed" as const) : ("sent" as const),
+      dryRun: options.dryRun ?? false,
+    };
+    return {
+      kind: "send",
+      action: "send",
+      channel: "discord",
+      to: target,
+      handledBy: "core",
+      payload: sendResult,
+      sendResult,
+      dryRun: options.dryRun ?? false,
+    } satisfies MessageActionResult;
+  });
+  const tool = createMessageTool({
+    agentId: "main",
+    agentSessionKey: requester,
+    runId,
+    sessionId,
+    agentAccountId: "default",
+    getRuntimeConfig: () => cfg,
+    messageActionTurnCapability: capability,
+    currentChannelProvider: "discord",
+    currentChannelId: channelId,
+    currentThreadTs: options.currentThread ?? channelId,
+    sourceReplyDeliveryMode: "automatic",
+    runMessageAction,
+  });
+  const args = {
+    action: "send",
+    channel: "discord",
+    target: `channel:${target}`,
+    message: "Child completed.",
+    final: options.final ?? true,
+    ...(options.accountId ? { accountId: options.accountId } : {}),
+    ...(options.dryRun ? { dryRun: true } : {}),
+  };
+  const result = await tool.execute("final-send", args);
+  const delivery = readEmbeddedMessageDeliveryFact(readToolResultDetails(result)?.messageDelivery);
+  const confirmed = isDeliveredMessageToolOnlySourceReplyResult({
+    sourceReplyDeliveryMode: "automatic",
+    toolName: "message",
+    args,
+    result,
+  });
+  const source = {
+    channel: "discord",
+    to: `channel:${channelId}`,
+    accountId: "default",
+    threadId: channelId,
+  };
+  const delivered = hasMessagingToolDeliveryToSource(
+    {
+      didSendViaMessagingTool: true,
+      didDeliverSourceReplyViaMessageTool: confirmed,
+      // The original explicit channel target omitted threadId. Canonical provider evidence must own it.
+      messagingToolSentTargets: [
+        {
+          provider: "discord",
+          to: `channel:${target}`,
+          accountId: "default",
+          sourceReplyFinal: args.final,
+        },
+      ],
+    },
+    source,
+    { requireFinalReply: true },
+  );
+  return { delivered, delivery, postMock, args, result };
+}
+
+describe("existing Discord thread source-final settlement", () => {
+  it("settles a yielded cohort after its one visible message-tool final without retrying or blocking", async () => {
+    const child = makeSettledChild({
+      runId: "child-run",
+      requesterSessionKey: requester,
+      requesterSettleWake: {
+        status: "pending",
+        attemptCount: 0,
+        batchRunIds: ["child-run"],
+        requesterYieldBatch: true,
+        rearmGeneration: 1,
+      },
+    });
+    setSessionStore({
+      [requester]: { sessionId: "requester-session", lastChannel: "discord", lastTo: channelId },
+    });
+    registryRuntimeMock.listSubagentRunsForRequester.mockReturnValue([child]);
+    const sent = await sendFinal();
+    expect(sent.delivery).toMatchObject({
+      status: "settled",
+      partialDelivery: false,
+      sourceReplyDelivered: true,
+    });
+    expect(sent.delivered).toBe(true);
+    // Substitute the model/handoff boundary, retaining the real source-final evidence decision.
+    deliverSpy.mockResolvedValue(
+      sent.delivered
+        ? { delivered: true, path: "direct" }
+        : { delivered: false, path: "direct", reason: "visible_reply_missing" },
+    );
+    const settle = () =>
+      maybeWakeRequesterAfterAllChildrenSettled(
+        wakeParams({
+          requesterSessionKey: requester,
+          settledEntry: child,
+          requesterOrigin: {
+            channel: "discord",
+            to: `channel:${channelId}`,
+            accountId: "default",
+            threadId: channelId,
+          },
+        }),
+      );
+    await expect(settle()).resolves.toBe(true);
+    expect(completeBatchSpy).toHaveBeenCalledExactlyOnceWith(["child-run"], 1, {
+      delivered: true,
+      path: "direct",
+    });
+    expect(child.requesterSettleWake).toBeUndefined();
+    await expect(settle()).resolves.toBe(false);
+    expect(deliverSpy).toHaveBeenCalledOnce();
+    expect(sent.postMock).toHaveBeenCalledOnce();
+  });
+
+  it.each([
+    { name: "different channel", target: otherChannelId },
+    { name: "different source thread", currentThread: otherChannelId },
+    { name: "non-thread channel metadata", channelType: ChannelType.GuildText },
+    { name: "partial send", partial: true },
+    { name: "progress-only send", final: false },
+    { name: "dry run", dryRun: true },
+  ])("does not settle from $name", async ({ name: _name, ...options }) => {
+    const sent = await sendFinal(options);
+    expect(sent.delivery?.sourceReplyDelivered).not.toBe(true);
+    expect(sent.delivered).toBe(false);
+  });
+
+  it("does not admit a different account under the current source capability", async () => {
+    await expect(sendFinal({ accountId: "other-account" })).rejects.toThrow(/account/i);
+  });
+});

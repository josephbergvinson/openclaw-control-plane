+import { Type } from "typebox";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import type { Context, Message } from "../../../llm/types.js";
+import type { AgentMessage } from "../../runtime/index.js";
+import {
+  createAssistant,
+  createAssistantResultStream,
+  createTestSession,
+  registerAgentSessionLoopTestLifecycle,
+  testModel,
+} from "../../sessions/agent-session-loop-correctness.test-support.js";
+import { SessionManager } from "../../sessions/session-manager.js";
+import {
+  clearEmbeddedSessionPromptStates,
+  cloneToolResultPromptProjectionState,
+  getEmbeddedSessionPromptState,
+} from "../session-prompt-state.js";
+import { installToolResultContextGuard } from "../tool-result-context-guard.js";
+import {
+  makeGuardableAgent,
+  makeToolResult,
+  makeUser,
+} from "../tool-result-context-guard.test-support.js";
+import {
+  resolveLiveToolResultAggregateMaxChars,
+  resolveLiveToolResultMaxChars,
+  truncateOversizedToolResultsInMessages,
+} from "../tool-result-truncation.js";
+import { submitEmbeddedAttemptPrompt } from "./attempt-prompt-submit.js";
+import { MidTurnPrecheckSignal } from "./midturn-precheck.js";
+import { shouldPreemptivelyCompactBeforePrompt } from "./preemptive-compaction.js";
+
+registerAgentSessionLoopTestLifecycle();
+const sessionId = "midturn-provider-projection";
+const contextTokenBudget = 200_000;
+const reserveTokens = 20_000;
+const toolResultMaxChars = resolveLiveToolResultMaxChars({
+  contextWindowTokens: contextTokenBudget,
+});
+const toolResultAggregateMaxChars = resolveLiveToolResultAggregateMaxChars({
+  contextWindowTokens: contextTokenBudget,
+  perResultMaxChars: toolResultMaxChars,
+});
+afterEach(() => clearEmbeddedSessionPromptStates([sessionId]));
+
+function createUnmeasuredAssistant(...args: Parameters<typeof createAssistant>) {
+  const message = createAssistant(...args);
+  message.usage = {
+    ...message.usage,
+    input: 0,
+    output: 0,
+    cacheRead: 0,
+    cacheWrite: 0,
+    totalTokens: 0,
+    contextUsage: { state: "unavailable" },
+  };
+  return message;
+}
+
+function createHistory(): Message[] {
+  const messages: Message[] = [
+    { role: "user", content: "Use the retained evidence.", timestamp: Date.now() },
+  ];
+  for (let index = 0; index < 4; index++) {
+    messages.push(
+      createUnmeasuredAssistant(
+        testModel,
+        [{ type: "toolCall", id: `old-${index}`, name: "read_evidence", arguments: {} }],
+        "toolUse",
+      ),
+      {
+        role: "toolResult",
+        toolCallId: `old-${index}`,
+        toolName: "read_evidence",
+        content: [{ type: "text", text: "e".repeat(95_000) }],
+        isError: false,
+        timestamp: Date.now(),
+      },
+    );
+  }
+  messages.push(
+    createUnmeasuredAssistant(testModel, [{ type: "text", text: "Evidence retained." }]),
+  );
+  return messages;
+}
+
+function pressure(messages: AgentMessage[]) {
+  return shouldPreemptivelyCompactBeforePrompt({
+    messages,
+    systemPrompt: "",
+    prompt: "",
+    contextTokenBudget,
+    reserveTokens,
+    toolResultMaxChars,
+  });
+}
+
+async function runProjectedToolLoop(extraHistory?: Message) {
+  const history = createHistory();
+  if (extraHistory) {
+    history.push(extraHistory);
+  }
+  const manager = SessionManager.inMemory();
+  for (const message of history) {
+    manager.appendMessage(message);
+  }
+  const readEvidence = vi.fn(async () => ({
+    content: [{ type: "text" as const, text: "Fresh bounded evidence." }],
+    details: {},
+  }));
+  const { session: activeSession } = await createTestSession({
+    sessionManager: manager,
+    model: { ...testModel, contextWindow: contextTokenBudget },
+    customTools: [
+      {
+        name: "read_evidence",
+        label: "Read evidence",
+        description: "Read bounded synthetic evidence",
+        parameters: Type.Object({}),
+        execute: readEvidence,
+      },
+    ],
+  });
+  const sessionPromptState = getEmbeddedSessionPromptState(sessionId);
+  const projectionState = sessionPromptState.toolResults;
+  const requests: Context["messages"][] = [];
+  const onMidTurnPrecheck = vi.fn();
+  const removeGuard = installToolResultContextGuard({
+    agent: activeSession.agent,
+    contextWindowTokens: contextTokenBudget,
+    midTurnPrecheck: {
+      enabled: true,
+      contextTokenBudget,
+      reserveTokens: () => reserveTokens,
+      toolResultMaxChars,
+      toolResultPromptProjectionState: projectionState,
+      getPrePromptMessageCount: () => history.length,
+      onMidTurnPrecheck,
+    },
+  });
+  activeSession.agent.streamFn = (model, context) => {
+    requests.push(structuredClone(context.messages));
+    const message =
+      requests.length === 1
+        ? createUnmeasuredAssistant(
+            model,
+            [{ type: "toolCall", id: "fresh", name: "read_evidence", arguments: {} }],
+            "toolUse",
+          )
+        : createUnmeasuredAssistant(model, [{ type: "text", text: "Done." }]);
+    return createAssistantResultStream(message);
+  };
+  const sourceBefore = structuredClone(manager.getEntries());
+  try {
+    await submitEmbeddedAttemptPrompt({
+      attempt: { sessionId },
+      activeSession,
+      contextTokenBudget,
+      images: [],
+      modelPrompt: "Continue using the evidence.",
+      onFinalPromptText: () => {},
+      onSteeringAcknowledged: () => {},
+      persistToolResultProjections: async () => {},
+      promptActiveSession: (prompt, options) => activeSession.prompt(prompt, options),
+      runtimeOnly: false,
+      sessionPromptState,
+      systemPrompt: "",
+      toolResultAggregateMaxChars,
+      toolResultMaxChars,
+      toolResultPromptProjectionState: projectionState,
+      trajectoryRecorder: null,
+      transcriptLeafId: manager.getLeafId(),
+      transcriptPrompt: "Continue using the evidence.",
+    });
+  } finally {
+    removeGuard();
+  }
+  expect(manager.getEntries().slice(0, sourceBefore.length)).toEqual(sourceBefore);
+  return { requests, readEvidence, onMidTurnPrecheck, activeSession, history };
+}
+
+describe("mid-turn provider projection budget", () => {
+  it("continues the real tool loop when oversized raw history projects within budget", async () => {
+    const result = await runProjectedToolLoop();
+
+    expect(pressure(result.history).route).not.toBe("fits");
+    expect(result.readEvidence).toHaveBeenCalledOnce();
+    expect(result.onMidTurnPrecheck).not.toHaveBeenCalled();
+    expect(result.requests).toHaveLength(2);
+    expect(pressure(result.requests[1] ?? []).route).toBe("fits");
+    expect(result.requests[1]?.slice(0, result.history.length)).toEqual(
+      result.requests[0]?.slice(0, result.history.length),
+    );
+    expect(result.activeSession.messages.at(-1)).toMatchObject({ stopReason: "stop" });
+  });
+
+  it("still requests recovery when projected non-tool history exceeds the model budget", async () => {
+    const result = await runProjectedToolLoop({
+      role: "user",
+      content: "required ".repeat(24_000),
+      timestamp: Date.now(),
+    });
+
+    expect(result.readEvidence).toHaveBeenCalledOnce();
+    expect(result.requests).toHaveLength(1);
+    expect(result.onMidTurnPrecheck).toHaveBeenCalledOnce();
+    expect(result.onMidTurnPrecheck.mock.calls[0]?.[0]).toMatchObject({
+      overflowTokens: expect.any(Number),
+    });
+    expect(result.activeSession.messages.at(-1)).toMatchObject({ stopReason: "error" });
+  });
+
+  it("previews current projection state without freezing fresh results or mutating history", async () => {
+    const state = getEmbeddedSessionPromptState(sessionId).toolResults;
+    const history = createHistory();
+    const agent = makeGuardableAgent();
+    const removeGuard = installToolResultContextGuard({
+      agent,
+      contextWindowTokens: contextTokenBudget,
+      midTurnPrecheck: {
+        enabled: true,
+        contextTokenBudget,
+        reserveTokens: () => reserveTokens,
+        toolResultMaxChars,
+        toolResultPromptProjectionState: state,
+        getPrePromptMessageCount: () => history.length,
+      },
+    });
+    // Dispatch owns this state change after guard installation. Its frozen
+    // projections must be reused by the next iteration's read-only preview.
+    const sent = truncateOversizedToolResultsInMessages(
+      history,
+      contextTokenBudget,
+      toolResultMaxChars,
+      toolResultAggregateMaxChars,
+      state,
+    ).messages;
+    const messages = [...history, makeUser("continue"), makeToolResult("fresh", "current output")];
+    const sourceBefore = structuredClone(messages);
+    const stateBefore = cloneToolResultPromptProjectionState(state);
+    try {
+      const transformed = await agent.transformContext?.(messages, new AbortController().signal);
+      expect(transformed).toBe(messages);
+      expect(messages).toEqual(sourceBefore);
+      expect(state).toEqual(stateBefore);
+      const projected = truncateOversizedToolResultsInMessages(
+        messages,
+        contextTokenBudget,
+        toolResultMaxChars,
+        toolResultAggregateMaxChars,
+        state,
+      ).messages;
+      expect(projected.slice(0, history.length)).toEqual(sent);
+      expect(state.frozen.size).toBeGreaterThan(stateBefore.frozen.size);
+
+      // Once dispatch has frozen a prefix, a changed aggregate must not pretend

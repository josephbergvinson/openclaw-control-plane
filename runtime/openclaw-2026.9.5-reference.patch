+++ b/src/agents/tools/sessions-send-tool.recovery.test.ts
@@ -0,0 +1,147 @@
+import path from "node:path";
+import { afterEach, expect, it, vi } from "vitest";
+import { clearRuntimeConfigSnapshot, setRuntimeConfigSnapshot } from "../../config/io.js";
+import { upsertSessionEntryCore } from "../../config/sessions/session-accessor.js";
+import type { OpenClawConfig } from "../../config/types.openclaw.js";
+import { withTestDir } from "../../test-helpers/temp-dir.js";
+import {
+  clearActiveEmbeddedRun,
+  setActiveEmbeddedRun,
+  type EmbeddedAgentQueueHandle,
+} from "../embedded-agent-runner/runs.js";
+import { SessionManager } from "../sessions/session-manager.js";
+import * as registryRead from "../subagents/registry/subagent-registry-read.js";
+import type { SubagentRunRecord } from "../subagents/registry/subagent-registry.types.js";
+import { startSessionsSendAgentRun } from "./sessions-send-tool.delivery.js";
+
+// Recovery owns a private transcript while callers retain the logical child key.
+// Steering must reach that execution without opening a second logical-session lane.
+afterEach(() => {
+  clearRuntimeConfigSnapshot();
+  vi.restoreAllMocks();
+});
+
+it.each([
+  "steer",
+  "followup",
+  "starting",
+  "stale-incarnation",
+  "session-rollover",
+  "owner-replaced",
+  "finished-followup",
+] as const)("preserves recovered child execution ownership: %s", async (scenario) => {
+  await withTestDir({ prefix: "openclaw-recovered-send-" }, async (dir) => {
+    const storePath = path.join(dir, "sessions.json");
+    const sessionKey = "agent:main:subagent:logical-child";
+    const privateKey = "agent:main:internal-session-effects:recovered-child";
+    const cfg: OpenClawConfig = { session: { store: storePath } };
+    setRuntimeConfigSnapshot(cfg);
+    const target = { agentId: "main", sessionKey, storePath };
+    const privateTarget = { agentId: "main", sessionKey: privateKey, storePath };
+    await upsertSessionEntryCore(target, { sessionId: "original-child", updatedAt: 1 });
+    await upsertSessionEntryCore(privateTarget, { sessionId: "private-child", updatedAt: 1 });
+    let record: SubagentRunRecord = {
+      runId: "recovered-execution",
+      taskRunId: "original-task",
+      childSessionKey: sessionKey,
+      requesterSessionKey: "agent:main:main",
+      requesterAgentId: "main",
+      requesterDisplayKey: "main",
+      task: "finish the task",
+      cleanup: "keep",
+      createdAt: 1,
+      expectsCompletionMessage: true,
+      execution: {
+        status: scenario === "finished-followup" ? "terminal" : "running",
+        ...(scenario === "finished-followup" ? { endedAt: 2 } : {}),
+        transcriptTarget: { ...privateTarget, sessionId: "private-child" },
+      },
+    };
+    vi.spyOn(registryRead, "getLatestSubagentRunByChildSessionKey").mockImplementation(
+      () => record,
+    );
+    const inject = vi.fn<
+      NonNullable<EmbeddedAgentQueueHandle["messageInjectionV2"]>["queueMessage"]
+    >(async (_text, options, assertCurrent) => {
+      // Model/tool waits must not preserve stale admission after a new owner
+      // or a new logical session incarnation takes over.
+      if (scenario === "owner-replaced") {
+        record = { ...record, runId: "replacement-execution" };
+      }
+      if (scenario === "session-rollover") {
+        await upsertSessionEntryCore(target, { sessionId: "new-child", updatedAt: 2 });
+      }
+      assertCurrent();
+      await options?.userTurnTranscriptRecorder?.persistApproved();
+    });
+    const handle: EmbeddedAgentQueueHandle = {
+      runId: record.runId,
+      queueMessage: vi.fn(),
+      messageInjectionV2: { version: 2, isAvailable: () => true, queueMessage: inject },
+      supportsTranscriptCommitWait: true,
+      isStreaming: () => true,
+      isCompacting: () => false,
+      abort: vi.fn(),
+    };
+    if (scenario !== "starting" && scenario !== "finished-followup") {
+      setActiveEmbeddedRun("private-child", handle, privateKey, undefined, "main");
+    }
+    const callGateway = vi.fn().mockResolvedValue({ runId: "next-execution" });
+    try {
+      const result = await startSessionsSendAgentRun({
+        cfg,
+        callGateway,
+        runId: "guidance-input",
+        mode: scenario.endsWith("followup") ? "followup" : "steer",
+        sessionKey,
+        sessionStoreTarget: { agentId: "main", canonicalKey: sessionKey, storePath },
+        expectedSessionId: scenario === "stale-incarnation" ? "previous-child" : "original-child",
+        sendParams: {
+          message: "Use the original source and finish the task.",
+          agentId: "main",
+          sessionKey,
+          inputProvenance: {
+            kind: "inter_session",
+            sourceSessionKey: "agent:main:main",
+            sourceTool: "sessions_send",
+          },
+          sourceReplyDeliveryMode: "message_tool_only",
+        },
+      });
+      const privateMessages = SessionManager.open(
+        { ...privateTarget, sessionId: "private-child" },
+        dir,
+      )
+        .getEntries()
+        .filter((entry) => entry.type === "message");
+      const originalMessages = SessionManager.open({ ...target, sessionId: "original-child" }, dir)
+        .getEntries()
+        .filter((entry) => entry.type === "message");
+      expect(originalMessages).toHaveLength(0);
+      expect(handle.queueMessage).not.toHaveBeenCalled();
+      if (scenario === "steer") {
+        expect(result).toMatchObject({ ok: true, targetDisposition: "steered" });
+        expect(inject).toHaveBeenCalledOnce();
+        expect(privateMessages).toHaveLength(1);
+        expect(privateMessages[0]).toMatchObject({
+          message: {
+            role: "user",
+            provenance: { kind: "inter_session", sourceSessionKey: "agent:main:main" },
+          },
+        });
+      } else if (scenario === "finished-followup") {
+        expect(result).toMatchObject({
+          ok: true,
+          runId: "next-execution",
+          targetDisposition: "queued",
+        });
+      } else {
+        expect(result).toMatchObject({ ok: false, result: { details: { status: "error" } } });
+        expect(privateMessages).toHaveLength(0);
+      }

+import { createExtensionRuntime, loadExtensionFromFactory } from "../sessions/extensions/loader.js";
+import { SessionManager } from "../sessions/session-manager.js";
+import { SettingsManager } from "../sessions/settings-manager.js";
+import {
+  limitHistoryTurnsMock,
+  resolveEffectiveCompactionModeMock,
+  ensureAuthProfileStoreMock,
+  getApiKeyForModelMock,
+  loadCompactHooksHarness,
+  resetCompactHooksHarnessMocks,
+  sessionCompactImpl,
+  sessionMessages,
+} from "./compact.hooks.harness.js";
+
+const { compactEmbeddedAgentSessionDirect } = await loadCompactHooksHarness();
+const [
+  authProfiles,
+  { upsertSessionEntryCore },
+  { closeOpenClawAgentDatabasesForTest },
+  { AsyncWorkScope, captureAsyncWorkTracker },
+] = await Promise.all([
+  import("../auth-profiles.js"),
+  import("../../config/sessions/session-accessor.js"),
+  import("../../state/openclaw-agent-db.js"),
+  import("../../shared/async-work-scope.js"),
+]);
+const dirs = useAutoCleanupTempDirTracker((cleanup) =>
+  afterEach(() => {
+    vi.restoreAllMocks();
+    closeOpenClawAgentDatabasesForTest();
+    cleanup();
+  }),
+);
+
+describe("compaction provider auth fallback", () => {
+  registerAgentSessionLoopTestLifecycle();
+  let workspaceDir: string;
+  let store: AuthProfileStore;
+  beforeEach(async () => {
+    workspaceDir = await realpath(dirs.make("compaction-auth-fallback-"));
+    resetCompactHooksHarnessMocks(workspaceDir);
+    store = {
+      version: 1,
+      profiles: {
+        "openai:first": createApiKeyCredential("openai", "test-first"),
+        "openai:second": createApiKeyCredential("openai", "test-second"),
+        "openai:outside": createApiKeyCredential("openai", "test-outside"),
+      },
+      order: { openai: ["openai:first", "openai:second"] },
+    };
+    ensureAuthProfileStoreMock.mockReturnValue(store);
+    getApiKeyForModelMock.mockImplementation(async (params) => ({
+      apiKey: `key-${params?.profileId}`,
+      mode: "api-key",
+      source: `profile:${params?.profileId}`,
+      ...(params?.profileId ? { profileId: params.profileId } : {}),
+    }));
+    vi.spyOn(authProfiles, "markAuthProfileFailure").mockResolvedValue();
+  });
+
+  async function compact(
+    source: "auto" | "user" = "auto",
+    trigger: "budget" | "overflow" = "budget",
+  ) {
+    const target = {
+      agentId: "main",
+      sessionId: "auth-fallback",
+      sessionKey: "agent:main:auth-fallback",
+      storePath: join(workspaceDir, "sessions.sqlite"),
+    };
+    await upsertSessionEntryCore(target, { sessionId: target.sessionId, updatedAt: 1 });
+    const scope = new AsyncWorkScope();
+    try {
+      return await scope.run(() =>
+        compactEmbeddedAgentSessionDirect({
+          ...target,
+          sessionTarget: target,
+          sessionFile: target.sessionKey,
+          workspaceDir,
+          provider: "openai",
+          model: "gpt-test",
+          authProfileId: "openai:first",
+          authProfileIdSource: source,
+          trigger,
+          forcePreflight: true,
+          preflightRequired: true,
+          config: {
+            agents: { defaults: { model: { primary: "openai/gpt-test", fallbacks: [] } } },
+          },
+        }),
+      );
+    } finally {
+      await AsyncWorkScope.runWhenAllIdle(
+        () => [scope],
+        () => scope.drain(),
+      );
+    }
+  }
+
+  it("uses the next authorized credential after quota failure without model fallbacks", async () => {
+    sessionCompactImpl.mockRejectedValueOnce(

+        harness.discoveryDiagnostics = diagnostics
+        let result = try await harness.call(.init(action: .credentialPrompts))
+        let roundTrip = try JSONDecoder().decode(
+            OpenClawComputerActResult.self, from: JSONEncoder().encode(result))
+        let decodedRows = roundTrip.details?["credentialPrompts"]?.value as? [AnyCodable]
+        let decodedDiagnostics = roundTrip.details?["credentialPromptDiagnostics"]?.value as? [String: AnyCodable]

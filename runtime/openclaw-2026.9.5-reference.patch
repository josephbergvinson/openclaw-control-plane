+import { beforeEach, describe, expect, it, vi } from "vitest";
+import type { GatewayRequestContext } from "../../gateway/server-methods/types.js";
+import { callAgentToolGatewayRequest } from "./in-process-gateway.js";
+
+const mocks = vi.hoisted(() => ({
+  hasContext: true,
+  context: {} as GatewayRequestContext,
+  dispatch: vi.fn(),
+  transport: vi.fn(),
+}));
+vi.mock("../../gateway/server-plugins.js", () => ({
+  dispatchGatewayMethodInProcess: mocks.dispatch,
+  getInProcessGatewayRequestContext: () => (mocks.hasContext ? mocks.context : undefined),
+  runWithOperatorToolGatewayCleanupContext: <T>(run: () => T) => run(),
+  hasInProcessGatewayContext: () => mocks.hasContext,
+}));
+vi.mock("../../gateway/call.js", () => ({ callGateway: mocks.transport }));
+
+function request() {
+  return {
+    method: "agent",
+    params: { message: "Return the actual child result", sessionKey: "parent-A" },
+    delegatedToolPolicyHandoff: {
+      sourceSessionKey: "child-A",
+      sourceSessionId: "child-id",
+      sourceRole: "subagent" as const,
+      targetSessionKey: "parent-A",
+      targetSessionId: "parent-id",
+      idempotencyKey: "return-A",
+      mcpRequesterScope: { requesterSenderId: "owner-A", messageChannel: "discord" },
+      mcpRequesterScopeAssertCurrent: vi.fn(),
+    },
+  };
+}
+
+describe("native child return handoff transport", () => {
+  beforeEach(() => {
+    mocks.hasContext = true;
+    mocks.dispatch.mockReset().mockResolvedValue({ runId: "return-A" });
+    mocks.transport.mockReset();
+  });
+  it("passes the private registration to dispatch without adding it to agent params", async () => {
+    const call = request();
+    await callAgentToolGatewayRequest(call);
+    expect(mocks.dispatch).toHaveBeenCalledWith(
+      "agent",
+      call.params,
+      expect.objectContaining({ delegatedToolPolicyHandoff: call.delegatedToolPolicyHandoff }),
+    );
+    expect(call.params).not.toHaveProperty("delegatedToolPolicyHandoff");
+    expect(mocks.transport).not.toHaveBeenCalled();
+  });
+  it("rejects an unavailable native Gateway before any wire request", async () => {
+    mocks.hasContext = false;
+    await expect(callAgentToolGatewayRequest(request())).rejects.toThrow(
+      "trusted in-process Gateway dispatch",
+    );
+    expect(mocks.transport).not.toHaveBeenCalled();
+    expect(mocks.dispatch).not.toHaveBeenCalled();
+  });
+  it("does not promote a model-authored params field into private dispatch authority", async () => {
+    const call = request();
+    await callAgentToolGatewayRequest({
+      method: call.method,
+      params: { ...call.params, delegatedToolPolicyHandoff: call.delegatedToolPolicyHandoff },
+    });
+    expect(mocks.dispatch.mock.calls[0]?.[2]).not.toHaveProperty("delegatedToolPolicyHandoff");
+  });
+});

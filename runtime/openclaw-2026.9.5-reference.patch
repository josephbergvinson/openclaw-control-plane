+import fs from "node:fs";
+import path from "node:path";
+import { describe, expect, it } from "vitest";
+import {
+  resolveBuildAllStep,
+  resolveBuildAllStepOnCacheHit,
+  resolveBuildAllSteps,
+} from "../../scripts/build-all.mts";
+import { resolveBuildStepCacheState } from "../../scripts/lib/build-artifact-cache.mts";
+import { resolveTsdownDeclarationGeneratorInputs } from "../../scripts/lib/tsdown-declaration-generator-inputs.mts";
+import { parseTsdownBuildArgs } from "../../scripts/tsdown-build.mts";
+import { createScriptTestHarness } from "./test-helpers.js";
+
+const { createTempDir } = createScriptTestHarness();
+
+describe("package cleanup admission", () => {
+  it.each([false, true])(
+    "moves the exact package reset to the first compiler (runtime-only: %s)",
+    (runtimeOnly) => {
+      const env = { OPENCLAW_RUN_NODE_SKIP_DTS_BUILD: runtimeOnly ? "1" : "0" };
+      const full = resolveBuildAllSteps("full", env);
+      const packaged = resolveBuildAllSteps("package", env);
+      expect(packaged.map((step) => step.label)).toEqual(full.map((step) => step.label));
+      expect(packaged).not.toContainEqual(expect.objectContaining({ label: "clean:dist" }));
+      const compilers = packaged.filter((step) => step.label.startsWith("tsdown"));
+      expect(compilers[0]?.label).toBe(runtimeOnly ? "tsdown" : "tsdown-ai");
+      for (const [index, step] of compilers.entries()) {
+        const command = resolveBuildAllStep(step, { env });
+        expect(command.args.filter((arg) => arg === "--clean-package-dist")).toHaveLength(
+          index === 0 ? 1 : 0,
+        );
+      }
+      for (const step of full) {
+        expect(resolveBuildAllStep(step, { env }).args).not.toContain("--clean-package-dist");
+      }
+    },
+  );
+
+  it("retains the package reset and workspace declaration cache on an AI cache hit", () => {
+    const first = resolveBuildAllSteps("package").find((step) => step.label === "tsdown-ai");
+    if (!first) {
+      throw new Error("missing package AI compiler");
+    }
+    const hit = resolveBuildAllStepOnCacheHit(first);
+    if (!hit) {
+      throw new Error("missing AI cache-hit command");
+    }
+    const command = resolveBuildAllStep(hit, { env: {} });
+    expect(command.args).toContain("--clean-package-dist");
+    expect(command.options.env.OPENCLAW_RUN_NODE_SKIP_DTS_BUILD).toBe("1");
+    expect(first.cache?.outputs).toEqual(
+      expect.arrayContaining([expect.objectContaining({ path: "packages/ai/dist" })]),
+    );
+    const parsed = parseTsdownBuildArgs(
+      command.args.slice(command.args.indexOf("scripts/tsdown-build.mts") + 1),
+    );
+    expect(parsed).toMatchObject({
+      cleanPackageDist: true,
+      forwardedArgs: ["--config", "tsdown.ai.config.ts"],
+    });
+  });
+
+  it("captures the extracted process owner in generator inputs and declaration cache signatures", () => {
+    const owner = "scripts/lib/tsdown-process.mts";
+    const inputs = resolveTsdownDeclarationGeneratorInputs(
+      process.cwd(),
+      "scripts/write-unified-entry-dts.ts",
+    );
+    expect(inputs).toContain(path.resolve(owner));
+    const root = createTempDir("tsdown-process-cache-");
+    const file = path.join(root, owner);
+    fs.mkdirSync(path.dirname(file), { recursive: true });
+    fs.writeFileSync(file, "first process owner");
+    const first = resolveBuildAllSteps("package").find((step) => step.label === "tsdown-ai");
+    if (!first) {
+      throw new Error("missing AI cache owner");
+    }
+    const before = resolveBuildStepCacheState(first, { rootDir: root, env: {} });
+    expect(before.signature).toEqual(expect.any(String));
+    fs.writeFileSync(file, "changed process owner");
+    const after = resolveBuildStepCacheState(first, { rootDir: root, env: {} });
+    expect(after.signature).not.toBe(before.signature);
+  });
+});

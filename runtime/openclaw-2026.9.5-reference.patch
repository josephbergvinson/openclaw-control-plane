+  const read = () => loadSessionEntry(scope) as InternalSessionEntry;
+  return {
+    scope,
+    sourceTurnId,
+    controller,
+    recorder,
+    read,
+    interrupt: () => {
+      restartAbort = true;
+    },
+    resume: () => {
+      restartAbort = false;
+    },
+  };
+}
+
+function recover(h: Awaited<ReturnType<typeof setup>>, entry = h.read()) {
+  return resolveAgentRestartRecoveryContext({
+    isRestartRecoveryResumeRun: true,
+    canUseInternalRuntimeHandoff: true,
+    expectedExistingSessionId: "original-session",
+    resolvedSessionId: "original-session",
+    runId: entry.restartRecoveryDeliveryRunId ?? "missing",
+    sessionEntry: entry,
+  });
+}
+
+it("native source admission survives interruption and exact recovery adoption, then retires with the claim", async () => {
+  const h = await setup();
+  const original = h.controller();
+  await expect(original.admitUserTurn(h.recorder)).resolves.toBe("admitted");
+  expect(h.recorder.hasPersisted()).toBe(true);
+  const admitted = h.read();
+  expect(admitted.restartRecoveryProgressSourceMessageId).toBe("900");
+  expect(admitted.restartRecoveryDeliverySourceRunId).toBe(h.sourceTurnId);
+  h.interrupt();
+  await original.clear();
+  expect(h.read().restartRecoveryProgressSourceMessageId).toBe("900");
+
+  h.resume();
+  const resumed = h.controller(admitted.restartRecoveryDeliveryRunId);
+  await expect(resumed.admitUserTurn()).resolves.toBe("admitted");
+  const channel = recover(h)?.channel;
+  expect(channel).toMatchObject({ currentMessageId: "900", sourceTurnId: h.sourceTurnId });
+  if (!channel) {
+    throw new Error("native recovery channel custody missing");
+  }
+  const identity = {
+    agentId: "main",
+    runId: "resumed-model-run",
+    sessionKey: h.scope.sessionKey,
+    sessionId: "original-session",
+  };
+  const params = {
+    ...buildAgentAttemptToolContext({
+      messageChannel: channel.channel,
+      opts: { message: "Resume the original request" },
+      runContext: {
+        accountId: channel.requesterAccountId,
+        senderId: channel.requesterSenderId,
+        currentChannelId: channel.currentChannelId,
+        currentMessageId: channel.currentMessageId,
+      },
+      spawnedBy: undefined,
+    }),
+    ...identity,
+    timeoutMs: 60_000,
+  };
+  setChannelSourceTurnId(params, channel.sourceTurnId);
+  const token = createRecoveryMessageActionTurnCapability(params);
+  try {
+    expect(
+      resolveMessageActionTurnAuthorization({ ...identity, token })?.sourceProgressRequest,
+    ).toEqual({
+      sessionKey: h.scope.sessionKey,
+      sessionId: "original-session",
+      sourceMessageId: "900",
+      requestGeneration: "900",
+    });
+    expect(resolveMessageActionTurnCapability({ ...identity, token })).not.toHaveProperty(
+      "sourceProgressRequest",
+    );
+  } finally {
+    revokeMessageActionTurnCapability(token);
+  }
+  await resumed.clear();
+  expect(h.read().restartRecoveryProgressSourceMessageId).toBeUndefined();
+  expect(recover(h)).toBeUndefined();
+});
+
+it("durable native admission rejects original locator drift at its actual SQLite commit boundary", async () => {
+  const h = await setup();
+  await updateSessionEntry(h.scope, () => ({
+    status: "done",
+    restartRecoveryDeliveryRunId: "previous-run",
+    restartRecoveryDeliverySourceRunId: "previous-source",
+    restartRecoveryProgressSourceMessageId: "800",
+  }));
+  const delegate = h.recorder;
+  const recorder = {
+    ...delegate,
+    persistApproved: async (
+      options?: Parameters<UserTurnTranscriptRecorder["persistApproved"]>[0],
+    ) => {
+      await updateSessionEntry(h.scope, () => ({ restartRecoveryProgressSourceMessageId: "801" }));
+      return delegate.persistApproved(options);
+    },
+  } satisfies UserTurnTranscriptRecorder;
+  await expect(h.controller().admitUserTurn(recorder)).rejects.toThrow(
+    "session changed before durable user-turn admission",
+  );
+  expect(delegate.hasPersisted()).toBe(false);
+  expect(h.read()).toMatchObject({
+    restartRecoveryDeliveryRunId: "previous-run",
+    restartRecoveryDeliverySourceRunId: "previous-source",
+    restartRecoveryProgressSourceMessageId: "801",
+  });
+});
+
+it("legacy source claims retain channel authority but cannot invent an original progress locator", async () => {
+  const h = await setup();
+  await updateSessionEntry(h.scope, () => ({
+    restartRecoveryDeliveryRunId: "legacy-run",
+    restartRecoveryDeliverySourceRunId: h.sourceTurnId,
+    restartRecoverySourceIngress: "channel",
+    restartRecoveryDeliveryContext: { channel: "discord", to: "channel:123" },
+  }));
+  expect(recover(h)?.channel).toMatchObject({
+    currentChannelId: "channel:123",
+    sourceTurnId: h.sourceTurnId,
+  });
+  expect(recover(h)?.channel?.currentMessageId).toBeUndefined();
+  expect(recover(h, { ...h.read(), sessionId: "replacement" })).toBeUndefined();
+});

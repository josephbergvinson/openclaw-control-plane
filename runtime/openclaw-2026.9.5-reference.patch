+import { afterEach, describe, expect, it, vi } from "vitest";
+import { createEmbeddedRunHandle } from "../../agents/embedded-agent-runner/runs.test-support.js";
+import { QuestionAnswerUnconfirmedError } from "../../agents/harness/gateway-question-dispatch.js";
+import {
+  retryRetainedFollowupSteers,
+  type ActiveReplySteerParams,
+} from "./agent-runner-steer-adoption.js";
+import { bindRetainedReplySteerSource } from "./agent-runner-steer-source.js";
+import { clearSessionQueues, enqueueFollowupRun } from "./queue.js";
+import { createQueueTestRun } from "./queue.test-helpers.js";
+import { getExistingFollowupQueue } from "./queue/state.js";
+import { withQuestionCreator } from "./reply-run-question.test-support.js";
+import { createMockTypingController } from "./test-helpers.js";
+import { createTypingSignaler } from "./typing-mode.js";
+
+function sourceParams(): ActiveReplySteerParams {
+  const typing = createMockTypingController();
+  return {
+    followupRun: createQueueTestRun({ prompt: "source input", messageId: "A" }),
+    opts: { onBlockReply: vi.fn(async () => undefined) },
+    providedReplyOperation: undefined,
+    queueKey: "agent:main:original-channel-source",
+    releaseAdmissionTicket: () => undefined,
+    replyOperationRunState: undefined,
+    resolvedQueue: { mode: "steer", debounceMs: 0 },
+    restartRecoverySourceTurnId: "A",
+    runFollowup: vi.fn(async () => undefined),
+    sessionCtx: {},
+    sessionKey: "agent:main:original-channel-source",
+    touchActiveSessionEntry: async () => undefined,
+    typing,
+    typingSignals: createTypingSignaler({ typing, mode: "never", isHeartbeat: false }),
+    toolAuthorityFingerprint: "fixture-bound-at-runtime",
+  };
+}
+
+describe("original channel retained source contract", () => {
+  afterEach(() => vi.restoreAllMocks());
+
+  it.each(["drop", "room-event", "missing-callback"] as const)(
+    "does not invent an original channel delivery owner for %s",
+    (condition) => {
+      const params = sourceParams();
+      if (condition === "drop") {
+        params.followupRun.queuedFollowupReplyDisposition = {
+          kind: "drop",
+          reason: "source-unavailable",
+        };
+      } else if (condition === "room-event") {
+        params.sessionCtx.InboundEventKind = "room_event";
+      } else {
+        params.opts = undefined;
+      }
+      bindRetainedReplySteerSource(params);
+      expect(params.followupRun.retrySteer).toBeUndefined();
+    },
+  );
+
+  it("joins original settlement after failed notice delivery and preserves that delivery error", async () => {
+    const params = sourceParams();
+    const deliveryError = new Error("original transport failed");
+    const cleanupError = new Error("original settlement failed");
+    const delivery = vi.fn(async () => {
+      throw deliveryError;
+    });
+    const settled = vi.fn(async () => {
+      throw cleanupError;
+    });
+    params.opts = { onBlockReply: delivery, onQueuedFollowupSettled: settled };
+    await withQuestionCreator(
+      params.queueKey,
+      params.followupRun,
+      async (operation, fingerprint) => {
+        params.providedReplyOperation = operation;
+        params.toolAuthorityFingerprint = fingerprint;
+        bindRetainedReplySteerSource(params);
+        enqueueFollowupRun(
+          params.queueKey,
+          params.followupRun,
+          params.resolvedQueue,
+          "none",
+          params.runFollowup,
+          false,
+        );
+        const queueMessage = vi.fn(async () => {
+          throw new QuestionAnswerUnconfirmedError(new Error("lost confirmation"));
+        });
+        const cancel = vi.fn();
+        operation.setPhase("running");
+        operation.attachBackend({
+          ...createEmbeddedRunHandle({
+            runId: "accepted-backing-work",
+            toolAuthorityFingerprint: fingerprint,
+            supportsTranscriptCommitWait: true,
+          }),
+          kind: "embedded",
+          supportsQueueMessageContext: true,
+          isSteeringCatalogCurrent: () => true,
+          cancel,
+          messageInjectionV2: { version: 2, isAvailable: () => true, queueMessage },
+        });
+        try {
+          await expect(retryRetainedFollowupSteers(operation)).rejects.toBe(deliveryError);
+          expect(delivery).toHaveBeenCalledTimes(1);
+          expect(settled).toHaveBeenCalledTimes(1);
+          expect(queueMessage).toHaveBeenCalledTimes(1);
+          expect(params.runFollowup).not.toHaveBeenCalled();
+          expect(cancel).not.toHaveBeenCalled();
+          expect(getExistingFollowupQueue(params.queueKey)?.items ?? []).toEqual([]);
+        } finally {
+          clearSessionQueues([params.queueKey]);
+        }
+      },
+    );
+  });
+});

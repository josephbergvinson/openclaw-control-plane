+import { releasePreparedAgentRunUserTurn } from "../../gateway/agent-turn/agent-run-user-turn.js";
+import { createDirectChatContext } from "../../gateway/server-chat.agent-events.test-helpers.js";
+import {
+  createAgentEventHandler,
+  createChatRunState,
+  createSessionEventSubscriberRegistry,
+  createSessionMessageSubscriberRegistry,
+} from "../../gateway/server-chat.js";
+import { persistGatewaySessionLifecycleEvent } from "../../gateway/session-lifecycle-state.js";
+import {
+  emitAgentEvent,
+  getAgentEventLifecycleGeneration,
+  onAgentRuntimeEvent,
+  withAgentRunLifecycleGeneration,
+} from "../../infra/agent-events.js";
+import { clearAgentRunContext } from "../../infra/agent-run-registry.js";
+import { buildOutboundSessionContext } from "../../infra/outbound/session-context.js";
+import { createNonExitingRuntime } from "../../runtime.js";
+import {
+  beginSessionWorkAdmission,
+  type SessionWorkAdmissionLease,
+} from "../../sessions/session-lifecycle-admission.js";
+import { withOpenClawTestState } from "../../test-utils/openclaw-test-state.js";
+import { prepareSystemAgentRunAdmission } from "../admitted-run-context.js";
+import { runWithAgentCommandRecoveryOwner } from "../agent-command-recovery-owner.js";
+import { buildAgentRunTerminalOutcome } from "../agent-run-terminal-outcome.js";
+import { runAcpAgentCommand } from "./acp-execution.js";
+import { prepareEmbeddedSessionState } from "./session-preparation.js";
+import type { AgentCommandOpts } from "./types.js";
+
+const recoveryScheduler = vi.hoisted(() => ({ schedule: vi.fn() }));
+
+// This fixture represents the Gateway host inside a Vitest thread; retain the
+// real native Workers so task reads use the actual broker and SQLite actor.
+vi.mock("node:worker_threads", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("node:worker_threads")>()),
+  isMainThread: true,
+}));
+
+vi.mock("../main-session-recovery/main-session-recovery-owner-release.js", () => ({
+  scheduleMainSessionRecoveryPendingTarget: recoveryScheduler.schedule,
+}));
+// Provider discovery is outside this proof. Admission, private-input validation,
+// transcript custody, event routing, lifecycle persistence and release are real.
+vi.mock("../prepared-model-runtime.js", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("../prepared-model-runtime.js")>()),
+  loadPublishedGatewayReplyDispatchRuntime: async () => ({
+    config: {},
+    agentId: "main",
+    agentDir: "/fixture/agent",
+    workspaceDir: "/fixture/workspace",
+  }),
+  acquireAgentRunPreparedModelRuntime: async () => ({
+    [Symbol.asyncDispose]: async () => {},
+  }),
+}));
+vi.mock("../../skills/discovery/agent-filter.js", () => ({
+  resolveEffectiveAgentSkillFilter: () => undefined,
+}));
+vi.mock("./runtime-loaders.js", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("./runtime-loaders.js")>()),
+  loadSkillsRuntime: async () => ({
+    getRemoteSkillEligibility: () => ({}),
+    resolveReusableWorkspaceSkillSnapshot: () => ({ snapshot: undefined, shouldRefresh: false }),
+  }),
+  loadExecDefaultsRuntime: async () => ({
+    resolveNodeExecEligibility: () => ({ canExec: false }),
+  }),
+}));
+
+describe("private completion recovery projection", () => {
+  it.each([
+    { sourceTool: "subagent_settle", privateCompletion: true, backend: "embedded" },
+    { sourceTool: "subagent_announce", privateCompletion: true, backend: "embedded" },
+    { sourceTool: "subagent_settle", privateCompletion: true, backend: "acp" },
+    { sourceTool: "subagent_settle", privateCompletion: false, backend: "embedded" },
+    { sourceTool: "sessions_send", privateCompletion: false, backend: "embedded" },
+  ])(
+    "retains original recovery only for validated private completion ($sourceTool/$privateCompletion/$backend)",
+    async ({ sourceTool, privateCompletion, backend }) => {
+      recoveryScheduler.schedule.mockClear();
+      await withOpenClawTestState({ label: "private-completion-recovery" }, async (state) => {
+        await state.writeConfig({});
+        const target = {
+          sessionAgentId: "main",
+          isNewSession: false,
+          sessionId: "interrupted-session",
+          sessionKey: "agent:main:private-completion-recovery",
+          storePath: path.join(state.sessionsDir(), "sessions.json"),
+        };
+        await replaceSessionEntry(target, {
+          sessionId: target.sessionId,
+          updatedAt: 100,
+          status: "running",
+          abortedLastRun: true,
+          restartRecoveryDeliverySourceRunId: "channel-user:original-music-request",
+          restartRecoveryRuns: [{ runId: "interrupted-user-run", lifecycleGeneration: "old" }],
+        });
+        const lifecycleGeneration = getAgentEventLifecycleGeneration();
+        let heldRecoveryRuns = [{ runId: "interrupted-user-run", lifecycleGeneration: "old" }];
+        const opts: AgentCommandOpts = {
+          message: "Process the child privately; NO_REPLY if no visible reply is owed.",
+          runId: "announce:requester-settle:completion",
+          deliver: false,
+          skipInitialSessionTouch: true,
+          preserveUserFacingSessionModelState: true,
+          sourceReplyDeliveryMode: "automatic",
+          inputProvenance: {
+            kind: "inter_session",
+            sourceSessionKey: "agent:main:subagent:completed-child",
+            sourceChannel: "internal",
+            sourceTool,
+          },
+        };
+        const runId = opts.runId ?? "announce:requester-settle:completion";
+        const context = createDirectChatContext();
+        let workAdmission: SessionWorkAdmissionLease | undefined;
+        let runAbort:
+          | NonNullable<Awaited<ReturnType<typeof prepareAgentRunDispatch>>>["activeRunAbort"]
+          | undefined;
+        const persistence: Promise<void>[] = [];
+        const chatRunState = createChatRunState();
+        const handler = createAgentEventHandler({
+          broadcast: vi.fn(),
+          broadcastToConnIds: vi.fn(),
+          nodeHasSessionSubscribers: () => false,
+          nodeSendToSession: vi.fn(),
+          chatRunState,
+          agentRunSeq: new Map(),
+          toolEventRecipients: chatRunState.toolEventRecipients,
+          sessionMessageSubscribers: createSessionMessageSubscriberRegistry(),
+          sessionEventSubscribers: createSessionEventSubscriberRegistry(),
+          clearAgentRunContext,
+          resolveSessionKeyForRun: () => {
+            throw new Error("The command event lost its captured session owner");
+          },
+          persistGatewaySessionLifecycleEventForEvent: (event) => {
+            const pending = persistGatewaySessionLifecycleEvent(event);
+            persistence.push(pending);
+            return pending;
+          },
+        });
+        const terminal = vi.fn();
+        const unsubscribe = onAgentRuntimeEvent((event) => {
+          handler(event);
+          if (event.runId === runId && event.stream === "lifecycle" && event.data.phase === "end") {
+            terminal(event);
+          }
+        });
+        const io = { emitAcceptance: vi.fn(), emitFinal: vi.fn() };
+        try {
+          const prepared = await withAgentRunLifecycleGeneration(lifecycleGeneration, async () => {
+            const admitted = await prepareAgentRunDispatch({
+              promptedAt: Date.now(),
+              request: {
+                message: opts.message,
+                idempotencyKey: runId,
+                sessionKey: target.sessionKey,
+                expectedExistingSessionId: target.sessionId,
+                deliver: false,
+                sourceReplyDeliveryMode: "automatic",
+              },
+              cfg: {},
+              sessionEntry: loadSessionEntry(target),
+              resolvedSessionKey: target.sessionKey,
+              activeSessionAgentId: "main",
+              delivery: {
+                activeSessionAgentId: "main",
+                deliver: false,
+                deliveryPlan: {
+                  baseDelivery: { mode: "implicit", channel: "webchat" },
+                  resolvedChannel: "webchat",
+                },
+                resolvedChannel: "webchat",
+                deliveryTargetMode: undefined,
+                resolvedAccountId: undefined,
+                resolvedTo: undefined,
+              },
+              allowModelOverride: false,
+              lifecycleGeneration,
+              getAdmittedSessionId: () => target.sessionId,
+              suppressVisibleSessionEffects: false,
+              inputProvenance: opts.inputProvenance,
+              isOneShotModelRun: false,
+              isRestartRecoveryResumeRun: false,
+              canUseInternalRuntimeHandoff: true,
+              message: opts.message,
+              effectiveTranscriptInputText: opts.message,
+              images: [],
+              offloadedRefs: [],
+              onUserTurnMediaPersisted: () => {},
+              requestedPromptPersistenceSuppression: false,
+              ...(privateCompletion ? { privateCompletion: true } : {}),
+              runId,
+              agentDedupeKeys: [`agent:${runId}`],
+              context,
+              client: null,
+              io,
+              abortForLifecycleRotation: () => false,
+              acquireGatewayWorkAdmission: async (scope) => {
+                workAdmission = await beginSessionWorkAdmission({
+                  scope,
+                  identities: [target.sessionKey, target.sessionId],
+                  assertAllowed: () => {},
+                });
+              },
+              assertGatewayWorkAdmissionAllowed: () => {},
+              hasGatewayAdmissionOutcome: () => false,
+              respondToGatewayAdmissionOutcome: () => false,
+              admissionAgentId: () => "main",
+              getGatewayWorkAdmission: () => workAdmission,
+              setAdmittedRunAbort: (value) => {
+                runAbort = value;
+              },
+              getAdmittedRunAbort: () => runAbort,
+              markAgentRunAccepted: () => {},
+            });
+            expect(io.emitAcceptance).toHaveBeenCalledWith(
+              [true, expect.objectContaining({ runId, status: "accepted" }), undefined],
+              { runId },
+            );
+            assert(admitted);
+            await runWithAgentCommandRecoveryOwner({
+              lifecycleGeneration,
+              mode: "claim",
+              opts,
+              prepare: async () => target,
+              run: async () => {
+                const held = loadSessionEntry(target);
+                assert(held?.mainRestartRecovery?.foregroundClaims);
+                expect(
+                  Object.values(held.mainRestartRecovery.foregroundClaims.runIdsByClaimId ?? {}),
+                ).toContain(runId);
+                heldRecoveryRuns = structuredClone(held.restartRecoveryRuns ?? []);
+                expect(heldRecoveryRuns).toContainEqual({
+                  runId: "interrupted-user-run",
+                  lifecycleGeneration: "old",
+                });
+                assert(admitted.userTurn.recorder);
+                opts.userTurnTranscriptRecorder = admitted.userTurn.recorder;
+                if (backend === "acp") {
+                  const manager = getAcpSessionManager();
+                  const backendTurn = vi
+                    .spyOn(manager, "runTurn")
+                    .mockImplementation(async (input) => {
+                      await input.onBeforePrompt?.();
+                      await input.onEvent?.({
+                        type: "done",
+                        status: "completed",
+                        stopReason: "end_turn",
+                      });
+                    });
+                  const runtimeAdmission = prepareSystemAgentRunAdmission(
+                    {},
+                    runId,
+                    "main",
+                    "private-completion-test",
+                  );
+                  try {
+                    await runAcpAgentCommand({
+                      preparedRunAdmission: runtimeAdmission,
+                      cfg: {},
+                      deps: {},
+                      runtime: createNonExitingRuntime(),
+                      opts,
+                      outboundSession: buildOutboundSessionContext({
+                        cfg: {},
+                        agentId: "main",
+                        sessionKey: target.sessionKey,
+                      }),
+                      ...target,
+                      sessionEntry: held,
+                      body: opts.message,
+                      transcriptBody: opts.message,
+                      suppressVisibleSessionEffects: false,
+                      provenance: "system",
+                      workspaceDir: state.workspaceDir,
+                      runId,
+                      lifecycleGeneration,
+                      acpManager: manager,
+                      acpResolution: {
+                        kind: "ready",
+                        sessionKey: target.sessionKey,
+                        agentId: "main",
+                        meta: {
+                          backend: "fixture",
+                          agent: "main",
+                          runtimeSessionName: "fixture",
+                          mode: "persistent",
+                          state: "idle",
+                          lastActivityAt: 1,
+                        },
+                      },
+                      trackInternalModelRunTarget: () => {},
+                    });
+                    expect(backendTurn).toHaveBeenCalledOnce();
+                  } finally {
+                    backendTurn.mockRestore();
+                    runtimeAdmission.close();
+                  }
+                } else {
+                  await prepareEmbeddedSessionState({
+                    cfg: {},
+                    opts,
+                    ...target,
+                    lifecycleGeneration,
+                    runId,
+                    workspaceDir: state.workspaceDir,
+                    executionWorkspaceDir: state.workspaceDir,
+                    watchSkills: false,
+                    isSubagentLaneTurn: false,
+                    suppressVisibleSessionEffects: false,
+                    sessionStateActor: { actorType: "system" },
+                  });
+                  expect(await admitted.userTurn.recorder.persistApproved()).toMatchObject({
+                    appended: true,
+                  });
+                  admitted.userTurn.recorder.completeProcessing?.(
+                    buildAgentRunTerminalOutcome({ status: "ok" }),
+                  );
+                  emitAgentEvent({
+                    runId,
+                    lifecycleGeneration,
+                    stream: "lifecycle",
+                    data: {
+                      phase: "end",
+                      endedAt: Date.now(),
+                      executionSettled: true,
+                    },
+                  });
+                }
+                await Promise.all(persistence);
+                expect(terminal).toHaveBeenCalledOnce();
+                if (privateCompletion) {
+                  admitted.userTurn.recorder.completeProcessing?.(
+                    buildAgentRunTerminalOutcome({ status: "ok" }),
+                  );
+                  expect(admitted.userTurn.recorder.getProcessingCompletion?.()).toMatchObject({
+                    status: "ok",
+                    reason: "completed",
+                  });
+                }
+              },
+            });
+            return admitted;
+          });
+          try {
+            const stored = loadSessionEntry(target);
+            assert(stored);
+            if (privateCompletion) {
+              expect(stored.abortedLastRun).toBe(true);
+              expect(stored.restartRecoveryRuns).toEqual(heldRecoveryRuns);
+              expect(stored.mainRestartRecovery?.foregroundClaims).toBeUndefined();
+              expect(recoveryScheduler.schedule).toHaveBeenCalledExactlyOnceWith({
+                agentId: "main",
+                sessionId: target.sessionId,
+                sessionKey: target.sessionKey,
+                storePath: target.storePath,
+              });
+              expect(persistence).toHaveLength(0);
+            } else {
+              expect(stored.abortedLastRun).toBe(false);
+              expect(stored.mainRestartRecovery).toBeUndefined();
+              expect(recoveryScheduler.schedule).toHaveBeenCalledExactlyOnceWith(undefined);
+              expect(persistence).toHaveLength(1);
+            }
+            expect(stored.restartRecoveryDeliverySourceRunId).toBe(
+              "channel-user:original-music-request",
+            );
+          } finally {
+            releasePreparedAgentRunUserTurn(prepared.userTurn, "interrupted");
+            await prepared.preparedModelRuntimeLease[Symbol.asyncDispose]();
+            prepared.releaseCallerAuthority?.();
+            prepared.activeRunAbort.cleanup();
+            prepared.activeGatewayWorkAdmission.release();
+          }
+        } finally {
+          runAbort?.cleanup();
+          workAdmission?.release();
+          unsubscribe();
+          handler.dispose();
+          clearAgentRunContext(runId);
+        }
+      });
+    },
+  );
+});

   if (policy?.mode !== "account") {
     return undefined;
   }
-  const requester = normalizeCronToolsAllowProvenance(job.toolsAllowProvenance)?.channelRequester;
-  return requester?.accountId === policy.ownerAccountId ? requester : undefined;
+  const provenance = normalizeCronToolsAllowProvenance(job.toolsAllowProvenance);
+  const requester = provenance?.channelRequester;
+  if (
+    requester?.accountId !== policy.ownerAccountId ||
+    (provenance?.callerOrigin?.kind === "external" &&
+      provenance.callerOrigin.channel !== requester.channel)
+  ) {
+    return undefined;
+  }
+  return requester;
 }

@@ -0,0 +1,49 @@
+import { describe, expect, it } from "vitest";
+import { buildRequesterSettleWakeMessage } from "./subagent-announce.requester-settle-message.js";
+
+describe("requester-settle progress and final-answer ownership", () => {
+  it.each(
+    [false, true].flatMap((requireVisibleReply) =>
+      [false, true].map((paused) => ({ requireVisibleReply, paused })),
+    ),
+  )(
+    "allows progress without closing the request (visible=$requireVisibleReply, paused=$paused)",
+    ({ requireVisibleReply, paused }) => {
+      const message = buildRequesterSettleWakeMessage({
+        requireVisibleReply,
+        ...(paused ? { pausedChildSessionKeys: ["agent:main:subagent:paused"] } : {}),
+        children: [],
+        preserveModelRouteNotice: false,
+      });
+
+      expect(message).toContain(
+        paused
+          ? "Continue the same child session when more work is needed"
+          : "continue any remaining in-scope work before the final answer",
+      );
+      expect(message).toContain("Useful intermediate progress updates remain appropriate");
+      expect(message).toContain("through this turn's permitted messaging route");
+      expect(message).toContain("A progress update is not the consolidated final answer");
+      if (requireVisibleReply) {
+        expect(message).not.toContain("NO_REPLY");
+        expect(message).toContain("visible final answer only after the requested outcome");
+      } else {
+        expect(message).toContain(
+          "NO_REPLY only if you already delivered the consolidated final answer",
+        );
+      }
+    },
+  );
+
+  it("keeps private completion delivery private", () => {
+    const message = buildRequesterSettleWakeMessage({
+      requireVisibleReply: false,
+      parentOnly: true,
+      children: [],
+      preserveModelRouteNotice: false,
+    });
+
+    expect(message).toContain("Your final reply stays internal");
+    expect(message).not.toContain("Useful intermediate progress updates remain appropriate");
+  });
+});

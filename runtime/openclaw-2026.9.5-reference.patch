@@ -0,0 +1,140 @@
+import fs from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { loadAuthProfileStoreForSecretsRuntime } from "openclaw/plugin-sdk/agent-runtime";
+import { upsertAuthProfile } from "openclaw/plugin-sdk/provider-auth";
+import { expect, it, vi } from "vitest";
+import { applyCodexAppServerAuthProfile, refreshCodexAppServerAuthTokens } from "./auth-bridge.js";
+
+type AuthProfileStore = ReturnType<typeof loadAuthProfileStoreForSecretsRuntime>;
+
+export function registerAuthBridgeAccountRotationTests(oauthMocks: {
+  refreshOpenAICodexToken: ReturnType<typeof vi.fn>;
+}) {
+  it("does not switch a scoped workspace during startup refresh", async () => {
+    const agentDir = await fs.mkdtemp(path.join(os.tmpdir(), "openclaw-codex-app-server-"));
+    const request = vi.fn(async () => ({ type: "chatgptAuthTokens" }));
+    const credential = {
+      type: "oauth" as const,
+      provider: "openai",
+      access: "expired-access",
+      refresh: "expired-refresh",
+      expires: Date.now() - 60_000,
+      accountId: "account-a",
+    };
+    const authProfileStore: AuthProfileStore = {
+      version: 1,
+      profiles: { "openai:work": credential },
+    };
+    oauthMocks.refreshOpenAICodexToken.mockResolvedValueOnce({
+      access: "other-access",
+      refresh: "other-refresh",
+      expires: Date.now() + 24 * 60 * 60_000,
+      accountId: "account-b",
+    });
+    try {
+      await expect(
+        applyCodexAppServerAuthProfile({
+          client: { request } as never,
+          agentDir,
+          authProfileId: "openai:work",
+          authProfileStore,
+        }),
+      ).rejects.toThrow("ChatGPT workspace changed during Codex token refresh");
+      expect(request).not.toHaveBeenCalled();
+      expect(authProfileStore.profiles["openai:work"]).toEqual(credential);
+    } finally {
+      await fs.rm(agentDir, { recursive: true, force: true });
+    }
+  });
+
+  it("returns to the rotated account after switching among nine persisted profiles", async () => {
+    const agentDir = await fs.mkdtemp(path.join(os.tmpdir(), "openclaw-codex-nine-profiles-"));
+    const request = vi.fn(async () => ({ type: "chatgptAuthTokens" }));
+    const expires = Date.now() + 3_600_000;
+    try {
+      for (const label of "abcdefghi") {
+        upsertAuthProfile({
+          agentDir,
+          profileId: `openai:${label}`,
+          credential: {
+            type: "oauth",
+            provider: "openai",
+            access: `${label}-access`,
+            refresh: `${label}-refresh`,
+            expires,
+            accountId: `${label}-account`,
+          },
+        });
+      }
+      const authProfileStore = loadAuthProfileStoreForSecretsRuntime(agentDir);
+      const originalProfiles = structuredClone(authProfileStore.profiles);
+      const apply = (label: string) =>
+        applyCodexAppServerAuthProfile({
+          client: { request } as never,
+          agentDir,
+          authProfileId: `openai:${label}`,
+          authProfileStore,
+        });
+
+      await apply("a");
+      oauthMocks.refreshOpenAICodexToken.mockResolvedValueOnce({
+        access: "a-rotated-access",
+        refresh: "a-rotated-refresh",
+        expires,
+        accountId: "a-account",
+      });
+      // Another native caller rotates A while this caller retains its prepared store.
+      await refreshCodexAppServerAuthTokens({ agentDir, authProfileId: "openai:a" });
+      expect(authProfileStore.profiles["openai:a"]).toEqual(originalProfiles["openai:a"]);
+      await apply("b");
+      await apply("a");
+
+      expect(request.mock.calls).toEqual([
+        [
+          "account/login/start",
+          {
+            type: "chatgptAuthTokens",
+            accessToken: "a-access",
+            chatgptAccountId: "a-account",
+            chatgptPlanType: null,
+          },
+          { assertCurrent: undefined },
+        ],
+        [
+          "account/login/start",
+          {
+            type: "chatgptAuthTokens",
+            accessToken: "b-access",
+            chatgptAccountId: "b-account",
+            chatgptPlanType: null,
+          },
+          { assertCurrent: undefined },
+        ],
+        [
+          "account/login/start",
+          {
+            type: "chatgptAuthTokens",
+            accessToken: "a-rotated-access",
+            chatgptAccountId: "a-account",
+            chatgptPlanType: null,
+          },
+          { assertCurrent: undefined },
+        ],
+      ]);
+      expect(oauthMocks.refreshOpenAICodexToken.mock.calls).toEqual([["a-refresh"]]);
+      const persisted = loadAuthProfileStoreForSecretsRuntime(agentDir);
+      expect(Object.keys(persisted.profiles)).toHaveLength(9);
+      expect(persisted.profiles["openai:a"]).toMatchObject({
+        access: "a-rotated-access",
+        refresh: "a-rotated-refresh",
+        accountId: "a-account",
+      });
+      for (const label of "bcdefghi") {
+        expect(persisted.profiles[`openai:${label}`]).toEqual(originalProfiles[`openai:${label}`]);
+      }
+    } finally {
+      await fs.rm(agentDir, { recursive: true, force: true });
+    }
+  });
+}

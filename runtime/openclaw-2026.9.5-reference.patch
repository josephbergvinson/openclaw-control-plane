@@ -0,0 +1,111 @@
+import type { Frame, Page } from "playwright-core";
+import { describe, expect, it, vi } from "vitest";
+import {
+  ensurePageState,
+  restoreRoleRefsForTarget,
+  storeRoleRefsForTarget,
+} from "./pw-session-state.js";
+
+function observedPage() {
+  const handlers = new Map<string, (...args: unknown[]) => void>();
+  const mainFrame = {} as Frame;
+  const page = {
+    on: vi.fn((event: string, handler: (...args: unknown[]) => void) => {
+      handlers.set(event, handler);
+    }),
+    mainFrame: () => mainFrame,
+  } as unknown as Page;
+  return { page, handlers, mainFrame };
+}
+
+describe("selector role ref cache lifecycle", () => {
+  it.each(["role", "aria"] as const)(
+    "restores captured selector scope and clears it when a full %s snapshot replaces refs",
+    (mode) => {
+      const cdpUrl = "http://127.0.0.1:9222";
+      const targetId = `selector-reset-${mode}`;
+      const { page } = observedPage();
+      storeRoleRefsForTarget({
+        page,
+        cdpUrl,
+        targetId,
+        selector: "#inside",
+        refs: { e1: { role: "button", name: "Shared" } },
+        mode: "role",
+      });
+      const { page: replacement } = observedPage();
+      restoreRoleRefsForTarget({ page: replacement, cdpUrl, targetId });
+      expect(ensurePageState(replacement).roleRefsSelector).toBe("#inside");
+
+      storeRoleRefsForTarget({
+        page: replacement,
+        cdpUrl,
+        targetId,
+        refs: { e1: { role: "button", name: "Outside" } },
+        mode,
+      });
+      expect(ensurePageState(replacement).roleRefsSelector).toBeUndefined();
+      const { page: next } = observedPage();
+      restoreRoleRefsForTarget({ page: next, cdpUrl, targetId });
+      expect(ensurePageState(next).roleRefs).toEqual({ e1: { role: "button", name: "Outside" } });
+      expect(ensurePageState(next).roleRefsSelector).toBeUndefined();
+    },
+  );
+
+  it("invalidates selector scope on main-frame navigation without retiring a newer generation", () => {
+    const cdpUrl = "http://127.0.0.1:9222";
+    const targetId = "selector-navigation";
+    const { page, handlers, mainFrame } = observedPage();
+    const refs = { e1: { role: "button", name: "Shared" } };
+    storeRoleRefsForTarget({ page, cdpUrl, targetId, refs, selector: "#old", mode: "role" });
+    handlers.get("framenavigated")?.(mainFrame);
+    expect(ensurePageState(page).roleRefs).toBeUndefined();
+    expect(ensurePageState(page).roleRefsSelector).toBeUndefined();
+    const { page: current } = observedPage();
+    restoreRoleRefsForTarget({ page: current, cdpUrl, targetId });
+    expect(ensurePageState(current).roleRefs).toBeUndefined();
+
+    storeRoleRefsForTarget({
+      page: current,
+      cdpUrl,
+      targetId,
+      refs,
+      selector: "#new",
+      mode: "role",
+    });
+    handlers.get("framenavigated")?.(mainFrame);
+    const { page: next } = observedPage();
+    restoreRoleRefsForTarget({ page: next, cdpUrl, targetId });
+    expect(ensurePageState(next).roleRefsSelector).toBe("#new");
+  });
+
+  it.each(["framenavigated", "framedetached"] as const)(
+    "keeps selector scope on its captured Frame and clears it when that Frame emits %s",
+    (event) => {
+      const cdpUrl = "http://127.0.0.1:9222";
+      const targetId = `selector-frame-${event}`;
+      const { page, handlers } = observedPage();
+      const frame = {} as Frame;
+      storeRoleRefsForTarget({
+        page,
+        cdpUrl,
+        targetId,
+        refs: { e1: { role: "button", name: "Shared" } },
+        selector: "#inside",
+        frameSelector: "iframe#embedded",
+        frame,
+        mode: "role",
+      });
+      const { page: replacement } = observedPage();
+      restoreRoleRefsForTarget({ page: replacement, cdpUrl, targetId });
+      expect(ensurePageState(replacement).roleRefs).toBeUndefined();
+      handlers.get(event)?.({});
+      expect(ensurePageState(page).roleRefsSelector).toBe("#inside");
+      expect(ensurePageState(page).roleRefsFrame).toBe(frame);
+      handlers.get(event)?.(frame);
+      expect(ensurePageState(page).roleRefs).toBeUndefined();
+      expect(ensurePageState(page).roleRefsSelector).toBeUndefined();
+      expect(ensurePageState(page).roleRefsFrame).toBeUndefined();
+    },
+  );
+});

@@ -0,0 +1,383 @@
+import { createHash } from "node:crypto";
+import { isDeepStrictEqual } from "node:util";
+import { resolveSessionStorePathCore } from "../../../config/sessions/paths.js";
+import type { RequesterSettleFinalClaim } from "../../../config/sessions/requester-settle-final.js";
+import { loadExactSessionEntry } from "../../../config/sessions/session-accessor.js";
+import type { InternalSessionEntry as SessionEntry } from "../../../config/sessions/types.js";
+import {
+  getAgentRunContext,
+  getAgentRunLifecycleGeneration,
+  hasAgentRunContextExecutionOwner,
+} from "../../../infra/agent-run-registry.js";
+import { readTaskBackingInstance } from "../../../tasks/task-backing-records.js";
+import { setTaskRunDeliveryStatusesById } from "../../../tasks/task-registry-record-api.js";
+import { withTaskRegistryMutation } from "../../../tasks/task-registry-state.js";
+import { isTerminalTaskStatus, type TaskRecord } from "../../../tasks/task-registry.types.js";
+import { resolveSubagentRequesterAgentId } from "../../subagent-requester-owner.js";
+import type {
+  SubagentLifecycleOptions,
+  SubagentLifecycleWakeContext,
+} from "./subagent-registry-lifecycle-context.js";
+import { completeRequesterSettleWakeBatch } from "./subagent-registry-lifecycle-wake.js";
+import type { SubagentRunRecord } from "./subagent-registry.types.js";
+
+type Requester = Pick<
+  RequesterSettleFinalClaim,
+  "sourceRunId" | "requesterSessionKey" | "requesterAgentId" | "sessionId"
+>;
+function readRequester(
+  options: SubagentLifecycleOptions,
+  requester: Requester,
+  storePath?: string,
+) {
+  return loadExactSessionEntry({
+    agentId: requester.requesterAgentId,
+    sessionKey: requester.requesterSessionKey,
+    storePath:
+      storePath ??
+      resolveSessionStorePathCore(options.getRuntimeConfig().session?.store, {
+        agentId: requester.requesterAgentId,
+      }),
+    readConsistency: "latest",
+  })?.entry;
+}
+
+function resultHash(task: TaskRecord, entry: SubagentRunRecord): string {
+  // Bind what wait returned plus the native frozen result; delivery bookkeeping is not result identity.
+  return createHash("sha256")
+    .update(
+      JSON.stringify([
+        task.status,
+        task.progressSummary,
+        task.terminalSummary,
+        task.terminalOutcome,
+        task.error,
+        entry.completion?.resultText,
+        entry.completion?.capturedAt,
+      ]),
+    )
+    .digest("hex");
+}
+
+function childClaim(
+  options: SubagentLifecycleOptions,
+  entry: SubagentRunRecord,
+): RequesterSettleFinalClaim["children"][number] | undefined {
+  const resolution = options.resolveSubagentTask(entry);
+  const task = resolution.task;
+  const backing = readTaskBackingInstance(task?.detail);
+  if (
+    resolution.lookup !== "available" ||
+    !task ||
+    task.runtime !== "subagent" ||
+    !isTerminalTaskStatus(task.status) ||
+    task.terminalOutcome === "blocked" ||
+    entry.execution.status !== "terminal" ||
+    entry.pauseReason ||
+    entry.execution.endedAt === undefined ||
+    backing?.runtime !== "subagent" ||
+    entry.generation === undefined ||
+    task.runId !== (entry.taskRunId ?? entry.runId) ||
+    task.childSessionKey !== entry.childSessionKey
+  ) {
+    return undefined;
+  }
+  return {
+    runId: entry.runId,
+    taskId: task.taskId,
+    taskRunId: task.runId,
+    childSessionKey: entry.childSessionKey,
+    generation: entry.generation,
+    taskGeneration: backing.generation,
+    ...(entry.delivery?.generation !== undefined
+      ? { deliveryGeneration: entry.delivery.generation }
+      : {}),
+    createdAt: entry.createdAt,
+    endedAt: entry.execution.endedAt,
+    resultHash: resultHash(task, entry),
+  };
+}
+
+/** Pure validation shared by final preparation and receipt reconciliation; all members are required. */
+function matchingBatch(
+  context: SubagentLifecycleWakeContext,
+  claim: RequesterSettleFinalClaim,
+  allowSettled = false,
+): SubagentRunRecord[] | undefined {
+  // Native yield retires the spawning turn; the frozen batch and rearm generation own completion.
+  const cfg = context.options.getRuntimeConfig();
+  const ids = claim.children.map((child) => child.runId).toSorted();
+  const entries: SubagentRunRecord[] = [];
+  for (const child of claim.children) {
+    const entry = context.options.runs.get(child.runId);
+    if (
+      !entry ||
+      entry.requesterSessionKey !== claim.requesterSessionKey ||
+      resolveSubagentRequesterAgentId(cfg, entry) !== claim.requesterAgentId ||
+      entry.expectsCompletionMessage !== true ||
+      !["pending", "in_progress", "delivered"].includes(entry.delivery?.status ?? "") ||
+      entry.suppressCompletionDelivery ||
+      entry.killIntent ||
+      entry.killReconciliation ||
+      context.newerGenerationOwnsSession(entry) ||
+      (entry.completionRequesterSessionId !== undefined &&
+        entry.completionRequesterSessionId !== claim.sessionId) ||
+      !isDeepStrictEqual(childClaim(context.options, entry), child)
+    ) {
+      return undefined;
+    }
+    const wake = entry.requesterSettleWake;
+    const settled =
+      allowSettled &&
+      !wake &&
+      entry.delivery?.status === "delivered" &&
+      entry.delivery.requesterVisibleFinal?.requesterTurnRunId === claim.sourceRunId &&
+      entry.delivery.requesterVisibleFinal.rearmGeneration === claim.rearmGeneration &&
+      isDeepStrictEqual(entry.delivery.requesterVisibleFinal.batchRunIds, ids);
+    if (
+      !settled &&
+      (!wake ||
+        wake.requesterYieldBatch !== true ||
+        wake.rearmGeneration !== claim.rearmGeneration ||
+        !isDeepStrictEqual(wake.batchRunIds, ids))
+    ) {
+      return undefined;
+    }
+    entries.push(entry);
+  }
+  return entries.length ? entries : undefined;
+}
+
+/** A completed read is an observation, never a receipt or a request to synthesize another reply. */
+export function recordRequesterCompletedWaitWithContext(
+  context: SubagentLifecycleWakeContext,
+  requester: Requester,
+  observedTasks: readonly TaskRecord[],
+): void {
+  const run = getAgentRunContext(requester.sourceRunId);
+  if (
+    !run ||
+    !hasAgentRunContextExecutionOwner(requester.sourceRunId) ||
+    run.sessionKey !== requester.requesterSessionKey ||
+    run.agentId !== requester.requesterAgentId ||
+    run.sessionId !== requester.sessionId ||
+    run.lifecycleGeneration !== getAgentRunLifecycleGeneration()
+  ) {
+    return;
+  }
+  run.assertSourceCurrent?.();
+  if (
+    getAgentRunContext(requester.sourceRunId) !== run ||
+    !hasAgentRunContextExecutionOwner(requester.sourceRunId) ||
+    run.lifecycleGeneration !== getAgentRunLifecycleGeneration()
+  ) {
+    return;
+  }
+  const session = readRequester(context.options, requester);
+  if (!session || session.sessionId !== requester.sessionId) {
+    return;
+  }
+  // A final receipt can commit before its registry settlement. Reconcile that
+  // acknowledgment before a later wait replaces its only retained observation.
+  const reconciledSources = new Set<string>();
+  for (const entry of context.options.runs.values()) {
+    const previous = entry.requesterFinalObservation;
+    if (
+      !previous ||
+      previous.requesterSessionKey !== requester.requesterSessionKey ||
+      previous.requesterAgentId !== requester.requesterAgentId ||
+      previous.sessionId !== requester.sessionId ||
+      reconciledSources.has(previous.sourceRunId)
+    ) {
+      continue;
+    }
+    reconciledSources.add(previous.sourceRunId);
+    reconcileRequesterSettleFinalWithContext(context, previous);
+  }
+  const seen = new Map(observedTasks.map((task) => [task.taskId, task]));
+  const cfg = context.options.getRuntimeConfig();
+  const updated = new Map<SubagentRunRecord, SubagentRunRecord["requesterFinalObservation"]>();
+  for (const anchor of context.options.runs.values()) {
+    const wake = anchor.requesterSettleWake;
+    if (
+      anchor.requesterSessionKey !== requester.requesterSessionKey ||
+      resolveSubagentRequesterAgentId(cfg, anchor) !== requester.requesterAgentId ||
+      wake?.requesterYieldBatch !== true ||
+      wake.rearmGeneration === undefined ||
+      !wake.batchRunIds?.length ||
+      wake.batchRunIds.length > 32 ||
+      updated.has(anchor)
+    ) {
+      continue;
+    }
+    const children = wake.batchRunIds.map((id) => {
+      const entry = context.options.runs.get(id);
+      return entry ? childClaim(context.options, entry) : undefined;
+    });
+    if (children.some((child) => !child || !seen.has(child.taskId))) {
+      continue;
+    }
+    const claim: RequesterSettleFinalClaim = {
+      ...requester,
+      lifecycleRevision: session.lifecycleRevision,
+      rearmGeneration: wake.rearmGeneration,
+      children: children.filter((child): child is NonNullable<typeof child> => Boolean(child)),
+    };
+    const entries = matchingBatch(context, claim);
+    if (
+      !entries ||
+      entries.some((entry) => {
+        const child = claim.children.find((item) => item.runId === entry.runId)!;
+        const observed = seen.get(child.taskId)!;
+        return (
+          observed.runId !== child.taskRunId || resultHash(observed, entry) !== child.resultHash
+        );
+      })
+    ) {
+      continue;
+    }
+    for (const entry of entries) {
+      updated.set(entry, entry.requesterFinalObservation);
+      entry.requesterFinalObservation = claim;
+    }
+  }
+  if (!updated.size) {
+    return;
+  }
+  try {
+    context.options.persistOrThrow(...[...updated.keys()].map((entry) => entry.runId));
+  } catch (error) {
+    for (const [entry, previous] of updated) {
+      entry.requesterFinalObservation = previous;
+    }
+    throw error;
+  }
+}
+
+export function prepareRequesterSettleFinalClaimsWithContext(
+  context: SubagentLifecycleWakeContext,
+  requester: Requester,
+  session: SessionEntry,
+): RequesterSettleFinalClaim[] | undefined {
+  if (
+    session.sessionId !== requester.sessionId ||
+    (session.activeWriterRunId !== undefined && session.activeWriterRunId !== requester.sourceRunId)
+  ) {
+    return undefined;
+  }
+  const claims: RequesterSettleFinalClaim[] = [];
+  const seen = new Set<string>();
+  for (const entry of context.options.runs.values()) {
+    const claim = entry.requesterFinalObservation;
+    if (
+      !claim ||
+      seen.has(claim.children[0]?.runId ?? "") ||
+      claim.sourceRunId !== requester.sourceRunId ||
+      claim.requesterSessionKey !== requester.requesterSessionKey ||
+      claim.requesterAgentId !== requester.requesterAgentId ||
+      claim.sessionId !== requester.sessionId ||
+      claim.lifecycleRevision !== session.lifecycleRevision ||
+      !matchingBatch(context, claim)
+    ) {
+      continue;
+    }
+    seen.add(claim.children[0]!.runId);
+    claims.push(structuredClone(claim));
+  }
+  return claims.length ? claims : undefined;
+}
+
+/** Reuse the native batch owner only after the pending-final transaction recorded all-parts delivery. */
+export function reconcileRequesterSettleFinalWithContext(
+  context: SubagentLifecycleWakeContext,
+  requester: Requester,
+  storePath?: string,
+): boolean {
+  const session = readRequester(context.options, requester, storePath);
+  if (!session || session.sessionId !== requester.sessionId) {
+    return false;
+  }
+  const evidence = session.restartRecoveryTerminalDeliveryEvidence?.find(
+    (item) => item.runId === requester.sourceRunId,
+  );
+  if (
+    !evidence?.durableFinalReceipt ||
+    !evidence.deliveryContext?.channel ||
+    !evidence.deliveryContext.to
+  ) {
+    return false;
+  }
+  let settled = false;
+  for (const claim of evidence.requesterSettleClaims ?? []) {
+    if (
+      claim.sourceRunId !== requester.sourceRunId ||
+      claim.sessionId !== session.sessionId ||
+      claim.lifecycleRevision !== session.lifecycleRevision ||
+      claim.requesterAgentId !== requester.requesterAgentId ||
+      claim.requesterSessionKey !== requester.requesterSessionKey
+    ) {
+      continue;
+    }
+    const didSettle = withTaskRegistryMutation(() => {
+      const entries = matchingBatch(context, claim, true);
+      if (!entries) {
+        return false;
+      }
+      const pending = entries.filter((entry) => entry.requesterSettleWake);
+      if (pending.length > 0 && pending.length < entries.length) {
+        return false;
+      }
+      // The receipt is already durable. Commit all exact task projections before
+      // the native wake owner can retire their registry rows during delete cleanup.
+      const updates = entries.flatMap((entry) => {
+        const task = context.options.resolveSubagentTask(entry).task;
+        if (!task) {
+          throw new Error("Requester final task owner changed before settlement");
+        }
+        return task.deliveryStatus === "delivered"
+          ? []
+          : [{ expected: task, deliveryStatus: "delivered" as const }];
+      });
+      if (
+        updates.length &&
+        !setTaskRunDeliveryStatusesById({ updates, onCommitted: () => undefined })
+      ) {
+        throw new Error("Requester final task delivery was not persisted");
+      }
+      // Task publication may invoke observers; a replacement must retain its wake.
+      const current = matchingBatch(context, claim, true);
+      if (!current || current.some((entry, index) => entry !== entries[index])) {
+        return false;
+      }
+      if (pending.length === entries.length) {
+        // The visible-final marker and wake retirement share the registry's existing commit.
+        const previous = entries.map((entry) => entry.delivery);
+        for (const entry of entries) {
+          entry.delivery = {
+            ...entry.delivery!,
+            requesterVisibleFinal: {
+              requesterTurnRunId: claim.sourceRunId,
+              batchRunIds: claim.children.map((child) => child.runId).toSorted(),
+              rearmGeneration: claim.rearmGeneration,
+            },
+          };
+        }
+        try {
+          completeRequesterSettleWakeBatch(context, entries, claim.rearmGeneration, {
+            delivered: true,
+            path: "direct",
+            requesterVisibleFinalDelivered: true,
+          });
+        } catch (error) {
+          entries.forEach((entry, index) => {
+            entry.delivery = previous[index];
+          });
+          throw error;
+        }
+      }
+      return true;
+    });
+    settled ||= didSettle;
+  }

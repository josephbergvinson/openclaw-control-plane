@@ -0,0 +1,30 @@
+import type { AgentMessage } from "./runtime/index.js";
+import {
+  estimateCompactedRequestTokens,
+  type CompactionRequestBudget,
+} from "./sessions/compaction/request-budget.js";
+
+/** An unsent extraction can be split; a started extraction must never replay its writes. */
+export class MemoryExtractionBudgetError extends Error {
+  constructor(readonly maxHistoryTokens: number) {
+    super("Memory extraction does not fit the prepared request allowance.");
+    this.name = "MemoryExtractionBudgetError";
+  }
+}
+
+export function assertMemoryExtractionRequestFits(
+  messages: AgentMessage[],
+  budget: CompactionRequestBudget,
+): void {
+  if (
+    estimateCompactedRequestTokens(messages, budget) >
+    budget.contextWindow - budget.reserveTokens
+  ) {
+    throw new MemoryExtractionBudgetError(
+      Math.max(
+        0,
+        budget.contextWindow - budget.reserveTokens - budget.fixedTokens - budget.pendingTokens,
+      ),
+    );
+  }
+}

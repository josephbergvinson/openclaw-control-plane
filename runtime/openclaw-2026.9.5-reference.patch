diff --git a/src/config/sessions/goals-usage.ts b/src/config/sessions/goals-usage.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5a2b0d34082856ea1a3e6dc39aaefe7093a44747
--- /dev/null
+++ b/src/config/sessions/goals-usage.ts
@@ -0,0 +1,106 @@
+import { accountSessionGoalUsage } from "./goals-transitions.js";
+import { patchSessionEntryCore } from "./session-accessor.entry.js";
+import type { SessionAccessScope } from "./session-accessor.types.js";
+import type { InternalSessionEntry, SessionGoal } from "./types.js";
+
+/** One cursor over the owning run's existing cumulative usage, not another usage ledger. */
+export type SessionGoalUsageCursor = {
+  version: 1;
+  goalId: string;
+  /** Preserved historical estimate; never reinterpreted as measured provider usage. */
+  legacyTokensUsed: number;
+  run?: { admissionId: string; instanceId: string; tokens: number };
+};
+
+export type SessionGoalUsageObservation = {
+  goalId: string;
+  admissionId: string;
+  instanceId: string;
+  tokens: number;
+  /** Unavailable baselines retain identity and writer fencing without charging usage. */
+  baselineTokens: number | undefined;
+  target: Required<Pick<SessionAccessScope, "agentId" | "sessionKey" | "storePath">> &
+    Pick<InternalSessionEntry, "sessionId" | "lifecycleRevision"> & {
+      activeWriterRunId: string;
+    };
+  assertCurrent: () => void;
+};
+
+export function createSessionGoalUsageCursor(goal: SessionGoal): SessionGoalUsageCursor {
+  return { version: 1, goalId: goal.id, legacyTokensUsed: 0 };
+}
+
+export function assertSessionGoalUsageOwner(
+  entry: InternalSessionEntry,
+  observation: SessionGoalUsageObservation,
+): void {
+  observation.assertCurrent();
+  const target = observation.target;
+  if (
+    entry.sessionId !== target.sessionId ||
+    entry.lifecycleRevision !== target.lifecycleRevision ||
+    entry.activeWriterRunId !== target.activeWriterRunId
+  ) {
+    throw new Error("goal usage session ownership changed");
+  }
+}
+
+export function projectSessionGoalUsage(
+  entry: InternalSessionEntry,
+  observation: SessionGoalUsageObservation | undefined,
+  now: number,
+): Pick<InternalSessionEntry, "goal" | "goalUsage"> | undefined {
+  if (!observation || entry.goal?.id !== observation.goalId) {
+    return undefined;
+  }
+  assertSessionGoalUsageOwner(entry, observation);
+  const { tokens, baselineTokens } = observation;
+  if (baselineTokens === undefined) {
+    return undefined;
+  }
+  if (
+    !Number.isSafeInteger(tokens) ||
+    tokens < 0 ||
+    !Number.isSafeInteger(baselineTokens) ||
+    baselineTokens < 0
+  ) {
+    throw new Error("invalid accepted goal usage snapshot");
+  }
+  const cursor =
+    entry.goalUsage?.version === 1 && entry.goalUsage.goalId === entry.goal.id
+      ? entry.goalUsage
+      : { version: 1 as const, goalId: entry.goal.id, legacyTokensUsed: entry.goal.tokensUsed };
+  const previous =
+    cursor.run?.instanceId === observation.instanceId ? cursor.run.tokens : baselineTokens;
+  const accountedTokens = Math.max(previous, tokens);
+  const goal = accountSessionGoalUsage(
+    {
+      goal: { ...entry.goal, tokensUsed: entry.goal.tokensUsed + accountedTokens - previous },
+    },
+    now,
+  );
+  return {
+    goal,
+    goalUsage: {
+      ...cursor,
+      run: {
+        admissionId: observation.admissionId,
+        instanceId: observation.instanceId,
+        tokens: accountedTokens,
+      },
+    },
+  };
+}
+
+export async function persistSessionGoalUsage(
+  observation: SessionGoalUsageObservation,
+): Promise<void> {
+  await patchSessionEntryCore(
+    observation.target,
+    (entry) => projectSessionGoalUsage(entry, observation, Date.now()) ?? null,
+    {
+      skipMaintenance: true,
+      assertCommitAllowed: observation.assertCurrent,
+    },
+  );
+}

+      next.peekCatalog = () => catalog;
+      next.getCatalog = async (options) => {
+        requests.push(options);
+        expect(getSessionMcpRequestSignal()).toBe(signal.signal);
+        discovery.resolve();
+        await releaseDiscovery.promise;
+        if (boundary === "failed discovery") {
+          throw new Error("target discovery failed");
+        }
+        return catalog;
+      };
+      return next;

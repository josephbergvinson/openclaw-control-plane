+      }
+      cleanup.resolve();
+      const result = await wake;
+      expect(phases).toEqual(
+        outcome === "current"
+          ? ["cleanup started", "writes released", "dispatch"]
+          : ["cleanup started", "writes released"],
+      );
+      if (kind === "descendant") {
+        expect(result).toBe(outcome === "current");
+      } else {
+        expect(result).toMatchObject({ delivered: outcome === "current" });
+      }
+    } finally {
+      cancelMaintenance.abort();
+      cleanup.resolve();
+      await maintenance;
+      await wake;
+      await waitForSessionMaintenance(sessionKey);
+      const next = createSessionMaintenanceOwner({ sessionKey, preemptible: true });
+      await next.track(next.run(async () => phases.push("next maintenance")));
+      expect(phases.at(-1)).toBe("next maintenance");
+    }
+  },
+);
+
+it("lets a private checkpoint's nested completion retain its maintenance ancestry", async () => {
+  const sessionKey = "agent:main:subagent:private-checkpoint";
+  const dispatch: typeof dispatchGatewayMethodInProcess = async <T>() =>
+    ({ status: "ok", result: { payloads: [{ text: "done" }] } }) as T;
+  setSubagentAnnounceDeliveryDepsForTest({
+    getRuntimeConfig: () => ({}),
+    loadRequesterSessionEntry: () => ({
+      cfg: {},
+      canonicalKey: sessionKey,
+      agentId: "main",
+      entry: { sessionId: "private-session", updatedAt: 1 },
+    }),
+    getRequesterSessionActivity: () => ({ sessionId: "private-session", isActive: false }),
+    dispatchGatewayMethodInProcess: dispatch,
+  });
+  const owner = createSessionMaintenanceOwner({ sessionKey, preemptible: true });
+  const result = await owner.track(
+    owner.run(async () => {
+      const delivered = await sendSubagentAnnounceDirectly({
+        requesterSessionKey: sessionKey,
+        requesterAgentId: "main",
+        targetRequesterSessionKey: sessionKey,
+        requesterIsSubagent: true,
+        expectsCompletionMessage: false,
+        triggerMessage: "Resume the private checkpoint",
+        sourceTool: "subagent_settle",
+        sourceSessionKey: "agent:main:subagent:checkpoint-child",
+        directIdempotencyKey: "private-checkpoint-wake",
+        isSourceSessionEffectsAllowed: () => !owner.signal.aborted,
+      });
+      owner.assertCurrent();
+      return delivered;
+    }),
+  );
+  expect(result).toMatchObject({ delivered: true });
+  expect(owner.signal.aborted).toBe(false);
+});

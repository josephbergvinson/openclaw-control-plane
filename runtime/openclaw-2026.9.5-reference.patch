+describe("private child cancellation delivery", () => {
+  it.each([
+    { requesterSessionKey: "agent:main:subagent:parent" },
+    { requesterSessionKey: "agent:main:discord:direct:owner" },
+    { runId: "recovered-execution", taskRunId: "original-task-run", generation: 2 },

+  claimPendingAgentQuestionAnswerFromCaller,
+  registerPendingAgentQuestion,
+} from "./gateway-question.js";
+import { withPreparedEmbeddedRunToolAuthority } from "./tool-authority.runtime.js";
+
+afterEach(() => {
+  testing.resetActiveEmbeddedRuns();
+  vi.restoreAllMocks();
+});
+
+it("keeps generic steering role narrowing out of the shared question caller policy", async () => {
+  const sessionKey = "agent:main:question-ceiling";
+  const runId = "question-ceiling-run";
+  const admission = prepareAgentRunAdmission({
+    cfg: {},
+    operationalRunInstance: createOperationalRunInstanceRef(runId),
+    facts: {
+      agentId: "main",
+      runId,
+      ingress: { kind: "system", state: "present", boundary: "question-ceiling-test" },
+    },
+  });
+  const narrow = vi.fn((input: ReplyToolAuthorityInput): ReplyToolAuthorityInput => ({
+    ...input,
+    disableTools: input.run.senderIsOwner !== true,
+  }));
+  const dispatch = vi.fn<AgentQuestionDispatcher["call"]>(async ({ authority }) => {
+    if (authority.kind === "source-bound") {
+      authority.assertCurrent();
+    }
+    return { status: "answered" };
+  });
+  try {
+    await withPreparedEmbeddedRunToolAuthority(
+      { admittedRunContext: await admission.admit("embedded", "question-ceiling-test") },
+      {
+        runId,
+        agentId: "main",
+        sessionId: "question-session",
+        sessionKey,
+        sessionFile: "/tmp/question-ceiling-session.jsonl",
+        workspaceDir: "/tmp/question-ceiling-workspace",
+        config: {},
+        provider: "openai",
+        modelId: "test-model",
+        sandboxSessionKey: sessionKey,
+        senderIsOwner: true,
+        senderId: "joseph",
+        messageProvider: "discord",
+      },
+      narrow,
+      async () => {
+        const question = registerPendingAgentQuestion({
+          questionId: "question-ceiling",
+          sessionKey,
+          questions: [{ id: "choice", header: "Choice", question: "Continue?" }],
+          gatewayCall: { version: 2, call: dispatch },
+          answer: Promise.resolve({ status: "pending" }),
+        });
+        question.attachRegistration(Promise.resolve({ id: "question-ceiling" }));
+        const caller: ReplyToolAuthorityOverlay = {
+          senderIsOwner: false,
+          senderId: "joseph",
+          traceAuthorized: false,
+          messageProvider: "discord",
+          disableTools: false,
+        };
+        try {
+          await expect(
+            claimPendingAgentQuestionAnswerFromCaller({
+              sessionKey,
+              text: "Continue",
+              caller,
+              assertSourceCurrent: () => {},
+            }),
+          ).rejects.toThrow("caller policy");
+          expect(dispatch).not.toHaveBeenCalled();
+          expect(narrow.mock.calls.some(([input]) => input.run.senderIsOwner === false)).toBe(true);
+          await expect(
+            claimPendingAgentQuestionAnswerFromCaller({
+              sessionKey,
+              text: "Continue",
+              caller: { ...caller, senderIsOwner: true },
+              assertSourceCurrent: () => {},
+            }),
+          ).resolves.toBe(true);
+          expect(dispatch).toHaveBeenCalledOnce();
+        } finally {
+          question.dispose();
+        }
+      },
+    );
+  } finally {
+    admission.close();
+  }
+});

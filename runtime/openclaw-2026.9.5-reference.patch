+import Darwin
+import Foundation
+import OpenClawKit
+import Testing
+@testable import OpenClaw
+@testable import OpenClawMacCLI
+
+/// No live AX, Keychain, AppDefaults, app launch, or Gateway calls.
+@MainActor
+struct NativeCredentialEntryTests {
+    @Test func `focused overlay is inspected only after no qualifying frontmost prompt or native read failure`() throws {
+        let prompt = NativeCredentialEntryService.Prompt(
+            bundleID: "com.apple.SecurityAgent", accountEvidence: [], validate: {}, setSecret: { _ in })
+        let eligible = NativeCredentialEntryService.Discovery(prompts: [prompt], diagnostics: .init(reason: .eligible))
+        let empty = NativeCredentialEntryService.Discovery(
+            prompts: [], diagnostics: .init(reason: .focusedWindowUnavailable))
+        var focusedReads = 0
+        let foreground = try NativeCredentialPromptFocus.discover(frontmost: { eligible }, focused: {
+            focusedReads += 1
+            throw NativeCredentialError.unavailable
+        })
+        #expect(foreground.prompts.count == 1)
+        #expect(focusedReads == 0)
+        let overlay = try NativeCredentialPromptFocus.discover(frontmost: { empty }, focused: {
+            focusedReads += 1
+            return eligible
+        })
+        #expect(overlay.prompts.count == 1)
+        #expect(focusedReads == 1)
+        let afterReadFailure = try NativeCredentialPromptFocus.discover(frontmost: {
+            throw NativeCredentialError.unavailable
+        }, focused: { eligible })
+        #expect(afterReadFailure.prompts.count == 1)
+        #expect(throws: NativeCredentialError.unavailable) {
+            try NativeCredentialPromptFocus.discover(frontmost: {
+                throw NativeCredentialError.unavailable
+            }, focused: { empty })
+        }
+        #expect(throws: NativeCredentialError.stalePrompt) {
+            try NativeCredentialPromptFocus.discover(frontmost: { empty }, focused: {
+                throw NativeCredentialError.stalePrompt
+            })
+        }
+    }
+
+    @Test func `focused OS secure field can own an overlay and must remain the same field and owner`() {
+        #expect(NativeCredentialPromptFocus.focusedSecureField.isCurrent(
+            ownerPID: 42, frontmostPID: 7, focusedPID: 42, sameFocusedField: true))
+        #expect(!NativeCredentialPromptFocus.frontmostApplication.isCurrent(
+            ownerPID: 42, frontmostPID: 7, focusedPID: 42, sameFocusedField: true))
+        #expect(!NativeCredentialPromptFocus.focusedSecureField.isCurrent(
+            ownerPID: 42, frontmostPID: 7, focusedPID: 42, sameFocusedField: true,
+            frontmostBundleID: "com.apple.loginwindow"))
+        for (focusedPID, sameField) in [(pid_t(7), true), (pid_t(42), false), (pid_t(0), true)] {
+            #expect(!NativeCredentialPromptFocus.focusedSecureField.isCurrent(
+                ownerPID: 42, frontmostPID: 42, focusedPID: focusedPID, sameFocusedField: sameField))
+        }
+        #expect(!NativeCredentialPromptFocus.focusedSecureField.isCurrent(
+            ownerPID: 42, frontmostPID: 42, focusedPID: nil, sameFocusedField: false))
+    }
+
+    @Test func `native process identity uses kernel incarnation without Launch Services metadata`() throws {
+        let identity = try NativeCredentialProcessIdentity.capture(42) { pid, info, size in
+            info.pbi_pid = UInt32(pid)
+            info.pbi_uid = 501
+            info.pbi_start_tvsec = 100
+            info.pbi_start_tvusec = 123
+            return size
+        }
+        #expect(identity.pid == 42)
+        #expect(identity.userID == 501)
+        #expect(identity.startedSeconds == 100)
+        #expect(identity.startedMicroseconds == 123)
+        for change in 0..<4 {
+            let replacement = try NativeCredentialProcessIdentity.capture(change == 0 ? 43 : 42) { pid, info, size in
+                info.pbi_pid = UInt32(pid)
+                info.pbi_uid = change == 1 ? 502 : 501
+                info.pbi_start_tvsec = change == 2 ? 101 : 100
+                info.pbi_start_tvusec = change == 3 ? 124 : 123
+                return size
+            }
+            #expect(replacement != identity)
+        }
+    }
+
+    @Test func `missing truncated or inconsistent kernel identity refuses native credential discovery`() {
+        for change in 0..<5 {
+            #expect(throws: NativeCredentialError.refused) {
+                try NativeCredentialProcessIdentity.capture(42) { pid, info, size in
+                    info.pbi_pid = change == 2 ? 43 : UInt32(pid)
+                    info.pbi_start_tvsec = change == 3 ? 0 : 100
+                    info.pbi_start_tvusec = change == 4 ? 1_000_000 : 123
+                    return change == 0 ? 0 : (change == 1 ? size - 1 : size)
+                }
+            }
+        }
+    }
+
+    @MainActor
+    private final class Harness {
+        let scope = UUID()
+        var now = Date(timeIntervalSince1970: 100)
+        var host = "11111111-1111-4111-8111-111111111111"
+        var allowed = true
+        var promptCurrent = true
+        var promptsPresent = true
+        var promptBundleID = "com.apple.systempreferences"
+        var accountEvidence = ["Sign in as operator@example.invalid"]
+        var selectedUsername: String?
+        var localAccount = NSUserName()
+        var discoveryDiagnostics = NativeCredentialDiscoveryDiagnostics(
+            reason: .bindingUnmatched, observedSecureFieldCount: 1)
+        var discoveryCalls = 0
+        var secretReads = 0
+        var entries: [String] = []
+        var duringResolution: (() async -> Void)?
+        var bindings: [NativeCredentialBinding]
+        lazy var service = self.makeService()
+
+        private func makeService() -> NativeCredentialEntryService {
+            NativeCredentialEntryService(environment: .init(
+                hostID: { self.host },
+                bindings: { self.bindings },
+                prompts: {
+                    self.discoveryCalls += 1
+                    let selectedUsername = self.selectedUsername
+                    return .init(prompts: self.promptsPresent ? [.init(
+                        bundleID: self.promptBundleID,
+                        accountEvidence: self.accountEvidence,
+                        selectedUsername: selectedUsername,
+                        validate: {
+                            if !self.promptCurrent || self.selectedUsername != selectedUsername {
+                                throw NativeCredentialError.stalePrompt
+                            }
+                        },
+                        setSecret: { self.entries.append($0) })] : [], diagnostics: self.discoveryDiagnostics)
+                },
+                withSecret: { _, consume in
+                    self.secretReads += 1
+                    await self.duringResolution?()
+                    try consume("fixture-password")
+                },
+                now: { self.now },
+                localAccount: { self.localAccount }))
+        }

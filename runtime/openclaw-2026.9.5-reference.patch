+import "../setup-openclaw-runtime.js";
+import { expectDefined } from "@openclaw/normalization-core";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { setActiveEmbeddedRun } from "../../src/agents/embedded-agent-runner/runs.js";
+import {
+  createEmbeddedRunHandle,
+  testing as embeddedTesting,
+} from "../../src/agents/embedded-agent-runner/runs.test-support.js";
+import { retryRetainedFollowupSteersAfterPublication } from "../../src/auto-reply/reply/agent-runner-steer-adoption.js";
+import {
+  clearSessionQueues,
+  enqueueFollowupRun,
+  scheduleFollowupDrain,
+  type FollowupRun,
+} from "../../src/auto-reply/reply/queue.js";
+import { createQueueTestRun } from "../../src/auto-reply/reply/queue.test-helpers.js";
+import { getExistingFollowupQueue } from "../../src/auto-reply/reply/queue/state.js";
+import { withQuestionCreator } from "../../src/auto-reply/reply/reply-run-question.test-support.js";
+import type { ReplyBackendHandle } from "../../src/auto-reply/reply/reply-run-registry.contracts.js";
+import { adoptedFollowupSourceByOperation } from "../../src/auto-reply/reply/reply-run-registry.state.js";
+import {
+  bindRetainedSource,
+  createRetainedCodexSteeringQueue,
+} from "./codex-retained-steering.test-support.js";
+
+describe("retained steer-mode FIFO at native publication", () => {
+  afterEach(() => {
+    embeddedTesting.resetActiveEmbeddedRuns();
+    vi.restoreAllMocks();
+  });
+
+  it.each([
+    { backendKind: "embedded", adoptedSource: true },
+    { backendKind: "codex", adoptedSource: true },
+    { backendKind: "embedded", adoptedSource: false },
+    { backendKind: "codex", adoptedSource: false },
+  ] as const)(
+    "adopts old A/B from $backendKind publication alone (adopted source: $adoptedSource)",
+    async ({ backendKind, adoptedSource }) => {
+      const key = `agent:main:retained-publication-${backendKind}-${adoptedSource}`;
+      const current = createQueueTestRun({ prompt: "existing work", messageId: "current" });
+      const followup = vi.fn(async (_run: FollowupRun) => undefined);
+      await withQuestionCreator(key, current, async (operation, fingerprint) => {
+        operation.setPhase("running");
+        if (adoptedSource) {
+          enqueueFollowupRun(
+            key,
+            current,
+            { mode: "steer", debounceMs: 0 },
+            "message-id",
+            followup,
+            false,
+          );
+          const queue = expectDefined(getExistingFollowupQueue(key), "active queue");
+          queue.draining = true;
+          queue.inFlight.add(current);
+          adoptedFollowupSourceByOperation.set(operation, current);
+        }
+        const adoptedA = vi.fn();
+        const adoptedB = vi.fn();
+        const deferredA = vi.fn();
+        const deferredB = vi.fn();
+        const a = {
+          ...current,
+          prompt: "old A",
+          messageId: "A",
+          currentInboundContext: { text: "A context" },
+          turnAdoptionLifecycle: { onDeferred: deferredA, onAdopted: adoptedA },
+        };
+        const b = {
+          ...current,
+          prompt: "old B",
+          messageId: "B",
+          currentInboundContext: { text: "B context" },
+          turnAdoptionLifecycle: { onDeferred: deferredB, onAdopted: adoptedB },
+        };
+        const startA = bindRetainedSource(key, a, operation, fingerprint, followup);
+        bindRetainedSource(key, b, operation, fingerprint, followup);
+        if (adoptedSource) {
+          // A falls back before publication, leaving a resolved false tail.
+          expect(await startA()).toBe("handled");
+        } else {
+          enqueueFollowupRun(
+            key,
+            a,
+            { mode: "steer", debounceMs: 0 },
+            "message-id",
+            followup,
+            false,
+          );
+          retryRetainedFollowupSteersAfterPublication(operation);
+        }
+        enqueueFollowupRun(key, b, { mode: "steer", debounceMs: 0 }, "message-id", followup, false);
+        const queue = expectDefined(getExistingFollowupQueue(key), "retained queue");
+        expect(queue.items).toEqual(adoptedSource ? [current, a, b] : [a, b]);
+        expect(deferredA).toHaveBeenCalledTimes(1);
+        expect(deferredB).toHaveBeenCalledTimes(1);
+        const received: Array<{ text: string; id?: string; context?: string }> = [];
+        let codexQueue: ReturnType<typeof createRetainedCodexSteeringQueue> | undefined;
+        const wire = vi.fn(async (method: string, args: Record<string, unknown>) => {
+          expect(method).toBe("turn/steer");
+          queueMicrotask(() =>
+            expectDefined(codexQueue, "Codex queue").confirmConsumed(
+              String(args.clientUserMessageId),
+            ),
+          );
+          return {};
+        });
+        if (backendKind === "codex") {
+          codexQueue = createRetainedCodexSteeringQueue({
+            client: { request: wire },
+            threadId: "native-thread",
+            turnId: "native-turn",
+            requestTimeoutMs: 1_000,
+            signal: operation.abortSignal,
+            assertActive: () => operation.abortSignal.throwIfAborted(),
+            prepareMessage: async (text) => {
+              return {
+                input: [{ type: "text", text, text_elements: [] }],
+                context: [],
+                message: { role: "user", content: [{ type: "text", text }], timestamp: 1 },
+              };
+            },
+          });
+        }
+        const queueMessage: NonNullable<
+          ReplyBackendHandle["messageInjectionV2"]
+        >["queueMessage"] = async (text, options, assertCurrent) => {
+          assertCurrent();
+          received.push({
+            text,
+            id: options?.queueIdentity,
+            context: options?.currentInboundContext?.text,
+          });
+          if (codexQueue) {
+            await codexQueue.queue(text, options, assertCurrent);
+          } else {
+            options?.onQueueAccepted?.(true);
+          }
+        };
+        const handle = {
+          ...createEmbeddedRunHandle({
+            runId: "accepted-backing-work",
+            toolAuthorityFingerprint: fingerprint,
+            supportsTranscriptCommitWait: true,
+          }),
+          kind: "embedded" as const,
+          cancel: vi.fn(),
+          supportsQueueMessageContext: true,
+          isSteeringCatalogCurrent: () => true,
+          messageInjectionV2: { version: 2 as const, isAvailable: () => true, queueMessage },
+        };
+        operation.attachBackend(handle);
+        setActiveEmbeddedRun(operation.sessionId, handle, key, current.run.sessionFile, "main");
+        await vi.waitFor(() => expect(adoptedB).toHaveBeenCalledTimes(1));
+        expect(received).toEqual([
+          { text: "old A", id: "A", context: "A context" },
+          { text: "old B", id: "B", context: "B context" },
+        ]);
+        expect(adoptedA).toHaveBeenCalledTimes(1);
+        expect(adoptedB).toHaveBeenCalledTimes(1);
+        expect(deferredA).toHaveBeenCalledTimes(1);
+        expect(deferredB).toHaveBeenCalledTimes(1);
+        expect(getExistingFollowupQueue(key)?.items ?? []).toEqual(adoptedSource ? [current] : []);
+        if (backendKind === "codex") {
+          expect(wire.mock.calls.map(([, args]) => args.input)).toEqual([

@@ -0,0 +1,105 @@
+import { publishChannelSourceProgress } from "../../channels/source-progress.js";
+import { throwIfAborted } from "./abort.js";
+import type { MessageActionResult, ResolvedActionContext } from "./message-action-contracts.js";
+import type { SendPayloadParts } from "./message-action-send-payload.js";
+import { isExactCurrentSourceConversation } from "./source-reply-mirror.js";
+
+/** Explicit non-final source text shares the channel's current request progress owner. */
+export async function executeMessageSourceProgress(params: {
+  ctx: ResolvedActionContext;
+  payload: SendPayloadParts;
+  threadId?: string | null;
+  replyToIsExplicit: boolean;
+}): Promise<MessageActionResult | undefined> {
+  const { ctx, payload } = params;
+  const { input } = ctx;
+  const authorization = input.messageActionAuthorization;
+  const sessionKey =
+    authorization?.sourceProgressRequest?.sessionKey ??
+    input.sourceReplySessionKey ??
+    input.sessionKey;
+  if (
+    ctx.dryRun ||
+    input.actionOrigin !== "message-tool" ||
+    input.sourceReplyFinal !== false ||
+    (ctx.gateway && !input.gatewayOwnedDelivery) ||
+    input.forceCoreDelivery ||
+    input.requireQueuePersistence ||
+    !sessionKey ||
+    !authorization?.toolContext ||
+    !payload.message.trim() ||
+    payload.mediaUrl ||
+    payload.mediaUrls?.length ||
+    payload.payload.mediaUrl ||
+    payload.payload.mediaUrls?.length ||
+    payload.payload.attachments?.length ||
+    payload.payload.presentation ||
+    payload.payload.interactive ||
+    payload.payload.location ||
+    payload.payload.delivery ||
+    payload.payload.channelData ||
+    payload.asVoice ||
+    payload.gifPlayback ||
+    payload.forceDocument ||
+    payload.silent !== undefined ||
+    !isExactCurrentSourceConversation({
+      cfg: ctx.cfg,
+      action: "send",
+      channel: ctx.channel,
+      actionParams: ctx.params,
+      accountId: ctx.accountId,
+      currentAccountId: authorization.requesterAccountId,
+      sessionKey,
+      toolContext: authorization.toolContext,
+      replyToIsExplicit: params.replyToIsExplicit,
+    })
+  ) {
+    return undefined;
+  }
+  const assertCurrent = () => {
+    throwIfAborted(ctx.abortSignal);
+    input.assertDirectAdapterHandoff?.();
+  };
+  assertCurrent();
+  const progress = await publishChannelSourceProgress({
+    cfg: ctx.cfg,
+    sessionKey,
+    sessionId: authorization.sourceProgressRequest?.sessionId ?? input.sessionId,
+    source: {
+      channel: ctx.channel,
+      to: String(ctx.params.to),
+      accountId: ctx.accountId ?? undefined,
+      threadId: params.threadId ?? undefined,
+    },
+    progressRequest: authorization.sourceProgressRequest,
+    text: payload.message,
+    signal: ctx.abortSignal ?? new AbortController().signal,
+    assertCurrent,
+  });
+  assertCurrent();
+  if (progress.status === "unbound") {
+    return undefined;
+  }
+  const sendResult = {
+    channel: ctx.channel,
+    to: String(ctx.params.to),
+    via: "direct" as const,
+    mediaUrl: null,
+    ...(progress.status === "visible" ? { result: { messageId: progress.messageId } } : {}),
+    deliveryStatus: progress.status === "visible" ? ("sent" as const) : ("suppressed" as const),
+  };
+  return {
+    kind: "send",
+    channel: ctx.channel,
+    action: "send",
+    to: sendResult.to,
+    handledBy: "core",
+    payload: {
+      ...sendResult,
+      ...(progress.status === "withheld" ? { ok: false, reason: "source_progress_withheld" } : {}),
+    },
+    sendResult,
+    ...(progress.status === "visible" ? { deliveredText: payload.message } : {}),
+    dryRun: false,
+  };
+}

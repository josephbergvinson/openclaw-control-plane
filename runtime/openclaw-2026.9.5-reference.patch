+import { describe, expect, it } from "vitest";
+import { resolveRequesterProgressRequest } from "./requester-presentation.js";
+const source = { channel: "discord", to: "channel:123", accountId: "default", threadId: "456" };
+function row() {
+  return {
+    completionRequesterSessionId: "incarnation",
+    progressOrigin: { ...source, messageId: "900" },
+  };
+}
+const params = { sessionKey: "agent:main:discord:channel:123", sessionId: "incarnation", source };
+describe("settled wave original progress facts", () => {
+  it("binds all completed and paused children to their exact common original request", () => {
+    const paused = { ...row(), pauseReason: "sessions_yield" };
+    expect(resolveRequesterProgressRequest({ ...params, rows: [row(), paused] })).toEqual({
+      sessionKey: params.sessionKey,
+      sessionId: "incarnation",
+      sourceMessageId: "900",
+      requestGeneration: "900",
+    });
+  });
+  it.each(["messageId", "to", "accountId", "threadId"] as const)(
+    "withholds a mixed wave with differing %s",
+    (field) => {
+      const other = row();
+      other.progressOrigin[field] = "different";
+      expect(resolveRequesterProgressRequest({ ...params, rows: [row(), other] })).toBeUndefined();
+    },
+  );
+  it("withholds a replaced or unproven incarnation and an unrelated current route", () => {
+    expect(
+      resolveRequesterProgressRequest({
+        ...params,
+        rows: [{ ...row(), completionRequesterSessionId: "replacement" }],
+      }),
+    ).toBeUndefined();
+    expect(
+      resolveRequesterProgressRequest({
+        ...params,
+        rows: [{ progressOrigin: row().progressOrigin }],
+      }),
+    ).toBeUndefined();
+    expect(
+      resolveRequesterProgressRequest({
+        ...params,
+        source: { ...source, to: "channel:999" },
+        rows: [row()],
+      }),
+    ).toBeUndefined();
+  });
+});

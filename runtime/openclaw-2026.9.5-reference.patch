+        requesterAgentId: "main",
+        acceptedSessionSpawns: [
+          {
+            runId: "accepted-child",
+            childSessionKey: entry.childSessionKey,
+            expectsCompletionMessage: true,
+          },
+        ],
+      });
+      expect(batch.children[0]?.runId).toBe(entry.runId);
+      expect(taskExecutorMocks.setDetachedTaskDeliveryStatusByRunId).not.toHaveBeenCalled();
+      if (boundary === "rearmed") {
+        entry.requesterSettleWake!.rearmGeneration = 2;
+      }
+      if (boundary === "replaced") {
+        runs.set(entry.runId, structuredClone(entry));
+      }
+      if (boundary === "running") {
+        entry.execution = { status: "running", startedAt: 3_000 };
+      }
+      if (boundary === "run-id") {
+        entry.runId = "other-run";
+      }
+      if (boundary === "task-id") {
+        entry.taskRunId = "other-task";
+      }
+      if (boundary === "generation") {
+        entry.generation = 99;
+      }
+      const outcome =
+        boundary === "ambiguous"
+          ? ({
+              delivered: false,
+              path: "none",
+              disposition: "ambiguous",
+              error: "Parent delivery is uncertain",
+            } as const)
+          : ({ delivered: true, path: "direct", requesterVisibleFinalDelivered: true } as const);
+      if (
+        ["rearmed", "replaced", "running", "run-id", "task-id", "generation"].includes(boundary)
+      ) {

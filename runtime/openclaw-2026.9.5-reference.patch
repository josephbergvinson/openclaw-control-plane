+            plugin: {
+              ...discordPlugin,
+              status: undefined,
+              actions: {
+                ...nativeActions,
+                handleAction: async (ctx) => {
+                  observedOwnerFlags.push(ctx.senderIsOwner);
+                  return await nativeHandle(ctx);
+                },
+              },
+            },
+          });
+          setActivePluginRegistry(owner.registry);
+          const voiceRead = vi.fn(async () =>
+            Response.json({ guild_id: guildId, channel_id: voiceChannelId, user_id: userId }),

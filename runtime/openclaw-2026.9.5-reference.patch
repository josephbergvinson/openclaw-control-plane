@@ -0,0 +1,68 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { createSessionsSpawnTool } from "./sessions-spawn-tool.js";
+
+const spawnSubagentDirect = vi.hoisted(() => vi.fn());
+
+vi.mock("../subagents/spawn/subagent-spawn.js", () => ({
+  SUBAGENT_SPAWN_CONTEXT_MODES: ["isolated", "fork"],
+  SUBAGENT_SPAWN_MODES: ["run", "session"],
+  spawnSubagentDirect,
+}));
+
+describe("sessions_spawn authenticated requester credential capture", () => {
+  beforeEach(() => {
+    spawnSubagentDirect
+      .mockReset()
+      .mockResolvedValue({ status: "error", error: "no launch in fixture" });
+  });
+
+  it("captures the runtime's sender tuple and ignores model-authored credential and owner fields", async () => {
+    const tool = createSessionsSpawnTool({
+      config: {},
+      agentSessionKey: "agent:main:main",
+      requesterSenderId: "owner-A",
+      agentAccountId: "company-A",
+      agentChannel: "discord",
+    });
+
+    await tool.execute("spawn-1", {
+      task: "retrieve protected evidence",
+      senderIsOwner: true,
+      mcpRequesterScope: { requesterSenderId: "other-owner", agentAccountId: "company-B" },
+    });
+
+    expect(spawnSubagentDirect).toHaveBeenCalledOnce();
+    const [request, context] = spawnSubagentDirect.mock.calls[0]!;
+    expect(context.mcpRequesterScope).toEqual({
+      requesterSenderId: "owner-A",
+      agentAccountId: "company-A",
+      messageChannel: "discord",
+    });
+    expect(context.mcpRequesterScopeAssertCurrent).toBeTypeOf("function");
+    expect(context).not.toHaveProperty("senderIsOwner");
+    expect(request).not.toHaveProperty("mcpRequesterScope");
+    expect(tool.parameters).not.toHaveProperty("properties.mcpRequesterScope");
+  });
+
+  it("never falls back to a later sender when an inherited credential scope is stale", async () => {
+    const tool = createSessionsSpawnTool({
+      config: {},
+      agentSessionKey: "agent:main:main",
+      requesterSenderId: "later-sender",
+      agentAccountId: "company-B",
+      mcpRequesterScope: {
+        requesterSenderId: "owner-A",
+        agentAccountId: "company-A",
+        messageChannel: "discord",
+      },
+      mcpRequesterScopeAssertCurrent: () => {
+        throw new Error("original task retired");
+      },
+    });
+
+    await expect(tool.execute("spawn-1", { task: "retrieve protected evidence" })).rejects.toThrow(
+      "original task retired",
+    );
+    expect(spawnSubagentDirect).not.toHaveBeenCalled();
+  });
+});

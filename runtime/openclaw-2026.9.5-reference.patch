@@ -0,0 +1,55 @@
+import {
+  normalizeOperatorMessageReadScope,
+  type OperatorMessageReadScope,
+} from "../../gateway/message-action-turn-capability.js";
+import { stripFormattedReasoningMessage } from "../../shared/text/formatted-reasoning-message.js";
+import { ToolInputError } from "../tool-input-error.js";
+import { readToolStringParam } from "./common.js";
+
+const SESSIONS_SEND_MESSAGE_ALIASES = ["SendMessage", "content", "text"] as const;
+
+export function normalizeSessionsSendArguments(args: unknown): Record<string, unknown> {
+  const params =
+    args && typeof args === "object" && !Array.isArray(args)
+      ? {
+          // SAFETY: The branch guards a non-null, non-array object; property values remain unknown.
+          ...(args as Record<string, unknown>),
+        }
+      : {};
+
+  if (typeof params.message !== "string" || !params.message.trim()) {
+    for (const alias of SESSIONS_SEND_MESSAGE_ALIASES) {
+      const value = readToolStringParam(params, alias, { trim: false });
+      if (value?.trim()) {
+        params.message = stripFormattedReasoningMessage(value);
+        break;
+      }
+    }
+  }
+
+  for (const alias of SESSIONS_SEND_MESSAGE_ALIASES) {
+    delete params[alias];
+  }
+  return params;
+}
+
+/** Parses the existing explicit-resume read scope without changing its authority. */
+export function readSessionsSendMessageReadScope(
+  value: unknown,
+  mode: string | undefined,
+): OperatorMessageReadScope | undefined {
+  let requestedReadScope: OperatorMessageReadScope | undefined;
+  if (value !== undefined) {
+    try {
+      requestedReadScope = normalizeOperatorMessageReadScope(value);
+    } catch (error) {
+      throw new ToolInputError(
+        error instanceof Error ? error.message : "Invalid messageReadScope.",
+      );
+    }
+  }
+  if (requestedReadScope !== undefined && mode !== "resume") {
+    throw new ToolInputError("messageReadScope is only valid for explicit task resume.");
+  }
+  return requestedReadScope;
+}

+import { beforeAll, beforeEach, expect, it, vi } from "vitest";
+import { SILENT_REPLY_TOKEN } from "../tokens.js";
+import { buildNoVisibleReplyFallbackText } from "./dispatch-from-config.payloads.js";
+import { diagnosticMocks, emptyConfig, mocks } from "./dispatch-from-config.shared.test-harness.js";
+import {
+  describe0BeforeEach0,
+  describe2BeforeEach0,
+  dispatchReplyFromConfig,
+  globalBeforeAll0,
+  firstRouteReplyCall,
+  setNoAbort,
+} from "./dispatch-from-config.test-harness.js";
+import { createReplyDispatcher } from "./reply-dispatcher.js";
+import { resolveReplyOperationRunState } from "./reply-operation-run-state.js";
+import { buildTestCtx } from "./test-ctx.js";
+
+beforeAll(globalBeforeAll0);
+beforeEach(() => {
+  describe0BeforeEach0();
+  describe2BeforeEach0();
+  setNoAbort();
+  diagnosticMocks.logMessageDispatchCompleted.mockClear();
+});
+
+it.each([
+  { terminal: "cancelled", text: SILENT_REPLY_TOKEN, routed: false },
+  { terminal: "cancelled", text: undefined, routed: false },
+  { terminal: "cancelled", text: SILENT_REPLY_TOKEN, routed: true },
+  { terminal: "cancelled", text: undefined, routed: true },
+  { terminal: "failed", text: SILENT_REPLY_TOKEN, routed: false },
+  { terminal: "failed", text: undefined, routed: false },
+  { terminal: "failed", text: SILENT_REPLY_TOKEN, routed: true },
+  { terminal: "failed", text: undefined, routed: true },
+  { terminal: "ok", text: undefined, routed: false },
+  { terminal: "ok", text: undefined, routed: true },
+] as const)("settles $terminal $text with routed=$routed", async ({ terminal, text, routed }) => {
+  const deliver = vi.fn(async () => {});
+  const dispatcher = createReplyDispatcher({ deliver });
+  const runId = "native-aborted-run";
+  const result = await dispatchReplyFromConfig({
+    ctx: buildTestCtx({
+      ChatType: "direct",
+      Provider: "telegram",
+      Surface: "telegram",
+      OriginatingChannel: routed ? "discord" : "telegram",
+      OriginatingTo: "user:1",
+    }),
+    cfg: emptyConfig,
+    dispatcher,
+    replyResolver: async (_ctx, options) => {
+      options?.onAgentRunStart?.(runId);
+      const state = resolveReplyOperationRunState(options);
+      if (!state) {
+        throw new Error("Expected invocation-owned reply state");
+      }
+      // A native run-only stop records cancellation without aborting dispatch.
+      state.agentTurn = terminal;
+      if (terminal === "failed") {
+        options?.onAgentRunTerminalOutcome?.("failed");
+      }
+      return text === undefined ? undefined : { text };
+    },
+  });
+
+  dispatcher.markComplete();
+  await dispatcher.waitForIdle();
+
+  if (terminal === "cancelled") {
+    expect(deliver).not.toHaveBeenCalled();
+    expect(mocks.routeReply).not.toHaveBeenCalled();
+    expect(result.queuedFinal).toBe(false);
+    expect(result.noVisibleReplyFallbackDelivered).toBeUndefined();
+    expect(result.noVisibleReplyFallbackEligible).toBeUndefined();
+    expect(diagnosticMocks.logMessageDispatchCompleted).toHaveBeenCalledWith(
+      expect.objectContaining({ outcome: "skipped", reason: "reply_operation_aborted" }),
+    );
+  } else {
+    const payload = { text: buildNoVisibleReplyFallbackText(runId) };
+    if (routed) {
+      expect(firstRouteReplyCall().payload).toEqual(payload);
+      expect(deliver).not.toHaveBeenCalled();
+    } else {
+      expect(deliver).toHaveBeenCalledExactlyOnceWith(payload, expect.any(Object));
+    }
+    expect(result.noVisibleReplyFallbackDelivered).toBe(true);
+    expect(diagnosticMocks.logMessageDispatchCompleted).toHaveBeenCalledWith(
+      expect.objectContaining({ outcome: terminal === "failed" ? "error" : "completed" }),
+    );
+  }
+});

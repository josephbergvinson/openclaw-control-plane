+} from "../../gateway/message-action-turn-capability.js";
+import { resolveAgentIdFromSessionKey } from "../../routing/session-key.js";
+import type { SubagentRunRecord } from "./registry/subagent-registry.types.js";
+
+/** Parent completion/yield does not retire its original session's authenticated source. */
+export function assertMessageActionSourceSessionCurrent(
+  source: MessageActionDelegationSource,
+  cfg: OpenClawConfig,
+): void {
+  const agentId = resolveAgentIdFromSessionKey(source.sourceRequest.sessionKey);
+  const entry = loadSessionEntryReadOnly({
+    sessionKey: source.sourceRequest.sessionKey,
+    storePath: resolveSessionStorePathCore(cfg.session?.store, { agentId }),
+  });
+  if (
+    entry?.sessionId !== source.sourceRequest.sessionId ||
+    entry.lifecycleRevision !== source.sourceLifecycleRevision ||
+    entry.archivedAt !== undefined
+  ) {
+    throw new Error("Message action original source session is no longer current");
+  }
+}
+
+/** Redeem native source authority once, while the actual parent's spawn invocation is live. */
+export function captureSubagentMessageActionSource(params: {
+  token?: string;
+  agentId?: string;
+  runId?: string;
+  sessionKey?: string;
+  sessionId?: string;
+  cfg: OpenClawConfig;
+  assertCurrent: () => void;
+}): MessageActionDelegation | undefined {
+  if (!params.token || !params.agentId || !params.runId || !params.sessionKey) {
+    return undefined;
+  }
+  const lookup = {
+    token: params.token,
+    agentId: params.agentId,
+    runId: params.runId,
+    sessionKey: params.sessionKey,
+    sessionId: params.sessionId,
+  };
+  const resolve = () => {
+    params.assertCurrent();
+    const authorization = resolveMessageActionTurnAuthorization(lookup);
+    if (!authorization) {
+      throw new Error("Authenticated message action source is no longer active");
+    }
+    if (
+      authorization.scheduled ||
+      authorization.assertDashboardReadCurrent ||
+      authorization.operator ||
+      !authorization.requesterSenderId ||
+      !isTrustedMessageActionTurnIngress(authorization.toolContext?.currentChannelProvider)
+    ) {
+      return undefined;
+    }
+    if (authorization.delegatedSource) {
+      return copyMessageActionDelegationSource(authorization.delegatedSource);
+    }
+    const sourceRequest = authorization.sourceProgressRequest;
+    if (!sourceRequest) {
+      return undefined;
+    }
+    const agentId = resolveAgentIdFromSessionKey(sourceRequest.sessionKey);
+    const entry = loadSessionEntryReadOnly({
+      sessionKey: sourceRequest.sessionKey,
+      storePath: resolveSessionStorePathCore(params.cfg.session?.store, { agentId }),
+    });
+    const context = authorization.toolContext;
+    return copyMessageActionDelegationSource({
+      sourceRequest,
+      sourceLifecycleRevision: entry?.lifecycleRevision,
+      requesterAccountId: authorization.requesterAccountId,
+      requesterSenderId: authorization.requesterSenderId,
+      toolContext: {
+        currentChannelProvider: context?.currentChannelProvider,
+        currentChannelId: context?.currentChannelId,
+        currentMessagingTarget: context?.currentMessagingTarget,
+        currentGraphChannelId: context?.currentGraphChannelId,
+        currentChatType: context?.currentChatType,
+        currentThreadTs: context?.currentThreadTs,
+        currentMessageId:
+          context?.currentMessageId != null ? String(context.currentMessageId) : undefined,
+        currentSourceTurnId: context?.currentSourceTurnId,
+        replyToMode: context?.replyToMode,
+        sameChannelThreadRequired: context?.sameChannelThreadRequired,
+        skipCrossContextDecoration: context?.skipCrossContextDecoration,
+      },
+    });
+  };
+  const source = resolve();
+  if (!source) {
+    return undefined;
+  }
+  assertMessageActionSourceSessionCurrent(source, params.cfg);
+  const fingerprint = JSON.stringify(source);
+  const admission = resolveMessageActionTurnCapability(lookup);
+  if (!admission) {
+    throw new Error("Authenticated message action source is no longer active");
+  }
+  return {
+    source,
+    sourceAdmission: { ...admission, turnCapability: params.token },
+    assertCurrent: () => {
+      if (JSON.stringify(resolve()) !== fingerprint) {
+        throw new Error("Message action delegating source changed");
+      }
+      assertMessageActionSourceSessionCurrent(source, params.cfg);
+    },
+  };
+}
+
+/** Existing registry/settlement guards own the row; only unanimous factual source is adopted. */
+export function captureRegisteredMessageActionSource(params: {
+  records: readonly SubagentRunRecord[];
+  assertCurrent: () => void;
+  cfg: OpenClawConfig;
+}): MessageActionDelegation | undefined {
+  const records = [...params.records];
+  const raw = records[0]?.requesterMessageActionSource;
+  if (!raw) {
+    return undefined;
+  }
+  const source = copyMessageActionDelegationSource(raw);
+  const fingerprint = JSON.stringify(source);
+  const identities = records.map((entry) => ({
+    entry,
+    runId: entry.runId,
+    generation: entry.generation,
+    createdAt: entry.createdAt,
+    requesterSessionKey: entry.requesterSessionKey,
+    completionRequesterSessionId: entry.completionRequesterSessionId,
+    childSessionKey: entry.childSessionKey,
+  }));
+  const assertCurrent = () => {
+    params.assertCurrent();
+    if (
+      !records.length ||
+      identities.some(
+        ({ entry, ...identity }) =>
+          entry.runId !== identity.runId ||
+          entry.generation !== identity.generation ||
+          entry.createdAt !== identity.createdAt ||
+          entry.childSessionKey !== identity.childSessionKey ||
+          entry.requesterSessionKey !== identity.requesterSessionKey ||
+          entry.completionRequesterSessionId !== identity.completionRequesterSessionId ||
+          JSON.stringify(copyMessageActionDelegationSource(entry.requesterMessageActionSource)) !==
+            fingerprint,
+      )
+    ) {
+      throw new Error("Message action registered source changed or has mixed owners");
+    }
+    assertMessageActionSourceSessionCurrent(source, params.cfg);
+  };
+  assertCurrent();
+  return { source, assertCurrent };
+}

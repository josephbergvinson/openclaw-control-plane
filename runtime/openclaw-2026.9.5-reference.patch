@@ -0,0 +1,241 @@
+import { describe, expect, it, vi } from "vitest";
+import { createDeferred, withTestTimeout } from "../../../test/helpers/promise.js";
+import { runActiveReplySteer } from "./agent-runner-steer-adoption.js";
+import { clearSessionQueues, enqueueFollowupRun, type FollowupRun } from "./queue.js";
+import { createQueueTestRun } from "./queue.test-helpers.js";
+import { getExistingFollowupQueue } from "./queue/state.js";
+import { withQuestionCreator } from "./reply-run-question.test-support.js";
+import type { ReplyBackendHandle, ReplyOperation } from "./reply-run-registry.contracts.js";
+import { createMockTypingController } from "./test-helpers.js";
+import { createTypingSignaler } from "./typing-mode.js";
+
+function startSteer(params: {
+  key: string;
+  run: FollowupRun;
+  operation: ReplyOperation;
+  fingerprint: string;
+  followup: (run: FollowupRun) => Promise<void>;
+  isToolAuthorityCurrent?: () => boolean;
+}) {
+  const typing = createMockTypingController();
+  return runActiveReplySteer({
+    followupRun: params.run,
+    opts: undefined,
+    providedReplyOperation: params.operation,
+    queueKey: params.key,
+    releaseAdmissionTicket: () => {},
+    replyOperationRunState: undefined,
+    resolvedQueue: { mode: "steer", debounceMs: 0 },
+    restartRecoverySourceTurnId: params.run.messageId,
+    runFollowup: params.followup,
+    sessionCtx: {},
+    sessionKey: params.key,
+    touchActiveSessionEntry: async () => {},
+    typing,
+    typingSignals: createTypingSignaler({ typing, mode: "never", isHeartbeat: false }),
+    toolAuthorityFingerprint: params.fingerprint,
+    isToolAuthorityCurrent: params.isToolAuthorityCurrent,
+  });
+}
+
+function autoAuthRun(prompt: string, messageId: string): FollowupRun {
+  const run = createQueueTestRun({ prompt, messageId });
+  run.run.authProfileId = "openai:admitted";
+  run.run.authProfileIdSource = "auto";
+  return run;
+}
+
+describe("automatic account ownership across steering awaits", () => {
+  it.each(["rotation", "replacement"] as const)(
+    "retains FIFO when backend %s invalidates a parked automatic-account steer",
+    async (change) => {
+      const key = `agent:main:parked-account-${change}`;
+      const first = autoAuthRun("first input", "first");
+      await withQuestionCreator(key, first, async (operation, fingerprint) => {
+        let acceptedProfileId = "openai:accepted";
+        const entered = createDeferred();
+        const releaseFirst = createDeferred();
+        const secondDeferred = createDeferred();
+        const secondAdopted = vi.fn();
+        const second = {
+          ...first,
+          prompt: "second input",
+          messageId: "second",
+          turnAdoptionLifecycle: {
+            onDeferred: () => secondDeferred.resolve(),
+            onAdopted: secondAdopted,
+          },
+        };
+        const third = { ...first, prompt: "third input", messageId: "third" };
+        const followup = vi.fn(async (_run: FollowupRun) => {});
+        const cancel = vi.fn();
+        const queueMessage = vi.fn<
+          NonNullable<ReplyBackendHandle["messageInjectionV2"]>["queueMessage"]
+        >(async (message, _options, assertCurrent) => {
+          assertCurrent();
+          if (message === first.prompt) {
+            // This dispatch began under the old backend. Its acceptance receipt
+            // can arrive after a successor attaches; the next input must wait.
+            entered.resolve();
+            await releaseFirst.promise;
+          }
+        });
+        const backend: ReplyBackendHandle = {
+          kind: "embedded",
+          runId: "accepted-backing-work",
+          get acceptedAutoAuthProfileId() {
+            return acceptedProfileId;
+          },
+          toolAuthorityFingerprint: fingerprint,
+          cancel,
+          messageInjectionV2: { version: 2, isAvailable: () => true, queueMessage },
+        };
+        operation.attachBackend(backend);
+        operation.setPhase("running");
+        const capturedAuth = operation.acceptedAutoAuthProfile;
+        expect(capturedAuth?.acceptedProfileId).toBe("openai:accepted");
+        const common = { key, operation, fingerprint, followup };
+        const firstSteer = startSteer({ ...common, run: first });
+        let secondSteer: ReturnType<typeof startSteer> | undefined;
+        try {
+          await withTestTimeout(entered.promise, 1_000, "first steer did not reach backend");
+          secondSteer = startSteer({
+            ...common,
+            run: second,
+            isToolAuthorityCurrent: capturedAuth!.isCurrent,
+          });
+          await withTestTimeout(secondDeferred.promise, 1_000, "second steer was not parked");
+          expect(
+            enqueueFollowupRun(
+              key,
+              third,
+              { mode: "followup", debounceMs: 0 },
+              "message-id",
+              followup,
+              false,
+            ),
+          ).toBe(true);
+          if (change === "rotation") {
+            acceptedProfileId = "openai:next";
+          } else {
+            operation.attachBackend({ ...backend, acceptedAutoAuthProfileId: "openai:next" });
+          }
+          expect(capturedAuth!.isCurrent()).toBe(false);
+          releaseFirst.resolve();
+          await Promise.all([firstSteer, secondSteer]);
+          expect(queueMessage.mock.calls.map(([message]) => message)).toEqual([first.prompt]);
+          expect(secondAdopted).not.toHaveBeenCalled();
+          expect(getExistingFollowupQueue(key)?.items.map((run) => run.messageId)).toEqual([
+            "second",
+            "third",
+          ]);
+          expect(cancel).not.toHaveBeenCalled();
+          operation.complete();
+          await vi.waitFor(() => expect(followup).toHaveBeenCalledTimes(2));
+          expect(followup.mock.calls.map(([run]) => run.messageId)).toEqual(["second", "third"]);
+        } finally {
+          releaseFirst.resolve();
+          await Promise.allSettled([firstSteer, secondSteer]);
+          clearSessionQueues([key]);
+        }
+      });
+    },
+  );
+
+  it.each([
+    { alreadyAccepted: false, rotates: true },
+    { alreadyAccepted: true, rotates: true },
+    { alreadyAccepted: false, rotates: false },
+  ])(
+    "rechecks account ownership at final dispatch (accepted: $alreadyAccepted, rotates: $rotates)",
+    async ({ alreadyAccepted, rotates }) => {
+      const key = `agent:main:dispatch-account-${alreadyAccepted}-${rotates}`;
+      const run = autoAuthRun("account-bound input", "dispatch");
+      await withQuestionCreator(key, run, async (operation, fingerprint) => {
+        let acceptedProfileId = "openai:accepted";
+        const entered = createDeferred();
+        const release = createDeferred();
+        const dispatch = vi.fn();
+        const adopted = vi.fn();
+        const cancel = vi.fn();
+        const followup = vi.fn(async (_run: FollowupRun) => {});
+        run.turnAdoptionLifecycle = { onAdopted: adopted };
+        operation.attachBackend({
+          kind: "embedded",
+          runId: "accepted-backing-work",
+          get acceptedAutoAuthProfileId() {
+            return acceptedProfileId;
+          },
+          toolAuthorityFingerprint: fingerprint,
+          cancel,
+          messageInjectionV2: {
+            version: 2,
+            isAvailable: () => true,
+            queueMessage: async (_message, options, assertCurrent) => {
+              assertCurrent();
+              if (alreadyAccepted) {
+                options?.onQueueAccepted?.(true);
+              }
+              entered.resolve();
+              await release.promise;
+              assertCurrent();
+              dispatch();
+            },
+          },
+        });
+        operation.setPhase("running");
+        const auth = operation.acceptedAutoAuthProfile!;
+        const steering = startSteer({
+          key,
+          run,
+          operation,
+          fingerprint,
+          followup,
+          isToolAuthorityCurrent: auth.isCurrent,
+        });
+        // Attach a rejection handler before releasing the delayed dispatch.
+        const observed = steering.then(
+          (result) => ({ result, error: undefined }),
+          (error: unknown) => ({ result: undefined, error }),
+        );
+        try {
+          await withTestTimeout(entered.promise, 1_000, "steer did not reach backend");
+          if (rotates) {
+            acceptedProfileId = "openai:next";
+          }
+          release.resolve();
+          const outcome = await observed;
+          expect(cancel).not.toHaveBeenCalled();
+          if (!rotates) {
+            expect(dispatch).toHaveBeenCalledOnce();
+            expect(adopted).toHaveBeenCalledOnce();
+            expect(outcome).toEqual({ result: "handled", error: undefined });
+            expect(getExistingFollowupQueue(key)?.items ?? []).toHaveLength(0);
+          } else if (alreadyAccepted) {
+            expect(dispatch).not.toHaveBeenCalled();
+            expect(adopted).not.toHaveBeenCalled();
+            expect(outcome.error).toBeInstanceOf(Error);
+            expect(getExistingFollowupQueue(key)?.items ?? []).toHaveLength(0);
+          } else {
+            expect(dispatch).not.toHaveBeenCalled();
+            expect(adopted).not.toHaveBeenCalled();
+            expect(outcome).toEqual({ result: "handled", error: undefined });
+            expect(getExistingFollowupQueue(key)?.items.map((item) => item.messageId)).toEqual([
+              "dispatch",
+            ]);
+          }
+          operation.complete();
+          if (rotates && !alreadyAccepted) {
+            await vi.waitFor(() => expect(followup).toHaveBeenCalledOnce());
+          } else {
+            expect(followup).not.toHaveBeenCalled();
+          }
+        } finally {
+          release.resolve();
+          await observed;
+          clearSessionQueues([key]);
+        }
+      });
+    },
+  );
+});

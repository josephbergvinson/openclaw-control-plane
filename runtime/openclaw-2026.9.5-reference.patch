+  runSessionCompactionIfNeeded: (...args: unknown[]) => mocks.preflight(...args),
+}));
+vi.mock("./agent-runner-auto-fallback.js", () => ({
+  resolveRunAfterAutoFallbackPrimaryProbeRecheck: ({ run }: { run: FollowupRun["run"] }) => run,

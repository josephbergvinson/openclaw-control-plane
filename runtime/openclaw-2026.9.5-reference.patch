+        preparing.resolve();
+        await release.promise;
+        try {
+          assertAdmissionCurrent?.();
+        } catch {
+          io.emitAcceptance([
+            false,
+            undefined,
+            errorShape(ErrorCodes.UNAVAILABLE, "temporarily reserved"),
+          ]);
+          return;

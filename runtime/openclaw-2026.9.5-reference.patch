+    "keeps acknowledged %s policy through a subsequent cancellation and reload",
+    async (notify) => {
+      const task = await seedActiveTask();
+      callGateway.mockImplementation(async ({ method, params }) => {
+        expect(method).toBe("tasks.notify");
+        const result = await runTaskHandler("tasks.notify", params);
+        expect(result.calls[0]?.[0]).toBe(true);
+        return result.payload;
+      });
+      const runtime = createTestRuntime();
+      await tasksNotifyCommand({ lookup: task.runId!, notify }, runtime);
+      expect(callGateway).toHaveBeenCalledExactlyOnceWith({
+        method: "tasks.notify",
+        params: { taskId: task.taskId, notifyPolicy: notify },
+        timeoutMs: 15_000,
+      });
+      expect(runtime.error).not.toHaveBeenCalled();
+      expect(runtime.log).toHaveBeenCalledExactlyOnceWith(
+        `Updated ${task.taskId} notify policy to ${notify}.`,
+      );
+      expect(getTaskById(task.taskId)?.notifyPolicy).toBe(notify);

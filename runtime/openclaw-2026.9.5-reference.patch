+
+/** Resolve only the private incarnation recorded by the completed child's owner. */
+export function findPrivateSubagentParent(
+  runs: ReadonlyMap<string, SubagentRunRecord>,
+  child: SubagentRunRecord,
+): SubagentRunRecord | undefined {
+  if (
+    !isInternalSessionEffectsKey(child.requesterSessionKey) ||
+    !child.completionRequesterSessionId
+  ) {
+    return undefined;
+  }
+  const owners = [...runs.values()].filter(
+    (owner) =>
+      owner.execution.transcriptTarget?.sessionKey === child.requesterSessionKey &&
+      owner.execution.transcriptTarget.sessionId === child.completionRequesterSessionId &&
+      owner.cleanupCompletedAt === undefined,
+  );
+  return owners.length === 1 ? owners[0] : undefined;

+/** Foreground requester admission and its lifecycle-owned synchronous outbox deferral. */
+import { resolveActiveReplyOperationForSessionId } from "../../../auto-reply/reply/reply-run-registry.js";
+import type { SubagentRunRecord } from "../registry/subagent-registry.types.js";
+import type { SubagentAnnounceDeliveryResult } from "./subagent-announce-dispatch.js";
+import type { RequesterSettleWakeBatchState } from "./subagent-announce.requester-settle-wave.js";
+
+export type RequesterSettleWakeBatchCallbacks = {
+  transitionBatch: (
+    batch: readonly SubagentRunRecord[],
+    state: RequesterSettleWakeBatchState,
+  ) => void;
+  completeBatch: (
+    batch: readonly SubagentRunRecord[],
+    rearmGeneration?: number,
+    delivery?: SubagentAnnounceDeliveryResult,
+  ) => void;
+};
+
+const REQUESTER_SETTLE_WAKE_MAX_DEFERRALS = 10;
+
+export function createRequesterSettleWakeDeferral(
+  params: RequesterSettleWakeBatchCallbacks & {
+    settledBatch: readonly SubagentRunRecord[];
+    batchRunIds: readonly string[];
+    retryDelayMs: number;
+    countTowardsLimit: () => boolean;
+    finalizeRequesterAttachment: (
+      runIds: readonly string[],
+      state: RequesterSettleWakeBatchState,
+    ) => void;
+  },
+): (state: RequesterSettleWakeBatchState, countTowardsLimit?: boolean) => void {
+  const { settledBatch, batchRunIds, completeBatch, finalizeRequesterAttachment } = params;
+  return function deferBatch(
+    state: RequesterSettleWakeBatchState,
+    countTowardsLimit = params.countTowardsLimit(),
+  ): void {
+    const now = Date.now();
+    if ((state.nextAttemptAt ?? 0) > now) {
+      return;
+    }
+    // Live descendant or requester work is not a stale settle loop.
+    // Reset their stale-deferral budget so long-running waves cannot terminalize
+    // an already completed sibling before the requester can receive it.
+    const deferralCount = countTowardsLimit ? (state.deferralCount ?? 0) + 1 : 0;
+    if (countTowardsLimit && deferralCount >= REQUESTER_SETTLE_WAKE_MAX_DEFERRALS) {
+      completeBatch(settledBatch, state.rearmGeneration, {
+        delivered: false,
+        path: "none",
+        error: "requester settle wake deferred too many times",
+      });
+      finalizeRequesterAttachment(batchRunIds, state);
+      return;
+    }
+    params.transitionBatch(settledBatch, {
+      status: state.status,
+      attemptCount: state.attemptCount,
+      ...(state.replayCount !== undefined ? { replayCount: state.replayCount } : {}),
+      nextAttemptAt: Math.max(state.nextAttemptAt ?? 0, now + params.retryDelayMs),
+      batchRunIds: [...batchRunIds],
+      ...(state.requesterYieldBatch === true ? { requesterYieldBatch: true } : {}),
+      ...(state.afterRequesterYield === true ? { afterRequesterYield: true } : {}),
+      ...(state.rearmGeneration !== undefined ? { rearmGeneration: state.rearmGeneration } : {}),
+      ...(state.lastError !== undefined ? { lastError: state.lastError } : {}),
+      deferralCount,
+    });
+  };
+}
+
+export function isRequesterSettleForegroundTurnPending(
+  requesterSessionId: string,
+  requesterAgentId: string | undefined,
+): boolean {
+  const operation = resolveActiveReplyOperationForSessionId(requesterSessionId);
+  // The active reservation owns preflight, queue waits and final persistence.
+  // Historical incarnations, other agents and heartbeat work do not own this wake.
+  return Boolean(
+    requesterAgentId &&
+    operation &&
+    operation.agentId === requesterAgentId &&
+    operation.turnKind !== "heartbeat",
+  );
+}

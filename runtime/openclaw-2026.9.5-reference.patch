index 0000000000000000000000000000000000000000..e7118adf068f59c124e36745fd00b6d5db2cbeff
--- /dev/null
+++ b/src/agents/embedded-agent-runner/compaction-auth-fallback.ts
@@ -0,0 +1,78 @@
+/** Advance failed compaction through its existing, same-route credential plan. */
+import { isProfileInCooldown, markAuthProfileFailure } from "../auth-profiles.js";
+import type { DirectCompactionPreparation } from "./direct-compaction-preparation.js";
+import { log } from "./logger.js";
+import { resolveAuthProfileFailureReason } from "./run/auth-profile-failure-policy.js";
+import type { EmbeddedAgentCompactResult } from "./types.js";
+
+export async function prepareCompactionAuthRetry(
+  prepared: DirectCompactionPreparation,
+  result: EmbeddedAgentCompactResult,
+  attemptedProfiles: Set<string>,
+): Promise<DirectCompactionPreparation["params"] | undefined> {
+  const {
+    params,
+    apiKeyInfo,
+    resolvedRuntimeAuthPlan: plan,
+    runtimeAuthProfileStore: store,
+  } = prepared;
+  const profileId = apiKeyInfo.profileId;
+  const failure = result.failure?.reason;
+  if (
+    result.ok ||
+    result.compacted ||
+    params.abortSignal?.aborted ||
+    !profileId ||
+    plan.forwardedAuthProfileSource !== "auto" ||
+    params.authProfileIdSource === "user" ||
+    (failure !== "rate_limit" &&
+      failure !== "billing" &&
+      failure !== "auth" &&
+      failure !== "auth_permanent")
+  ) {
+    return undefined;
+  }
+  attemptedProfiles.add(profileId);
+  const reason = resolveAuthProfileFailureReason({
+    failoverReason: failure,
+    providerStarted: true,
+  });
+  if (reason) {
+    try {
+      await markAuthProfileFailure({
+        store,
+        profileId,
+        credential: prepared.authProfileCredential,
+        reason,
+        cfg: params.config,
+        agentDir: prepared.agentDir,
+        runId: prepared.runId,
+        modelId: prepared.modelId,
+      });
+    } catch {
+      // Run-local exhaustion must still advance if shared bookkeeping is unavailable.
+      log.warn("Compaction auth failure bookkeeping failed; retaining run-local exhaustion.");
+    }
+  }
+  params.abortSignal?.throwIfAborted();
+  const candidates = plan.forwardedAuthProfileCandidateIds?.filter(
+    (candidate) =>
+      !attemptedProfiles.has(candidate) &&
+      !isProfileInCooldown(store, candidate, undefined, prepared.modelId),
+  );
+  if (!candidates?.length) {
+    return undefined;
+  }
+  return {
+    ...params,
+    authProfileId: candidates[0],
+    authProfileIdSource: "auto",
+    runtimeAuthPlan: {
+      ...plan,
+      forwardedAuthProfileId: candidates[0],
+      forwardedAuthProfileCandidateIds: candidates,
+    },
+    // Rebuild the model and request wrappers from the next immutable auth tuple.
+    runtimePlan: undefined,
+  };
+}

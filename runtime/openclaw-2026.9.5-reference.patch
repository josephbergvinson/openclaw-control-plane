+import { expect, it, vi } from "vitest";
+import type { agentCommandFromGatewayIngress } from "../../../commands/agent.js";
+import { dispatchAgentRunFromGateway } from "../../../gateway/agent-turn/agent-run-dispatch.js";
+import type { createAgentTurnService } from "../../../gateway/agent-turn/agent-turn-service.js";
+import { createInternalAgentTurnFacade } from "../../../gateway/agent-turn/internal-facade.js";
+import { createGatewayMethodRegistry } from "../../../gateway/methods/registry.js";
+import { createChatRunState } from "../../../gateway/server-chat-state.js";
+import type { GatewayRequestContext } from "../../../gateway/server-methods/types.js";
+import { createSyntheticPluginRuntimeClient } from "../../../gateway/server-plugin-runtime-client.js";
+import { withPluginRuntimeGatewayRequestScope } from "../../../plugins/runtime/gateway-request-scope.js";
+import { createUserTurnTranscriptRecorder } from "../../../sessions/user-turn-transcript.js";
+import type { UserTurnTranscriptRecorder } from "../../../sessions/user-turn-transcript.types.js";
+import { trackAsyncWork } from "../../../shared/async-work-scope.js";
+import { createDeferredCore } from "../../../shared/deferred.js";
+import type { RequesterPresentation } from "../../command/requester-presentation.js";
+import { createAgentRunSupersededAbortError } from "../../run-termination.js";
+import type { SubagentRunRecord } from "../registry/subagent-registry.types.js";
+import { setSubagentAnnounceDeliveryDepsForTest } from "./subagent-announce-delivery.runtime.js";
+import { sendSubagentAnnounceDirectly } from "./subagent-announce-direct-delivery.js";
+import {
+  maybeWakeRequesterAfterAllChildrenSettled,
+  type RequesterSettleWakeBatchState,
+} from "./subagent-announce.requester-settle-wake.js";
+
+const REQUESTER_KEY = "agent:main:main";
+
+export function createContext(): GatewayRequestContext {
+  const chatRunState = createChatRunState();
+  const methodRegistry = createGatewayMethodRegistry([]);
+  const context = Object.assign({} as GatewayRequestContext, {
+    trackExecution: trackAsyncWork,
+    agentRunSeq: new Map(),
+    broadcast: vi.fn(),
+    chatAbortControllers: new Map(),
+    chatRunState,
+    dedupe: new Map(),
+    getRuntimeConfig: () => ({}),
+    getGatewayMethodRegistry: () => methodRegistry,
+    logGateway: { error: vi.fn(), warn: vi.fn() },
+    nodeSendToSession: vi.fn(),
+    removeChatRun: vi.fn(() => undefined),
+  });
+  context.createAgentTurnFacade = (principal) =>
+    createInternalAgentTurnFacade({
+      ...principal,
+      getContext: () => context,
+      getMethodRegistry: () => methodRegistry,
+    });
+  return context;
+}
+
+export function settledChild(): SubagentRunRecord {
+  return {
+    runId: "settled-child",
+    childSessionKey: "agent:main:subagent:settled-child",
+    requesterSessionKey: REQUESTER_KEY,
+    requesterDisplayKey: "main",
+    requesterAgentId: "main",
+    task: "finish child work",
+    cleanup: "keep",
+    createdAt: 1_000,
+    execution: { status: "terminal", startedAt: 2_000, endedAt: 3_000, outcome: { status: "ok" } },
+    expectsCompletionMessage: true,
+    completion: { required: true, resultText: "child result", capturedAt: 3_000 },
+    delivery: { status: "delivered" },
+    requesterSettleWake: {
+      status: "pending",
+      attemptCount: 0,
+      requesterYieldBatch: true,
+      rearmGeneration: 1,
+    },
+  };
+}
+
+export function registerRequesterSettleSupersessionTests({
+  startTurn,
+  agentCommand,
+  deliver,
+  registryRead,
+}: {
+  startTurn: ReturnType<typeof vi.fn<ReturnType<typeof createAgentTurnService>["startTurn"]>>;
+  agentCommand: ReturnType<typeof vi.fn<typeof agentCommandFromGatewayIngress>>;
+  deliver: ReturnType<typeof vi.fn<typeof sendSubagentAnnounceDirectly>>;
+  registryRead: {
+    listSubagentRunsForRequester: ReturnType<typeof vi.fn<() => SubagentRunRecord[]>>;
+  };
+}): void {
+  it.each([
+    { owner: "run", wrapped: false, settled: true, superseded: true },
+    { owner: "run", wrapped: true, settled: true, superseded: true },
+    { owner: "gateway", wrapped: true, settled: true, superseded: true },
+    { owner: "run", wrapped: false, settled: false, superseded: true },
+    { owner: "run", wrapped: false, settled: true, superseded: true, inputCompletionFails: true },
+    { owner: "run", wrapped: false, settled: true, superseded: false },
+  ])(
+    "preserves requester settlement through the real Gateway producer ($owner, wrapped=$wrapped, persisted=$settled, input write fails=$inputCompletionFails, typed=$superseded)",
+    async ({ owner, wrapped, settled, superseded, inputCompletionFails }) => {
+      vi.useFakeTimers();
+      vi.setSystemTime(10_000);
+      const context = createContext();
+      const child = settledChild();
+      registryRead.listSubagentRunsForRequester.mockReturnValue([child]);
+      const abortController = new AbortController();
+      const abortError = superseded
+        ? createAgentRunSupersededAbortError()
+        : Object.assign(new Error("agent run superseded by a newer session writer"), {
+            name: "AbortError",
+          });
+      const rejection = wrapped ? new Error("run failed", { cause: abortError }) : abortError;
+      agentCommand.mockImplementationOnce(async () => {
+        if (owner === "gateway") {
+          abortController.abort(abortError);
+        }
+        throw rejection;
+      });
+      const onSettled = vi.fn<
+        NonNullable<Parameters<typeof dispatchAgentRunFromGateway>[0]["onSettled"]>
+      >(() => settled);
+      const completeProcessing = vi.fn<
+        NonNullable<UserTurnTranscriptRecorder["completeProcessing"]>
+      >((outcome) => {
+        if (inputCompletionFails) {
+          throw new Error("required input completion write failed");
+        }
+        return outcome;
+      });
+      startTurn.mockImplementation(async ({ preflight, io }) => {
+        const request = preflight.request;
+        io.emitAcceptance(
+          [true, { runId: request.idempotencyKey, status: "accepted" }, undefined],
+          {
+            runId: request.idempotencyKey,
+          },
+        );
+        io.emitExecutionStarted?.();
+        await dispatchAgentRunFromGateway({
+          ingressOpts: {
+            message: request.message,
+            sessionKey: request.sessionKey,
+            allowModelOverride: false,
+            abortSignal: abortController.signal,
+            userTurnTranscriptRecorder: {
+              ...createUserTurnTranscriptRecorder({ target: () => undefined }),
+              completeProcessing,
+            },
+          },
+          runId: request.idempotencyKey,
+          dedupeKeys: [`agent:${request.idempotencyKey}`],
+          abortController,
+          cleanupAbortController: vi.fn(),
+          io,
+          context,
+          taskTrackingMode: "none",
+          onSettled,
+        });
+      });
+      setSubagentAnnounceDeliveryDepsForTest({
+        getRuntimeConfig: () => ({}),
+        loadRequesterSessionEntry: () => ({
+          cfg: {},
+          canonicalKey: REQUESTER_KEY,
+          agentId: "main",
+          entry: { sessionId: "requester-session", updatedAt: 1 },
+        }),
+        getRequesterSessionActivity: () => ({ sessionId: "requester-session", isActive: false }),
+      });
+      deliver.mockImplementation(sendSubagentAnnounceDirectly);
+      const completeBatch = vi.fn(() => {
+        child.requesterSettleWake = undefined;
+      });
+      const wakeParams = {
+        requesterSessionKey: REQUESTER_KEY,
+        requesterOrigin: { channel: "discord", to: "channel:123" },
+        settledEntry: child,
+        transitionBatch: (
+          _batch: readonly SubagentRunRecord[],
+          state: RequesterSettleWakeBatchState,
+        ) => {
+          child.requesterSettleWake = state;
+        },
+        completeBatch,
+      };
+      await expect(
+        withPluginRuntimeGatewayRequestScope(
+          { context, client: createSyntheticPluginRuntimeClient(), isWebchatConnect: () => false },
+          () => maybeWakeRequesterAfterAllChildrenSettled(wakeParams),
+        ),
+      ).resolves.toBe(false);
+
+      if (superseded) {
+        expect(onSettled).toHaveBeenCalledWith(
+          expect.objectContaining({
+            terminalOutcome: expect.objectContaining({ reason: "superseded" }),
+          }),
+        );
+      }
+      if (superseded && settled && !inputCompletionFails) {
+        expect(completeBatch).toHaveBeenCalledExactlyOnceWith(
+          [child],
+          1,
+          expect.objectContaining({
+            delivered: false,
+            terminal: true,
+            disposition: "intentional_non_delivery",
+          }),
+        );
+        expect(child.requesterSettleWake).toBeUndefined();
+        await vi.advanceTimersByTimeAsync(30_001);
+        await expect(maybeWakeRequesterAfterAllChildrenSettled(wakeParams)).resolves.toBe(false);
+      } else {
+        // Failed required persistence and lookalike text must retain their failure path.
+        expect(completeBatch).not.toHaveBeenCalled();
+        expect(child.requesterSettleWake).toMatchObject({ status: "pending", attemptCount: 1 });
+      }
+      const getDedupeEntry = () => [...context.dedupe.values()][0];
+      expect(getDedupeEntry()?.ok).toBe(superseded && settled && !inputCompletionFails);
+      if (inputCompletionFails) {
+        onSettled.mock.calls[0]?.[0].onRecovered?.();
+        expect(getDedupeEntry()).toMatchObject({ ok: false, error: expect.any(Object) });
+      }
+      expect(startTurn).toHaveBeenCalledOnce();
+      expect(agentCommand).toHaveBeenCalledOnce();
+      expect(completeProcessing).toHaveBeenCalledOnce();
+    },
+  );
+}
+
+export function registerRequesterSettlePresentationTests({
+  startTurn,
+  deliver,
+  registryRead,
+}: {
+  startTurn: ReturnType<typeof vi.fn<ReturnType<typeof createAgentTurnService>["startTurn"]>>;
+  deliver: ReturnType<typeof vi.fn<typeof sendSubagentAnnounceDirectly>>;
+  registryRead: {
+    listSubagentRunsForRequester: ReturnType<typeof vi.fn<() => SubagentRunRecord[]>>;
+    getLatestLiveSubagentRunByChildSessionKey: ReturnType<
+      typeof vi.fn<() => SubagentRunRecord | undefined>
+    >;
+  };
+}): void {
+  it.each([
+    { agentId: "main", requesterSessionKey: REQUESTER_KEY, scoped: false },
+    {
+      agentId: "company",
+      requesterSessionKey: "agent:company:discord:channel:123",
+      scoped: true,
+    },
+  ])(
+    "delivers the yielded $agentId requester's visible final with MCP scope=$scoped while retaining adoption and revocation guards",
+    async ({ agentId, requesterSessionKey, scoped }) => {
+      const context = createContext();
+      const child = settledChild();
+      child.requesterSessionKey = requesterSessionKey;
+      child.requesterAgentId = agentId;
+      child.childSessionKey = `agent:${agentId}:subagent:settled-child`;
+      if (scoped) {
+        child.requesterMcpScope = {
+          requesterSenderId: "test-sender",
+          agentAccountId: "company",
+          messageChannel: "discord",
+        };
+      }
+      child.completionTarget = "parent";
+      child.completionRequesterSessionId = "requester-session";
+      registryRead.listSubagentRunsForRequester.mockReturnValue([child]);
+      const pausedRequester = {
+        ...settledChild(),
+        runId: "requester-run",
+        taskRunId: "task-owner",
+        childSessionKey: requesterSessionKey,
+        pauseReason: "sessions_yield" as const,
+      };
+      registryRead.getLatestLiveSubagentRunByChildSessionKey.mockReturnValue(pausedRequester);
+      const source = {
+        channel: "discord",
+        to: "channel:123",
+        accountId: "company",
+        threadId: "456",
+      };
+      let presentation: RequesterPresentation | undefined;
+      const active = createDeferredCore();
+      const finish = createDeferredCore();
+      startTurn.mockImplementation(
+        async ({ preflight, io, requesterPresentation, privateCompletion }) => {
+          presentation = requesterPresentation;
+          const request = preflight.request;
+          expect(request).toMatchObject({
+            deliver: true,
+            expectedExistingSessionId: "requester-session",
+            ...source,
+            sourceReplyDeliveryMode: "automatic",
+          });
+          expect(request.message).toContain("requires your visible final answer");
+          expect(request.message).not.toContain("Your final reply stays internal");
+          expect(privateCompletion).not.toBe(true);
+          expect(request).not.toHaveProperty("requesterPresentation"); // never a wire field
+          expect(presentation?.source).toEqual(source);
+          presentation?.assertCurrent();
+          io.emitAcceptance(
+            [true, { runId: request.idempotencyKey, status: "accepted" }, undefined],
+            {
+              runId: request.idempotencyKey,
+            },
+          );
+          // The admitted continuation adopts the paused requester task before model execution.
+          registryRead.getLatestLiveSubagentRunByChildSessionKey.mockReturnValue({
+            ...pausedRequester,
+            runId: request.idempotencyKey,
+            generation: 2,
+            createdAt: 4_000,
+            pauseReason: undefined,
+          });
+          io.emitExecutionStarted?.();
+          presentation?.assertCurrent();
+          active.resolve();
+          await finish.promise;
+          presentation?.assertCurrent();
+          io.emitFinal([
+            true,
+            {
+              status: "ok",
+              inputProcessingCompleted: true,
+              result: {
+                payloads: [{ text: "Reviewed requester answer" }],
+                deliveryStatus: { status: "sent", resultCount: 1 },
+              },
+            },
+            undefined,
+          ]);
+        },
+      );
+      setSubagentAnnounceDeliveryDepsForTest({
+        getRuntimeConfig: () => ({}),
+        loadRequesterSessionEntry: () => ({
+          cfg: {},
+          canonicalKey: requesterSessionKey,
+          agentId,
+          entry: { sessionId: "requester-session", updatedAt: 1 },
+        }),
+        getRequesterSessionActivity: () => ({ sessionId: "requester-session", isActive: false }),
+      });
+      deliver.mockImplementation(sendSubagentAnnounceDirectly);
+      const completeBatch = vi.fn(() => {
+        child.requesterSettleWake = undefined;
+      });
+      const wake = withPluginRuntimeGatewayRequestScope(
+        { context, client: createSyntheticPluginRuntimeClient(), isWebchatConnect: () => false },
+        () =>
+          maybeWakeRequesterAfterAllChildrenSettled({
+            requesterSessionKey,
+            requesterOrigin: source,
+            settledEntry: child,
+            transitionBatch: (_batch, state) => {
+              child.requesterSettleWake = state;
+            },
+            completeBatch,
+          }),
+      );
+      try {
+        // A refused wake must settle this race rather than leave the test waiting for a turn.
+        const admitted = await Promise.race([
+          active.promise.then(() => true),
+          wake.then(() => false),
+        ]);
+        expect(admitted).toBe(true);
+        const deliveredRequest = deliver.mock.calls[0]?.[0];
+        expect(deliveredRequest?.requesterAgentId).toBe(agentId);
+        expect(deliveredRequest?.targetRequesterSessionKey).toBe(requesterSessionKey);
+        if (scoped) {
+          expect(deliveredRequest?.mcpRequesterScope).toEqual(child.requesterMcpScope);
+          expect(() => deliveredRequest?.mcpRequesterScopeAssertCurrent?.()).not.toThrow();
+          child.requesterMcpScope!.requesterSenderId = "replacement-sender";
+          expect(() => deliveredRequest?.mcpRequesterScopeAssertCurrent?.()).toThrow();
+          child.requesterMcpScope!.requesterSenderId = "test-sender";
+        }
+        expect(presentation).toBeDefined();
+        expect(() => presentation!.assertCurrent()).not.toThrow();
+        child.suppressCompletionDelivery = true;
+        expect(() => presentation!.assertCurrent()).toThrow("owner changed");
+        child.suppressCompletionDelivery = undefined;
+        expect(() => presentation!.assertCurrent()).not.toThrow();
+        finish.resolve();
+        await expect(wake).resolves.toBe(true);
+        expect(completeBatch).toHaveBeenCalledExactlyOnceWith(
+          [child],
+          1,
+          expect.objectContaining({ delivered: true, requesterVisibleFinalDelivered: true }),
+        );
+        expect(() => presentation!.assertCurrent()).toThrow("owner changed");
+      } finally {
+        finish.resolve();
+        await wake;
+      }
+    },
+  );
+}

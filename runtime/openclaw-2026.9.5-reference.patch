+/** A recovery transcript remains owned until its exact children's private receipts settle. */
+export function hasUnsettledPrivateChildReceipt(
+  runs: ReadonlyMap<string, SubagentRunRecord>,
+  owner: SubagentRunRecord,
+): boolean {
+  const target = owner.execution.transcriptTarget;
+  return Boolean(
+    !owner.killIntent &&
+    !owner.killReconciliation &&
+    !owner.execution.suppressSessionEffects &&
+    target?.sessionKey &&
+    isInternalSessionEffectsKey(target.sessionKey) &&
+    [...runs.values()].some(
+      (child) =>
+        child.requesterSessionKey === target.sessionKey &&
+        child.completionRequesterSessionId === target.sessionId &&
+        child.completionTarget === "parent" &&
+        child.delivery?.status !== "delivered" &&
+        child.cleanupCompletedAt === undefined &&
+        !child.suppressCompletionDelivery &&
+        !child.execution.suppressSessionEffects &&
+        !child.killIntent &&
+        !child.killReconciliation,
+    ),
+  );
+}
+
+/** Resolve only the private incarnation recorded by the completed child's owner. */
+export function findPrivateSubagentParent(
+  runs: ReadonlyMap<string, SubagentRunRecord>,
+  child: SubagentRunRecord,
+): SubagentRunRecord | undefined {
+  if (
+    !isInternalSessionEffectsKey(child.requesterSessionKey) ||
+    !child.completionRequesterSessionId
+  ) {
+    return undefined;
+  }
+  const owners = [...runs.values()].filter(
+    (owner) =>
+      owner.execution.transcriptTarget?.sessionKey === child.requesterSessionKey &&
+      owner.execution.transcriptTarget.sessionId === child.completionRequesterSessionId &&
+      owner.cleanupCompletedAt === undefined,
+  );
+  return owners.length === 1 ? owners[0] : undefined;
+}

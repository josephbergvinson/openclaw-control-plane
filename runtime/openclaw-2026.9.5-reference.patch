+      // Native keyed admission adopts the still-current human instead of reopening history.
+      expect(manager.appendMessage(opinion)).toBe("foreground-opinion");
+      expect(await loadTranscriptEvents(scope)).toEqual(admittedTranscript);
+      // Waiting foreground custody does not exhaust the ordinary stale-deferral budget.
+      for (let retry = 0; retry < 12; retry += 1) {
+        await vi.advanceTimersByTimeAsync(30_000);
+        await expect(scoped(f.wake)).resolves.toBe(false);
+        expect(f.child.requesterSettleWake).toMatchObject({ attemptCount: 0, deferralCount: 0 });
+      }
+      expect(f.completeBatch).not.toHaveBeenCalled();
+      expect(await loadTranscriptEvents(scope)).toEqual(admittedTranscript);
+      foreground.complete();
+      await vi.advanceTimersByTimeAsync(30_000);
+      await expect(scoped(f.wake)).resolves.toBe(true);
+      expect(deliver).toHaveBeenCalledOnce();
+      expect(deliver.mock.calls[0]?.[0].directIdempotencyKey).toBe(expectedKey);
+      expect(startTurn).toHaveBeenCalledOnce();
+      expect(f.completeBatch).toHaveBeenCalledOnce();
+      expect(await loadTranscriptEvents(scope)).toHaveLength(admittedTranscript.length + 1);
+      expect(() => manager.appendMessage(opinion)).toThrow(
+        "Session transcript keyed user is outside the current turn",
+      );
+      expect(await loadTranscriptEvents(scope)).toHaveLength(admittedTranscript.length + 1);
+    } finally {
+      foreground.complete();
+    }
+  });
+
+  it("defers without an attempt when foreground custody arrives during real findings preparation", async () => {
+    vi.useFakeTimers();
+    vi.setSystemTime(10_000);
+    const f = fixture();
+    // The actual findings owner has yielded before this reservation is registered.
+    const wake = f.wake();
+    const foreground = reserveForeground();
+    try {
+      await expect(wake).resolves.toBe(false);
+      expect(deliver).not.toHaveBeenCalled();
+      expect(f.completeBatch).not.toHaveBeenCalled();
+      expect(f.child.requesterSettleWake).toMatchObject({
+        status: "pending",
+        attemptCount: 0,
+        deferralCount: 0,
+        nextAttemptAt: 40_000,
+      });
+    } finally {
+      foreground.complete();
+      await wake;
+    }
+  });
+
+  it.each([
+    { boundary: "maintenance", status: "pending", attemptCount: 0 },
+    { boundary: "gateway-preaccept", status: "pending", attemptCount: 0 },
+    { boundary: "maintenance", status: "dispatching", attemptCount: 1 },
+    { boundary: "gateway-preaccept", status: "dispatching", attemptCount: 1 },
+  ] as const)(
+    "restores the same zero-spend $status outbox during $boundary",
+    async ({ boundary, status, attemptCount }) => {
+      vi.useFakeTimers();
+      vi.setSystemTime(10_000);
+      const context = createContext();

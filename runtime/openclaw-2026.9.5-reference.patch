@@ -0,0 +1,237 @@
+import { expectDefined } from "@openclaw/normalization-core";
+import { ChannelType } from "discord-api-types/v10";
+import { beforeEach, describe, expect, it, vi, type Mock } from "vitest";
+import { handleDiscordMessageAction } from "./handle-action.js";
+import { discordAllowlistCfg } from "./runtime-action-context.test-support.js";
+
+type VoiceStateTestMocks = {
+  fetchChannelInfoDiscord: Mock<
+    (channelId: string) => Promise<{
+      id: string;
+      type: number;
+      guild_id?: string;
+      name?: string;
+      parent_id?: string;
+    }>
+  >;
+  fetchVoiceStatusDiscord: Mock<() => Promise<Record<string, unknown>>>;
+  fetchMemberInfoDiscord: unknown;
+  fetchRoleInfoDiscord: unknown;
+  listGuildEmojisDiscord: unknown;
+  listScheduledEventsDiscord: unknown;
+  listGuildChannelsDiscord: unknown;
+};
+
+export function registerRequesterVoiceStateTests({
+  fetchChannelInfoDiscord,
+  fetchVoiceStatusDiscord,
+  fetchMemberInfoDiscord,
+  fetchRoleInfoDiscord,
+  listGuildEmojisDiscord,
+  listScheduledEventsDiscord,
+  listGuildChannelsDiscord,
+}: VoiceStateTestMocks) {
+  describe("authenticated requester voice-state lookup", () => {
+    type ActionContext = Parameters<typeof handleDiscordMessageAction>[0];
+
+    function requesterContext(overrides: Partial<ActionContext> = {}): ActionContext {
+      return {
+        action: "voice-status",
+        params: { guildId: "111", userId: "333" },
+        cfg: discordAllowlistCfg({ "111": { channels: { "222": { enabled: true } } } }),
+        accountId: "default",
+        requesterAccountId: "default",
+        requesterSenderId: "333",
+        senderIsOwner: true,
+        toolContext: { currentChannelProvider: "discord", currentChannelId: "222" },
+        assertDirectAdapterHandoff: vi.fn(),
+        ...overrides,
+      };
+    }
+
+    beforeEach(() => {
+      fetchChannelInfoDiscord.mockImplementation(async (id) => ({
+        id,
+        guild_id: "111",
+        type: ChannelType.GuildText,
+      }));
+    });
+
+    it.each([true, false, undefined])(
+      "lets the authenticated requester find their own room with owner=%s",
+      async (senderIsOwner) => {
+        const ctx = requesterContext({ senderIsOwner });
+        fetchVoiceStatusDiscord.mockResolvedValueOnce({ channel_id: "444", user_id: "333" });
+
+        const result = await handleDiscordMessageAction(ctx);
+
+        expect(result.details).toEqual({ ok: true, voice: { channel_id: "444", user_id: "333" } });
+        expect(fetchVoiceStatusDiscord).toHaveBeenCalledWith("111", "333", {
+          cfg: ctx.cfg,
+          accountId: "default",
+        });
+        expect(fetchChannelInfoDiscord).toHaveBeenCalledWith("222", {
+          cfg: ctx.cfg,
+          accountId: "default",
+        });
+        expect(ctx.assertDirectAdapterHandoff).toHaveBeenCalled();
+      },
+    );
+
+    it.each([
+      ["missing sender", { requesterSenderId: undefined }],
+      ["missing handoff", { assertDirectAdapterHandoff: undefined }],
+      ["missing origin", { toolContext: undefined }],
+      [
+        "foreign provider",
+        { toolContext: { currentChannelProvider: "slack", currentChannelId: "222" } },
+      ],
+      ["other user", { params: { guildId: "111", userId: "999" } }],
+      ["other bot account", { accountId: "secondary" }],
+      ["missing originating account", { requesterAccountId: undefined }],
+    ] satisfies Array<[string, Partial<ActionContext>]>)(
+      "does not broaden voice lookup for %s",
+      async (_label, overrides) => {
+        await expect(handleDiscordMessageAction(requesterContext(overrides))).rejects.toThrow(
+          "Discord guild metadata reads require a wildcard channel allowlist",
+        );
+        expect(fetchVoiceStatusDiscord).not.toHaveBeenCalled();
+      },
+    );
+
+    it("ignores owner, sender, origin and handoff claims in model parameters", async () => {
+      await expect(
+        handleDiscordMessageAction(
+          requesterContext({
+            senderIsOwner: false,
+            requesterSenderId: "999",
+            params: {
+              guildId: "111",
+              userId: "333",
+              senderIsOwner: true,
+              requesterSenderId: "333",
+              readContext: {
+                requesterSenderId: "333",
+                senderIsOwner: true,
+                currentChannelId: "222",
+              },
+              assertDirectAdapterHandoff: () => {},
+            },
+          }),
+        ),
+      ).rejects.toThrow("Discord guild metadata reads require a wildcard channel allowlist");
+      expect(fetchVoiceStatusDiscord).not.toHaveBeenCalled();
+    });
+
+    it("does not borrow the origin for another configured guild", async () => {
+      await expect(
+        handleDiscordMessageAction(
+          requesterContext({
+            cfg: discordAllowlistCfg({
+              "111": { channels: { "222": { enabled: true } } },
+              "555": { channels: { "666": { enabled: true } } },
+            }),
+            params: { guildId: "555", userId: "333" },
+          }),
+        ),
+      ).rejects.toThrow("Discord guild metadata reads require a wildcard channel allowlist");
+      expect(fetchVoiceStatusDiscord).not.toHaveBeenCalled();
+    });
+
+    it("fails closed when origin channel metadata is unavailable", async () => {
+      fetchChannelInfoDiscord.mockRejectedValueOnce(new Error("not available"));
+      await expect(handleDiscordMessageAction(requesterContext())).rejects.toThrow(
+        "Discord guild metadata reads require a wildcard channel allowlist",
+      );
+      expect(fetchVoiceStatusDiscord).not.toHaveBeenCalled();
+    });
+
+    it.each([
+      "origin channel",
+      "ancestor",
+      "account",
+      "group",
+      "action",
+      "removed channel",
+      "removed guild",
+    ])("honors an explicitly disabled %s", async (disabledScope) => {
+      const ctx = requesterContext();
+      const discord = expectDefined(
+        ctx.cfg.channels?.discord,
+        "Discord requester voice test configuration",
+      );
+      if (disabledScope === "origin channel") {
+        discord.guilds = { "111": { channels: { "222": { enabled: false } } } };
+      } else if (disabledScope === "ancestor") {
+        discord.guilds = {
+          "111": { channels: { "222": { enabled: true }, "777": { enabled: false } } },
+        };
+        fetchChannelInfoDiscord.mockImplementation(async (id) => ({
+          id,
+          guild_id: "111",
+          type: ChannelType.GuildText,
+          ...(id === "222" ? { parent_id: "777" } : {}),
+        }));
+      } else if (disabledScope === "account") {
+        discord.enabled = false;
+      } else if (disabledScope === "group") {
+        discord.groupPolicy = "disabled";
+      } else if (disabledScope === "removed channel") {
+        discord.guilds = { "111": { channels: { "777": { enabled: true } } } };
+      } else if (disabledScope === "removed guild") {
+        discord.guilds = {};
+      } else {
+        discord.actions = { voiceStatus: false };
+      }
+      await expect(handleDiscordMessageAction(ctx)).rejects.toThrow();
+      expect(fetchVoiceStatusDiscord).not.toHaveBeenCalled();
+    });
+
+    it("rechecks current authorization after resolving the origin channel", async () => {
+      let policyCurrent = true;
+      const ctx = requesterContext({
+        assertDirectAdapterHandoff: () => {
+          if (!policyCurrent) {
+            throw new Error("request policy changed");
+          }
+        },
+      });
+      fetchChannelInfoDiscord.mockImplementationOnce(async (id) => {
+        policyCurrent = false;
+        return { id, guild_id: "111", type: ChannelType.GuildText };
+      });
+      await expect(handleDiscordMessageAction(ctx)).rejects.toThrow("request policy changed");
+      expect(fetchVoiceStatusDiscord).not.toHaveBeenCalled();
+    });
+
+    it("does not release voice state if authorization changes during the REST read", async () => {
+      let policyCurrent = true;
+      const ctx = requesterContext({
+        assertDirectAdapterHandoff: () => {
+          if (!policyCurrent) {
+            throw new Error("request policy changed");
+          }
+        },
+      });
+      fetchVoiceStatusDiscord.mockImplementationOnce(async () => {
+        policyCurrent = false;
+        return { channel_id: "444", user_id: "333" };
+      });
+      await expect(handleDiscordMessageAction(ctx)).rejects.toThrow("request policy changed");
+      expect(fetchVoiceStatusDiscord).toHaveBeenCalledTimes(1);
+    });
+
+    it.each([
+      ["member-info", fetchMemberInfoDiscord],
+      ["role-info", fetchRoleInfoDiscord],
+      ["emoji-list", listGuildEmojisDiscord],
+      ["event-list", listScheduledEventsDiscord],
+      ["channel-list", listGuildChannelsDiscord],
+    ] as const)("retains the existing metadata guard for %s", async (action, runtimeCall) => {
+      await expect(handleDiscordMessageAction(requesterContext({ action }))).rejects.toThrow(
+        "Discord guild metadata reads require a wildcard channel allowlist",
+      );
+      expect(runtimeCall).not.toHaveBeenCalled();
+    });
+  });
+}

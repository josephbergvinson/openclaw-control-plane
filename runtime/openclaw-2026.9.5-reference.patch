+import { expect, it } from "vitest";
+import { makeUserMessage } from "../../test/helpers/user-message.js";
+import {
+  assertMemoryExtractionRequestFits,
+  MemoryExtractionBudgetError,
+} from "./memory-extraction-budget.js";
+import {
+  createCompactionRequestBudget,
+  estimateCompactedRequestTokens,
+} from "./sessions/compaction/request-budget.js";
+
+it("counts prepared system, tools, and pending memory prompt before dispatch", () => {
+  const messages = [makeUserMessage("original memory", 1)];
+  const budget = createCompactionRequestBudget({
+    contextWindow: 1000,
+    reserveTokens: 100,
+    systemPrompt: "system ".repeat(100),
+    tools: [{ name: "read", description: "tool ".repeat(100), parameters: { type: "object" } }],
+    pendingPrompt: "memory ".repeat(100),
+  });
+  const measured = estimateCompactedRequestTokens(messages, budget);
+  expect(() =>
+    assertMemoryExtractionRequestFits(messages, { ...budget, contextWindow: measured + 100 }),
+  ).not.toThrow();
+  expect(() =>
+    assertMemoryExtractionRequestFits(messages, { ...budget, contextWindow: measured + 99 }),
+  ).toThrow(MemoryExtractionBudgetError);
+});
+
+it("rejects actual later tool growth rather than checking only the original segment", () => {
+  const original = [makeUserMessage("original memory", 1)];
+  const budget = createCompactionRequestBudget({
+    contextWindow: 1000,
+    reserveTokens: 100,
+    systemPrompt: "prepared system",
+  });
+  expect(() => assertMemoryExtractionRequestFits(original, budget)).not.toThrow();
+  const grown = [...original, makeUserMessage("late evidence ".repeat(1000), 2)];
+  expect(() => assertMemoryExtractionRequestFits(grown, budget)).toThrow(
+    MemoryExtractionBudgetError,
+  );
+});

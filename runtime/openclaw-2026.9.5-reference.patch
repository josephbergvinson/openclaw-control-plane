+  plugin: vi.fn(),
+  preflight: vi.fn(),
+  typing: vi.fn(),
+}));
+vi.mock("../../channels/plugins/index.js", () => ({ getChannelPlugin: mocks.plugin }));
+vi.mock("./session-helpers.js", () => ({ prepareCurrentRunDelivery: mocks.preflight }));

+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { createSecretsTool } from "../../agents/tools/secrets-tool.js";
+import { isConfiguredCommandOwner } from "../../auto-reply/command-auth.js";
+import { releaseAgentRunDelegatedAuthority } from "../../infra/agent-run-registry.js";
+import { clearSecretsRuntimeSnapshot } from "../../secrets/runtime.js";
+import {
+  listSecretStoreEntries,
+  readSecretStoreValue,
+  writeSecretStoreEntry,
+} from "../../secrets/store/secret-store.js";
+import { withOpenClawTestState } from "../../test-utils/openclaw-test-state.js";
+import { revokeMessageActionTurnCapability } from "../message-action-turn-capability.js";
+import { createProvidedInputStore } from "./secrets.provided-input.test-support.js";
+
+const providerRead = vi.hoisted(() => vi.fn());
+vi.mock("../../infra/outbound/message-action-runner.js", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("../../infra/outbound/message-action-runner.js")>()),
+  runMessageAction: (...args: unknown[]) => providerRead(...args),
+}));
+
+const scope = { kind: "team" } as const;
+const name = "SUPPLIED_INPUT_TEST";
+const config = { commands: { ownerAllowFrom: ["provided-owner"] } };
+const originalMessage = (content: string) => ({
+  id: "provided-message",
+  content,
+  author: { id: "provided-owner", bot: false },
+  edited_timestamp: null,
+});
+const payload = (message: Record<string, unknown>) => ({
+  payload: { ok: true, channelId: "provided-channel", messages: [message] },
+});
+
+beforeEach(() => {
+  providerRead.mockReset();
+});
+afterEach(() => {
+  clearSecretsRuntimeSnapshot();
+  vi.restoreAllMocks();
+});
+
+describe("native provided-input secret import", () => {
+  it.each([
+    { body: "TOKEN: alpha beta", selector: { field: "TOKEN" }, value: "alpha beta" },
+    { body: 'TOKEN: "alpha beta!;"', selector: { field: "TOKEN" }, value: "alpha beta!;" },
+    {
+      body: "username: dummy-user\npassword: a b!;",
+      selector: { field: "password" },
+      value: "a b!;",
+    },
+    { body: "  alpha beta!;  ", selector: { line: 1 }, value: "  alpha beta!;  " },
+    {
+      body: "My opaque code is dummy-value!; moving forward. Please retain it.",
+      selector: { prefix: "My opaque code is ", suffix: " moving forward." },
+      value: "dummy-value!;",
+    },
+    {
+      body: "Use [alpha beta!] for the requested task.",
+      selector: { prefix: "Use [", suffix: "] for the requested task." },
+      value: "alpha beta!",
+    },
+  ])(
+    "writes exact selected bytes with only metadata in the tool RPC ($selector)",
+    async ({ body, selector, value }) => {
+      await withOpenClawTestState({ scenario: "minimal" }, async () => {
+        const store = createProvidedInputStore({
+          source: { kind: "dashboard", readText: () => body, assertCurrent: () => {} },
+        });
+        try {
+          const tool = createSecretsTool({ gatewayCall: store.gatewayCall });
+          const args = { action: "import", name, ...selector };
+          const result = await tool.execute("provided-input", args);
+          expect(readSecretStoreValue({ scope, name })).toEqual({ ok: true, value });
+          expect(result.details).toMatchObject({
+            status: "stored",
+            name,
+            kind: "secret",
+            currentPolicy: { status: "available", allowedHosts: [] },
+          });
+          expect(store.requests[0]).toEqual({
+            method: "secrets.store.set",
+            params: { name, kind: "secret", source: { kind: "current-user-message", ...selector } },
+          });
+          expect(store.requests.map((request) => request.method)).toEqual([
+            "secrets.store.set",
+            "secrets.store.list",
+          ]);
+          expect(JSON.stringify(result)).not.toContain(value);
+          expect(JSON.stringify(store.requests)).not.toContain(value);
+          expect(providerRead).not.toHaveBeenCalled();
+        } finally {
+          store.close();
+        }
+      });
+    },
+  );
+
+  it.each([
+    { body: "TOKEN: one\nTOKEN: two", selector: { field: "TOKEN" } },
+    {
+      body: "prefix(one) suffix prefix(two) suffix",
+      selector: { prefix: "prefix(", suffix: ") suffix" },
+    },

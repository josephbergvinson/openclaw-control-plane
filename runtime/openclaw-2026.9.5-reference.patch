+} from "./codex-retained-steering.test-support.js";
+
+describe("retained steering custody after preparation", () => {
+  afterEach(() => {
+    embeddedTesting.resetActiveEmbeddedRuns();
+    vi.restoreAllMocks();
+  });
+
+  it.each(["media", "custody", "debounce"] as const)(
+    "retains the source when the catalog changes during Codex %s preparation",
+    async (stage) => {
+      const key = `agent:main:retained-catalog-final-${stage}`;
+      const current = createQueueTestRun({ prompt: "existing work", messageId: "current" });
+      const a = { ...current, prompt: "original requester input", messageId: "A" };
+      const followup = vi.fn(async (_run: FollowupRun) => undefined);
+      await withQuestionCreator(key, current, async (operation, fingerprint) => {
+        operation.setPhase("running");
+        const finishCurrent = holdAdoptedSource(key, current, operation, followup);
+        bindRetainedSource(key, a, operation, fingerprint, followup);
+        enqueueFollowupRun(key, a, { mode: "steer", debounceMs: 0 }, "message-id", followup, false);
+        const entered = createDeferred();
+        const release = createDeferred();
+        let catalogCurrent = true;
+        const wire = vi.fn(async () => ({}));
+        const queue = createRetainedCodexSteeringQueue({
+          client: { request: wire },
+          threadId: "native-thread",
+          turnId: "native-turn",
+          requestTimeoutMs: 1_000,
+          signal: operation.abortSignal,
+          assertActive: () => {
+            if (!catalogCurrent) {
+              throw new Error("codex app-server steering catalog is no longer current");
+            }
+          },
+          prepareMessage: async (text) => {
+            if (stage === "media") {
+              entered.resolve();
+              await release.promise;
+            }
+            return {
+              input: [{ type: "text", text, text_elements: [] }],
+              context: [],
+              message: { role: "user", content: [{ type: "text", text }], timestamp: 1 },
+            };
+          },
+          beforeSubmit: async () => {
+            if (stage === "custody") {
+              entered.resolve();
+              await release.promise;
+            }
+          },
+        });
+        const handle = {
+          ...createEmbeddedRunHandle({
+            runId: "accepted-backing-work",
+            toolAuthorityFingerprint: fingerprint,
+          }),
+          kind: "embedded" as const,
+          cancel: vi.fn(),
+          isSteeringCatalogCurrent: () => catalogCurrent,
+          messageInjectionV2: {
+            version: 2 as const,
+            isAvailable: () => catalogCurrent,
+            queueMessage: async (
+              text: string,
+              options: Parameters<
+                NonNullable<ReplyBackendHandle["messageInjectionV2"]>["queueMessage"]
+              >[1],
+              assertCurrent: () => void,
+            ) => {
+              const queued = queue.queue(
+                text,
+                { ...options, debounceMs: stage === "debounce" ? 5 : 0 },
+                assertCurrent,
+              );
+              if (stage === "debounce") {
+                catalogCurrent = false;
+              }
+              await queued;
+            },
+          },
+        };
+        operation.attachBackend(handle);
+        setActiveEmbeddedRun(operation.sessionId, handle, key, current.run.sessionFile, "main");
+        const retry = retryRetainedFollowupSteers(operation);
+        try {
+          if (stage !== "debounce") {
+            await withTestTimeout(entered.promise, 1_000, "steer preparation was not entered");
+            catalogCurrent = false;
+            release.resolve();
+          }
+          await retry;
+          expect(wire).not.toHaveBeenCalled();
+          expect(getExistingFollowupQueue(key)?.items).toEqual([current, a]);
+          expect(a.steerPending).toBeUndefined();
+          operation.complete();
+          finishCurrent();
+          scheduleFollowupDrain(key, followup);
+          await vi.waitFor(() => expect(followup).toHaveBeenCalledOnce());
+          expect(followup).toHaveBeenCalledWith(a);
+        } finally {
+          release.resolve();
+          await retry;
+          queue.cancel();
+          clearSessionQueues([key]);
+        }
+      });
+    },
+  );
+
+  it("retires a terminal refused source instead of replaying it after clear", async () => {
+    const key = "agent:main:retained-terminal-authority";
+    const current = createQueueTestRun({ prompt: "existing work", messageId: "current" });
+    const adopted = vi.fn();
+    const abandoned = vi.fn();
+    const settled = vi.fn();
+    const a = {
+      ...current,
+      prompt: "refused requester input",
+      messageId: "A",
+      turnAdoptionLifecycle: { onAdopted: adopted, onAbandoned: abandoned, onSettled: settled },
+    };
+    const followup = vi.fn(async (_run: FollowupRun) => undefined);
+    await withQuestionCreator(key, current, async (operation, fingerprint) => {
+      operation.setPhase("running");
+      const finishCurrent = holdAdoptedSource(key, current, operation, followup);
+      bindRetainedSource(key, a, operation, fingerprint, followup);
+      enqueueFollowupRun(key, a, { mode: "steer", debounceMs: 0 }, "message-id", followup, false);
+      const handle = {
+        ...createEmbeddedRunHandle({
+          runId: "accepted-backing-work",
+          toolAuthorityFingerprint: fingerprint,
+        }),
+        kind: "embedded" as const,
+        cancel: vi.fn(),
+        isSteeringCatalogCurrent: () => true,
+        messageInjectionV2: {
+          version: 2 as const,
+          isAvailable: () => true,
+          queueMessage: async () => {
+            throw new MessageInjectionAuthorityError();
+          },
+        },
+      };
+      operation.attachBackend(handle);
+      setActiveEmbeddedRun(operation.sessionId, handle, key, current.run.sessionFile, "main");
+      await expect(retryRetainedFollowupSteers(operation)).rejects.toBeInstanceOf(
+        MessageInjectionAuthorityError,
+      );
+      expect(adopted).not.toHaveBeenCalled();
+      expect(abandoned).toHaveBeenCalledOnce();
+      expect(settled).toHaveBeenCalledOnce();
+      expect(getExistingFollowupQueue(key)?.items).toEqual([current]);
+      operation.complete();
+      finishCurrent();
+      scheduleFollowupDrain(key, followup);
+      await Promise.resolve();
+      expect(followup).not.toHaveBeenCalled();
+      expect(handle.cancel).not.toHaveBeenCalled();
+      clearSessionQueues([key]);
+    });
+  });
+
+  it("keeps accepted-unconfirmed custody and delivers through the original source once", async () => {
+    const key = "agent:main:retained-indeterminate";
+    const current = createQueueTestRun({ prompt: "existing work", messageId: "current" });
+    const adopted = vi.fn(async () => {
+      throw new Error("adoption receipt unavailable");
+    });
+    const abandoned = vi.fn();
+    const a = {
+      ...current,
+      prompt: "possibly committed requester input",
+      messageId: "A",
+      turnAdoptionLifecycle: { onAdopted: adopted, onAbandoned: abandoned },
+    };
+    const followup = vi.fn(async (_run: FollowupRun) => undefined);
+    await withQuestionCreator(key, current, async (operation, fingerprint) => {
+      operation.setPhase("running");
+      const finishCurrent = holdAdoptedSource(key, current, operation, followup);
+      bindRetainedSource(key, a, operation, fingerprint, followup);
+      const disposition = a.queuedFollowupReplyDisposition;
+      if (disposition?.kind !== "deliver") {
+        throw new Error("original delivery owner missing");
+      }
+      enqueueFollowupRun(key, a, { mode: "steer", debounceMs: 0 }, "message-id", followup, false);
+      const queueMessage = vi.fn(async () => {
+        throw new QuestionAnswerUnconfirmedError(new Error("confirmation unavailable"));
+      });
+      const handle = {
+        ...createEmbeddedRunHandle({
+          runId: "accepted-backing-work",
+          toolAuthorityFingerprint: fingerprint,
+        }),
+        kind: "embedded" as const,
+        cancel: vi.fn(),
+        isSteeringCatalogCurrent: () => true,
+        messageInjectionV2: { version: 2 as const, isAvailable: () => true, queueMessage },
+      };
+      operation.attachBackend(handle);
+      setActiveEmbeddedRun(operation.sessionId, handle, key, current.run.sessionFile, "main");
+      await retryRetainedFollowupSteers(operation);
+      await retryRetainedFollowupSteers(operation);
+      expect(queueMessage).toHaveBeenCalledOnce();
+      expect(adopted).toHaveBeenCalledOnce();
+      expect(abandoned).not.toHaveBeenCalled();
+      expect(disposition.deliver).toHaveBeenCalledOnce();
+      expect(disposition.deliver).toHaveBeenCalledWith(
+        expect.objectContaining({
+          kind: "queued-followup",
+          runId: "A",
+          completion: expect.objectContaining({ kind: "failed" }),
+          payloads: [expect.objectContaining({ isError: true })],

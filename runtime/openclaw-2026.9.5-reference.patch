+            // A dispatched acknowledgement remains factual even if its author was revoked.
+            // Reacquisition drains this callback before advancing the epoch.
+            const current = await store.observe!(key);
+            if (current.value?.epoch !== epoch) {
+              throw new Error("Discord progress receipt epoch changed");
+            }
+            const result = await store.compareAndApply!(key, current.comparison, {
+              operation: "update",
+              action: "set",
+              value: { scope, epoch, closed: closed || current.value.closed, draft },
+              ...((closed || current.value.closed) && resolvedDraft(draft)
+                ? { ttlMs: TERMINAL_RETENTION_MS }
+                : {}),
+            });
+            if (result.status === "conflict") {
+              throw new Error("Discord progress receipt changed");
+            }
+          };
+          closeReceipt = async (factualOnly = false) => {
+            if (!factualOnly) {
+              assertScopeCurrent();
+            }
+            const current = await store.observe!(key);
+            if (!factualOnly) {
+              assertScopeCurrent();
+            }
+            if (current.value?.epoch !== epoch) {
+              throw new Error("Discord progress receipt epoch changed");
+            }
+            await persist(current.value.draft, true);
+          };
+          const nextLease: Lease = {
+            revoked: false,
+            // The draft constructor installs callbacks; it dispatches only after this lease is assigned.
+            stream: createDiscordDraftStream({
+              ...params,
+              initialSnapshot: prior.draft,
+              assertCurrent: () => {
+                params.assertCurrent?.();
+                resolved.assertCurrent?.();
+                if (generation !== localGeneration) {
+                  throw new Error("Discord progress request generation changed");
+                }
+                if (released || nextLease.revoked || activeWriter.lease !== nextLease) {
+                  throw new Error("Discord progress writer changed");
+                }
+              },
+              onStateChange: (draft) => persist(draft),
+              onRetargetStart: () => closeReceipt!(),
+              onRetarget: async (channelId) => {
+                assertScopeCurrent();
+                const targetScope = { ...scope, channelId, threadId: channelId };
+                const targetKey = receiptKey(targetScope);
+                const targetWriter = retainWriter(targetKey);
+                const transfer = targetWriter.acquiring
+                  .catch(() => undefined)
+                  .then(async () => {
+                    assertScopeCurrent();
+                    const existing = await store.observe!(targetKey);
+                    assertScopeCurrent();
+                    if (existing.value) {
+                      throw new Error("Discord progress retarget custody drift");
+                    }
+                    if (targetWriter.lease) {
+                      targetWriter.lease.revoked = true;
+                      await targetWriter.lease.stream.discardPending();
+                    }
+                    assertScopeCurrent();
+                    const registered = await store.registerIfAbsent(targetKey, {
+                      scope: targetScope,
+                      epoch: 1,
+                      closed: false,
+                      draft: { messages: [], pendingCreates: [], lastSentText: "" },
+                    });
+                    assertScopeCurrent();
+                    if (!registered) {
+                      throw new Error("Discord progress retarget custody drift");
+                    }
+                    await closeReceipt!();
+                    assertScopeCurrent();
+                    if (activeWriter.lease === nextLease) {
+                      activeWriter.lease = undefined;
+                    }
+                    scope = targetScope;
+                    key = targetKey;
+                    epoch = 1;
+                    activeWriter = targetWriter;
+                    targetWriter.lease = nextLease;
+                  });
+                // Reacquisition must await the entire ordinary move, including its nonce
+                // acknowledgement and old-message cleanup, not only receipt preparation.
+                targetWriter.acquiring = transfer.then(() => retargetFinished);
+                // The caller observes transfer rejection; future claimers observe this barrier.
+                void targetWriter.acquiring.catch(() => undefined);
+                await transfer;
+              },
+            }),
+          };
+          const stream = nextLease.stream;
+          const publishProgress = params.publishProgress;
+          if (publishProgress) {
+            nextLease.publishProgress = async (text, assertCallerCurrent) => {
+              const assertPublicationCurrent = () => {
+                assertCallerCurrent();
+                assertScopeCurrent();
+                if (activeWriter.lease !== nextLease || nextLease.revoked) {
+                  throw new Error("Discord progress writer changed");
+                }
+              };
+              assertPublicationCurrent();
+              const visible = await publishProgress(text, assertPublicationCurrent);
+              assertPublicationCurrent();
+              return visible ? stream.messageId() : undefined;
+            };
+          }
+          lease = nextLease;
+          writer.lease = nextLease;
+          const closeThisReceipt = closeReceipt;
+          prepareRetarget = (channelId) => {
+            if (!channelId.trim() || channelId.trim() === scope.channelId) {
+              return undefined;
+            }
+            const acquired = activeWriter.acquiring
+              .catch(() => undefined)
+              .then(() => assertScopeCurrent());
+            // The real thread owner has already adopted the target. Retain old-route
+            // nonce facts, but fence fresh claimers before waiting on dispatched work.
+            activeWriter.acquiring = acquired.then(() => retargetFinished);
+            void activeWriter.acquiring.catch(() => undefined);
+            return acquired;
+          };
+          retireWriter = () => {
+            nextLease.revoked = true;
+            const retiring = activeWriter.acquiring
+              .catch(() => undefined)
+              .then(async () => {
+                try {
+                  await stream.discardPending();
+                  await closeThisReceipt(true);
+                } finally {
+                  releaseWriters();
+                }
+              });
+            activeWriter.acquiring = retiring;
+            return retiring;
+          };
+          return stream;
+        });
+      writer.acquiring = next;
+      try {
+        return await next;
+      } catch (error) {
+        releaseWriters();
+        throw error;
+      }
+    })());
+  const enqueue = <T>(operation: (stream: DiscordDraftStream) => T | Promise<T>): Promise<T> => {
+    const generation = localGeneration;
+    const result = queued.then(async () => {
+      assertCurrent();
+      if (generation !== localGeneration) {
+        throw new Error("Discord progress request generation changed");
+      }
+      const stream = await acquire();
+      assertCurrent();
+      if (generation !== localGeneration) {
+        throw new Error("Discord progress request generation changed");
+      }
+      return operation(stream);
+    });
+    queued = result;
+    // update is synchronous; flush/stop remains the explicit error observation boundary.
+    void result.catch(() => undefined);
+    return result;
+  };
+  const release = async () => {
+    const current = lease;
+    released = true;
+    try {
+      if (current) {
+        current.revoked = true;
+        await current.stream.discardPending();
+      }
+    } finally {
+      releaseWriters();
+    }
+  };
+  return {
+    update: (text, options) => {
+      void enqueue((stream) => stream.update(text, options));
+    },
+    flush: () => enqueue((stream) => stream.flush()),
+    messageId: () => lease?.stream.messageId(),
+    clear: () =>
+      enqueue(async (stream) => {
+        await stream.clear();
+        await closeReceipt?.();
+      }),
+    deleteCurrentMessage: () =>
+      enqueue(async (stream) => {
+        await stream.deleteCurrentMessage();
+        await closeReceipt?.();
+      }),
+    discardPending: async () => {
+      if (!released && !lease?.revoked) {
+        await enqueue((stream) => stream.discardPending());
+      }
+    },
+    seal: () => enqueue((stream) => stream.seal()),
+    stop: () => enqueue((stream) => stream.stop()),
+    retarget: (channelId) => {
+      let finish!: () => void;
+      retargetFinished = new Promise<void>((resolve) => {
+        finish = resolve;
+      });
+      const preparing = prepareRetarget?.(channelId);
+      void preparing?.catch(() => undefined);
+      // A prior unknown acknowledgement is reconciled by the draft's original nonce.
+      queued = queued.catch(() => undefined);
+      return enqueue(async (stream) => {
+        await preparing;
+        await stream.retarget(channelId);
+      }).finally(() => {
+        finish();
+        retargetFinished = undefined;
+      });
+    },
+    cleanupPendingMessages: async (options) => {
+      if (released || !acquiring) {
+        return;
+      }
+      if (lease?.revoked) {
+        releaseWriters();
+        return;
+      }
+      try {
+        await enqueue((stream) => stream.cleanupPendingMessages(options));
+      } finally {
+        if (options?.terminal && retireWriter) {
+          await retireWriter();
+        } else {
+          await release();
+        }
+      }
+    },
+    forceNewMessage: () => {
+      // A queued independent task cannot inherit the initiating request's provider custody.
+      if (lease) {
+        lease.revoked = true;
+      }
+      const retire = retireWriter;
+      retireWriter = undefined;
+      prepareRetarget = undefined;
+      queued = queued
+        .catch(() => undefined)
+        .then(async () => {
+          await retire?.();
+        });
+      localGeneration += 1;
+      acquiring = undefined;
+      lease = undefined;
+      queued = queued.catch(() => undefined);
+    },
+  };
+}

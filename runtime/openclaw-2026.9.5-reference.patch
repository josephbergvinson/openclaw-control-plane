+// Value-free readback for release activation and recovery checks.
+import path from "node:path";
+import type { DatabaseSync } from "node:sqlite";
+import { normalizeProviderId } from "@openclaw/model-catalog-core/provider-id";
+import { stableStringify } from "@openclaw/normalization-core";
+import { evaluateStoredCredentialEligibility } from "../agents/auth-profiles/credential-state.js";
+import {
+  parseSharedAuthStoreOwnership,
+  SHARED_AUTH_STORE_STATE_KEY,
+} from "../agents/auth-profiles/path-resolve.js";
+import { coercePersistedAuthProfileStoreSilently } from "../agents/auth-profiles/persisted.js";
+import {
+  inspectPersistedAuthProfileStateRaw,
+  inspectPersistedAuthProfileStoreRaw,
+} from "../agents/auth-profiles/sqlite.js";
+import { coerceAuthProfileState } from "../agents/auth-profiles/state.js";
+import { readConfigMachineStateFromDatabase } from "../state/config-machine-state.js";
+import { withExistingOpenClawAgentDatabaseArtifactPreservingReadOnly } from "../state/openclaw-agent-db-readonly.js";
+import { withExistingOpenClawStateDatabaseArtifactPreservingReadOnly } from "../state/openclaw-state-db-readonly.js";
+import { sha256Hex } from "./crypto-digest.js";
+import {
+  resolveExecApprovalsSocketPath,
+  tryParsePersistedExecApprovals,
+} from "./exec-approvals-config.js";
+import type {
+  ExecApprovalsAgent,
+  ExecApprovalsDefaults,
+  ExecApprovalsFile,
+} from "./exec-approvals-core.js";
+import { inspectPendingLegacyExecApprovals } from "./exec-approvals-migration-gate.js";
+import {
+  projectionValues,
+  inspectExecApprovalsConfigRows,
+  type ExecApprovalsConfigFullRow,
+} from "./exec-approvals-sqlite.js";
+
+export type ExecApprovalsInspection = {
+  schemaVersion: 2;
+  databasePresent: boolean;
+  rowPresent: boolean;
+  rowCount: number;
+  currentKeyOnly: boolean;
+  legacySourceAbsent: boolean;
+  doctorClaimAbsent: boolean;
+  schemaValid: boolean;
+  projectionsValid: boolean;
+  expectedSocketPathMatched: boolean;
+  tokenPresent: boolean;
+  agentCount: number | null;
+  allowlistCount: number | null;
+  semanticSha256: string | null;
+  rawCasSha256: string | null;
+  authProfileStateReadable: boolean;
+  authProfileStoreReadable: boolean;
+  openAIProfileOrderCount: number | null;
+  openAIProfileOrderSha256: string | null;
+  openAIProfileOrderCredentialsUsable: boolean;
+};
+
+type SemanticPolicy = {
+  security: ExecApprovalsDefaults["security"] | null;
+  ask: ExecApprovalsDefaults["ask"] | null;
+  askFallback: ExecApprovalsDefaults["askFallback"] | null;
+  autoAllowSkills: boolean | null;
+};
+
+type AuthProfileInspections = {
+  state: ReturnType<typeof inspectPersistedAuthProfileStateRaw>;
+  store: ReturnType<typeof inspectPersistedAuthProfileStoreRaw>;
+};
+
+type SharedAuthStoreOwnership = "legacy-main" | "state-db" | "invalid";
+
+function inspectSharedAuthStoreOwnership(db: DatabaseSync): SharedAuthStoreOwnership {
+  try {
+    return parseSharedAuthStoreOwnership(
+      readConfigMachineStateFromDatabase(SHARED_AUTH_STORE_STATE_KEY, db),
+    ).location;
+  } catch {
+    return "invalid";
+  }
+}
+
+function inspectAuthProfiles(database: { db: DatabaseSync }): AuthProfileInspections {
+  return {
+    state: (() => {
+      try {
+        return inspectPersistedAuthProfileStateRaw(undefined, database);
+      } catch {
+        return { status: "unreadable" } as const;
+      }
+    })(),
+    store: (() => {
+      try {
+        return inspectPersistedAuthProfileStoreRaw(undefined, database);
+      } catch {
+        return { status: "unreadable" } as const;
+      }
+    })(),
+  };
+}
+
+function semanticPolicy(policy: ExecApprovalsDefaults | undefined): SemanticPolicy {
+  return {
+    security: policy?.security ?? null,
+    ask: policy?.ask ?? null,
+    askFallback: policy?.askFallback ?? null,
+    autoAllowSkills: policy?.autoAllowSkills ?? null,
+  };
+}
+
+function semanticAllowlist(agent: ExecApprovalsAgent) {
+  return (agent.allowlist ?? [])
+    .map((entry) => ({
+      pattern: entry.pattern,
+      argPattern: entry.argPattern ?? null,
+      source: entry.source ?? null,
+    }))
+    .toSorted((left, right) => compareCodeUnits(stableStringify(left), stableStringify(right)));
+}
+
+function semanticMcpTools(agent: ExecApprovalsAgent) {
+  return (agent.mcpTools ?? [])
+    .map(({ server, tool, source }) => ({ server, tool, source }))
+    .toSorted((left, right) => compareCodeUnits(stableStringify(left), stableStringify(right)));
+}
+
+function compareCodeUnits(left: string, right: string): number {
+  return left < right ? -1 : left > right ? 1 : 0;
+}
+
+function semanticExecApprovals(file: ExecApprovalsFile) {
+  return {
+    version: file.version,
+    defaults: semanticPolicy(file.defaults),
+    agents: Object.entries(file.agents ?? {})
+      .map(([agentId, agent]) => {
+        const semanticAgent: {
+          agentId: string;
+          policy: SemanticPolicy;
+          allowlist: ReturnType<typeof semanticAllowlist>;
+          mcpTools?: ReturnType<typeof semanticMcpTools>;
+        } = {
+          agentId,
+          policy: semanticPolicy(agent),
+          allowlist: semanticAllowlist(agent),
+        };
+        // Omit the key entirely: stableStringify retains undefined-valued fields.
+        if (agent.mcpTools?.length) {
+          semanticAgent.mcpTools = semanticMcpTools(agent);
+        }
+        return semanticAgent;
+      })
+      .toSorted((left, right) => compareCodeUnits(left.agentId, right.agentId)),
+  };
+}
+
+function rowProjectionsMatch(row: ExecApprovalsConfigFullRow, file: ExecApprovalsFile): boolean {
+  const expected = projectionValues(file);
+  return (
+    row.socket_path === expected.socket_path &&
+    row.has_socket_token === expected.has_socket_token &&
+    row.default_security === expected.default_security &&
+    row.default_ask === expected.default_ask &&
+    row.default_ask_fallback === expected.default_ask_fallback &&
+    row.auto_allow_skills === expected.auto_allow_skills &&
+    row.agent_count === expected.agent_count &&
+    row.allowlist_count === expected.allowlist_count &&
+    Number.isSafeInteger(row.updated_at_ms) &&
+    row.updated_at_ms >= 0
+  );
+}
+
+export function inspectExecApprovalsState(options: {
+  stateDir: string;
+  legacyPath: string;
+}): ExecApprovalsInspection {
+  if (!path.isAbsolute(options.stateDir) || !path.isAbsolute(options.legacyPath)) {
+    throw new Error("exec approvals inspection requires absolute state and legacy paths");
+  }
+  const env = { ...process.env, OPENCLAW_STATE_DIR: options.stateDir };
+  const legacy = inspectPendingLegacyExecApprovals({ sourcePath: options.legacyPath });
+  const databaseInspection = withExistingOpenClawStateDatabaseArtifactPreservingReadOnly(
+    (database) => {
+      const authStoreOwnership = inspectSharedAuthStoreOwnership(database.db);
+      return {
+        rows: inspectExecApprovalsConfigRows(database.db),
+        authStoreOwnership,
+        authProfiles: authStoreOwnership === "state-db" ? inspectAuthProfiles(database) : null,
+      };
+    },
+    { env },
+  );
+  const rowInspection = databaseInspection?.rows;
+  const databasePresent = rowInspection !== undefined;
+  const rowCount = rowInspection?.rowCount ?? 0;
+  const row = rowInspection?.current;
+  const parsed = row ? tryParsePersistedExecApprovals(row.raw_json) : null;
+  const projections = parsed ? projectionValues(parsed) : null;
+  const legacyAuthProfiles =
+    databaseInspection?.authStoreOwnership === "legacy-main"
+      ? withExistingOpenClawAgentDatabaseArtifactPreservingReadOnly(
+          (database) => inspectAuthProfiles(database),
+          { agentId: "main", env },
+        )
+      : null;
+  const authProfiles =
+    databaseInspection?.authStoreOwnership === "state-db"
+      ? databaseInspection.authProfiles
+      : legacyAuthProfiles?.found
+        ? legacyAuthProfiles.value
+        : null;
+  const authProfileStateInspection = authProfiles?.state ?? null;
+  const authProfileStoreInspection = authProfiles?.store ?? null;
+  const authProfileStateReadable = authProfileStateInspection?.status === "readable";
+  const persistedOpenAIProfileOrder = authProfileStateReadable
+    ? (coerceAuthProfileState(authProfileStateInspection.raw).order?.openai ?? null)
+    : null;
+  const persistedAuthProfileStore =
+    authProfileStoreInspection?.status === "readable"
+      ? coercePersistedAuthProfileStoreSilently(authProfileStoreInspection.raw)
+      : null;
+  const authProfileStoreReadable = persistedAuthProfileStore !== null;
+  const inspectableOpenAIProfileOrder =
+    persistedAuthProfileStore !== null && persistedOpenAIProfileOrder
+      ? persistedOpenAIProfileOrder
+      : null;
+  const openAIProfileOrderCredentialsUsable =
+    inspectableOpenAIProfileOrder !== null &&
+    persistedAuthProfileStore !== null &&
+    inspectableOpenAIProfileOrder.every((profileId) => {
+      const credential = persistedAuthProfileStore.profiles[profileId];
+      return (
+        credential !== undefined &&
+        credential.type === "oauth" &&
+        normalizeProviderId(credential.provider) === "openai" &&
+        evaluateStoredCredentialEligibility({ credential }).eligible
+      );
+    });
+
+  return {
+    schemaVersion: 2,
+    databasePresent,
+    rowPresent: row !== undefined,
+    rowCount,
+    currentKeyOnly: rowCount === 1 && row !== undefined,
+    ...legacy,
+    schemaValid: parsed !== null,
+    projectionsValid: row !== undefined && parsed !== null && rowProjectionsMatch(row, parsed),
+    expectedSocketPathMatched:
+      parsed?.socket?.path ===
+      path.join(path.dirname(options.legacyPath), path.basename(resolveExecApprovalsSocketPath())),
+    tokenPresent: Boolean(parsed?.socket?.token),
+    agentCount: projections?.agent_count ?? null,
+    allowlistCount: projections?.allowlist_count ?? null,
+    semanticSha256: parsed ? sha256Hex(stableStringify(semanticExecApprovals(parsed))) : null,
+    rawCasSha256: row ? sha256Hex(row.raw_json) : null,
+    authProfileStateReadable,
+    authProfileStoreReadable,
+    openAIProfileOrderCount: inspectableOpenAIProfileOrder?.length ?? null,
+    openAIProfileOrderSha256: inspectableOpenAIProfileOrder
+      ? sha256Hex(stableStringify(inspectableOpenAIProfileOrder))
+      : null,
+    openAIProfileOrderCredentialsUsable,
+  };
+}

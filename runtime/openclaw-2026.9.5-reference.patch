@@ -0,0 +1,93 @@
+import { asOptionalObjectRecord as record } from "@openclaw/normalization-core/record-coerce";
+import { resolveSessionTranscriptReadFence } from "../../config/sessions/session-transcript-read-fence.js";
+import { hasPersistedMedia } from "../../sessions/user-turn-media.js";
+import { ASSISTANT_DISPLAY_CONTENT_FIELD } from "../../shared/assistant-display-content.js";
+import { loadSessionAccessorRuntime } from "./run-prepare-runtime.js";
+
+export const CRON_PREWORK_FAILURE_DIAGNOSTIC =
+  "cron isolated failure verified before tool execution or assistant output";
+
+/** Positive proof from the settled native transcript, never from display history. */
+export async function hasSettledCronPreworkFailure(params: {
+  agentId: string;
+  sessionId: string;
+  sessionKey: string;
+  storePath: string;
+  jobId: string;
+}): Promise<boolean> {
+  try {
+    // A fenced page can be complete only before the admitted input. Do not
+    // mistake that prefix for the whole run or bypass the admission boundary.
+    if (resolveSessionTranscriptReadFence(params)) {
+      return false;
+    }
+    const { readTranscriptRawDelta } = await loadSessionAccessorRuntime();
+    const page = readTranscriptRawDelta(params, { maxEvents: 8, maxBytes: 512_000 });
+    if (page.kind !== "page" || page.hasMore || page.requiredBytes || page.events.length !== 7) {
+      return false;
+    }
+    const expectedTypes = [
+      "session",
+      "model_change",
+      "thinking_level_change",
+      "custom",
+      "message",
+      "custom_message",
+      "message",
+    ];
+    const events = page.events.map(({ event }) => record(event));
+    if (
+      events.some(
+        (event, index) =>
+          !event ||
+          event.type !== expectedTypes[index] ||
+          page.events[index]?.seq !== index ||
+          typeof event.id !== "string" ||
+          !event.id ||
+          (index === 1
+            ? event.parentId !== null
+            : index > 1 && event.parentId !== events[index - 1]?.id),
+      ) ||
+      new Set(events.map((event) => event?.id)).size !== 7
+    ) {
+      return false;
+    }
+    if (
+      events[0]?.id !== params.sessionId ||
+      events[3]?.customType !== "model-snapshot" ||
+      events[5]?.customType !== "openclaw.runtime-context"
+    ) {
+      return false;
+    }
+    const input = record(events[4]?.message);
+    const provenance = record(input?.provenance);
+    const terminal = record(events[6]?.message);
+    const usage = record(terminal?.usage);
+    const identity = record(terminal?.["__openclaw"]);
+    // run-entry awaits the exact terminal-error write before rejecting. Any
+    // tools, output, earlier turns, branching or unknown records fail closed.
+    return (
+      params.sessionKey.endsWith(`:cron:${params.jobId}:run:${params.sessionId}`) &&
+      input?.role === "user" &&
+      provenance?.kind === "internal_system" &&
+      provenance.sourceTool === "cron" &&
+      provenance.jobId === params.jobId &&
+      provenance.runId === params.sessionId &&
+      provenance.sourceSessionKey === params.sessionKey &&
+      terminal?.role === "assistant" &&
+      terminal.stopReason === "error" &&
+      Array.isArray(terminal.content) &&
+      terminal.content.length === 0 &&
+      identity?.runId === params.sessionId &&
+      terminal.idempotencyKey === `${params.sessionId}:terminal-error` &&
+      usage?.input === 0 &&
+      usage.output === 0 &&
+      terminal.openclawDelivery === undefined &&
+      !hasPersistedMedia(terminal) &&
+      terminal[ASSISTANT_DISPLAY_CONTENT_FIELD] === undefined
+    );
+  } catch {
+    // A failed or incomplete proof must not replace the original run error.
+    return false;
+  }
+}

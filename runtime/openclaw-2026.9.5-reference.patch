+            agentId: params.agentId,
+          });
+          return buildGenericCliContextEngineHostSupport({
+            backendId: backend?.id ?? executionProvider,
+            ...(backend?.contextEngineHostCapabilities
+              ? { capabilities: backend.contextEngineHostCapabilities }

+        expect(firstKey).toBe(expectedKey);
+        foreground.complete();
+        await vi.advanceTimersByTimeAsync(30_000);
+        startTurn.mockImplementation(async (input) => {
+          input.assertAdmissionCurrent?.();
+          completeTurn(input);
+        });
+        await expect(scoped(f.wake)).resolves.toBe(true);
+        expect(deliver.mock.calls[1]?.[0].directIdempotencyKey).toBe(firstKey);
+        expect(f.completeBatch).toHaveBeenCalledOnce();
+      } finally {
+        releasePreparation.resolve();
+        foreground?.complete();
+        await Promise.allSettled([wake, maintenanceWork]);
+      }
+    },
+  );
+
+  it.each([
+    {
+      kind: "other-agent",
+      agentId: "other",
+      sessionId: "requester-session",
+      sessionKey: "agent:other:main",
+    },
+    {
+      kind: "other-session",
+      agentId: "main",
+      sessionId: "other-session",
+      sessionKey: REQUESTER_KEY,
+    },
+    {
+      kind: "heartbeat",
+      agentId: "main",
+      sessionId: "requester-session",
+      sessionKey: REQUESTER_KEY,
+    },
+    { kind: "cleared", agentId: "main", sessionId: "requester-session", sessionKey: REQUESTER_KEY },
+  ] as const)("does not borrow $kind foreground custody as a blocker", async (owner) => {
+    const f = fixture();
+    const operation = reserveForeground({
+      agentId: owner.agentId,
+      sessionId: owner.sessionId,
+      sessionKey: owner.sessionKey,
+      ...(owner.kind === "heartbeat" ? { turnKind: "heartbeat" } : {}),
+    });
+    if (owner.kind === "cleared") {
+      operation.complete();
+    }
+    deliver.mockResolvedValue({ delivered: true, path: "direct" });
+    try {
+      await expect(f.wake()).resolves.toBe(true);
+      expect(deliver).toHaveBeenCalledOnce();
+      expect(f.completeBatch).toHaveBeenCalledOnce();
+    } finally {
+      operation.complete();
+    }
+  });
+
+  it("keeps a terminal retained owner fenced until physical finalization releases it", async () => {
+    vi.useFakeTimers();
+    vi.setSystemTime(10_000);
+    const f = fixture();
+    const operation = reserveForeground();
+    operation.retainFailureUntilComplete();
+    operation.fail("run_failed", new Error("synthetic foreground finalization"));
+    deliver.mockResolvedValue({ delivered: true, path: "direct" });

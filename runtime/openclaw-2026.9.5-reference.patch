+
+/** Registers socket-fallback ownership cases under the caller's shared lifecycle hooks. */
+export function registerFallbackOwnershipTests({
+  makeGatewayContext,
+  externalCliClient,
+}: {
+  makeGatewayContext: () => GatewayRequestContext;
+  externalCliClient: () => GatewayRequestOptions["client"];
+}): void {
+  it("registers the native completion owner beside a silent fallback CLI task and settles a failed wake once", async () => {
+    const gatewayContext = makeGatewayContext();
+    const requests: string[] = [];
+    const runId = "gateway-owned-run";
+    // The synthetic terminal event below owns completion; do not contact a real gateway.
+    subagentRegistryTesting.setDepsForTest({
+      loadAgentRuntimePluginRegistryHandle: () => undefined,
+      persistSubagentRunsToDisk: () => {},
+      persistSubagentRunsToDiskOrThrow: () => {},
+      restoreSubagentRunsFromDisk: () => 0,
+      callGateway: async () => new Promise<never>(() => {}),
+    });
+    let cliTaskId = "";
+    subagentSpawnTesting.setDepsForTest({
+      hasInProcessGatewayContext: () => false,
+      callGateway: async <T>(request: { method: string; params?: unknown }) => {
+        requests.push(request.method);
+        if (request.method === "agent") {
+          const params = request.params as { sessionKey: string };
+          cliTaskId = expectDefined(
+            createRunningTaskRun({
+              runtime: "cli",
+              sourceId: runId,
+              ownerKey: params.sessionKey,
+              scopeKind: "session",
+              childSessionKey: params.sessionKey,
+              runId,
+              task: "check the invitation",
+              deliveryStatus: "not_applicable",
+              startedAt: Date.now(),
+            }),
+            "silent CLI transport task",
+          ).taskId;
+        }
+        return { runId: request.method === "agent" ? runId : undefined, status: "accepted" } as T;
+      },
+    });
+    const result = await withPluginRuntimeGatewayRequestScope(
+      { context: gatewayContext, client: externalCliClient(), isWebchatConnect: () => false },
+      () =>
+        spawnSubagentDirect(
+          { task: "check the invitation", context: "isolated", lightContext: true },
+          { agentSessionKey: "agent:main:main", requesterRunId: "parent-run" },
+        ),
+    );
+    expect(result.status).toBe("accepted");
+    const task = expectDefined(findTaskByRunId(runId), "native completion task");
+    expect(result).toHaveProperty("taskId", task.taskId);
+    expect(task.taskId).not.toBe(cliTaskId);
+    expect(task).toMatchObject({
+      runtime: "subagent",
+      runId,
+      ownerKey: "agent:main:main",
+      requesterSessionKey: "agent:main:main",
+      childSessionKey: result.childSessionKey,
+      deliveryStatus: "pending",
+    });
+    expect(listTasksForOwnerKey("agent:main:main").map((entry) => entry.taskId)).toEqual([
+      task.taskId,
+    ]);
+    expect(getTaskById(cliTaskId)).toMatchObject({
+      runtime: "cli",
+      notifyPolicy: "silent",
+      deliveryStatus: "not_applicable",
+    });
+    expect(requests.filter((method) => method === "agent")).toHaveLength(1);
+    expect(requests).not.toContain("chat.abort");
+
+    const subagent = expectDefined(subagentRuns.get(runId), "registered subagent run");
+    // The scoped settlement controller below owns the synthetic completion event.
+    resetSubagentRegistryForTests({ persist: false });
+    subagentRuns.set(runId, subagent);
+    // Feed the completed child into the real settlement store while the requester is unavailable.
+    subagent.execution = {
+      ...subagent.execution,
+      status: "terminal",
+      endedAt: Date.now(),
+      outcome: { status: "ok" },
+    };
+    subagent.completion = {
+      required: true,
+      resultText: "invitation found",
+      capturedAt: Date.now(),
+    };
+    const input = armRequesterWake({ ...records(), subagent, task });
+    const completedTask = { ...task, status: "succeeded" as const, endedAt: Date.now() };
+    settleSubagentCompletionDelivery({ subagent, task: completedTask });
+    publishTaskRecordAfterAtomicStore(completedTask);
+    const driver = requesterWakeDriver([input]);
+    try {
+      await driver.run();
+      expect(driver.warn).not.toHaveBeenCalledWith(
+        "failed to persist requester settle wake rejection",
+        expect.any(Object),
+      );
+      expect(subagent.requesterSettleWake).toBeUndefined();
+      expect(subagent.delivery).toMatchObject({
+        status: "failed",
+        lastError: "requester unavailable",
+      });
+      expect(getTaskById(task.taskId)).toMatchObject({
+        deliveryStatus: "failed",
+        terminalOutcome: "blocked",
+        error: "requester unavailable",
+      });
+      expect(loadSubagentRegistryFromSqlite().get(runId)?.requesterSettleWake).toBeUndefined();
+      expect(driver.controller.getRequesterSettleWakeTimer(runId)).toBeUndefined();
+      expect(driver.wake).toHaveBeenCalledOnce();
+      const database = openOpenClawStateDatabase();
+      expect(
+        database.db
+          .prepare(
+            "SELECT COUNT(*) AS count FROM delivery_queue_entries WHERE entry_kind = 'systemEvent'",
+          )
+          .get(),
+      ).toMatchObject({ count: 1 });
+      expect(getTaskById(cliTaskId)).toMatchObject({
+        runtime: "cli",
+        notifyPolicy: "silent",
+        deliveryStatus: "not_applicable",
+      });
+    } finally {
+      driver.controller.clearScheduledResumeTimers();
+    }
+  });
+
+  it.each(["missing", "wrong identity"] as const)(
+    "aborts a fallback child when its canonical task is %s",
+    async (fault) => {
+      const unrelated = expectDefined(
+        createRunningTaskRun({
+          runtime: "subagent",
+          sourceId: "other-run",
+          runId: "other-run",
+          ownerKey: "agent:other:main",
+          scopeKind: "session",
+          childSessionKey: "agent:other:subagent:child",
+          task: "unrelated work",
+          startedAt: Date.now(),
+        }),
+        "unrelated task",
+      );
+      const requests: string[] = [];
+      subagentSpawnTesting.setDepsForTest({
+        hasInProcessGatewayContext: () => false,
+        callGateway: async <T>(request: { method: string; params?: unknown }) => {
+          requests.push(request.method);
+          return { runId: "fallback-rejected-run", status: "accepted" } as T;
+        },
+      });
+      setDetachedTaskLifecycleRuntime({
+        ...getDetachedTaskLifecycleRuntime(),
+        createRunningTaskRun: () => (fault === "missing" ? null : unrelated),
+      });
+      const result = await withPluginRuntimeGatewayRequestScope(
+        {
+          context: makeGatewayContext(),
+          client: externalCliClient(),
+          isWebchatConnect: () => false,
+        },
+        () =>
+          spawnSubagentDirect(
+            { task: "check the invitation", context: "isolated", lightContext: true },
+            { agentSessionKey: "agent:main:main", requesterRunId: "parent-run" },
+          ),
+      );
+      expect(result.status).toBe("error");
+      expect(requests).toContain("chat.abort");
+      expect(subagentRuns.size).toBe(0);
+      expect(getTaskById(unrelated.taskId)).toEqual(unrelated);
+    },
+  );
+}

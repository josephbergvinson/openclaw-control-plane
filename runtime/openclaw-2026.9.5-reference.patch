+import type { AgentMessage } from "openclaw/plugin-sdk/agent-core";
+import { describe, expect, it } from "vitest";
+import { createZeroUsageFixture } from "../../test-helpers/usage-fixtures.js";
+import { shouldPreemptivelyCompactBeforePrompt } from "./preemptive-compaction.js";
+
+function measuredHistory(): [AgentMessage, ...AgentMessage[]] {
+  return [
+    {
+      role: "assistant",
+      api: "openai-responses",
+      provider: "openai",
+      model: "measured-model",
+      content: [],
+      timestamp: 1,
+      stopReason: "toolUse",
+      usage: {
+        ...createZeroUsageFixture(),
+        input: 35_411,
+        cacheRead: 153_472,
+        output: 1_147,
+        totalTokens: 190_030,
+        contextUsage: { state: "available", promptTokens: 188_883, totalTokens: 190_030 },
+      },
+    },
+    ...[6_726, 13_743, 6_767, 13_833, 50_687].map((length, index) => ({
+      role: "toolResult" as const,
+      toolName: "read",
+      toolCallId: `call-${index}`,
+      isError: false,
+      timestamp: index + 2,
+      content: [{ type: "text" as const, text: "x".repeat(length) }],
+    })),
+  ];
+}
+const options = {
+  systemPrompt: "s".repeat(45_000),
+  prompt: "",
+  contextTokenBudget: 272_000,
+  reserveTokens: 20_000,
+};
+describe("fixed cost pressure at an accepted provider boundary", () => {
+  it("keeps the actual measured prefix and pending tail below budget without counting unchanged instructions twice", () => {
+    const messages = measuredHistory();
+    expect(shouldPreemptivelyCompactBeforePrompt({ ...options, messages }).route).not.toBe("fits");
+    const result = shouldPreemptivelyCompactBeforePrompt({
+      ...options,
+      messages,
+      getMeasuredFixedPromptCoverage: () => ({ systemPrompt: true, toolSchemas: true }),
+    });
+    expect(result.route).toBe("fits");
+    expect(result.estimatedPromptTokens).toBeGreaterThan(190_030);
+    expect(result.estimatedPromptTokens).toBeLessThan(252_000);
+  });
+  it("retains conservative changed or unavailable fixed costs and tool schema costs", () => {
+    const messages = measuredHistory();
+    for (const getMeasuredFixedPromptCoverage of [
+      () => undefined,
+      () => ({ systemPrompt: false, toolSchemas: false }),
+    ]) {
+      expect(
+        shouldPreemptivelyCompactBeforePrompt({
+          ...options,
+          messages,
+          getMeasuredFixedPromptCoverage,
+        }).route,
+      ).not.toBe("fits");
+    }
+    expect(
+      shouldPreemptivelyCompactBeforePrompt({
+        ...options,
+        messages,
+        toolSchemaTokens: 30_000,
+        getMeasuredFixedPromptCoverage: () => ({ systemPrompt: true, toolSchemas: false }),
+      }).route,
+    ).not.toBe("fits");
+  });
+  it("does not reuse fixed coverage across a genuine unavailable usage barrier", () => {
+    const messages = measuredHistory();
+    const unavailable: AgentMessage = {
+      role: "assistant",
+      api: "openai-responses",
+      provider: "openai",
+      model: "measured-model",
+      content: [],
+      timestamp: 50,
+      stopReason: "stop",
+      usage: { ...createZeroUsageFixture(), contextUsage: { state: "unavailable" } },
+    };
+    const result = shouldPreemptivelyCompactBeforePrompt({
+      ...options,
+      messages: [messages[0], unavailable, ...messages.slice(1)],
+      getMeasuredFixedPromptCoverage: () => ({ systemPrompt: true, toolSchemas: true }),
+    });
+    expect(result.pressureSource).toBe("transcript_estimate");
+  });
+});

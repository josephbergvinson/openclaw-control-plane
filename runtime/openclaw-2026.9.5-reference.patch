+    target: {
+      agentId: "main",
+      cwd: "/tmp",
+      sessionEntry,
+      sessionId: "session",
+      sessionKey: "main",
+      sessionStore,
+      storePath,
+    },
+  });
+  try {
+    const controller = createReplyAgentRestartRecoveryController({
+      activeSessionStore: sessionStore,
+      cfg: {},
+      followupRun,
+      getActiveSessionEntry: () => entry,
+      opts: undefined,
+      replyOperation: active,
+      restartRecoverySourceTurnId: readChannelSourceTurnId(sessionCtx),
+      runtimePolicySessionKey: undefined,
+      sessionCtx,
+      sessionKey: "main",
+      setActiveSessionEntry: (next) => {
+        entry = next;

--- /dev/null
+++ b/src/agents/session-goal-usage.test.ts
@@ -0,0 +1,555 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { persistSessionUsageUpdate } from "../auto-reply/reply/session-usage.js";
+import { persistSessionGoalUsage } from "../config/sessions/goals-usage.js";
+import {
+  clearSessionGoal,
+  createSessionGoal,
+  getSessionGoal,
+  updateSessionGoalStatus,
+} from "../config/sessions/goals.js";
+import {
+  loadSessionEntry,
+  patchSessionEntryCore,
+  upsertSessionEntryCore,
+} from "../config/sessions/session-accessor.js";
+import * as sessionAccessor from "../config/sessions/session-accessor.js";
+import { projectPublicSessionEntry } from "../config/sessions/session-entry-projection.js";
+import { useTempSessionsFixture } from "../config/sessions/test-helpers.js";
+import { updateSessionStore } from "../plugin-sdk/session-store-runtime.js";
+import {
+  createUsageAccumulator,
+  mergeUsageIntoAccumulator,
+  toNormalizedUsage,
+} from "./embedded-agent-runner/usage-accumulator.js";
+import { createSubscribedSessionHarness } from "./embedded-agent-subscribe.e2e-harness.js";
+import {
+  bindSessionGoalAttemptUsage,
+  createSessionGoalUsageRun,
+  settleSessionGoalUsageRun,
+  withSessionGoalUsageRun,
+} from "./session-goal-usage.js";
+import { makeAgentAssistantMessage } from "./test-helpers/agent-message-fixtures.js";
+import {
+  createCreateGoalTool,
+  createGetGoalTool,
+  createUpdateGoalTool,
+} from "./tools/goal-tools.js";
+import { makeZeroUsageSnapshot } from "./usage.js";
+
+describe("accepted native goal usage", () => {
+  const fixture = useTempSessionsFixture("openclaw-goal-usage-");
+  afterEach(() => vi.restoreAllMocks());
+  const sessionKey = "agent:main:discord:channel:123";
+
+  async function prepare(options: { goal?: boolean; budget?: number; legacy?: number } = {}) {
+    const scope = { agentId: "main", sessionKey, storePath: fixture.storePath() };
+    const target = {
+      ...scope,
+      sessionId: "session",
+      lifecycleRevision: "revision-1",
+      activeWriterRunId: "run",
+    };
+    await upsertSessionEntryCore(scope, {
+      ...target,
+      updatedAt: 1,
+      totalTokens: 142_679,
+      totalTokensFresh: true,
+      totalTokensVersion: 1,
+    });
+    if (options.goal !== false) {
+      await createSessionGoal({
+        ...scope,
+        objective: "Read the five sources",
+        tokenBudget: options.budget,
+      });
+    }
+    if (options.legacy !== undefined) {
+      await patchSessionEntryCore(scope, (entry) => ({
+        goalUsage: undefined,
+        goal: entry.goal ? { ...entry.goal, tokensUsed: options.legacy! } : undefined,
+      }));
+    }
+    const runTotals = createUsageAccumulator();
+    let current = true;
+    const run = createSessionGoalUsageRun({
+      runId: "run",
+      admissionId: "admission",
+      instanceId: "instance",
+      initialScope: target,
+      readTarget: () => target,
+      readRunTokens: () => runTotals.total,
+      assertCurrent: () => {
+        if (!current) {
+          throw new Error("owner replaced");
+        }
+      },
+    });
+    const toolOptions = {
+      runId: "run",
+      runSessionKey: sessionKey,
+      agentSessionKey: "agent:main:discord:slash:456",
+      config: { session: { store: fixture.storePath() } },
+    };
+    return {
+      scope,
+      target,
+      run,
+      runTotals,
+      toolOptions,
+      close: () => {
+        current = false;
+      },
+    };
+  }
+
+  it("counts both calls through complete and settlement after compaction on the native slash run session", async () => {
+    const f = await prepare();
+    await withSessionGoalUsageRun(f.run, async () => {
+      const complete = createUpdateGoalTool(f.toolOptions);
+      const get = createGetGoalTool(f.toolOptions);
+      const attempt = createUsageAccumulator();
+      const release = bindSessionGoalAttemptUsage("run", () => attempt.total);
+      await patchSessionEntryCore(f.scope, () => ({ totalTokens: 135_190, compactionCount: 1 }));
+      mergeUsageIntoAccumulator(attempt, { input: 135_190, output: 1_067 });
+      const projected = await get.execute("read", {});
+      expect(projected.details).toMatchObject({ goal: { tokensUsed: 136_257 } });
+      expect(loadSessionEntry(f.scope)?.goal?.tokensUsed).toBe(0);
+      await complete.execute("complete", { status: "complete" });
+      expect(loadSessionEntry(f.scope)?.goal).toMatchObject({
+        status: "complete",
+        tokensUsed: 136_257,
+      });
+      mergeUsageIntoAccumulator(attempt, { input: 1_463, cacheRead: 135_040, output: 456 });
+      release();
+      mergeUsageIntoAccumulator(f.runTotals, toNormalizedUsage(attempt));
+      await settleSessionGoalUsageRun(f.run, async () => {
+        // This is the production settlement order: account before releasing writer authority.
+        expect(loadSessionEntry(f.scope)?.goal?.tokensUsed).toBe(273_216);
+        f.close();
+      });
+    });
+    await persistSessionUsageUpdate({
+      ...f.scope,
+      usage: toNormalizedUsage(f.runTotals),
+      lastCallUsage: { input: 1_463, output: 456, cacheRead: 135_040 },
+    });
+    const entry = loadSessionEntry(f.scope)!;
+    expect(entry.totalTokens).toBe(136_503);
+    expect(entry.goal?.tokensUsed).toBe(273_216);
+    expect(
+      loadSessionEntry({ ...f.scope, sessionKey: f.toolOptions.agentSessionKey })?.goal,
+    ).toBeUndefined();
+    expect(projectPublicSessionEntry(entry)).not.toHaveProperty("goalUsage");
+  });
+
+  it("charges accepted retries once and adds only a larger same-run snapshot", async () => {
+    const f = await prepare({ budget: 40 });
+    await withSessionGoalUsageRun(f.run, async () => {
+      for (const usage of [
+        { input: 10, output: 5 },
+        { input: 20, output: 10 },
+      ]) {
+        const attempt = createUsageAccumulator();
+        const release = bindSessionGoalAttemptUsage("run", () => attempt.total);
+        mergeUsageIntoAccumulator(attempt, usage);
+        await persistSessionGoalUsage(f.run.observe()!);
+        release();
+        mergeUsageIntoAccumulator(f.runTotals, toNormalizedUsage(attempt));
+        await persistSessionGoalUsage(f.run.observe()!);
+      }
+      expect(loadSessionEntry(f.scope)?.goal).toMatchObject({
+        tokensUsed: 45,
+        status: "budget_limited",
+      });
+      await settleSessionGoalUsageRun(f.run, async () => {});
+      expect(loadSessionEntry(f.scope)?.goal?.tokensUsed).toBe(45);
+    });
+  });
+
+  it("starts a mid-run goal at the accepted accumulator baseline and retains its final", async () => {
+    const f = await prepare({ goal: false });
+    await withSessionGoalUsageRun(f.run, async () => {
+      const create = createCreateGoalTool(f.toolOptions);
+      const complete = createUpdateGoalTool(f.toolOptions);
+      const attempt = createUsageAccumulator();
+      const release = bindSessionGoalAttemptUsage("run", () => attempt.total);
+      mergeUsageIntoAccumulator(attempt, { input: 100, output: 20 });
+      await create.execute("create", { objective: "Finish the requested work" });
+      mergeUsageIntoAccumulator(attempt, { input: 30, output: 10 });
+      await complete.execute("complete", { status: "complete" });
+      mergeUsageIntoAccumulator(attempt, { input: 15, output: 5 });
+      release();
+      mergeUsageIntoAccumulator(f.runTotals, toNormalizedUsage(attempt));
+      await settleSessionGoalUsageRun(f.run, async () => {});
+      expect(loadSessionEntry(f.scope)?.goal?.tokensUsed).toBe(60);
+    });
+  });
+
+  it("does not charge pre-creation usage when a harness reports only terminal totals", async () => {
+    const f = await prepare({ goal: false });
+    await withSessionGoalUsageRun(f.run, async () => {
+      mergeUsageIntoAccumulator(f.runTotals, { input: 30, output: 10 });
+      const created = await createCreateGoalTool(f.toolOptions).execute("create", {
+        objective: "Continue from here",
+      });
+      expect(created.details).toMatchObject({
+        usageAccounting: expect.stringContaining("unaccounted"),
+      });
+      // This combined return cannot tell us which calls occurred before creation.
+      mergeUsageIntoAccumulator(f.runTotals, { input: 100, output: 20 });
+      await settleSessionGoalUsageRun(f.run, async () => {});
+      expect(loadSessionEntry(f.scope)?.goal?.tokensUsed).toBe(0);
+    });
+    const nextRun = createSessionGoalUsageRun({
+      runId: "run",
+      admissionId: "next-admission",
+      instanceId: "next-accumulator",
+      initialScope: f.target,
+      readTarget: () => f.target,
+      readRunTokens: () => 20,
+      assertCurrent: () => {},
+    });
+    await settleSessionGoalUsageRun(nextRun, async () => {});
+    expect(loadSessionEntry(f.scope)?.goal?.tokensUsed).toBe(20);
+  });
+
+  it.each([
+    { creation: "before usage", expected: 0 },
+    { creation: "after usage", expected: 40 },
+    { creation: "at admission", expected: 160 },
+  ])("accounts a subscribed goal created $creation", async ({ creation, expected }) => {
+    const f = await prepare({ goal: creation === "at admission", budget: 20 });
+    await withSessionGoalUsageRun(f.run, async () => {
+      const { emit, subscription } = createSubscribedSessionHarness({ runId: "run" });
+      const reportUsage = (tokens: number) => {
+        const message = makeAgentAssistantMessage({
+          content: [],
+          usage: { ...makeZeroUsageSnapshot(), input: tokens, totalTokens: tokens },
+        });
+        emit({ type: "message_start", message });
+        emit({ type: "message_end", message });
+      };
+      try {
+        expect(subscription.getUsageTotals()).toBeUndefined();
+        if (creation === "after usage") {
+          reportUsage(120);
+          expect(subscription.getUsageTotals()?.total).toBe(120);
+        }
+        if (creation !== "at admission") {
+          const created = await createCreateGoalTool(f.toolOptions).execute("create", {
+            objective: "Finish from here",
+            token_budget: 20,
+          });

@@ -0,0 +1,156 @@
+import ConcurrencyExtras
+import Foundation
+import Testing
+@testable import OpenClaw
+
+private actor GatewayLocalAuthTestGate {
+    private var released = false
+    private var continuation: CheckedContinuation<Void, Never>?
+
+    func wait() async {
+        guard !self.released else { return }
+        await withCheckedContinuation { self.continuation = $0 }
+    }
+
+    func release() {
+        self.released = true
+        self.continuation?.resume()
+        self.continuation = nil
+    }
+}
+
+struct GatewayLocalAuthResolverTests {
+    private let reference: [String: Any] = ["source": "store", "provider": "default", "id": "GATEWAY_AUTH"]
+
+    @Test func `structured local refs reach the private pipe resolver`() throws {
+        let root: [String: Any] = ["gateway": ["mode": "local", "auth": ["mode": "token", "token": self.reference]]]
+        let data = try #require(try GatewayLocalAuthResolver.request(root: root, env: [:]))
+        let request = try #require(try JSONSerialization.jsonObject(with: data) as? [String: Any])
+        #expect(request["version"] as? Int == 1)
+        let auth = try #require(request["auth"] as? [String: Any])
+        #expect((auth["token"] as? [String: String]) == self.reference as? [String: String])
+    }
+
+    @Test func `literal env and remote routes retain their original resolution`() throws {
+        for token in ["literal-token", "${GATEWAY_AUTH}"] {
+            let root: [String: Any] = ["gateway": ["mode": "local", "auth": ["mode": "token", "token": token]]]
+            #expect(try GatewayLocalAuthResolver.request(root: root, env: [:]) == nil)
+        }
+        let remote: [String: Any] = ["gateway": ["mode": "remote", "auth": ["mode": "token", "token": self.reference]]]
+        #expect(try GatewayLocalAuthResolver.request(root: remote, env: [:]) == nil)
+        let local: [String: Any] = ["gateway": ["mode": "local", "auth": ["mode": "token", "token": self.reference]]]
+        #expect(try GatewayLocalAuthResolver.request(root: local, env: ["OPENCLAW_GATEWAY_TOKEN": "stale"]) != nil)
+        let password: [String: Any] = ["gateway": ["mode": "local", "auth": [
+            "mode": "password", "password": self.reference,
+        ]]]
+        #expect(try GatewayLocalAuthResolver
+            .request(root: password, env: ["OPENCLAW_GATEWAY_PASSWORD": "stale"]) != nil)
+    }
+
+    @Test func `selected password ref is not masked by a sibling literal token`() throws {
+        let root: [String: Any] = ["gateway": ["mode": "local", "auth": [
+            "mode": "password", "password": self.reference, "token": "stale",
+        ]]]
+        #expect(try GatewayLocalAuthResolver.request(root: root, env: [:]) != nil)
+        let inferred: [String: Any] = ["gateway": ["auth": ["password": self.reference]]]
+        #expect(try GatewayLocalAuthResolver.request(root: inferred, env: ["OPENCLAW_GATEWAY_TOKEN": "ambient"]) != nil)
+        let blankRemote: [String: Any] = ["gateway": [
+            "remote": ["url": "  "], "auth": ["password": self.reference],
+        ]]
+        #expect(try GatewayLocalAuthResolver.request(root: blankRemote, env: [:]) != nil)
+    }
+
+    @Test func `connection auth is single flight reused and refreshed after invalidation`() async throws {
+        let cache = GatewayLocalAuthResolver.ConnectionCache()
+        let calls = LockIsolated(0)
+        let operation: @Sendable () async throws -> GatewayLocalAuthResolver.Credentials = {
+            let number = calls.withValue { $0 += 1
+                return $0
+            }
+            try await Task.sleep(for: .milliseconds(20))
+            return .init(version: 1, token: "synthetic-\(number)", password: nil)
+        }
+        async let first = cache.resolve(key: Data([1]), operation: operation)
+        async let second = cache.resolve(key: Data([1]), operation: operation)
+        let results = try await [first, second]
+        #expect(results[0] == results[1])
+        #expect(calls.value == 1)
+        #expect(try await cache.resolve(key: Data([1]), operation: operation) == results[0])
+        #expect(calls.value == 1)
+        cache.invalidate()
+        #expect(try await cache.resolve(key: Data([1]), operation: operation).token == "synthetic-2")
+        #expect(try await cache.resolve(key: Data([2]), operation: operation).token == "synthetic-3")
+    }
+
+    @Test func `retired in flight auth cannot publish and failures do not poison retry`() async throws {
+        let cache = GatewayLocalAuthResolver.ConnectionCache()
+        let started = LockIsolated(false)
+        let operation = Task {
+            try await cache.resolve(key: Data([1])) {
+                started.setValue(true)
+                try await Task.sleep(for: .seconds(10))
+                return .init(version: 1, token: "retired", password: nil)
+            }
+        }
+        while !started.value {
+            await Task.yield()
+        }
+        cache.invalidate()
+        await #expect(throws: CancellationError.self) { try await operation.value }
+        await #expect(throws: GatewayLocalAuthResolver.ResolutionError.self) {
+            try await cache.resolve(key: Data([1])) { throw GatewayLocalAuthResolver.ResolutionError.unavailable }
+        }
+        let fresh = try await cache.resolve(key: Data([1])) {
+            .init(version: 1, token: "fresh", password: nil)
+        }
+        #expect(fresh.token == "fresh")
+    }
+
+    @Test func `one cancelled consumer does not retire another consumers auth`() async throws {
+        let cache = GatewayLocalAuthResolver.ConnectionCache()
+        let calls = LockIsolated(0)
+        let gate = GatewayLocalAuthTestGate()
+        let resolve: @Sendable () async throws -> GatewayLocalAuthResolver.Credentials = {
+            calls.withValue { $0 += 1 }
+            await gate.wait()
+            return .init(version: 1, token: "shared", password: nil)
+        }
+        let cancelled = Task { try await cache.resolve(key: Data([1]), operation: resolve) }
+        while calls.value == 0 {
+            await Task.yield()
+        }
+        let other = Task { try await cache.resolve(key: Data([1]), operation: resolve) }
+        cancelled.cancel()
+        await gate.release()
+        await #expect(throws: CancellationError.self) { try await cancelled.value }
+        #expect(try await other.value.token == "shared")
+        #expect(try await cache.resolve(key: Data([1]), operation: resolve).token == "shared")
+        #expect(calls.value == 1)
+    }
+
+    @Test func `private subprocess stdin closes and credentials remain captured in memory`() async throws {
+        let bytes = Data(#"{"version":1,"token":"synthetic-pipe-token"}"#.utf8)
+        let result = try await BoundedProcess.run(
+            path: "/bin/cat",
+            arguments: [],
+            standardInput: .array(Array(bytes)),
+            standardError: .discarded,
+            timeout: 5)
+        #expect(try GatewayLocalAuthResolver.decode(result).token == "synthetic-pipe-token")
+    }
+
+    @Test func `helper errors and malformed output reveal no credentials`() throws {
+        for output in [#"{"version":1,"token":"secret-from-error"}"#, "provider diagnostic: secret", "{}"] {
+            #expect(throws: GatewayLocalAuthResolver.ResolutionError.self) {
+                try GatewayLocalAuthResolver.decode(.init(output: Data(output.utf8), terminationStatus: 1))
+            }
+        }
+        #expect(throws: GatewayLocalAuthResolver.ResolutionError.self) {
+            try GatewayLocalAuthResolver.decode(.init(output: Data("{}".utf8), terminationStatus: 0))
+        }
+        let result = try GatewayLocalAuthResolver.decode(.init(
+            output: Data(#"{"version":1,"token":"synthetic-token"}"#.utf8), terminationStatus: 0))
+        #expect(result.token == "synthetic-token")
+        #expect(result.password == nil)
+    }
+}

+++ b/src/agents/subagents/registry/subagent-registry-lifecycle.delivery-window.test-harness.ts
@@ -0,0 +1,273 @@
+import { expect, it, vi } from "vitest";
+import {
+  cancelSubagentCompletionToolHandoff,
+  consumeSubagentCompletionToolHandoff,
+  registerSubagentCompletionToolHandoff,
+} from "../../../gateway/subagent-completion-tool-handoff.js";
+import { getAgentEventLifecycleGeneration } from "../../../infra/agent-events.js";
+import { getActiveGatewayRootWorkCount } from "../../../process/gateway-work-admission.js";
+import { createDeferredCore } from "../../../shared/deferred.js";
+import { SUBAGENT_ENDED_REASON_COMPLETE } from "./subagent-lifecycle-events.js";
+import type {
+  SubagentLifecycleController,
+  SubagentLifecycleOptions,
+} from "./subagent-registry-lifecycle.js";
+import {
+  createRunEntry,
+  waitForLifecycleState,
+} from "./subagent-registry-lifecycle.test-fixtures.js";
+import { createSubagentRegistrationRecord } from "./subagent-registry-run-launch-record.js";
+import type { SubagentRunRecord } from "./subagent-registry.types.js";
+
+type AnnounceFlowOutcome = Awaited<ReturnType<SubagentLifecycleOptions["runSubagentAnnounceFlow"]>>;
+
+// Register within the lifecycle suite to retain its real controller, mocks, and hooks.
+export function registerCompletionDeliveryWindowCases({
+  createLifecycleController,
+  completionDeliveryMocks,
+}: {
+  createLifecycleController: (
+    params: {
+      entry: SubagentRunRecord;
+      runs?: Map<string, SubagentRunRecord>;
+    } & Partial<SubagentLifecycleOptions>,
+  ) => SubagentLifecycleController;
+  completionDeliveryMocks: { blockSubagentCompletionDelivery: ReturnType<typeof vi.fn> };
+}): void {
+  it.each(["matching", "legacy", "source-replaced", "parent-replaced"] as const)(
+    "transfers ordinary cleanup requester credentials only from a %s registration",
+    async (mode) => {
+      const scope = {
+        requesterSenderId: "alice",
+        agentAccountId: "work",
+        messageChannel: "discord",
+      };
+      const entry = createSubagentRegistrationRecord(
+        {
+          ...createRunEntry(),
+          completionRequesterSessionId: "parent-original",
+          requesterMcpScope: mode === "legacy" ? undefined : scope,
+          expectsCompletionMessage: true,
+          retainAttachmentsOnKeep: true,
+        },
+        { now: Date.now(), generation: 1, lifecycleGeneration: getAgentEventLifecycleGeneration() },
+      );
+      entry.execution = {
+        ...entry.execution,
+        status: "terminal",
+        endedAt: Date.now(),
+        outcome: { status: "ok" },
+      };
+      entry.completion = { required: true, resultText: "review complete" };
+      const runs = new Map([[entry.runId, entry]]);
+      let accepted: ReturnType<typeof consumeSubagentCompletionToolHandoff>;
+      let sourceAssertion: (() => void) | undefined;
+      const runSubagentAnnounceFlow = vi.fn<SubagentLifecycleOptions["runSubagentAnnounceFlow"]>(
+        async (params) => {
+          expect(params.completionRequesterSessionId).toBe("parent-original");
+          expect(params).not.toHaveProperty("senderIsOwner");
+          expect(params.requesterMcpContext?.mcpRequesterScope).toEqual(
+            mode === "legacy" ? undefined : scope,
+          );
+          sourceAssertion = params.requesterMcpContext?.mcpRequesterScopeAssertCurrent;
+          const registration = {
+            ...params.requesterMcpContext,
+            sourceSessionKey: entry.childSessionKey,
+            sourceSessionId: "child-original",
+            targetSessionKey: entry.requesterSessionKey,
+            targetSessionId: "parent-original",
+            idempotencyKey: "ordinary-completion",
+          };
+          if (mode === "source-replaced") {
+            runs.set(entry.runId, { ...entry });
+            expect(() => registerSubagentCompletionToolHandoff(registration)).toThrow(
+              "no longer current",
+            );
+            return "intentional_non_delivery";
+          }
+          const handoffId = registerSubagentCompletionToolHandoff(registration);
+          expect(handoffId).toBeTypeOf("string");
+          try {
+            accepted = consumeSubagentCompletionToolHandoff({
+              ...registration,
+              handoffId,
+              sourceTool: "subagent_announce",
+              targetSessionId: mode === "parent-replaced" ? "parent-successor" : "parent-original",
+              provider: "openai",
+              model: "fixture-model",
+            });
+            if (mode === "parent-replaced") {
+              expect(accepted).toBeUndefined();
+              return "intentional_non_delivery";
+            }
+            expect(accepted?.mcpRequesterScope).toEqual(mode === "legacy" ? undefined : scope);
+            expect(accepted).not.toHaveProperty("senderId");
+            params.onDeliveryResult?.({ delivered: true, path: "direct" });
+            return "delivered";
+          } finally {
+            cancelSubagentCompletionToolHandoff(handoffId);
+          }
+        },
+      );
+      const controller = createLifecycleController({ entry, runs, runSubagentAnnounceFlow });
+      try {
+        expect(controller.startSubagentAnnounceCleanupFlow(entry.runId, entry)).toBe(true);
+        await waitForLifecycleState(() => expect(runSubagentAnnounceFlow).toHaveBeenCalledOnce());
+        await expect(runSubagentAnnounceFlow.mock.results[0]?.value).resolves.toBe(
+          mode === "source-replaced" || mode === "parent-replaced"
+            ? "intentional_non_delivery"
+            : "delivered",
+        );
+        if (mode === "matching" || mode === "legacy") {
+          await waitForLifecycleState(() => expect(entry.cleanupCompletedAt).toBeTypeOf("number"));
+          runs.delete(entry.runId);
+          if (mode === "matching") {
+            expect(() => sourceAssertion?.()).toThrow("no longer current");
+            expect(accepted?.mcpRequesterScope).toEqual(scope);
+          }
+        }
+        await waitForLifecycleState(() => expect(getActiveGatewayRootWorkCount()).toBe(0));
+      } finally {
+        controller.clearScheduledResumeTimers();
+      }
+    },
+  );
+
+  it("admits a held parent completion before starting its delivery window", async () => {
+    vi.useFakeTimers();
+    vi.setSystemTime(4_000_000);
+    const entry = createRunEntry({
+      completionTarget: "parent",
+      requesterTurnRunId: "held-requester-turn",
+      expectsCompletionMessage: true,
+      endedAt: Date.now(),
+      completion: { required: true, resultText: "retained review result" },
+      delivery: { status: "pending" },
+      outcome: { status: "ok" },
+    });
+    let deliverySignal: AbortSignal | undefined;
+    const runSubagentAnnounceFlow = vi.fn<SubagentLifecycleOptions["runSubagentAnnounceFlow"]>(
+      async (params) => {
+        deliverySignal = params.signal;
+        expect(deliverySignal?.aborted).toBe(false);
+        params.onDeliveryResult?.({ delivered: true, path: "direct" });
+        return "delivered";
+      },
+    );
+    const controller: SubagentLifecycleController = createLifecycleController({
+      entry,
+      runSubagentAnnounceFlow,
+      resumeSubagentRun: (runId) => {
+        expect(runId).toBe(entry.runId);
+        controller.startSubagentAnnounceCleanupFlow(runId, entry);
+      },
+    });
+    try {
+      expect(controller.startSubagentAnnounceCleanupFlow(entry.runId, entry)).toBe(false);
+      await vi.advanceTimersByTimeAsync(40 * 60_000);
+      expect(runSubagentAnnounceFlow).not.toHaveBeenCalled();
+      expect(entry.completion?.resultText).toBe("retained review result");
+      expect(
+        controller.settleRequesterTurnAfterSessionSpawns({
+          requesterSessionKey: entry.requesterSessionKey,
+          requesterTurnRunId: "held-requester-turn",
+          requesterYielded: false,
+          acceptedSessionSpawns: [
+            {
+              runId: entry.runId,
+              childSessionKey: entry.childSessionKey,
+              expectsCompletionMessage: true,
+            },
+          ],
+        }),
+      ).toBe(true);
+      await vi.advanceTimersByTimeAsync(0);
+      await waitForLifecycleState(() => expect(runSubagentAnnounceFlow).toHaveBeenCalledOnce());
+      expect(deliverySignal?.aborted).toBe(false);
+      await waitForLifecycleState(() => expect(entry.delivery?.status).toBe("delivered"));
+      expect(entry.delivery?.windowStartedAt).toBe(6_400_000);
+      expect(entry.delivery?.deadlineAt).toBe(8_200_000);
+    } finally {
+      controller.clearScheduledResumeTimers();
+      vi.useRealTimers();
+    }
+  });
+
+  it.each([
+    { name: "original window", required: true, redriven: false, replaced: false },
+    { name: "explicit retry window", required: true, redriven: true, replaced: false },
+    { name: "retired owner", required: true, redriven: false, replaced: true },
+    { name: "optional completion window", required: false, redriven: false, replaced: false },
+  ])(
+    "bounds a pending completion handoff by its $name",
+    async ({ required, redriven, replaced }) => {
+      vi.useFakeTimers();
+      vi.setSystemTime(2_000_000);
+      const deadlineAt = Date.now() + (redriven ? 3_000 : 1_000);
+      const entry = createRunEntry({
+        endedAt: Date.now() - (required ? 30 : 5) * 60_000 + 1_000,
+        endedReason: SUBAGENT_ENDED_REASON_COMPLETE,
+        expectsCompletionMessage: required ? true : undefined,
+        completion: { required, resultText: "final answer" },
+        delivery: {
+          status: "pending",
+          ...(redriven ? { windowStartedAt: Date.now(), deadlineAt } : {}),
+        },
+        outcome: { status: "ok" },
+        retainAttachmentsOnKeep: true,
+      });
+      const pendingHandoff = createDeferredCore<AnnounceFlowOutcome>();
+      let deliverySignal: AbortSignal | undefined;
+      const runSubagentAnnounceFlow = vi.fn<SubagentLifecycleOptions["runSubagentAnnounceFlow"]>(
+        (params) => {
+          deliverySignal = params.signal;
+          params.signal?.addEventListener(
+            "abort",
+            () => pendingHandoff.reject(params.signal?.reason),
+            {
+              once: true,
+            },
+          );
+          return pendingHandoff.promise;
+        },
+      );
+      const runs = new Map([[entry.runId, entry]]);
+      const controller = createLifecycleController({ entry, runs, runSubagentAnnounceFlow });
+      try {
+        expect(controller.startSubagentAnnounceCleanupFlow(entry.runId, entry)).toBe(true);
+        await waitForLifecycleState(() => expect(runSubagentAnnounceFlow).toHaveBeenCalledOnce());
+        const successor = replaced ? createRunEntry({ runId: entry.runId }) : undefined;
+        if (successor) {
+          runs.set(entry.runId, successor);
+        }
+
+        await vi.advanceTimersByTimeAsync(deadlineAt - Date.now() - 1);
+        expect(entry.delivery?.status).toBe("pending");
+        expect(completionDeliveryMocks.blockSubagentCompletionDelivery).not.toHaveBeenCalled();
+        await vi.advanceTimersByTimeAsync(1);
+
+        expect(deliverySignal?.aborted).toBe(true);
+        await waitForLifecycleState(() => expect(getActiveGatewayRootWorkCount()).toBe(0));
+        if (successor) {
+          expect(runs.get(entry.runId)).toBe(successor);
+          expect(completionDeliveryMocks.blockSubagentCompletionDelivery).not.toHaveBeenCalled();
+        } else if (!required) {
+          expect(entry.delivery?.status).toBe("failed");
+          expect(entry.cleanupCompletedAt).toBeTypeOf("number");
+          expect(completionDeliveryMocks.blockSubagentCompletionDelivery).not.toHaveBeenCalled();
+        } else {
+          expect(entry.delivery?.status).toBe("suspended");
+          expect(entry.delivery?.suspendedReason).toBe("expiry");
+          expect(entry.completion?.resultText).toBe("final answer");
+          expect(entry.cleanupHandled).toBe(false);
+          expect(entry.cleanupCompletedAt).toBeUndefined();
+        }
+      } finally {
+        pendingHandoff.resolve("retryable");
+        await vi.advanceTimersByTimeAsync(0);
+        controller.clearScheduledResumeTimers();
+        vi.useRealTimers();
+      }
+    },
+  );
+}

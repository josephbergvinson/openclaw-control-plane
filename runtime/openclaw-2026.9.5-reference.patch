@@ -0,0 +1,673 @@
+import type { OAuthClientProvider } from "@modelcontextprotocol/sdk/client/auth.js";
+import { expectDefined } from "@openclaw/normalization-core";
+import type { Context, Model } from "openclaw/plugin-sdk/llm";
+import { Type } from "typebox";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { withTestTimeout } from "../../../../test/helpers/promise.js";
+import type { OpenClawConfig } from "../../../config/types.openclaw.js";
+import { createDeferredCore } from "../../../shared/deferred.js";
+import { startCatalogRecoveryMcpServer } from "../../agent-bundle-mcp-catalog-recovery.test-support.js";
+import { createSessionMcpRuntimeManager } from "../../agent-bundle-mcp-manager.js";
+import { materializeBundleMcpToolsForRun } from "../../agent-bundle-mcp-materialize.js";
+import { SESSION_MCP_RUNTIME_MANAGER_KEY } from "../../agent-bundle-mcp-runtime-shared.js";
+import { resolveConversationCapabilityProfile } from "../../conversation-capability-profile.js";
+import { requesterMcpOAuthIdentity } from "../../mcp-oauth-identity.js";
+import { readMcpOAuthStore, updateMcpOAuthStore } from "../../mcp-oauth-store.js";
+import { completeOAuthCallback } from "../../mcp-oauth.js";
+import { withTempHome } from "../../mcp-oauth.test-harness.js";
+import { resolveMcpTransportConfig } from "../../mcp-transport-config.js";
+import {
+  createAssistant,
+  createAssistantResultStream,
+  streamMocks,
+  testModel,
+} from "../../sessions/agent-session-loop-correctness.test-support.js";
+import { createResourceLoader } from "../../sessions/agent-session-loop-resource-loader.test-support.js";
+import { AuthStorage } from "../../sessions/auth-storage.js";
+import { ModelRegistry } from "../../sessions/model-registry.js";
+import { SessionManager } from "../../sessions/session-manager.js";
+import { SettingsManager } from "../../sessions/settings-manager.js";
+import { resolveToolSearchConfig } from "../../tool-search-config.js";
+import { prepareEmbeddedAttemptBundleTools } from "./attempt-bundle-tools.js";
+import { createPromptBuildToolPolicy } from "./attempt-prompt-support.js";
+import { prepareEmbeddedAttemptAgentSession } from "./attempt-session-prepare.js";
+import { createAttemptSetupFixture } from "./attempt-setup.test-support.js";
+import { prepareEmbeddedAttemptToolCatalog } from "./attempt-tool-catalog.js";
+import type { EmbeddedRunAttemptParams } from "./types.js";
+
+const mocks = vi.hoisted(() => ({ auth: vi.fn(), acquire: vi.fn() }));
+vi.mock("@modelcontextprotocol/sdk/client/auth.js", () => ({
+  auth: mocks.auth,
+  UnauthorizedError: class extends Error {},
+  // The isolated HTTP fixture has no authentication challenge. Native bearer,
+  // OAuth lease/store, requester identity and transport remain production code.
+  extractWWWAuthenticateParams: () => ({}),
+}));
+vi.mock("../../../llm/stream.js", () => ({
+  streamSimple: (...args: unknown[]) => streamMocks.streamSimple(...args),
+}));
+vi.mock("../../../plugins/hook-runner-global.js", () => ({ getGlobalHookRunner: () => undefined }));
+vi.mock("../../agent-bundle-lsp-runtime.js", () => ({
+  createBundleLspToolRuntime: async () => undefined,
+}));
+vi.mock("../../agent-bundle-mcp-tools.js", () => ({
+  acquireSessionMcpRuntime: (...args: unknown[]) => mocks.acquire(...args),
+  materializeBundleMcpToolsForRun: (...args: Parameters<typeof materializeBundleMcpToolsForRun>) =>
+    materializeBundleMcpToolsForRun(...args),
+}));
+vi.mock("../../agent-project-settings.js", () => ({
+  createPreparedEmbeddedAgentSettingsManager: () =>
+    SettingsManager.inMemory({ compaction: { enabled: false }, retry: { enabled: false } }),
+}));
+vi.mock("../../agent-settings.js", () => ({
+  applyAgentAutoCompactionGuard: () => {},
+  applyAgentCompactionSettingsFromConfig: () => {},
+  isSilentOverflowProneModel: () => false,
+  resolveEffectiveCompactionMode: () => "safeguard",
+}));
+vi.mock("../../runtime-plan/tools.js", () => ({
+  normalizeAgentRuntimeTools: ({ tools }: { tools: unknown[] }) => [...tools],
+  logAgentRuntimeToolDiagnostics: () => {},
+}));
+vi.mock("../extensions.js", () => ({ buildEmbeddedExtensionFactories: () => [] }));
+vi.mock("../resource-loader.js", () => ({
+  createEmbeddedAgentResourceLoader: () => createResourceLoader(),
+}));
+
+beforeEach(() => {
+  mocks.auth.mockReset();
+  mocks.acquire.mockReset();
+  streamMocks.streamSimple.mockReset();
+});
+
+type Boundary =
+  | "ordinary"
+  | "inherited"
+  | "inherited-revoked"
+  | "admission-expired"
+  | "requires-authorization"
+  | "tokenless-authorized"
+  | "post-publication"
+  | "prior-context"
+  | "prior-stop"
+  | "pending"
+  | "pending-completed"
+  | "empty"
+  | "wrong-owner"
+  | "revoked"
+  | "generation"
+  | "generation-same-config"
+  | "abort";
+
+async function withContinuation(
+  boundary: Boundary,
+  run: (fixture: {
+    prompt: Promise<void>;
+    requests: string[][];
+    server: Awaited<ReturnType<typeof startCatalogRecoveryMcpServer>>;
+    rotate: () => Promise<void>;
+    abort: () => void;
+    refreshEntered: Promise<void>;
+    sessionId: string;
+    originalStoreKey: string;
+    nativeError: () => string | undefined;
+  }) => Promise<void>,
+) {
+  await withTempHome(
+    async (home) => {
+      const initiallyUnauthorized =
+        boundary === "requires-authorization" ||
+        boundary === "tokenless-authorized" ||
+        boundary === "pending-completed";
+      const server = await startCatalogRecoveryMcpServer("recovery", {
+        failFirstList: !initiallyUnauthorized,
+        failRecoveryList: boundary === "empty",
+        holdFirstList: initiallyUnauthorized,
+      });
+      server.allowCalls();
+      const manager = createSessionMcpRuntimeManager({ enableIdleSweepTimer: false });
+      const singleton = globalThis as Record<PropertyKey, unknown>;
+      const previousManager = singleton[SESSION_MCP_RUNTIME_MANAGER_KEY];
+      singleton[SESSION_MCP_RUNTIME_MANAGER_KEY] = manager;
+      const runAbort = new AbortController();
+      const generation = new AbortController();
+      const sessionManager = SessionManager.inMemory(home);
+      const sessionId = sessionManager.getSessionId();
+      const scope = {
+        requesterSenderId: "alice",
+        agentAccountId: "bot",
+        messageChannel: "discord",
+      };
+      let inheritedScopeCurrent = true;
+      const identity = requesterMcpOAuthIdentity("recovery", server.url, scope);
+      const cfg: OpenClawConfig = {
+        plugins: { enabled: false },
+        gateway: { publicOrigin: "https://gateway.example" },
+        tools: { profile: "full", toolSearch: { enabled: false } },
+        mcp: {
+          servers: {
+            recovery: {
+              transport: "streamable-http",
+              url: server.url,
+              auth: "oauth",
+              oauth: { identity: "per-requester", scope: "offline_access recovery:read" },
+              requestTimeoutMs: 2_000,
+            },
+          },
+        },
+      };
+      const tokenless =
+        boundary === "pending" ||
+        boundary === "pending-completed" ||
+        boundary === "tokenless-authorized";
+      updateMcpOAuthStore(identity.storeKey, () => ({
+        clientInformation: { client_id: "original-client" },
+        ...(tokenless
+          ? {}
+          : {
+              tokens: {
+                access_token: "fixture-original-access",
+                refresh_token: "fixture-original-refresh",
+                token_type: "Bearer",
+                scope: "offline_access recovery:read",
+              },
+              tokenExpiresAt: Date.now() + (boundary === "admission-expired" ? -60_000 : 120_000),
+              ...(boundary === "requires-authorization"
+                ? { pendingAuthorizationChallenge: { requiresAuthorization: true } }
+                : {}),
+            }),
+      }));
+      const authStorage = AuthStorage.inMemory();
+      authStorage.setRuntimeApiKey(testModel.provider, "fixture-model-key");
+      const modelRegistry = ModelRegistry.inMemory(authStorage);
+      modelRegistry.registerProvider(testModel.provider, {
+        api: testModel.api,
+        streamSimple: streamMocks.streamSimple,
+      });
+      const attempt = {
+        config: cfg,
+        authStorage,
+        modelRegistry,
+        model: testModel,
+        modelId: testModel.id,
+        provider: testModel.provider,
+        runId: "original-run",
+        sessionId,
+        sessionKey: "agent:main:discord:channel:fixture",
+        senderId: scope.requesterSenderId,
+        agentAccountId: scope.agentAccountId,
+        messageChannel: scope.messageChannel,
+        workspaceDir: home,
+        runtimePlan: {},
+        contextTokenBudget: testModel.contextWindow,
+      } as unknown as EmbeddedRunAttemptParams;
+      if (boundary === "inherited" || boundary === "inherited-revoked") {
+        attempt.senderId = undefined;
+        attempt.senderIsOwner = false;
+        attempt.mcpRequesterScope = { ...scope };
+        attempt.mcpRequesterScopeAssertCurrent = () => {
+          if (!inheritedScopeCurrent) {
+            throw new Error("inherited requester task retired");
+          }
+        };
+      }
+      const setup = createAttemptSetupFixture({ effectiveCwd: home, effectiveWorkspace: home });
+      const callbackTransport = expectDefined(
+        resolveMcpTransportConfig("recovery", cfg.mcp?.servers?.recovery, { logWarnings: false }),
+        "callback transport",
+      );
+      if (callbackTransport.kind !== "http") {
+        throw new Error("callback fixture requires HTTP transport");
+      }
+      const toolBase = {
+        toolsRaw:
+          boundary === "pending-completed"
+            ? [
+                {
+                  name: "browser",
+                  label: "Browser callback fixture",
+                  description: "Complete the original requester's pending sign-in.",
+                  parameters: Type.Object({}),
+                  execute: async () => {
+                    // Only the external browser exchange is synthetic. The state,
+                    // callback claim, requester lease and saved grant use their real owners.
+                    expect(
+                      await completeOAuthCallback(identity, callbackTransport, {
+                        code: "fixture-code",
+                        state: "fixture",
+                      }),
+                    ).toBe("authorized");
+                    return {
+                      content: [{ type: "text", text: "Original requester sign-in completed." }],
+                      details: {},
+                    };
+                  },
+                },
+              ]
+            : [],
+        toolsEnabled: true,
+        toolAbortSignal: generation.signal,
+        effectiveToolsAllow: undefined,
+        inheritedToolAllowlist: [],
+        cronCreatorToolAllowlist: [],
+        localModelLeanPreserveToolNames: [],
+        runtimeCapabilityProfile: resolveConversationCapabilityProfile({ config: cfg }),
+        toolSearchConfig: resolveToolSearchConfig(cfg),
+        toolSearchRuntimeConfig: cfg,
+        toolSearchControlsEnabledForRun: false,
+        codeModeControlsEnabledForRun: false,
+        codeModeSkills: [],
+        replaySafetyOptions: {},
+      } as unknown as Parameters<typeof prepareEmbeddedAttemptBundleTools>[0]["preparedToolBase"];
+      mocks.acquire.mockImplementation((params: Parameters<typeof manager.acquire>[0]) => {
+        expect(params.requesterSenderId).toBe(scope.requesterSenderId);
+        expect(params.agentAccountId).toBe(scope.agentAccountId);
+        expect(params.messageChannel).toBe(scope.messageChannel);
+        expect(params.sessionId).toBe(sessionId);
+        return manager.acquire(params);
+      });
+      let pendingAuthorizationIssued = false;
+      mocks.auth.mockImplementation(async (provider: OAuthClientProvider) => {
+        expect(await provider.clientInformation()).toMatchObject({ client_id: "original-client" });
+        if (
+          boundary === "pending" ||
+          (boundary === "pending-completed" && !pendingAuthorizationIssued)
+        ) {
+          pendingAuthorizationIssued = true;
+          await provider.saveCodeVerifier("fixture-code-verifier");
+          await provider.redirectToAuthorization(
+            new URL("https://auth.example/authorize?state=fixture"),
+          );
+          return "REDIRECT";
+        }
+        await provider.saveTokens({
+          access_token: "fixture-renewed-access",
+          refresh_token: "fixture-original-refresh",
+          token_type: "Bearer",
+          expires_in: 900,
+          scope: "offline_access recovery:read",
+        });
+        if (boundary === "wrong-owner") {
+          attempt.senderId = "bob";
+        } else if (boundary === "inherited-revoked") {
+          inheritedScopeCurrent = false;
+        } else if (boundary === "revoked") {
+          updateMcpOAuthStore(identity.storeKey, (store) => ({
+            ...store,
+            pendingAuthorizationChallenge: { requiresAuthorization: true },
+          }));
+        }
+        return "AUTHORIZED";
+      });
+      let bundle = await prepareEmbeddedAttemptBundleTools({
+        agentDir: home,
+        attempt,
+        setup,
+        isRawModelRun: false,
+        preparedToolBase: toolBase,
+        assertCurrent: () => runAbort.signal.throwIfAborted(),
+      });
+      if (boundary === "post-publication") {
+        await manager.reloadConfig({ cfg });
+        expect(bundle.bundleMcpRuntime?.isRequesterConnectRefreshCurrent?.()).toBe(false);
+        await bundle.bundleMcpRuntime?.dispose();
+        bundle = await prepareEmbeddedAttemptBundleTools({
+          agentDir: home,
+          attempt,
+          setup,
+          isRawModelRun: false,
+          preparedToolBase: toolBase,
+          assertCurrent: () => runAbort.signal.throwIfAborted(),
+        });
+        expect(bundle.bundleMcpRuntime?.isRequesterConnectRefreshCurrent?.()).toBe(true);
+      }
+      expect(bundle.uncompactedEffectiveTools.map((tool) => tool.name)).toEqual(
+        boundary === "pending-completed" ? ["browser", "recovery__connect"] : ["recovery__connect"],
+      );
+      const catalog = prepareEmbeddedAttemptToolCatalog({
+        attempt,
+        setup,
+        preparedToolBase: toolBase,
+        bundleTools: bundle,
+        abortSignal: runAbort.signal,
+        executeCodeModeTool: async () => ({ content: [], details: {} }),
+      });
+      let prepared: Awaited<ReturnType<typeof prepareEmbeddedAttemptAgentSession>> | undefined;
+      let policy: ReturnType<typeof createPromptBuildToolPolicy> | undefined;
+      const refreshEntered = createDeferredCore();
+      const requests: string[][] = [];
+      let originalPrompt: Promise<void> | undefined;
+      try {
+        prepared = await prepareEmbeddedAttemptAgentSession({
+          attempt,
+          agentCoreThinkingLevel: "off",
+          agentDir: home,

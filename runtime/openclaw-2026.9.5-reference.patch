+import type { OpenClawConfig } from "../../../config/types.openclaw.js";
+import { createDeferredCore } from "../../../shared/deferred.js";
+import { startCatalogRecoveryMcpServer } from "../../agent-bundle-mcp-catalog-recovery.test-support.js";
+import { createSessionMcpRuntimeManager } from "../../agent-bundle-mcp-manager.js";
+import { materializeBundleMcpToolsForRun } from "../../agent-bundle-mcp-materialize.js";
+import { SESSION_MCP_RUNTIME_MANAGER_KEY } from "../../agent-bundle-mcp-runtime-shared.js";
+import { resolveConversationCapabilityProfile } from "../../conversation-capability-profile.js";
+import { requesterMcpOAuthIdentity } from "../../mcp-oauth-identity.js";
+import { readMcpOAuthStore, updateMcpOAuthStore } from "../../mcp-oauth-store.js";
+import { withTempHome } from "../../mcp-oauth.test-harness.js";
+import {
+  createAssistant,
+  createAssistantResultStream,
+  streamMocks,
+  testModel,
+} from "../../sessions/agent-session-loop-correctness.test-support.js";
+import { createResourceLoader } from "../../sessions/agent-session-loop-resource-loader.test-support.js";
+import { AuthStorage } from "../../sessions/auth-storage.js";
+import { ModelRegistry } from "../../sessions/model-registry.js";
+import { SessionManager } from "../../sessions/session-manager.js";

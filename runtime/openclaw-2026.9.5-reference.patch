+import { describe, expect, it, vi } from "vitest";
+import { createDrainRecorder, createQueueSettings } from "./queue.collect.test-support.js";
+import { enqueueFollowupRun, scheduleFollowupDrain } from "./queue.js";
+import {
+  createQueueTestRun as createRun,
+  installQueueRuntimeErrorSilencer,
+} from "./queue.test-helpers.js";
+import { resolveFollowupDeliveryContextKey } from "./queue/drain.js";
+
+installQueueRuntimeErrorSilencer();
+
+describe("queued MCP requester lifetime isolation", () => {
+  it.each(["same-profile", "different-profile"])(
+    "drains %s MCP requesters separately and retains each live callback",
+    async (identity) => {
+      const key = `test-collect-mcp-requester-${identity}-${Date.now()}`;
+      const { calls, done, runFollowup } = createDrainRecorder(2);
+      const first = createRun({ prompt: "first requester input" });
+      const second = createRun({ prompt: "second requester input" });
+      const assertFirst = vi.fn();
+      const assertSecond = vi.fn();
+      first.run.mcpRequesterScope = {
+        requesterSenderId: "profile-first",
+        messageChannel: "webchat",
+      };
+      first.run.mcpRequesterScopeAssertCurrent = assertFirst;
+      second.run.mcpRequesterScope = {
+        requesterSenderId: identity === "same-profile" ? "profile-first" : "profile-second",
+        messageChannel: "webchat",
+      };
+      second.run.mcpRequesterScopeAssertCurrent = assertSecond;
+      expect(resolveFollowupDeliveryContextKey(first)).not.toBe(
+        resolveFollowupDeliveryContextKey(second),
+      );
+      const settings = createQueueSettings();
+      enqueueFollowupRun(key, first, settings);
+      enqueueFollowupRun(key, second, settings);
+      scheduleFollowupDrain(key, runFollowup);
+      await done.promise;
+      expect(calls.map((call) => call.prompt)).toEqual([first.prompt, second.prompt]);
+      expect(calls[0]?.run.mcpRequesterScopeAssertCurrent).toBe(assertFirst);
+      expect(calls[1]?.run.mcpRequesterScopeAssertCurrent).toBe(assertSecond);
+      expect(calls[0]?.run.mcpRequesterScope).toEqual(first.run.mcpRequesterScope);
+      expect(calls[1]?.run.mcpRequesterScope).toEqual(second.run.mcpRequesterScope);
+    },
+  );
+
+  it("keeps overflow summaries bound to each original UI requester callback", async () => {
+    const key = `test-overflow-mcp-requester-${Date.now()}`;
+    const { calls, done, runFollowup } = createDrainRecorder(3);
+    const first = createRun({ prompt: "first source" });
+    const second = createRun({ prompt: "second source" });
+    const assertFirst = vi.fn();
+    const assertSecond = vi.fn();
+    first.run.mcpRequesterScope = { requesterSenderId: "profile-ui", messageChannel: "webchat" };
+    first.run.mcpRequesterScopeAssertCurrent = assertFirst;
+    second.run.mcpRequesterScope = { requesterSenderId: "profile-ui", messageChannel: "webchat" };
+    second.run.mcpRequesterScopeAssertCurrent = assertSecond;
+    const settings = createQueueSettings({ cap: 1, dropPolicy: "summarize" });
+    enqueueFollowupRun(key, first, settings);
+    enqueueFollowupRun(key, second, settings);
+    enqueueFollowupRun(key, createRun({ prompt: "remaining source" }), settings);
+    scheduleFollowupDrain(key, runFollowup);
+    await done.promise;
+    expect(calls[0]?.run.mcpRequesterScopeAssertCurrent).toBe(assertFirst);
+    expect(calls[1]?.run.mcpRequesterScopeAssertCurrent).toBe(assertSecond);
+    expect(calls[2]?.prompt).toContain("remaining source");
+    expect(calls[2]?.run.mcpRequesterScope).toBeUndefined();
+    expect(calls[2]?.run.mcpRequesterScopeAssertCurrent).toBeUndefined();
+  });
+});

+import fs from "node:fs/promises";
+import path from "node:path";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { createDeferred } from "../../../test/helpers/promise.js";
+import { useAutoCleanupTempDirTracker } from "../../../test/helpers/temp-dir.js";
+import { resolveBootstrapContextForRun } from "../../agents/bootstrap-files.js";
+import type { RunCliAgentParams } from "../../agents/cli-runner/types.js";
+import type { RunEmbeddedAgentParams } from "../../agents/embedded-agent-runner/run/params.js";
+import { clearInternalHooks } from "../../hooks/internal-hooks.js";
+import { closeOpenClawAgentDatabasesForTest } from "../../state/openclaw-agent-db.js";
+import { makeIsolatedAgentJobFixture, makeIsolatedAgentParamsFixture } from "./job-fixtures.js";
+import { requireDeliveryRequest } from "./run.interim-retry.test-support.js";
+import { setupRunCronIsolatedAgentTurnSuite } from "./run.suite-helpers.js";
+import {
+  callGatewayMock,
+  dispatchCronDeliveryMock,
+  ensureAgentWorkspaceMock,
+  isCliProviderMock,
+  loadRunCronIsolatedAgentTurn,
+  makeCronSession,
+  makeCronSessionEntry,
+  mockRunCronFallbackPassthrough,
+  pickLastNonEmptyTextFromPayloadsMock,
+  resolveCronDeliveryPlanMock,
+  resolveCronSessionMock,
+  runCliAgentMock,
+  runEmbeddedAgentMock,
+  settleCronRequesterYieldBatchMock,
+} from "./run.test-harness.js";
+
+const runCronIsolatedAgentTurn = await loadRunCronIsolatedAgentTurn();
+setupRunCronIsolatedAgentTurnSuite();
+beforeEach(() => clearInternalHooks());
+afterEach(() => clearInternalHooks());
+const tempDirs = useAutoCleanupTempDirTracker((cleanup) =>
+  afterEach(() => {
+    closeOpenClawAgentDatabasesForTest();
+    cleanup();
+  }),
+);
+
+type ModelRequest = RunEmbeddedAgentParams | RunCliAgentParams;
+type Flow = "initial" | "ack" | "yield";
+const choices = [
+  { choice: "omitted", lightContext: undefined },
+  { choice: "full", lightContext: false },
+  { choice: "light", lightContext: true },
+] as const;
+const runners = ["embedded", "cli"] as const;
+const cases = runners.flatMap((runner) =>
+  choices.flatMap((choice) =>
+    (["initial", "ack", "yield"] as const).map((flow) => ({
+      runner,
+      choice: choice.choice,
+      lightContext: choice.lightContext,
+      flow,
+    })),
+  ),
+);
+const instructions = {
+  "AGENTS.md":
+    "Finish the original authorized outcome after enabling work; honor other owners' holds.",
+  "SOUL.md":
+    "Investigate concrete evidence and continue the task rather than giving generic advice.",
+  "USER.md": "Reuse authorized connected services without asking the requester to repeat the task.",
+  "IDENTITY.md": "The configured agent owns completing its original requested outcome.",
+  "TOOLS.md":
+    "Use the configured tools to verify the requested result before reporting completion.",
+};
+const toolsAllow = ["exec", "process", "read", "sessions_spawn", "sessions_yield"];
+const originalMessage = "gh pr checks 13 then investigate and fix every failed check";
+const parentFinal = "The original task is complete: the requested result was verified.";
+const childFinding =
+  "Private child evidence: the failed check has a recoverable configuration cause.";
+
+/** Runs the real cron preparation/retry/yield owner with a synthetic model boundary. */
+async function observeTurn(params: {
+  runner: (typeof runners)[number];
+  lightContext: boolean | undefined;
+  flow: Flow;
+  isolated?: boolean;
+}) {
+  const workspaceDir = tempDirs.make("cron-bootstrap-continuation-");
+  await Promise.all(
+    Object.entries(instructions).map(([name, content]) =>
+      fs.writeFile(path.join(workspaceDir, name), content),
+    ),
+  );
+  await fs.writeFile(path.join(workspaceDir, "MEMORY.md"), "Private root memory fixture.");
+  ensureAgentWorkspaceMock.mockResolvedValue({ dir: workspaceDir });
+  const sessionId = "bootstrap-continuation-session";
+  resolveCronSessionMock.mockReturnValue(
+    makeCronSession({ sessionEntry: makeCronSessionEntry({ sessionId }) }),
+  );
+  isCliProviderMock.mockReturnValue(params.runner === "cli");
+  mockRunCronFallbackPassthrough();
+  pickLastNonEmptyTextFromPayloadsMock.mockImplementation(
+    (payloads?: Array<{ text?: string }>) =>
+      payloads?.findLast((payload) => payload.text?.trim())?.text ?? "",
+  );
+  resolveCronDeliveryPlanMock.mockReturnValue({
+    requested: true,
+    mode: "announce",
+    channel: "messagechat",
+    to: "context-test-target",
+  });
+  const captures: Array<{
+    request: ModelRequest;
+    abortedAtExecution: boolean;
+    context: Awaited<ReturnType<typeof resolveBootstrapContextForRun>>;
+  }> = [];
+  const childDone = createDeferred<{
+    status: string;
+    endedAt: number;
+    terminalReply: { disposition: string; text: string };
+  }>();
+  const waitStarted = createDeferred();
+  const childRunId = "bootstrap-child-run";
+  callGatewayMock.mockImplementation(async (request) => {
+    if (request.method !== "agent.wait") {
+      return { ok: true, deleted: true };
+    }
+    expect(request.params.runId).toBe(childRunId);
+    expect(request.params.timeoutMs).toBeGreaterThan(0);
+    expect(request.params.timeoutMs).toBeLessThanOrEqual(1_000);
+    expect(dispatchCronDeliveryMock).not.toHaveBeenCalled();
+    waitStarted.resolve();
+    return childDone.promise;
+  });
+  const model = params.runner === "cli" ? runCliAgentMock : runEmbeddedAgentMock;
+  model.mockImplementation(async (request: ModelRequest) => {
+    // Call through the real file loader with precisely the context selection that
+    // this actual attempt received. The model/provider itself is a stand-in.
+    const context = await resolveBootstrapContextForRun({
+      workspaceDir: request.workspaceDir,
+      config: request.config,
+      agentId: request.agentId,
+      sessionKey: request.sessionKey,
+      sessionId: request.sessionId,
+      contextMode: request.bootstrapContextMode,
+      runKind: request.bootstrapContextRunKind,
+    });
+    captures.push({ request, context, abortedAtExecution: request.abortSignal?.aborted === true });
+    const first = captures.length === 1;
+    if (first && params.flow === "ack") {
+      return {
+        payloads: [{ text: "On it, checking the report now." }],
+        meta: { agentMeta: { usage: { input: 1, output: 1 } } },
+      };
+    }
+    if (first && params.flow === "yield") {
+      return {
+        payloads: [],
+        acceptedSessionSpawns: [
+          {
+            runId: childRunId,
+            childSessionKey: "agent:main:subagent:bootstrap-child",
+            expectsCompletionMessage: true,
+          },
+        ],
+        meta: { yielded: true, agentMeta: { usage: { input: 1, output: 1 } } },
+      };
+    }
+    return {
+      payloads: [{ text: parentFinal }],
+      meta: {
+        finalAssistantVisibleText: parentFinal,
+        agentMeta: { usage: { input: 1, output: 1 } },
+      },
+    };
+  });
+  const jobId = "bootstrap-policy-job";
+  const sessionKey = params.isolated ? "cron:bootstrap-policy" : "bootstrap-policy";
+  const turn = runCronIsolatedAgentTurn(
+    makeIsolatedAgentParamsFixture({
+      agentId: "main",
+      cfg: { agents: { list: [{ id: "main", workspace: workspaceDir }] } },
+      sessionKey,
+      message: originalMessage,
+      job: makeIsolatedAgentJobFixture({
+        id: jobId,
+        sessionTarget: params.isolated ? "isolated" : "session:bootstrap-policy",
+        payload: {
+          kind: "agentTurn",
+          message: originalMessage,
+          timeoutSeconds: 60,
+          toolsAllow,
+          ...(params.lightContext !== undefined ? { lightContext: params.lightContext } : {}),
+        },
+        delivery: { mode: "announce", channel: "messagechat", to: "context-test-target" },
+      }),
+    }),
+  );
+  if (params.flow === "yield") {
+    try {
+      await Promise.race([
+        waitStarted.promise,
+        turn.then((result) => {
+          throw new Error(`Parent finalized before its accepted child settled: ${result.status}`);
+        }),
+      ]);
+      expect(captures).toHaveLength(1);
+      expect(dispatchCronDeliveryMock).not.toHaveBeenCalled();
+    } finally {
+      childDone.resolve({
+        status: "ok",
+        endedAt: Date.now(),
+        terminalReply: { disposition: "visible", text: childFinding },
+      });
+      await turn;
+    }
+  }
+  const result = await turn;
+  expect(result.status).toBe("ok");
+  expect(result.delivered).toBe(true);
+  expect(captures).toHaveLength(params.flow === "initial" ? 1 : 2);
+  expect(model).toHaveBeenCalledTimes(captures.length);
+  expect(params.runner === "cli" ? runEmbeddedAgentMock : runCliAgentMock).not.toHaveBeenCalled();
+  const expectedKey = params.isolated
+    ? `agent:main:cron:bootstrap-policy:run:${sessionId}`
+    : "agent:main:bootstrap-policy";
+  for (const { request, abortedAtExecution } of captures) {
+    expect(request.workspaceDir).toBe(workspaceDir);
+    expect(request.sessionId).toBe(sessionId);
+    expect(request.sessionKey).toBe(expectedKey);
+    expect(request.bootstrapContextRunKind).toBe("cron");
+    expect(request.sessionTarget).toMatchObject({
+      agentId: "main",
+      sessionId,
+      sessionKey: expectedKey,
+    });
+    expect(request.toolsAllow).toEqual(toolsAllow);
+    // This fixture has no authenticated creator grant: context restoration must
+    // not fabricate one. Existing requester-grant whole-file controls are retained.
+    expect(request.mcpRequesterScope).toBeUndefined();
+    expect(request.mcpRequesterScopeAssertCurrent).toBeUndefined();
+    expect(request.timeoutMs).toBeGreaterThan(0);
+    expect(request.timeoutMs).toBeLessThanOrEqual(60_000);
+    expect(abortedAtExecution).toBe(false);
+  }
+  expect(captures[0]?.request.prompt).toContain(originalMessage);
+  if (params.flow !== "initial") {
+    expect(captures[1]?.request.timeoutMs).toBeLessThanOrEqual(captures[0]!.request.timeoutMs);
+    expect(captures[1]?.request.prompt).toContain(
+      params.flow === "ack" ? "Complete the original task now" : childFinding,
+    );
+    expect(captures[1]?.request.prompt).not.toContain(originalMessage);
+  }
+  if (params.flow === "yield") {
+    expect(settleCronRequesterYieldBatchMock).toHaveBeenCalledWith(
+      expect.objectContaining({ delivered: true, requesterVisibleFinalDelivered: true }),
+    );
+  }
+  expect(dispatchCronDeliveryMock).toHaveBeenCalledTimes(1);
+  expect(requireDeliveryRequest().deliveryPayloads).toEqual([{ text: parentFinal }]);
+  return captures;
+}
+
+describe("cron command-headed original-task bootstrap context", () => {
+  it.each(cases)(
+    "$runner keeps operator $choice context through the $flow original-task attempts",
+    async ({ runner, lightContext, flow }) => {
+      // Check after both actual attempts have completed, so a baseline context
+      // failure cannot intercept the retry/yield path being covered.
+      const captures = await observeTurn({ runner, lightContext, flow });
+      for (const { request, context } of captures) {
+        expect(request.bootstrapContextMode).toBe(
+          lightContext === true ? "lightweight" : undefined,
+        );
+        if (lightContext === true) {
+          expect(context.bootstrapFiles).toEqual([]);
+          expect(context.contextFiles).toEqual([]);
+        } else {
+          for (const name of ["AGENTS.md", "SOUL.md", "USER.md", "IDENTITY.md"] as const) {
+            expect(context.contextFiles).toContainEqual(
+              expect.objectContaining({
+                path: path.join(request.workspaceDir, name),
+                content: instructions[name],
+              }),
+            );
+          }
+          // Legacy TOOLS.md is not a recognized default bootstrap file. Restoring
+          // normal context must not silently expand that existing source contract.
+          expect(context.contextFiles.map((file) => path.basename(file.path))).not.toContain(
+            "TOOLS.md",
+          );
+        }
+      }
+    },
+    30_000,
+  );
+
+  it.each(runners)(
+    "%s restores eligible isolated-cron context without widening its bootstrap privacy filter",
+    async (runner) => {
+      const captures = await observeTurn({
+        runner,
+        lightContext: undefined,
+        flow: "initial",
+        isolated: true,
+      });
+      const context = captures[0]!.context;
+      for (const name of ["AGENTS.md", "SOUL.md", "USER.md", "IDENTITY.md"] as const) {
+        expect(context.contextFiles).toContainEqual(
+          expect.objectContaining({
+            path: path.join(captures[0]!.request.workspaceDir, name),
+            content: instructions[name],
+          }),
+        );
+      }
+      const names = context.contextFiles.map((file) => path.basename(file.path));
+      expect(names).not.toContain("TOOLS.md");
+      expect(names).not.toContain("MEMORY.md");
+    },
+    30_000,
+  );
+});

@@ -0,0 +1,15 @@
+import type { DiscordDraftStream } from "./draft-stream.js";
+
+export type DiscordProgressWriterLease = {
+  revoked: boolean;
+  stream: DiscordDraftStream;
+  publishProgress?: (text: string, assertCurrent: () => void) => Promise<string | undefined>;
+};
+export type DiscordProgressWriter = {
+  acquiring: Promise<unknown>;
+  lease?: DiscordProgressWriterLease;
+  references: number;
+};
+
+/** The request-progress owner alone acquires and retires these process-local FIFO writers. */
+export const discordProgressWriters = new Map<string, DiscordProgressWriter>();
diff --git a/extensions/discord/src/request-progress.test.ts b/extensions/discord/src/request-progress.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e485b844c2bc6a5c39842436b808027b45896b8d
--- /dev/null
+++ b/extensions/discord/src/request-progress.test.ts
@@ -0,0 +1,721 @@
+import type { PluginRuntime } from "openclaw/plugin-sdk/channel-core";
+import {
+  createPluginStateKeyedStoreForTests as createPluginStateKeyedStore,
+  resetPluginStateStoreForTests,
+} from "openclaw/plugin-sdk/plugin-state-test-runtime";
+import { createOpenClawTestState, type OpenClawTestState } from "openclaw/plugin-sdk/test-state";
+import { afterAll, afterEach, beforeAll, beforeEach, describe, expect, it, vi } from "vitest";
+import { RequestClient } from "./internal/discord.js";
+import { createDiscordDraftPreviewController } from "./monitor/message-handler.draft-preview.js";
+import { discordProgressWriters } from "./request-progress-writer-state.js";
+import {
+  createDiscordRequestProgressStream,
+  type DiscordProgressScope,
+} from "./request-progress.js";
+import { setDiscordRuntime } from "./runtime.js";
+const client = vi.hoisted(() => ({ create: vi.fn() }));
+vi.mock("./client.js", () => ({ createDiscordRestClient: client.create }));
+import {
+  createDiscordContinuationProgress,
+  publishDiscordTaskProgress,
+} from "./continuation-progress.js";
+
+let state: OpenClawTestState;
+let nextRequest = 0;
+beforeAll(async () => {
+  state = await createOpenClawTestState({ label: "discord-original-progress" });
+});
+beforeEach(() => {
+  state.applyEnv();
+  setDiscordRuntime({
+    state: { openKeyedStore: (options) => createPluginStateKeyedStore("discord", options) },
+  } as PluginRuntime);
+});
+afterEach(() => {
+  resetPluginStateStoreForTests();
+});
+afterAll(async () => {
+  await state.cleanup();
+});
+
+function setup() {
+  const writes: Array<{ method: string; url: string; text?: string; nonce?: string }> = [];
+  const nonces = new Map<string, string>();
+  let accepted = 0;
+  let holdPatch: (() => Promise<void>) | undefined;
+  let loseAck = false;
+  let current = true;
+  const rest = new RequestClient("test-token", {
+    queueRequests: false,
+    fetch: async (url, init) => {
+      const body = typeof init?.body === "string" ? JSON.parse(init.body) : {};
+      writes.push({
+        method: init?.method ?? "GET",
+        url: typeof url === "string" ? url : url instanceof URL ? url.href : url.url,
+        text: body.content,
+        nonce: body.nonce,
+      });
+      if (init?.method === "DELETE") {
+        return new Response(null, { status: 204 });
+      }
+      if (init?.method === "PATCH") {
+        await holdPatch?.();
+      }
+      const id = body.nonce
+        ? (nonces.get(body.nonce) ?? `${1000 + ++accepted}`)
+        : `${1000 + ++accepted}`;
+      if (body.nonce) {
+        nonces.set(body.nonce, id);
+      }
+      if (loseAck && init?.method === "POST") {
+        loseAck = false;
+        throw new Error("provider accepted; acknowledgement lost");
+      }
+      return Response.json({ id });
+    },
+  });
+  const config = {
+    streaming: {
+      mode: "progress" as const,
+      progress: {
+        label: false as const,
+        toolProgress: false,
+        commentary: true,
+        narration: true,
+        maxLines: 3,
+        maxLineChars: 560,
+      },
+    },
+  };
+  client.create.mockReturnValue({ rest, account: { accountId: "default", config } });
+  const scope: DiscordProgressScope = {
+    sessionKey: "agent:main:discord:channel:123",
+    sessionId: `incarnation-${++nextRequest}`,
+    sourceMessageId: "900",
+    requestGeneration: "900",
+    accountId: "default",
+    channelId: "123",
+  };
+  const assertCurrent = () => {
+    if (!current) {
+      throw new Error("request revoked");
+    }
+  };
+  const params = {
+    cfg: { channels: { discord: config } },
+    to: "channel:123",
+    signal: new AbortController().signal,
+    assertCurrent,
+    progressRequest: {
+      sessionKey: scope.sessionKey,
+      sessionId: scope.sessionId,
+      sourceMessageId: scope.sourceMessageId,
+      requestGeneration: scope.requestGeneration,
+    },
+  };
+  const controller = () =>
+    createDiscordDraftPreviewController({
+      cfg: params.cfg,
+      discordConfig: config,
+      accountId: "default",
+      sourceRepliesAreToolOnly: false,
+      textLimit: 2000,
+      deliveryRest: rest,
+      deliverChannelId: "123",
+      replyReference: { peek: () => "900" },
+      tableMode: "off",
+      maxLinesPerMessage: undefined,
+      chunkMode: "length",
+      log: () => {},
+      assertCurrent,
+      progressScope: async () => scope,
+    });
+  const stream = (override: Partial<DiscordProgressScope> = {}, reuseOnly = false) =>
+    createDiscordRequestProgressStream({
+      rest,
+      channelId: override.channelId ?? "123",
+      chunkText: (s) => [s],
+      throttleMs: 250,
+      assertCurrent,
+      resolveScope: async () => ({ ...scope, ...override }),
+      reuseOnly,
+    });
+  return {
+    rest,
+    writes,
+    scope,
+    params,
+    controller,
+    stream,
+    revoke: () => {
+      current = false;
+    },
+    hold: (fn?: () => Promise<void>) => {
+      holdPatch = fn;
+    },
+    loseAck: () => {
+      loseAck = true;
+    },
+  };
+}
+
+describe("original Discord request progress custody", () => {
+  it("borrows the live compositor behind an accepted timer PATCH without replacing its writer", async () => {
+    const h = setup();
+    const source = h.controller();
+    await source.pushPreambleItemEvent({
+      itemId: "initial",
+      phase: "end",
+      progressText: "Checking the original fixture.",
+    });
+    await source.draftStream?.flush();
+    const store = createPluginStateKeyedStore<{ scope: DiscordProgressScope; epoch: number }>(
+      "discord",
+      { namespace: "request-progress", maxEntries: 10_000, overflowPolicy: "reject-new" },
+    );
+    const before = (await store.entries()).find(
+      (row) => row.value.scope.sessionId === h.scope.sessionId,
+    )?.value;
+    let release: () => void = () => {};
+    let started: () => void = () => {};
+    const blocked = new Promise<void>((resolve) => {
+      release = resolve;
+    });
+    const dispatched = new Promise<void>((resolve) => {
+      started = resolve;
+    });
+    h.hold(async () => {
+      started();
+      await blocked;
+    });
+    await source.pushPreambleItemEvent({
+      itemId: "timer",
+      phase: "end",
+      progressText: "Checking the provider roles.",
+    });
+    await dispatched;
+    // The same factual locator can cross host boundaries with another property
+    // insertion order. It must retain the existing receipt and live compositor.
+    const manual = publishDiscordTaskProgress({
+      ...h.params,
+      progressRequest: {
+        requestGeneration: "900",
+        sourceMessageId: "900",
+        sessionId: h.scope.sessionId,
+        sessionKey: h.scope.sessionKey,
+      },
+      text: "The independent worker will compare the original roles.",
+    });
+    await new Promise<void>((resolve) => {
+      setImmediate(resolve);
+    });
+    expect(h.writes.filter((write) => write.method === "PATCH")).toHaveLength(1);
+    release();
+    h.hold();
+    await expect(manual).resolves.toEqual({ status: "visible", messageId: "1001" });
+    expect(h.writes.filter((write) => write.method === "POST")).toHaveLength(1);
+    expect(
+      (await store.entries()).find((row) => row.value.scope.sessionId === h.scope.sessionId)?.value
+        .epoch,
+    ).toBe(before?.epoch);
+    await source.pushPreambleItemEvent({
+      itemId: "after-manual",
+      phase: "end",
+      progressText: "The original request continues after the comparison.",
+    });
+    await source.draftStream?.flush();
+    expect(h.writes.at(-1)?.text).toContain("original request continues");
+    await source.cleanup();
+  });
+
+  it("manual progress preserves an unknown original create until the normal handoff reconciles its nonce", async () => {
+    const h = setup();
+    const source = h.controller();
+    h.loseAck();
+    source.draftStream?.update("Original checkpoint", { complete: true });
+    await expect(source.draftStream?.flush()).rejects.toThrow(/acknowledgement lost/);
+    await expect(
+      publishDiscordTaskProgress({
+        ...h.params,
+        text: "The original task continues after interruption.",
+      }),
+    ).rejects.toThrow(/acknowledgement lost/);
+    expect(h.writes.filter((write) => write.method === "POST")).toHaveLength(1);
+    // The failed live owner stays ambiguous. Its ordinary cleanup releases the
+    // in-memory writer without declaring the old create absent or sent.
+    await source.cleanup();
+    await expect(
+      publishDiscordTaskProgress({
+        ...h.params,
+        text: "The original task continues after interruption.",
+      }),
+    ).resolves.toEqual({ status: "visible", messageId: "1001" });
+    const posts = h.writes.filter((write) => write.method === "POST");
+    expect(posts).toHaveLength(2);
+    expect(posts[1]?.nonce).toBe(posts[0]?.nonce);
+    expect(new Set(posts.map((write) => write.nonce)).size).toBe(1);
+    expect(h.writes.at(-1)?.text).toContain("original task continues after interruption");
+  });
+
+  it("drains an accepted timer PATCH before terminal abort closes factual custody", async () => {
+    const baseline = discordProgressWriters.size;
+    const h = setup();
+    const source = h.stream();
+    source.update("Original checkpoint", { complete: true });
+    await source.flush();
+    let release!: () => void;
+    let started!: () => void;
+    const blocked = new Promise<void>((resolve) => {
+      release = resolve;
+    });
+    const dispatched = new Promise<void>((resolve) => {
+      started = resolve;
+    });
+    h.hold(async () => {
+      started();
+      await blocked;
+    });
+    // Ordinary update leaves the existing timer to dispatch; there is no flush promise.
+    source.update("Accepted latest timer checkpoint", { complete: true });
+    await dispatched;
+    h.revoke();
+    const cleanup = source.cleanupPendingMessages({ terminal: true });
+    const observedCleanup = cleanup.catch((error: unknown) => error);
+    const store = createPluginStateKeyedStore<{
+      scope: DiscordProgressScope;
+      closed: boolean;
+      draft: { messages: Array<{ id: string; text: string }> };
+    }>("discord", {
+      namespace: "request-progress",
+      maxEntries: 10_000,
+      overflowPolicy: "reject-new",
+    });
+    try {
+      // Read through the real database worker after cleanup's failed source assertion.
+      // Factual close must remain behind the dispatched provider acknowledgement.
+      for (let i = 0; i < 4; i += 1) {
+        await new Promise<void>((resolve) => {
+          setImmediate(resolve);
+        });
+        const receipt = (await store.entries()).find(
+          (entry) => entry.value.scope.sessionId === h.scope.sessionId,
+        )?.value;
+        expect(receipt?.closed).toBe(false);
+      }
+    } finally {
+      release();
+      await observedCleanup;
+    }
+    await expect(cleanup).rejects.toThrow(/revoked/);
+    const receipt = (await store.entries()).find(
+      (entry) => entry.value.scope.sessionId === h.scope.sessionId,
+    )?.value;
+    expect(receipt?.closed).toBe(true);
+    expect(receipt?.draft.messages).toEqual([
+      { id: "1001", text: "Accepted latest timer checkpoint" },

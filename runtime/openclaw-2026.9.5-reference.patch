@@ -0,0 +1,319 @@
+import { describe, expect, it, vi } from "vitest";
+import { prepareSystemAgentRunAdmission } from "../../agents/admitted-run-context.js";
+import { requesterMcpOAuthIdentity } from "../../agents/mcp-oauth-identity.js";
+import { resolveMcpRequesterScope } from "../../agents/mcp-requester-scope.js";
+import { withGatewayToolCallerIdentity } from "../../agents/tools/gateway-caller-context.js";
+import { resolveChatSendCallerContext } from "../../gateway/server-methods/gateway-client-identity.js";
+import type { GatewayClient } from "../../gateway/server-methods/types.js";
+import { resolveGatewayInputParticipant } from "../../gateway/session-input-participant.js";
+import { prepareSessionParticipantInput } from "../../sessions/session-participant-input.js";
+import type { MsgContext } from "../templating.js";
+import {
+  captureReplyMcpRequesterScope,
+  withReplyMcpRequesterAdmission,
+} from "./reply-mcp-requester-scope.js";
+
+function createClient(overrides: Partial<GatewayClient> = {}): GatewayClient {
+  return {
+    authenticatedUserId: "ada@example.test",
+    authenticatedUserProfile: {
+      profileId: "profile-ada",
+      displayName: "Ada",
+      hasAvatar: false,
+      updatedAt: 1,
+    },
+    connect: {
+      minProtocol: 1,
+      maxProtocol: 1,
+      client: { id: "openclaw-control-ui", version: "test", platform: "test", mode: "webchat" },
+      role: "operator",
+      scopes: ["operator.write"],
+    },
+    ...overrides,
+  };
+}
+
+function prepareContext(client: GatewayClient, extra: MsgContext = {}): MsgContext {
+  const ctx = { ...resolveChatSendCallerContext(client), ...extra };
+  const participant = resolveGatewayInputParticipant(client, ctx.InputProvenance);
+  if (participant) {
+    prepareSessionParticipantInput(ctx, participant, 42);
+  }
+  return ctx;
+}
+
+describe("reply MCP requester profile admission", () => {
+  it.each(["reply-operation", "options"])(
+    "binds requester authority before the execution callback and retains %s cancellation",
+    async (owner) => {
+      const prepared = captureReplyMcpRequesterScope(prepareContext(createClient()));
+      const lifetime = new AbortController();
+      const admission = prepareSystemAgentRunAdmission(
+        {},
+        `ui-wrapper-${owner}`,
+        "main",
+        "test.ui-mcp",
+      );
+      const observeAdmission = vi.fn(() => {
+        expect(resolveMcpRequesterScope(prepared)).toEqual({
+          requesterSenderId: "profile-ada",
+          messageChannel: "webchat",
+        });
+      });
+      try {
+        const context = await admission.admit("embedded");
+        withReplyMcpRequesterAdmission(
+          prepared,
+          owner === "reply-operation"
+            ? { replyOperation: { abortSignal: lifetime.signal } }
+            : { opts: { abortSignal: lifetime.signal } },
+          observeAdmission,
+        )(context);
+        expect(observeAdmission).toHaveBeenCalledWith(context);
+        lifetime.abort();
+        expect(() => resolveMcpRequesterScope(prepared)).toThrow();
+      } finally {
+        admission.close();
+      }
+    },
+  );
+
+  it("refuses execution callback when the reply-operation lifetime is already aborted", async () => {
+    const prepared = captureReplyMcpRequesterScope(prepareContext(createClient()));
+    const lifetime = new AbortController();
+    const admission = prepareSystemAgentRunAdmission(
+      {},
+      "ui-wrapper-aborted",
+      "main",
+      "test.ui-mcp",
+    );
+    const observeAdmission = vi.fn();
+    lifetime.abort();
+    try {
+      const context = await admission.admit("embedded");
+      expect(() =>
+        withReplyMcpRequesterAdmission(
+          prepared,
+          {
+            replyOperation: { abortSignal: lifetime.signal },
+            opts: { abortSignal: new AbortController().signal },
+          },
+          observeAdmission,
+        )(context),
+      ).toThrow();
+      expect(observeAdmission).not.toHaveBeenCalled();
+    } finally {
+      admission.close();
+    }
+  });
+
+  it.each([
+    "transport close before runtime admission",
+    "transport close during execution",
+    "invalidation",
+    "profile replacement",
+    "synthetic replacement",
+    "run retirement",
+    "run abort",
+  ])("keeps transport presence separate from admitted authority: %s", async (transition) => {
+    const transport = new AbortController();
+    const runLifetime = new AbortController();
+    const client = createClient({ connectionSignal: transport.signal });
+    const prepared = captureReplyMcpRequesterScope(prepareContext(client));
+    const admission = prepareSystemAgentRunAdmission({}, `ui-${transition}`, "main", "test.ui-mcp");
+    try {
+      if (transition === "transport close before runtime admission") {
+        transport.abort();
+      }
+      const admitted = await admission.admit("embedded");
+      withReplyMcpRequesterAdmission(
+        prepared,
+        { replyOperation: { abortSignal: runLifetime.signal } },
+        () => {},
+      )(admitted);
+      if (transition === "transport close during execution") {
+        transport.abort();
+      }
+      if (transition === "invalidation") {
+        client.invalidated = true;
+      }
+      if (transition === "profile replacement") {
+        client.authenticatedUserProfile = {
+          ...client.authenticatedUserProfile!,
+          profileId: "other",
+        };
+      }
+      if (transition === "synthetic replacement") {
+        client.internal = { syntheticClient: true };
+      }
+      if (transition === "run retirement") {
+        admission.close();
+      }
+      if (transition === "run abort") {
+        runLifetime.abort();
+      }
+      if (transition.startsWith("transport close")) {
+        expect(resolveMcpRequesterScope({ ...prepared, senderId: "later-user" })).toEqual({
+          requesterSenderId: "profile-ada",
+          messageChannel: "webchat",
+        });
+        expect(captureReplyMcpRequesterScope(prepareContext(client))).toEqual({});
+      } else {
+        expect(() => resolveMcpRequesterScope({ ...prepared, senderId: "later-user" })).toThrow();
+      }
+    } finally {
+      admission.close();
+    }
+    expect(() => resolveMcpRequesterScope(prepared)).toThrow();
+  });
+
+  it("cannot transfer a captured UI principal to a different admitted run", async () => {
+    const prepared = captureReplyMcpRequesterScope(prepareContext(createClient()));
+    const first = prepareSystemAgentRunAdmission({}, "ui-first-owner", "main", "test.ui-mcp");
+    const second = prepareSystemAgentRunAdmission({}, "ui-other-owner", "main", "test.ui-mcp");
+    try {
+      withReplyMcpRequesterAdmission(prepared, {}, () => {})(await first.admit("embedded"));
+      expect(() =>
+        withReplyMcpRequesterAdmission(prepared, {}, () => {})({
+          operationalRunInstance: { instanceId: "forged", runId: "forged" },
+        }),
+      ).toThrow("run owner changed");
+      const replacement = await second.admit("embedded");
+      expect(() => withReplyMcpRequesterAdmission(prepared, {}, () => {})(replacement)).toThrow(
+        "run owner changed",
+      );
+      first.close();
+      expect(() => resolveMcpRequesterScope(prepared)).toThrow();
+    } finally {
+      first.close();
+      second.close();
+    }
+  });
+
+  it("retains an admitted UI principal inside its agent run without letting that run mint a scope", async () => {
+    const client = createClient();
+    const ctx = prepareContext(client);
+    const prepared = captureReplyMcpRequesterScope(ctx);
+    await withGatewayToolCallerIdentity(
+      { agentId: "main", sessionKey: "agent:main:dashboard:ui" },
+      () => {
+        expect(resolveMcpRequesterScope(prepared)).toEqual({
+          requesterSenderId: "profile-ada",
+          messageChannel: "webchat",
+        });
+        expect(captureReplyMcpRequesterScope({ ...ctx })).toEqual({});
+        client.invalidated = true;
+        expect(() => resolveMcpRequesterScope(prepared)).toThrow(
+          "MCP requester profile authority is unavailable",
+        );
+      },
+    );
+  });
+
+  it.each(["openclaw-control-ui", "openclaw-browser-copilot", "openclaw-tui"] as const)(
+    "binds the verified %s person without changing sender authority",
+    (id) => {
+      const client = createClient();
+      client.connect.client.id = id;
+      const ctx = prepareContext(client);
+      const prepared = captureReplyMcpRequesterScope({ ...ctx });
+      expect(resolveMcpRequesterScope(prepared)).toEqual({
+        requesterSenderId: "profile-ada",
+        messageChannel: "webchat",
+      });
+      expect(ctx).not.toHaveProperty("SenderId");
+      expect(ctx).not.toHaveProperty("SenderIsOwner");
+    },
+  );
+
+  it("uses the current UI principal and surface when a Discord session is opened", () => {
+    const ctx = prepareContext(createClient(), {
+      SessionKey: "agent:main:discord:channel:finance",
+      OriginatingChannel: "discord",
+      AccountId: "default",
+    });
+    const scope = resolveMcpRequesterScope(captureReplyMcpRequesterScope(ctx));
+    expect(scope).toEqual({ requesterSenderId: "profile-ada", messageChannel: "webchat" });
+    const uiIdentity = requesterMcpOAuthIdentity("explorer", "https://example.test/mcp", scope!);
+    const channelIdentity = requesterMcpOAuthIdentity("explorer", "https://example.test/mcp", {
+      requesterSenderId: "discord-ada",
+      messageChannel: "discord",
+      agentAccountId: "default",
+    });
+    expect(uiIdentity.storeKey).not.toBe(channelIdentity.storeKey);
+    const freshScope = resolveMcpRequesterScope(
+      captureReplyMcpRequesterScope(
+        prepareContext(createClient(), { SessionKey: "fresh-session" }),
+      ),
+    );
+    expect(
+      requesterMcpOAuthIdentity("explorer", "https://example.test/mcp", freshScope!).storeKey,
+    ).toBe(uiIdentity.storeKey);
+  });
+
+  it.each([
+    { name: "unresolved profile", overrides: { authenticatedUserProfile: undefined } },
+    { name: "fallback owner", overrides: { authenticatedUserId: undefined } },
+    { name: "invalidated client", overrides: { invalidated: true } },
+    { name: "synthetic caller", overrides: { internal: { syntheticClient: true as const } } },
+    {
+      name: "agent tool caller",
+      overrides: {
+        internal: { agentToolCaller: { agentId: "main", sessionKey: "agent:main:tool" } },
+      },
+    },
+  ])("does not mint requester credentials for $name", ({ overrides }) => {
+    expect(captureReplyMcpRequesterScope(prepareContext(createClient(overrides)))).toEqual({});
+  });
+
+  it("does not trust public profile, creator, or display assertions", () => {
+    const ctx = {
+      Provider: "webchat",
+      SenderName: "Ada",
+      SessionCreation: {
+        via: "operator",
+        actor: { type: "human", source: "profile", id: "profile-ada" },
+      },
+      authenticatedUserProfile: { profileId: "profile-ada" },
+    };
+    expect(captureReplyMcpRequesterScope(ctx as MsgContext)).toEqual({});
+    const participantOnly: MsgContext = { Provider: "webchat" };
+    prepareSessionParticipantInput(participantOnly, { type: "profile", id: "profile-ada" });
+    expect(captureReplyMcpRequesterScope(participantOnly)).toEqual({});
+  });
+
+  it.each([
+    { InternalTurnSource: "heartbeat" as const },
+    { InputProvenance: { kind: "internal_system" as const, sourceTool: "restart-sentinel" } },
+    { InputProvenance: { kind: "inter_session" as const } },
+    { Provider: "discord" },
+    { SenderId: "discord-ada", OriginatingChannel: "discord", AccountId: "default" },
+    { SenderId: "cli" },
+  ])("preserves the existing source admission for %j", (extra) => {
+    expect(captureReplyMcpRequesterScope(prepareContext(createClient(), extra))).toEqual({});
+  });
+
+  it.each(["invalidation", "closure", "profile replacement"])(
+    "rejects a retained requester after %s without falling back to a later sender",
+    async (transition) => {
+      const lifetime = new AbortController();
+      const client = createClient({ connectionSignal: lifetime.signal });
+      const prepared = captureReplyMcpRequesterScope(prepareContext(client));
+      expect(resolveMcpRequesterScope(prepared)?.requesterSenderId).toBe("profile-ada");
+      await Promise.resolve();
+      if (transition === "invalidation") {
+        client.invalidated = true;
+      } else if (transition === "closure") {
+        lifetime.abort();
+      } else {
+        client.authenticatedUserProfile = {
+          ...client.authenticatedUserProfile!,
+          profileId: "profile-other",
+        };
+      }
+      expect(() => resolveMcpRequesterScope({ ...prepared, senderId: "later-user" })).toThrow(
+        "MCP requester profile authority is unavailable",
+      );
+    },
+  );
+});

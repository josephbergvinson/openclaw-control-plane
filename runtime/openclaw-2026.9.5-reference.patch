new file mode 100644
index 0000000000000000000000000000000000000000..ff890c46e16e308b44aee4716a3ef61fd504d40e
--- /dev/null
+++ b/extensions/memory-core/src/tools.real-manager.cleanup.test.ts
@@ -0,0 +1,122 @@
+import { createDeferred } from "openclaw/plugin-sdk/extension-shared";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import {
+  createManagerIndexFixture,
+  type ManagerIndexFixture,
+} from "./memory/manager-index.test-support.js";
+import { createMemorySearchTool, testing } from "./tools.js";
+
+const { closeAllMemorySearchManagers, closeMemorySearchManager, getMemorySearchManager } =
+  await import("./memory/index.js");
+
+describe("memory_search real manager cleanup ownership", () => {
+  const fixture: ManagerIndexFixture = createManagerIndexFixture({
+    getMemorySearchManager,
+    closeAllMemorySearchManagers,
+  });
+
+  beforeEach(() => {
+    testing.resetMemorySearchToolCooldowns();
+  });
+
+  it.each(["before search", "after search"])(
+    "keeps timeout cleanup behind a concurrent tool's finalization when closing %s",
+    async (phase) => {
+      const cfg = fixture.createConfig({ minScore: 0, vectorEnabled: false });
+      const manager = await fixture.getFreshManager(cfg);
+      await manager.sync({ reason: "baseline", force: true });
+      const searchFinished = createDeferred<void>();
+      const releaseSearchResult = createDeferred<void>();
+      const closeStarted = createDeferred<void>();
+      const releaseProviderClose = createDeferred<void>();
+      fixture.provider.providerCloseGate = releaseProviderClose.promise;
+      const search = manager.search.bind(manager);
+      const searchSpy = vi.spyOn(manager, "search").mockImplementation(async (...args) => {
+        if (phase === "before search") {
+          searchFinished.resolve();
+          await releaseSearchResult.promise;
+        }
+        const result = await search(...args);
+        searchFinished.resolve();
+        await releaseSearchResult.promise;
+        return result;
+      });
+      const close = manager.close.bind(manager);
+      const closeSpy = vi.spyOn(manager, "close").mockImplementation(async () => {
+        const result = close();
+        closeStarted.resolve();
+        await result;
+      });
+      const tool = createMemorySearchTool({ config: cfg, agentId: "main" });
+      if (!tool) {
+        throw new Error("memory_search tool missing");
+      }
+      const execution = tool.execute("concurrent-timeout-cleanup", {
+        query: "zebra",
+        corpus: "memory",
+      });
+      let cleanup: Promise<void> | undefined;
+      try {
+        await searchFinished.promise;
+        // Active-memory timeout cleanup closes this same agent-scoped default manager.
+        cleanup = closeMemorySearchManager({ cfg, agentId: "main" });
+        await closeStarted.promise;
+        expect(() => manager.status()).toThrow("Memory index manager is closed");
+        await new Promise<void>((resolve) => {
+          setImmediate(resolve);
+        });
+        expect.soft(fixture.provider.providerCloseCalls).toBe(0);
+        releaseSearchResult.resolve();
+        const result = await execution;
+        expect(result.details).toMatchObject({
+          results: [expect.objectContaining({ path: "memory/2026-01-12.md" })],
+          provider: "mock",
+        });
+        expect(result.details).not.toHaveProperty("unavailable");
+      } finally {
+        releaseSearchResult.resolve();
+        releaseProviderClose.resolve();
+        await execution;
+        await cleanup;
+        searchSpy.mockRestore();
+        closeSpy.mockRestore();
+      }
+      expect(fixture.provider.providerCloseCalls).toBe(1);
+    },
+  );
+
+  it("expires operation admission before an escaped callback can search during cleanup", async () => {
+    const cfg = fixture.createConfig({ minScore: 0, vectorEnabled: false });
+    const manager = await fixture.getFreshManager(cfg);
+    await manager.sync({ reason: "baseline", force: true });
+    const releaseCallback = createDeferred<void>();
+    const releaseProviderClose = createDeferred<void>();
+    fixture.provider.providerCloseGate = releaseProviderClose.promise;
+    let escaped: ReturnType<typeof manager.search> | undefined;
+    let escapedStatus: Promise<ReturnType<typeof manager.status>> | undefined;
+    await manager.withSearchOperation(async () => {
+      escaped = releaseCallback.promise.then(() => manager.search("zebra"));
+      escapedStatus = releaseCallback.promise.then(() => manager.status());
+    });
+    const cleanup = closeMemorySearchManager({ cfg, agentId: "main" });
+    try {
+      await new Promise<void>((resolve) => {
+        setImmediate(resolve);
+      });
+      expect(fixture.provider.providerCloseCalls).toBe(1);
+      const rejected = expect(escaped).rejects.toThrow("Memory index manager is closed");
+      const statusRejected = expect(escapedStatus).rejects.toThrow(
+        "Memory index manager is closed",
+      );
+      releaseCallback.resolve();
+      await Promise.all([rejected, statusRejected]);
+      expect(fixture.provider.embedQueryCalls).toBe(0);
+    } finally {
+      releaseCallback.resolve();
+      releaseProviderClose.resolve();
+      await escaped?.catch(() => undefined);
+      await escapedStatus?.catch(() => undefined);
+      await cleanup;
+    }
+  });
+});

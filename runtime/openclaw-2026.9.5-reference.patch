@@ -0,0 +1,36 @@
+import type { ContextEngineRuntimeContext } from "../../context-engine/types.js";
+import { projectQueuedCompactionSessionTarget } from "./compact.queued-execution.js";
+import type { CompactEmbeddedAgentSessionParams } from "./compact.types.js";
+import { buildEmbeddedCompactionRuntimeContext } from "./compaction-runtime-context.js";
+import { resolveContextEngineCapabilities } from "./context-engine-capabilities.js";
+
+export function buildCompactionContextEngineRuntimeContext(params: {
+  params: CompactEmbeddedAgentSessionParams;
+  agentDir: string;
+  contextEngineSessionKey?: string;
+  harnessRuntime?: string;
+  contextEnginePluginId?: string;
+  contextTokenBudget?: number;
+}): ContextEngineRuntimeContext {
+  const { sessionFile: _sessionFile, contextEngineAgentId, ...runtimeParams } = params.params;
+  return {
+    ...runtimeParams,
+    sessionTarget: projectQueuedCompactionSessionTarget(params.params),
+    ...buildEmbeddedCompactionRuntimeContext({
+      ...params.params,
+      agentDir: params.agentDir,
+      modelId: params.params.model,
+      harnessRuntime: params.harnessRuntime,
+    }),
+    ...resolveContextEngineCapabilities({
+      config: params.params.config,
+      sessionKey: params.contextEngineSessionKey ?? params.params.sessionKey,
+      explicitAgentId: contextEngineAgentId,
+      authProfileId: params.params.authProfileId,
+      contextEnginePluginId: params.contextEnginePluginId,
+      purpose: "context-engine.compaction",
+    }),
+    tokenBudget: params.contextTokenBudget,
+    currentTokenCount: params.params.currentTokenCount,
+  };
+}
diff --git a/src/agents/embedded-agent-runner/compact.auth-fallback.test.ts b/src/agents/embedded-agent-runner/compact.auth-fallback.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2158f76ed77803512c8eb96a123bffdf42c82610
--- /dev/null
+++ b/src/agents/embedded-agent-runner/compact.auth-fallback.test.ts
@@ -0,0 +1,324 @@
+import { realpath } from "node:fs/promises";
+import { join } from "node:path";
+import type { StreamFn } from "openclaw/plugin-sdk/agent-core";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { createDeferred } from "../../../test/helpers/promise.js";
+import { useAutoCleanupTempDirTracker } from "../../../test/helpers/temp-dir.js";
+import { createApiKeyCredential } from "../auth-profiles/credential-fixtures.test-support.js";
+import type { AuthProfileStore } from "../auth-profiles/types.js";
+import {
+  createAssistant,
+  createAssistantResultStream,
+  createTestSession,
+  registerAgentSessionLoopTestLifecycle,
+  testModel,
+} from "../sessions/agent-session-loop-correctness.test-support.js";
+import { createResourceLoader } from "../sessions/agent-session-loop-resource-loader.test-support.js";
+import { generateSummary as generateRealSummary } from "../sessions/compaction/compaction.js";
+import { createEventBus } from "../sessions/event-bus.js";
+import { createExtensionRuntime, loadExtensionFromFactory } from "../sessions/extensions/loader.js";
+import { SessionManager } from "../sessions/session-manager.js";
+import { SettingsManager } from "../sessions/settings-manager.js";
+import {
+  limitHistoryTurnsMock,
+  resolveEffectiveCompactionModeMock,
+  ensureAuthProfileStoreMock,
+  getApiKeyForModelMock,
+  loadCompactHooksHarness,
+  resetCompactHooksHarnessMocks,
+  sessionCompactImpl,
+  sessionMessages,
+} from "./compact.hooks.harness.js";
+
+const { compactEmbeddedAgentSessionDirect } = await loadCompactHooksHarness();
+const [
+  authProfiles,
+  { upsertSessionEntryCore },
+  { closeOpenClawAgentDatabasesForTest },
+  { AsyncWorkScope, captureAsyncWorkTracker },
+] = await Promise.all([
+  import("../auth-profiles.js"),
+  import("../../config/sessions/session-accessor.js"),
+  import("../../state/openclaw-agent-db.js"),
+  import("../../shared/async-work-scope.js"),
+]);
+const dirs = useAutoCleanupTempDirTracker((cleanup) =>
+  afterEach(() => {
+    vi.restoreAllMocks();
+    closeOpenClawAgentDatabasesForTest();
+    cleanup();
+  }),
+);
+
+describe("compaction provider auth fallback", () => {
+  registerAgentSessionLoopTestLifecycle();
+  let workspaceDir: string;
+  let store: AuthProfileStore;
+  beforeEach(async () => {
+    workspaceDir = await realpath(dirs.make("compaction-auth-fallback-"));
+    resetCompactHooksHarnessMocks(workspaceDir);
+    store = {
+      version: 1,
+      profiles: {
+        "openai:first": createApiKeyCredential("openai", "test-first"),
+        "openai:second": createApiKeyCredential("openai", "test-second"),
+        "openai:outside": createApiKeyCredential("openai", "test-outside"),
+      },
+      order: { openai: ["openai:first", "openai:second"] },
+    };
+    ensureAuthProfileStoreMock.mockReturnValue(store);
+    getApiKeyForModelMock.mockImplementation(async (params) => ({
+      apiKey: `key-${params?.profileId}`,
+      mode: "api-key",
+      source: `profile:${params?.profileId}`,
+      ...(params?.profileId ? { profileId: params.profileId } : {}),
+    }));
+    vi.spyOn(authProfiles, "markAuthProfileFailure").mockResolvedValue();
+  });
+
+  async function compact(
+    source: "auto" | "user" = "auto",
+    trigger: "budget" | "overflow" = "budget",
+  ) {
+    const target = {
+      agentId: "main",
+      sessionId: "auth-fallback",
+      sessionKey: "agent:main:auth-fallback",
+      storePath: join(workspaceDir, "sessions.sqlite"),
+    };
+    await upsertSessionEntryCore(target, { sessionId: target.sessionId, updatedAt: 1 });
+    const scope = new AsyncWorkScope();
+    try {
+      return await scope.run(() =>
+        compactEmbeddedAgentSessionDirect({
+          ...target,
+          sessionTarget: target,
+          sessionFile: target.sessionKey,
+          workspaceDir,
+          provider: "openai",
+          model: "gpt-test",
+          authProfileId: "openai:first",
+          authProfileIdSource: source,
+          trigger,
+          forcePreflight: true,
+          preflightRequired: true,
+          config: {
+            agents: { defaults: { model: { primary: "openai/gpt-test", fallbacks: [] } } },
+          },
+        }),
+      );
+    } finally {
+      await AsyncWorkScope.runWhenAllIdle(
+        () => [scope],
+        () => scope.drain(),
+      );
+    }
+  }
+
+  it("uses the next authorized credential after quota failure without model fallbacks", async () => {
+    sessionCompactImpl.mockRejectedValueOnce(
+      new Error("Codex error: The usage limit has been reached"),
+    );
+    const result = await compact();
+    expect(result.ok).toBe(true);
+    expect(sessionCompactImpl).toHaveBeenCalledTimes(2);
+    expect(getApiKeyForModelMock.mock.calls.map(([arg]) => arg?.profileId)).toEqual([
+      "openai:first",
+      "openai:second",
+    ]);
+    expect(authProfiles.markAuthProfileFailure).toHaveBeenCalledWith(
+      expect.objectContaining({ profileId: "openai:first", reason: "rate_limit" }),
+    );
+  });
+
+  it("preserves history and returns quota failure when all authorized candidates fail", async () => {
+    const history = structuredClone(sessionMessages);
+    sessionCompactImpl.mockRejectedValue(
+      new Error("Codex error: The usage limit has been reached"),
+    );
+    const result = await compact();
+    expect(result).toMatchObject({
+      ok: false,
+      compacted: false,
+      failure: { reason: "rate_limit" },
+    });
+    expect(sessionCompactImpl).toHaveBeenCalledTimes(2);
+    expect(sessionMessages).toEqual(history);
+    expect(getApiKeyForModelMock.mock.calls.map(([arg]) => arg?.profileId)).not.toContain(
+      "openai:outside",
+    );
+  });
+
+  it("does not rotate an explicitly pinned account", async () => {
+    sessionCompactImpl.mockRejectedValue(
+      new Error("Codex error: The usage limit has been reached"),
+    );
+    expect(await compact("user")).toMatchObject({ ok: false, compacted: false });
+    expect(sessionCompactImpl).toHaveBeenCalledTimes(1);
+  });
+
+  it("skips candidates that enter cooldown while the failed request is in flight", async () => {
+    sessionCompactImpl.mockImplementation(async () => {
+      store.usageStats = { "openai:second": { cooldownUntil: Date.now() + 60_000 } };
+      throw new Error("Codex error: The usage limit has been reached");
+    });
+    expect(await compact()).toMatchObject({ ok: false, compacted: false });
+    expect(sessionCompactImpl).toHaveBeenCalledTimes(1);
+  });
+
+  it("retains failed-attempt tools until their accepted descendants finish", async () => {
+    const { createBundleMcpToolRuntime } = await import("../agent-bundle-mcp-tools.js");
+    const finish = createDeferred();
+    const retried = createDeferred();
+    const disposed: number[] = [];
+    let runtime = 0;
+    vi.mocked(createBundleMcpToolRuntime).mockImplementation(async () => {
+      const id = ++runtime;
+      return {
+        tools: [],
+        dispose: async () => {
+          disposed.push(id);
+        },
+      };
+    });
+    sessionCompactImpl
+      .mockImplementationOnce(async () => {
+        void captureAsyncWorkTracker()(() => finish.promise);
+        throw new Error("Codex error: The usage limit has been reached");
+      })
+      .mockImplementationOnce(async () => {
+        retried.resolve();
+        return {
+          summary: "summary",
+          firstKeptEntryId: "entry-1",
+          tokensBefore: 120,
+          details: { ok: true },
+        };
+      });
+    const pending = compact();
+    try {
+      await retried.promise;
+      expect(disposed).toEqual([]);
+    } finally {
+      finish.resolve();
+    }
+    expect(await pending).toMatchObject({ ok: true, compacted: true });
+    expect(disposed).toEqual([1, 2]);
+  });
+
+  it.each([false, true])(
+    "retains provider provenance through the real safeguard, exhausted=%s",
+    async (exhausted) => {
+      const { default: safeguard } = await import("../agent-hooks/compaction-safeguard.js");
+      const { setCompactionSafeguardRuntime } =
+        await import("../agent-hooks/compaction-safeguard-runtime.js");
+      const { generateSummary } = await import("../sessions/index.js");
+      const { guardSessionManager } = await import("../session-tool-result-guard-wrapper.js");
+      const { resolveEmbeddedAgentStream } = await import("./stream-resolution.js");
+      const { createAgentSessionForEmbeddedRunner } = await import("../sessions/sdk.js");
+      const { buildEmbeddedExtensionFactories } = await import("./extensions.js");
+      const manager = SessionManager.inMemory(workspaceDir);
+      for (const content of [
+        "Review deployment notes.",
+        "Compare the remaining options.",
+        "Keep the rollout notes.",
+      ]) {
+        manager.appendMessage({ role: "user", content, timestamp: 1 });
+      }
+      const history = manager.buildSessionContext().messages;
+      const extension = await loadExtensionFromFactory(
+        safeguard,
+        workspaceDir,
+        createEventBus(),
+        createExtensionRuntime(),
+      );
+      const summary = [
+        "## Decisions",
+        "Review deployment notes.",
+        "## Open TODOs",
+        "Compare the remaining options.",
+        "## Constraints/Rules",
+        "None.",
+        "## Pending user asks",
+        "Keep the rollout notes.",
+        "## Exact identifiers",
+        "None.",
+      ].join("\n");
+      const keys: Array<string | undefined> = [];
+      const stream = vi.fn<StreamFn>((model, _context, options) => {
+        keys.push(options?.apiKey);
+        return createAssistantResultStream(
+          exhausted || options?.apiKey === "key-openai:first"
+            ? {
+                ...createAssistant(model, [], "error"),
+                errorMessage: "Codex error: The usage limit has been reached",
+              }
+            : createAssistant(model, [{ type: "text", text: summary }]),
+        );
+      });
+      vi.mocked(generateSummary).mockImplementation(generateRealSummary);
+      vi.mocked(guardSessionManager).mockReturnValue(manager);
+      limitHistoryTurnsMock.mockImplementation((messages) => messages);
+      resolveEffectiveCompactionModeMock.mockReturnValue("safeguard");
+      vi.mocked(resolveEmbeddedAgentStream).mockReturnValue({
+        streamFn: stream,
+        strategy: "session-custom",
+      });
+      vi.mocked(buildEmbeddedExtensionFactories).mockImplementation(({ model }) => {
+        setCompactionSafeguardRuntime(manager, {
+          model,
+          contextWindowTokens: 128_000,
+          recentTurnsPreserve: 0,
+          qualityGuardEnabled: false,
+        });
+        return [];
+      });
+      vi.mocked(createAgentSessionForEmbeddedRunner).mockImplementation(async ({ model }) => {
+        if (!model) {
+          throw new Error("Expected prepared model");
+        }
+        const created = await createTestSession({
+          model: { ...testModel, ...model, maxTokens: 1_024 },
+          sessionManager: manager,
+          settingsManager: SettingsManager.inMemory({
+            compaction: { enabled: false, reserveTokens: 1_024, keepRecentTokens: 1 },
+            retry: { enabled: false },
+          }),
+          resourceLoader: createResourceLoader(extension.handlers),
+        });
+        const auth = await getApiKeyForModelMock.mock.results.at(-1)?.value;
+        if (!auth?.apiKey) {
+          throw new Error("Expected prepared credential");
+        }
+        created.modelRegistry.authStorage.setRuntimeApiKey(model.provider, auth.apiKey);
+        return created;
+      });
+      try {
+        const result = await compact("auto", "overflow");
+        expect(keys).toEqual(["key-openai:first", "key-openai:second"]);
+        if (exhausted) {
+          expect(result).toMatchObject({
+            ok: false,
+            compacted: false,
+            failure: { reason: "rate_limit" },
+          });
+          expect(result.reason).toContain("safeguard");
+          expect(manager.buildSessionContext().messages).toEqual(history);
+          expect(manager.getEntries().some((entry) => entry.type === "compaction")).toBe(false);
+        } else {
+          expect(result).toMatchObject({ ok: true, compacted: true });
+          expect(manager.getEntries().some((entry) => entry.type === "compaction")).toBe(true);
+        }
+      } finally {
+        vi.mocked(generateSummary).mockReset().mockResolvedValue("summary");
+      }
+    },
+  );
+
+  it("does not rotate accounts for a transcript or quality failure", async () => {
+    sessionCompactImpl.mockRejectedValue(new Error("Compaction cancelled"));
+    expect(await compact()).toMatchObject({ ok: false, compacted: false });
+    expect(sessionCompactImpl).toHaveBeenCalledTimes(1);
+    expect(authProfiles.markAuthProfileFailure).not.toHaveBeenCalled();
+  });
+});

+/** Capture post-click controls only when the affected tab and complete effect are known. */
+function actCompletedClick(request: BrowserActRequest, result: unknown): boolean {
+  if (!isRecord(result)) {
+    return false;
+  }
+  const response = result;
+  if (
+    response.ok !== true ||
+    !readStringValue(response.targetId)?.trim() ||
+    response.error !== undefined ||
+    response.aborted !== undefined ||
+    (response.blockedByDialog !== undefined && response.blockedByDialog !== false) ||
+    response.downloads !== undefined
+  ) {
+    return false;
+  }
+  if (request.kind === "click" || request.kind === "clickCoords") {
+    return true;
+  }
+  if (
+    request.kind !== "batch" ||
+    !request.actions.some((action) => action.kind === "click" || action.kind === "clickCoords") ||
+    request.actions.some((action) => action.kind === "close" || action.kind === "batch")
+  ) {
+    return false;
+  }
+  // A nested batch's outer ok does not establish the outcome of its inner actions.
+  return (
+    Array.isArray(response.results) &&
+    response.results.length === request.actions.length &&
+    response.results.every(
+      (entry: unknown) => isRecord(entry) && entry.ok === true && entry.error === undefined,
+    )
+  );
+}

@@ -0,0 +1,161 @@
+import { resolveMarkdownTableMode } from "openclaw/plugin-sdk/markdown-table-runtime";
+import { resolveChunkMode, resolveTextChunkLimit } from "openclaw/plugin-sdk/reply-chunking";
+import { resolveDiscordMaxLinesPerMessage } from "./accounts.js";
+import type { ChannelPlugin } from "./channel-api.js";
+import { createDiscordRestClient } from "./client.js";
+import { createDiscordDraftPreviewController } from "./monitor/message-handler.draft-preview.js";
+import { resolveDiscordPreviewStreamMode } from "./preview-streaming.js";
+import { publishDiscordRequestProgress } from "./request-progress.js";
+import { parseDiscordTarget } from "./targets.js";
+
+type CreateProgress = NonNullable<
+  NonNullable<ChannelPlugin["streaming"]>["createContinuationProgress"]
+>;
+
+/** Source progress uses the ordinary Discord card, never the private completion payload. */
+export const createDiscordContinuationProgress: CreateProgress = async (params) => {
+  return createContinuationProgress(params);
+};
+
+async function createContinuationProgress(
+  params: Parameters<CreateProgress>[0],
+  preparedClient?: ReturnType<typeof createDiscordRestClient>,
+): ReturnType<CreateProgress> {
+  const target = parseDiscordTarget(params.to, { defaultKind: "channel" });
+  // A user target needs the ordinary DM resolution owner; retain that fallback.
+  if (target?.kind !== "channel") {
+    return undefined;
+  }
+  params.assertCurrent();
+  const { rest, account } = preparedClient ?? createDiscordRestClient(params);
+  if (resolveDiscordPreviewStreamMode(account.config) !== "progress") {
+    return undefined;
+  }
+  if (!params.progressRequest) {
+    // Progress mode owns channel commentary. An unproven original request cannot
+    // fall through to a second independently sent commentary message.
+    return { replyOptions: {}, finish: async () => {}, cleanup: async () => {} };
+  }
+  const draft = createDiscordDraftPreviewController({
+    cfg: params.cfg,
+    discordConfig: account.config,
+    accountId: account.accountId,
+    sourceRepliesAreToolOnly: false,
+    textLimit: resolveTextChunkLimit(params.cfg, "discord", account.accountId),
+    deliveryRest: rest,
+    deliverChannelId: params.threadId != null ? String(params.threadId) : target.id,
+    replyReference: { peek: () => undefined },
+    tableMode: resolveMarkdownTableMode({
+      cfg: params.cfg,
+      channel: "discord",
+      accountId: account.accountId,
+    }),
+    maxLinesPerMessage: resolveDiscordMaxLinesPerMessage({
+      cfg: params.cfg,
+      discordConfig: account.config,
+      accountId: account.accountId,
+    }),
+    chunkMode: resolveChunkMode(params.cfg, "discord", account.accountId),
+    assertCurrent: () => {
+      if (params.signal.aborted) {
+        throw new Error("Discord progress requester aborted");
+      }
+      params.assertCurrent();
+    },
+    progressScope: async () => ({
+      ...params.progressRequest!,
+      accountId: account.accountId,
+      channelId: params.threadId != null ? String(params.threadId) : target.id,
+      ...(params.threadId != null ? { threadId: String(params.threadId) } : {}),
+    }),
+    reuseProgressOnly: true,
+    // Caller owns error reporting; never publish diagnostics into the progress card.
+    log: () => undefined,
+  });

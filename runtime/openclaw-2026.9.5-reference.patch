+      const callback = vi.fn(async () => undefined);
+      enqueueFollowupRun(key, source, { mode, debounceMs: 0 }, "none", callback, false);
+      kickFollowupDrainIfIdle(key);
+      await vi.waitFor(() => expect(callback).toHaveBeenCalledExactlyOnceWith(source));
+    },
+  );
+
+  it("waits for owner clear and resolves the latest transport callback", async () => {
+    const owner = createReplyOperation({
+      sessionKey: key,
+      sessionId: "original",
+      resetTriggered: false,
+    });
+    const source = createQueueTestRun({ prompt: "retained source", messageId: "A" });
+    const original = vi.fn(async () => undefined);
+    const current = vi.fn(async () => undefined);
+    enqueueFollowupRun(key, source, { mode: "steer", debounceMs: 0 }, "none", original, false);
+    kickFollowupDrainIfIdle(key);
+    expect(getExistingFollowupQueue(key)?.inFlight.size).toBe(0);
+    expect(getExistingFollowupQueue(key)?.draining).toBe(false);
+    rememberFollowupDrainCallback(key, current);
+    owner.complete();
+    await vi.waitFor(() => expect(current).toHaveBeenCalledExactlyOnceWith(source));
+    expect(original).not.toHaveBeenCalled();

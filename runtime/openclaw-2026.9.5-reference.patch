+      expect(startTurn).not.toHaveBeenCalled();
+      expect(f.completeBatch).not.toHaveBeenCalled();
+      expect(f.child.requesterSettleWake).toMatchObject({
+        status: "pending",
+        attemptCount: 0,
+        deferralCount: 0,
+        rearmGeneration: 1,
+        nextAttemptAt: 40_000,

@@ -0,0 +1,123 @@
+import {
+  createAssistantMessageEventStream,
+  type Context,
+  type Model,
+  type SimpleStreamOptions,
+} from "openclaw/plugin-sdk/llm";
+import { describe, expect, it, vi } from "vitest";
+import { createUserTurnTranscriptRecorder } from "../../sessions/user-turn-transcript.js";
+import { createTestUserTurnTranscriptTarget } from "../../sessions/user-turn-transcript.test-support.js";
+import { createDeferredCore } from "../../shared/deferred.js";
+import { steerActiveSessionWithOptionalDeliveryWait } from "../embedded-agent-runner/run/attempt-queue-message.js";
+import {
+  createAssistant,
+  createTestSession,
+  registerAgentSessionLoopTestLifecycle,
+  streamMocks,
+  testModel,
+} from "./agent-session-loop-correctness.test-support.js";
+
+registerAgentSessionLoopTestLifecycle();
+
+describe("native AgentSession synthetic checkpoint admission", () => {
+  it("refuses synthetic checkpoints at the final response before transcript persistence or provider reservation", async () => {
+    const finalText = "The complete meeting notes remain the final result.";
+    const providerSteer = vi.fn(async () => true);
+    const responseStarted = createDeferredCore();
+    const recorderStarted = createDeferredCore();
+    const releaseRecorder = createDeferredCore();
+    const response = createAssistantMessageEventStream();
+    streamMocks.streamSimple.mockImplementation(
+      (model: Model, _context: Context, options?: SimpleStreamOptions) => {
+        options?.onActiveResponse?.({ steer: providerSteer, needsContinuation: () => false });
+        response.push({ type: "start", partial: createAssistant(model, []) });
+        responseStarted.resolve();
+        return response;
+      },
+    );
+    const { session, sessionManager } = await createTestSession();
+    const checkpointText = "synthetic task progress checkpoint";
+    const recorder = createUserTurnTranscriptRecorder({
+      input: { text: checkpointText },
+      target: createTestUserTurnTranscriptTarget(),
+    });
+    vi.spyOn(recorder, "resolveMessage").mockImplementation(async () => {
+      recorderStarted.resolve();
+      await releaseRecorder.promise;
+      return undefined;
+    });
+    let checkpoint: Promise<PromiseSettledResult<unknown>[]> | undefined;
+    const unsubscribe = session.subscribe((event) => {
+      if (event.type === "message_end" && event.message.role === "assistant" && !checkpoint) {
+        // Runtime response is complete before this listener; the transcript append follows it.
+        checkpoint = Promise.allSettled([
+          steerActiveSessionWithOptionalDeliveryWait(session, checkpointText, {
+            isInboundUserMessage: false,
+            queueIdentity: "final-checkpoint",
+            waitForTranscriptCommit: true,
+          }),
+        ]);
+        releaseRecorder.resolve();
+      }
+    });
+    const prompt = session.prompt("summarize the meeting");
+    const promptSettled = Promise.allSettled([prompt]);
+    await responseStarted.promise;
+    const delayedCheckpoint = Promise.allSettled([
+      steerActiveSessionWithOptionalDeliveryWait(session, checkpointText, {
+        isInboundUserMessage: false,
+        queueIdentity: "prepared-checkpoint",
+        userTurnTranscriptRecorder: recorder,
+        waitForTranscriptCommit: true,
+      }),
+    ]);
+    await recorderStarted.promise;
+    response.push({
+      type: "done",
+      reason: "stop",
+      message: createAssistant(testModel, [{ type: "text", text: finalText }]),
+    });
+    response.end();
+    try {
+      await prompt;
+      expect(checkpoint).toBeDefined();
+      await expect(checkpoint).resolves.toEqual([
+        {
+          status: "rejected",
+          reason: expect.objectContaining({
+            message: "active session completed before task checkpoint acceptance",
+          }),
+        },
+      ]);
+      await expect(delayedCheckpoint).resolves.toEqual([
+        {
+          status: "rejected",
+          reason: expect.objectContaining({
+            message: expect.stringMatching(
+              /^active session (is finalizing|completed before task checkpoint delivery)$/,
+            ),
+          }),
+        },
+      ]);
+      expect(providerSteer).not.toHaveBeenCalled();
+      expect(streamMocks.streamSimple).toHaveBeenCalledOnce();
+      expect(session.pendingMessageCount).toBe(0);
+      expect(session.agent.state.messages.at(-1)).toMatchObject({
+        role: "assistant",
+        content: [{ type: "text", text: finalText }],
+      });
+      expect(JSON.stringify(sessionManager.getBranch())).not.toContain(checkpointText);
+      await expect(
+        steerActiveSessionWithOptionalDeliveryWait(session, checkpointText, {
+          isInboundUserMessage: false,
+          waitForTranscriptCommit: true,
+        }),
+      ).rejects.toThrow("active session completed before task checkpoint acceptance");
+    } finally {
+      releaseRecorder.resolve();
+      unsubscribe();
+      await promptSettled;
+      await delayedCheckpoint;
+    }
+  });
+});

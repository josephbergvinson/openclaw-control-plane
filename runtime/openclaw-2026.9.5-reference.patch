+import {
+  isTrustedSubagentCompletionHandoffForRun,
+  type TrustedSubagentCompletionHandoff,
+} from "../../agents/subagents/announce/subagent-announce-handoff.js";
+import {
+  assertMessageActionSourceSessionCurrent,
+  captureSubagentMessageActionSource,
+} from "../../agents/subagents/subagent-message-action-source.js";
+import {
+  copyMessageActionDelegationSource,
+  type MessageActionDelegationSource,
+} from "../message-action-delegation-source.js";
+import { resolveAgentRunMcpRequesterScope } from "./agent-run-admission-revalidation.js";
+
+type AdmissionParams = Parameters<typeof resolveAgentRunMcpRequesterScope>[0];
+
+/** Transfer both sources synchronously before task acceptance can retire their producers. */
+export function resolveAgentRunRequesterSources(params: AdmissionParams) {
+  const admittedMcpRequesterScope = resolveAgentRunMcpRequesterScope(params);
+  const admittedMessageActionSource = resolveAgentRunMessageActionSource(params);
+  return {
+    ...(admittedMcpRequesterScope ? { admittedMcpRequesterScope } : {}),
+    ...(admittedMessageActionSource ? { admittedMessageActionSource } : {}),
+  };
+}
+
+/** Adopt factual action source only from the same private owners as task admission. */
+function resolveAgentRunMessageActionSource(
+  params: AdmissionParams,
+): MessageActionDelegationSource | undefined {
+  const { source, activeRunAbort } = params;
+  if (activeRunAbort.registered) {
+    params.assertInputOwnerCurrent();
+  } else {
+    params.assertInputAdmissionCurrent?.();
+    source.assertGatewayWorkAdmissionAllowed();
+  }
+  activeRunAbort.controller.signal.throwIfAborted();
+  const identity = source.client?.internal?.agentRuntimeIdentity;
+  const spawnSource = identity?.sessionSpawnContext?.messageActionSource;
+  const queued = source.client?.internal?.mcpRequesterScopeContext?.messageActionDelegation;
+  const handoff: TrustedSubagentCompletionHandoff | undefined =
+    params.completionHandoff.trustedInternalHandoff;
+  const completed = handoff?.messageActionDelegation?.source;
+  if ([spawnSource, queued, completed].filter(Boolean).length > 1) {
+    throw new Error("Message action task admission has conflicting source owners");
+  }
+  let candidate: MessageActionDelegationSource | undefined;
+  if (spawnSource) {
+    if (!identity || source.context.validateAgentRuntimeApprovalAuthority?.(identity) !== true) {
+      throw new Error("Message action child admission authority is no longer active");
+    }
+    const context = identity.messageActionContext;
+    const captured = captureSubagentMessageActionSource({
+      token: context?.turnCapability,
+      agentId: identity.agentId,
+      runId: identity.operationalRunInstance.runId,
+      sessionKey: identity.sessionKey,
+      sessionId: context?.sessionId,
+      cfg: source.cfg,
+      assertCurrent: () => {
+        if (source.context.validateAgentRuntimeApprovalAuthority?.(identity) !== true) {
+          throw new Error("Message action child admission authority is no longer active");
+        }
+      },
+    });
+    if (
+      !captured ||
+      JSON.stringify(captured.source) !==
+        JSON.stringify(copyMessageActionDelegationSource(spawnSource))
+    ) {
+      throw new Error("Message action child source differs from its authenticated parent");
+    }
+    candidate = spawnSource;
+  } else if (queued) {
+    if (
+      source.client?.internal?.syntheticClient !== true ||
+      !source.resolvedSessionKey ||
+      source.request.sessionKey !== source.resolvedSessionKey ||
+      !source.request.expectedExistingSessionId ||
+      source.request.expectedExistingSessionId !== source.getAdmittedSessionId()
+    ) {
+      throw new Error("Message action queued task target incarnation does not match");
+    }
+    queued.assertCurrent();
+    candidate = queued.source;
+  } else if (completed) {
+    if (
+      !isTrustedSubagentCompletionHandoffForRun({
+        handoff,
+        inputProvenance: source.inputProvenance,
+        internalEvents: source.request.internalEvents,
+        sessionKey: source.resolvedSessionKey,
+        sessionId: source.getAdmittedSessionId(),
+        provider: params.activeModel.provider,
+        model: params.activeModel.model,
+      })
+    ) {
+      throw new Error("Message action continuation does not match its admitted task");
+    }
+    // The exact single-use handoff already redeemed its source owner at consumption.
+    // Row cleanup may now retire that producer; the accepted run owns the copied facts.
+    candidate = completed;
+  }
+  if (!candidate) {
+    return undefined;
+  }
+  const copied = copyMessageActionDelegationSource(candidate);
+  assertMessageActionSourceSessionCurrent(copied, source.cfg);
+  const partition =
+    params.completionHandoff.mcpRequesterScope ??
+    identity?.sessionSpawnContext?.mcpRequesterScope ??
+    source.client?.internal?.mcpRequesterScopeContext?.mcpRequesterScope;
+  if (
+    partition &&
+    (partition.requesterSenderId !== copied.requesterSenderId ||
+      partition.agentAccountId !== copied.requesterAccountId ||
+      partition.messageChannel !== copied.toolContext.currentChannelProvider)
+  ) {
+    throw new Error("Message action source and credential account binding differ");
+  }
+  return copied;
+}

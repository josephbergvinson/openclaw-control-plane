diff --git a/src/agents/embedded-agent-runner/run.overflow-progress.test-support.ts b/src/agents/embedded-agent-runner/run.overflow-progress.test-support.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b7a1eaad7ed383c2ff72d0a68bdb2490039e6498
--- /dev/null

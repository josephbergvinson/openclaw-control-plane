+  const bindTrackedLane = (params: {
+    task: TaskRun;
+    ownerSessionKey: string;
+    route: DiscordRoute;
+    inbound: PendingInbound;
+  }): void => {
+    const runId = normalizeOptionalString(params.task.runId);
+    const childSessionKey = normalizeOptionalString(params.task.childSessionKey);
+    if (!runId || !childSessionKey || !isActiveDetachedTask(params.task)) {
+      return;
+    }
+    const existing = lanes.get(runId);
+    if (existing) {
+      if (
+        existing.taskId !== params.task.id ||
+        existing.ownerSessionKey !== params.ownerSessionKey ||
+        existing.childSessionKey !== childSessionKey ||
+        !sameRoute(existing.route, params.route)
+      ) {
+        api.logger.warn("lane-contract withheld a conflicting detached run identity");
+      }
+      return;
+    }
+    if (params.inbound.presentationRunId) {
+      if (params.inbound.presentationRunId !== runId) {
+        api.logger.warn("lane-contract withheld a conflicting inbound presentation identity");
+      }
+      return;
+    }

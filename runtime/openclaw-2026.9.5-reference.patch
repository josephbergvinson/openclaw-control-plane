+import { isCronActiveJobMarkerCurrent } from "../active-jobs.js";
+import type { CronJob, CronRunTelemetry } from "../types.js";
+import { abortErrorMessage } from "./execution-errors.js";
+import type { CronServiceState } from "./state.js";
+import { resolveCronJobTimeoutMs } from "./timeout-policy.js";
+import type { ExecuteJobCoreOptions } from "./timer-execution-timeout.js";
+
+type CronCommandRunResult = Awaited<
+  ReturnType<NonNullable<CronServiceState["deps"]["runCommandJob"]>>
+>;
+
+/** One opt-in repair turn stays inside the original command job and its deadline. */
+export async function repairCronCommand(params: {
+  state: CronServiceState;
+  job: CronJob;
+  initial: CronCommandRunResult;
+  startedAt: number;
+  abortSignal?: AbortSignal;
+  options?: ExecuteJobCoreOptions;
+}): Promise<CronCommandRunResult & CronRunTelemetry> {
+  const { state, job, initial, abortSignal, options } = params;
+  if (job.payload.kind !== "command" || !job.payload.repair || !state.deps.runCommandJob) {
+    return initial;
+  }
+  const repair = job.payload.repair;
+  const detail = initial.failureNotificationDetail;
+  if (
+    initial.status !== "error" ||
+    detail?.kind !== "command-exit" ||
+    !repair.onExitCodes.includes(detail.exitCode)
+  ) {
+    return initial;
+  }
+  const assertCurrent = () => {
+    abortSignal?.throwIfAborted();
+    if (!isCronActiveJobMarkerCurrent(options?.activeJobMarker)) {
+      throw new Error("Gateway restarting.");
+    }
+    options?.assertRunCurrent?.();
+  };
+  const timeoutMs = resolveCronJobTimeoutMs(job);
+  if (timeoutMs === undefined) {
+    return { ...initial, error: "command repair requires a bounded original job timeout" };
+  }

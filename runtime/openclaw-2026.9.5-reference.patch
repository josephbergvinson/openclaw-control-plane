diff --git a/src/agents/embedded-agent-runner/run/attempt.checkpoint-admission.test.ts b/src/agents/embedded-agent-runner/run/attempt.checkpoint-admission.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..444ab8d17f3bbba7c47b4fa71b4860cadc776aa9
--- /dev/null
+++ b/src/agents/embedded-agent-runner/run/attempt.checkpoint-admission.test.ts
@@ -0,0 +1,247 @@
+import { describe, expect, it, vi } from "vitest";
+import { createDeferredCore } from "../../../shared/deferred.js";
+import { Agent } from "../../runtime/index.js";
+import { registerQueuedUserMessageRetirement } from "../../sessions/queued-user-message-retirement.js";
+import { SessionManager } from "../../sessions/session-manager.js";
+import { setSteeringMessageIdentity } from "../../sessions/steering-message-identity.js";
+import { makeAgentUserMessage } from "../../test-helpers/agent-message-fixtures.js";
+import { makeAssistantMessageFixture } from "../../test-helpers/assistant-message-fixtures.js";
+import { steerActiveSessionWithOptionalDeliveryWait } from "./attempt-queue-message.js";
+
+type SteerTarget = Parameters<typeof steerActiveSessionWithOptionalDeliveryWait>[0];
+
+describe("synthetic task checkpoint admission", () => {
+  it("refuses a task checkpoint after the latest committed message completes the assistant turn", async () => {
+    const sessionManager = SessionManager.inMemory();
+    sessionManager.appendMessage(makeAssistantMessageFixture({ stopReason: "stop" }));
+    const steer = vi.fn(async () => {});
+    const onQueueAccepted = vi.fn();
+    await expect(
+      steerActiveSessionWithOptionalDeliveryWait(
+        { sessionManager, steer, subscribe: () => () => {} },
+        "checkpoint",
+        { isInboundUserMessage: false, onQueueAccepted, waitForTranscriptCommit: true },
+      ),
+    ).rejects.toThrow("active session completed before task checkpoint acceptance");
+    expect(steer).not.toHaveBeenCalled();
+    expect(onQueueAccepted).toHaveBeenCalledExactlyOnceWith(false);
+  });
+
+  it("closes synthetic admission at the complete runtime response before its transcript append", async () => {
+    const sessionManager = SessionManager.inMemory();
+    sessionManager.appendMessage(
+      makeAgentUserMessage({ content: [{ type: "text", text: "summarize" }], timestamp: 1 }),
+    );
+    const steer = vi.fn(async () => {});
+    await expect(
+      steerActiveSessionWithOptionalDeliveryWait(
+        {
+          sessionManager,
+          messages: [makeAssistantMessageFixture({ stopReason: "stop" })],
+          steer,
+          subscribe: () => () => {},
+        },
+        "checkpoint",
+        { isInboundUserMessage: false, waitForTranscriptCommit: true },
+      ),
+    ).rejects.toThrow("active session completed before task checkpoint acceptance");
+    expect(steer).not.toHaveBeenCalled();
+    expect(sessionManager.getLeafEntry()).toMatchObject({
+      type: "message",
+      message: { role: "user" },
+    });
+  });
+
+  it.each([true, undefined])(
+    "retains steering semantics for input kind %s after a completed turn",
+    async (isInboundUserMessage) => {
+      const sessionManager = SessionManager.inMemory();
+      sessionManager.appendMessage(makeAssistantMessageFixture({ stopReason: "stop" }));
+      const steer = vi.fn(async () => {});
+      await steerActiveSessionWithOptionalDeliveryWait(
+        { sessionManager, steer, subscribe: () => () => {} },
+        "new input",
+        { isInboundUserMessage },
+      );
+      expect(steer).toHaveBeenCalledOnce();
+    },
+  );
+
+  it.each([
+    { name: "tool use", stopReason: "toolUse" as const },
+    { name: "error retry", stopReason: "error" as const },
+    { name: "length continuation", stopReason: "length" as const },
+    { name: "aborted turn", stopReason: "aborted" as const },
+    {
+      name: "explicit commentary continuation",
+      stopReason: "stop" as const,
+      endTurn: false,
+      content: [
+        {
+          type: "text" as const,
+          text: "progress",
+          textSignature: JSON.stringify({ v: 1, id: "progress", phase: "commentary" }),
+        },
+      ],
+    },
+    {
+      name: "tool boundary",
+      stopReason: "stop" as const,
+      content: [{ type: "toolCall" as const, id: "call", name: "read", arguments: {} }],
+    },
+  ])("keeps synthetic input admitted during $name", async ({ name: _name, ...message }) => {
+    const sessionManager = SessionManager.inMemory();
+    sessionManager.appendMessage(makeAssistantMessageFixture(message));
+    const steer = vi.fn(async () => {});
+    await steerActiveSessionWithOptionalDeliveryWait(
+      { sessionManager, steer, subscribe: () => () => {} },
+      "checkpoint",
+      { isInboundUserMessage: false },
+    );
+    expect(steer).toHaveBeenCalledOnce();
+  });
+
+  it("uses the latest committed message rather than an older completed assistant after new user input", async () => {
+    const sessionManager = SessionManager.inMemory();
+    sessionManager.appendMessage(makeAssistantMessageFixture({ stopReason: "stop" }));
+    sessionManager.appendMessage(
+      makeAgentUserMessage({
+        content: [{ type: "text", text: "continue this task" }],
+        timestamp: 1,
+      }),
+    );
+    const steer = vi.fn(async () => {});
+    await steerActiveSessionWithOptionalDeliveryWait(
+      { sessionManager, steer, subscribe: () => () => {} },
+      "checkpoint",
+      { isInboundUserMessage: false },
+    );
+    expect(steer).toHaveBeenCalledOnce();
+  });
+
+  it.each([false, true])(
+    "cancels only local checkpoint input with pending admission: %s",
+    async (pending) => {
+      const agent = new Agent();
+      const target = makeAgentUserMessage({ content: [{ type: "text", text: "checkpoint" }] });
+      const human = makeAgentUserMessage({
+        content: [{ type: "text", text: "continue this task" }],
+      });
+      agent.steer(human);
+      const retireDisplay = vi.fn(() => true);
+      registerQueuedUserMessageRetirement(target, retireDisplay);
+      let emit!: (event: unknown) => void;
+      const started = createDeferredCore();
+      const release = createDeferredCore();
+      const returned = createDeferredCore();
+      const onQueueAccepted = vi.fn();
+      const final = makeAssistantMessageFixture({ stopReason: "stop" });
+      const activeSession: SteerTarget = {
+        messages: [makeAgentUserMessage({ content: [{ type: "text", text: "task" }] })],
+        agent,
+        steer: async (_text, _images, _recorder, _media, _order, queueIdentity) => {
+          setSteeringMessageIdentity(target, queueIdentity);
+          agent.steer(target);
+          started.resolve();
+          if (pending) {
+            await release.promise;
+          }
+          returned.resolve();
+        },
+        subscribe: (listener) => {
+          emit = listener;
+          return () => {};
+        },
+      };
+      const wait = steerActiveSessionWithOptionalDeliveryWait(activeSession, "checkpoint", {
+        isInboundUserMessage: false,
+        queueIdentity: "task-checkpoint",
+        waitForTranscriptCommit: true,
+        onQueueAccepted,
+      });
+      const rejection = expect(wait).rejects.toThrow(
+        "active session completed before task checkpoint delivery",
+      );
+      try {
+        await started.promise;
+        if (!pending) {
+          await Promise.resolve();
+        }
+        emit({ type: "turn_end", message: final, toolResults: [] });
+        await rejection;
+        expect(agent.cancelSteeringMessage((message) => message === target)).toBeUndefined();
+        expect(agent.cancelSteeringMessage((message) => message === human)).toBe(human);
+        expect(retireDisplay).toHaveBeenCalledOnce();
+        expect(onQueueAccepted).toHaveBeenCalledExactlyOnceWith(!pending);
+      } finally {
+        release.resolve();
+        await returned.promise;
+        await Promise.allSettled([wait]);
+      }
+    },
+  );
+
+  it.each(["settled", "pending", "deadline"] as const)(
+    "retains unconfirmed provider-owned input with %s admission",
+    async (mode) => {
+      vi.useFakeTimers();
+      const release = createDeferredCore();
+      const returned = createDeferredCore();
+      const onQueueAccepted = vi.fn();
+      let emit!: (event: unknown) => void;
+      const cancelSteeringMessage = vi.fn(() => undefined);
+      const activeSession: SteerTarget = {
+        messages: [makeAgentUserMessage({ content: [{ type: "text", text: "task" }] })],
+        agent: { cancelSteeringMessage },
+        steer: async () => {
+          if (mode !== "settled") {
+            await release.promise;
+          }
+          returned.resolve();
+        },
+        subscribe: (listener) => {
+          emit = listener;
+          return () => {};
+        },
+      };
+      const wait = steerActiveSessionWithOptionalDeliveryWait(activeSession, "checkpoint", {
+        isInboundUserMessage: false,
+        queueIdentity: "provider-owned-checkpoint",
+        waitForTranscriptCommit: true,
+        deliveryTimeoutMs: 10,
+        onQueueAccepted,
+      });
+      try {
+        if (mode === "settled") {
+          await returned.promise;
+        }
+        emit({
+          type: "turn_end",
+          message: makeAssistantMessageFixture({ stopReason: "stop" }),
+          toolResults: [],
+        });
+        await Promise.resolve();
+        if (mode !== "settled") {
+          expect(onQueueAccepted).not.toHaveBeenCalled();
+        }
+        if (mode === "deadline") {
+          await vi.advanceTimersByTimeAsync(10);
+        } else {
+          release.resolve();
+        }
+        await expect(wait).resolves.toMatchObject({ transcriptCommit: "unconfirmed" });
+        expect(cancelSteeringMessage).toHaveBeenCalledOnce();
+        if (mode === "deadline") {
+          expect(onQueueAccepted).not.toHaveBeenCalled();
+        } else {
+          expect(onQueueAccepted).toHaveBeenCalledExactlyOnceWith(true);
+        }
+      } finally {
+        release.resolve();
+        await returned.promise;
+        await Promise.allSettled([wait]);
+        vi.useRealTimers();
+      }
+    },
+  );
+});

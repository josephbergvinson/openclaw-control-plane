@@ -0,0 +1,61 @@
+import type { ReplySessionBinding } from "../../auto-reply/reply/get-reply.types.js";
+import { loadSessionEntryReadOnly } from "../../config/sessions/session-accessor.js";
+import type { LocalOperatorMessageAdmission } from "../message-action-turn-capability.js";
+import type { AdmittedChatSend } from "./chat-send-admission.js";
+import type { GatewayCronCreatorAuthorityAdmission } from "./cron-creator-authority-admission.js";
+import type { GatewayRequestHandlerOptions } from "./types.js";
+
+/** Freeze the first native session binding before queued work can change its execution run. */
+export function createChatSendOperatorMessageAdmission(params: {
+  admission: Pick<AdmittedChatSend, "onSessionPrepared" | "assertWorkAdmissionCurrent">;
+  authority?: GatewayCronCreatorAuthorityAdmission;
+  agentId: string;
+  runId: string;
+  sessionKey: string;
+  storePath: string;
+  client: GatewayRequestHandlerOptions["client"];
+}): {
+  onSessionPrepared: AdmittedChatSend["onSessionPrepared"];
+  operatorMessageAdmission: LocalOperatorMessageAdmission | undefined;
+} {
+  const { admission, authority, agentId, runId, sessionKey, storePath, client } = params;
+  let operatorSession: Readonly<ReplySessionBinding> | undefined;
+  const onSessionPrepared: AdmittedChatSend["onSessionPrepared"] = (binding) => {
+    admission.onSessionPrepared(binding);
+    if (
+      authority?.callerOrigin.kind === "local" &&
+      binding.sessionKey === sessionKey &&
+      !operatorSession
+    ) {
+      operatorSession = Object.freeze({ ...binding });
+    }
+  };
+  const assertWorkAdmissionCurrent = admission.assertWorkAdmissionCurrent;
+  const operatorMessageAdmission =
+    authority?.callerOrigin.kind === "local"
+      ? Object.freeze({
+          agentId,
+          runId,
+          sessionKey,
+          client,
+          admission: authority,
+          get sessionId() {
+            return operatorSession?.sessionId;
+          },
+          assertInputCurrent: assertWorkAdmissionCurrent,
+          assertSessionCurrent: () => {
+            const current = loadSessionEntryReadOnly({ storePath, sessionKey });
+            if (
+              !operatorSession ||
+              !current ||
+              current.sessionId !== operatorSession.sessionId ||
+              current.archivedAt !== undefined ||
+              current.lifecycleRevision !== operatorSession.lifecycleRevision
+            ) {
+              throw new Error("Operator chat logical admission has changed.");
+            }
+          },
+        })
+      : undefined;
+  return { onSessionPrepared, operatorMessageAdmission };
+}

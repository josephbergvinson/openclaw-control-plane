diff --git a/src/gateway/server-restart-sentinel.assertions.test-support.ts b/src/gateway/server-restart-sentinel.assertions.test-support.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3ea4c24d929ee2c64028e8515eaac6844e792837
--- /dev/null
+++ b/src/gateway/server-restart-sentinel.assertions.test-support.ts
@@ -0,0 +1,81 @@
+import { expect } from "vitest";
+import type { RuntimeContextFragment } from "../agents/internal-runtime-context.js";
+import type { RestartSentinelPayload } from "../infra/restart-sentinel.js";
+import { resolveOpenClawStateSqlitePath } from "../state/openclaw-state-db.paths.js";
+import { mockCallArg } from "./server-restart-sentinel.test-support.js";
+
+export function expectRecordFields(
+  record: unknown,
+  expected: Record<string, unknown>,
+): Record<string, unknown> {
+  if (!record || typeof record !== "object") {
+    throw new Error("Expected record");
+  }
+  // SAFETY: The guard proves a non-null object; indexed reads remain unknown and every expected field is asserted below.
+  const actual = record as Record<string, unknown>;
+  for (const [key, value] of Object.entries(expected)) {
+    expect(actual[key]).toEqual(value);
+  }
+  return actual;
+}
+
+export function expectMockCallFields(
+  mock: { mock: { calls: Array<Array<unknown>> } },
+  expected: Record<string, unknown>,
+  callIndex = 0,
+): Record<string, unknown> {
+  return expectRecordFields(mockCallArg(mock, callIndex), expected);
+}
+
+export function createRestartContinuationSentinel(
+  continuation: NonNullable<RestartSentinelPayload["continuation"]>,
+  threadId?: string,
+) {
+  return {
+    payload: {
+      sessionKey: "agent:main:main",
+      deliveryContext: {
+        channel: "whatsapp",
+        to: "+15550002",
+        accountId: "acct-2",
+      },
+      ...(threadId === undefined ? {} : { threadId }),
+      ts: 123,
+      continuation,
+    },
+  };
+}
+
+export function createRestartQueueContextMatcher(stateDir: string) {
+  return expect.objectContaining({
+    environment: expect.objectContaining({ OPENCLAW_STATE_DIR: stateDir }),
+    admission: expect.objectContaining({
+      databasePath: resolveOpenClawStateSqlitePath({
+        ...process.env,
+        OPENCLAW_STATE_DIR: stateDir,
+      }),
+    }),
+  });
+}
+export function expectContinuationDispatchMockFields(
+  mock: { mock: { calls: Array<Array<unknown>> } },
+  expected: Record<string, unknown>,
+  expectedCtx?: Record<string, unknown>,
+  callIndex = 0,
+): Record<string, unknown> {
+  const params = expectMockCallFields(mock, expected, callIndex);
+  if (expectedCtx) {
+    expectRecordFields(params.ctxPayload, expectedCtx);
+  }
+  return params;
+}
+
+export function createExpectedGeneratedMediaContext(): RuntimeContextFragment[] {
+  return [
+    {
+      kind: "runtime-instruction",
+      text: "Deliver the generated media listed below to the user.",
+    },
+    { kind: "conversation-data", text: "Generated media:\nMEDIA:/tmp/proof.png" },
+  ];
+}
diff --git a/src/gateway/server-restart-sentinel.internal-continuation.test.ts b/src/gateway/server-restart-sentinel.internal-continuation.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..16283ee6d98863eadf59602674eae500e0a57075
--- /dev/null
+++ b/src/gateway/server-restart-sentinel.internal-continuation.test.ts
@@ -0,0 +1,605 @@
+// Internal restart continuations retain their native queue and original conversation.
+import path from "node:path";
+import { asOptionalRecord } from "@openclaw/normalization-core/record-coerce";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { setReplyPayloadMetadata } from "../auto-reply/reply-payload.js";
+import type {
+  GetReplyFromConfig,
+  InternalGetReplyOptions,
+} from "../auto-reply/reply/get-reply.types.js";
+import { resetInboundDedupe } from "../auto-reply/reply/inbound-dedupe.js";
+import type { AssembledChannelTurn } from "../channels/turn/types.js";
+import {
+  appendTranscriptMessage,
+  loadSessionEntry as loadStoredSessionEntry,
+  loadTranscriptEvents,
+  upsertSessionEntryCore,
+} from "../config/sessions/session-accessor.js";
+import { appendAssistantMessageToSessionTranscript } from "../config/sessions/transcript.js";
+import type { OpenClawConfig } from "../config/types.openclaw.js";
+import {
+  resolveHeartbeatPreflight,
+  resolveHeartbeatRunPrompt,
+} from "../infra/heartbeat-runner-prompt.js";
+import { writeRestartSentinel } from "../infra/restart-sentinel.js";
+import { drainPendingSessionDelivery } from "../infra/session-delivery-queue-recovery.js";
+import * as queueStorage from "../infra/session-delivery-queue-storage.js";
+import {
+  SessionDeliverySafeRetryError,
+  type SessionDeliveryRoute,
+} from "../infra/session-delivery-queue.records.js";
+import { peekSystemEvents, resetSystemEventsForTest } from "../infra/system-events.js";
+import { buildUpdateRestartSentinelPayload } from "../infra/update-restart-sentinel-payload.js";
+import { onInternalSessionTranscriptUpdate } from "../sessions/transcript-events.js";
+import { createDeferredCore } from "../shared/deferred.js";
+import { closeOpenClawStateDatabaseAsync } from "../state/openclaw-state-db.js";
+import { captureOpenClawStateWorkerContext } from "../state/openclaw-state-worker-context.js";
+import type { OpenClawStateWorkerContext } from "../state/openclaw-state-worker-context.types.js";
+import {
+  createOpenClawTestState,
+  type OpenClawTestState,
+} from "../test-utils/openclaw-test-state.js";
+import { normalizeSessionDeliveryState } from "../utils/delivery-context.shared.js";
+import { INTERNAL_MESSAGE_CHANNEL } from "../utils/message-channel.js";
+
+const mocks = vi.hoisted(() => ({
+  dispatch: vi.fn<(params: AssembledChannelTurn) => Promise<unknown>>(),
+  reply: vi.fn<GetReplyFromConfig>(),
+  requestHeartbeat: vi.fn(),
+  routeReply: vi.fn<typeof import("../auto-reply/reply/route-reply.js").routeReply>(),
+}));
+
+vi.mock("../channels/turn/lifecycle.js", async (importOriginal) => {
+  const actual = await importOriginal<typeof import("../channels/turn/lifecycle.js")>();
+  mocks.dispatch.mockImplementation(async (params) =>
+    actual.dispatchAssembledChannelTurn({ ...params, replyResolver: mocks.reply }),
+  );
+  return { ...actual, dispatchAssembledChannelTurn: mocks.dispatch };
+});
+vi.mock("../infra/heartbeat-wake.js", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("../infra/heartbeat-wake.js")>()),
+  requestHeartbeat: mocks.requestHeartbeat,
+}));
+vi.mock("../auto-reply/reply/route-reply.js", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("../auto-reply/reply/route-reply.js")>()),
+  routeReply: mocks.routeReply,
+}));
+
+const { deliverQueuedSessionDelivery, settleQueuedSessionDelivery, scheduleRestartSentinelWake } =
+  await import("./server-restart-sentinel.js");
+
+const sessionKey = "agent:main:restart-cui";
+const sessionId = "original-restart-conversation";
+const messageId = `restart-sentinel:${sessionKey}:agentTurn:123`;
+const originalTask = "Repair the original work, verify it, and report the result here.";
+const oldContext =
+  "The existing task concerns account recovery; a prepared artifact is not completion.";
+const finalText = "The original repair and verification are complete.";
+const log = { info: vi.fn(), warn: vi.fn(), error: vi.fn() };
+let state: OpenClawTestState;
+let queueContext: OpenClawStateWorkerContext;
+let cfg: OpenClawConfig;
+let storePath: string;
+let replyOptions: InternalGetReplyOptions | undefined;
+
+beforeEach(async () => {
+  resetInboundDedupe();
+  state = await createOpenClawTestState({ label: "internal-restart-continuation" });
+  storePath = path.join(state.sessionsDir(), "sessions.json");
+  cfg = {
+    agents: {
+      defaults: {
+        workspace: state.workspaceDir,
+        timeoutSeconds: 600,
+        heartbeat: {
+          every: "30m",
+          isolatedSession: true,
+          lightContext: true,
+          model: "monitor/model",
+          thinking: "low",
+          timeoutSeconds: 10,
+        },
+      },
+    },
+    session: { store: storePath },
+  };
+  await state.writeConfig(cfg);
+  await upsertSessionEntryCore(
+    { agentId: "main", sessionKey, storePath },
+    {
+      sessionId,
+      updatedAt: 1,
+      modelProvider: "task-provider",
+      model: "task-model",
+      thinkingLevel: "max",
+      delivery: normalizeSessionDeliveryState({
+        context: { channel: INTERNAL_MESSAGE_CHANNEL },
+        origin: { provider: INTERNAL_MESSAGE_CHANNEL, surface: INTERNAL_MESSAGE_CHANNEL },
+      }),
+    },
+  );
+  await appendTranscriptMessage(
+    { agentId: "main", sessionKey, sessionId, storePath },
+    { message: { role: "user", content: oldContext, timestamp: 1 } },
+  );
+  queueContext = captureOpenClawStateWorkerContext();
+  replyOptions = undefined;
+  mocks.dispatch.mockClear();
+  mocks.requestHeartbeat.mockClear();
+  mocks.routeReply.mockReset();
+  mocks.routeReply.mockRejectedValue(new Error("Unexpected external automatic reply"));
+  resetSystemEventsForTest();
+  mocks.reply.mockReset();
+  // The provider resolver stands in for a normal model result. The assembled
+  // dispatcher, queue, session store, transcript writer, and publication remain real.
+  mocks.reply.mockImplementation(async (ctx, options) => {
+    replyOptions = options;
+    await options?.turnAdoptionLifecycle?.onAdopted();
+    const result = await appendAssistantMessageToSessionTranscript({
+      agentId: "main",
+      sessionKey: ctx.SessionKey!,
+      storePath,
+      expectedSessionId: sessionId,
+      text: finalText,
+      idempotencyKey: `${ctx.MessageSid}:model-final`,
+      updateMode: "inline",
+    });
+    if (!result.ok) {
+      throw new Error(result.reason);
+    }
+    return setReplyPayloadMetadata({ text: finalText }, { assistantTranscriptOwned: true });
+  });
+});
+
+afterEach(async () => {
+  resetInboundDedupe();
+  vi.restoreAllMocks();
+  resetSystemEventsForTest();
+  await closeOpenClawStateDatabaseAsync();
+  await state.cleanup();
+});
+
+async function enqueueContinuation(route?: SessionDeliveryRoute): Promise<string> {
+  const payload = buildUpdateRestartSentinelPayload({
+    result: { status: "ok", mode: "npm", steps: [], durationMs: 1 },
+    meta: { sessionKey, continuationMessage: originalTask },
+    nowMs: 123,
+  });
+  expect(payload.continuation).toEqual({ kind: "agentTurn", message: originalTask });
+  if (payload.continuation?.kind !== "agentTurn") {
+    throw new Error("Expected a typed original-task continuation");
+  }
+  return queueStorage.enqueueSessionDelivery(
+    {
+      kind: payload.continuation.kind,
+      sessionKey: payload.sessionKey!,
+      message: payload.continuation.message,
+      messageId,
+      expectedSessionId: sessionId,
+      idempotencyKey: messageId,
+      completionRetention: "permanent",
+      ...(route ? { route } : {}),
+    },
+    queueContext,
+  );
+}
+
+function drain(id: string) {
+  return drainPendingSessionDelivery({
+    id,
+    bypassBackoff: true,
+    logLabel: "internal restart continuation",
+    log,
+    queueContext,
+    deliver: (entry, { queueContext: current }) =>
+      deliverQueuedSessionDelivery({ deps: {} as never, entry, queueContext: current }),
+    onSettled: settleQueuedSessionDelivery,
+  });
+}
+
+async function history() {
+  return loadTranscriptEvents({ agentId: "main", sessionKey, sessionId, storePath });
+}
+
+async function pendingAgentTurn(id: string) {
+  const entry = await queueStorage.loadPendingSessionDelivery(id, queueContext);
+  if (!entry || entry.kind !== "agentTurn") {
+    throw new Error("Expected pending typed agent turn");
+  }
+  return entry;
+}
+
+describe("typed internal restart continuations", () => {
+  it("keeps an internal continuation private despite a persisted external delivery route", async () => {
+    await upsertSessionEntryCore(
+      { agentId: "main", sessionKey, storePath },
+      {
+        delivery: normalizeSessionDeliveryState({
+          context: {
+            channel: "discord",
+            to: "channel:old-external-destination",
+            accountId: "old-account",
+          },
+          origin: {
+            provider: "discord",
+            surface: "discord",
+            to: "channel:old-external-destination",
+          },
+        }),
+      },
+    );
+    const before = await history();
+    const id = await enqueueContinuation();
+    await expect(drain(id)).resolves.toBeNull();
+    expect(mocks.reply).toHaveBeenCalledOnce();
+    expect(mocks.routeReply).not.toHaveBeenCalled();
+    expect(replyOptions).toMatchObject({
+      sourceReplyDeliveryMode: "automatic",
+      expectedExistingSessionId: sessionId,
+      pinExpectedExistingSession: true,
+    });
+    const ctx = mocks.dispatch.mock.calls[0]?.[0].ctxPayload;
+    expect(ctx?.OriginatingChannel).toBeUndefined();
+    expect(ctx?.OriginatingTo).toBeUndefined();
+    expect(ctx?.InternalTurnSource).toBeUndefined();
+    expect(loadStoredSessionEntry({ agentId: "main", sessionKey, storePath })?.sessionId).toBe(
+      sessionId,
+    );
+    const after = await history();
+    expect(after.slice(0, before.length)).toEqual(before);
+    expect(after).toContainEqual(
+      expect.objectContaining({
+        type: "message",
+        message: expect.objectContaining({
+          role: "assistant",
+          content: [{ type: "text", text: finalText }],
+        }),
+      }),
+    );
+    expect(mocks.requestHeartbeat).not.toHaveBeenCalled();
+    expect(peekSystemEvents(sessionKey)).toEqual([]);
+  });
+
+  it("resumes a producer's internal continuation at startup without a redundant monitor wake", async () => {
+    const payload = buildUpdateRestartSentinelPayload({
+      result: { status: "ok", mode: "npm", steps: [], durationMs: 1 },
+      meta: { sessionKey, continuationMessage: originalTask },
+      nowMs: 123,
+    });
+    await writeRestartSentinel(payload);
+    await scheduleRestartSentinelWake({ deps: {} as never });
+    expect(mocks.reply).toHaveBeenCalledOnce();
+    expect(mocks.dispatch).toHaveBeenCalledWith(
+      expect.objectContaining({
+        channel: INTERNAL_MESSAGE_CHANNEL,
+        routeSessionKey: sessionKey,
+        ctxPayload: expect.objectContaining({ BodyForAgent: originalTask }),
+      }),
+    );
+    const messages = await history();
+    expect(messages).toContainEqual(
+      expect.objectContaining({
+        type: "message",
+        message: expect.objectContaining({
+          role: "assistant",
+          content: [{ type: "text", text: finalText }],
+        }),
+      }),
+    );
+    expect(
+      messages.filter((event) => {
+        const record = asOptionalRecord(event);
+        return record?.type === "message" && asOptionalRecord(record.message)?.role === "assistant";
+      }),
+    ).toHaveLength(2);
+    expect(mocks.requestHeartbeat).not.toHaveBeenCalled();
+    expect(peekSystemEvents(sessionKey)).toEqual([]);
+  });
+
+  it("uses the original CUI conversation and ordinary execution despite isolated monitor settings", async () => {
+    const before = await history();
+    const publications: unknown[] = [];
+    const unsubscribe = onInternalSessionTranscriptUpdate((update) => publications.push(update));
+    try {
+      const id = await enqueueContinuation();
+      await expect(drain(id)).resolves.toBeNull();
+
+      expect(mocks.reply).toHaveBeenCalledOnce();
+      expect(mocks.dispatch).toHaveBeenCalledWith(
+        expect.objectContaining({
+          channel: INTERNAL_MESSAGE_CHANNEL,
+          routeSessionKey: sessionKey,
+          storePath,
+          ctxPayload: expect.objectContaining({
+            Body: originalTask,
+            BodyForAgent: originalTask,
+            SessionKey: sessionKey,
+            MessageSid: messageId,
+            Provider: INTERNAL_MESSAGE_CHANNEL,
+            Surface: INTERNAL_MESSAGE_CHANNEL,
+            ExplicitDeliverRoute: false,
+            InputProvenance: {
+              kind: "internal_system",
+              sourceChannel: INTERNAL_MESSAGE_CHANNEL,
+              sourceTool: "restart-sentinel",
+            },
+          }),
+        }),
+      );
+      expect(replyOptions).toMatchObject({
+        expectedExistingSessionId: sessionId,
+        pinExpectedExistingSession: true,
+        sourceReplyDeliveryMode: "automatic",
+      });
+      for (const key of [
+        "isHeartbeat",
+        "heartbeatModelOverride",
+        "thinkingLevelOverride",
+        "timeoutOverrideSeconds",
+        "bootstrapContextMode",
+        "disableTools",
+        "toolsAllow",
+        "cleanupBundleMcpOnRunEnd",
+      ]) {
+        expect(replyOptions).not.toHaveProperty(key);
+      }
+      const stored = loadStoredSessionEntry({ agentId: "main", sessionKey, storePath });
+      expect(stored).toMatchObject({
+        sessionId,
+        modelProvider: "task-provider",
+        model: "task-model",
+      });
+      const after = await history();
+      expect(after.slice(0, before.length)).toEqual(before);
+      expect(after).toContainEqual(
+        expect.objectContaining({
+          type: "message",
+          message: expect.objectContaining({
+            role: "assistant",
+            content: [{ type: "text", text: finalText }],
+          }),
+        }),
+      );
+      expect(publications).toContainEqual(
+        expect.objectContaining({
+          target: expect.objectContaining({ sessionKey, sessionId }),
+        }),
+      );
+      expect(mocks.requestHeartbeat).not.toHaveBeenCalled();
+      expect(peekSystemEvents(sessionKey)).toEqual([]);
+    } finally {
+      unsubscribe();
+    }

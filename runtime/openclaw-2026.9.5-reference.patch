+import { expect, it, vi } from "vitest";
+import { SUBAGENT_ENDED_REASON_KILLED } from "./subagent-lifecycle-events.js";
+import type {
+  SubagentLifecycleController,
+  SubagentLifecycleOptions,
+} from "./subagent-registry-lifecycle.js";
+import {
+  createRunEntry,
+  waitForLifecycleState,
+} from "./subagent-registry-lifecycle.test-fixtures.js";
+import type { SubagentRunRecord } from "./subagent-registry.types.js";
+
+// Registered inside the lifecycle suite so its existing mocks and hooks remain authoritative.
+export function registerCronRequesterYieldBatchCases({
+  createLifecycleController,
+  taskExecutorMocks,
+  completionDeliveryMocks,
+}: {
+  createLifecycleController: (
+    params: {
+      entry: SubagentRunRecord;
+      runs?: Map<string, SubagentRunRecord>;
+    } & Partial<SubagentLifecycleOptions>,
+  ) => SubagentLifecycleController;
+  taskExecutorMocks: { setDetachedTaskDeliveryStatusByRunId: ReturnType<typeof vi.fn> };
+  completionDeliveryMocks: { blockSubagentCompletionDelivery: ReturnType<typeof vi.fn> };
+}): void {
+  it.each(["same controller", "restored controller", "restored without parent failure"])(
+    "retains actual parent failure through provisional cancellation with %s",
+    async (boundary) => {
+      const requester = "agent:main:cron:job:run:parent";
+      const completed = createRunEntry({
+        runId: "completed",
+        requesterSessionKey: requester,
+        requesterAgentId: "main",
+        endedAt: 4_000,
+        outcome: { status: "ok" },
+        expectsCompletionMessage: true,
+        completion: { required: true, resultText: "private finding", capturedAt: 4_001 },
+        delivery: { status: "pending" },
+        childSessionKey: "agent:main:subagent:completed",
+      });
+      const pending = createRunEntry({
+        runId: "pending",
+        requesterSessionKey: requester,
+        requesterAgentId: "main",
+        expectsCompletionMessage: true,
+        delivery: { status: "pending" },
+        childSessionKey: "agent:main:subagent:pending",
+      });
+      for (const entry of [completed, pending]) {
+        entry.requesterSettleWake = {
+          status: "pending",
+          attemptCount: 0,
+          requesterYieldBatch: true,
+          batchRunIds: ["completed", "pending"],
+          rearmGeneration: 1,
+          retireAfterSettle: true,
+        };
+      }
+      const tasks = new Map<
+        string,
+        { taskId: string; runId: string; status: string; deliveryStatus: string }
+      >([
+        [
+          "completed",
+          {
+            taskId: "task-completed",
+            runId: "completed",
+            status: "succeeded",
+            deliveryStatus: "pending",
+          },
+        ],
+        [
+          "pending",
+          {
+            taskId: "task-pending",
+            runId: "pending",
+            status: "running",
+            deliveryStatus: "pending",
+          },
+        ],
+      ]);
+      const runs = new Map([
+        [completed.runId, completed],
+        [pending.runId, pending],
+      ]);
+      const externalWake = vi.fn(async () => false);
+      const controller = createLifecycleController({
+        entry: completed,
+        runs,
+        resolveSubagentTask: (entry) => ({
+          lookup: "available",
+          task: tasks.get(entry.runId) as never,
+        }),
+        maybeWakeRequesterAfterAllChildrenSettled: externalWake,
+      });
+      const control = await import("./subagent-control.js");
+      const kill = vi
+        .spyOn(control, "killAllControlledSubagentRuns")
+        .mockImplementation(async (params) => {
+          expect(params.runs).toEqual([completed, pending]);
+          expect(params.suppressTaskDelivery).toBe(true);
+          params.assertCurrent?.();
+          pending.execution = {
+            status: "terminal",
+            startedAt: 2_000,
+            endedAt: 5_000,
+            outcome: { status: "error", error: "cancelled" },
+          };
+          pending.endedReason = SUBAGENT_ENDED_REASON_KILLED;
+          pending.killReconciliation = { killedAt: 5_000, suppressTaskDelivery: true };
+          tasks.set("pending", {
+            taskId: "task-pending",
+            runId: "pending",
+            status: "cancelled",
+            deliveryStatus: "not_applicable",
+          });
+          return { status: "ok", killed: 1, labels: [] };
+        });
+      try {
+        const batch = controller.claimCronRequesterYieldBatch({
+          requesterSessionKey: requester,
+          requesterAgentId: "main",
+          acceptedSessionSpawns: [completed, pending].map((entry) => ({
+            runId: entry.runId,
+            childSessionKey: entry.childSessionKey,
+            expectsCompletionMessage: true,
+          })),
+        });
+        await batch.abandon({
+          delivered: false,
+          path: "none",
+          disposition: "ambiguous",
+          error: "The parent failed after starting work",
+        });
+        expect(kill).toHaveBeenCalledOnce();
+        expect(completionDeliveryMocks.blockSubagentCompletionDelivery).not.toHaveBeenCalled();
+        expect(runs.size).toBe(2);
+        controller.resumeRequesterSettleWake(pending.runId, pending);
+        await waitForLifecycleState(() =>
+          expect(controller.hasScheduledRequesterSettleWakeRun(pending)).toBe(false),
+        );
+        expect(runs.size).toBe(2);
+        if (boundary === "restored without parent failure") {
+          for (const entry of runs.values()) {
+            delete entry.requesterSettleWake!.cronRequesterFailure;
+          }
+        }
+        const finalController = boundary.startsWith("restored")
+          ? createLifecycleController({
+              entry: completed,
+              runs,
+              resolveSubagentTask: (entry) => ({
+                lookup: "available",
+                task: tasks.get(entry.runId) as never,
+              }),
+              maybeWakeRequesterAfterAllChildrenSettled: externalWake,
+            })
+          : controller;
+        pending.completion = { required: true, resultText: null, capturedAt: 5_001 };
+        // Normal cleanup may clear the transient flag; the durable task projection remains authoritative.
+        pending.suppressCompletionDelivery = undefined;
+        finalController.resumeRequesterSettleWake(pending.runId, pending);
+        if (boundary === "restored without parent failure") {
+          await waitForLifecycleState(() => expect(externalWake).toHaveBeenCalled());
+          expect(runs.size).toBe(2);
+          expect(completionDeliveryMocks.blockSubagentCompletionDelivery).not.toHaveBeenCalled();
+          return;
+        }
+        await waitForLifecycleState(() => expect(runs.size).toBe(0));
+        expect(externalWake).not.toHaveBeenCalled();
+        expect(
+          completionDeliveryMocks.blockSubagentCompletionDelivery,
+        ).toHaveBeenCalledExactlyOnceWith(
+          expect.objectContaining({
+            subagent: completed,
+            taskId: "task-completed",
+            disposition: "ambiguous",
+          }),
+        );
+        expect(tasks.get("pending")?.deliveryStatus).toBe("not_applicable");
+        expect(taskExecutorMocks.setDetachedTaskDeliveryStatusByRunId).not.toHaveBeenCalled();
+        expect(pending.requesterSettleWake?.cronRequesterFailure).toBeDefined();
+      } finally {
+        kill.mockRestore();
+      }
+    },
+  );
+
+  it.each([
+    "delivered",
+    "ambiguous",
+    "rearmed",
+    "replaced",
+    "running",
+    "run-id",
+    "task-id",
+    "generation",
+  ] as const)(
+    "settles a claimed cron batch only from its captured parent outcome: %s",
+    (boundary) => {
+      const entry = createRunEntry({
+        requesterSessionKey: "agent:main:cron:job:run:parent",
+        requesterAgentId: "main",
+        taskRunId: "accepted-child",
+        endedAt: 4_000,
+        expectsCompletionMessage: true,
+        delivery: { status: "pending" },
+        requesterSettleWake: {
+          status: "pending",
+          attemptCount: 0,
+          requesterYieldBatch: true,
+          batchRunIds: ["run-1"],
+          rearmGeneration: 1,
+          retireAfterSettle: true,
+        },
+      });
+      const runs = new Map([[entry.runId, entry]]);
+      const controller = createLifecycleController({ entry, runs });
+      const batch = controller.claimCronRequesterYieldBatch({
+        requesterSessionKey: entry.requesterSessionKey,
+        requesterAgentId: "main",
+        acceptedSessionSpawns: [
+          {
+            runId: "accepted-child",
+            childSessionKey: entry.childSessionKey,
+            expectsCompletionMessage: true,
+          },
+        ],
+      });
+      expect(batch.children[0]?.runId).toBe(entry.runId);
+      expect(taskExecutorMocks.setDetachedTaskDeliveryStatusByRunId).not.toHaveBeenCalled();
+      if (boundary === "rearmed") {
+        entry.requesterSettleWake!.rearmGeneration = 2;
+      }
+      if (boundary === "replaced") {
+        runs.set(entry.runId, structuredClone(entry));
+      }
+      if (boundary === "running") {
+        entry.execution = { status: "running", startedAt: 3_000 };
+      }
+      if (boundary === "run-id") {
+        entry.runId = "other-run";
+      }
+      if (boundary === "task-id") {
+        entry.taskRunId = "other-task";
+      }
+      if (boundary === "generation") {
+        entry.generation = 99;
+      }
+      const outcome =
+        boundary === "ambiguous"
+          ? ({
+              delivered: false,
+              path: "none",
+              disposition: "ambiguous",
+              error: "Parent delivery is uncertain",
+            } as const)
+          : ({ delivered: true, path: "direct", requesterVisibleFinalDelivered: true } as const);
+      if (
+        ["rearmed", "replaced", "running", "run-id", "task-id", "generation"].includes(boundary)
+      ) {
+        expect(() => batch.settle(outcome)).toThrow();
+        expect(taskExecutorMocks.setDetachedTaskDeliveryStatusByRunId).not.toHaveBeenCalled();
+        expect(completionDeliveryMocks.blockSubagentCompletionDelivery).not.toHaveBeenCalled();
+        expect(runs.size).toBe(1);
+      } else {
+        batch.settle(outcome);
+        expect(runs.has(entry.runId)).toBe(false);
+        if (boundary === "delivered") {
+          expect(taskExecutorMocks.setDetachedTaskDeliveryStatusByRunId).toHaveBeenCalledWith(
+            expect.objectContaining({ deliveryStatus: "delivered" }),
+          );
+        } else {
+          expect(completionDeliveryMocks.blockSubagentCompletionDelivery).toHaveBeenCalledWith(
+            expect.objectContaining({ subagent: entry, disposition: "ambiguous" }),
+          );
+          expect(entry.delivery?.deliveredAt).toBeUndefined();
+        }
+        expect(() => batch.settle(outcome)).toThrow();
+      }
+    },
+  );
+
+  it.each(["missing", "mixed", "wrong-agent", "incomplete-batch"] as const)(
+    "rejects a cron yield claim without exact frozen batch authority: %s",
+    (boundary) => {
+      const entry = createRunEntry({
+        requesterSessionKey: "agent:main:cron:job:run:parent",
+        requesterAgentId: "main",
+        endedAt: 4_000,
+        expectsCompletionMessage: true,
+        requesterSettleWake: {
+          status: "pending",
+          attemptCount: 0,
+          requesterYieldBatch: true,
+          batchRunIds: boundary === "incomplete-batch" ? ["run-1", "run-2"] : ["run-1"],
+          rearmGeneration: 1,
+        },
+      });
+      const controller = createLifecycleController({ entry });
+      expect(() =>
+        controller.claimCronRequesterYieldBatch({
+          requesterSessionKey:
+            boundary === "mixed" ? "agent:main:cron:another" : entry.requesterSessionKey,
+          requesterAgentId: boundary === "wrong-agent" ? "another" : "main",
+          acceptedSessionSpawns: [
+            {
+              runId: boundary === "missing" ? "missing" : entry.runId,
+              childSessionKey: entry.childSessionKey,
+              expectsCompletionMessage: true,
+            },
+          ],
+        }),
+      ).toThrow();
+    },
+  );
+}

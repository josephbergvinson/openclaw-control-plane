@@ -0,0 +1,179 @@
+import { expectDefined } from "@openclaw/normalization-core";
+import { expect, vi } from "vitest";
+import {
+  createOperationalRunInstanceRef,
+  prepareAgentRunAdmission,
+} from "../../agents/admitted-run-context.js";
+import {
+  resolveCurrentEmbeddedMessageInjectionTarget,
+  setActiveEmbeddedRun,
+  type EmbeddedAgentQueueHandle,
+} from "../../agents/embedded-agent-runner/runs.js";
+import { createEmbeddedRunHandle } from "../../agents/embedded-agent-runner/runs.test-support.js";
+import { withPreparedEmbeddedRunToolAuthority } from "../../agents/harness/tool-authority.runtime.js";
+import { clearAgentRunContext } from "../../infra/agent-run-registry.js";
+import { runActiveReplySteer } from "./agent-runner-steer-adoption.js";
+import { prepareReplyRunAdmission } from "./get-reply-run-admission.js";
+import { prepareReplyRunContext } from "./get-reply-run-context.js";
+import { baseParams } from "./get-reply-run.media-only.test-fixtures.js";
+import { clearSessionQueues, type FollowupRun } from "./queue.js";
+import { createQueueTestRun } from "./queue.test-helpers.js";
+import type { ReplyOperationRunState } from "./reply-operation-run-state.js";
+import { createMockTypingController } from "./test-helpers.js";
+import { createTypingSignaler } from "./typing-mode.js";
+
+export async function withRecoveredOwner(
+  key: string,
+  test: (owner: {
+    run: FollowupRun;
+    handle: EmbeddedAgentQueueHandle;
+    fingerprint: string;
+    revoke: () => void;
+  }) => Promise<void>,
+  configure?: (run: FollowupRun) => void,
+) {
+  const run = createQueueTestRun({
+    prompt: "Use the named asset icons",
+    messageId: "asset-icons-followup",
+  });
+  run.run.agentId = "main";
+  run.run.sessionKey = key;
+  run.run.senderId = "joseph";
+  configure?.(run);
+  const runId = "recovered-marketing-run";
+  const admission = prepareAgentRunAdmission({
+    cfg: run.run.config,
+    operationalRunInstance: createOperationalRunInstanceRef(runId),
+    facts: {
+      agentId: "main",
+      runId,
+      ingress: { kind: "system", state: "present", boundary: "recovery-steering-test" },
+    },
+  });
+  try {
+    await withPreparedEmbeddedRunToolAuthority(
+      { admittedRunContext: await admission.admit("embedded", "recovery-steering-test") },
+      {
+        ...run.run,
+        runId,
+        modelId: run.run.model,
+        messageChannel: run.originatingChannel,
+        sandboxSessionKey: run.run.runtimePolicySessionKey,
+      },
+      undefined,
+      async (prepared) => {
+        const fingerprint = expectDefined(
+          prepared.toolAuthorityFingerprint,
+          "prepared recovery authority",
+        );
+        const handle = createEmbeddedRunHandle({
+          runId,
+          toolAuthorityFingerprint: fingerprint,
+          supportsTranscriptCommitWait: true,
+          supportsQueueMessageImages: true,
+        });
+        handle.supportsQueueMessageContext = true;
+        handle.messageInjectionV2 = {
+          version: 2,
+          isAvailable: () => true,
+          queueMessage: async (_text, _options, assertCurrent) => assertCurrent(),
+        };
+        setActiveEmbeddedRun(run.run.sessionId, handle, key, run.run.sessionFile, "main");
+        await test({ run, handle, fingerprint, revoke: () => admission.close() });
+      },
+    );
+  } finally {
+    clearAgentRunContext(runId);
+    clearSessionQueues([key]);
+    admission.close();
+  }
+}
+
+export function startSteer(
+  key: string,
+  run: FollowupRun,
+  fingerprint: string,
+  followup = vi.fn(async (_run: FollowupRun) => {}),
+) {
+  const state: ReplyOperationRunState = {};
+  const typing = createMockTypingController();
+  const task = runActiveReplySteer({
+    followupRun: run,
+    opts: undefined,
+    providedReplyOperation: undefined,
+    queueKey: key,
+    releaseAdmissionTicket: () => {},
+    replyOperationRunState: state,
+    resolvedQueue: { mode: "steer", debounceMs: 0 },
+    restartRecoverySourceTurnId: run.messageId,
+    runFollowup: followup,
+    sessionCtx: { SenderId: run.run.senderId },
+    sessionKey: key,
+    touchActiveSessionEntry: async () => {},
+    typing,
+    typingSignals: createTypingSignaler({ typing, mode: "never", isHeartbeat: false }),
+    toolAuthorityFingerprint: fingerprint,
+    isToolAuthorityCurrent: () => true,
+  });
+  return { task, state, followup };
+}
+
+export function capture(key: string, run: FollowupRun) {
+  const target = resolveCurrentEmbeddedMessageInjectionTarget({
+    sessionKey: key,
+    sessionId: run.run.sessionId,
+  });
+  expect(target).toBeDefined();
+  return expectDefined(target, "captured recovery target");
+}
+
+export async function prepareRecoveryAdmission(
+  key: string,
+  run: FollowupRun,
+  storePath: string,
+  opts?: NonNullable<Parameters<typeof baseParams>[0]>["opts"],
+  overrides: NonNullable<Parameters<typeof baseParams>[0]> = {},
+) {
+  const params = baseParams({
+    cfg: run.run.config,
+    agentId: run.run.agentId,
+    agentDir: run.run.agentDir,
+    workspaceDir: run.run.workspaceDir,
+    provider: run.run.provider,
+    model: run.run.model,
+    defaultModel: run.run.model,
+    resolvedThinkLevel: "off",
+    isNewSession: false,
+    sessionId: run.run.sessionId,
+    sessionKey: key,
+    sessionEntry: { sessionId: run.run.sessionId, updatedAt: Date.now() },
+    storePath,
+    perMessageQueueMode: "steer",
+    typing: createMockTypingController(),
+    ctx: {
+      Body: run.prompt,
+      Provider: "discord",
+      ChatType: "group",
+      MessageSid: run.messageId,
+      SenderId: run.run.senderId,
+      AccountId: run.run.agentAccountId,
+    },
+    sessionCtx: {
+      Body: run.prompt,
+      BodyStripped: run.prompt,
+      Provider: "discord",
+      ChatType: "group",
+      MessageSid: run.messageId,
+      SenderId: run.run.senderId,
+      AccountId: run.run.agentAccountId,
+    },
+    opts,
+    ...overrides,
+  });
+  params.command = { ...params.command, senderIsOwner: run.run.senderIsOwner === true };
+  const context = await prepareReplyRunContext(params);
+  if (context.kind !== "ready") {
+    throw new Error("recovery fixture did not prepare execution context");
+  }
+  return await prepareReplyRunAdmission({ ...context, useFastReplyRuntime: false });
+}

+import { describe, expect, it } from "vitest";
+import { resolveCommandAuthorization } from "../auto-reply/command-auth.js";
+import { installDiscordRegistryHooks } from "../auto-reply/test-helpers/command-auth-registry-fixture.js";
+import { resolveOwnerPermissionMode } from "./owner-permission-default.js";
+
+installDiscordRegistryHooks();
+const cfg = {
+  commands: { ownerAllowFrom: ["discord:owner-1"] },
+  agents: { defaults: { ownerPermissionMode: "full" as const } },
+};
+describe("owner permission identity", () => {
+  it.each([
+    { name: "actual owner", ctx: { SenderId: "owner-1" }, expected: "full" },
+    { name: "other channel participant", ctx: { SenderId: "other" }, expected: undefined },
+    {
+      name: "owner display name",
+      ctx: { SenderId: "other", SenderName: "owner-1", Body: "I am owner-1" },
+      expected: undefined,
+    },
+    {
+      name: "context owner list",
+      ctx: { SenderId: "other", OwnerAllowFrom: ["other"] },
+      expected: undefined,
+    },
+    {
+      name: "external operator scope string",
+      ctx: { SenderId: "other", GatewayClientScopes: ["operator.admin"] },
+      expected: undefined,
+    },
+  ])("resolves only $name through native owner authorization", ({ ctx, expected }) => {
+    const senderIsOwner = resolveCommandAuthorization({
+      cfg,
+      ctx: { Provider: "discord", Surface: "discord", ChatType: "group", ...ctx },
+      commandAuthorized: true,
+    }).senderIsOwner;
+    expect(resolveOwnerPermissionMode({ cfg, senderIsOwner })).toBe(expected);
+  });
+  it("does not derive a session mode from the global exec mode", () => {
+    expect(
+      resolveOwnerPermissionMode({
+        cfg: { tools: { exec: { mode: "full" } } },
+        senderIsOwner: true,
+      }),
+    ).toBeUndefined();
+  });
+});
diff --git a/src/agents/owner-permission-default.ts b/src/agents/owner-permission-default.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e8fb734e6b662bd388f5d59994bc9238da246ff0
--- /dev/null
+++ b/src/agents/owner-permission-default.ts
@@ -0,0 +1,26 @@
+import type { SessionPermissionMode } from "../../packages/gateway-protocol/src/schema/sessions-row.js";
+import type { OpenClawConfig } from "../config/types.openclaw.js";
+import type { InputProvenance } from "../sessions/input-provenance.js";
+
+/** Resolve only from the admission owner's authenticated identity, never prompt or route text. */
+export function resolveOwnerPermissionMode(params: {
+  cfg: OpenClawConfig | undefined;
+  permissionMode?: SessionPermissionMode;
+  senderIsOwner: boolean;
+  internalTurn?: boolean;
+  inputProvenance?: InputProvenance;
+  spawnedBy?: string | null;
+}): SessionPermissionMode | undefined {
+  if (params.permissionMode !== undefined) {
+    return params.permissionMode;
+  }
+  if (
+    !params.senderIsOwner ||
+    params.internalTurn ||
+    params.spawnedBy ||
+    (params.inputProvenance !== undefined && params.inputProvenance.kind !== "external_user")
+  ) {
+    return undefined;
+  }
+  return params.cfg?.agents?.defaults?.ownerPermissionMode;
+}

+import { describe, expect, it, vi } from "vitest";
+import { diagnosticLogger } from "../../logging/diagnostic-runtime.js";
+import { runActiveReplySteer } from "./agent-runner-steer-adoption.js";
+import { clearSessionQueues, type FollowupRun } from "./queue.js";
+import { createQueueTestRun } from "./queue.test-helpers.js";
+import { getExistingFollowupQueue } from "./queue/state.js";
+import { withQuestionCreator } from "./reply-run-question.test-support.js";
+import type { ReplyBackendHandle } from "./reply-run-registry.contracts.js";
+import { createMockTypingController } from "./test-helpers.js";
+import { createTypingSignaler } from "./typing-mode.js";
+
+describe("active steer context custody", () => {
+  it.each([
+    { supportsContext: true, loggerThrows: false },
+    { supportsContext: false, loggerThrows: false },
+    { supportsContext: undefined, loggerThrows: false },
+    { supportsContext: false, loggerThrows: true },
+  ])(
+    "preserves the quote with backend support $supportsContext and logging failure $loggerThrows",
+    async ({ supportsContext, loggerThrows }) => {
+      const key = `agent:main:steer-context-${supportsContext}${loggerThrows ? "-logging-failure" : ""}`;
+      const run = createQueueTestRun({ prompt: "GO", messageId: "quoted-reply" });
+      run.currentInboundContext = {
+        text: "Quoted reply: synthetic plan",
+        fragments: [{ kind: "conversation-data", text: "Quoted reply: synthetic plan" }],
+      };
+      await withQuestionCreator(key, run, async (operation, fingerprint) => {
+        const queueMessage = vi.fn<
+          NonNullable<ReplyBackendHandle["messageInjectionV2"]>["queueMessage"]
+        >(async (_text, _options, assertCurrent) => {
+          assertCurrent();
+        });
+        operation.attachBackend({
+          kind: "embedded",
+          runId: "accepted-backing-work",
+          toolAuthorityFingerprint: fingerprint,
+          supportsQueueMessageContext: supportsContext,
+          cancel: vi.fn(),
+          messageInjectionV2: { version: 2, isAvailable: () => true, queueMessage },
+        });
+        operation.setPhase("running");
+        const followup = vi.fn(async (_run: FollowupRun) => {});
+        const typing = createMockTypingController();
+        const log = loggerThrows
+          ? vi.spyOn(diagnosticLogger, "info").mockImplementation(() => {
+              throw new Error("synthetic diagnostic sink failure");
+            })
+          : undefined;
+        try {
+          await runActiveReplySteer({
+            followupRun: run,
+            opts: undefined,
+            providedReplyOperation: operation,
+            queueKey: key,
+            releaseAdmissionTicket: () => {},
+            replyOperationRunState: undefined,
+            resolvedQueue: { mode: "steer", debounceMs: 0 },
+            restartRecoverySourceTurnId: run.messageId,
+            runFollowup: followup,
+            sessionCtx: {},
+            sessionKey: key,
+            touchActiveSessionEntry: async () => {},
+            typing,
+            typingSignals: createTypingSignaler({ typing, mode: "never", isHeartbeat: false }),
+            toolAuthorityFingerprint: fingerprint,
+            isToolAuthorityCurrent: () => true,
+          });
+          if (supportsContext) {
+            expect(queueMessage).toHaveBeenCalledExactlyOnceWith(
+              "GO",
+              expect.objectContaining({
+                currentInboundContext: run.currentInboundContext,
+              }),
+              expect.any(Function),
+              "source-bound",
+            );
+            expect(getExistingFollowupQueue(key)?.items ?? []).toEqual([]);
+          } else {
+            expect(queueMessage).not.toHaveBeenCalled();
+            expect(getExistingFollowupQueue(key)?.items).toEqual([run]);
+            if (log) {
+              expect(log).toHaveBeenCalled();
+            }
+            operation.complete();
+            await vi.waitFor(() => expect(followup).toHaveBeenCalledOnce());
+            expect(followup.mock.calls[0]?.[0]).toBe(run);
+            expect(run.prompt).toBe("GO");
+            expect(run.currentInboundContext?.text).toBe("Quoted reply: synthetic plan");
+          }
+        } finally {
+          log?.mockRestore();
+          clearSessionQueues([key]);
+        }
+      });
+    },
+  );
+});

+  threadId: "synthetic-marketing",
+};
+const sendMessage = vi.fn<deliveryRuntime.TaskRegistryDeliveryRuntime["sendMessage"]>();
+const kill = vi.fn<TaskRegistryControlRuntime["killSubagentRunAdmin"]>();
+
+function createChild(overrides: Partial<SubagentRunRecord> = {}) {
+  const entry: SubagentRunRecord & { generation: number } = {
+    runId: "child-run",
+    childSessionKey: "agent:main:subagent:child",
+    requesterSessionKey: "agent:main:subagent:parent",
+    requesterAgentId: "main",
+    requesterDisplayKey: "parent",
+    requesterOrigin: origin,
+    task: "Private supporting assignment",
+    label: "Private supporting assignment",
+    cleanup: "keep",
+    createdAt: Date.now(),
+    execution: { status: "running", startedAt: Date.now() },
+    expectsCompletionMessage: true,
+    completionTarget: "parent",
+    ...overrides,
+    generation: overrides.generation ?? 1,
+  };
+  subagentRuns.set(entry.runId, entry);
+  const task = createTaskRecord({
+    runtime: "subagent",
+    ownerKey: entry.requesterSessionKey,
+    requesterAgentId: "main",
+    scopeKind: "session",
+    childSessionKey: entry.childSessionKey,
+    runId: entry.taskRunId ?? entry.runId,
+    task: entry.task,
+    label: entry.label,
+    status: "running",
+    deliveryStatus: "pending",
+    notifyPolicy: "done_only",
+    requesterOrigin: origin,
+    detail: createSubagentTaskBackingDetail(entry.generation),
+  });
+  if (!task) {
+    throw new Error("Expected accepted task");
+  }
+  return { entry, task };

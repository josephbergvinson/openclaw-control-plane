diff --git a/src/auto-reply/reply/agent-runner-source-admission.test.ts b/src/auto-reply/reply/agent-runner-source-admission.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3b3fe8c09df7fd9f20b1107d3734559fe09c67b5
--- /dev/null
+++ b/src/auto-reply/reply/agent-runner-source-admission.test.ts
@@ -0,0 +1,271 @@
+/** Native CUI input admission must bind the source used by the steering fence. */
+import { join } from "node:path";
+import { afterEach, expect, it, vi } from "vitest";
+import { useAutoCleanupTempDirTracker } from "../../../test/helpers/temp-dir.js";
+import { loadSessionEntry, replaceSessionEntry } from "../../config/sessions/session-accessor.js";
+import type { SessionEntry } from "../../config/sessions/types.js";
+import { resolveChatSendOriginatingRoute } from "../../gateway/server-methods/chat-origin-routing.js";
+import { createChatSendMessageInjectionStarter } from "../../gateway/server-methods/chat-send-message-injection.js";
+import { prepareChatSendUserTurn } from "../../gateway/server-methods/chat-send-user-turn.js";
+import {
+  createUserTurnTranscriptRecorder,
+  type UserTurnInput,
+} from "../../sessions/user-turn-transcript.js";
+import { resolveCommandAuthorization } from "../command-auth.js";
+import { createReplyAgentRestartRecoveryController } from "./agent-runner-execute.js";
+import { finalizeInboundContext } from "./inbound-context.js";
+import type { FollowupRun } from "./queue.js";
+import { createReplyOperation, replyRunRegistry } from "./reply-run-registry.js";
+import {
+  prepareReplyToolAuthority,
+  resolveInboundReplyToolAuthorityOverlay,
+} from "./reply-tool-authority.js";
+import { readChannelSourceTurnId, shouldMintChannelSourceTurnId } from "./source-turn-id.js";
+
+// Model the runtime host inside the test thread, preserving real native SQLite workers.
+vi.mock("node:worker_threads", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("node:worker_threads")>()),
+  isMainThread: true,
+}));
+
+const tempDirs = useAutoCleanupTempDirTracker(afterEach);
+async function makeSessionFixture(overrides: Partial<SessionEntry>) {
+  const sessionEntry: SessionEntry = { sessionId: "session", updatedAt: Date.now(), ...overrides };
+  const sessionStore = { main: sessionEntry };
+  const storePath = join(tempDirs.make("openclaw-cui-source-admission-"), "sessions.json");
+  await replaceSessionEntry({ storePath, sessionKey: "main" }, sessionEntry);
+  return { sessionEntry, sessionStore, storePath };
+}
+function requireStoredSessionEntry(storePath: string) {
+  const entry = loadSessionEntry({ storePath, sessionKey: "main", readConsistency: "latest" });
+  if (!entry) {
+    throw new Error("expected the native session entry");
+  }
+  return entry;
+}
+
+it.each<{
+  label: string;
+  accepts: boolean;
+  fence?: Partial<SessionEntry>;
+  receiptSourceId?: string;
+  externalProvider?: boolean;
+  fullMessageSid?: boolean;
+}>([
+  { label: "an older terminal tombstone", accepts: true },
+  { label: "normalized MessageSidFull admission", accepts: true, fullMessageSid: true },
+  {
+    label: "the exact current-source tombstone",
+    accepts: false,
+    fence: { restartRecoveryTerminalRunIds: ["fresh-control-ui-source"] },
+  },
+  {
+    label: "an ambiguous pending terminal receipt",
+    accepts: false,
+    fence: { restartRecoveryDeliveryReceiptState: "terminal-pending" },
+  },
+  {
+    label: "a delivered terminal receipt",
+    accepts: false,
+    fence: { restartRecoveryDeliveryReceiptState: "delivered-terminal" },
+  },
+  {
+    label: "an unresolved terminal tool call",
+    accepts: false,
+    fence: { restartRecoveryDeliveryToolCallId: "terminal-send" },
+  },
+  { label: "a mismatched durable input receipt", accepts: false, receiptSourceId: "other-source" },
+  { label: "an external provider's message id", accepts: false, externalProvider: true },
+])("retains native Control UI admission fencing with $label", async (testCase) => {
+  const sourceRunId = "fresh-control-ui-source";
+  const { sessionEntry, sessionStore, storePath } = await makeSessionFixture({
+    status: "running",
+    restartRecoveryTerminalRunIds: ["earlier-control-ui-source"],
+  });
+  const sourceInput = {
+    text: "continue the existing task",
+    timestamp: Date.now(),
+    idempotencyKey: `${testCase.receiptSourceId ?? sourceRunId}:user`,
+  };
+  let inputPromise: Promise<UserTurnInput> = Promise.resolve(sourceInput);
+  const prepared = prepareChatSendUserTurn({
+    request: { inboundMessage: sourceInput.text, suppressCommandInterpretation: false },
+    session: { agentId: "main", clientRunId: sourceRunId, sessionKey: "main", cfg: {} },
+    admission: {
+      originatingRoute: resolveChatSendOriginatingRoute({
+        sessionKey: "main",
+        entry: sessionEntry,
+      }),
+    },
+    attachments: {
+      explicitOriginTargetsPlugin: false,
+      imageOrder: [],
+      mediaPathOffloadPaths: [],
+      mediaPathOffloadTypes: [],
+      mediaPathOffloadWorkspaceDir: undefined,
+      offloadedRefs: [],
+      parsedImages: [],
+      parsedMessage: sourceInput.text,
+      prepareAttachmentsMs: undefined,
+    },
+    client: null,
+    logGateway: { warn: vi.fn() } as never,
+    userTurn: {
+      baseInput: sourceInput,
+      setInputPromise: (input) => {
+        inputPromise = input;
+      },
+    },
+  });
+  const sessionCtx = prepared.ctx;
+  // Gateway inputs have native run identities. They must not acquire a
+  // synthetic channel-user identity to get past a terminal-delivery fence.
+  expect(sessionCtx.MessageSid).toBe(sourceRunId);
+  expect(shouldMintChannelSourceTurnId(sessionCtx.Provider)).toBe(false);
+  expect(readChannelSourceTurnId(sessionCtx)).toBeUndefined();
+  if (testCase.externalProvider) {
+    sessionCtx.Provider = "discord";
+  }
+  if (testCase.fullMessageSid) {
+    sessionCtx.MessageSid = undefined;
+    sessionCtx.MessageSidFull = `  ${sourceRunId}  `;
+  }
+  const { originatingChannel, toolsAllow, disableTools, ...inboundRunAuthority } =
+    resolveInboundReplyToolAuthorityOverlay({
+      ctx: finalizeInboundContext(sessionCtx),
+      sessionEntry,
+      senderIsOwner: resolveCommandAuthorization({
+        ctx: sessionCtx,
+        cfg: {},
+        commandAuthorized: sessionCtx.CommandAuthorized === true,
+      }).senderIsOwner,
+      disableTools: false,
+    });
+  const followupRun = {
+    originatingChannel,
+    toolsAllow,
+    disableTools,

+import { expect, it, type Mock } from "vitest";
+import type { OpenClawConfig } from "../../../config/types.openclaw.js";
+import { resolveRequesterToolPolicies } from "../../requester-tool-policy.js";
+import {
+  mockGatewayMethods,
+  waitForFast,
+  type SubagentRunRecordOverrides,
+} from "../../subagent-test-fixtures.test-helpers.js";
+import { createToolPolicyMatcher } from "../../tool-policy-match.js";
+import type { restoreSubagentRunsFromDisk } from "./subagent-registry-state.js";
+import type { SubagentRunRecord } from "./subagent-registry.types.js";
+
+type QueuedRunOverrides = Pick<SubagentRunRecordOverrides, "runId" | "createdAt" | "groupId"> &
+  Partial<Omit<SubagentRunRecordOverrides, "runId" | "createdAt" | "groupId" | "queuedLaunch">> & {
+    queuedLaunch?: Partial<NonNullable<SubagentRunRecord["queuedLaunch"]>>;
+  };
+
+type QueuedRestoreMocks = {
+  callGateway: Mock<
+    (request: {
+      method?: string;
+      params?: Record<string, unknown>;
+      scopes?: string[];
+      timeoutMs?: number | null;
+    }) => Promise<Record<string, unknown>>
+  >;
+  restoreSubagentRunsFromDisk: Mock<typeof restoreSubagentRunsFromDisk>;
+  loadSessionStore: { mockReturnValue(value: Record<string, unknown>): unknown };
+  dispatchRecoveryAgent: Mock;
+  getRuntimeConfig: () => OpenClawConfig;
+};
+
+/** Retains the original registry lifecycle and mocks for restored credential ownership cases. */
+export function registerQueuedRequesterContinuityTests({
+  mocks,
+  makeQueuedRun,
+  hydrateAndActivateRegistry,
+  getRun,
+}: {
+  mocks: QueuedRestoreMocks;
+  makeQueuedRun: (overrides: QueuedRunOverrides) => SubagentRunRecord;
+  hydrateAndActivateRegistry: () => void;
+  getRun: (runId: string) => SubagentRunRecord | undefined;
+}): void {
+  it("does not relaunch a restored queued collector with durable kill intent", async () => {
+    const now = Date.now();
+    mocks.restoreSubagentRunsFromDisk.mockImplementation(((params: {
+      runs: Map<string, unknown>;
+    }) => {
+      params.runs.set(
+        "run-queued-kill-intent",
+        makeQueuedRun({
+          runId: "run-queued-kill-intent",
+          childSessionKey: "agent:main:subagent:queued-kill-intent",
+          task: "do not relaunch",
+          groupId: "kill-intent",
+          createdAt: now,
+          killIntent: {
+            requestedAt: now + 1,
+            reason: "killed",
+            sessionId: "session-queued-kill-intent",
+          },
+        }),
+      );
+      return 1;
+    }) as never);
+
+    hydrateAndActivateRegistry();
+    await Promise.resolve();
+    await Promise.resolve();
+
+    expect(mocks.callGateway.mock.calls.filter(([request]) => request.method === "agent")).toEqual(
+      [],
+    );
+  });
+
+  it("restores queued requester credentials only from the exact private registration", async () => {
+    mockGatewayMethods(mocks.callGateway, { "agent.wait": { status: "timeout" } });
+    const now = Date.now();
+    const scope = {
+      requesterSenderId: "owner-A",
+      agentAccountId: "company-A",
+      messageChannel: "discord",
+    };
+    const entry = makeQueuedRun({
+      runId: "restored-credentials",
+      createdAt: now,
+      groupId: "credential-restore",
+      requesterMcpScope: scope,
+      completionRequesterSessionId: "parent-original",
+      swarmLaunchPending: true,
+      swarmLaunchIdempotencyKey: "restored-credentials",
+      queuedLaunch: {
+        expectedSessionId: "child-original",
+        expectedLifecycleRevision: "child-revision",
+      },
+    });
+    mocks.restoreSubagentRunsFromDisk.mockImplementation(((params: {
+      runs: Map<string, SubagentRunRecord>;
+    }) => {
+      params.runs.set(entry.runId, entry);
+      return 1;
+    }) as never);
+    mocks.loadSessionStore.mockReturnValue({
+      "agent:main:main": { sessionId: "parent-original", updatedAt: now },
+      [entry.childSessionKey]: {
+        sessionId: "child-original",
+        lifecycleRevision: "child-revision",
+        spawnedBy: "agent:main:main",
+        spawnDepth: 1,
+        inheritedToolPolicyVersion: 1,
+        inheritedToolAllow: ["read"],
+        inheritedToolDeny: ["exec"],
+        updatedAt: now,
+      },
+    });
+    mocks.dispatchRecoveryAgent.mockImplementation(async (request, _timeout, options) => {
+      expect(request.expectedExistingSessionId).toBe("child-original");
+      expect(request).not.toHaveProperty("mcpRequesterScope");
+      expect(request).not.toHaveProperty("senderIsOwner");
+      expect(options.mcpRequesterScopeContext.mcpRequesterScope).toEqual(scope);
+      options.mcpRequesterScopeContext.mcpRequesterScopeAssertCurrent();
+      const policies = resolveRequesterToolPolicies({
+        config: mocks.getRuntimeConfig(),
+        sessionKey: entry.childSessionKey,
+      });
+      expect(policies.requesterPolicySource).toBe("persisted-child");
+      expect(policies.inheritedToolPolicy).toEqual({ allow: ["read"], deny: ["exec"] });
+      const permits = createToolPolicyMatcher(policies.inheritedToolPolicy);
+      expect(permits("read")).toBe(true);
+      expect(permits("exec")).toBe(false);
+      expect(permits("write")).toBe(false);
+      return { runId: entry.runId, status: "accepted" };
+    });
+    hydrateAndActivateRegistry();
+    await waitForFast(() => {
+      expect(mocks.dispatchRecoveryAgent).toHaveBeenCalledOnce();
+      expect(getRun(entry.runId)?.execution.status).toBe("running");
+    });
+  });
+}

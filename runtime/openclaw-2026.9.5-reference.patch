+    assertOwnerCurrent();
+    const operation = resolveActiveReplyOperationForSessionId(target.sessionId);
+    if (
+      operation &&
+      operation !== replyOperation &&
+      operation.sessionId === target.sessionId &&
+      operation.agentId === target.agentId &&
+      operation.turnKind !== "heartbeat"

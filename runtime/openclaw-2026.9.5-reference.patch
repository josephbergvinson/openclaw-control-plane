@@ -0,0 +1,338 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { configureAiTransportHost } from "../host.js";
+import { buildOpenAIResponsesReasoningReplayMetadata } from "../transports/openai-responses-compaction-replay.js";
+import { OPENAI_RESPONSES_REASONING_REPLAY_META_KEY } from "../transports/openai-responses-contracts.js";
+import type { Context, Model } from "../types.js";
+import { createZeroUsage } from "../usage.test-support.js";
+import {
+  closeOpenAICodexWebSocketSessions,
+  resetOpenAICodexWebSocketStateForTest,
+  streamOpenAICodexResponses,
+} from "./openai-chatgpt-responses.js";
+
+const model = {
+  id: "gpt-5.5",
+  name: "GPT-5.5",
+  api: "openai-chatgpt-responses",
+  provider: "openai",
+  baseUrl: "https://chatgpt.test/backend-api",
+  reasoning: true,
+  input: ["text"],
+  cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+  contextWindow: 128_000,
+  maxTokens: 16_000,
+} satisfies Model<"openai-chatgpt-responses">;
+
+function createJwt(account = "account-a", generation = 1): string {
+  const encode = (value: object) => Buffer.from(JSON.stringify(value)).toString("base64url");
+  return `${encode({ alg: "none", typ: "JWT" })}.${encode({
+    "https://api.openai.com/auth": { chatgpt_account_id: account },
+    generation,
+  })}.synthetic-signature`;
+}
+
+function context(turns: number): Context {
+  return {
+    messages: Array.from({ length: turns }, (_, index) => ({
+      role: "user",
+      content: `turn ${index + 1}`,
+      timestamp: index + 1,
+    })),
+  };
+}
+
+function installWebSockets(holdFirstRequest = false) {
+  const sockets: IdentityWebSocket[] = [];
+  class IdentityWebSocket extends EventTarget {
+    readyState = 1;
+    readonly requests: Array<Record<string, unknown>> = [];
+    hold = holdFirstRequest && sockets.length === 0;
+    constructor(
+      readonly url: string,
+      readonly options: { headers: Record<string, string> },
+    ) {
+      super();
+      sockets.push(this);
+      queueMicrotask(() => this.dispatchEvent(new Event("open")));
+    }
+    send(raw: string): void {
+      this.requests.push(JSON.parse(raw) as Record<string, unknown>);
+      if (!this.hold) {
+        this.complete();
+      }
+    }
+    complete(): void {
+      queueMicrotask(() => {
+        this.dispatchEvent(
+          Object.assign(new Event("message"), {
+            data: JSON.stringify({
+              type: "response.completed",
+              response: {
+                id: `response-${sockets.indexOf(this) + 1}-${this.requests.length}`,
+                status: "completed",
+                output: [],
+                usage: { input_tokens: 5, output_tokens: 3, total_tokens: 8 },
+              },
+            }),
+          }),
+        );
+      });
+    }
+    close(): void {
+      this.readyState = 3;
+    }
+  }
+  vi.stubGlobal("WebSocket", IdentityWebSocket);
+  return sockets;
+}
+
+describe("ChatGPT WebSocket transport identity", () => {
+  afterEach(() => {
+    closeOpenAICodexWebSocketSessions();
+    vi.restoreAllMocks();
+    vi.unstubAllGlobals();
+    resetOpenAICodexWebSocketStateForTest();
+    configureAiTransportHost({});
+  });
+
+  it.each(["account", "refreshed credential", "URL", "model header", "option header"])(
+    "reconnects and sends full history after changing %s, then reuses only that identity",
+    async (change) => {
+      const sockets = installWebSockets();
+      const options = {
+        apiKey: createJwt(),
+        sessionId: "rotating-session",
+        transport: "websocket-cached" as const,
+      };
+      const nextOptions = {
+        ...options,
+        ...(change === "account" ? { apiKey: createJwt("account-b") } : {}),
+        ...(change === "refreshed credential" ? { apiKey: createJwt("account-a", 2) } : {}),
+        ...(change === "option header" ? { headers: { "x-route": "route-b" } } : {}),
+      };
+      const nextModel = {
+        ...model,
+        ...(change === "URL" ? { baseUrl: "https://other.test/backend-api" } : {}),
+        ...(change === "model header" ? { headers: { "x-route": "route-b" } } : {}),
+      };
+      expect(
+        (await streamOpenAICodexResponses(model, context(1), options).result()).stopReason,
+      ).toBe("stop");
+      expect(
+        (await streamOpenAICodexResponses(model, context(2), options).result()).stopReason,
+      ).toBe("stop");
+      expect(sockets).toHaveLength(1);
+      expect(sockets[0]?.requests[1]?.previous_response_id).toBe("response-1-1");
+
+      expect(
+        (await streamOpenAICodexResponses(nextModel, context(3), nextOptions).result()).stopReason,
+      ).toBe("stop");
+      expect(sockets).toHaveLength(2);
+      expect(sockets[0]?.readyState).toBe(3);
+      expect(sockets[1]?.requests[0]?.previous_response_id).toBeUndefined();
+      expect(sockets[1]?.requests[0]?.input).toHaveLength(3);
+      expect(sockets[1]?.options.headers.authorization).toBe(`Bearer ${nextOptions.apiKey}`);
+      expect(sockets[1]?.options.headers["chatgpt-account-id"]).toBe(
+        change === "account" ? "account-b" : "account-a",
+      );
+
+      expect(
+        (await streamOpenAICodexResponses(nextModel, context(4), nextOptions).result()).stopReason,
+      ).toBe("stop");
+      expect(sockets).toHaveLength(2);
+      expect(sockets[1]?.requests[1]?.previous_response_id).toBe("response-2-1");
+
+      expect(
+        (await streamOpenAICodexResponses(model, context(5), options).result()).stopReason,
+      ).toBe("stop");
+      expect(sockets).toHaveLength(3);
+      expect(sockets[2]?.requests[0]?.previous_response_id).toBeUndefined();
+      expect(sockets[2]?.requests[0]?.input).toHaveLength(5);
+    },
+  );
+
+  it("reuses identical effective headers despite input casing and order", async () => {
+    const sockets = installWebSockets();
+    const options = {
+      apiKey: createJwt(),
+      sessionId: "normalized-headers",
+      transport: "websocket-cached" as const,
+    };
+    expect(
+      (
+        await streamOpenAICodexResponses(model, context(1), {
+          ...options,
+          headers: { "X-Route": "route-a", "X-Feature": "feature-a" },
+        }).result()
+      ).stopReason,
+    ).toBe("stop");
+    expect(
+      (
+        await streamOpenAICodexResponses(model, context(2), {
+          ...options,
+          headers: { "x-feature": "feature-a", "x-route": "route-a" },
+        }).result()
+      ).stopReason,
+    ).toBe("stop");
+    expect(sockets).toHaveLength(1);
+    expect(sockets[0]?.requests[1]?.previous_response_id).toBe("response-1-1");
+  });
+
+  it("carries executed tool history to the next account without account-bound reasoning", async () => {
+    const sockets = installWebSockets();
+    const options = {
+      apiKey: createJwt(),
+      authProfileId: "profile-a",
+      sessionId: "committed-tool-rotation",
+      transport: "websocket-cached" as const,
+    };
+    const history: Context = {
+      messages: [
+        ...context(1).messages,
+        {
+          role: "assistant",
+          api: model.api,
+          provider: model.provider,
+          model: model.id,
+          usage: createZeroUsage(),
+          stopReason: "toolUse",
+          timestamp: 2,
+          content: [
+            {
+              type: "thinking",
+              thinking: "Perform the write once.",
+              thinkingSignature: JSON.stringify({
+                type: "reasoning",
+                id: "rs_account_a",
+                encrypted_content: "synthetic-account-a-ciphertext",
+                summary: [],
+                [OPENAI_RESPONSES_REASONING_REPLAY_META_KEY]:
+                  buildOpenAIResponsesReasoningReplayMetadata(model, options),
+              }),
+            },
+            {
+              type: "toolCall",
+              id: "call_write|fc_write",
+              name: "save_record",
+              arguments: { id: "record-1" },
+            },
+          ],
+        },
+        {
+          role: "toolResult",
+          toolCallId: "call_write|fc_write",
+          toolName: "save_record",
+          content: [{ type: "text", text: "Committed record-1; receipt-1" }],
+          isError: false,
+          timestamp: 3,
+        },
+      ],
+    };
+    expect((await streamOpenAICodexResponses(model, history, options).result()).stopReason).toBe(
+      "stop",
+    );
+    const continuation: Context = {
+      messages: [
+        ...history.messages,
+        { role: "user", content: "Continue from the saved receipt.", timestamp: 4 },
+      ],
+    };
+    expect(
+      (
+        await streamOpenAICodexResponses(model, continuation, {
+          ...options,
+          apiKey: createJwt("account-b"),
+          authProfileId: "profile-b",
+        }).result()
+      ).stopReason,
+    ).toBe("stop");
+    expect(sockets).toHaveLength(2);
+    const replay = sockets[1]?.requests[0];
+    expect(replay?.previous_response_id).toBeUndefined();
+    expect(replay?.input).toEqual(
+      expect.arrayContaining([
+        expect.objectContaining({
+          type: "function_call",
+          call_id: "call_write",
+          name: "save_record",
+          arguments: JSON.stringify({ id: "record-1" }),
+        }),
+        expect.objectContaining({
+          type: "function_call_output",
+          call_id: "call_write",
+          output: "Committed record-1; receipt-1",
+        }),
+      ]),
+    );
+    expect(JSON.stringify(sockets[0]?.requests[0])).toContain("synthetic-account-a-ciphertext");
+    expect(JSON.stringify(replay)).not.toContain("synthetic-account-a-ciphertext");
+    expect(JSON.stringify(replay)).not.toContain("rs_account_a");
+  });
+
+  it("uses transient full-history sockets when Web Crypto is unavailable", async () => {
+    const sockets = installWebSockets();
+    vi.stubGlobal("crypto", undefined);
+    const options = {
+      apiKey: createJwt(),
+      sessionId: "no-web-crypto",
+      transport: "websocket-cached" as const,
+    };
+    expect((await streamOpenAICodexResponses(model, context(1), options).result()).stopReason).toBe(
+      "stop",
+    );
+    expect((await streamOpenAICodexResponses(model, context(2), options).result()).stopReason).toBe(
+      "stop",
+    );
+    expect(sockets).toHaveLength(2);
+    expect(sockets.map((socket) => socket.readyState)).toEqual([3, 3]);
+    expect(sockets[1]?.requests[0]?.previous_response_id).toBeUndefined();
+    expect(sockets[1]?.requests[0]?.input).toHaveLength(2);
+  });
+
+  it.each(["fresh", "reused"])(
+    "lets a %s old-account lease finish without evicting its replacement",
+    async (lease) => {
+      const sockets = installWebSockets(lease === "fresh");
+      const options = {
+        apiKey: createJwt(),
+        sessionId: "busy-account-rotation",
+        transport: "websocket-cached" as const,
+      };
+      if (lease === "reused") {
+        expect(
+          (await streamOpenAICodexResponses(model, context(1), options).result()).stopReason,
+        ).toBe("stop");
+        const seededSocket = sockets[0];
+        if (!seededSocket) {
+          throw new Error("Seed connection is missing");
+        }
+        seededSocket.hold = true;
+      }
+      const oldTurn = streamOpenAICodexResponses(model, context(2), options).result();
+      await vi.waitFor(() => expect(sockets[0]?.requests).toHaveLength(lease === "fresh" ? 1 : 2));
+      const oldSocket = sockets[0];
+      if (!oldSocket) {
+        throw new Error("Old account connection is missing");
+      }
+
+      const nextOptions = { ...options, apiKey: createJwt("account-b") };
+      expect(
+        (await streamOpenAICodexResponses(model, context(3), nextOptions).result()).stopReason,
+      ).toBe("stop");
+      expect(sockets).toHaveLength(2);
+      expect(oldSocket.readyState).toBe(1);
+      expect(sockets[1]?.readyState).toBe(1);
+      expect(sockets[1]?.requests[0]?.previous_response_id).toBeUndefined();
+
+      oldSocket.complete();
+      expect((await oldTurn).stopReason).toBe("stop");
+      expect(oldSocket.readyState).toBe(3);
+      expect(sockets[1]?.readyState).toBe(1);
+      expect(
+        (await streamOpenAICodexResponses(model, context(4), nextOptions).result()).stopReason,
+      ).toBe("stop");
+      expect(sockets).toHaveLength(2);
+      expect(sockets[1]?.requests[1]?.previous_response_id).toBe("response-2-1");
+    },
+  );
+});

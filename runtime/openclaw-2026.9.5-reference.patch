+        let cases: [([NativeCredentialPromptContext.Node], Bool, NativeCredentialDiscoveryDiagnostics.Reason)] = [
+            ([window], false, .secureFieldNotObserved),
+            ([window, field], false, .formContextMissing),
+            ([window, field, field], false, .secureFieldAmbiguous),
+            ([window, field], true, .bindingUnmatched),
+        ]
+        for (nodes, resolved, reason) in cases {
+            let observed = NativeCredentialPromptContext.diagnostics(nodes, resolved: resolved, axReadFailureCount: 0)
+            #expect(observed.reason == reason)

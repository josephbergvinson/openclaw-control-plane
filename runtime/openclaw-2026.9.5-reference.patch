new file mode 100644
index 0000000000000000000000000000000000000000..7c554f661d91cf7b592d97b6c8d96dbcbba8aa62
--- /dev/null
+++ b/extensions/discord/src/send.existing-thread-receipts.test.ts
@@ -0,0 +1,57 @@
+import { ChannelType } from "discord-api-types/v10";
+import { describe, expect, it, vi } from "vitest";
+import { sendMessageDiscord } from "./send.outbound.js";
+import { makeDiscordRest } from "./send.test-harness.js";
+
+const cfg = { channels: { discord: { token: "test-token" } } };
+const channelId = "123456789012345678";
+
+describe("existing Discord thread delivery receipts", () => {
+  it.each([ChannelType.PublicThread, ChannelType.PrivateThread, ChannelType.AnnouncementThread])(
+    "records canonical thread placement for channel type %s and every chunk",
+    async (type) => {
+      const { rest, getMock, postMock } = makeDiscordRest();
+      getMock.mockResolvedValue({ id: channelId, type });
+      let sent = 0;
+      postMock.mockImplementation(async () => ({ id: `message-${++sent}`, channel_id: channelId }));
+      const onDeliveryResult = vi.fn();
+      const result = await sendMessageDiscord(
+        `channel:${channelId}`,
+        "line one\nline two\nline three",
+        {
+          cfg,
+          rest,
+          maxLinesPerMessage: 1,
+          onDeliveryResult,
+        },
+      );
+
+      expect(sent).toBeGreaterThan(1);
+      expect(result.receipt?.threadId).toBe(channelId);
+      expect(result.receipt?.parts).toHaveLength(sent);
+      expect(onDeliveryResult).toHaveBeenCalledTimes(sent);
+      for (const [part] of onDeliveryResult.mock.calls) {
+        expect(part.receipt?.threadId).toBe(channelId);
+        expect(part.channelId).toBe(channelId);
+      }
+    },
+  );
+
+  it.each([ChannelType.GuildText, ChannelType.DM, undefined])(
+    "does not invent thread placement for channel type %s",
+    async (type) => {
+      const { rest, getMock, postMock } = makeDiscordRest();
+      getMock.mockResolvedValue(type === undefined ? undefined : { id: channelId, type });
+      postMock.mockResolvedValue({ id: "message-1", channel_id: channelId });
+      const onDeliveryResult = vi.fn();
+      const result = await sendMessageDiscord(`channel:${channelId}`, "done", {
+        cfg,
+        rest,
+        onDeliveryResult,
+      });
+      expect(result.receipt?.threadId).toBeUndefined();
+      expect(onDeliveryResult).toHaveBeenCalledOnce();
+      expect(onDeliveryResult.mock.calls[0]?.[0].receipt?.threadId).toBeUndefined();
+    },
+  );
+});

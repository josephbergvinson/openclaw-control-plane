index 0000000000000000000000000000000000000000..165f49057520a11dcf6c089be01749222112152e
--- /dev/null
+++ b/apps/macos/Tests/OpenClawIPCTests/NativeCredentialPromptWindowTests.swift
@@ -0,0 +1,159 @@
+import ApplicationServices
+import Darwin
+import Foundation
+import Testing
+@testable import OpenClaw
+
+/// Synthetic relationships only; no AX, process, Keychain, app or Gateway calls.
+@MainActor
+struct NativeCredentialPromptWindowTests {
+    private typealias Ancestor = NativeCredentialPromptWindow.Ancestor<Int>
+    private static let owner: pid_t = 42
+
+    private static func chain() -> [Int: Ancestor] {
+        [
+            0: .init(role: "AXTextField", subrole: "AXSecureTextField", ownerPID: self.owner, parent: 1),
+            1: .init(role: "AXGroup", subrole: nil, ownerPID: self.owner, parent: 2),
+            2: .init(role: "AXSheet", subrole: nil, ownerPID: self.owner, parent: 3),
+            3: .init(role: "AXWindow", subrole: "AXStandardWindow", ownerPID: self.owner, parent: nil),
+        ]
+    }
+
+    private static func locate(
+        _ nodes: [Int: Ancestor],
+        direct: Int? = nil,
+        result: AXError = .noValue,
+        bundle: String = "com.apple.Safari",
+        field: Int? = 0,
+        read: ((Int, TimeInterval) -> Ancestor?)? = nil,
+        now: () -> TimeInterval = { 100 }) -> Int?
+    {
+        NativeCredentialPromptWindow.resolve(
+            direct: (window: direct, result: result),
+            bundleID: bundle,
+            focusedField: field,
+            ownerPID: self.owner,
+            readAncestor: read ?? { element, _ in nodes[element] },
+            sameElement: { $0 == $1 },
+            now: now)
+    }
+
+    @Test(arguments: [AXError.noValue, .attributeUnsupported])
+    func `absent Safari field window resolves its actual same owner ancestor window`(_ error: AXError) {
+        let nodes = Self.chain()
+        // The retained 609 and 610 runs returned -25212: AXError.noValue.
+        #expect(AXError(rawValue: -25212) == .noValue)
+        #expect(AXError.attributeUnsupported.rawValue == -25205)
+        #expect(Self.locate(nodes, result: error) == 3)
+        let form: [NativeCredentialPromptContext.Node] = [
+            .init(parent: nil, role: "AXWindow", subrole: "AXStandardWindow", text: []),
+            .init(parent: 0, role: "AXSheet", subrole: nil, text: [], identifier: "AutoFillAuthenticationSheet"),
+            .init(parent: 1, role: "AXTextField", subrole: "AXSecureTextField", text: []),
+            .init(parent: 1, role: "AXButton", subrole: nil, text: ["Cancel"], buttonTitle: "Cancel"),
+            .init(parent: 1, role: "AXButton", subrole: nil, text: ["Sign In"], buttonTitle: "Sign In"),
+        ]
+        let resolved = NativeCredentialPromptContext.resolve(form, bundleID: "com.apple.Safari")
+        #expect(resolved?.field == 2)
+        #expect(resolved?.context == 1)
+        #expect(resolved?.submit == 4)
+    }
+
+    @Test(arguments: [
+        "direct",
+        "other-owner",
+        "missing-focus",
+        "failure",
+        "disabled",
+        "not-implemented",
+        "malformed-success"
+    ])
+    func `parent reads occur only for an absent focused Safari window`(_ change: String) {
+        var reads = 0
+        let read: (Int, TimeInterval) -> Ancestor? = { element, _ in
+            reads += 1
+            return Self.chain()[element]
+        }
+        let result: AXError = switch change {
+        case "direct": .success
+        case "failure": .cannotComplete
+        case "disabled": .apiDisabled
+        case "not-implemented": .notImplemented
+        case "malformed-success": .success
+        default: .noValue
+        }
+        let window = Self.locate(
+            Self.chain(),
+            direct: change == "direct" ? 7 : nil,
+            result: result,
+            bundle: change == "other-owner" ? "com.apple.SecurityAgent" : "com.apple.Safari",
+            field: change == "missing-focus" ? nil : 0,
+            read: read)
+        #expect(window == (change == "direct" ? 7 : nil))
+        #expect(reads == 0)
+    }
+
+    @Test(arguments: [
+        "nonsecure", "nonfield", "field-owner", "parent-owner", "window-owner", "web-area", "cycle",
+        "missing-parent", "metadata-failure", "depth-budget", "time-budget", "read-time-budget",
+    ])
+    func `untrusted incomplete web or unbounded parent chains cannot supply a native window`(_ change: String) {
+        var nodes = Self.chain()
+        switch change {
+        case "nonsecure":
+            nodes[0] = .init(role: "AXTextField", subrole: nil, ownerPID: Self.owner, parent: 1)
+        case "nonfield":
+            nodes[0] = .init(role: "AXButton", subrole: "AXSecureTextField", ownerPID: Self.owner, parent: 1)
+        case "field-owner":
+            nodes[0] = .init(role: "AXTextField", subrole: "AXSecureTextField", ownerPID: 43, parent: 1)
+        case "parent-owner":
+            nodes[1] = .init(role: "AXGroup", subrole: nil, ownerPID: 43, parent: 2)
+        case "window-owner":
+            nodes[3] = .init(role: "AXWindow", subrole: nil, ownerPID: 43, parent: nil)
+        case "web-area":
+            nodes[1] = .init(role: "AXWebArea", subrole: nil, ownerPID: Self.owner, parent: 2)
+        case "cycle":
+            nodes[2] = .init(role: "AXSheet", subrole: nil, ownerPID: Self.owner, parent: 0)
+        case "missing-parent":
+            nodes[1] = .init(role: "AXGroup", subrole: nil, ownerPID: Self.owner, parent: nil)
+        case "metadata-failure":
+            nodes.removeValue(forKey: 1)
+        case "depth-budget":
+            for index in 1...16 {
+                nodes[index] = .init(role: "AXGroup", subrole: nil, ownerPID: Self.owner, parent: index + 1)
+            }
+            nodes[17] = .init(role: "AXWindow", subrole: nil, ownerPID: Self.owner, parent: nil)
+        default:
+            break
+        }
+        var clock: TimeInterval = 100
+        let window = Self.locate(
+            nodes,
+            read: { element, _ in
+                if change == "read-time-budget" { clock += 1 }
+                return nodes[element]
+            }, now: {
+                defer { if change == "time-budget" { clock += 1 } }
+                return clock
+            })
+        #expect(window == nil)
+    }
+
+    @Test(arguments: ["window", "owner", "web", "metadata"])
+    func `rediscovery cannot preserve a captured window after its relationship changes`(_ change: String) {
+        let captured = Self.locate(Self.chain())
+        var changed = Self.chain()
+        switch change {
+        case "window":
+            changed[2] = .init(role: "AXSheet", subrole: nil, ownerPID: Self.owner, parent: 4)
+            changed[4] = .init(role: "AXWindow", subrole: nil, ownerPID: Self.owner, parent: nil)
+        case "owner":
+            changed[1] = .init(role: "AXGroup", subrole: nil, ownerPID: 43, parent: 2)
+        case "web":
+            changed[1] = .init(role: "AXWebArea", subrole: nil, ownerPID: Self.owner, parent: 2)
+        default:
+            changed.removeValue(forKey: 1)
+        }
+        #expect(captured == 3)
+        #expect(Self.locate(changed) != captured)
+    }
+}

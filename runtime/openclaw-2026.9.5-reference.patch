@@ -0,0 +1,261 @@
+import type { StreamFn } from "openclaw/plugin-sdk/agent-core";
+import { createAssistantMessageEventStream } from "openclaw/plugin-sdk/llm";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { createZeroUsageFixture } from "../test-helpers/usage-fixtures.js";
+import {
+  consumeCompactionSafeguardCancellation,
+  setCompactionSafeguardRuntime,
+} from "./compaction-safeguard-runtime.js";
+import {
+  createAnthropicModelFixture,
+  createCompactionContext,
+  createCompactionEvent,
+  createCompactionHandler,
+  expectCompactionResult,
+  stubSessionManager,
+} from "./compaction-safeguard.test-fixtures.js";
+
+const latestAsk = "Verify receipt_90210 before completing the deployment.";
+const historyBody = [
+  "## Decisions\n\nKeep the approved deployment and its rollback.",
+  "## Open TODOs\n\nVerify the deployment.",
+  "## Constraints/Rules\n\nReuse the existing implementation.",
+  `## Pending user asks\n\nLatest user request context: ${JSON.stringify(latestAsk)}`,
+  "## Exact identifiers\n\nreceipt_90210",
+].join("\n\n");
+const prefixBody = [
+  `## Original Request\n\n${latestAsk}`,
+  "## Early Progress\n\nThe existing rollback has been preserved.",
+  "## Context for Suffix\n\nDeployment receipt receipt_90210 still needs verification.",
+].join("\n\n");
+
+type SummaryKind = "history" | "prefix";
+type HeldRequest = {
+  kind: SummaryKind;
+  prompt: string;
+  options: Parameters<StreamFn>[2];
+  consumed: boolean;
+  finish: (failure?: string, aborted?: boolean) => void;
+};
+
+function startScenario(split = true) {
+  const manager = stubSessionManager();
+  const controller = new AbortController();
+  const model = createAnthropicModelFixture({
+    api: "test-api" as never,
+    baseUrl: "",
+    reasoning: true,
+    maxTokens: 32_768,
+  });
+  setCompactionSafeguardRuntime(manager, {
+    model,
+    recentTurnsPreserve: 0,
+    qualityGuardEnabled: true,
+    qualityGuardMaxRetries: 0,
+  });
+  const requests: HeldRequest[] = [];
+  let releasing = false;
+  const streamFn: StreamFn = (_model, context, options) => {
+    const prompt = JSON.stringify(context);
+    const kind = prompt.includes("## Original Request") ? "prefix" : "history";
+    const stream = createAssistantMessageEventStream();
+    const request: HeldRequest = {
+      kind,
+      prompt,
+      options,
+      consumed: false,
+      finish: (failure, aborted = false) => {
+        stream.end({
+          role: "assistant",
+          content: [{ type: "text", text: kind === "history" ? historyBody : prefixBody }],
+          api: model.api,
+          provider: model.provider,
+          model: model.id,
+          usage: createZeroUsageFixture(),
+          stopReason: aborted ? "aborted" : failure ? "error" : "stop",
+          ...(failure ? { errorMessage: failure } : {}),
+          timestamp: 1,
+        });
+      },
+    };
+    const result = stream.result.bind(stream);
+    stream.result = async () => {
+      const message = await result();
+      request.consumed = true;
+      return message;
+    };
+    requests.push(request);
+    if (releasing) {
+      request.finish();
+    }
+    return stream;
+  };
+  const event = createCompactionEvent({
+    messageText: "Keep the approved deployment and its rollback.",
+    tokensBefore: 1_000,
+  });
+  const current = { role: "user" as const, content: latestAsk, timestamp: 3 };
+  let settled = false;
+  const outcome = createCompactionHandler()(
+    {
+      ...event,
+      signal: controller.signal,
+      thinkingLevel: "max",
+      streamFn,
+      preparation: {
+        ...event.preparation,
+        messagesToSummarize: split
+          ? event.preparation.messagesToSummarize
+          : [...event.preparation.messagesToSummarize, current],
+        turnPrefixMessages: split ? [current] : [],
+        isSplitTurn: split,
+        latestUnresolvedUserRequest: latestAsk,
+        settings: { reserveTokens: 20_000 },
+      },
+    },
+    createCompactionContext({
+      sessionManager: manager,
+      getApiKeyAndHeadersMock: vi.fn().mockResolvedValue({ ok: true, apiKey: "test-key" }),
+    }),
+  ).then(
+    (value) => {
+      settled = true;
+      return { value, error: undefined };
+    },
+    (error: unknown) => {
+      settled = true;
+      return { value: undefined, error };
+    },
+  );
+  return {
+    manager,
+    controller,
+    requests,
+    outcome,
+    isSettled: () => settled,
+    request: (kind: SummaryKind) => {
+      const request = requests.find((candidate) => candidate.kind === kind);
+      if (!request) {
+        throw new Error(`Missing ${kind} stream`);
+      }
+      return request;
+    },
+    cleanup: async () => {
+      releasing = true;
+      for (const request of requests) {
+        request.finish();
+      }
+      await outcome;
+      setCompactionSafeguardRuntime(manager, null);
+    },
+  };
+}
+
+describe("split compaction request ownership", () => {
+  const scenarios: ReturnType<typeof startScenario>[] = [];
+  afterEach(async () => {
+    await Promise.all(scenarios.splice(0).map((scenario) => scenario.cleanup()));
+  });
+  function start(split = true) {
+    const scenario = startScenario(split);
+    scenarios.push(scenario);
+    return scenario;
+  }
+
+  it("starts the split prefix while history is held and joins both before finalizing", async () => {
+    const scenario = start();
+    await vi.waitFor(() => expect(scenario.requests).toHaveLength(2));
+    const history = scenario.request("history");
+    const prefix = scenario.request("prefix");
+    expect(scenario.isSettled()).toBe(false);
+    expect(history.options?.signal).toBe(scenario.controller.signal);
+    expect(prefix.options?.signal).toBe(scenario.controller.signal);
+    expect([history.options?.reasoning, prefix.options?.reasoning]).toEqual(["max", "max"]);
+    expect([history.options?.maxTokens, prefix.options?.maxTokens]).toEqual([16_000, 10_000]);
+    expect(history.prompt).toContain("Keep the approved deployment and its rollback.");
+    expect(prefix.prompt).toContain(latestAsk);
+    prefix.finish();
+    await vi.waitFor(() => expect(prefix.consumed).toBe(true));
+    expect(scenario.isSettled()).toBe(false);
+    history.finish();
+    const { value, error } = await scenario.outcome;
+    expect(error).toBeUndefined();
+    const summary = expectCompactionResult(value as Parameters<typeof expectCompactionResult>[0]);
+    expect(summary.summary).toContain(historyBody);
+    expect(summary.summary).toContain("**Turn Context (split turn):**");
+    expect(summary.summary).toContain("### Early Progress");
+    expect(summary.summary).toContain(latestAsk);
+    expect(summary.summary).toContain("receipt_90210");
+    expect(summary.firstKeptEntryId).toBe("entry-1");
+    expect(summary.tokensBefore).toBe(1_000);
+  });
+
+  it.each(["history", "prefix"] as const)(
+    "joins the held peer before cancelling after a %s stream failure",
+    async (kind) => {
+      const scenario = start();
+      await vi.waitFor(() => expect(scenario.requests).toHaveLength(2));
+      const failed = scenario.request(kind);
+      const held = scenario.request(kind === "history" ? "prefix" : "history");
+      failed.finish(`${kind} request timed out`);
+      await vi.waitFor(() => expect(failed.consumed).toBe(true));
+      expect(scenario.isSettled()).toBe(false);
+      held.finish();
+      const { value, error } = await scenario.outcome;
+      expect(error).toBeUndefined();
+      expect(value).toEqual({ cancel: true });
+      expect(held.consumed).toBe(true);
+      expect(consumeCompactionSafeguardCancellation(scenario.manager)?.reason).toContain(
+        `${kind} request timed out`,
+      );
+      expect(scenario.requests).toHaveLength(2);
+    },
+  );
+
+  it("joins both aborted streams before returning the original caller cancellation", async () => {
+    const scenario = start();
+    await vi.waitFor(() => expect(scenario.requests).toHaveLength(2));
+    const reason = new Error("original caller cancellation");
+    scenario.controller.abort(reason);
+    const history = scenario.request("history");
+    const prefix = scenario.request("prefix");
+    expect(history.options?.signal?.aborted).toBe(true);
+    expect(prefix.options?.signal?.aborted).toBe(true);
+    history.finish("history aborted", true);
+    await vi.waitFor(() => expect(history.consumed).toBe(true));
+    expect(scenario.isSettled()).toBe(false);
+    prefix.finish("prefix aborted", true);
+    const outcome = await scenario.outcome;
+    expect(outcome.error).toBe(reason);
+    expect(outcome.value).toBeUndefined();
+    expect(prefix.consumed).toBe(true);
+    expect(consumeCompactionSafeguardCancellation(scenario.manager)).toBeNull();
+  });
+
+  it("retains the history failure when both requests fail in the opposite order", async () => {
+    const scenario = start();
+    await vi.waitFor(() => expect(scenario.requests).toHaveLength(2));
+    const prefix = scenario.request("prefix");
+    prefix.finish("prefix request timed out");
+    await vi.waitFor(() => expect(prefix.consumed).toBe(true));
+    expect(scenario.isSettled()).toBe(false);
+    scenario.request("history").finish("history request timed out");
+    const { value, error } = await scenario.outcome;
+    expect(error).toBeUndefined();
+    expect(value).toEqual({ cancel: true });
+    expect(consumeCompactionSafeguardCancellation(scenario.manager)?.reason).toContain(
+      "history request timed out",
+    );
+    expect(scenario.requests.every((request) => request.consumed)).toBe(true);
+  });
+
+  it("keeps history-only compaction to one joined request", async () => {
+    const scenario = start(false);
+    await vi.waitFor(() => expect(scenario.requests).toHaveLength(1));
+    scenario.request("history").finish();
+    const { value, error } = await scenario.outcome;
+    expect(error).toBeUndefined();
+    expectCompactionResult(value as Parameters<typeof expectCompactionResult>[0]);
+    expect(scenario.requests).toHaveLength(1);
+  });
+});
diff --git a/src/agents/agent-hooks/compaction-safeguard-summaries.ts b/src/agents/agent-hooks/compaction-safeguard-summaries.ts

+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import {
+  clearFollowupQueue,
+  getFollowupQueue,
+  inspectFollowupQueueAdmission,
+} from "./auto-reply/reply/queue/state.js";
+import { createMockFollowupRun } from "./auto-reply/reply/test-helpers.js";
+import { cleanupBrowserSessionsForTaskCompletion } from "./browser-lifecycle-cleanup.js";
+import type { InternalSessionEntry, SessionGoalStatus } from "./config/sessions/types.js";
+import type { BrowserTaskCompletionCleanup } from "./plugin-sdk/browser-maintenance.js";
+
+const owner = vi.hoisted(() => ({
+  entry: undefined as InternalSessionEntry | undefined,
+  generation: "current",
+  activeRunId: undefined as string | undefined,
+  reply: false,
+  descendants: false,
+  continuation: false,
+}));
+const close = vi.hoisted(() =>
+  vi.fn(
+    async (_params: {
+      sessionKeys: Array<string | undefined>;
+      taskCompletion?: BrowserTaskCompletionCleanup;
+    }) => 0,
+  ),
+);
+vi.mock("./plugin-sdk/browser-maintenance.js", () => ({
+  closeTrackedBrowserTabsForSessions: close,
+}));
+vi.mock("./config/sessions/session-accessor.js", () => ({
+  loadSessionEntryReadOnly: () => owner.entry,
+}));
+vi.mock("./infra/agent-events.js", () => ({
+  getAgentEventLifecycleGeneration: () => owner.generation,
+}));
+vi.mock("./agents/embedded-agent-runner/runs.js", () => ({
+  resolveActiveEmbeddedRunOwner: () =>
+    owner.activeRunId ? { runId: owner.activeRunId } : undefined,
+}));
+vi.mock("./auto-reply/reply/reply-run-registry.js", () => ({
+  replyRunRegistry: { get: () => owner.reply },
+}));
+vi.mock("./agents/subagents/registry/subagent-registry-read.js", () => ({
+  hasDescendantRunAwaitingSettle: () => owner.descendants,
+  hasPendingRequesterYieldContinuation: () => owner.continuation,
+}));
+
+function request() {
+  return {
+    cfg: {},
+    sessionKey: "agent:main:primary",
+    storePath: "/fixture/openclaw-agent.sqlite",
+    agentId: "main",
+    runId: "finished",
+    lifecycleGeneration: "current",
+    expectedSession: { sessionId: "session", lifecycleRevision: "revision" },
+    completedAt: 20,
+    isCurrent: () => true,
+  };
+}
+
+function queuedSource() {
+  const source = createMockFollowupRun();
+  const queue = getFollowupQueue(request().sessionKey, { mode: "followup", cap: 10 });
+  // The drain deliberately retains its in-flight source in items through delivery.
+  queue.items.push(source);
+  queue.inFlight.add(source);
+  return { source, queue };
+}
+
+describe("ordinary browser task completion ownership", () => {
+  beforeEach(() => {
+    clearFollowupQueue(request().sessionKey);
+    vi.clearAllMocks();
+    Object.assign(owner, {
+      entry: {
+        ...request().expectedSession,
+        activeWriterRunId: "finished",
+        lastInteractionAt: 10,
+        updatedAt: 20,
+      },
+      generation: "current",
+      activeRunId: undefined,
+      reply: false,
+      descendants: false,
+      continuation: false,
+    });
+  });
+  afterEach(() => clearFollowupQueue(request().sessionKey));
+
+  it("passes a still-revocable exact terminal owner to tracked cleanup", async () => {
+    await cleanupBrowserSessionsForTaskCompletion(request());
+    expect(close).toHaveBeenCalledOnce();
+    const completion = close.mock.calls[0]?.[0].taskCompletion;
+    expect(completion?.completedAt).toBe(20);
+    expect(completion?.isCurrent()).toBe(true);
+    owner.entry = { ...owner.entry!, activeWriterRunId: "followup" };
+    expect(completion?.isCurrent()).toBe(false);
+  });
+
+  it.each([

+import { asOptionalObjectRecord } from "@openclaw/normalization-core/record-coerce";
+import { normalizeOptionalString } from "@openclaw/normalization-core/string-coerce";
+import { isSubagentSessionKey } from "../../sessions/session-key-utils.js";
+import { getLatestSubagentRunByChildSessionKey } from "../subagents/registry/subagent-registry-read.js";
+
+export function readSessionsSendProgressTarget(args: unknown): string | undefined {
+  return normalizeOptionalString(asOptionalObjectRecord(args)?.sessionKey);
+}
+
+/** Internal child coordination stays in runtime records, outside channel tool attention. */
+export function resolveInternalSessionsSendProgressTarget(params: {
+  toolName: string;
+  args: unknown;
+  requesterSessionKey?: string;
+}): string | undefined {
+  if (params.toolName !== "sessions_send" || !params.requesterSessionKey) {
+    return undefined;
+  }
+  const target = readSessionsSendProgressTarget(params.args);
+  if (!target || !isSubagentSessionKey(target)) {
+    return undefined;
+  }
+  // Use the scoped readable registry so worker processes see the same owner.
+  const child = getLatestSubagentRunByChildSessionKey(target);
+  return child?.requesterSessionKey === params.requesterSessionKey ? target : undefined;
+}

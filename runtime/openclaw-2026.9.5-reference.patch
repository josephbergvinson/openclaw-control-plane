@@ -0,0 +1,229 @@
+import { expectDefined } from "@openclaw/normalization-core";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import {
+  createOperationalRunInstanceRef,
+  getAdmittedRunDelegatedAuthority,
+  prepareAgentRunAdmission,
+} from "../../agents/admitted-run-context.js";
+import type { RunCliAgentParams } from "../../agents/cli-runner/types.js";
+import {
+  captureCronRequesterGrantIssuer,
+  createCronCreatorAuthorityCapability,
+  runWithCronCreatorAuthorityCapability,
+} from "../../agents/cron-creator-authority-context.js";
+import type { RunEmbeddedAgentParams } from "../../agents/embedded-agent-runner/run/params.js";
+import { resolveMcpRequesterScope } from "../../agents/mcp-requester-scope.js";
+import {
+  consumeCronCreatorAuthorityGrant,
+  resolveCronCreatorAuthorityGrantProvenance,
+} from "../../gateway/cron-creator-authority-grant.js";
+import { runOpenClawStateWriteTransaction } from "../../state/openclaw-state-db.js";
+import { bindCronJobAdmittedRun, resetCronActiveJobs } from "../active-jobs.js";
+import { CronService } from "../service.js";
+import { createCronStoreHarness, createNoopLogger } from "../service.test-harness.js";
+import { markServiceCronJobActive } from "../service/run-receipts.js";
+import { createCronServiceState } from "../service/state.js";
+import { loadCronStore } from "../store.js";
+import {
+  claimCronRunReceiptInDatabase,
+  finishCronRunReceipt,
+  prepareCronRunReceiptClaim,
+  type CronRunReceiptHandle,
+} from "../store/run-receipt-store.js";
+import type { CronJobCreate, CronToolsAllowProvenance } from "../types.js";
+import { makeIsolatedAgentParamsFixture } from "./job-fixtures.js";
+import { setupRunCronIsolatedAgentTurnSuite } from "./run.suite-helpers.js";
+import {
+  getChannelPluginMock,
+  isCliProviderMock,
+  loadRunCronIsolatedAgentTurn,
+  mockRunCronFallbackPassthrough,
+  runCliAgentMock,
+  runEmbeddedAgentMock,
+} from "./run.test-harness.js";
+
+const runCronIsolatedAgentTurn = await loadRunCronIsolatedAgentTurn();
+const { makeStorePath } = createCronStoreHarness({ prefix: "cron-mcp-requester-" });
+setupRunCronIsolatedAgentTurnSuite({ fast: true });
+afterEach(() => resetCronActiveJobs());
+
+describe("cron authenticated requester runner projection", () => {
+  it.each([
+    { runner: "embedded", authenticated: true },
+    { runner: "cli", authenticated: true },
+    { runner: "embedded", authenticated: false },
+    { runner: "cli", authenticated: false },
+  ] as const)(
+    "projects only stored authenticated=$authenticated creator credentials into $runner with no message grant",
+    async ({ runner, authenticated }) => {
+      const { storePath } = await makeStorePath();
+      const logger = createNoopLogger();
+      const deps = {
+        storePath,
+        cronEnabled: false,
+        log: logger,
+        enqueueSystemEvent: vi.fn(),
+        requestHeartbeat: vi.fn(),
+        runIsolatedAgentJob: vi.fn(async () => ({ status: "ok" as const })),
+      };
+      const cron = new CronService(deps);
+      const requester = {
+        version: 1 as const,
+        channel: "discord",
+        accountId: "work",
+        senderId: "requester-a",
+      };
+      const owner = {
+        agentId: "main",
+        accountId: requester.accountId,
+        sessionKey: "agent:main:discord:group:ops",
+      };
+      const policy = {
+        version: 1 as const,
+        mode: "account" as const,
+        ownerSessionKey: owner.sessionKey,
+        ownerAccountId: owner.accountId,
+      };
+      const definition: CronJobCreate = {
+        name: "Company report",
+        enabled: true,
+        schedule: { kind: "every", everyMs: 60_000 },
+        sessionTarget: "isolated",
+        wakeMode: "next-heartbeat",
+        owner,
+        sessionKey: owner.sessionKey,
+        payload: { kind: "agentTurn", message: "Read the company report", toolsAllow: ["read"] },
+        delivery: { mode: "none" },
+      };
+      const creatorRunId = "authenticated-cron-creator";
+      const creatorAdmission = prepareAgentRunAdmission({
+        cfg: {},
+        operationalRunInstance: createOperationalRunInstanceRef(creatorRunId),
+        facts: {
+          runId: creatorRunId,
+          agentId: "main",
+          ingress: { kind: "system", boundary: "cron-requester-test", state: "present" },
+        },
+      });
+      let receipt: CronRunReceiptHandle | undefined;
+      let captured: RunCliAgentParams | RunEmbeddedAgentParams | undefined;
+      try {
+        let provenance: CronToolsAllowProvenance | undefined;
+        if (authenticated) {
+          const admitted = await creatorAdmission.admit("gateway");
+          const authority = expectDefined(
+            getAdmittedRunDelegatedAuthority(admitted),
+            "creator admission",
+          );
+          const creator = expectDefined(
+            createCronCreatorAuthorityCapability(
+              creatorRunId,
+              { kind: "external", channel: requester.channel },
+              undefined,
+              undefined,
+              requester,
+            ),
+            "native creator binding",
+          );
+          await runWithCronCreatorAuthorityCapability(creator, async () => {
+            const issuer = expectDefined(
+              captureCronRequesterGrantIssuer(creatorRunId),
+              "private requester issuer",
+            );
+            const grant = issuer(authority);
+            const capturedProvenance = expectDefined(
+              resolveCronCreatorAuthorityGrantProvenance(grant, creatorRunId),
+              "authenticated creator provenance",
+            );
+            const channelRequester = expectDefined(
+              capturedProvenance.channelRequester,
+              "authenticated requester tuple",
+            );
+            provenance = { version: 1, source: "authenticated-requester", channelRequester };
+            await cron.add(definition, {
+              scheduledToolPolicy: policy,
+              toolsAllowProvenance: provenance,
+              commitGuard: () => {
+                consumeCronCreatorAuthorityGrant(grant);
+              },
+            });
+          });
+        } else {
+          await cron.add(definition, { scheduledToolPolicy: policy });
+        }
+        creatorAdmission.close();
+        const job = expectDefined((await loadCronStore(storePath)).jobs[0], "persisted job");
+        expect(job.toolsAllowProvenance).toEqual(provenance);
+        const preparedClaim = prepareCronRunReceiptClaim({
+          storePath,
+          job,
+          agentId: "main",
+          startedAtMs: Date.now(),
+        });
+        receipt = runOpenClawStateWriteTransaction(({ db }) =>
+          claimCronRunReceiptInDatabase({
+            database: db,
+            prepared: preparedClaim,
+            resolveAgentId: () => "main",
+          }),
+        );
+        const marker = markServiceCronJobActive(createCronServiceState(deps), job, receipt);
+        const controller = new AbortController();
+        getChannelPluginMock.mockReturnValue({
+          config: { listAccountIds: () => ["work"] },
+        });
+        isCliProviderMock.mockReturnValue(runner === "cli");
+        mockRunCronFallbackPassthrough();
+        (runner === "cli" ? runCliAgentMock : runEmbeddedAgentMock).mockImplementationOnce(
+          async (request: RunCliAgentParams | RunEmbeddedAgentParams) => {
+            captured = request;
+            const admission = expectDefined(request.preparedRunAdmission, "scheduled admission");
+            bindCronJobAdmittedRun(
+              marker,
+              await admission.admit(runner === "cli" ? "plugin-harness" : "embedded"),
+              controller.signal,
+            );
+            expect(request.toolsAllow).toEqual(["read"]);
+            expect(request.messageActionTurnCapability).toBeUndefined();
+            expect(request.senderId).toBeUndefined();
+            expect(request.senderIsOwner).toBeUndefined();
+            expect(request.agentAccountId).toBeUndefined();
+            expect(request.messageChannel).toBeUndefined();
+            expect(resolveMcpRequesterScope(request)).toEqual(
+              authenticated
+                ? {
+                    requesterSenderId: "requester-a",
+                    agentAccountId: "work",
+                    messageChannel: "discord",
+                  }
+                : undefined,
+            );
+            expect(request.scheduledToolPolicy).toMatchObject(policy);
+            return { payloads: [{ text: "Report complete" }], meta: { agentMeta: {} } };
+          },
+        );
+        const result = await runCronIsolatedAgentTurn(
+          makeIsolatedAgentParamsFixture({
+            job,
+            message: definition.payload.kind === "agentTurn" ? definition.payload.message : "",
+            sessionKey: `cron:${job.id}`,
+          }),
+        );
+        expect(result.status, JSON.stringify(result)).toBe("ok");
+        const request = expectDefined(captured, "executed runner request");
+        if (authenticated) {
+          expect(() => resolveMcpRequesterScope(request)).toThrow();
+        } else {
+          expect(request.mcpRequesterScope).toBeUndefined();
+          expect(request.mcpRequesterScopeAssertCurrent).toBeUndefined();
+        }
+      } finally {
+        if (receipt) {
+          finishCronRunReceipt({ handle: receipt, status: "ok", finishedAtMs: Date.now() });
+        }
+        creatorAdmission.close();
+        cron.stop();
+      }
+    },
+  );
+});

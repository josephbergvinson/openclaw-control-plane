+import path from "node:path";
+import { expect, it, vi, type Mock } from "vitest";
+import { setRuntimeConfigSnapshot } from "../../config/io.js";
+import { upsertSessionEntryCore } from "../../config/sessions/session-accessor.js";
+import type { OpenClawConfig } from "../../config/types.openclaw.js";
+import { withTestDir } from "../../test-helpers/temp-dir.js";
+import { requireDetails, type SessionsToolTestConfig } from "./sessions.test-fixtures.js";
+
+/** Shared sessions suite setup exercises native completion custody through the real tool. */
+export function registerOwnedChildFollowupTests({
+  callGatewayMock,
+  loadConfigMock,
+  getCreateSessionsSendTool,
+}: {
+  callGatewayMock: Mock;
+  loadConfigMock: ReturnType<typeof vi.fn<() => SessionsToolTestConfig>>;
+  getCreateSessionsSendTool: () => typeof import("./sessions-send-tool.js").createSessionsSendTool;
+}) {
+  const MAIN_AGENT_SESSION_KEY = "agent:main:main";
+  it.each<{
+    state: "idle" | "active";
+    splitOwner: boolean;
+    recovered?: boolean;
+    mode?: "followup";
+    completesDuringSend: boolean;
+    sourceReplyDeliveryMode?: "automatic" | "message_tool_only";
+    failure?: "claim" | "active-owner" | "aborted" | "gateway-retired" | "starting";
+  }>([
+    { state: "idle", splitOwner: false, completesDuringSend: false },
+    { state: "active", splitOwner: false, completesDuringSend: false, recovered: true },
+    {
+      state: "active",
+      splitOwner: false,
+      completesDuringSend: false,
+      recovered: true,
+      mode: "followup",
+    },
+    {
+      state: "active",
+      splitOwner: false,
+      completesDuringSend: false,
+      recovered: true,
+      mode: "followup",
+      failure: "starting",
+    },
+    {
+      state: "idle",
+      splitOwner: false,
+      completesDuringSend: false,
+      recovered: true,
+      mode: "followup",
+    },
+    { state: "active", splitOwner: false, completesDuringSend: false },
+    {
+      state: "active",
+      splitOwner: false,
+      completesDuringSend: false,
+      sourceReplyDeliveryMode: "message_tool_only",
+    },
+    { state: "idle", splitOwner: true, completesDuringSend: false },
+    { state: "active", splitOwner: false, completesDuringSend: true },
+    { state: "active", splitOwner: false, completesDuringSend: false, failure: "claim" },
+    { state: "active", splitOwner: false, completesDuringSend: false, failure: "active-owner" },
+    { state: "active", splitOwner: false, completesDuringSend: false, failure: "aborted" },
+    { state: "active", splitOwner: false, completesDuringSend: false, failure: "gateway-retired" },
+    { state: "idle", splitOwner: false, completesDuringSend: false, failure: "gateway-retired" },
+  ])(
+    "preserves native child follow-up ownership or reports an undeliverable follow-up: %j",
+    async ({
+      state,
+      splitOwner,
+      recovered,
+      mode,
+      completesDuringSend,
+      sourceReplyDeliveryMode = "automatic",
+      failure,
+    }) => {
+      await withTestDir({ prefix: "openclaw-native-child-followup-" }, async (dir) => {
+        const read = await import("../subagents/registry/subagent-registry-read.js");
+        const registry = await import("../subagents/registry/subagent-registry.js");
+        const reactivation = await import("../../gateway/session-subagent-reactivation.js");
+        const runtime = await import("../embedded-agent-runner/runs.js");
+        const callerContext = await import("./gateway-caller-context.js");
+        const { claimSubagentFollowupOwner } =
+          await import("../subagents/registry/subagent-followup-owner.js");
+        const { markRequesterTurnYieldedInRuns } =
+          await import("../subagents/registry/subagent-registry-requester-yield.js");
+        const { runSessionsSendA2AFlow } = await import("./sessions-send-tool.a2a.js");
+        const storePath = path.join(dir, "sessions.json");
+        const childSessionKey = "agent:main:dashboard:retained-child";
+        const activeSessionId = recovered ? "private-child" : "native-child";
+        const activeSessionKey = recovered
+          ? "agent:main:internal-session-effects:recovered-child"
+          : childSessionKey;
+        const entry: import("../subagents/registry/subagent-registry.types.js").SubagentRunRecord =
+          {
+            runId: "first-execution",
+            taskRunId: "original-task",
+            childSessionKey,
+            requesterSessionKey: MAIN_AGENT_SESSION_KEY,
+            requesterAgentId: "main",
+            requesterDisplayKey: "main",
+            task: "initial work",
+            cleanup: "keep" as const,
+            createdAt: 1,
+            expectsCompletionMessage: true,
+            execution:
+              state === "idle"
+                ? { status: "terminal" as const, endedAt: 2 }
+                : { status: "running" as const, startedAt: 1 },
+          };
+        if (recovered) {
+          entry.execution.transcriptTarget = {
+            agentId: "main",
+            sessionId: activeSessionId,
+            sessionKey: activeSessionKey,
+            storePath,
+          };
+          await upsertSessionEntryCore(
+            { agentId: "main", sessionKey: activeSessionKey, storePath },
+            { sessionId: activeSessionId, updatedAt: 1 },
+          );
+        }
+        const runs = new Map<
+          string,
+          import("../subagents/registry/subagent-registry.types.js").SubagentRunRecord
+        >([[entry.runId, entry]]);
+        const config = {
+          session: { scope: "per-sender", mainKey: "main", store: storePath },
+          tools: { agentToAgent: { enabled: true }, sessions: { visibility: "all" } },
+        } as OpenClawConfig;
+        setRuntimeConfigSnapshot(config);
+        loadConfigMock.mockReturnValue(config as SessionsToolTestConfig);
+        await upsertSessionEntryCore(
+          { agentId: "main", sessionKey: childSessionKey, storePath },
+          {
+            sessionId: "native-child",
+            updatedAt: 1,
+            parentSessionKey: MAIN_AGENT_SESSION_KEY,
+            spawnedBy: MAIN_AGENT_SESSION_KEY,
+            createdVia: "spawn",
+          },
+        );
+        const readSpy = vi
+          .spyOn(read, "getLatestSubagentRunByChildSessionKey")
+          .mockImplementation(() => [...runs.values()][0] ?? null);
+        let gatewayOpen = true;
+        const gatewayContext =
+          {} as import("../../gateway/server-methods/types.js").GatewayRequestContext;
+        const callerSpy = vi.spyOn(callerContext, "getGatewayToolCallerIdentity").mockReturnValue(
+          failure === "gateway-retired"
+            ? {
+                agentId: "main",
+                sessionKey: MAIN_AGENT_SESSION_KEY,
+                receiptAuthority: () => true,
+                gatewayContextResolver: () => (gatewayOpen ? gatewayContext : undefined),
+              }
+            : undefined,
+        );
+        const inject = vi.fn<
+          NonNullable<
+            import("../embedded-agent-runner/runs.js").EmbeddedAgentQueueHandle["messageInjectionV2"]
+          >["queueMessage"]
+        >(async (_text, _options, assertCurrent) => {
+          assertCurrent();
+          if (completesDuringSend) {
+            runs.get(entry.runId)!.execution = { status: "terminal", endedAt: 3 };
+          }
+          if (failure === "gateway-retired") {
+            gatewayOpen = false;
+          }
+        });
+        const handle: import("../embedded-agent-runner/runs.js").EmbeddedAgentQueueHandle = {
+          runId: failure === "active-owner" ? "untracked-active-run" : entry.runId,
+          sourceReplyDeliveryMode,
+          supportsTranscriptCommitWait: true,
+          queueMessage: vi.fn(),
+          messageInjectionV2: { version: 2, isAvailable: () => true, queueMessage: inject },
+          isStreaming: () => true,
+          isCompacting: () => false,
+          abort: vi.fn(),
+        };
+        if (state === "active" && failure !== "starting") {
+          runtime.setActiveEmbeddedRun(
+            activeSessionId,
+            handle,
+            activeSessionKey,
+            undefined,
+            "main",
+          );
+        }
+        const reactivateSpy = vi
+          .spyOn(reactivation, "reactivateCompletedSubagentSession")
+          .mockImplementation(async ({ runId }) => {
+            runs.delete(entry.runId);
+            runs.set(runId!, { ...entry, runId: runId!, execution: { status: "running" } });
+            return true;
+          });
+        const persistOrThrow = vi.fn();
+        const claimSpy = vi
+          .spyOn(registry, "claimSubagentFollowup")
+          .mockImplementation((params) =>
+            failure === "claim"
+              ? undefined
+              : claimSubagentFollowupOwner({ ...params, runs, persistOrThrow }),
+          );
+        callGatewayMock.mockImplementation(async (request: { method?: string }) => {
+          if (request.method === "agent") {
+            if (failure === "gateway-retired") {
+              gatewayOpen = false;
+            }
+            return { runId: "followup-execution" };
+          }
+          return request.method === "sessions.list"
+            ? { path: storePath, sessions: [{ key: childSessionKey, kind: "direct" }] }
+            : {};
+        });
+        vi.mocked(runSessionsSendA2AFlow).mockClear();
+        try {
+          const result = await getCreateSessionsSendTool()({
+            agentId: "main",
+            agentSessionKey: splitOwner
+              ? "agent:main:telegram:direct:123456"
+              : MAIN_AGENT_SESSION_KEY,
+            completionOwnerKey: MAIN_AGENT_SESSION_KEY,
+            requesterTurnRunId: "resumed-parent",
+            config,
+            callGateway: callGatewayMock,
+          }).execute(
+            "followup",
+            {
+              sessionKey: childSessionKey,
+              message: "finish the remaining fix",
+              timeoutSeconds: 0,
+              watch: true,
+              mode,
+            },
+            failure === "aborted" ? AbortSignal.abort(new Error("follow-up cancelled")) : undefined,
+          );
+          if (failure) {
+            expect(requireDetails(result)).toMatchObject({ status: "error" });
+            expect(requireDetails(result).sentBeforeError).toBe(
+              failure === "claim" || failure === "gateway-retired" ? true : undefined,
+            );
+            expect(requireDetails(result).error).toContain(
+              failure === "claim" || failure === "gateway-retired"
+                ? "do not resend"
+                : failure === "aborted"
+                  ? "follow-up cancelled"
+                  : "follow-up was not sent",
+            );
+            expect(runs.get(entry.runId)!.requesterTurnRunId).toBeUndefined();
+            if (failure === "gateway-retired") {
+              expect(requireDetails(result).error).toContain("Gateway owner ended");
+              expect(claimSpy).not.toHaveBeenCalled();
+              expect(reactivateSpy).not.toHaveBeenCalled();
+            }
+          } else {
+            expect(requireDetails(result)).toMatchObject({
+              status: "accepted",
+              runId: state === "active" ? "first-execution" : "followup-execution",
+              completionRunId: "original-task",
+              childSessionKey,
+              expectsCompletionMessage: true,
+              targetDisposition: state === "active" ? "steered" : "queued",
+              delivery: { status: "pending", mode: "announce" },
+            });
+            expect(
+              markRequesterTurnYieldedInRuns({
+                requesterSessionKey: MAIN_AGENT_SESSION_KEY,
+                requesterAgentId: "main",
+                requesterTurnRunId: "resumed-parent",
+                runs,
+                persistOrThrow,
+              }),
+            ).toBe(1);
+          }
+          expect(runs.size).toBe(1);
+          expect(runSessionsSendA2AFlow).not.toHaveBeenCalled();
+          expect(inject).toHaveBeenCalledTimes(
+            state === "active" &&
+              failure !== "active-owner" &&
+              failure !== "aborted" &&
+              failure !== "starting"
+              ? 1
+              : 0,
+          );
+          expect(handle.sourceReplyDeliveryMode).toBe(sourceReplyDeliveryMode);
+          expect(handle.queueMessage).not.toHaveBeenCalled();
+          if (state === "idle") {
+            expect(callGatewayMock).toHaveBeenCalledWith(
+              expect.objectContaining({
+                method: "agent",
+                params: expect.objectContaining({ sourceReplyDeliveryMode: "message_tool_only" }),
+              }),
+            );
+          }
+          expect(
+            callGatewayMock.mock.calls.filter(([request]) => request.method === "agent"),
+          ).toHaveLength(state === "active" ? 0 : 1);
+        } finally {
+          readSpy.mockRestore();
+          if (state === "active") {
+            runtime.clearActiveEmbeddedRun(activeSessionId, handle);
+          }
+          reactivateSpy.mockRestore();
+          claimSpy.mockRestore();
+          callerSpy.mockRestore();
+        }
+      });
+    },
+  );
+}

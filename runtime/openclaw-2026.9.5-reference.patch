+      workspaceDir: state.path("workspace"),
+      config,
+      readRuntimeConfig: createRuntimeConfigReader(config),
+      provider: "custom",
+      model: "test-model",
+      timeoutMs: 1_000,
+      blockReplyBreak: "message_end",
+    },
+  };
+}
+async function replaceRuntime(retained: OpenClawConfig, replacement: OpenClawConfig) {
+  await refreshPreparedModelRuntimeSnapshots(retained, {
+    gatewayLifecycle: true,
+    catalogMode: "static",
+  });

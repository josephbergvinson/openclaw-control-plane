+import fs from "node:fs";
+import path from "node:path";
+import { pathToFileURL } from "node:url";
+import { describe, expect, it, vi } from "vitest";
+import { runManagedCommand } from "../../scripts/lib/managed-child-process.mts";
+import { resolveTestNodeExecPath } from "../../src/test-utils/node-process.js";
+import { createDeferred } from "../helpers/promise.js";
+import { createScriptTestHarness } from "./test-helpers.js";
+
+const { createTempDir } = createScriptTestHarness();
+const node = resolveTestNodeExecPath();
+const managedUrl = pathToFileURL(path.resolve("scripts/lib/managed-child-process.mts")).href;
+const tsxUrl = pathToFileURL(path.resolve("scripts/tsx.mjs")).href;
+
+describe.skipIf(process.platform === "win32")("native local check admission", () => {
+  it("refuses a competing process in another checkout before spawning and releases after abort joins", async () => {
+    const root = createTempDir("managed-host-admission-");
+    const admission = path.join(root, "host");
+    const checkouts: readonly [string, string] = [
+      path.join(root, "first"),
+      path.join(root, "second"),
+    ];
+    for (const checkout of checkouts) {
+      fs.mkdirSync(checkout);
+    }
+    const ready = createDeferred();
+    const abort = new AbortController();
+    const first = runManagedCommand({
+      bin: node,
+      args: ["-e", "setInterval(() => {}, 1000)"],
+      cwd: checkouts[0],
+      localCheckAdmission: admission,
+      signal: abort.signal,
+      timeoutMs: 10_000,
+      stdio: "ignore",

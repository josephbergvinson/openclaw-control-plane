+import {
+  getSubagentRunsForChildSession,
+  subagentRuns,
+} from "../agents/subagents/registry/subagent-registry-memory.js";
+import { getAgentRunContext, hasLiveAgentRunContext } from "../infra/agent-run-registry.js";
+import { hasAuthoritativeTaskBacking, readTaskBackingInstance } from "./task-backing-authority.js";
+import { shouldAutoDeliverTaskStateChange } from "./task-executor-policy.js";
+import type { TaskRecord } from "./task-registry.types.js";
+import { resolveTaskSessionAgentId } from "./task-session-identity.js";
+
+/** Structural ownership only; callers separately verify the current delivery route. */
+export function resolveNativeTaskProgressOwner(task: TaskRecord, runId?: string) {
+  if (task.runtime !== "subagent" || !shouldAutoDeliverTaskStateChange(task)) {
+    return undefined;
+  }
+  const backing = readTaskBackingInstance(task.detail);
+  if (backing?.runtime !== "subagent") {
+    return undefined;
+  }
+  const entry = runId
+    ? subagentRuns.get(runId)
+    : [...getSubagentRunsForChildSession(task.childSessionKey ?? "")].find(
+        (candidate) =>
+          candidate.generation === backing.generation &&
+          (candidate.taskRunId ?? candidate.runId) === task.runId,
+      );
+  if (
+    !entry ||
+    entry.generation !== backing.generation ||
+    (entry.taskRunId ?? entry.runId) !== task.runId ||
+    entry.childSessionKey !== task.childSessionKey ||
+    entry.requesterSessionKey !== task.ownerKey ||
+    (entry.requesterAgentId !== undefined && entry.requesterAgentId !== task.requesterAgentId) ||
+    entry.killIntent ||
+    entry.killReconciliation ||
+    entry.execution.suppressSessionEffects ||
+    entry.suppressAnnounceReason ||
+    entry.collect === true ||
+    (entry.execution.status === "terminal" && entry.pauseReason !== "sessions_yield") ||
+    !hasAuthoritativeTaskBacking(task)
+  ) {
+    return undefined;
+  }
+  if (entry.requesterTurnRunId) {
+    const requester = getAgentRunContext(entry.requesterTurnRunId);
+    const agentId = resolveTaskSessionAgentId(task.ownerKey, task.requesterAgentId);
+    if (
+      requester?.sessionKey === task.ownerKey &&
+      agentId !== undefined &&
+      resolveTaskSessionAgentId(requester.sessionKey, requester.agentId) === agentId &&
+      requester.isHeartbeat !== true &&
+      !requester.cronRunsByJobId?.size &&
+      requester.projectSessionMessages !== false &&
+      hasLiveAgentRunContext(entry.requesterTurnRunId)
+    ) {
+      return { kind: "foreground" as const, entry, generation: backing.generation };
+    }
+    return undefined;
+  }
+  const wake = entry.requesterSettleWake;
+  if (
+    wake?.requesterYieldBatch !== true ||
+    wake.status !== "pending" ||
+    wake.rearmGeneration === undefined ||
+    !wake.batchRunIds?.includes(entry.runId)
+  ) {
+    return undefined;
+  }
+  return { kind: "yielded" as const, entry, wake, generation: backing.generation };
+}

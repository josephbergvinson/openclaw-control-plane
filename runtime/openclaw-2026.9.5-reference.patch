+import { describe, expect, it } from "vitest";
+import {
+  parseComputerActParamsJSON,
+  COMPUTER_USE_V1_ACTION_NAMES,
+} from "./computer-use-contract.js";
+describe("native credential wire authority", () => {
+  it("preserves legacy v1 action capabilities", () => {
+    expect(COMPUTER_USE_V1_ACTION_NAMES).not.toContain("type_secret");
+  });
+  it.each([
+    { text: "synthetic" },
+    { value: "synthetic" },
+    { elementRef: "cua-ref" },
+    { windowRef: "peekaboo-ref" },
+  ])("rejects credential values and provider references %j", (extra) => {
+    expect(() =>
+      parseComputerActParamsJSON(
+        JSON.stringify({
+          action: "type_secret",
+          alias: "fixture",
+          promptRef: "native-credential:v1:fixture",
+          ...extra,
+        }),
+      ),
+    ).toThrow("invalid params");
+  });
+  it("requires alias plus opaque prompt and permits secret-free discovery", () => {
+    expect(() =>
+      parseComputerActParamsJSON('{"action":"type_secret","alias":"fixture"}'),
+    ).toThrow();
+    expect(parseComputerActParamsJSON('{"action":"credential_prompts"}')).toEqual({
+      action: "credential_prompts",
+    });
+  });
+});

+
+type CredentialHarness = ReturnType<typeof createCredentialHarness>;
+
+async function runSecureFill(
+  harness: CredentialHarness,
+  request: Omit<typeof REQUEST, "submit"> & { submit: boolean; submitRef?: string } = REQUEST,
+  assertCurrent?: () => void | Promise<void>,
+) {
+  runtimeMocks.getPage.mockImplementation(harness.getPage);
+  runtimeMocks.resolveElement.mockImplementation(harness.resolveElement);
+  runtimeMocks.resolveSecret.mockImplementation(harness.resolveSecret);
+  return await executeBrowserTypeSecret({
+    request,
+    cdpUrl: CDP_URL,
+    targetId: "tab-1",
+    assertCurrent,
+  });
+}
+
+async function readSecureFillError(
+  harness: CredentialHarness,
+  request: Omit<typeof REQUEST, "submit"> & { submit: boolean; submitRef?: string } = REQUEST,
+): Promise<string> {
+  try {
+    await runSecureFill(harness, request);
+    return "";
+  } catch (error) {
+    return String(error);
+  }
+}

+import { describe, expect, it } from "vitest";
+import { buildMessageToolSchemaFromActions } from "./message-tool-schema-scoping.js";
+import { MESSAGE_TOOL_SCHEMA_BUILDERS } from "./message-tool-schema.js";
+
+describe("role lifecycle message schema", () => {
+  it("scopes creation fields without advertising unrelated channel management", () => {
+    const schema = buildMessageToolSchemaFromActions(
+      ["role-create", "role-delete"],
+      {
+        includePresentation: false,
+        includeDeliveryPin: false,
+        includeBestEffort: false,
+        scopeToActions: true,
+      },
+      MESSAGE_TOOL_SCHEMA_BUILDERS,
+    );
+    expect(schema.properties).toHaveProperty("guildId");
+    expect(schema.properties).toHaveProperty("roleId");
+    for (const field of ["name", "permissions", "hoist", "mentionable"]) {
+      expect(schema.properties).toHaveProperty(field);
+    }
+    for (const field of ["channelType", "parentId", "topic", "position", "nsfw"]) {
+      expect(schema.properties).not.toHaveProperty(field);
+    }
+  });
+
+  it("does not add creation fields to deletion-only discovery", () => {
+    const schema = buildMessageToolSchemaFromActions(
+      ["role-delete"],
+      {
+        includePresentation: false,
+        includeDeliveryPin: false,
+        includeBestEffort: false,
+        scopeToActions: true,
+      },
+      MESSAGE_TOOL_SCHEMA_BUILDERS,
+    );
+    expect(schema.properties).toHaveProperty("guildId");
+    expect(schema.properties).toHaveProperty("roleId");
+    expect(schema.properties).not.toHaveProperty("permissions");
+    expect(schema.properties).not.toHaveProperty("hoist");
+    expect(schema.properties).not.toHaveProperty("mentionable");
+  });
+});

+import type { OperationalRunInstanceRef } from "../../agents/admitted-run-context.js";
+import type { SessionEntry } from "../../config/sessions.js";
+import { assertAgentRunLifecycleGenerationCurrent } from "../../infra/agent-events.js";
+import type { InputProvenance } from "../../sessions/input-provenance.js";
+import type { TrustedSubagentResume } from "../in-process-subagent-resume.js";
+import { mintLocalOperatorMessageActionCapability } from "../message-action-turn-capability.js";
+import type { AgentRunRequest } from "../server-methods/agent-request-types.js";
+import { resolveGatewayCronCreatorAuthorityAdmission } from "../server-methods/cron-creator-authority-admission.js";
+import { assertParentSubagentResumeSuccessorCurrent } from "../session-subagent-resume.js";
+import { loadGatewaySessionEntryReadOnly } from "../session-utils.js";
+import type { RestoredCronContinuation } from "./agent-handler-helpers.js";
+import { prepareAgentRunUserTurn } from "./agent-run-user-turn.js";
+import type { AgentTurnContext, AgentTurnPrincipal, PreparedAgentRunDispatch } from "./types.js";
+
+type NativeAdmissionSource = {
+  runId: string;
+  resolvedSessionKey?: string;
+  activeSessionAgentId: string;
+  lifecycleGeneration: string;
+  context: AgentTurnContext;
+  client: AgentTurnPrincipal | null;
+  request: AgentRunRequest;
+  sessionEntry?: SessionEntry;
+  getAdmittedSessionId: () => string;
+  hasCurrentClientAuthority?: () => boolean;
+  inputProvenance?: InputProvenance;
+  restoredCronContinuation?: RestoredCronContinuation;
+  isOneShotModelRun: boolean;
+  isRestartRecoveryResumeRun: boolean;
+};
+
+/** Exact input/controller ownership, including the adopted native resume successor. */
+export function createAgentRunInputOwnerCurrent(params: {
+  source: NativeAdmissionSource;
+  activeRunAbort: PreparedAgentRunDispatch["activeRunAbort"];
+  operationalRunInstance: OperationalRunInstanceRef | undefined;
+  parentResume?: TrustedSubagentResume;
+  isResumedTaskAdopted: () => boolean;
+  getAdmissionGuard: () => (() => void) | undefined;
+}): (terminal?: boolean) => void {
+  const {
+    source,
+    activeRunAbort,
+    operationalRunInstance,
+    parentResume,
+    getAdmissionGuard,
+    isResumedTaskAdopted,
+  } = params;
+  return (terminal = false) => {
+    getAdmissionGuard()?.();
+    if (parentResume && isResumedTaskAdopted() && !terminal) {
+      assertParentSubagentResumeSuccessorCurrent(parentResume, source.runId);
+    }
+    assertAgentRunLifecycleGenerationCurrent(source.lifecycleGeneration);
+    const entry = source.context.chatAbortControllers.get(source.runId);
+    if (
+      !entry ||
+      entry !== activeRunAbort.entry ||
+      entry.operationalRunInstance !== operationalRunInstance ||
+      (!terminal && entry.registrationCleanupRequested)
+    ) {
+      throw new Error("agent input admission no longer owns this run");
+    }
+  };
+}
+
+/** Classify the original ingress and mint only its private local operator grant. */
+export function resolveAgentRunOperatorMessageAuthority(
+  source: NativeAdmissionSource,
+  options: {
+    existingCapability?: string;
+    hasMessageActionSource: boolean;
+    hasParentResume: boolean;
+    assertRunCurrent: () => void;
+  },
+) {
+  const cronCreatorAuthority = resolveGatewayCronCreatorAuthorityAdmission({
+    runId: source.runId,
+    resolvedSessionKey: source.resolvedSessionKey,
+    sessionId: source.getAdmittedSessionId(),
+    spawnedBy: source.sessionEntry?.spawnedBy,
+    client: source.client,
+    request: source.request,
+    isCurrent: source.hasCurrentClientAuthority,
+    inputProvenance: source.inputProvenance,
+    hasRestoredCronContinuation: source.restoredCronContinuation !== undefined,
+    isOneShotModelRun: source.isOneShotModelRun,
+    isRestartRecoveryResumeRun: source.isRestartRecoveryResumeRun,
+  });
+  let operatorMessageActionCapability = options.existingCapability;
+  if (
+    cronCreatorAuthority?.callerOrigin.kind === "local" &&
+    !operatorMessageActionCapability &&
+    !options.hasMessageActionSource &&
+    source.resolvedSessionKey &&
+    !options.hasParentResume
+  ) {
+    const sessionKey = source.resolvedSessionKey;
+    const sessionId = source.getAdmittedSessionId();
+    const readSession = () =>
+      loadGatewaySessionEntryReadOnly(sessionKey, {
+        agentId: source.activeSessionAgentId,
+        clone: false,
+        projection: "list",
+      }).entry;
+    const revision = readSession()?.lifecycleRevision;
+    operatorMessageActionCapability = mintLocalOperatorMessageActionCapability({
+      identity: {
+        agentId: source.activeSessionAgentId,
+        runId: source.runId,
+        sessionKey,
+        sessionId,
+      },
+      admission: cronCreatorAuthority,
+      client: source.client,
+      assertRunCurrent: options.assertRunCurrent,
+      assertSessionCurrent: () => {
+        const entry = readSession();
+        if (
+          !entry ||
+          entry.sessionId !== sessionId ||
+          entry.archivedAt !== undefined ||
+          entry.lifecycleRevision !== revision
+        ) {
+          throw new Error("Operator message authority logical session has changed.");
+        }
+      },
+    });
+  }
+  return { cronCreatorAuthority, operatorMessageActionCapability };
+}
+
+/** Prepare the pending native input under its exact live and terminal ownership guards. */
+export function prepareAgentRunNativeUserTurn(
+  source: Omit<
+    Parameters<typeof prepareAgentRunUserTurn>[0],
+    | "assertCurrent"
+    | "assertCompletionCurrent"
+    | "abortSignal"
+    | "getAbortStopReason"
+    | "deferTimeoutCompletion"
+    | "admittedSessionId"
+    | "resolvedThreadId"
+  > & { getAdmittedSessionId: () => string },
+  options: {
+    assertInputOwnerCurrent: (terminal?: boolean) => void;
+    activeRunAbort: PreparedAgentRunDispatch["activeRunAbort"];
+    resolvedThreadId?: string | number;
+  },
+): ReturnType<typeof prepareAgentRunUserTurn> {
+  const { assertInputOwnerCurrent, activeRunAbort, resolvedThreadId } = options;
+  return prepareAgentRunUserTurn({
+    assertCurrent: () => {
+      assertInputOwnerCurrent();
+      activeRunAbort.controller.signal.throwIfAborted();
+    },
+    assertCompletionCurrent: () => assertInputOwnerCurrent(true),
+    abortSignal: activeRunAbort.controller.signal,
+    getAbortStopReason: () => activeRunAbort.entry?.abortStopReason ?? "rpc",
+    deferTimeoutCompletion: activeRunAbort.deferTimeoutCompletion,
+    privateCompletion: source.privateCompletion,
+    request: source.request,
+    cfg: source.cfg,
+    cfgForAgent: source.cfgForAgent,
+    sessionEntry: source.sessionEntry,
+    resolvedSessionKey: source.resolvedSessionKey,
+    requestedSessionKeyRaw: source.requestedSessionKeyRaw,
+    admittedSessionId: source.getAdmittedSessionId(),
+    activeSessionAgentId: source.activeSessionAgentId,
+    resolvedThreadId,
+    suppressVisibleSessionEffects: source.suppressVisibleSessionEffects,
+    requestedPromptPersistenceSuppression: source.requestedPromptPersistenceSuppression,
+    restoredCronContinuation: source.restoredCronContinuation,
+    canUseInternalRuntimeHandoff: source.canUseInternalRuntimeHandoff,
+    execApprovalFollowupApprovalId: source.execApprovalFollowupApprovalId,
+    message: source.message,
+    effectiveTranscriptInputText: source.effectiveTranscriptInputText,
+    images: source.images,
+    offloadedRefs: source.offloadedRefs,
+    inputProvenance: source.inputProvenance,
+    runId: source.runId,
+    client: source.client,
+    context: source.context,
+  });
+}

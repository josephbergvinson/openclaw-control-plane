+// Only global discovery can be repeated after native session revival without
+// carrying a frame, window, element, browser, or recording reference forward.
+const GLOBAL_DISCOVERY_TOOLS = new Set([
+  "list_apps",
+  "list_windows",
+  "get_accessibility_tree",
+  "get_cursor_position",
+  "get_desktop_state",
+  "get_screen_size",
+  "get_session_state",
+]);
+
+export function isCuaGlobalDiscovery(name: string, args: Record<string, unknown>): boolean {
+  return GLOBAL_DISCOVERY_TOOLS.has(name) && Object.keys(args).length === 0;
+}

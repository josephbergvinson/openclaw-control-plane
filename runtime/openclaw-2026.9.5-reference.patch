+/** Retain a visible ingress behind its exact recovery publisher before reservation. */
+import { waitForEmbeddedRunPublication } from "../../agents/embedded-agent-runner/runs.publication-wait.js";
+import { MAIN_SESSION_RECOVERY_WORK_ADMISSION_OWNER } from "../../agents/main-session-recovery/main-session-recovery-admission.js";
+import { loadSessionEntry } from "../../config/sessions/session-accessor.js";
+import type { SessionEntry } from "../../config/sessions/types.js";
+import { getSessionWorkAdmissionOwnerRelease } from "../../sessions/session-lifecycle-admission.js";
+import type { ReplyTurnKind } from "./reply-run-registry.contracts.js";
+
+export function waitForReplyRecoveryPublication(params: {
+  turn: {
+    kind: ReplyTurnKind;
+    allowActiveEmbeddedQueueResolution?: boolean;
+    sessionKey: string;
+    storePath?: string;
+    upstreamAbortSignal?: AbortSignal;
+  };
+  entry?: SessionEntry;
+  sessionId: string;
+  ownerReleased?: Promise<void>;
+  releaseAdmission: () => void;
+}) {
+  const { turn, entry, ownerReleased } = params;
+  const runId = entry?.restartRecoveryDeliveryRunId;
+  if (
+    !ownerReleased ||
+    turn.kind !== "visible" ||
+    !turn.allowActiveEmbeddedQueueResolution ||
+    !runId ||
+    entry.sessionId !== params.sessionId
+  ) {
+    return undefined;
+  }
+  params.releaseAdmission();
+  return (async () => {
+    const result = await waitForEmbeddedRunPublication({
+      sessionId: params.sessionId,
+      sessionKey: turn.sessionKey,
+      runId,
+      ownerReleased,
+      abortSignal: turn.upstreamAbortSignal,
+    });
+    if (result !== "registered") {
+      return result;
+    }
+    const latest = turn.storePath
+      ? loadSessionEntry({
+          storePath: turn.storePath,
+          sessionKey: turn.sessionKey,
+          readConsistency: "latest",
+        })
+      : undefined;
+    if (
+      latest?.sessionId !== params.sessionId ||
+      latest.restartRecoveryDeliveryRunId !== runId ||
+      latest.lifecycleRevision !== entry.lifecycleRevision
+    ) {
+      return "invalidated" as const;
+    }
+    return getSessionWorkAdmissionOwnerRelease({
+      scope: turn.storePath ?? "",
+      identities: [turn.sessionKey, params.sessionId],
+      owner: MAIN_SESSION_RECOVERY_WORK_ADMISSION_OWNER,
+    })
+      ? ("registered" as const)
+      : ("released" as const);
+  })();
+}

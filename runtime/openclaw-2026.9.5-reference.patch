+      { payload: { text: "Starting.", isStatusNotice: true }, kind: "block" },
+      { payload: { text: "Private result." }, kind: "final" },
+    ]);
+    await dispatchDiscordNativeAgentReply(params);
+    expect(params.interactionMock.followUp).toHaveBeenCalledTimes(2);
+    expect(deliverDiscordReply).not.toHaveBeenCalled();
+    expect(capturedTurnPlan().replyOptions?.onItemEvent).toBeUndefined();

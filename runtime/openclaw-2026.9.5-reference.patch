+        child.completionRequesterSessionId === target.sessionId &&
+        child.completionTarget === "parent" &&
+        child.delivery?.status !== "delivered" &&
+        child.cleanupCompletedAt === undefined &&
+        !child.suppressCompletionDelivery &&
+        !child.execution.suppressSessionEffects &&
+        !child.killIntent &&
+        !child.killReconciliation,
+    ),
+  );

+          expect(getTaskById(task.taskId)?.deliveryStatus).toBe("delivered");
+        }
+        testing.setDepsForTest({ persistSubagentRunsToDiskOrThrow: () => undefined });
+        expect((await laterWait()).details).toMatchObject({
+          reason: "completed",
+          completed: [task.taskId],
+        });
+        expect(child.requesterFinalObservation?.sourceRunId).toBe("later-steering-turn");
+        expect(child.requesterSettleWake).toBeUndefined();
+        expect(getTaskById(task.taskId)?.deliveryStatus).toBe("delivered");
+      }
+      saveSubagentRegistryToSqlite(subagentRuns);
+      const restored = loadSubagentRegistryFromSqlite().get(child.runId)!;
+      resetSubagentRegistryForTests({ persist: false });
+      addSubagentRunForTests(restored);
+      if (scenario === "failed startup replay") {
+        // The public startup path keeps this receipt pending and lets unrelated rows resume.
+        expect(() => resumeSubagentRun(restored.runId, "restore")).not.toThrow();
+        expect(restored.requesterSettleWake).toBeDefined();
+        expect(getTaskById(task.taskId)?.deliveryStatus).toBe("delivered");
+        const unrelated = structuredClone(restored);
+        unrelated.runId = "unrelated-restored-run";
+        unrelated.taskRunId = unrelated.runId;
+        unrelated.childSessionKey = "agent:main:subagent:unrelated-restored-child";
+        unrelated.execution = { status: "terminal", endedAt: 2000 };
+        unrelated.expectsCompletionMessage = false;
+        unrelated.delivery = { status: "not_required" };
+        unrelated.requesterFinalObservation = undefined;
+        unrelated.requesterSettleWake = undefined;
+        unrelated.cleanupCompletedAt = 2000;
+        addSubagentRunForTests(unrelated);
+        expect(() => resumeSubagentRun(unrelated.runId, "restore")).not.toThrow();
+      }
+      testing.setDepsForTest({
+        persistSubagentRunsToDiskOrThrow: () => saveSubagentRegistryToSqlite(subagentRuns),
+      });
+      if (scenario === "failed startup replay") {
+        restored.cleanupCompletedAt = 2000;
+        resumeSubagentRun(restored.runId, "restore");
+        expect(restored.requesterSettleWake).toBeUndefined();
+        expect(getTaskById(task.taskId)?.deliveryStatus).toBe("delivered");
+      }
+      expect(reconcileRequesterSettleFinal(restored.requesterFinalObservation!, storePath)).toBe(
+        true,
+      );
+      if (!scenario.startsWith("delete cleanup")) {
+        expect(reconcileRequesterSettleFinal(restored.requesterFinalObservation!, storePath)).toBe(
+          true,
+        );
+      }
+    } else if (
+      ["task projection failure", "delete cleanup task projection failure"].includes(scenario)
+    ) {
+      const commitTasks = taskStore.commitTaskRecordUpdates;
+      if (!commitTasks) {
+        throw new Error("Expected atomic task-store settlement");
+      }
+      taskStore.commitTaskRecordUpdates = () => false;
+      await expect(send()).rejects.toThrow("Requester final task delivery was not persisted");
+      expect(child.requesterSettleWake).toBeDefined();
+      expect(
+        loadSessionEntry({ sessionKey, storePath })?.restartRecoveryTerminalDeliveryEvidence,
+      ).toMatchObject([{ durableFinalReceipt: { platformMessageId: "identified-final-0" } }]);
+      // Reopen the owners after receipt commit and failed task projection, without rewinding any row.
+      resetTaskRegistryForTests();
+      configureTaskRegistryRuntime({ store: taskStore });
+      expect(getTaskById(task.taskId)?.deliveryStatus).toBe("pending");
+      saveSubagentRegistryToSqlite(subagentRuns);
+      const restored = loadSubagentRegistryFromSqlite().get(child.runId)!;
+      resetSubagentRegistryForTests({ persist: false });
+      addSubagentRunForTests(restored);
+      taskStore.commitTaskRecordUpdates = commitTasks;
+      testing.setDepsForTest({
+        persistSubagentRunsToDiskOrThrow: () => saveSubagentRegistryToSqlite(subagentRuns),
+      });
+      expect(reconcileRequesterSettleFinal(restored.requesterFinalObservation!, storePath)).toBe(
+        true,
+      );
+      if (!scenario.startsWith("delete cleanup")) {
+        expect(reconcileRequesterSettleFinal(restored.requesterFinalObservation!, storePath)).toBe(
+          true,
+        );
+      }
+    } else if (scenario !== "read only") {
+      await send(0, scenario !== "unidentified sibling");
+      if (["unidentified sibling", "multipart complete"].includes(scenario)) {
+        await send(1);
+      }
+    }
+    if (scenario.startsWith("delete cleanup")) {
+      expect(subagentRuns.has(child.runId)).toBe(false);
+      expect(loadSubagentRegistryFromSqlite().has(child.runId)).toBe(false);
+      resetTaskRegistryForTests();
+      configureTaskRegistryRuntime({ store: taskStore });
+      expect(getTaskById(task.taskId)?.deliveryStatus).toBe("delivered");
+      return;
+    }
+    const delivered = [
+      "complete",
+      "crash after receipt",
+      "task projection failure",
+      "later accounting",
+      "later wait before receipt replay",
+      "failed replay before later wait",
+      "failed startup replay",
+      "multipart complete",
+      "steered native generation",
+    ].includes(scenario);
+    expect(getSubagentRunByRunId(task.runId!)?.delivery?.status).toBe(
+      delivered ? "delivered" : "pending",
+    );
+    if (delivered) {
+      expect(getSubagentRunByRunId(task.runId!)?.requesterSettleWake).toBeUndefined();
+    } else {
+      expect(getSubagentRunByRunId(task.runId!)?.requesterSettleWake).toBeDefined();
+    }
+    expect(getTaskById(task.taskId)?.deliveryStatus).toBe(delivered ? "delivered" : "pending");
+  },
+);

new file mode 100644
index 0000000000000000000000000000000000000000..bb77418467f29228999ef5512f6faa9dfda980e3
--- /dev/null
+++ b/extensions/lane-contract/src/detached-lane-checkpoint.test.ts
@@ -0,0 +1,131 @@
+import { describe, expect, it } from "vitest";
+import { DetachedLaneCheckpointProjector } from "./detached-lane-checkpoint.js";
+
+type CheckpointEvent = Parameters<DetachedLaneCheckpointProjector["projectCheckpoint"]>[0];
+
+const assistantCommentary = (seq: number, data: Record<string, unknown>): CheckpointEvent => ({
+  seq,
+  stream: "assistant",
+  data: { phase: "commentary", ...data },
+});
+const cliPreamble = (seq: number, data: Record<string, unknown>): CheckpointEvent => ({
+  seq,
+  stream: "item",
+  data: { kind: "preamble", phase: "update", ...data },
+});
+const toolStart = (
+  seq: number,
+  toolCallId: string,
+  data: Record<string, unknown> = {},
+): CheckpointEvent => ({ seq, stream: "tool", data: { phase: "start", toolCallId, ...data } });
+const checkpoint = (key: string, text: string) => ({ key, text });
+
+describe("detached lane checkpoint projection", () => {
+  it.each([
+    {
+      name: "keyed assistant deltas complete once at tool start",
+      events: [
+        assistantCommentary(20, { itemId: "assistant", delta: "Desktop is complete" }),
+        assistantCommentary(21, { itemId: "assistant", delta: "; mobile is next." }),
+        toolStart(22, "assistant-tool"),
+      ],
+      expected: [
+        checkpoint("commentary:assistant:completed", "Desktop is complete; mobile is next."),
+      ],
+    },
+    {
+      name: "CLI preamble completes once at tool start",
+      events: [
+        cliPreamble(30, {
+          itemId: "cli",
+          progressText: "Checks are isolated; correction is next.",
+        }),
+        toolStart(31, "cli-tool"),
+      ],
+      expected: [
+        checkpoint("commentary:cli:completed", "Checks are isolated; correction is next."),
+      ],
+    },
+    {
+      name: "unkeyed full snapshot uses the tool identity",
+      events: [
+        assistantCommentary(40, {
+          text: "Browser is complete; settlement is next.",
+          replace: true,
+        }),
+        toolStart(41, "snapshot-tool"),
+      ],
+      expected: [
+        checkpoint(
+          "commentary:tool:snapshot-tool:completed",
+          "Browser is complete; settlement is next.",
+        ),
+      ],
+    },
+    {
+      name: "unkeyed deltas stay private",
+      events: [
+        assistantCommentary(50, { delta: "private partial" }),
+        toolStart(51, "partial-tool"),
+      ],
+      expected: [],
+    },
+    {
+      name: "explicit Codex completion is not duplicated by tool start",
+      events: [
+        assistantCommentary(60, {
+          itemId: "codex",
+          text: "Change is complete; verification is next.",
+          replace: true,
+          completed: true,
+        }),
+        toolStart(61, "codex-tool"),
+      ],
+      expected: [
+        checkpoint("commentary:codex:completed", "Change is complete; verification is next."),
+      ],
+    },
+    {
+      name: "replayed tool identities do not duplicate snapshots",
+      events: [
+        assistantCommentary(70, { text: "First inspection is complete.", replace: true }),
+        toolStart(71, "replayed-tool"),
+        assistantCommentary(72, { text: "Second inspection is complete.", replace: true }),
+        toolStart(73, "replayed-tool"),
+      ],
+      expected: [
+        checkpoint("commentary:tool:replayed-tool:completed", "First inspection is complete."),
+      ],
+    },
+    {
+      name: "latest full snapshot wins before tool start",
+      events: [
+        assistantCommentary(80, { text: "First pass is complete.", replace: true }),
+        assistantCommentary(81, { text: "Browser is complete; mobile is next.", replace: true }),
+        toolStart(82, "latest-tool"),
+      ],
+      expected: [
+        checkpoint("commentary:tool:latest-tool:completed", "Browser is complete; mobile is next."),
+      ],
+    },
+    {
+      name: "tool payload details never enter checkpoint text",
+      events: [
+        assistantCommentary(90, { itemId: "privacy", delta: "Public review is complete." }),
+        toolStart(91, "private-tool", {
+          name: "private_admin_tool",
+          args: { apiKey: "secret" },
+          result: "private-result",
+        }),
+      ],
+      expected: [checkpoint("commentary:privacy:completed", "Public review is complete.")],
+    },
+  ])("$name", ({ events, expected }) => {
+    const projector = new DetachedLaneCheckpointProjector();
+    const projected = events.flatMap((event) => {
+      const result = projector.projectCheckpoint(event);
+      return result ? [result] : [];
+    });
+    expect(projected).toEqual(expected);
+  });
+});

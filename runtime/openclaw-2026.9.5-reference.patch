index 0000000000000000000000000000000000000000..9506eea639213e67bab8d0b1cb58ce82e1df3405
--- /dev/null
+++ b/src/agents/command/browser-cleanup.test.ts
@@ -0,0 +1,91 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { buildAgentRunTerminalOutcomeFromLifecycleEvent } from "../agent-run-terminal-outcome.js";
+import { cleanupCommandBrowserTabsAfterCompletion } from "./maintenance.js";
+
+const cleanup = vi.hoisted(() =>
+  vi.fn(
+    async (_params: { expectedSession: { sessionId: string }; isCurrent: () => boolean }) => {},
+  ),
+);
+vi.mock("../../browser-lifecycle-cleanup.js", () => ({
+  cleanupBrowserSessionsForTaskCompletion: cleanup,
+}));
+
+function fixture() {
+  const controller = new AbortController();
+  const params: Parameters<typeof cleanupCommandBrowserTabsAfterCompletion>[0] = {
+    prepared: {
+      cfg: {},
+      sessionKey: "agent:main:main",
+      storePath: "/fixture/openclaw-agent.sqlite",
+      sessionAgentId: "main",
+      runId: "run",
+    },
+    opts: {},
+    sessionEntry: { sessionId: "session", lifecycleRevision: "revision", updatedAt: 10 },
+    runOwnedSessionId: "session",
+    sessionReboundDuringRun: false,
+    suppressVisibleSessionEffects: false,
+    preserveUserFacingSessionModelState: false,
+    outcome: buildAgentRunTerminalOutcomeFromLifecycleEvent({ phase: "end" }),
+    result: { meta: { durationMs: 1 } },
+    lifecycleGeneration: "current",
+    signal: controller.signal,
+    onWarn: vi.fn(),
+  };
+  return { controller, params };
+}
+
+describe("ordinary command completion retains its owner through Browser cleanup", () => {
+  beforeEach(() => cleanup.mockClear());
+
+  it("passes exact admitted identity and revocable cancellation after successful delivery", async () => {
+    const { params, controller } = fixture();
+    params.opts.deliver = true;
+    params.deliverySucceeded = true;
+    await cleanupCommandBrowserTabsAfterCompletion(params);
+    expect(cleanup).toHaveBeenCalledOnce();
+    const projection = cleanup.mock.calls[0]?.[0];
+    expect(projection?.expectedSession).toEqual({
+      sessionId: "session",
+      lifecycleRevision: "revision",
+    });
+    expect(projection?.isCurrent()).toBe(true);
+    controller.abort();
+    expect(projection?.isCurrent()).toBe(false);
+  });
+
+  it.each([false, undefined])(
+    "preserves tabs if requested final delivery did not succeed (%s)",
+    async (deliverySucceeded) => {
+      const { params } = fixture();
+      params.opts.deliver = true;
+      params.deliverySucceeded = deliverySucceeded;
+      await cleanupCommandBrowserTabsAfterCompletion(params);
+      expect(cleanup).not.toHaveBeenCalled();
+    },
+  );
+
+  it.each([
+    { yielded: true },
+    { continuationPending: true as const },
+    { stopReason: "tool_calls" },
+    { pendingToolCalls: [{ id: "pending", name: "browser", arguments: "{}" }] },
+  ])("keeps unfinished command resources: %j", async (meta) => {
+    const { params } = fixture();
+    params.result.meta = { durationMs: 1, ...meta };
+    await cleanupCommandBrowserTabsAfterCompletion(params);
+    expect(cleanup).not.toHaveBeenCalled();
+  });
+
+  it.each([
+    "sessionReboundDuringRun",
+    "suppressVisibleSessionEffects",
+    "preserveUserFacingSessionModelState",
+  ] as const)("does not clean under %s", async (field) => {
+    const { params } = fixture();
+    params[field] = true;
+    await cleanupCommandBrowserTabsAfterCompletion(params);
+    expect(cleanup).not.toHaveBeenCalled();
+  });
+});

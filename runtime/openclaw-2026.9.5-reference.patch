+  it("preserves command-resolved config and does not refresh after admission", async () => {
+    const retained = createConfig(true);
+    const replacement = createConfig(false);
+    const resolved: OpenClawConfig = { ...replacement, tools: { allow: ["read"] } };
+    setRuntimeConfigSnapshot(retained, retained);
+    const item = createQueued(retained);
+    await replaceRuntime(retained, replacement);
+    mocks.resolveSecrets.mockImplementation(async () => ({ resolvedConfig: resolved }));
+    const readRuntimeConfig = vi.fn(item.run.readRuntimeConfig);

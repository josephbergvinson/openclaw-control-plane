+      deliverSpy.mockImplementationOnce(async (params) => {
+        if (mode === "matching") {
+          expect(params.mcpRequesterScope).toEqual(scope);
+          expect(params.mcpRequesterScopeAssertCurrent).toBeTypeOf("function");
+          (params.mcpRequesterScopeAssertCurrent as () => void)();
+        } else {
+          expect(params.mcpRequesterScope).toBeUndefined();
+        }
+        return { delivered: true, path: "direct" };
+      });
+      expect(
+        await maybeWakeRequesterAfterAllChildrenSettled(wakeParams({ settledEntry: children[1] })),
+      ).toBe(true);
+      expect(deliveredCallArg()).not.toHaveProperty("senderIsOwner");
+    },

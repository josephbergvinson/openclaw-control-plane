+import { describe, expect, it, vi } from "vitest";
+import {
+  captureAgentPluginRuntimeRefresh,
+  createAgentPluginRuntimeRefresh,
+} from "../agents/plugin-runtime-refresh.js";
+import { jsonResult, type AnyAgentTool } from "../agents/tools/common.js";
+import { runOutsideGatewayRootWorkAdmission } from "../process/gateway-work-admission.js";
+import { createCronScriptRuntimeFixture } from "./trigger-script.test-helpers.js";
+
+type RefreshControl = ReturnType<typeof captureAgentPluginRuntimeRefresh>;
+type Runtime = ReturnType<typeof createCronScriptRuntimeFixture>;
+type Mode = "trigger" | "payload";
+const request = {
+  jobId: "refresh-scope",
+  script: "return { fire: false, state: await probe({}) };",
+  state: null,
+};
+
+async function invoke(runtime: Runtime, mode: Mode, params = request) {
+  return await (mode === "trigger"
+    ? runtime.evaluateTrigger(params)
+    : runtime.executePayload(params));
+}
+
+function probe(execute: AnyAgentTool["execute"]): AnyAgentTool {
+  return {
+    name: "probe",
+    label: "Probe",
+    description: "Synthetic invocation scope probe",
+    parameters: { type: "object", properties: {} },
+    execute,
+  };
+}
+
+async function inheritedTimer<T>(state: "closed" | "requested", run: () => Promise<T>) {
+  const ambient = createAgentPluginRuntimeRefresh();
+  let control: RefreshControl | undefined;
+  const pending = ambient.run(() => {
+    control = captureAgentPluginRuntimeRefresh();
+    control.bindConsumer(() => true);
+    if (state === "requested") {
+      expect(control.request()).toBe(true);
+    }
+    // Match the scheduler: leaving root work does not leave agent refresh ALS.
+    return new Promise<T>((resolve, reject) => {
+      setTimeout(() => {
+        void runOutsideGatewayRootWorkAdmission(run).then(resolve, reject);
+      }, 0);
+    });
+  });
+  if (state === "closed") {
+    ambient.close();
+  }
+  try {
+    const result = await pending;
+    expect(() => control!.assertCurrent()).toThrow("Plugin runtime changed");
+    expect(control!.isRequested()).toBe(state === "requested");
+    return result;
+  } finally {
+    ambient.close();
+  }
+}
+
+describe("cron invocation plugin refresh ownership", () => {
+  it.each([
+    ["trigger", "closed"],
+    ["trigger", "requested"],
+    ["payload", "closed"],
+    ["payload", "requested"],
+  ] as const)("isolates cold and warm %s from a %s ambient timer scope", async (mode, state) => {
+    const config = {};
+    const controls: RefreshControl[] = [];
+    const effects = vi.fn(async () => {
+      captureAgentPluginRuntimeRefresh().assertCurrent();
+      return jsonResult({ ok: true });
+    });
+    const createTools = vi.fn(() => {
+      const control = captureAgentPluginRuntimeRefresh();
+      control.assertCurrent();
+      controls.push(control);
+      return [probe(effects)];
+    });
+    const prepareRuntime = vi.fn(async () => ({
+      context: { config, agentId: "main", sessionKey: "agent:main:cron:refresh" },
+      createTools,
+    }));
+    const runtime = createCronScriptRuntimeFixture({ config, prepareRuntime });
+    for (let index = 0; index < 2; index += 1) {
+      await expect(inheritedTimer(state, () => invoke(runtime, mode))).resolves.toMatchObject({
+        kind: mode === "trigger" ? "evaluated" : "completed",
+        state: { ok: true },
+      });
+      expect(effects).toHaveBeenCalledTimes(index + 1);
+      expect(() => controls[index]!.assertCurrent()).toThrow("Plugin runtime changed");
+    }
+    expect(prepareRuntime).toHaveBeenCalledOnce();
+    expect(createTools).toHaveBeenCalledTimes(2);
+  });
+
+  it.each(["trigger", "payload"] as const)(
+    "closes %s refresh authority when preparation fails",
+    async (mode) => {
+      let retained: RefreshControl | undefined;
+      const prepareRuntime = vi.fn(async () => {
+        retained = captureAgentPluginRuntimeRefresh();
+        retained.assertCurrent();
+        throw new Error("synthetic preparation failure");
+      });
+      const runtime = createCronScriptRuntimeFixture({ config: {}, prepareRuntime });
+      await expect(invoke(runtime, mode)).resolves.toMatchObject({
+        kind: "error",
+        error: expect.stringContaining("synthetic preparation failure"),
+      });
+      expect(prepareRuntime).toHaveBeenCalledOnce();
+      expect(() => retained!.assertCurrent()).toThrow("Plugin runtime changed");
+    },
+  );
+
+  it.each(["trigger", "payload"] as const)(
+    "does not replay or retain %s authority after script failure following an effect",
+    async (mode) => {
+      let retained: RefreshControl | undefined;
+      const effects = vi.fn(async () => {
+        retained = captureAgentPluginRuntimeRefresh();
+        return jsonResult({ ok: true });
+      });
+      const prepareRuntime = vi.fn(async () => ({
+        context: { config: {}, agentId: "main", sessionKey: "agent:main:cron:refresh" },
+        createTools: () => [probe(effects)],
+      }));
+      const runtime = createCronScriptRuntimeFixture({ config: {}, prepareRuntime });
+      await expect(
+        invoke(runtime, mode, {
+          ...request,
+          script: "await probe({}); throw new Error('synthetic failure after effect');",
+        }),
+      ).resolves.toMatchObject({
+        kind: "error",
+        error: expect.stringContaining("synthetic failure after effect"),
+      });
+      expect(effects).toHaveBeenCalledOnce();
+      expect(prepareRuntime).toHaveBeenCalledOnce();
+      expect(() => retained!.assertCurrent()).toThrow("Plugin runtime changed");
+    },
+  );
+
+  it.each(["refresh", "abort"] as const)(
+    "preserves invocation %s fencing after the first effect without replay",
+    async (reason) => {
+      const abort = new AbortController();
+      let retained: RefreshControl | undefined;
+      const effects = vi.fn(async () => {
+        retained = captureAgentPluginRuntimeRefresh();
+        if (reason === "refresh") {
+          retained.bindConsumer(() => true);
+          expect(retained.request()).toBe(true);
+        } else {
+          abort.abort();
+        }
+        return jsonResult({ ok: true });
+      });
+      const prepareRuntime = vi.fn(async () => ({
+        context: { config: {}, agentId: "main", sessionKey: "agent:main:cron:refresh" },
+        createTools: () => [probe(effects)],
+      }));
+      const runtime = createCronScriptRuntimeFixture({ config: {}, prepareRuntime });
+      await expect(
+        runtime.executePayload({
+          ...request,
+          script: "await probe({}); await probe({}); return { state: true };",
+          abortSignal: abort.signal,
+        }),
+      ).resolves.toMatchObject({ kind: "error" });
+      expect(effects).toHaveBeenCalledOnce();
+      expect(prepareRuntime).toHaveBeenCalledOnce();
+      expect(() => retained!.assertCurrent()).toThrow("Plugin runtime changed");
+    },
+  );
+});

@@ -0,0 +1,297 @@
+import fs from "node:fs/promises";
+import path from "node:path";
+import { createDeferred } from "openclaw/plugin-sdk/extension-shared";
+import { withTempDir } from "openclaw/plugin-sdk/test-env";
+import { expect, it, vi, type Mock } from "vitest";
+import { createCodexCatalogHomeResolver } from "../session-catalog-homes.js";
+import type {
+  bridgeCodexAppServerStartOptions as bridgeStartOptions,
+  reconcileCodexComputerUseStartArtifacts as reconcileArtifacts,
+} from "./auth-bridge.js";
+import { CodexAppServerClient } from "./client.js";
+import { resolveCodexSupervisionAppServerRuntimeOptions } from "./config-runtime.js";
+import type { CodexAppServerStartOptions } from "./config.js";
+import { withCodexAppServerJsonClient } from "./request.js";
+import type {
+  getLeasedSharedCodexAppServerClient as getLeasedClient,
+  releaseLeasedSharedCodexAppServerClient as releaseLeasedClient,
+} from "./shared-client.js";
+import { createClientHarness } from "./test-support.js";
+
+export function registerSharedClientHomeTests(fixtures: {
+  mocks: {
+    bridgeCodexAppServerStartOptions: Mock<typeof bridgeStartOptions>;
+    reconcileCodexComputerUseStartArtifacts: Mock<typeof reconcileArtifacts>;
+  };
+  getLeasedSharedCodexAppServerClient: typeof getLeasedClient;
+  releaseLeasedSharedCodexAppServerClient: typeof releaseLeasedClient;
+  sendInitializeResult: (
+    harness: ReturnType<typeof createClientHarness>,
+    userAgent: string,
+  ) => Promise<void>;
+}): void {
+  const {
+    mocks,
+    getLeasedSharedCodexAppServerClient,
+    releaseLeasedSharedCodexAppServerClient,
+    sendInitializeResult,
+  } = fixtures;
+
+  for (const isolated of [false, true]) {
+    it(`rejects a prepared home from a transient alias retarget before ${isolated ? "isolated" : "shared"} native launch`, async () => {
+      await withTempDir("codex-shared-home-aba-", async (logicalRoot) => {
+        const root = await fs.realpath(logicalRoot);
+        const agentDir = path.join(root, "agent");
+        const homeA = path.join(root, "a");
+        const homeB = path.join(root, "b");
+        await Promise.all(
+          [agentDir, homeA, homeB].map((directory) => fs.mkdir(directory, { recursive: true })),
+        );
+        const link = path.join(agentDir, "codex-home");
+        await fs.symlink(homeA, link, "dir");
+        const config = {
+          agents: { ownership: "explicit" as const, entries: { selected: { agentDir } } },
+        };
+        const requested: CodexAppServerStartOptions = {
+          transport: "stdio",
+          homeScope: "agent",
+          command: "codex",
+          commandSource: "managed",
+          args: ["app-server"],
+          headers: {},
+        };
+        const resolver = createCodexCatalogHomeResolver({
+          config,
+          getRuntimeConfig: () => config,
+          getPluginConfig: () => ({ appServer: { homeScope: "agent" } }),
+          resolveRuntimeOptions: (options) => ({
+            ...resolveCodexSupervisionAppServerRuntimeOptions(options),
+            start: requested,
+            requestTimeoutMs: 1_000,
+            connectionClass: "local-loopback",
+          }),
+        });
+        const source = await resolver.forNode("selected");
+        const { bridgeCodexAppServerStartOptions: actualBridge } =
+          await vi.importActual<typeof import("./auth-bridge.js")>("./auth-bridge.js");
+        let preparedHome: string | undefined;
+        mocks.bridgeCodexAppServerStartOptions.mockImplementationOnce(
+          async (params: Parameters<typeof actualBridge>[0]) => {
+            await fs.unlink(link);
+            await fs.symlink(homeB, link, "dir");
+            const prepared = await actualBridge(params);
+            preparedHome = prepared.env?.CODEX_HOME;
+            await fs.unlink(link);
+            await fs.symlink(homeA, link, "dir");
+            return prepared;
+          },
+        );
+        const startSpy = vi
+          .spyOn(CodexAppServerClient, "start")
+          .mockRejectedValue(new Error("Unexpected native fixture launch"));
+        const consume = vi.fn(async () => undefined);
+        await expect(
+          withCodexAppServerJsonClient(
+            {
+              config,
+              agentDir,
+              startOptions: source.appServer.start,
+              authProfileId: null,
+              timeoutMs: 1_000,
+              isolated,
+              assertCurrent: source.assertCurrent,
+            },
+            consume,
+          ),
+        ).rejects.toThrow("prepared home changed");
+        expect(preparedHome).toBe(homeB);
+        expect(await fs.realpath(link)).toBe(homeA);
+        expect(requested.env).toBeUndefined();
+        expect(startSpy).not.toHaveBeenCalled();
+        expect(consume).not.toHaveBeenCalled();
+        expect(mocks.reconcileCodexComputerUseStartArtifacts).not.toHaveBeenCalled();
+        expect(() => source.assertCurrent()).not.toThrow();
+      });
+    });
+  }
+
+  it("pins the actual prepared home when a source link moves after the last startup guard", async () => {
+    await withTempDir("codex-shared-physical-home-", async (logicalRoot) => {
+      const root = await fs.realpath(logicalRoot);
+      const agentDir = path.join(root, "agent");
+      const homeA = path.join(root, "a");
+      const homeB = path.join(root, "b");
+      await Promise.all(
+        [agentDir, homeA, homeB].map((directory) => fs.mkdir(directory, { recursive: true })),
+      );
+      const link = path.join(agentDir, "codex-home");
+      await fs.symlink(homeA, link, "dir");
+      const config = {
+        agents: { ownership: "explicit" as const, entries: { selected: { agentDir } } },
+      };
+      const requested: CodexAppServerStartOptions = {
+        transport: "stdio",
+        homeScope: "agent",
+        command: "codex",
+        commandSource: "managed",
+        args: ["app-server"],
+        headers: {},
+      };
+      const resolver = createCodexCatalogHomeResolver({
+        config,
+        getRuntimeConfig: () => config,
+        getPluginConfig: () => ({ appServer: { homeScope: "agent" } }),
+        resolveRuntimeOptions: (options) => ({
+          ...resolveCodexSupervisionAppServerRuntimeOptions(options),
+          start: requested,
+          requestTimeoutMs: 1_000,
+          connectionClass: "local-loopback",
+        }),
+      });
+      const source = await resolver.forNode("selected");
+      const { bridgeCodexAppServerStartOptions: actualBridge } =
+        await vi.importActual<typeof import("./auth-bridge.js")>("./auth-bridge.js");
+      mocks.bridgeCodexAppServerStartOptions.mockImplementationOnce(actualBridge);
+      mocks.reconcileCodexComputerUseStartArtifacts.mockImplementationOnce(async () => {
+        source.assertCurrent();
+        await fs.unlink(link);
+        await fs.symlink(homeB, link, "dir");
+      });
+      const harness = createClientHarness();
+      const startSpy = vi.spyOn(CodexAppServerClient, "start").mockResolvedValue(harness.client);
+      const request = withCodexAppServerJsonClient(
+        {
+          config,
+          agentDir,
+          startOptions: source.appServer.start,
+          authProfileId: null,
+          timeoutMs: 1_000,
+          assertCurrent: source.assertCurrent,
+        },
+        async (read) => read({ method: "thread/list", requestParams: { limit: 1 } }),
+      );
+      const rejected = expect(request).rejects.toThrow("home changed");
+      await sendInitializeResult(harness, "openclaw/0.149.0 (macOS; test)");
+      await rejected;
+      expect(requested.env).toBeUndefined();
+      const startedOptions = startSpy.mock.calls[0]?.[0];
+      expect(startedOptions).toBeDefined();
+      if (!startedOptions) {
+        throw new Error("Expected a native client startup call");
+      }
+      expect(startedOptions.env?.CODEX_HOME).toBe(homeA);
+      expect(await fs.realpath(link)).toBe(homeB);
+      expect(harness.writes.map((line) => JSON.parse(line).method)).not.toContain("thread/list");
+      expect(releaseLeasedSharedCodexAppServerClient(harness.client)).toBe(false);
+    });
+  });
+
+  it("rejects a source retired during awaited home preparation before native launch", async () => {
+    const entered = createDeferred<void>();
+    const finish = createDeferred<void>();
+    const retired = new Error("source home changed");
+    let current = true;
+    mocks.bridgeCodexAppServerStartOptions.mockImplementationOnce(async ({ startOptions }) => {
+      entered.resolve();
+      await finish.promise;
+      return { ...startOptions, env: { CODEX_HOME: "/replacement/home" } };
+    });
+    const startSpy = vi.spyOn(CodexAppServerClient, "start");
+    const acquire = getLeasedSharedCodexAppServerClient({
+      timeoutMs: 1_000,
+      authProfileId: null,
+      assertCurrent: () => {
+        if (!current) {
+          throw retired;
+        }
+      },
+      startOptions: {
+        transport: "stdio",
+        homeScope: "agent",
+        command: "codex",
+        commandSource: "managed",
+        args: ["app-server"],
+        headers: {},
+      },
+    });
+    const rejected = expect(acquire).rejects.toBe(retired);
+    await entered.promise;
+    current = false;
+    finish.resolve();
+    await rejected;
+    expect(startSpy).not.toHaveBeenCalled();
+    expect(mocks.reconcileCodexComputerUseStartArtifacts).not.toHaveBeenCalled();
+  });
+
+  it("does not start a client after its sole waiter abandons artifact reconciliation", async () => {
+    const reconcileStarted = createDeferred<void>();
+    const releaseReconcile = createDeferred<void>();
+    const reconcileFinished = createDeferred<void>();

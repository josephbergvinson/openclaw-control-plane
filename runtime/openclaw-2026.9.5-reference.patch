@@ -0,0 +1,105 @@
+import { beforeEach, expect, it, vi } from "vitest";
+import { makeRuntime } from "./agent-bundle-mcp-harness.test-support.js";
+import type { SessionMcpRuntime } from "./agent-bundle-mcp-types.js";
+
+const acquire = vi.hoisted(() => vi.fn());
+vi.mock("./agent-bundle-mcp-manager-api.js", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("./agent-bundle-mcp-manager-api.js")>()),
+  acquireRequesterScopedMcpRuntime: acquire,
+  getAdvertisedScopedMcpCatalog: () => undefined,
+  rememberAdvertisedScopedMcpCatalog: () => undefined,
+}));
+import { materializeRequesterScopedMcpToolsForHarnessRunCore as materialize } from "./agent-bundle-mcp-harness.js";
+import { shouldLoadRequesterScopedMcpHarnessRuntime } from "./agent-bundle-mcp-runtime-shared.js";
+
+beforeEach(() => acquire.mockReset());
+const scope = {
+  requesterSenderId: "alice",
+  messageChannel: "discord",
+  agentAccountId: "account-a",
+};
+const base = { sessionId: "continuation", workspaceDir: "/workspace" };
+
+it("discovers and calls the original requester's tools in a senderless continuation", async () => {
+  const runtime = makeRuntime({ sessionId: base.sessionId, requesterSenderId: "alice" });
+  const call = vi.fn(runtime.callTool);
+  runtime.callTool = call;
+  acquire.mockResolvedValue({ runtime, releaseLease: runtime.acquireLease?.() });
+  let current = true;
+  const params = {
+    ...base,
+    mcpRequesterScope: scope,
+    mcpRequesterScopeAssertCurrent: () => {
+      if (!current) {
+        throw new Error("closed task");
+      }
+    },
+  };
+  expect(shouldLoadRequesterScopedMcpHarnessRuntime(params)).toBe(true);
+  const result = await materialize(params);
+  try {
+    expect(acquire).toHaveBeenCalledWith(expect.objectContaining(scope));
+    expect(result?.tools.map((tool) => tool.name)).toEqual(["user-mail__inbox"]);
+    await result!.tools[0]!.execute("read", {});
+    expect(call).toHaveBeenCalledOnce();
+    current = false;
+    await expect(result!.tools[0]!.execute("late", {})).rejects.toThrow("closed task");
+    await expect(result!.advertisedTools[0]!.execute("late-advertised", {})).rejects.toThrow(
+      "closed task",
+    );
+    expect(call).toHaveBeenCalledOnce();
+  } finally {
+    await result?.dispose();
+  }
+});
+
+it.each(["missing", "revoked", "invalid"])(
+  "rejects %s task authority without fallback to another sender",
+  async (mode) => {
+    await expect(
+      materialize({
+        ...base,
+        requesterSenderId: "bob",
+        mcpRequesterScope: mode === "invalid" ? { ...scope, requesterSenderId: "  " } : scope,
+        ...(mode === "missing"
+          ? {}
+          : {
+              mcpRequesterScopeAssertCurrent: () => {
+                if (mode === "revoked") {
+                  throw new Error("revoked");
+                }
+              },
+            }),
+      }),
+    ).rejects.toThrow();
+    expect(acquire).not.toHaveBeenCalled();
+  },
+);
+
+it("revalidates after acquisition before catalog discovery", async () => {
+  let current = true;
+  const runtime: SessionMcpRuntime = makeRuntime({
+    sessionId: base.sessionId,
+    requesterSenderId: "alice",
+  });
+  const catalog = vi.fn(runtime.getCatalog);
+  runtime.getCatalog = catalog;
+  const release = vi.fn(runtime.acquireLease?.());
+  acquire.mockImplementation(async () => {
+    current = false;
+    return { runtime, releaseLease: release };
+  });
+  await expect(
+    materialize({
+      ...base,
+      mcpRequesterScope: scope,
+      mcpRequesterScopeAssertCurrent: () => {
+        if (!current) {
+          throw new Error("revoked during acquisition");
+        }
+      },
+    }),
+  ).rejects.toThrow("revoked during acquisition");
+  expect(catalog).not.toHaveBeenCalled();
+  expect(release).toHaveBeenCalledOnce();
+});

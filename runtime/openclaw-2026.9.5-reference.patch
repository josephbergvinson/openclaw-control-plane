+  registerChannelIngressHostOwner,
+} from "openclaw/plugin-sdk/channel-ingress-test-runtime";
+import { withTempDir } from "openclaw/plugin-sdk/test-env";
+import { describe, expect, it } from "vitest";
+import { buildDiscordMessageProcessContext } from "./message-handler.context.js";
+import { preflightDiscordMessage } from "./message-handler.preflight.js";
+import {
+  createDiscordMessage,
+  createDiscordPreflightArgs,
+  createGuildEvent,
+  createGuildTextClient,
+} from "./message-handler.preflight.test-helpers.js";
+
+type IngressOwner = Parameters<typeof registerChannelIngressHostOwner>[0];
+type GatewayContext = NonNullable<ReturnType<NonNullable<IngressOwner["resolveGatewayContext"]>>>;
+
+function createHostContextBuilder(owner: IngressOwner) {
+  const buildHostContext = createHostChannelInboundEventContextBuilder(
+    buildChannelInboundEventContext,
+    owner,
+  );
+  function buildContext(
+    params: BuildChannelInboundEventContextAsyncParams,
+  ): Promise<BuiltChannelInboundEventContext>;
+  function buildContext(
+    params: BuildChannelInboundEventContextParams,
+  ): BuiltChannelInboundEventContext;
+  function buildContext(
+    params: BuildChannelInboundEventContextParams &
+      Partial<ChannelInboundSupplementalResolutionOptions>,
+  ): BuiltChannelInboundEventContext | Promise<BuiltChannelInboundEventContext> {
+    return buildHostContext(params);
+  }
+  return buildContext;
+}
+
+describe("Discord preflight host ownership", () => {
+  it.each([
+    { builderKind: "host", unrestricted: false },
+    { builderKind: "raw", unrestricted: false },
+    { builderKind: "retired", unrestricted: false },
+    { builderKind: "host", unrestricted: true },
+  ] as const)(
+    "preserves only the $builderKind builder's valid Gateway binding through ordinary message processing (unrestricted=$unrestricted)",
+    async ({ builderKind, unrestricted }) => {
+      await withTempDir("discord-preflight-owner-", async (dir) => {
+        const channelId = "channel-host-boundary";
+        const guildId = "guild-host-boundary";
+        const agentId = unrestricted ? "coordination" : "main";
+        const senderId = "123456789012345678";
+        const gateway = {} as GatewayContext;
+        let live = builderKind !== "retired";
+        const owner: IngressOwner = {
+          channelId: "discord",
+          record: {},
+          epoch: {},
+          isLive: () => live,
+          resolveGatewayContext: () => (live ? gateway : undefined),
+        };
+        const clearOwner = registerChannelIngressHostOwner(owner);
+        try {
+          const guildEntries = {
+            [guildId]: {
+              ...(unrestricted ? {} : { users: [senderId] }),
+              requireMention: false,
+              channels: { [channelId]: { enabled: true } },
+            },
+          };
+          const discordConfig = { groupPolicy: "allowlist" as const, guilds: guildEntries };
+          const text = "Check the project access.";
+          const message = createDiscordMessage({
+            id: "message-host-boundary",
+            channelId,
+            content: text,
+            author: { id: senderId, bot: false, username: "operator" },
+          });
+          const preflight = await preflightDiscordMessage({
+            ...createDiscordPreflightArgs({
+              cfg: {
+                ...(unrestricted
+                  ? {
+                      agents: { entries: { main: {}, coordination: { workspace: dir } } },
+                      bindings: [{ agentId, match: { channel: "discord", guildId } }],
+                    }
+                  : {}),
+                session: { store: path.join(dir, "sessions.json") },
+                channels: { discord: discordConfig },
+              },
+              discordConfig,
+              data: createGuildEvent({ channelId, guildId, author: message.author, message }),
+              client: createGuildTextClient(channelId),
+            }),
+            guildEntries,
+            buildContext:
+              builderKind === "raw"
+                ? buildChannelInboundEventContext
+                : createHostContextBuilder(owner),
+          });
+          if (!preflight) {
+            throw new Error("Expected an admitted ordinary Discord message");
+          }
+          const processed = await buildDiscordMessageProcessContext({
+            ctx: preflight,
+            text,
+            mediaList: [],
+          });
+          if (!processed) {
+            throw new Error("Expected the ordinary Discord message context");
+          }
+          const resolver = readChannelContextGatewayContextResolver(processed.ctxPayload);
+          expect(processed.ctxPayload.AgentId).toBe(agentId);
+          expect(processed.ctxPayload.SessionKey).toBe(
+            `agent:${agentId}:discord:channel:${channelId}`,
+          );
+          expect(processed.ctxPayload.CommandAuthorized).toBe(!unrestricted);
+          if (builderKind === "host") {
+            expect(resolver?.()).toBe(gateway);
+            live = false;
+            expect(resolver?.()).toBeUndefined();
+          } else {
+            expect(resolver).toBeUndefined();
+          }
+        } finally {
+          clearOwner();
+        }
+      });
+    },
+  );
+});

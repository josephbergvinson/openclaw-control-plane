@@ -0,0 +1,204 @@
+import { createAssistantMessageEventStream } from "@openclaw/llm-core";
+import { describe, expect, it } from "vitest";
+import { serializeConversation } from "../../packages/agent-core/src/harness/compaction/utils.js";
+import { convertToLlm } from "../../packages/agent-core/src/harness/messages.js";
+import {
+  buildStageSplitPlanWithWorker,
+  buildSummaryChunksWithWorker,
+} from "./compaction-planning-worker.js";
+import { buildSummaryChunks, estimateMessagesTokens } from "./compaction-planning.js";
+import { runCompactionPlanningWorkerInput } from "./compaction-planning.worker.js";
+import { summarizeInStages } from "./compaction.js";
+import type { AgentMessage } from "./runtime/index.js";
+import { makeAgentAssistantMessage } from "./test-helpers/agent-message-fixtures.js";
+
+function toolHistory(pairs: number): AgentMessage[] {
+  return Array.from({ length: pairs }, (_, index) => [
+    makeAgentAssistantMessage({
+      content: [
+        { type: "text", text: `Decision ${index}: preserve the completed change.` },
+        { type: "toolCall", id: `call-${index}`, name: "read", arguments: { path: "notes" } },
+      ],
+      stopReason: "toolUse",
+      timestamp: index * 2,
+    }),
+    {
+      role: "toolResult" as const,
+      toolCallId: `call-${index}`,
+      toolName: "read",
+      content: [{ type: "text" as const, text: `Result ${index}: ` + "x".repeat(400_000) }],
+      isError: false,
+      timestamp: index * 2 + 1,
+    },
+  ]).flat();
+}
+
+describe("summary planning uses the serialized conversation budget", () => {
+  it.each([8, 40])("does not charge omitted tool text with %i tool pairs", async (pairs) => {
+    const messages = toolHistory(pairs);
+    const original = JSON.stringify(messages);
+    const serialized = serializeConversation(convertToLlm(messages));
+    expect(serialized.length).toBeLessThan(100_000);
+    expect(estimateMessagesTokens(messages)).toBeGreaterThan(700_000);
+    const chunks = await buildSummaryChunksWithWorker({
+      messages,
+      maxChunkTokens: 32_000,
+      tokenBudget: "summary",
+    });
+    expect(chunks).toHaveLength(1);
+    expect(chunks.flat()).toEqual(messages);
+    chunks.flat().forEach((message, index) => expect(message).toBe(messages[index]));
+    expect(JSON.stringify(messages)).toBe(original);
+    // The ordinary replay/context-pressure owner still sees every saved byte.
+    expect(buildSummaryChunks({ messages, maxChunkTokens: 32_000 }).length).toBeGreaterThan(1);
+  });
+
+  it("does not create summary stages for omitted tool-result bytes", async () => {
+    const messages = toolHistory(40);
+    const result = await buildStageSplitPlanWithWorker({
+      messages,
+      maxChunkTokens: 32_000,
+      tokenBudget: "summary",
+    });
+    expect(result.mode).toBe("single");
+  });
+
+  it("uses the summary budget through the composed summarization caller", async () => {
+    const messages = toolHistory(40);
+    const model = {
+      id: "synthetic-summary",
+      name: "Synthetic summary",
+      provider: "openai",
+      api: "openai-responses",
+      baseUrl: "https://unused.invalid",
+      reasoning: false,
+      input: ["text"],
+      contextWindow: 272_000,
+      maxTokens: 8_192,
+      cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+    } satisfies Parameters<typeof summarizeInStages>[0]["model"];
+    let calls = 0;
+    const result = await summarizeInStages({
+      messages,
+      model,
+      apiKey: "synthetic-no-credential", // pragma: allowlist secret
+      signal: new AbortController().signal,
+      reserveTokens: 4_096,
+      maxChunkTokens: 32_000,
+      contextWindow: 272_000,
+      streamFn: (_model, context) => {
+        calls += 1;
+        const text = serializeConversation(context.messages);
+        expect(text).toContain("Decision 0:");
+        expect(text).toContain("Decision 39:");
+        const stream = createAssistantMessageEventStream();
+        stream.push({
+          type: "done",
+          reason: "stop",
+          message: makeAgentAssistantMessage({
+            content: [{ type: "text", text: "Retained every completed change." }],
+          }),
+        });
+        stream.end();
+        return stream;
+      },
+    });
+    expect(result).toBe("Retained every completed change.");
+    expect(calls).toBe(1);
+  });
+
+  it("still splits genuinely large user input and retains chronology", async () => {
+    const messages: AgentMessage[] = Array.from({ length: 6 }, (_, index) => ({
+      role: "user",
+      content: `${index}:` + "漢".repeat(20_000),
+      timestamp: index,
+    }));
+    const chunks = await buildSummaryChunksWithWorker({
+      messages,
+      maxChunkTokens: 30_000,
+      tokenBudget: "summary",
+    });
+    expect(chunks).toHaveLength(6);
+    expect(chunks.flat()).toEqual(messages);
+  });
+
+  it("keeps genuinely large tool calls and their results atomic", async () => {
+    const messages = toolHistory(3);
+    for (const message of messages) {
+      if (message.role === "assistant") {
+        const call = message.content.find((block) => block.type === "toolCall");
+        if (call?.type === "toolCall") {
+          call.arguments = { content: "important change ".repeat(10_000) };
+        }
+      }
+    }
+    const chunks = await buildSummaryChunksWithWorker({
+      messages,
+      maxChunkTokens: 32_000,
+      tokenBudget: "summary",
+    });
+    expect(chunks.map((chunk) => chunk.map((message) => message.timestamp))).toEqual([
+      [0, 1],
+      [2, 3],
+      [4, 5],
+    ]);
+    expect(chunks.flat()).toEqual(messages);
+  });
+
+  it("preserves summary pressure after the worker payload projection is exhausted", async () => {
+    const messages: AgentMessage[] = Array.from({ length: 64 }, (_, index) => ({
+      role: "user",
+      content: `${index}:` + "漢".repeat(20_000),
+      timestamp: index,
+    }));
+    const chunks = await buildSummaryChunksWithWorker({
+      messages,
+      maxChunkTokens: 30_000,
+      tokenBudget: "summary",
+    });
+    expect(chunks).toHaveLength(64);
+    chunks.flat().forEach((message, index) => expect(message).toBe(messages[index]));
+  });
+
+  it.each(
+    (["summaryChunks", "stageSplit"] as const).flatMap((kind) =>
+      [[], [Number.NaN], [Number.POSITIVE_INFINITY], [-1], [1.5]].map((messageTokenEstimates) => ({
+        kind,
+        messageTokenEstimates,
+      })),
+    ),
+  )("rejects malformed scalar budgets for $kind: $messageTokenEstimates", (input) => {
+    expect(() =>
+      runCompactionPlanningWorkerInput({
+        ...input,
+        messages: [{ role: "user", content: "retain the current request", timestamp: 0 }],
+        maxChunkTokens: 32_000,
+      }),
+    ).toThrow("token estimates must match every message");
+  });
+
+  it.each([8, 40])("honors cancellation before planning %i tool pairs", async (pairs) => {
+    const reason = new Error("caller cancelled compaction");
+    await expect(
+      buildSummaryChunksWithWorker({
+        messages: toolHistory(pairs),
+        maxChunkTokens: 32_000,
+        tokenBudget: "summary",
+        signal: AbortSignal.abort(reason),
+      }),
+    ).rejects.toBe(reason);
+  });
+
+  it("rejects missing scalar positions rather than silently undercounting", () => {
+    const messageTokenEstimates = [1];
+    Reflect.deleteProperty(messageTokenEstimates, "0");
+    expect(() =>
+      runCompactionPlanningWorkerInput({
+        kind: "stageSplit",
+        messageTokenEstimates,
+        messages: [{ role: "user", content: "retain this request", timestamp: 0 }],
+        maxChunkTokens: 32_000,
+      }),
+    ).toThrow("token estimates must match every message");
+  });
+});

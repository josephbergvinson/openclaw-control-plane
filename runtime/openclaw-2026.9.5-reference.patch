diff --git a/test/scripts/mac-worker-native-provenance.test.ts b/test/scripts/mac-worker-native-provenance.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a33b357f5733f5977f66fd839492b58a4a56a008
--- /dev/null
+++ b/test/scripts/mac-worker-native-provenance.test.ts
@@ -0,0 +1,85 @@
+import fs from "node:fs";
+import path from "node:path";
+import { afterEach, describe, expect, it } from "vitest";
+import { loadMacWorkerDarwinProcessApi } from "../../scripts/lib/mac-worker-portability.mjs";
+import { useAutoCleanupTempDirTracker } from "../helpers/temp-dir.js";
+
+const temps = useAutoCleanupTempDirTracker(afterEach);
+
+function fixture() {
+  const root = temps.make("openclaw-worker-native-provenance-");
+  const runtime = path.join(root, "runtime");
+  const packageRoot = path.join(runtime, "lib/node_modules/openclaw");
+  const koffi = path.join(packageRoot, "node_modules/koffi");
+  const platform = path.join(
+    packageRoot,
+    `node_modules/@koromix/koffi-${process.platform}-${process.arch}`,
+  );
+  const marker = path.join(root, "loader-executed");
+  const canary = `require('node:fs').writeFileSync(${JSON.stringify(marker)}, 'executed'); throw new Error('loader canary executed');`;
+  for (const directory of [packageRoot, koffi, platform]) {
+    fs.mkdirSync(directory, { recursive: true });
+    fs.writeFileSync(path.join(directory, "package.json"), '{"main":"index.cjs"}');
+    fs.writeFileSync(path.join(directory, "index.cjs"), canary);
+  }
+  const native = path.join(platform, `darwin_${process.arch}/koffi.node`);
+  fs.mkdirSync(path.dirname(native));
+  fs.writeFileSync(native, "unloadable fixture; provenance must reject before dlopen");
+  const outside = path.join(root, "outside");
+  fs.mkdirSync(outside);
+  fs.writeFileSync(path.join(outside, "index.cjs"), canary);
+  fs.writeFileSync(path.join(outside, "package.json"), '{"main":"index.cjs"}');
+  fs.writeFileSync(path.join(outside, "koffi.node"), "outside native canary");
+  return { root, runtime, packageRoot, koffi, platform, native, outside, marker };
+}
+
+describe.skipIf(process.platform === "win32")(
+  "Mac worker managed native dependency custody",
+  () => {
+    it.each(["koffi", "platform", "native"] as const)(
+      "rejects an escaped %s before executing a loader or loading a binary",
+      (escape) => {
+        const f = fixture();
+        const member = escape === "native" ? f.native : escape === "koffi" ? f.koffi : f.platform;
+        fs.rmSync(member, { recursive: escape !== "native" });
+        fs.symlinkSync(
+          escape === "native" ? path.join(f.outside, "koffi.node") : f.outside,
+          member,
+        );
+        expect(() => loadMacWorkerDarwinProcessApi(f.runtime, f.packageRoot)).toThrow(
+          "outside the worker payload",
+        );
+        expect(fs.existsSync(f.marker)).toBe(false);
+      },
+    );
+
+    it.each(["koffi", "platform"] as const)(
+      "rejects an omitted %s that module resolution finds in an outside ancestor",
+      (omitted) => {
+        const f = fixture();
+        const member = omitted === "koffi" ? f.koffi : f.platform;
+        const ancestor = path.join(
+          f.root,
+          "node_modules",
+          omitted === "koffi" ? "koffi" : `@koromix/koffi-${process.platform}-${process.arch}`,
+        );
+        fs.rmSync(member, { recursive: true });
+        fs.mkdirSync(path.dirname(ancestor), { recursive: true });
+        fs.symlinkSync(f.outside, ancestor);
+        expect(() => loadMacWorkerDarwinProcessApi(f.runtime, f.packageRoot)).toThrow(
+          "outside the worker payload",
+        );
+        expect(fs.existsSync(f.marker)).toBe(false);
+      },
+    );
+
+    it("rejects an omitted native binary before invoking Koffi's fallback loader", () => {
+      const f = fixture();
+      fs.rmSync(f.native);
+      expect(() => loadMacWorkerDarwinProcessApi(f.runtime, f.packageRoot)).toThrow(
+        "Cannot find module",
+      );
+      expect(fs.existsSync(f.marker)).toBe(false);
+    });
+  },
+);

index 0000000000000000000000000000000000000000..2d61a3a05bd3cc8299f4564d420e2a0bd64ccd0d
--- /dev/null
+++ b/src/gateway/auth-token-source-conflict.test.ts
@@ -0,0 +1,64 @@
+import { describe, expect, it } from "vitest";
+import { resolveGatewayAuthTokenSourceConflict } from "./auth-token-source-conflict.js";
+
+describe("gateway token-source diagnostic attribution", () => {
+  it.each(["store", "file", "exec"] as const)(
+    "reports %s SecretRef comparison as unresolved without exposing token values",
+    (source) => {
+      const result = resolveGatewayAuthTokenSourceConflict({
+        cfg: {
+          gateway: { auth: { token: { source, provider: "default", id: "GATEWAY_SECRET" } } },
+        },
+        env: { OPENCLAW_GATEWAY_TOKEN: "synthetic-shell-token" },
+      });
+      expect(result?.title).toContain("values not compared");
+      expect(result?.detail).toContain("values may be identical");
+      expect(JSON.stringify(result)).not.toContain("synthetic-shell-token");
+      expect(result?.title).not.toContain("conflicts");
+    },
+  );
+
+  it.each([false, true])("compares available literal/environment values (ref=%s)", (useRef) => {
+    const cfg = {
+      gateway: {
+        auth: {
+          token: useRef
+            ? { source: "env" as const, provider: "default", id: "CONFIGURED_TOKEN" }
+            : "synthetic-config-token",
+        },
+      },
+    };
+    expect(
+      resolveGatewayAuthTokenSourceConflict({
+        cfg,
+        env: {
+          OPENCLAW_GATEWAY_TOKEN: "synthetic-config-token",
+          CONFIGURED_TOKEN: "synthetic-config-token",
+        },
+      }),
+    ).toBeNull();
+    const mismatch = resolveGatewayAuthTokenSourceConflict({
+      cfg,
+      env: {
+        OPENCLAW_GATEWAY_TOKEN: "synthetic-other-token",
+        CONFIGURED_TOKEN: "synthetic-config-token",
+      },
+    });
+    expect(mismatch?.title).toContain("conflicts");
+    expect(mismatch?.detail).toContain("value differs");
+    expect(JSON.stringify(mismatch)).not.toContain("synthetic-other-token");
+    expect(JSON.stringify(mismatch)).not.toContain("synthetic-config-token");
+  });
+
+  it("does not assert inequality when an environment SecretRef is unavailable", () => {
+    const result = resolveGatewayAuthTokenSourceConflict({
+      cfg: {
+        gateway: {
+          auth: { token: { source: "env", provider: "default", id: "MISSING_TOKEN" } },
+        },
+      },
+      env: { OPENCLAW_GATEWAY_TOKEN: "synthetic-shell-token" },
+    });
+    expect(result?.title).toContain("values not compared");
+  });
+});

+import { beforeEach, describe, expect, it, vi } from "vitest";
+import type { SessionEntry } from "../../../config/sessions.js";
+import { createSubagentRunRecord } from "../../subagent-test-fixtures.test-helpers.js";
+import { captureQueuedSubagentMcpRequesterScope } from "./subagent-registry-run-launch.js";
+
+const state = vi.hoisted(() => ({
+  generation: "generation-A",
+  sessions: new Map<string, SessionEntry>(),
+}));
+
+vi.mock("../../../infra/agent-events.js", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("../../../infra/agent-events.js")>()),
+  getAgentEventLifecycleGeneration: () => state.generation,
+  isAgentEventLifecycleGenerationCurrent: (generation: string) => generation === state.generation,
+}));
+vi.mock("./subagent-session-reconciliation.js", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("./subagent-session-reconciliation.js")>()),
+  loadSubagentSessionEntry: ({ childSessionKey }: { childSessionKey: string }) =>
+    state.sessions.get(childSessionKey),
+}));
+
+function createQueuedOwner() {
+  const scope = {
+    requesterSenderId: "owner-A",
+    agentAccountId: "company-A",
+    messageChannel: "discord",
+  };
+  const entry = createSubagentRunRecord({
+    runId: "queued-A",
+    generation: 4,
+    createdAt: 100,
+    childSessionKey: "agent:main:subagent:child-A",
+    requesterSessionKey: "agent:main:main",
+    controllerSessionKey: "agent:main:main",
+    requesterAgentId: "main",
+    completionRequesterSessionId: "parent-A",
+    requesterMcpScope: scope,
+    collect: true,
+    swarmLaunchPending: true,
+    swarmLaunchIdempotencyKey: "queued-A",
+    execution: { status: "queued" },
+    queuedLaunch: {
+      request: { sessionKey: "agent:main:subagent:child-A", idempotencyKey: "queued-A" },
+      expectedSessionId: "child-A",
+      expectedLifecycleRevision: "revision-A",
+      timeoutMs: 1_000,
+      schedulerGroupKey: "group-A",
+      maxConcurrent: 1,
+    },
+  });
+  state.sessions.set(entry.childSessionKey, {
+    sessionId: "child-A",
+    lifecycleRevision: "revision-A",
+    spawnedBy: "agent:main:main",
+    spawnDepth: 1,
+    inheritedToolPolicyVersion: 1,
+    inheritedToolAllow: ["read"],
+    inheritedToolDeny: ["exec"],
+    updatedAt: 100,
+  });
+  state.sessions.set(entry.requesterSessionKey, { sessionId: "parent-A", updatedAt: 100 });
+  const runs = new Map([[entry.runId, entry]]);
+  const capture = () =>
+    captureQueuedSubagentMcpRequesterScope({
+      runs,
+      entry,
+      expectedRequesterSessionKey: "agent:main:main",
+      expectedChildSessionKey: "agent:main:subagent:child-A",
+    });
+  return { entry, runs, scope, capture };
+}
+
+describe("queued subagent requester credential ownership", () => {
+  beforeEach(() => {
+    state.generation = "generation-A";
+    state.sessions.clear();
+  });
+
+  it("restores the saved exact credential partition and expires it when registration transfers", () => {
+    const original = createQueuedOwner();
+    const restored = structuredClone(original.entry);
+    const runs = new Map([[restored.runId, restored]]);
+    const context = captureQueuedSubagentMcpRequesterScope({
+      runs,
+      entry: restored,
+      expectedRequesterSessionKey: restored.requesterSessionKey,
+      expectedChildSessionKey: restored.childSessionKey,
+    })!;
+    expect(context.mcpRequesterScope).toEqual(original.scope);
+    expect(context.mcpRequesterScope).not.toBe(restored.requesterMcpScope);
+    context.mcpRequesterScopeAssertCurrent!();
+    restored.execution = { status: "running" };
+    expect(context.mcpRequesterScopeAssertCurrent).toThrow("ownership is no longer current");
+  });
+
+  it.each([
+    [
+      "replaced row",
+      ({ entry, runs }: ReturnType<typeof createQueuedOwner>) =>
+        runs.set(entry.runId, structuredClone(entry)),
+    ],
+    [
+      "removed row",
+      ({ entry, runs }: ReturnType<typeof createQueuedOwner>) => runs.delete(entry.runId),
+    ],
+    [
+      "changed parent",
+      ({ entry }: ReturnType<typeof createQueuedOwner>) => {
+        entry.requesterSessionKey = "agent:main:other";
+      },
+    ],
+    [
+      "changed child target",
+      ({ entry }: ReturnType<typeof createQueuedOwner>) => {
+        entry.queuedLaunch!.request.sessionKey = "agent:main:subagent:other";
+      },
+    ],
+    [
+      "changed launch id",
+      ({ entry }: ReturnType<typeof createQueuedOwner>) => {
+        entry.queuedLaunch!.request.idempotencyKey = "queued-B";
+      },
+    ],
+    [
+      "changed registration",
+      ({ entry }: ReturnType<typeof createQueuedOwner>) => {
+        entry.generation = 5;
+      },
+    ],
+    [
+      "retired gateway",
+      () => {
+        state.generation = "generation-B";
+      },
+    ],
+    [
+      "rebound child",
+      ({ entry }: ReturnType<typeof createQueuedOwner>) => {
+        state.sessions.get(entry.childSessionKey)!.sessionId = "child-B";
+      },
+    ],
+    [
+      "revised child",
+      ({ entry }: ReturnType<typeof createQueuedOwner>) => {
+        state.sessions.get(entry.childSessionKey)!.lifecycleRevision = "revision-B";
+      },
+    ],
+    [
+      "reset parent",
+      ({ entry }: ReturnType<typeof createQueuedOwner>) => {
+        state.sessions.get(entry.requesterSessionKey)!.sessionId = "parent-B";
+      },
+    ],
+    [
+      "changed account",
+      ({ entry }: ReturnType<typeof createQueuedOwner>) => {
+        entry.requesterMcpScope!.agentAccountId = "company-B";
+      },
+    ],
+    [
+      "widened tool ceiling",
+      ({ entry }: ReturnType<typeof createQueuedOwner>) => {
+        state.sessions.get(entry.childSessionKey)!.inheritedToolAllow = ["*"];
+      },
+    ],
+    [
+      "removed deny",
+      ({ entry }: ReturnType<typeof createQueuedOwner>) => {
+        state.sessions.get(entry.childSessionKey)!.inheritedToolDeny = [];
+      },
+    ],
+    [
+      "removed typed envelope",
+      ({ entry }: ReturnType<typeof createQueuedOwner>) => {
+        delete state.sessions.get(entry.childSessionKey)!.inheritedToolPolicyVersion;
+      },
+    ],
+    [
+      "changed channel",
+      ({ entry }: ReturnType<typeof createQueuedOwner>) => {
+        entry.requesterMcpScope!.messageChannel = "webchat";
+      },
+    ],
+    [
+      "cancelled row",
+      ({ entry }: ReturnType<typeof createQueuedOwner>) => {
+        entry.killIntent = { requestedAt: 101, reason: "cancelled" };
+      },
+    ],
+  ] as const)("rejects a %s before credential transfer", (_name, mutate) => {
+    const owner = createQueuedOwner();
+    const context = owner.capture()!;
+    mutate(owner);
+    expect(context.mcpRequesterScopeAssertCurrent).toThrow();
+  });
+
+  it("never infers credential authority from legacy queued request JSON", () => {
+    const owner = createQueuedOwner();
+    delete owner.entry.requesterMcpScope;
+    owner.entry.queuedLaunch!.request.mcpRequesterScope = owner.scope;
+    owner.entry.queuedLaunch!.request.senderIsOwner = true;
+    expect(owner.capture()).toBeUndefined();
+  });
+
+  it("does not let model JSON replace the private requester tuple", () => {
+    const owner = createQueuedOwner();
+    owner.entry.queuedLaunch!.request.mcpRequesterScope = { requesterSenderId: "owner-B" };
+    expect(owner.capture()!.mcpRequesterScope).toEqual(owner.scope);
+  });
+
+  it.each(["parent stamp", "child stamp", "lifecycle stamp", "blank lifecycle stamp"])(
+    "rejects a new scoped registration without its %s",
+    (stamp) => {
+      const owner = createQueuedOwner();
+      if (stamp === "parent stamp") {
+        delete owner.entry.completionRequesterSessionId;
+      } else if (stamp === "child stamp") {
+        delete owner.entry.queuedLaunch!.expectedSessionId;
+      } else if (stamp === "lifecycle stamp") {
+        delete owner.entry.queuedLaunch!.expectedLifecycleRevision;
+        delete state.sessions.get(owner.entry.childSessionKey)!.lifecycleRevision;
+      } else {
+        owner.entry.queuedLaunch!.expectedLifecycleRevision = " ";
+        state.sessions.get(owner.entry.childSessionKey)!.lifecycleRevision = " ";
+      }
+      expect(owner.capture).toThrow("ownership is no longer current");
+    },
+  );
+});

+let state: OpenClawTestState;
+const defaults = { typing: {} as never, typingMode: "never" as const, defaultModel: "test-model" };
+function createConfig(enabled: boolean): OpenClawConfig {
+  return { hooks: { internal: { entries: { "session-memory": { enabled } } } } };

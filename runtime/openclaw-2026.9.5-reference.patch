+import { replaceTranscriptEvents } from "../../config/sessions/session-accessor.js";
+import { runWithSessionTranscriptReadFence } from "../../config/sessions/session-transcript-read-fence.js";
+import { withOpenClawTestState } from "../../test-utils/openclaw-test-state.js";
+import { emitCronOutcomeEventForJob } from "../service/timer-outcome-events.js";
+import { authorCronRunCompletion, applyJobResult } from "../service/timer.js";
+import { cronRunLogEntryFromEvent } from "../task-run-event-codec.js";
+import { makeIsolatedAgentParamsFixture } from "./job-fixtures.js";
+import {
+  CRON_PREWORK_FAILURE_DIAGNOSTIC,
+  hasSettledCronPreworkFailure,
+} from "./run-prework-failure.js";
+import { setupRunCronIsolatedAgentTurnSuite } from "./run.suite-helpers.js";
+import {
+  loadRunCronIsolatedAgentTurn,
+  makeCronSession,
+  resolveCronSessionMock,
+  mockRunCronFallbackPassthrough,
+  runEmbeddedAgentMock,
+  dispatchCronDeliveryMock,
+  resolveCronDeliveryPlanMock,
+  patchSessionEntryMock,
+  pickLastNonEmptyTextFromPayloadsMock,
+} from "./run.test-harness.js";
+
+const runCronIsolatedAgentTurn = await loadRunCronIsolatedAgentTurn();
+const sessionId = "test-session-id";
+const jobId = "test-job";
+// Wire diagnostic oracle remains defined when running these fixtures on OLD source.
+const CRON_PREDELIVERY_FAILURE_DIAGNOSTIC =
+  "cron isolated failure after completed native execution with no recorded tool, delivery, or accepted work and before final delivery entry";
+const sessionKey = `agent:main:cron:${jobId}:run:${sessionId}`;
+
+function history() {
+  return [
+    { type: "session", id: sessionId, version: 3 },
+    {
+      type: "model_change",
+      id: "model",
+      parentId: null,
+      provider: "openai",
+      modelId: "test-model",
+    },
+    { type: "thinking_level_change", id: "thinking", parentId: "model", thinkingLevel: "high" },
+    {
+      type: "custom",
+      id: "snapshot",
+      parentId: "thinking",
+      customType: "model-snapshot",
+      data: {},
+    },
+    {
+      type: "message",
+      id: "input",
+      parentId: "snapshot",
+      message: {
+        role: "user",
+        content: "Check changes",
+        provenance: {
+          kind: "internal_system",
+          sourceTool: "cron",
+          jobId,
+          runId: sessionId,
+          sourceSessionKey: sessionKey,
+        },
+      },
+    },
+    {
+      type: "custom_message",
+      id: "context",
+      parentId: "input",
+      customType: "openclaw.runtime-context",
+      content: "Current run",
+      display: false,
+    },
+    {
+      type: "message",
+      id: "error",
+      parentId: "context",
+      message: {
+        ...makeAssistantMessageFixture({
+          content: [],
+          stopReason: "error",
+          errorMessage: "429 rate limit",
+        }),
+        usage: { input: 0, output: 0 },
+        __openclaw: { runId: sessionId },
+        idempotencyKey: `${sessionId}:terminal-error`,
+      },
+    },
+  ];
+}
+
+describe("settled cron prework failure", () => {
+  setupRunCronIsolatedAgentTurnSuite();
+
+  it.each([
+    "complete",
+    "tool",
+    "partial",
+    "branch",
+    "unknown",
+    "missing-terminal",
+    "wrong-run",
+    "fenced",
+    "truncated",
+    "display",
+  ])("requires complete canonical prework proof (%s)", async (scenario) => {
+    await withOpenClawTestState({ label: "cron-prework-proof" }, async (state) => {
+      const scope = {
+        agentId: "main",
+        sessionId,
+        sessionKey,
+        storePath: state.statePath("agents", "main", "agent", "openclaw-agent.sqlite"),
+      };
+      const events = history();
+      if (scenario === "tool") {
+        events.splice(6, 0, {
+          type: "message",
+          id: "tool",
+          parentId: "context",
+          message: {
+            role: "assistant",
+            content: [{ type: "toolCall", id: "send", name: "message", arguments: {} }],
+          },
+        } as never);
+      }
+      if (scenario === "partial") {
+        expectDefined(events[6], "Missing fixture event").message!.content = [
+          { type: "text", text: "Already sent" },
+        ] as never;
+      }
+      if (scenario === "branch") {
+        expectDefined(events[6], "Missing fixture event").parentId = "input";
+      }
+      if (scenario === "unknown") {
+        expectDefined(events[3], "Missing fixture event").customType = "unrecognized";
+      }
+      if (scenario === "missing-terminal") {
+        events.pop();
+      }
+      if (scenario === "wrong-run") {
+        expectDefined(events[4], "Missing fixture event").message!.provenance!.runId = "old-run";
+      }
+      if (scenario === "display") {
+        Object.assign(expectDefined(events[6], "Missing fixture event").message!, {
+          openclawDisplayContent: [{ type: "text", text: "Sent" }],
+        });
+      }
+      if (scenario === "truncated") {
+        expectDefined(events[5], "Missing fixture event").content = "x".repeat(512_001);
+      }
+      await replaceTranscriptEvents(scope, events);
+      const check = () => hasSettledCronPreworkFailure({ ...scope, jobId });
+      const actual =
+        scenario === "fenced"
+          ? await runWithSessionTranscriptReadFence({ agentId: "main", sessionId } as never, check)
+          : await check();
+      expect(actual).toBe(scenario === "complete");
+    });
+  });
+
+  it.each([false, true])(
+    "native owner retains a no-send fact only before any work (tool=%s)",
+    async (toolStarted) => {
+      await withOpenClawTestState({ label: "cron-prework-owner" }, async (state) => {
+        const storePath = state.statePath("agents", "main", "agent", "openclaw-agent.sqlite");
+        resolveCronSessionMock.mockReturnValue(makeCronSession({ storePath }));
+        mockRunCronFallbackPassthrough();
+        resolveCronDeliveryPlanMock.mockReturnValue({
+          requested: true,
+          mode: "announce",
+          channel: "discord",
+          to: "channel:test",
+        });
+        runEmbeddedAgentMock.mockImplementationOnce(async (params) => {
+          const scope = {
+            agentId: "main",
+            sessionId: params.sessionId,
+            sessionKey: params.sessionKey,
+            storePath,
+          };
+          expect(scope.sessionKey).toBe(sessionKey);
+          await replaceTranscriptEvents(scope, history().slice(0, 6));
+          if (toolStarted) {
+            params.onExecutionPhase?.({ phase: "tool_execution_started" });
+          }
+          params.assistantErrorTranscript.record(
+            makeAssistantMessageFixture({
+              content: [],
+              stopReason: "error",
+              errorMessage: "429 rate limit",
+              usage: {
+                input: 0,
+                output: 0,
+                cacheRead: 0,
+                cacheWrite: 0,
+                totalTokens: 0,
+                cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+              },
+            }),
+            scope,
+          );
+          throw new FailoverError("429 rate limit", { reason: "rate_limit", provider: "openai" });
+        });
+        const job = createDueIsolatedJob({ id: jobId, nowMs: Date.now(), nextRunAtMs: Date.now() });
+        job.delivery = { mode: "announce", channel: "discord", to: "channel:test" };
+        const result = await runCronIsolatedAgentTurn(
+          makeIsolatedAgentParamsFixture({ job, agentId: "main", sessionKey: `cron:${jobId}` }),
+        );
+        expect(result.error).toContain("429 rate limit");
+        expect(result.status).toBe("error");
+        expect(dispatchCronDeliveryMock).not.toHaveBeenCalled();
+        expect(result.delivered).toBe(toolStarted ? undefined : false);
+        const onEvent = vi.fn();
+        const service = createCronRegressionState({
+          storePath: state.statePath("cron", "jobs.json"),
+          onEvent,
+          runIsolatedAgentJob: vi.fn(),
+        });
+        const outcome = {
+          ...authorCronRunCompletion(service, job, result),
+          job,
+          jobId,
+          startedAt: Date.now(),
+          endedAt: Date.now(),
+        };
+        applyJobResult(service, job, outcome, { failureAlerts: false });
+        emitCronOutcomeEventForJob(service, job, outcome);
+        const row = cronRunLogEntryFromEvent(
+          expectDefined(onEvent.mock.calls[0], "Missing terminal cron event")[0],
+          Date.now(),
+        );
+        expect(Value.Check(CronRunLogEntrySchema, row)).toBe(true);
+        expect(row).not.toHaveProperty("deliveryAttempted");
+        expect(row.deliveryStatus).toBe(toolStarted ? "unknown" : "not-delivered");
+        expect(row.deliveryError).toBe(result.error);
+        expect(
+          row.diagnostics?.entries.some(
+            (entry) =>
+              entry.source === "agent-run" &&
+              entry.severity === "info" &&
+              entry.message === CRON_PREWORK_FAILURE_DIAGNOSTIC,
+          ),
+        ).toBe(!toolStarted);
+      });
+    },
+  );
+});
+
+describe("completed native cron execution before final delivery", () => {
+  setupRunCronIsolatedAgentTurnSuite();
+  const bookkeepingError = "post-prompt bookkeeping failed";
+
+  function nativeResult(): EmbeddedAgentRunResult {
+    return {
+      payloads: [{ text: "The requested result is complete." }],
+      meta: {
+        durationMs: 1,
+        executionTrace: { runner: "embedded" },
+        agentMeta: {
+          sessionId,
+          provider: "openai",
+          model: "test-model",
+          agentHarnessId: "openclaw",
+        },
+      },
+    };
+  }
+
+  // The backend result is synthetic; preparation, execution/ack handling,
+  // completed-result capture, continuation persistence and cron rows are real.
+  async function completedFailure(runResult: EmbeddedAgentRunResult, beforeHandle = false) {
+    return withOpenClawTestState({ label: "cron-completed-predelivery" }, async (state) => {
+      resolveCronSessionMock.mockReturnValue(
+        makeCronSession({
+          storePath: state.statePath("agents", "main", "agent", "openclaw-agent.sqlite"),
+        }),
+      );
+      mockRunCronFallbackPassthrough();
+      resolveCronDeliveryPlanMock.mockReturnValue({
+        requested: true,
+        mode: "announce",
+        channel: "discord",
+        to: "channel:test",
+      });
+      const persist: typeof import("../../config/sessions/session-accessor.js").patchSessionEntryCore =
+        expectDefined(
+          patchSessionEntryMock.getMockImplementation(),
+          "Missing actual persistence fixture",
+        );
+      let completed = false;
+      const failingSessionKey = beforeHandle ? sessionKey : `agent:main:cron:${jobId}`;
+      patchSessionEntryMock.mockImplementation(async (...args: Parameters<typeof persist>) => {
+        if (completed && args[0].sessionKey === failingSessionKey) {
+          throw new Error(bookkeepingError);
+        }
+        return persist(...args);
+      });
+      runEmbeddedAgentMock.mockImplementationOnce(async (params) => {
+        params.onExecutionStarted?.();
+        completed = true;
+        return runResult;
+      });
+      const job = createDueIsolatedJob({ id: jobId, nowMs: Date.now(), nextRunAtMs: Date.now() });
+      job.delivery = { mode: "announce", channel: "discord", to: "channel:test" };
+      const result = await runCronIsolatedAgentTurn(
+        makeIsolatedAgentParamsFixture({ job, agentId: "main", sessionKey: `cron:${jobId}` }),
+      );
+      expect(runEmbeddedAgentMock).toHaveBeenCalledOnce();
+      expect(result.status).toBe("error");
+      expect(result.error).toBe(bookkeepingError);
+      expect(
+        patchSessionEntryMock.mock.calls.some(([scope]) => scope.sessionKey === failingSessionKey),
+      ).toBe(true);
+      expect(dispatchCronDeliveryMock).not.toHaveBeenCalled();
+      const onEvent = vi.fn();
+      const service = createCronRegressionState({
+        storePath: state.statePath("cron", "jobs.json"),
+        onEvent,
+        runIsolatedAgentJob: vi.fn(),
+      });
+      const outcome = {
+        ...authorCronRunCompletion(service, job, result),
+        job,
+        jobId,
+        startedAt: Date.now(),
+        endedAt: Date.now(),
+      };
+      applyJobResult(service, job, outcome, { failureAlerts: false });
+      emitCronOutcomeEventForJob(service, job, outcome);
+      const row = cronRunLogEntryFromEvent(
+        expectDefined(onEvent.mock.calls[0], "Missing terminal cron event")[0],
+        Date.now(),
+      );
+      expect(Value.Check(CronRunLogEntrySchema, row)).toBe(true);
+      expect(row).not.toHaveProperty("deliveryAttempted");
+      expect(row.deliveryError).toBe(bookkeepingError);
+      return { result, row };
+    });
+  }
+
+  it.each([false, true])(
+    "recovers only a completed native zero-tool owner (explicit zero=%s)",
+    async (explicitZero) => {
+      const runResult = nativeResult();
+      if (explicitZero) {
+        runResult.meta.toolSummary = { calls: 0, tools: [] };
+      }
+      const { result, row } = await completedFailure(runResult);
+      expect(result.delivered).toBe(false);
+      expect(result.deliveryAttempted).toBe(false);
+      expect(row.deliveryStatus).toBe("not-delivered");
+      expect(
+        row.diagnostics?.entries.some(
+          (entry) =>
+            entry.source === "agent-run" &&
+            entry.severity === "info" &&
+            entry.message === CRON_PREDELIVERY_FAILURE_DIAGNOSTIC,
+        ),
+      ).toBe(true);
+    },
+  );
+
+  it.each([
+    "read",
+    "exec",
+    "message",
+    "conversations_send",
+    "conversations_turn",
+    "provider-native",
+    "custom-catalog",
+    "unknown-tool",
+    "sent-text",
+    "sent-target",
+    "cron-add",
+    "source-reply",
+    "source-message-reply",
+    "source-payload",
+    "approval",
+    "async",
+    "accepted-child",
+    "yielded",
+    "continuation-pending",
+    "replay-invalid",
+    "aborted",
+    "pending-tool",
+    "requester-settled",
+    "cli",
+    "opaque-runner",
+    "contradictory-zero-summary",
+  ])("retains unknown or effectful completed work (%s)", async (activity) => {
+    const runResult = nativeResult();
+    if (
+      [
+        "read",
+        "exec",
+        "message",
+        "conversations_send",
+        "conversations_turn",
+        "provider-native",
+        "custom-catalog",
+        "unknown-tool",
+      ].includes(activity)
+    ) {
+      runResult.meta.toolSummary = {
+        calls: 1,
+        tools: activity === "unknown-tool" ? [] : [activity],
+      };
+    }

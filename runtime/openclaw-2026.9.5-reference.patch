+import crypto from "node:crypto";
+import { stripCompactionReplayCheckpoint } from "@openclaw/ai/transports";
+import { buildSummaryChunksWithWorker } from "../../agents/compaction-planning-worker.js";
+import { sanitizeCompactionMessages } from "../../agents/compaction-planning.js";
+import {
+  assertMemoryExtractionRequestFits,
+  MemoryExtractionBudgetError,
+} from "../../agents/memory-extraction-budget.js";
+import type { AgentMessage } from "../../agents/runtime/index.js";
+import {
+  estimateCompactionHistoryTokens,
+  type CompactionRequestBudget,
+} from "../../agents/sessions/compaction/request-budget.js";
+import { SessionManager } from "../../agents/sessions/session-manager.js";
+import { updateSessionEntry } from "../../config/sessions/session-accessor.js";
+import { logVerbose } from "../../globals.js";
+import { registerAgentRunContext } from "../../infra/agent-run-registry.js";
+import type { VerboseLevel } from "../thinking.js";
+
+/** Register only runnable private maintenance; its checkpoint owner retains the sole cleanup. */
+export function registerMemoryExtractionContext(
+  runId: string,
+  session: { sessionKey: string; sessionId: string },
+  source: { sessionKey?: string; resolvedVerboseLevel: VerboseLevel },
+): boolean {
+  if (!source.sessionKey) {
+    return false;
+  }
+  registerAgentRunContext(runId, {
+    sessionKey: session.sessionKey,
+    sessionId: session.sessionId,
+    verboseLevel: source.resolvedVerboseLevel,
+    isControlUiVisible: false,
+    projectSessionActive: false,
+    projectSessionLifecycle: false,
+    projectSessionMessages: false,
+  });
+  return true;
+}
+
+/** Only an exact, pre-dispatch refusal may repartition an unsent original segment. */
+export async function runMemoryExtractionSegments(params: {
+  messages: AgentMessage[];
+  workspaceDir: string;
+  signal: AbortSignal;
+  runSegment: (extraction: {
+    sessionManager: SessionManager;
+    prepareCandidate: () => void;
+    assertPrepared: () => void;
+    onPreparedBudget: (budget: CompactionRequestBudget | undefined) => void;
+  }) => Promise<void>;
+}): Promise<void> {
+  const pendingSegments = [params.messages];
+  while (pendingSegments.length > 0) {
+    params.signal.throwIfAborted();
+    const segment = pendingSegments.shift()!;
+    const sessionManager = createMemoryExtractionSession(segment, params.workspaceDir);
+    const extractionMessages = sessionManager.buildSessionContext().messages;
+    let rejectedBudget: MemoryExtractionBudgetError | undefined;
+    let initialBudgetChecked = false;
+    let providerAttempted = false;
+    try {
+      await params.runSegment({
+        sessionManager,
+        prepareCandidate: () => {
+          if (rejectedBudget) {
+            throw rejectedBudget;
+          }
+          initialBudgetChecked = false;
+        },
+        assertPrepared: () => {
+          if (rejectedBudget) {
+            throw rejectedBudget;
+          }
+        },
+        onPreparedBudget: (budget) => {
+          if (!budget) {
+            // Every inner auth/profile attempt publishes this preparation boundary.
+            initialBudgetChecked = false;
+            return;
+          }
+          if (initialBudgetChecked) {
+            // The existing second budget callback is immediately before streaming.
+            // A started segment can continue, but may never replay its original input.
+            providerAttempted = true;
+            return;
+          }
+          initialBudgetChecked = true;
+          try {
+            assertMemoryExtractionRequestFits(
+              providerAttempted
+                ? sessionManager.buildSessionContext().messages
+                : extractionMessages,
+              budget,
+            );
+          } catch (error) {
+            if (error instanceof MemoryExtractionBudgetError && !providerAttempted) {
+              rejectedBudget = error;
+            }
+            throw error;
+          }
+        },
+      });
+    } catch (error) {
+      if (!rejectedBudget || error !== rejectedBudget || params.signal.aborted) {
+        throw error;
+      }
+    }
+    if (rejectedBudget) {
+      const split = await splitMemoryExtractionHistory(
+        segment,
+        rejectedBudget.maxHistoryTokens,
+        params.signal,
+      );
+      if (split.length < 2) {
+        throw rejectedBudget;
+      }
+      pendingSegments.unshift(...split);
+    }
+  }
+}
+
+/** Publish success only after every original segment has completed under the checkpoint owner. */
+export async function persistMemoryExtractionCheckpoint(params: {
+  storePath?: string;
+  sessionKey?: string;
+  compactionCount: number;
+}) {
+  if (!params.storePath || !params.sessionKey) {
+    return undefined;
+  }
+  try {
+    return await updateSessionEntry(
+      { storePath: params.storePath, sessionKey: params.sessionKey },
+      async () => ({ memoryFlush: { kind: "succeeded", compactionCount: params.compactionCount } }),
+      { skipMaintenance: true, takeCacheOwnership: true },
+    );
+  } catch (error) {
+    logVerbose(`failed to persist memory flush metadata: ${String(error)}`);
+    return undefined;
+  }
+}
+
+/** Prefer whole turns, falling back only to complete tool-call/result groups. No summaries or omissions. */
+async function splitMemoryExtractionHistory(
+  messages: AgentMessage[],
+  maxHistoryTokens: number,
+  signal?: AbortSignal,
+): Promise<AgentMessage[][]> {
+  const groups = await buildSummaryChunksWithWorker({ messages, maxChunkTokens: 1, signal });
+  const turns: AgentMessage[][][] = [];
+  for (const group of groups) {
+    if (group[0]?.role === "user" || turns.length === 0) {
+      turns.push([group]);
+    } else {
+      turns[turns.length - 1]!.push(group);
+    }
+  }
+  const chunks: AgentMessage[][] = [];
+  let current: AgentMessage[] = [];
+  for (const turnGroups of turns) {
+    signal?.throwIfAborted();
+    const turn = turnGroups.flat();
+    const units = estimateCompactionHistoryTokens(turn) <= maxHistoryTokens ? [turn] : turnGroups;
+    for (const unit of units) {
+      if (estimateCompactionHistoryTokens(unit) > maxHistoryTokens) {
+        throw new Error(
+          "An indivisible memory extraction group cannot fit the prepared request allowance.",
+        );
+      }
+      if (
+        current.length > 0 &&
+        estimateCompactionHistoryTokens([...current, ...unit]) > maxHistoryTokens
+      ) {
+        chunks.push(current);
+        current = [];
+      }
+      current.push(...unit);
+    }
+  }
+  if (current.length > 0) {
+    chunks.push(current);
+  }
+  return chunks;
+}
+
+/** A caller-owned model view; constructing it cannot mutate the original transcript. */
+function createMemoryExtractionSession(messages: AgentMessage[], workspaceDir: string) {
+  const header = SessionManager.inMemory(workspaceDir).getHeader();
+  const visibleMessages = sanitizeCompactionMessages(messages);
+  const ids = visibleMessages.map(() => crypto.randomUUID());
+  let parentId: string | null = null;
+  const entries: unknown[] = [header];
+  for (const [index, message] of visibleMessages.entries()) {
+    const id = ids[index]!;
+    const base = { id, parentId, timestamp: new Date(message.timestamp).toISOString() };
+    // Reconstitute existing context carriers through their ordinary codec. A
+    // maintenance system prompt cannot reuse the canonical provider checkpoint.
+    const entry =
+      message.role === "compactionSummary"
+        ? {
+            ...base,
+            type: "compaction",
+            summary: message.summary,
+            tokensBefore: message.tokensBefore,
+            firstKeptEntryId: ids[index + 1] ?? id,
+          }
+        : message.role === "branchSummary"
+          ? {
+              ...base,
+              type: "branch_summary",
+              summary: message.summary,
+              fromId: message.fromId,
+            }
+          : message.role === "custom"
+            ? {
+                ...base,
+                type: "custom_message",
+                customType: message.customType,
+                content: message.content,
+                display: message.display,
+                details: message.details,
+              }
+            : {
+                ...base,
+                type: "message",
+                message:
+                  message.role === "assistant" ? stripCompactionReplayCheckpoint(message) : message,
+              };
+    parentId = id;
+    entries.push(entry);
+  }
+  return SessionManager.fromEntries(entries, workspaceDir);
+}

@@ -0,0 +1,100 @@
+import { createDeferred } from "openclaw/plugin-sdk/extension-shared";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { createBrowserNodeSessionTabRoute } from "./browser-node-proxy.js";
+
+type GatewayExtra = Parameters<typeof import("./browser-tool.runtime.js").callGatewayTool>[3];
+const state = vi.hoisted(() => ({
+  gateway: vi.fn(
+    async (_method: string, _options: unknown, _request: unknown, _extra: GatewayExtra) => ({
+      payload: { result: { ok: true } },
+    }),
+  ),
+  prepare: vi.fn(async ({ body }: { body?: unknown }) => ({ body })),
+  effects: 0,
+}));
+vi.mock("./browser-tool.runtime.js", () => ({
+  callGatewayTool: state.gateway,
+  persistBrowserProxyResultFiles: async (result: unknown) => result,
+  fetchBrowserJson: vi.fn(),
+}));
+vi.mock("./browser-proxy-upload.js", () => ({
+  isBrowserProxyUploadRequest: () => false,
+  prepareBrowserProxyUploadRequest: state.prepare,
+}));
+
+function close(assertCurrent: () => void) {
+  return createBrowserNodeSessionTabRoute({
+    nodeId: "node",
+    commands: ["browser.proxy"],
+  }).closeTarget({
+    targetId: "agent-tab",
+    profile: "work",
+    assertCurrent,
+  });
+}
+
+describe("ordinary completion keeps node close authority at actual dispatch", () => {
+  beforeEach(() => {
+    state.gateway.mockReset().mockResolvedValue({ payload: { result: { ok: true } } });
+    state.prepare.mockReset().mockImplementation(async ({ body }) => ({ body }));
+    state.effects = 0;
+  });
+
+  it("revokes before the Gateway call if preparation outlives the completed owner", async () => {
+    const entered = createDeferred<void>();
+    const release = createDeferred<void>();
+    state.prepare.mockImplementation(async ({ body }) => {
+      entered.resolve();
+      await release.promise;
+      return { body };
+    });
+    let current = true;
+    const pending = close(() => {
+      if (!current) {
+        throw new Error("completion revoked");
+      }
+    });
+    const rejected = expect(pending).rejects.toThrow("completion revoked");
+    await entered.promise;
+    current = false;
+    release.resolve();
+    await rejected;
+    expect(state.gateway).not.toHaveBeenCalled();
+  });
+
+  it.each([true, false])(
+    "projects a host-only guard through the existing Gateway dispatch boundary (current=%s)",
+    async (currentAtDispatch) => {
+      const entered = createDeferred<void>();
+      const release = createDeferred<void>();
+      let current = true;
+      state.gateway.mockImplementation(async (_method, _options, _request, extra) => {
+        entered.resolve();
+        await release.promise;
+        if (extra?.dispatchAuthority?.kind !== "source-bound") {
+          throw new Error("missing close owner");
+        }
+        extra.dispatchAuthority.assertCurrent();
+        state.effects += 1;
+        return { payload: { result: { ok: true } } };
+      });
+      const pending = close(() => {
+        if (!current) {
+          throw new Error("completion revoked");
+        }
+      });
+      const result = currentAtDispatch
+        ? expect(pending).resolves.toEqual({ status: "closed" })
+        : expect(pending).rejects.toThrow("completion revoked");
+      await entered.promise;
+      current = currentAtDispatch;
+      release.resolve();
+      await result;
+      expect(state.effects).toBe(currentAtDispatch ? 1 : 0);
+      expect(state.gateway.mock.calls[0]?.[2]).toMatchObject({
+        params: { method: "DELETE", path: "/tabs/agent-tab" },
+      });
+      expect(JSON.stringify(state.gateway.mock.calls[0]?.[2])).not.toContain("assertCurrent");
+    },
+  );
+});

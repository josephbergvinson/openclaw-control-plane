+import { createHash } from "node:crypto";
+import type { ChannelPlugin } from "./channel-api.js";
+import {
+  createDiscordDraftStream,
+  type DiscordDraftSnapshot,
+  type DiscordDraftStream,
+} from "./draft-stream.js";
+import {
+  discordProgressWriters as writers,
+  type DiscordProgressWriter as Writer,
+  type DiscordProgressWriterLease as Lease,
+} from "./request-progress-writer-state.js";
+import { getDiscordRuntime } from "./runtime.js";
+
+type ProgressRequest = NonNullable<
+  Parameters<
+    NonNullable<NonNullable<ChannelPlugin["streaming"]>["createContinuationProgress"]>
+  >[0]["progressRequest"]
+>;
+export type DiscordProgressScope = ProgressRequest & {
+  accountId: string;
+  channelId: string;
+  threadId?: string;
+};
+type Receipt = {
+  scope: DiscordProgressScope;
+  epoch: number;
+  closed: boolean;
+  draft: DiscordDraftSnapshot;
+};
+const TERMINAL_RETENTION_MS = 24 * 60 * 60 * 1000;
+
+function resolvedDraft(draft: DiscordDraftSnapshot) {
+  return (
+    draft.pendingCreates.every((create) => Boolean(create.messageId)) &&
+    !draft.pendingCleanupMessages?.length &&
+    !draft.pendingCleanupCreates?.length
+  );
+}
+
+function receiptKey(scope: DiscordProgressScope) {
+  // Retain the existing normalized receipt bytes regardless of a host locator's
+  // property insertion order; delegated facts do not mint a second request key.
+  return createHash("sha256")
+    .update(
+      JSON.stringify({
+        sessionKey: scope.sessionKey,
+        sessionId: scope.sessionId,
+        sourceMessageId: scope.sourceMessageId,
+        requestGeneration: scope.requestGeneration,
+        accountId: scope.accountId,
+        channelId: scope.channelId,
+        ...(scope.threadId ? { threadId: scope.threadId } : {}),
+      }),
+    )
+    .digest("hex");
+}
+
+/** An in-run message or worker checkpoint borrows the current compositor, never its lease. */
+export async function publishDiscordRequestProgress(params: {
+  scope: DiscordProgressScope;
+  text: string;
+  assertCurrent: () => void;
+}): Promise<{ status: "visible"; messageId: string } | { status: "withheld" } | undefined> {
+  params.assertCurrent();
+  const key = receiptKey(params.scope);
+  const writer = writers.get(key);
+  if (!writer) {
+    return undefined;
+  }
+  await writer.acquiring;
+  params.assertCurrent();
+  const lease = writer.lease;
+  if (writers.get(key) !== writer || !lease || lease.revoked || !lease.publishProgress) {
+    return undefined;
+  }
+  const assertCurrent = () => {
+    params.assertCurrent();
+    if (writers.get(key) !== writer || writer.lease !== lease || lease.revoked) {
+      throw new Error("Discord progress writer changed");
+    }
+  };
+  assertCurrent();
+  const messageId = await lease.publishProgress(params.text, assertCurrent);
+  assertCurrent();
+  return messageId ? { status: "visible", messageId } : { status: "withheld" };
+}
+
+/** One Discord transport writer; persisted facts never retain a prior turn's authority. */
+export function createDiscordRequestProgressStream(
+  params: Parameters<typeof createDiscordDraftStream>[0] & {
+    resolveScope: () => Promise<DiscordProgressScope & { assertCurrent?: () => void }>;
+    reuseOnly?: boolean;
+    publishProgress?: (text: string, assertCurrent: () => void) => Promise<boolean>;
+  },
+): DiscordDraftStream {
+  let lease: Lease | undefined;
+  const retainedWriters = new Map<string, Writer>();
+  const retainWriter = (key: string) => {
+    const existing = retainedWriters.get(key);
+    if (existing) {
+      return existing;
+    }
+    const writer = writers.get(key) ?? { acquiring: Promise.resolve(), references: 0 };
+    writer.references += 1;
+    writers.set(key, writer);
+    retainedWriters.set(key, writer);
+    return writer;
+  };
+  const releaseWriters = () => {
+    for (const [key, writer] of retainedWriters) {
+      if (writer.lease === lease) {
+        writer.lease = undefined;
+      }
+      writer.references -= 1;
+      if (writer.references === 0 && writers.get(key) === writer) {
+        writers.delete(key);
+      }
+    }
+    retainedWriters.clear();
+  };

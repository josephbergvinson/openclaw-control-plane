+import { describe, expect, it } from "vitest";
+import { projectSubagentRunForSessionList } from "../registry/subagent-delivery-state.js";
+import { createSubagentRegistrationRecord } from "../registry/subagent-registry-run-launch-record.js";
+import {
+  registryRuntimeMock,
+  wakeParams,
+} from "./subagent-announce.requester-settle-fixture.test-support.js";
+import { maybeWakeRequesterAfterAllChildrenSettled } from "./subagent-announce.requester-settle-wake.js";
+import {
+  deliveredCallArg,
+  makeSettledChild,
+  deliverSpy,
+} from "./subagent-announce.requester-settle-wake.test-support.js";
+import { captureSubagentRequesterMcpScope } from "./subagent-requester-mcp-scope.js";
+
+const scope = { requesterSenderId: "alice", agentAccountId: "bot", messageChannel: "discord" };
+describe("requester credential custody", () => {
+  it("captures registration privately without exposing it in session lists", () => {
+    const original = { ...scope };
+    const row = createSubagentRegistrationRecord(
+      {
+        runId: "child",
+        childSessionKey: "agent:main:subagent:child",
+        requesterSessionKey: "agent:main:main",
+        requesterDisplayKey: "main",
+        cleanup: "keep",
+        task: "review",
+        requesterMcpScope: original,
+      },
+      { now: 1000, generation: 1, lifecycleGeneration: "generation" },
+    );
+    original.requesterSenderId = "mallory";
+    expect(row.requesterMcpScope).toEqual(scope);
+    expect(projectSubagentRunForSessionList(row)).not.toHaveProperty("requesterMcpScope");
+  });
+
+  it.each(["matching", "legacy", "mixed", "replacement"])(
+    "settle producer handles a %s requester batch",
+    async (mode) => {
+      const children = [
+        makeSettledChild({
+          runId: "a",
+          completionRequesterSessionId: "sess-main",
+          requesterMcpScope: scope,
+        }),
+        makeSettledChild({
+          runId: "b",
+          completionRequesterSessionId: "sess-main",
+          requesterMcpScope:
+            mode === "legacy"
+              ? undefined
+              : { ...scope, requesterSenderId: mode === "mixed" ? "bob" : "alice" },
+        }),
+      ];
+      if (mode === "replacement") {
+        children[0]!.completionRequesterSessionId = "old-session";
+      }
+      registryRuntimeMock.listSubagentRunsForRequester.mockReturnValue(children);
+      deliverSpy.mockImplementationOnce(async (params) => {
+        if (mode === "matching") {
+          expect(params.mcpRequesterScope).toEqual(scope);
+          expect(params.mcpRequesterScopeAssertCurrent).toBeTypeOf("function");
+          (params.mcpRequesterScopeAssertCurrent as () => void)();
+        } else {
+          expect(params.mcpRequesterScope).toBeUndefined();
+        }
+        return { delivered: true, path: "direct" };
+      });
+      expect(
+        await maybeWakeRequesterAfterAllChildrenSettled(wakeParams({ settledEntry: children[1] })),
+      ).toBe(true);
+      expect(deliveredCallArg()).not.toHaveProperty("senderIsOwner");
+    },
+  );
+
+  it("rejects replacement or changed private identity before completion handoff", () => {
+    const row = makeSettledChild({
+      runId: "a",
+      completionRequesterSessionId: "sess-main",
+      requesterMcpScope: scope,
+    });
+    let current = true;
+    const captured = captureSubagentRequesterMcpScope({
+      records: [row],
+      requesterSessionKey: row.requesterSessionKey,
+      requesterSessionId: "sess-main",
+      assertCurrent: () => {
+        if (!current) {
+          throw new Error("replaced");
+        }
+      },
+    });
+    row.requesterMcpScope = { ...scope, agentAccountId: "other" };
+    expect(() => captured.mcpRequesterScopeAssertCurrent?.()).toThrow("identity changed");
+    row.requesterMcpScope = scope;
+    current = false;
+    expect(() => captured.mcpRequesterScopeAssertCurrent?.()).toThrow("replaced");
+  });
+});

@@ -0,0 +1,46 @@
+import type { InternalChannelThreadingToolContext } from "../../../channels/threading-tool-context-internal.js";
+import { copyMessageActionDelegationSource } from "../../../gateway/message-action-delegation-source.js";
+import {
+  mintMessageActionTurnCapability,
+  resolveMessageActionTurnCapabilityLifetime,
+} from "../../../gateway/message-action-turn-capability.js";
+import type { RunEmbeddedAgentParams } from "./params.js";
+
+/** A new admitted task owns a new token; the authenticated parent token is never reused. */
+export function createDelegatedMessageActionTurnCapability(
+  params: Pick<
+    RunEmbeddedAgentParams,
+    | "agentId"
+    | "runId"
+    | "sessionKey"
+    | "sessionId"
+    | "timeoutMs"
+    | "messageActionTurnCapability"
+    | "messageActionDelegation"
+  >,
+): string | undefined {
+  const delegated = params.messageActionDelegation;
+  if (params.messageActionTurnCapability || !delegated) {
+    return undefined;
+  }
+  if (!params.agentId || !params.sessionKey) {
+    throw new Error("Message action delegation requires the admitted task identity");
+  }
+  delegated.assertCurrent();
+  const source = copyMessageActionDelegationSource(delegated.source);
+  return mintMessageActionTurnCapability({
+    agentId: params.agentId,
+    runId: params.runId,
+    sessionKey: params.sessionKey,
+    sessionId: params.sessionId,
+    sourceReplySessionKey: source.sourceRequest.sessionKey,
+    sourceProgressRequest: source.sourceRequest,
+    requesterAccountId: source.requesterAccountId,
+    requesterSenderId: source.requesterSenderId,
+    // SAFETY: The captured native source has validated threading fields; providers recheck targets and permissions.
+    toolContext: source.toolContext as InternalChannelThreadingToolContext,
+    delegatedSource: source,
+    assertDelegationCurrent: delegated.assertCurrent,
+    ...resolveMessageActionTurnCapabilityLifetime(params.timeoutMs),
+  });
+}

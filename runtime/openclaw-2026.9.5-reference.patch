+
+    @Test func `eligible discovery keeps prompt rows and single use entry unchanged`() async throws {
+        let harness = try Harness()
+        harness.discoveryDiagnostics.axReadFailureCount = 1
+        let result = try await harness.call(.init(action: .credentialPrompts))
+        let rows = try #require(result.details?["credentialPrompts"]?.value as? [[String: String]])
+        let row = try #require(rows.first)

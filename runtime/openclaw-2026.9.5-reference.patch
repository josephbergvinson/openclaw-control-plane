new file mode 100644
index 0000000000000000000000000000000000000000..dca79611e957fd32365806391c7f17a127836f1e
--- /dev/null
+++ b/src/gateway/scheduled-run-gateway-context.test.ts
@@ -0,0 +1,111 @@
+import path from "node:path";
+import { afterEach, describe, expect, it } from "vitest";
+import { useAutoCleanupTempDirTracker } from "../../test/helpers/temp-dir.js";
+import { createEmbeddedAttemptTranscriptLifecycle } from "../agents/embedded-agent-runner/run/attempt-transcript-lifecycle.js";
+import { loadTranscriptEvents, replaceSessionEntry } from "../config/sessions/session-accessor.js";
+import { readTranscriptEventMessage } from "../config/sessions/session-accessor.sqlite-read.js";
+import {
+  runWithOwnedSessionTranscriptWrite,
+  withOwnedSessionTranscriptWrites,
+} from "../config/sessions/transcript-write-context.js";
+import { getPluginRuntimeGatewayRequestScope } from "../plugins/runtime/gateway-request-scope.js";
+import { commitBackgroundResultToSession } from "../sessions/background-session-result.js";
+import { closeOpenClawAgentDatabasesForTest } from "../state/openclaw-agent-db.js";
+import { runWithScheduledGatewayContext } from "./scheduled-run-gateway-context.js";
+
+describe("scheduler-owned transcript context", () => {
+  const tempDirs = useAutoCleanupTempDirTracker((cleanup) =>
+    afterEach(() => {
+      closeOpenClawAgentDatabasesForTest();
+      cleanup();
+    }),
+  );
+
+  it.each([true, false])(
+    "commits a timed completion once after its creating attempt retires (resolver=%s)",
+    async (hasResolver) => {
+      const storePath = path.join(
+        tempDirs.make("openclaw-scheduled-transcript-"),
+        "agents",
+        "main",
+        "sessions",
+        "sessions.json",
+      );
+      const target = {
+        agentId: "main",
+        sessionKey: "agent:main:discord:channel:reminder-fixture",
+        sessionId: "reminder-conversation",
+        storePath,
+      };
+      const generation = { sessionId: target.sessionId, lifecycleRevision: "source-revision" };
+      await replaceSessionEntry(target, { ...generation, updatedAt: 1 });
+      const lifecycle = createEmbeddedAttemptTranscriptLifecycle({
+        runId: "reminder-creating-attempt",
+        sessionId: target.sessionId,
+      });
+      const resolveGatewayContext = hasResolver ? () => undefined : undefined;
+      const completion = {
+        agentId: target.agentId,
+        sessionKey: target.sessionKey,
+        expectedGeneration: generation,
+        text: "Reminder: time to leave for your appointment.",
+        idempotencyKey: "cron-current-completion:cron:reminder-fixture:1000",
+        provenance: {
+          kind: "cron" as const,
+          jobId: "reminder-fixture",
+          runId: "cron:reminder-fixture:1000",
+        },
+        config: { session: { store: storePath } },
+      };
+      await withOwnedSessionTranscriptWrites(
+        {
+          sessionTarget: target,
+          withTranscriptWrite: (write) => lifecycle.withTranscriptWrite(write),
+        },
+        async () => {
+          // Real timers retain the creating attempt's AsyncLocalStorage; fake timers do not.
+          let releaseTimer!: () => void;
+          const ready = new Promise<void>((resolve) => {
+            releaseTimer = resolve;
+          });
+          const fired = new Promise<void>((resolve, reject) => {
+            setTimeout(() => {
+              void ready
+                .then(() =>
+                  runWithScheduledGatewayContext({
+                    resolveGatewayContext,
+                    run: async () => {
+                      expect(getPluginRuntimeGatewayRequestScope()?.resolveGatewayContext).toBe(
+                        resolveGatewayContext,
+                      );
+                      const first = await commitBackgroundResultToSession(completion);
+                      expect(first.ok).toBe(true);
+                      expect(await commitBackgroundResultToSession(completion)).toEqual(first);
+                    },
+                  }),
+                )
+                .then(resolve, reject);
+            }, 0);
+          });
+          await lifecycle.dispose();
+          releaseTimer();
+          await fired;
+          // Detaching scheduled work must not reopen the caller's retired writer.
+          await expect(
+            runWithOwnedSessionTranscriptWrite({ sessionTarget: target }, () => undefined),
+          ).rejects.toThrow("attempt disposed before transcript write");
+        },
+      );
+      const messages = (await loadTranscriptEvents(target))
+        .map(readTranscriptEventMessage)
+        .filter((message) => message?.role === "assistant");
+      expect(messages).toEqual([
+        expect.objectContaining({
+          idempotencyKey: completion.idempotencyKey,
+          openclawAutomation: completion.provenance,
+          content: [{ type: "text", text: completion.text }],
+        }),
+      ]);
+    },
+  );
+});

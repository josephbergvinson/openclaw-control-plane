@@ -0,0 +1,614 @@
+import path from "node:path";
+import { afterEach, expect, it, vi } from "vitest";
+import { subagentRuns } from "../../agents/subagents/registry/subagent-registry-memory.js";
+import { settleRequesterTurnAfterSessionSpawns } from "../../agents/subagents/registry/subagent-registry-requester-yield.js";
+import {
+  saveSubagentRegistryToSqlite,
+  loadSubagentRegistryFromSqlite,
+} from "../../agents/subagents/registry/subagent-registry.store.sqlite.js";
+import {
+  addSubagentRunForTests,
+  getSubagentRunByRunId,
+  resetSubagentRegistryForTests,
+  reconcileRequesterSettleFinal,
+  resumeSubagentRun,
+  testing,
+} from "../../agents/subagents/registry/subagent-registry.test-helpers.js";
+import { createSubagentsTool } from "../../agents/tools/subagents-tool.js";
+import { mergeRestartRecoveryTerminalDeliveryEvidence } from "../../config/sessions/restart-recovery-state.js";
+import { loadSessionEntry, replaceSessionEntry } from "../../config/sessions/session-accessor.js";
+import {
+  claimAgentRunContext,
+  releaseAgentRunContext,
+  clearAgentRunContext,
+} from "../../infra/agent-run-registry.js";
+import { settlePendingFinalDelivery } from "../../infra/outbound/delivery-completion.js";
+import { installDeliveryQueueTmpDirHooks } from "../../infra/outbound/delivery-queue.test-helpers.js";
+import { createSubagentTaskBackingDetail } from "../../tasks/task-backing-records.js";
+import { getTaskById, resetTaskRegistryForTests } from "../../tasks/task-registry-query.js";
+import { configureTaskRegistryRuntime } from "../../tasks/task-registry.store.js";
+import type { TaskRecord } from "../../tasks/task-registry.types.js";
+import { createInMemoryTaskRegistryStore } from "../../test-utils/task-registry-store.js";
+import { getReplyPayloadMetadata } from "../reply-payload.js";
+import { completeReplyAgentRun } from "./agent-runner-result-complete.js";
+import {
+  createMockFollowupRun,
+  createMockReplyOperation,
+  createMockTypingController,
+} from "./test-helpers.js";
+import { createTypingSignaler } from "./typing-mode.js";
+
+vi.mock("./agent-runner-result-diagnostics.js", () => ({
+  buildReplyDiagnosticsPayload: () => undefined,
+}));
+vi.mock("./agent-runner-maintenance.js", () => ({
+  scheduleReplyBrowserCleanup: () => undefined,
+  scheduleReplySessionMaintenance: () => undefined,
+}));
+
+const fixtures = installDeliveryQueueTmpDirHooks();
+let runClaim: string | undefined;
+let secondRunClaim: string | undefined;
+afterEach(() => {
+  resetSubagentRegistryForTests({ persist: false });
+  testing.setDepsForTest();
+  resetTaskRegistryForTests();
+  vi.unstubAllEnvs();
+  releaseAgentRunContext("later-steering-turn", runClaim);
+  clearAgentRunContext("later-steering-turn");
+  releaseAgentRunContext("second-steering-turn", secondRunClaim);
+  clearAgentRunContext("second-steering-turn");
+  secondRunClaim = undefined;
+});
+
+it.each([
+  "complete",
+  "unrelated final",
+  "read only",
+  "NO_REPLY",
+  "partial",
+  "unidentified sibling",
+  "wrong route",
+  "replacement requester",
+  "new batch generation",
+  "new child generation",
+  "new task generation",
+  "changed result",
+  "crash after receipt",
+  "task projection failure",
+  "later accounting",
+  "later wait before receipt replay",
+  "failed replay before later wait",
+  "failed startup replay",
+  "multipart complete",
+  "steered native generation",
+  "partial cohort",
+  "closed source owner",
+  "wrong requester agent",
+  "wrong lifecycle",
+  "delete cleanup",
+  "delete cleanup task projection failure",
+  "delete cleanup registry failure",
+  "delete cleanup crash after registry commit",
+] as const)(
+  "credits only an exact completed wait and acknowledged ordinary final: %s",
+  async (scenario) => {
+    const stateDir = fixtures.tmpDir();
+    vi.stubEnv("OPENCLAW_STATE_DIR", stateDir);
+    const sessionKey = "agent:main:discord:channel:test-thread";
+    const sessionId = "requester-session";
+    const storePath = path.join(stateDir, "agents/main/sessions/sessions.json");
+    const task: TaskRecord = {
+      taskId: "retained-child-task",
+      runId: "child-run",
+      runtime: "subagent",
+      ownerKey: sessionKey,
+      requesterSessionKey: sessionKey,
+      requesterAgentId: "main",
+      childSessionKey: "agent:main:subagent:retained-child",
+      scopeKind: "session",
+      task: "Compare the proposals",
+      status: "succeeded",
+      deliveryStatus: "pending",
+      notifyPolicy: "done_only",
+      createdAt: 1000,
+      endedAt: 2000,
+      progressSummary: "Proposal B meets both requirements.",
+      detail: createSubagentTaskBackingDetail(1),
+    };
+    const tasks = new Map([[task.taskId, task]]);
+    const taskStore = createInMemoryTaskRegistryStore({ tasks, deliveryStates: new Map() });
+    configureTaskRegistryRuntime({ store: taskStore });
+    testing.setDepsForTest({
+      persistSubagentRunsToDisk: () => undefined,
+      persistSubagentRunsToDiskOrThrow: () => undefined,
+      restoreSubagentRunsFromDisk: () => 0,
+      getRuntimeConfig: () => ({}),
+    });
+    addSubagentRunForTests({
+      runId: task.runId!,
+      taskRunId: task.runId,
+      generation: 1,
+      createdAt: task.createdAt,
+      childSessionKey: task.childSessionKey!,
+      requesterSessionKey: sessionKey,
+      requesterAgentId: "main",
+      requesterTurnRunId: "original-yielded-turn",
+      requesterTurnYielded: true,
+      completionRequesterSessionId: sessionId,
+      expectsCompletionMessage: true,
+      execution: { status: "terminal", endedAt: 2000, outcome: { status: "ok" } },
+      completion: { required: true, resultText: task.progressSummary, capturedAt: 2000 },
+      delivery: { status: "pending" },
+      ...(scenario.startsWith("delete cleanup")
+        ? { retireAfterRequesterTurn: true, cleanupCompletedAt: 2000 }
+        : {}),
+    });
+    if (scenario === "steered native generation") {
+      subagentRuns.get(task.runId!)!.generation = 2;
+    }
+    if (scenario === "partial cohort") {
+      const sibling = structuredClone(subagentRuns.get(task.runId!)!);
+      sibling.runId = "sibling-child-run";
+      sibling.taskRunId = sibling.runId;
+      sibling.childSessionKey = "agent:main:subagent:sibling-child";
+      const siblingTask = {
+        ...task,
+        taskId: "sibling-child-task",
+        runId: sibling.runId,
+        childSessionKey: sibling.childSessionKey,
+      };
+      taskStore.upsertTaskWithDeliveryState({ task: siblingTask });
+      addSubagentRunForTests(sibling);
+      resetTaskRegistryForTests();
+      configureTaskRegistryRuntime({ store: taskStore });
+    }
+    // Freeze the batch through its native yield owner, which retires the spawning turn identity.
+    expect(
+      settleRequesterTurnAfterSessionSpawns({
+        requesterSessionKey: sessionKey,
+        requesterAgentId: "main",
+        requesterTurnRunId: "original-yielded-turn",
+        requesterYielded: true,
+        acceptedSessionSpawns: [...subagentRuns.values()].map((entry) => ({
+          runId: entry.taskRunId ?? entry.runId,
+          childSessionKey: entry.childSessionKey,
+          expectsCompletionMessage: true,
+        })),
+        runs: subagentRuns,
+        persistOrThrow: () => undefined,
+        schedule: () => undefined,
+      }),
+    ).toBe(true);
+    expect(subagentRuns.get(task.runId!)!.requesterTurnRunId).toBeUndefined();
+    expect(subagentRuns.get(task.runId!)!.requesterSettleWake?.rearmGeneration).toBe(1);
+    if (scenario.startsWith("delete cleanup")) {
+      expect(subagentRuns.get(task.runId!)!.requesterSettleWake?.retireAfterSettle).toBe(true);
+      testing.setDepsForTest({
+        persistSubagentRunsToDiskOrThrow: () => saveSubagentRegistryToSqlite(subagentRuns),
+      });
+    }
+    const session = {
+      sessionId,
+      lifecycleRevision: "requester-revision",
+      updatedAt: 2000,
+      status: "done" as const,
+    };
+    await replaceSessionEntry({ sessionKey, storePath }, session);
+    runClaim = claimAgentRunContext(
+      "later-steering-turn",
+      { sessionKey, sessionId, agentId: "main" },
+      { trackOwner: true, ownsContext: true },
+    );
+    if (scenario === "closed source owner") {
+      releaseAgentRunContext("later-steering-turn", runClaim);
+    }
+    const toolOptions = {
+      agentSessionKey: sessionKey,
+      agentId: "main",
+      config: {},
+      runId: "later-steering-turn",
+      sessionId,
+      storePath,
+    };
+    const waited = await createSubagentsTool(toolOptions).execute("read-child", {
+      action: "wait",
+      taskIds: [task.taskId],
+      timeoutSeconds: 0,
+    });
+    expect(waited.details).toMatchObject({ reason: "completed", completed: [task.taskId] });
+    expect(getTaskById(task.taskId)?.deliveryStatus).toBe("pending");
+
+    // Exercise normal final preparation, then the real identified outbound receipt owner.
+    const sourceRunId = scenario === "unrelated final" ? "unrelated-turn" : "later-steering-turn";
+    const model = { provider: "synthetic", model: "synthetic" };
+    const runResult = {
+      payloads: [],
+      meta: { durationMs: 1, finalAssistantVisibleText: task.progressSummary },
+    };
+    const followupRun = createMockFollowupRun({
+      originatingChannel: "discord",
+      originatingTo: "channel:test-thread",
+      run: {
+        sessionKey,
+        sessionId,
+        agentId: "main",
+        agentDir: stateDir,
+        workspaceDir: stateDir,
+        config: {},
+        messageProvider: "discord",
+        ...model,
+      },
+    });
+    // Supply the real finalizer contract while keeping unrelated accounting/diagnostics inert.
+    const input: Parameters<typeof completeReplyAgentRun>[0] = {
+      context: {
+        cfg: {},
+        execution: {
+          kind: "settled",
+          status: "ok",
+          result: runResult,
+          resolved: model,
+          fallback: { exhausted: false, attempts: [] },
+          autoCompactionCount: 0,
+          didLogHeartbeatStrip: false,
+        },
+        runId: sourceRunId,
+        runStartedAt: 2000,
+        sessionKey,
+        storePath,
+        activeIsNewSession: false,
+        activeSessionEntry: session,
+        activeSessionStore: { [sessionKey]: session },
+        blockReplyPipeline: null,
+        blockStreamingEnabled: false,
+        commandBody: task.task,
+        defaultModel: model.model,
+        isHeartbeat: false,
+        followupRun,
+        pendingToolTasks: new Set(),
+        preflightCompactionApplied: false,
+        queueKey: sessionKey,
+        replyMediaContext: { normalizePayload: async (payload) => payload },
+        replyOperation: createMockReplyOperation({ key: sessionKey, sessionId }).replyOperation,
+        replyRouteThreadId: undefined,
+        replyToChannel: undefined,
+        replyToMode: "off",
+        resolvedBlockStreamingBreak: "message_end",
+        resolvedQueue: { mode: "followup" },
+        resolvedVerboseLevel: "off",
+        runFollowupTurn: async () => {},
+        shouldInjectGroupIntro: false,
+        typingSignals: createTypingSignaler({
+          typing: createMockTypingController(),
+          mode: "never",
+          isHeartbeat: false,
+        }),
+        sessionCtx: {
+          Provider: "discord",
+          Surface: "discord",
+          OriginatingChannel: "discord",
+          OriginatingTo: "channel:test-thread",
+          SessionKey: sessionKey,
+        },
+        returnWithQueuedFollowupDrain: <T>(value: T) => value,
+      },
+      accounting: {
+        activeSessionEntry: session,
+        autoCompactionCount: 0,
+        compactionCount: undefined,
+        expectedSession: { sessionId, lifecycleRevision: session.lifecycleRevision },
+        configuredFallbackModel: { ...model, persistedAutoFallback: false },
+        contextTokensUsed: 1000,
+        didLogHeartbeatStrip: false,
+        directlySentBlockKeys: undefined,
+        directBlockDeliveries: undefined,
+        fallbackAttempts: [],
+        fallbackExhausted: false,
+        fallbackTransition: {
+          selectedModelRef: "synthetic/synthetic",
+          activeModelRef: "synthetic/synthetic",
+          fallbackActive: false,
+          fallbackTransitioned: false,
+          fallbackCleared: false,
+          reasonSummary: "",
+          attemptSummaries: [],
+          previousState: {},
+          nextState: {},
+          stateChanged: false,
+        },
+        modelUsed: model.model,
+        payloadArray: [],
+        preserveUserFacingSessionState: false,
+        promptTokens: undefined,
+        providerUsed: model.provider,
+        replyUsageState: {},
+        runId: sourceRunId,
+        runResult,
+        selectedModel: model.model,
+        selectedProvider: model.provider,
+        sessionModel: model,
+        terminalFailurePayload: undefined,
+        usage: undefined,
+        verboseEnabled: false,
+      },
+      prepared: {
+        kind: "continue",
+        activeSessionEntry: session,
+        completedSourceReplyDelivery: false,
+        guardedReplyPayloads:
+          scenario === "NO_REPLY"
+            ? []
+            : [
+                { text: task.progressSummary },
+                ...(["partial", "unidentified sibling", "multipart complete"].includes(scenario)
+                  ? [{ text: "Both requirements were verified." }]
+                  : []),
+              ],
+        responseUsageLine: undefined,
+      },
+    };
+    const final = await completeReplyAgentRun(input);
+    if (scenario === "NO_REPLY") {
+      expect(final).toEqual([]);
+      expect(getTaskById(task.taskId)?.deliveryStatus).toBe("pending");
+      return;
+    }
+    const payloads = Array.isArray(final) ? final : [final];
+    const metadata = getReplyPayloadMetadata(payloads[0]!);
+    const completion = metadata?.pendingFinalDeliveryCompletion;
+    expect(completion).toBeDefined();
+    const child = subagentRuns.get(task.runId!)!;
+    if (scenario === "new batch generation") {
+      child.requesterSettleWake!.rearmGeneration = 2;
+    }
+    if (scenario === "new child generation") {
+      child.generation = 2;
+    }
+    if (scenario === "new task generation") {
+      taskStore.upsertTaskWithDeliveryState({
+        task: { ...task, detail: createSubagentTaskBackingDetail(2) },
+      });
+      resetTaskRegistryForTests();
+      configureTaskRegistryRuntime({ store: taskStore });
+    }
+    if (scenario === "changed result") {
+      child.completion!.resultText = "A newer result not read by that turn.";
+    }
+    if (scenario === "wrong requester agent") {
+      child.requesterAgentId = "another-agent";
+    }

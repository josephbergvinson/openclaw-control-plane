+/** Preserve oversized MCP output at the admitted producer before the transcript cap. */
+async function preserveMcpToolOutput(
+  result: AgentToolResult<unknown>,
+  options: {
+    workspaceDir: string;
+    maxChars: number;
+    loggingConfig?: OpenClawConfig["logging"];
+    assertCurrent?: () => void;
+    signal?: AbortSignal;
+  },
+): Promise<AgentToolResult<unknown>> {
+  const textChars = result.content.reduce(
+    (total, block) => total + (block.type === "text" ? estimateToolResultTextChars(block.text) : 0),
+    0,
+  );
+  if (textChars <= options.maxChars) {
+    return result;
+  }
+  const [
+    { isAbsolute, relative },
+    { removePathWithinRoot },
+    { writePrivateTempFile },
+    { formatFullOutputFooter },
+    { truncateToolResultMessage },
+    { formatContextLimitTruncationNotice },
+    { redactToolPayloadTextWithConfig },
+    { wrapExternalContent },
+  ] = await Promise.all([
+    import("node:path"),
+    import("../infra/fs-safe-remove.js"),
+    import("./sessions/tools/private-temp-file.js"),
+    import("./sessions/tools/tool-contracts.js"),
+    import("./embedded-agent-runner/tool-result-truncation.js"),
+    import("./embedded-agent-runner/context-truncation-notice.js"),
+    import("../logging/redact.js"),
+    import("../security/external-content.js"),
+  ]);
+  if (!options.workspaceDir || !isAbsolute(options.workspaceDir)) {
+    throw new Error("Oversized MCP output requires the admitted absolute workspace.");
+  }
+  const assertCurrent = () => {
+    options.signal?.throwIfAborted();
+    options.assertCurrent?.();
+  };
+  assertCurrent();
+  // This snapshot contains server output, never runtime credentials or requester configuration.
+  const value = toToolSearchJsonSafe(
+    mcpCodeModeGuestResults.get(result) ?? { content: result.content },
+  );
+  if (isRecord(value)) {
+    delete value._meta;
+  }
+  const json = redactToolPayloadTextWithConfig(
+    // Scrub decoded strings before escaping JSON text mirrors into the envelope.
+    JSON.stringify(
+      value,
+      (_key, child: unknown) =>
+        typeof child === "string"
+          ? redactToolPayloadTextWithConfig(child, options.loggingConfig)
+          : child,
+      2,
+    ),
+    options.loggingConfig,
+  );
+  const content = wrapExternalContent(json, { source: "api" });
+  let outputPath: string | undefined;
+  try {
+    outputPath = await writePrivateTempFile("openclaw-mcp-output", content, options.workspaceDir);
+    assertCurrent();
+    const footer = `${formatFullOutputFooter(outputPath)}\nRead with offset/limit or cursor to continue. This is the received MCP snapshot; source coverage limits still apply.`;
+    const remainingChars = options.maxChars - estimateToolResultTextChars(footer);
+    if (remainingChars < 1) {
+      throw new Error("The MCP output reference exceeds the prepared tool-result budget.");
+    }
+    const message = {
+      ...result,
+      role: "toolResult" as const,
+      toolCallId: "mcp-output",
+      toolName: "mcp-output",
+      isError: isToolResultError(result),
+      timestamp: 0,
+    };
+    const bounded = truncateToolResultMessage(message, remainingChars, {
+      suffix: (chars) => formatContextLimitTruncationNotice(chars),
+      minKeepChars: 2_000,
+    }) as typeof message; // SAFETY: The truncator preserves metadata/block types, changing only text.
+    const preserved: AgentToolResult<unknown> = {
+      ...result,
+      content: [...bounded.content, { type: "text", text: footer }],
+      details: {
+        ...(isRecord(result.details) ? result.details : {}),
+        fullOutputPath: outputPath,
+        spilledChars: content.length,
+        spillTruncated: false,
+      },
+    };

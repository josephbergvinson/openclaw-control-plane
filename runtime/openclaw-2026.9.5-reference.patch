index 0000000000000000000000000000000000000000..ac823cafd0fbea72396cddefb14c2363ae4a9a88
--- /dev/null
+++ b/src/agents/agent-tools.subagent-session-status.test.ts
@@ -0,0 +1,201 @@
+// Registered child status keeps normal session visibility and tool-policy boundaries.
+import path from "node:path";
+import { expectDefined, isRecord } from "@openclaw/normalization-core";
+import { describe, expect, it, vi } from "vitest";
+import "./test-helpers/fast-bash-tools.js";
+import "./test-helpers/fast-coding-tools.js";
+import "./test-helpers/fast-openclaw-tools.js";
+import { replaceSessionEntry } from "../config/sessions/session-accessor.js";
+import type { OpenClawConfig } from "../config/types.openclaw.js";
+import { withOpenClawTestState } from "../test-utils/openclaw-test-state.js";
+import { createOpenClawCodingTools } from "./agent-tools.js";
+import { createOpenClawTools } from "./openclaw-tools.js";
+import { createStubTool } from "./test-helpers/agent-tool-stubs.js";
+import {
+  createToolSearchCatalogRef,
+  createToolSearchTools,
+  registerHeadlessToolSearchCatalog,
+  TOOL_CALL_RAW_TOOL_NAME,
+  TOOL_SEARCH_RAW_TOOL_NAME,
+} from "./tool-search.js";
+import { createSessionStatusTool } from "./tools/session-status-tool.js";
+
+const buildStatusText = vi.hoisted(() => vi.fn(async () => "Synthetic child runtime status"));
+vi.mock("../status/status-text.js", () => ({ buildStatusText }));
+vi.mock("./prepared-model-catalog.js", () => ({
+  loadPublishedPreparedModelCatalog: async () => [],
+}));
+
+async function withRegisteredChildStatus(
+  options: { maxSpawnDepth?: number; deny?: string[]; visibility?: "self" | "agent" },
+  run: (fixture: {
+    childKey: string;
+    parentKey: string;
+    tools: ReturnType<typeof createOpenClawCodingTools>;
+    controls: ReturnType<typeof createToolSearchTools>;
+    catalogRef: ReturnType<typeof createToolSearchCatalogRef>;
+  }) => Promise<void>,
+) {
+  await withOpenClawTestState({ prefix: "registered-child-status-" }, async (state) => {
+    const childKey = "agent:main:subagent:status-child";
+    const parentKey = "agent:main:main";
+    const store = path.join(state.sessionsDir("main"), "sessions.json");
+    const config: OpenClawConfig = {
+      session: { store },
+      agents: {
+        defaults: {
+          workspace: state.workspaceDir,
+          model: { primary: "openai/gpt-5.4" },
+          subagents: { maxSpawnDepth: options.maxSpawnDepth ?? 2 },
+        },
+      },
+      tools: {
+        sessions: { visibility: options.visibility ?? "self" },
+        subagents: { tools: { deny: options.deny } },
+        toolSearch: { enabled: true, mode: "tools" },
+      },
+    };
+    await replaceSessionEntry(
+      { agentId: "main", sessionKey: childKey, storePath: store },
+      { sessionId: "status-child", updatedAt: 20, spawnDepth: 1, spawnedBy: parentKey },
+    );
+    await replaceSessionEntry(
+      { agentId: "main", sessionKey: parentKey, storePath: store },
+      { sessionId: "status-parent", updatedAt: 10 },
+    );
+    // Only sibling materialization is stubbed; policy, catalog and status execution stay native.
+    vi.mocked(createOpenClawTools).mockImplementationOnce((nativeOptions) => [
+      createSessionStatusTool({
+        agentSessionKey: nativeOptions?.agentSessionKey,
+        runSessionKey: nativeOptions?.runSessionKey,
+        config: nativeOptions?.config,
+        sandboxed: nativeOptions?.sandboxed,
+      }),
+      ...["gateway", "agents_list", "message", "sessions_send"].map(createStubTool),
+    ]);
+    buildStatusText.mockClear();
+    const tools = createOpenClawCodingTools({
+      config,
+      sessionKey: childKey,
+      runSessionKey: childKey,
+      workspaceDir: state.workspaceDir,
+      agentDir: state.agentDir("main"),
+      wrapBeforeToolCallHook: false,
+    });
+    const catalogRef = createToolSearchCatalogRef();
+    registerHeadlessToolSearchCatalog({ catalogRef, tools });
+    const controls = createToolSearchTools({ catalogRef, config });
+    await run({ childKey, parentKey, tools, controls, catalogRef });
+  });
+}
+
+describe("registered subagent session_status", () => {
+  it.each([1, 2])("discovers and executes own status at spawn cap %i", async (maxSpawnDepth) => {
+    await withRegisteredChildStatus({ maxSpawnDepth }, async ({ childKey, tools, controls }) => {
+      const search = expectDefined(
+        controls.find((tool) => tool.name === TOOL_SEARCH_RAW_TOOL_NAME),
+        "native tool_search",
+      );
+      const found = await search.execute("find-child-status", {
+        query: "session_status",
+        limit: 1,
+      });
+      expect(found.details).toMatchObject([
+        { id: "openclaw:core:session_status", name: "session_status" },
+      ]);
+      const candidate: unknown = Array.isArray(found.details) ? found.details[0] : undefined;
+      if (!isRecord(candidate) || typeof candidate.id !== "string") {
+        throw new Error("Expected discovered child status ID");
+      }
+      const call = expectDefined(
+        controls.find((tool) => tool.name === TOOL_CALL_RAW_TOOL_NAME),
+        "native tool_call",
+      );
+      const result = await call.execute("inspect-child-status", {
+        id: candidate.id,
+        args: { sessionKey: "current" },
+      });
+      expect(result.details).toMatchObject({
+        tool: { id: candidate.id, name: "session_status" },
+        result: {
+          details: { ok: true, sessionKey: childKey, agentId: "main", changedModel: false },
+        },
+      });
+      expect(buildStatusText).toHaveBeenCalledOnce();
+      expect(buildStatusText).toHaveBeenCalledWith(
+        expect.objectContaining({
+          sessionKey: childKey,
+          sessionEntry: expect.objectContaining({ sessionId: "status-child" }),
+        }),
+      );
+      const names = tools.map((tool) => tool.name);
+      expect(names).toContain("message");
+      for (const denied of ["gateway", "agents_list", "sessions_send"]) {
+        expect(names).not.toContain(denied);
+      }
+    });
+  });
+
+  it("retains an explicit child status deny", async () => {
+    await withRegisteredChildStatus(
+      { deny: ["session_status"] },
+      async ({ tools, controls, catalogRef }) => {
+        expect(tools.map((tool) => tool.name)).not.toContain("session_status");
+        const catalog = expectDefined(catalogRef.current, "native child status catalog");
+        expect(catalog.entries.map((entry) => entry.name)).not.toContain("session_status");
+        expect(catalog.entries.map((entry) => entry.id)).not.toContain(
+          "openclaw:core:session_status",
+        );
+        const search = expectDefined(
+          controls.find((tool) => tool.name === TOOL_SEARCH_RAW_TOOL_NAME),
+          "native tool_search",
+        );
+        const found = await search.execute("find-denied-status", {
+          query: "session_status",
+          limit: 1,
+        });
+        expect(found.details).toEqual(expect.any(Array));
+        expect(found.details).not.toContainEqual(
+          expect.objectContaining({ name: "session_status" }),
+        );
+        expect(found.details).not.toContainEqual(
+          expect.objectContaining({ id: "openclaw:core:session_status" }),
+        );
+        const call = expectDefined(
+          controls.find((tool) => tool.name === TOOL_CALL_RAW_TOOL_NAME),
+          "native tool_call",
+        );
+        await expect(
+          call.execute("call-denied-status", {
+            id: "openclaw:core:session_status",
+            args: { sessionKey: "current" },
+          }),
+        ).rejects.toThrow("Unknown tool id: openclaw:core:session_status");
+        expect(buildStatusText).not.toHaveBeenCalled();
+      },
+    );
+  });
+
+  it.each(["self", "agent"] as const)(
+    "preserves %s visibility for a parent target",
+    async (visibility) => {
+      await withRegisteredChildStatus({ visibility }, async ({ parentKey, tools }) => {
+        const status = expectDefined(
+          tools.find((tool) => tool.name === "session_status"),
+          "registered status",
+        );
+        const operation = status.execute("inspect-parent-status", { sessionKey: parentKey });
+        if (visibility === "self") {
+          await expect(operation).rejects.toThrow("restricted to the current session");
+          expect(buildStatusText).not.toHaveBeenCalled();
+        } else {
+          expect((await operation).details).toMatchObject({
+            ok: true,
+            sessionKey: parentKey,
+            changedModel: false,
+          });
+        }
+      });
+    },
+  );
+});

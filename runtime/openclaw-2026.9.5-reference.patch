+async function snapshot(auth: object, mode = "local") {
+  await fs.writeFile(path.join(root, "openclaw.json"), JSON.stringify({ gateway: { mode, auth } }));
+  return readConfigFileSnapshot();
+}
+
+function store(value: string) {
+  writeSecretStoreEntry({
+    scope: { kind: "team" },
+    name: ref.id,
+    value,
+    kind: "secret",
+    updatedBy: "native-auth-test",
+  });
+}
+
+describe("private native local Gateway auth", () => {
+  it("reads the existing store owner and observes rotation on the next resolution", async () => {
+    const auth = { mode: "token", token: ref };
+    const config = await snapshot(auth);
+    store("synthetic-first-token");
+    expect(
+      await resolveLocalGatewayAuth({ version: 1, auth }, config, { OPENCLAW_STATE_DIR: root }),
+    ).toEqual({
+      token: "synthetic-first-token",
+    });
+    store("synthetic-rotated-token");
+    expect(
+      await resolveLocalGatewayAuth({ version: 1, auth }, config, { OPENCLAW_STATE_DIR: root }),
+    ).toEqual({
+      token: "synthetic-rotated-token",
+    });
+    expect(
+      JSON.parse(await fs.readFile(path.join(root, "openclaw.json"), "utf8")).gateway.auth,
+    ).toEqual(auth);
+  });
+
+  it("fails a missing selected ref without using ambient credentials or exposing its diagnostic", async () => {
+    const auth = { mode: "token", token: ref };
+    await expect(
+      resolveLocalGatewayAuth({ version: 1, auth }, await snapshot(auth), {
+        OPENCLAW_STATE_DIR: root,
+        OPENCLAW_GATEWAY_TOKEN: "unrelated-ambient-token",
+      }),
+    ).rejects.toThrow("Local Gateway credentials could not be resolved.");
+  });
+
+  it("rejects a changed auth owner and remote routing before reading credentials", async () => {
+    const auth = { mode: "token", token: ref };
+    store("synthetic-token");
+    const request = { version: 1, auth };
+    await expect(
+      resolveLocalGatewayAuth(request, await snapshot({ mode: "token", token: "changed" }), {
+        OPENCLAW_STATE_DIR: root,
+      }),
+    ).rejects.toThrow("Local Gateway credentials could not be resolved.");
+    await expect(
+      resolveLocalGatewayAuth(request, await snapshot(auth, "remote"), {
+        OPENCLAW_STATE_DIR: root,
+      }),
+    ).rejects.toThrow("Local Gateway credentials could not be resolved.");
+  });
+
+  it("honors password mode instead of a stale sibling token", async () => {
+    store("synthetic-password");
+    const auth = { mode: "password", password: ref, token: "stale-sibling" };
+    expect(
+      await resolveLocalGatewayAuth({ version: 1, auth }, await snapshot(auth), {
+        OPENCLAW_STATE_DIR: root,
+      }),
+    ).toEqual({
+      password: "synthetic-password",
+    });
+  });
+
+  it("uses the canonical environment SecretRef resolver", async () => {
+    const auth = {
+      mode: "token",
+      token: { source: "env", provider: "default", id: "NATIVE_AUTH_ENV" },
+    };
+    expect(
+      await resolveLocalGatewayAuth({ version: 1, auth }, await snapshot(auth), {
+        OPENCLAW_STATE_DIR: root,
+        NATIVE_AUTH_ENV: "synthetic-env-token",
+      }),
+    ).toEqual({ token: "synthetic-env-token" });
+  });

+import { beforeEach, expect, it, vi } from "vitest";
+import { createDeferred } from "../../test/helpers/promise.js";
+import { closeTrackedBrowserTabsForSessions } from "./browser-maintenance.js";
+
+const loader = vi.hoisted(() => vi.fn());
+vi.mock("./facade-runtime.js", () => ({
+  tryLoadActivatedBundledPluginPublicSurfaceModule: loader,
+}));
+beforeEach(() => loader.mockReset());
+
+it("rechecks completion after lazy Browser activation before invoking the plugin", async () => {
+  const activated = createDeferred<{ closeTrackedBrowserTabsForSessions: () => Promise<number> }>();
+  const close = vi.fn(async () => 1);
+  loader.mockReturnValue(activated.promise);
+  let current = true;
+  const pending = closeTrackedBrowserTabsForSessions({
+    sessionKeys: ["agent:main:main"],
+    taskCompletion: { completedAt: 10, isCurrent: () => current },
+  });
+  current = false;
+  activated.resolve({ closeTrackedBrowserTabsForSessions: close });
+  await expect(pending).resolves.toBe(0);
+  expect(close).not.toHaveBeenCalled();
+});
+
+it("forwards the private completion fence without changing lifecycle defaults", async () => {
+  const close = vi.fn(async () => 1);
+  loader.mockResolvedValue({ closeTrackedBrowserTabsForSessions: close });
+  const taskCompletion = { completedAt: 10, isCurrent: () => true };
+  await expect(
+    closeTrackedBrowserTabsForSessions({ sessionKeys: ["agent:main:main"], taskCompletion }),
+  ).resolves.toBe(1);
+  expect(close).toHaveBeenCalledWith({ sessionKeys: ["agent:main:main"], taskCompletion });
+});

+        #expect(observed.reason == .focusedWindowUnavailable)
+        #expect(observed.payload["frontmostOwnerBundleID"] as? String == "com.example.Browser")
+        #expect(observed.payload["focusedOwnerBundleID"] as? String == "com.example.Unenrolled")
+        #expect(observed.payload["focusedOwnerStatus"] as? String == "unsupported")
+        #expect(observed.payload["windowLookupSource"] as? String == "application_focused_window")
+        #expect(observed.payload["windowLookupAXResult"] as? Int == Int(AXError.noValue.rawValue))
+        #expect(observed.payload["windowLookupElementPresent"] as? Bool == false)
+    }
+
+    @Test @MainActor func `focused native window failure is distinct from no focused element and unattempted overlay`() throws {
+        let foreground = NativeCredentialEntryService.Discovery(
+            prompts: [], diagnostics: .init(reason: .focusedWindowUnavailable))
+        var overlayDiagnostics = NativeCredentialDiscoveryDiagnostics(reason: .focusedWindowUnavailable)
+        overlayDiagnostics.windowLookupSource = .focusedFieldWindow
+        overlayDiagnostics.windowLookupAXResult = AXError.noValue.rawValue
+        overlayDiagnostics.windowLookupElementPresent = false
+        let overlay = NativeCredentialEntryService.Discovery(prompts: [], diagnostics: overlayDiagnostics)
+        let selected = try NativeCredentialPromptFocus.discover(frontmost: { foreground }, focused: { overlay })
+        #expect(selected.diagnostics.payload["windowLookupSource"] as? String == "focused_field_window")
+        #expect(selected.diagnostics.payload["windowLookupElementPresent"] as? Bool == false)
+        #expect(foreground.diagnostics.payload["windowLookupSource"] == nil)
+        let prompt = NativeCredentialEntryService.Prompt(
+            bundleID: "com.apple.SecurityAgent", accountEvidence: [], validate: {}, setSecret: { _ in })
+        let eligible = NativeCredentialEntryService.Discovery(prompts: [prompt], diagnostics: .init(reason: .eligible))
+        let early = try NativeCredentialPromptFocus.discover(frontmost: { eligible }, focused: {
+            Issue.record("A qualifying frontmost prompt must not inspect another owner")
+            return overlay
+        })
+        #expect(early.prompts.count == 1)
+        #expect(early.diagnostics.payload["focusedElementStatus"] == nil)
+    }
+
+    @Test func `diagnostic process metadata rejects form text and never serializes raw role values`() throws {
+        var diagnostics = NativeCredentialDiscoveryDiagnostics(reason: .focusedWindowUnavailable)
+        diagnostics.frontmostOwnerBundleID = "private-requester title"
+        diagnostics.focusedOwnerBundleID = "fixture@example.invalid"
+        diagnostics.focusedElement = .init(elementPresent: true, role: "private-field-role", subrole: "fixture-secret")
+        let encoded = try #require(String(
+            data: JSONSerialization.data(withJSONObject: diagnostics.payload), encoding: .utf8))
+        for privateText in [
+            "private-requester title",
+            "fixture@example.invalid",
+            "private-field-role",
+            "fixture-secret",
+        ] {
+            #expect(!encoded.contains(privateText))
+        }
+        #expect(diagnostics.payload["frontmostOwnerBundleID"] == nil)
+        #expect(diagnostics.payload["focusedOwnerBundleID"] == nil)
+    }
+}
diff --git a/apps/macos/Tests/OpenClawIPCTests/NativeCredentialPromptWindowTests.swift b/apps/macos/Tests/OpenClawIPCTests/NativeCredentialPromptWindowTests.swift

@@ -0,0 +1,177 @@
+import path from "node:path";
+import { setImmediate as checkpoint } from "node:timers/promises";
+import { expect, it, vi } from "vitest";
+import { createDeferred } from "../../../../test/helpers/promise.js";
+import { SYNC_REBUILD_MAX_BYTES } from "../../../config/sessions/session-transcript-index.js";
+import { SessionTranscriptProjectionUnavailableError } from "../../../config/sessions/session-transcript-projection-error.js";
+import { waitForSessionTranscriptIndexReconcile } from "../../../config/sessions/session-transcript-reconcile.js";
+import { withOwnedSessionTranscriptWrites } from "../../../config/sessions/transcript-write-context.js";
+import { openOpenClawAgentDatabase } from "../../../state/openclaw-agent-db.js";
+import { withOpenClawTestState } from "../../../test-utils/openclaw-test-state.js";
+import type { AgentMessage } from "../../runtime/index.js";
+import { SessionManager } from "../../sessions/session-manager.js";
+import { createZeroUsageFixture } from "../../test-helpers/usage-fixtures.js";
+import { handleEmbeddedAttemptPromptError } from "./attempt-prompt-submit.js";
+import { SESSIONS_YIELD_ABORT_REASON } from "./attempt-sessions-yield.js";
+import { createEmbeddedAttemptTranscriptLifecycle } from "./attempt-transcript-lifecycle.js";
+
+type PromptErrorInput = Parameters<typeof handleEmbeddedAttemptPromptError>[0];
+
+it.each(["continue", "abort", "owner-revoked"] as const)(
+  "settles a yielded transcript projection before handoff: %s",
+  async (outcome) => {
+    await withOpenClawTestState({ label: "yield-projection" }, async (state) => {
+      const target = {
+        agentId: "main",
+        sessionId: "yield-projection",
+        sessionKey: "agent:main:yield-projection",
+        storePath: path.join(state.agentDir(), "openclaw-agent.sqlite"),
+      };
+      const manager = SessionManager.open(target, state.workspaceDir);
+      // The rewrite sizes both its old and replacement rows; cross that real
+      // threshold with two events instead of thousands of fixture appends.
+      const user: AgentMessage = {
+        role: "user",
+        content: "x".repeat(SYNC_REBUILD_MAX_BYTES / 2 + 1),
+        timestamp: 1,
+      };
+      const aborted: AgentMessage = {
+        role: "assistant",
+        content: [],
+        api: "openai-responses",
+        provider: "openai",
+        model: "test-model",
+        stopReason: "aborted",
+        timestamp: 2,
+        usage: createZeroUsageFixture(),
+      };
+      manager.appendMessage(user);
+      manager.appendMessage(aborted);
+      manager.appendCustomEntry("retained-state", { retained: true });
+      const databaseOptions = { agentId: target.agentId, path: target.storePath };
+      const openContinuation = () =>
+        SessionManager.openBounded(target, { maxBytes: SYNC_REBUILD_MAX_BYTES, maxEvents: 10 });
+      await waitForSessionTranscriptIndexReconcile(databaseOptions);
+      const database = openOpenClawAgentDatabase(databaseOptions);
+      const controller = new AbortController();
+      const lifecycle = createEmbeddedAttemptTranscriptLifecycle({
+        runId: "yield-run",
+        sessionId: target.sessionId,
+      });
+      let ownerActive = true;
+      const revoked = new Error("admitted owner revoked");
+      const withOwnedTranscriptWrite: PromptErrorInput["withOwnedTranscriptWrite"] = (operation) =>
+        withOwnedSessionTranscriptWrites(
+          {
+            sessionTarget: target,
+            assertCommitAllowed: () => {
+              controller.signal.throwIfAborted();
+              if (!ownerActive) {
+                throw revoked;
+              }
+            },
+            withTranscriptWrite: (write) => lifecycle.withTranscriptWrite(write),
+          },
+          () => lifecycle.withTranscriptWrite(operation),
+        );
+      const messages = [user, aborted];
+      // SAFETY: The prompt-error boundary uses only these session operations;
+      // persistence and admitted transcript ownership remain their real owners.
+      const activeSession = {
+        messages,
+        agent: { state: { messages } },
+        sessionManager: manager,
+        sendCustomMessage: async (message) => {
+          manager.appendCustomMessageEntry(
+            message.customType,
+            message.content,
+            message.display,
+            message.details,
+          );
+        },
+      } as PromptErrorInput["activeSession"];
+      const releaseWorker = createDeferred();
+      const scheduled = createDeferred();
+      const realSetImmediate = globalThis.setImmediate;
+      const immediateSpy = vi
+        .spyOn(globalThis, "setImmediate")
+        .mockImplementationOnce((callback) => {
+          scheduled.resolve();
+          void releaseWorker.promise.then(() => callback());
+          return realSetImmediate(() => undefined);
+        });
+      let settled = false;
+      const recovered = handleEmbeddedAttemptPromptError({
+        activeSession,
+        attempt: {
+          runId: "yield-run",
+          sessionId: target.sessionId,
+          abortSignal: controller.signal,
+        },
+        error: new Error("aborted", { cause: SESSIONS_YIELD_ABORT_REASON }),
+        handleMidTurnPrecheckRequest: () => {},
+        markYieldAborted: () => {},
+        releaseLeasedSteering: () => {},
+        withOwnedTranscriptWrite,
+        yieldAbortSettled: Promise.resolve(),
+        yieldDetected: true,
+        yieldMessage: outcome === "continue" ? "Wait for the child result." : null,
+      }).then(
+        (value) => {
+          settled = true;
+          return { value };
+        },
+        (error: unknown) => {
+          settled = true;
+          return { error };
+        },
+      );
+      try {
+        await scheduled.promise;
+        await checkpoint();
+        expect(
+          database.db
+            .prepare(
+              "SELECT needs_rebuild FROM session_transcript_index_state WHERE session_id = ?",
+            )
+            .get(target.sessionId),
+        ).toEqual({ needs_rebuild: 1 });
+        expect(openContinuation).toThrow(SessionTranscriptProjectionUnavailableError);
+        expect(settled).toBe(false);
+
+        if (outcome === "abort") {
+          controller.abort(new Error("external cancellation"));
+          expect(await recovered).toMatchObject({ error: { name: "AbortError" } });
+        } else {
+          if (outcome === "owner-revoked") {
+            ownerActive = false;
+          }
+          releaseWorker.resolve();
+          const result = await recovered;
+          if (outcome === "owner-revoked") {
+            expect(result).toEqual({ error: revoked });
+          } else {
+            expect(result).toEqual({ value: {} });
+            const continuation = openContinuation();
+            expect(continuation.buildSessionContext().messages).toEqual([
+              user,
+              expect.objectContaining({
+                role: "custom",
+                content: expect.stringContaining("Wait for the child result."),
+              }),
+            ]);
+            expect(SessionManager.open(target).getEntries()).toContainEqual(
+              expect.objectContaining({ customType: "retained-state" }),
+            );
+          }
+        }
+      } finally {
+        immediateSpy.mockRestore();
+        releaseWorker.resolve();
+        await recovered;
+        await waitForSessionTranscriptIndexReconcile(databaseOptions);
+        await lifecycle.dispose();
+      }
+    });
+  },
+);

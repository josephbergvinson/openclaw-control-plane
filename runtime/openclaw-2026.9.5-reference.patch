new file mode 100644
index 0000000000000000000000000000000000000000..03c9ef9e8db1ef647f40ac62199d7f7614be21c3
--- /dev/null
+++ b/src/agents/sessions/agent-session-checkpoint-admission.test.ts
@@ -0,0 +1,355 @@
+import {
+  createAssistantMessageEventStream,
+  type Context,
+  type Model,
+  type SimpleStreamOptions,
+} from "openclaw/plugin-sdk/llm";
+import { Type } from "typebox";
+import { describe, expect, it, vi } from "vitest";
+import { createUserTurnTranscriptRecorder } from "../../sessions/user-turn-transcript.js";
+import { createTestUserTurnTranscriptTarget } from "../../sessions/user-turn-transcript.test-support.js";
+import { createDeferredCore } from "../../shared/deferred.js";
+import { steerActiveSessionWithOptionalDeliveryWait } from "../embedded-agent-runner/run/attempt-queue-message.js";
+import {
+  createAssistant,
+  createAssistantResultStream,
+  createTestSession,
+  registerAgentSessionLoopTestLifecycle,
+  streamMocks,
+  testModel,
+} from "./agent-session-loop-correctness.test-support.js";
+
+registerAgentSessionLoopTestLifecycle();
+
+const checkpointText = "Report the concrete progress, then continue this task.";
+
+async function createToolCheckpointHarness(toolExecution: "sequential" | "parallel") {
+  const responseStarted = createDeferredCore();
+  const toolStarted = createDeferredCore();
+  const releaseTool = createDeferredCore();
+  const firstResponse = createAssistantMessageEventStream();
+  const requests: Context["messages"][] = [];
+  const providerSteer = vi.fn(async () => false);
+  streamMocks.streamSimple.mockImplementation(
+    (model: Model, context: Context, options?: SimpleStreamOptions) => {
+      requests.push([...context.messages]);
+      if (requests.length === 1) {
+        options?.onActiveResponse?.({ steer: providerSteer, needsContinuation: () => false });
+        firstResponse.push({ type: "start", partial: createAssistant(model, []) });
+        responseStarted.resolve();
+        return firstResponse;
+      }
+      if (requests.length !== 2) {
+        throw new Error("unexpected third provider request");
+      }
+      return createAssistantResultStream(
+        createAssistant(model, [{ type: "text", text: "Work complete." }]),
+      );
+    },
+  );
+  const execute = vi.fn(async (toolCallId: string) => {
+    if (toolCallId === "first") {
+      toolStarted.resolve();
+      await releaseTool.promise;
+    }
+    return { content: [{ type: "text" as const, text: `${toolCallId} completed` }], details: {} };
+  });
+  const { session, sessionManager } = await createTestSession({
+    customTools: [
+      {
+        name: "inspect",
+        label: "Inspect",
+        description: "Inspect a fixture.",
+        parameters: Type.Object({}),
+        execute,
+      },
+    ],
+  });
+  session.agent.toolExecution = toolExecution;
+  session.agent.steeringMode = "all";
+  const finishResponse = () => {
+    firstResponse.push({
+      type: "done",
+      reason: "toolUse",
+      message: createAssistant(
+        testModel,
+        [
+          { type: "toolCall", id: "first", name: "inspect", arguments: {} },
+          { type: "toolCall", id: "second", name: "inspect", arguments: {} },
+        ],
+        "toolUse",
+      ),
+    });
+    firstResponse.end();
+  };
+  return {
+    session,
+    sessionManager,
+    responseStarted,
+    toolStarted,
+    releaseTool,
+    finishResponse,
+    requests,
+    execute,
+    providerSteer,
+  };
+}
+
+function queueCheckpoint(
+  session: Awaited<ReturnType<typeof createTestSession>>["session"],
+  signal?: AbortSignal,
+) {
+  const accepted = createDeferredCore();
+  const outcome = Promise.allSettled([
+    steerActiveSessionWithOptionalDeliveryWait(session, checkpointText, {
+      isInboundUserMessage: false,
+      deliveryBoundary: "after-tool-batch",
+      queueIdentity: "live-checkpoint",
+      waitForTranscriptCommit: true,
+      abortSignal: signal,
+      onQueueAccepted: () => accepted.resolve(),
+    }),
+  ]);
+  return { accepted: accepted.promise, outcome };
+}
+
+describe("native AgentSession synthetic checkpoint admission", () => {
+  it.each([
+    ["sequential", "before-tools"],
+    ["parallel", "before-tools"],
+    ["sequential", "during-tool"],
+    ["parallel", "during-tool"],
+  ] as const)(
+    "delivers a checkpoint after %s tools without skipping work (%s)",
+    async (mode, arrival) => {
+      const h = await createToolCheckpointHarness(mode);
+      const prompt = h.session.prompt("inspect both fixtures");
+      await h.responseStarted.promise;
+      if (arrival === "during-tool") {
+        h.finishResponse();
+        await h.toolStarted.promise;
+      }
+      const checkpoint = queueCheckpoint(h.session);
+      await checkpoint.accepted;
+      const queuedUserCount = h.sessionManager
+        .getBranch()
+        .filter((entry) => entry.type === "message" && entry.message.role === "user").length;
+      if (arrival === "before-tools") {
+        h.finishResponse();
+      }
+      h.releaseTool.resolve();
+      await prompt;
+      expect(queuedUserCount).toBe(1);
+      await expect(checkpoint.outcome).resolves.toEqual([
+        { status: "fulfilled", value: undefined },
+      ]);
+      expect(h.execute.mock.calls.map(([id]) => id)).toEqual(["first", "second"]);
+      const nextRequest = h.requests[1];
+      expect(nextRequest?.filter((message) => message.role === "toolResult")).toMatchObject([
+        { toolCallId: "first", isError: false },
+        { toolCallId: "second", isError: false },
+      ]);
+      expect(nextRequest?.at(-1)).toMatchObject({
+        role: "user",
+        content: [{ type: "text", text: checkpointText }],
+      });
+      expect(
+        h.session.messages.filter(
+          (message) =>
+            message.role === "user" && JSON.stringify(message.content).includes(checkpointText),
+        ),
+      ).toHaveLength(1);
+      expect(h.session.pendingMessageCount).toBe(0);
+      expect(h.requests).toHaveLength(2);
+      expect(h.providerSteer).not.toHaveBeenCalled();
+    },
+  );
+
+  it.each(["sequential", "parallel"] as const)(
+    "still preempts %s tools for an urgent steer behind a checkpoint",
+    async (mode) => {
+      const h = await createToolCheckpointHarness(mode);
+      const prompt = h.session.prompt("inspect both fixtures");
+      await h.responseStarted.promise;
+      const checkpoint = queueCheckpoint(h.session);
+      await checkpoint.accepted;
+      await h.session.steer("Stop these inspections and change direction.");
+      h.finishResponse();
+      h.releaseTool.resolve();
+      await prompt;
+      expect(h.execute).not.toHaveBeenCalled();
+      expect(h.requests[1]?.filter((message) => message.role === "toolResult")).toMatchObject([
+        { toolCallId: "first", isError: true },
+        { toolCallId: "second", isError: true },
+      ]);
+      expect(h.requests[1]?.at(-1)).toMatchObject({
+        role: "user",
+        content: [{ type: "text", text: "Stop these inspections and change direction." }],
+      });
+      await expect(checkpoint.outcome).resolves.toEqual([
+        {
+          status: "rejected",
+          reason: expect.objectContaining({
+            message: "active session completed before task checkpoint delivery",
+          }),

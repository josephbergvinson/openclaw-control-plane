+++ b/src/agents/subagents/registry/subagent-followup-owner.ts
@@ -0,0 +1,117 @@
+import type { AcceptedSessionSpawn } from "../../accepted-session-spawn.js";
+import type { RequesterSettleWakeState, SubagentRunRecord } from "./subagent-registry.types.js";
+
+/** Transfer an existing native completion obligation to its parent's current turn. */
+export function claimSubagentFollowupOwner(params: {
+  runs: Map<string, SubagentRunRecord>;
+  persistOrThrow: (...runIds: string[]) => void;
+  runId: string;
+  taskRunId: string;
+  childSessionKey: string;
+  requesterSessionKey: string;
+  requesterAgentId: string;
+  requesterTurnRunId: string;
+  previousRunId?: string;
+  previousRequesterSettleWake?: RequesterSettleWakeState;
+}): (AcceptedSessionSpawn & { completionSpawns?: AcceptedSessionSpawn[] }) | undefined {
+  const entry = params.runs.get(params.runId);
+  if (
+    !params.requesterTurnRunId.trim() ||
+    !entry ||
+    entry.childSessionKey !== params.childSessionKey ||
+    (entry.taskRunId ?? entry.runId) !== params.taskRunId ||
+    entry.requesterSessionKey !== params.requesterSessionKey ||
+    entry.requesterAgentId !== params.requesterAgentId ||
+    (entry.controllerSessionKey ?? entry.requesterSessionKey) !== params.requesterSessionKey ||
+    entry.expectsCompletionMessage !== true ||
+    entry.collect === true ||
+    entry.killIntent ||
+    entry.killReconciliation ||
+    entry.execution.suppressSessionEffects
+  ) {
+    return undefined;
+  }
+  // A completed execution may have been replaced before this claim. Its
+  // original frozen cohort remains authoritative only for matching siblings.
+  const previousWake = entry.requesterSettleWake ?? params.previousRequesterSettleWake;
+  const previousRunId = entry.requesterSettleWake
+    ? entry.runId
+    : (params.previousRunId ?? entry.runId);
+  const batchRunIds = previousWake?.batchRunIds;
+  const cohort = [entry];
+  if (batchRunIds?.includes(previousRunId)) {
+    for (const runId of batchRunIds) {
+      const sibling = params.runs.get(runId);
+      const wake = sibling?.requesterSettleWake;
+      if (
+        !sibling ||
+        sibling === entry ||
+        sibling.requesterSessionKey !== params.requesterSessionKey ||
+        sibling.requesterAgentId !== params.requesterAgentId ||
+        (sibling.controllerSessionKey ?? sibling.requesterSessionKey) !==
+          params.requesterSessionKey ||
+        sibling.expectsCompletionMessage !== true ||
+        sibling.collect === true ||
+        sibling.killIntent ||
+        sibling.killReconciliation ||
+        sibling.execution.suppressSessionEffects ||
+        !wake ||
+        wake.rearmGeneration !== previousWake?.rearmGeneration ||
+        wake.batchRunIds?.length !== batchRunIds.length ||
+        !batchRunIds.every((id) => wake.batchRunIds?.includes(id))
+      ) {
+        continue;
+      }
+      cohort.push(sibling);
+    }
+  }
+  const previous = cohort.map((member) => ({
+    requesterTurnRunId: member.requesterTurnRunId,
+    requesterTurnYielded: member.requesterTurnYielded,
+    requesterSettleWake: member.requesterSettleWake,
+    retireAfterRequesterTurn: member.retireAfterRequesterTurn,
+  }));
+  const nextGeneration =
+    Math.max(
+      previousWake?.rearmGeneration ?? 0,
+      ...cohort.map((member) => member.requesterSettleWake?.rearmGeneration ?? 0),
+    ) + 1;
+  const nextBatchRunIds = cohort.map((member) => member.runId).toSorted();
+  // Transfer the complete still-owned cohort atomically. Otherwise an old
+  // callback rejects the replaced row and leaves its frozen siblings stranded.
+  for (const member of cohort) {
+    member.requesterTurnRunId = params.requesterTurnRunId;
+    member.requesterTurnYielded = undefined;
+    const retireAfterRequesterTurn =
+      member !== entry &&
+      (member.retireAfterRequesterTurn === true ||
+        member.requesterSettleWake?.retireAfterSettle === true);
+    // The bound parent suppresses dispatch; advancing this marker prevents a
+    // later yield from reusing an earlier callback or Gateway idempotency key.
+    member.requesterSettleWake =
+      previousWake || member.requesterSettleWake
+        ? {
+            status: "pending",
+            attemptCount: 0,
+            rearmGeneration: nextGeneration,
+            ...(cohort.length > 1 ? { batchRunIds: nextBatchRunIds } : {}),
+          }
+        : undefined;
+    member.retireAfterRequesterTurn = retireAfterRequesterTurn ? true : undefined;
+  }
+  try {
+    params.persistOrThrow(...cohort.map((member) => member.runId));
+  } catch (error) {
+    cohort.forEach((member, index) => Object.assign(member, previous[index]));
+    throw error;
+  }
+  const completionSpawns = cohort.map((member) => ({
+    runId: member.taskRunId ?? member.runId,
+    childSessionKey: member.childSessionKey,
+    expectsCompletionMessage: true,
+  }));
+  return {
+    ...completionSpawns[0]!,
+    ...(completionSpawns.length > 1 ? { completionSpawns } : {}),
+  };
+}
diff --git a/src/agents/subagents/registry/subagent-registry-cron-yield-failure.ts b/src/agents/subagents/registry/subagent-registry-cron-yield-failure.ts

+      expect(getExistingFollowupQueue(key)?.items).toEqual([current]);
+      operation.complete();
+      finishCurrent();
+      scheduleFollowupDrain(key, followup);
+      await Promise.resolve();
+      expect(followup).not.toHaveBeenCalled();
+      expect(handle.cancel).not.toHaveBeenCalled();
+      clearSessionQueues([key]);
+    });
+  });
+
+  it("preserves existing unaccepted automatic-account rotation fallback", async () => {
+    const key = "agent:main:retained-auto-account-rotation";
+    const current = createQueueTestRun({ prompt: "existing work", messageId: "current" });
+    current.run.authProfileId = "openai:admitted";
+    current.run.authProfileIdSource = "auto";
+    const followup = vi.fn(async (_run: FollowupRun) => undefined);
+    await withQuestionCreator(key, current, async (operation, fingerprint) => {
+      operation.setPhase("running");
+      const finishCurrent = holdAdoptedSource(key, current, operation, followup);
+      const a: FollowupRun = {
+        ...current,
+        prompt: "account-bound requester input",
+        messageId: "A",
+        run: { ...current.run, authProfileId: "openai:accepted" },
+      };
+      bindRetainedSource(key, a, operation, fingerprint, followup);
+      enqueueFollowupRun(key, a, { mode: "steer", debounceMs: 0 }, "message-id", followup, false);
+      let acceptedProfileId = "openai:accepted";
+      const dispatch = vi.fn();
+      const entered = createDeferred();
+      const release = createDeferred();
+      const handle = {
+        ...createEmbeddedRunHandle({
+          runId: "accepted-backing-work",
+          toolAuthorityFingerprint: fingerprint,
+        }),
+        kind: "embedded" as const,
+        cancel: vi.fn(),
+        get acceptedAutoAuthProfileId() {
+          return acceptedProfileId;
+        },
+        isSteeringCatalogCurrent: () => true,
+        messageInjectionV2: {
+          version: 2 as const,
+          isAvailable: () => true,
+          queueMessage: async (
+            _text: string,
+            _options: Parameters<
+              NonNullable<ReplyBackendHandle["messageInjectionV2"]>["queueMessage"]
+            >[1],
+            assertCurrent: () => void,
+          ) => {
+            assertCurrent();
+            entered.resolve();
+            await release.promise;
+            assertCurrent();
+            dispatch();
+          },
+        },
+      };
+      operation.attachBackend(handle);
+      setActiveEmbeddedRun(operation.sessionId, handle, key, current.run.sessionFile, "main");
+      const retry = retryRetainedFollowupSteers(operation);

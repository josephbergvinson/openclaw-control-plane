@@ -0,0 +1,290 @@
+import Darwin
+import Foundation
+import OpenClawKit
+import Testing
+@testable import OpenClaw
+@testable import OpenClawMacCLI
+
+/// No live AX, Keychain, AppDefaults, app launch, or Gateway calls.
+@MainActor
+struct NativeCredentialEntryTests {
+    @Test func `native process identity uses kernel incarnation without Launch Services metadata`() throws {
+        let identity = try NativeCredentialProcessIdentity.capture(42) { pid, info, size in
+            info.pbi_pid = UInt32(pid)
+            info.pbi_uid = 501
+            info.pbi_start_tvsec = 100
+            info.pbi_start_tvusec = 123
+            return size
+        }
+        #expect(identity.pid == 42)
+        #expect(identity.userID == 501)
+        #expect(identity.startedSeconds == 100)
+        #expect(identity.startedMicroseconds == 123)
+        for change in 0..<4 {
+            let replacement = try NativeCredentialProcessIdentity.capture(change == 0 ? 43 : 42) { pid, info, size in
+                info.pbi_pid = UInt32(pid)
+                info.pbi_uid = change == 1 ? 502 : 501
+                info.pbi_start_tvsec = change == 2 ? 101 : 100
+                info.pbi_start_tvusec = change == 3 ? 124 : 123
+                return size
+            }
+            #expect(replacement != identity)
+        }
+    }
+
+    @Test func `missing truncated or inconsistent kernel identity refuses native credential discovery`() {
+        for change in 0..<5 {
+            #expect(throws: NativeCredentialError.refused) {
+                try NativeCredentialProcessIdentity.capture(42) { pid, info, size in
+                    info.pbi_pid = change == 2 ? 43 : UInt32(pid)
+                    info.pbi_start_tvsec = change == 3 ? 0 : 100
+                    info.pbi_start_tvusec = change == 4 ? 1_000_000 : 123
+                    return change == 0 ? 0 : (change == 1 ? size - 1 : size)
+                }
+            }
+        }
+    }
+
+    @MainActor
+    private final class Harness {
+        let scope = UUID()
+        var now = Date(timeIntervalSince1970: 100)
+        var host = "11111111-1111-4111-8111-111111111111"
+        var allowed = true
+        var promptCurrent = true
+        var secretReads = 0
+        var entries: [String] = []
+        var duringResolution: (() async -> Void)?
+        var bindings: [NativeCredentialBinding]
+        lazy var service = self.makeService()
+
+        private func makeService() -> NativeCredentialEntryService {
+            NativeCredentialEntryService(environment: .init(
+                hostID: { self.host },
+                bindings: { self.bindings },
+                prompts: { [.init(
+                    bundleID: "com.apple.systempreferences",
+                    accountEvidence: ["Sign in as operator@example.invalid"],
+                    validate: { if !self.promptCurrent { throw NativeCredentialError.stalePrompt } },
+                    setSecret: { self.entries.append($0) })] },
+                withSecret: { _, consume in
+                    self.secretReads += 1
+                    await self.duringResolution?()
+                    try consume("fixture-password")
+                },
+                now: { self.now }))
+        }
+
+        init() throws {
+            self.bindings = try [NativeCredentialBinding(
+                alias: "apple.fixture.password",
+                kind: .appleAccount,
+                account: "operator@example.invalid",
+                hostID: "11111111-1111-4111-8111-111111111111",
+                bundleIDs: ["com.apple.systempreferences"])]
+        }
+
+        func call(_ params: OpenClawComputerActParams, scope: UUID? = nil, generation: UInt64 = 1) async throws
+            -> OpenClawComputerActResult
+        {
+            try await self.service.perform(params, scope: scope ?? self.scope, generation: generation) {
+                if !self.allowed { throw CancellationError() }
+            }
+        }
+
+        func observe() async throws -> String {
+            let result = try await self.call(.init(action: .credentialPrompts))
+            let rows = try #require(result.details?["credentialPrompts"]?.value as? [[String: String]])
+            return try #require(rows.first?["promptRef"])
+        }
+
+        func fill(_ ref: String, scope: UUID? = nil, generation: UInt64 = 1) async throws -> OpenClawComputerActResult {
+            try await self.call(
+                .init(action: .typeSecret, alias: "apple.fixture.password", promptRef: ref),
+                scope: scope,
+                generation: generation)
+        }
+    }
+
+    @Test func `decoded CUA capabilities retain provider data and add native actions once`() throws {
+        let json = #"""
+        {"contractVersion":2,"provider":{"id":"cua","generation":"fixture"},
+        "actions":["type","start_recording"],"features":{"recording":true}}
+        """#
+        let descriptor = try JSONDecoder().decode(AnyCodable.self, from: Data(json.utf8))
+        let once = NativeCredentialEntryService.addingCapabilities(descriptor)
+        let twice = try #require(NativeCredentialEntryService.addingCapabilities(once))
+        let object = try #require(JSONSerialization.jsonObject(with: JSONEncoder().encode(twice)) as? [String: Any])
+        #expect(object["actions"] as? [String] == ["type", "start_recording", "credential_prompts", "type_secret"])
+        #expect((object["provider"] as? [String: String])?["generation"] == "fixture")
+        #expect((object["features"] as? [String: Bool])?["recording"] == true)
+        #expect(NativeCredentialEntryService.addingCapabilities(nil) == nil)
+    }
+
+    @Test func `account evidence belongs to the native password dialog and excludes sidebar or other dialogs`() throws {
+        let nodes: [NativeCredentialPromptContext.Node] = [
+            .init(parent: nil, role: "AXWindow", subrole: nil, text: []),
+            .init(parent: 0, role: "AXStaticText", subrole: nil, text: ["sidebar@example.invalid"]),
+            .init(parent: 0, role: "AXSheet", subrole: nil, text: ["Sign in"]),
+            .init(parent: 2, role: "AXStaticText", subrole: nil, text: ["operator@example.invalid"]),
+            .init(parent: 2, role: "AXTextField", subrole: "AXSecureTextField", text: []),
+            .init(parent: 2, role: "AXGroup", subrole: "AXDialog", text: ["other@example.invalid"]),
+            .init(parent: 5, role: "AXStaticText", subrole: nil, text: ["nested@example.invalid"]),
+        ]
+        let context = try #require(NativeCredentialPromptContext.resolve(
+            nodes,
+            bundleID: "com.apple.systempreferences"))
+        #expect(context.field == 4)
+        #expect(context.context == 2)
+        #expect(context.evidence == ["Sign in", "operator@example.invalid"])
+    }
+
+    @Test func `only dedicated native authentication owners can use a whole window password form`() throws {
+        let nodes: [NativeCredentialPromptContext.Node] = [
+            .init(parent: nil, role: "AXWindow", subrole: nil, text: ["operator"]),
+            .init(parent: 0, role: "AXTextField", subrole: "AXSecureTextField", text: []),
+        ]
+        #expect(NativeCredentialPromptContext.resolve(nodes, bundleID: "com.apple.systempreferences") == nil)
+        #expect(NativeCredentialPromptContext.resolve(nodes, bundleID: "com.apple.Safari") == nil)
+        let context = try #require(NativeCredentialPromptContext.resolve(nodes, bundleID: "com.apple.ScreenContinuity"))
+        #expect(context.evidence == ["operator"])
+        let passwordChange = nodes + [.init(parent: 0, role: "AXTextField", subrole: "AXSecureTextField", text: [])]
+        #expect(NativeCredentialPromptContext.resolve(passwordChange, bundleID: "com.apple.ScreenContinuity") == nil)
+    }
+
+    @Test func `native entry is opaque single use and does not claim authentication`() async throws {
+        let harness = try Harness()
+        let ref = try await harness.observe()
+        #expect(harness.secretReads == 0)
+        let result = try await harness.fill(ref)
+        #expect(harness.entries == ["fixture-password"])
+        #expect(result.effect == .unverifiable)
+        let json = try #require(String(data: JSONEncoder().encode(result), encoding: .utf8))
+        #expect(!json.contains("fixture-password"))
+        #expect(json.contains("authenticationVerified"))
+        await #expect(throws: NativeCredentialError.stalePrompt) { try await harness.fill(ref) }
+        #expect(harness.secretReads == 1)
+    }
+
+    @Test func `scope generation expiry and superseded discovery reject before reading`() async throws {
+        for change in 0..<4 {
+            let harness = try Harness()
+            let ref = try await harness.observe()
+            if change == 2 { harness.now.addTimeInterval(61) }
+            if change == 3 { _ = try await harness.observe() }
+            await #expect(throws: NativeCredentialError.stalePrompt) {
+                try await harness.fill(ref, scope: change == 0 ? UUID() : nil, generation: change == 1 ? 2 : 1)
+            }
+            #expect(harness.secretReads == 0)
+            #expect(harness.entries.isEmpty)
+        }
+    }
+
+    @Test func `changed host binding prompt expiry and cancellation refuse entry after secret resolution`() async throws {
+        for change in 0..<5 {
+            let harness = try Harness()
+            let ref = try await harness.observe()
+            harness.duringResolution = {
+                switch change {
+                case 0: harness.host = "22222222-2222-4222-8222-222222222222"
+                case 1: harness.bindings = []
+                case 2: harness.promptCurrent = false
+                case 3: harness.now.addTimeInterval(61)
+                default: harness.allowed = false
+                }
+            }
+            await #expect(throws: (any Error).self) { try await harness.fill(ref) }
+            #expect(harness.entries.isEmpty)
+            #expect(harness.secretReads == 1)
+        }
+    }
+
+    @Test func `wrong host or account cannot obtain a prompt reference`() async throws {
+        let harness = try Harness()
+        harness.host = "22222222-2222-4222-8222-222222222222"
+        let result = try await harness.call(.init(action: .credentialPrompts))
+        #expect((result.details?["credentialPrompts"]?.value as? [[String: String]])?.isEmpty == true)
+        let binding = try #require(harness.bindings.first)
+        #expect(!binding.authorizes(
+            hostID: binding.hostID,
+            bundleID: "com.apple.systempreferences",
+            accountEvidence: [
+                "otheroperator@example.invalid",
+                "operator@example.invalid.evil",
+            ]))
+        #expect(!binding.authorizes(
+            hostID: binding.hostID,
+            bundleID: "com.apple.Safari",
+            accountEvidence: [binding.account]))
+        #expect(harness.secretReads == 0)
+    }
+
+    @Test func `prompt replacement during an awaited read refuses entry and consumes the reference`() async throws {
+        let harness = try Harness()
+        let ref = try await harness.observe()
+        let started = AsyncStream.makeStream(of: CheckedContinuation<Void, Never>.self)
+        harness.duringResolution = {
+            await withCheckedContinuation { started.continuation.yield($0) }
+        }
+        let operation = Task { try await harness.fill(ref) }
+        var iterator = started.stream.makeAsyncIterator()
+        let release = try #require(await iterator.next())
+        harness.promptCurrent = false
+        release.resume()
+        await #expect(throws: NativeCredentialError.stalePrompt) { try await operation.value }
+        await #expect(throws: NativeCredentialError.stalePrompt) { try await harness.fill(ref) }
+        #expect(harness.entries.isEmpty)
+        #expect(harness.secretReads == 1)
+        started.continuation.finish()
+    }
+
+    @Test func `metadata rejects browsers renderers and wrong prompt kinds`() throws {
+        let host = "11111111-1111-4111-8111-111111111111"
+        for bundle in [
+            "com.apple.Safari",
+            "com.apple.WebKit.WebContent",
+            "com.apple.loginwindow",
+            "com.apple.ScreenContinuity",
+            "com.example.native",
+        ] {
+            #expect(throws: NativeCredentialError.invalidBinding) {
+                try NativeCredentialBinding(
+                    alias: "fixture",
+                    kind: .appleAccount,
+                    account: "operator@example.invalid",
+                    hostID: host,
+                    bundleIDs: [bundle])
+            }
+        }
+        #expect(throws: NativeCredentialError.invalidBinding) {
+            try NativeCredentialBinding(
+                alias: "fixture",
+                kind: .macLogin,
+                account: "operator",
+                hostID: host,
+                bundleIDs: ["com.apple.systempreferences"])
+        }
+    }
+
+    @Test func `literal values are refused and metadata CLI cannot take passwords`() async throws {
+        let harness = try Harness()
+        let ref = try await harness.observe()
+        await #expect(throws: NativeCredentialError.stalePrompt) {
+            try await harness.call(.init(
+                action: .typeSecret,
+                alias: "apple.fixture.password",
+                promptRef: ref,
+                text: "must-not-type"))
+        }
+        #expect(harness.secretReads == 0)
+        #expect(throws: NativeCredentialError.invalidBinding) {
+            try parseNativeCredentialBinding(["--password", "must-not-store"], hostID: harness.host)
+        }
+        let binding = try parseNativeCredentialBinding([
+            "--alias", "mac.fixture.password", "--kind", "macLogin", "--account", "fixture",
+            "--bundle", "com.apple.ScreenContinuity",
+        ], hostID: harness.host)
+        #expect(binding.hostID == harness.host)
+        #expect(binding.alias == "mac.fixture.password")
+    }
+}

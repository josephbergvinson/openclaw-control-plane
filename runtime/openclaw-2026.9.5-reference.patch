+            name: "AbortError",
+          });
+      const rejection = wrapped ? new Error("run failed", { cause: abortError }) : abortError;
+      agentCommand.mockImplementationOnce(async () => {
+        if (owner === "gateway") {
+          abortController.abort(abortError);
+        }
+        throw rejection;
+      });
+      const onSettled = vi.fn<
+        NonNullable<Parameters<typeof dispatchAgentRunFromGateway>[0]["onSettled"]>
+      >(() => settled);
+      const completeProcessing = vi.fn<
+        NonNullable<UserTurnTranscriptRecorder["completeProcessing"]>
+      >((outcome) => {
+        if (inputCompletionFails) {
+          throw new Error("required input completion write failed");
+        }
+        return outcome;
+      });
+      startTurn.mockImplementation(async ({ preflight, io }) => {
+        const request = preflight.request;
+        io.emitAcceptance(
+          [true, { runId: request.idempotencyKey, status: "accepted" }, undefined],
+          {
+            runId: request.idempotencyKey,
+          },
+        );

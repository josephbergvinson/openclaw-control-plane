+export function retainCodexNativeChildContinuation(state: ParentState, child: ChildState): void {
+  if (!child.releaseDirectChild || child.continuationRetained) {
+    return;
+  }
+  const scope = child.directOwner?.taskRuntimeScope;
+  if (scope && state.taskRuntime?.retainContinuation?.(child.runId, scope)) {
+    child.continuationScope = scope;
+    child.continuationRetained = true;
+  }
+}
+
+export function releaseCodexNativeDirectChild(childState: ChildState): void {
+  const release = childState.releaseDirectChild;
+  childState.releaseDirectChild = undefined;
+  childState.directOwner = undefined;
+  release?.();
+}

+import type { ReadStream } from "node:fs";
+import os from "node:os";
+import { describe, expect, it, vi } from "vitest";
+import { createCodexCliSessionNodeHostCommands } from "./node-cli-sessions.js";
+// Install the maintained catalog's narrow native request mocks before production imports.
+import {
+  commandRpcMocks,
+  createCodexSessionCatalogControlFactory,
+  idleThread,
+  fs,
+  path,
+  tempDirs,
+} from "./session-catalog.test-helpers.js";
+
+async function rollout(home: string, id: string, suffix = "") {
+  const directory = path.join(home, "sessions", "2026", "10", "08");
+  await fs.mkdir(directory, { recursive: true });
+  const file = path.join(directory, "rollout-2026-10-08T12-00-00-" + id + suffix + ".jsonl");
+  await fs.writeFile(
+    file,
+    JSON.stringify({
+      type: "session_meta",
+      payload: { id, source: "cli", originator: "codex_cli_rs" },
+    }) + "\n",
+  );
+  return file;
+}
+async function coldHome() {
+  const home = await fs.mkdtemp(path.join(os.tmpdir(), "codex-cli-cold-catalog-"));
+  tempDirs.push(home);
+  return await fs.realpath(home);
+}
+function findCommand(owner: ReturnType<typeof createCodexSessionCatalogControlFactory>) {
+  const found = createCodexCliSessionNodeHostCommands(owner).find(
+    ({ command }) => command === "codex.cli.sessions.list",
+  );
+  if (!found) {
+    throw new Error("missing CLI discovery");
+  }
+  return found;
+}
+describe("CLI discovery over a cold native catalog", () => {
+  it("does not read an 11 GiB rollout or history in full on its first limit-one list", async () => {
+    const home = await coldHome();
+    const threadId = "0199c456-7812-7a00-8000-000000000001";
+    const file = await rollout(home, threadId);
+    await fs.truncate(file, 11 * 1024 ** 3);
+    await fs.writeFile(path.join(home, "history.jsonl"), "legacy history is not the catalog\n");
+    const owner = createCodexSessionCatalogControlFactory({
+      env: { CODEX_HOME: home },
+      getPluginConfig: () => undefined,
+      getRuntimeConfig: () => undefined,
+    });
+    commandRpcMocks.codexControlRequest.mockResolvedValue({
+      data: [
+        idleThread({
+          id: threadId,
+          source: "cli",
+          path: file,
+          name: "Native title",
+          updatedAt: 100,
+          recencyAt: 101,
+        }),
+      ],
+    });
+    const fullRead = vi.spyOn(fs, "readFile");
+    const actualOpen = fs.open.bind(fs);
+    // Native RPC is mocked here. Count actual wrapper stream reads, not handle.read:
+    // createReadStream owns its native fd reads without calling that public method.
+    const streams: ReadStream[] = [];
+    vi.spyOn(fs, "open").mockImplementation(async (filePath, flags, mode) => {
+      const handle = await actualOpen(filePath, flags, mode);
+      if (filePath === file) {
+        const createStream = handle.createReadStream.bind(handle);
+        vi.spyOn(handle, "createReadStream").mockImplementation((options) => {
+          const stream = createStream(options);
+          streams.push(stream);
+          return stream;
+        });
+      }
+      return handle;
+    });
+    const page = JSON.parse(await findCommand(owner).handle(JSON.stringify({ limit: 1 })));
+    expect(page.sessions).toEqual([
+      expect.objectContaining({
+        sessionId: threadId,
+        name: "Native title",
+        status: "idle",
+      }),
+    ]);
+    expect(page.sessions[0]).not.toHaveProperty("messageCount");
+    expect(page.sessions[0]).not.toHaveProperty("lastMessage");
+    const bytesRead = streams.reduce((total, stream) => total + stream.bytesRead, 0);
+    expect(bytesRead).toBeGreaterThan(0);
+    expect(bytesRead).toBeLessThan(1024 * 1024);
+    expect(
+      fullRead.mock.calls.some(
+        ([filePath]) => filePath === file || filePath === path.join(home, "history.jsonl"),
+      ),
+    ).toBe(false);
+    expect(commandRpcMocks.codexControlRequest).toHaveBeenCalledWith(
+      undefined,
+      "thread/list",
+      expect.objectContaining({
+        archived: false,
+        sortKey: "recency_at",
+        sortDirection: "desc",
+        limit: 64,
+      }),
+      expect.objectContaining({ authProfileId: null }),
+    );
+  });
+
+  it("keeps native tie order and cursors while duplicate local rollouts share an ID", async () => {
+    const home = await coldHome();
+    const ids = ["thread-b", "thread-a", "thread-c"];
+    const paths = await Promise.all(ids.map((id) => rollout(home, id)));
+    await rollout(home, "thread-b", "-duplicate");
+    const owner = createCodexSessionCatalogControlFactory({
+      env: { CODEX_HOME: home },
+      getPluginConfig: () => undefined,
+      getRuntimeConfig: () => undefined,
+    });
+    commandRpcMocks.codexControlRequest.mockResolvedValue({
+      data: ids.map((id, index) =>
+        idleThread({
+          id,
+          name: "Title " + id,
+          path: paths[index],
+          source: "cli",
+          updatedAt: 100,
+          recencyAt: 100,
+        }),
+      ),
+    });
+    const listing = findCommand(owner);
+    const seen: string[] = [];
+    let cursor: string | undefined;
+    do {
+      const page = JSON.parse(await listing.handle(JSON.stringify({ limit: 1, cursor })));
+      seen.push(...page.sessions.map((row: { sessionId: string }) => row.sessionId));
+      cursor = page.nextCursor;
+      if (seen.length > 3) {
+        throw new Error("duplicate or repeated continuation");
+      }
+    } while (cursor);
+    expect(seen).toEqual(ids);
+    expect(new Set(seen).size).toBe(3);
+    expect(commandRpcMocks.codexControlRequest).toHaveBeenCalledOnce();
+  });
+});

+import { describe, expect, it, vi } from "vitest";
+import { createOperationalRunInstanceRef } from "../../agents/admitted-run-context.js";
+import { jsonResult } from "../../agents/tools/common.js";
+import type { ChannelPlugin } from "../../channels/plugins/types.public.js";
+import {
+  claimAgentRunDelegatedAuthority,
+  releaseAgentRunDelegatedAuthority,
+} from "../../infra/agent-run-registry.js";
+import { setActivePluginRegistry } from "../../plugins/runtime.js";
+import {
+  createChannelTestPluginBase,
+  createTestRegistry,
+} from "../../test-utils/channel-plugins.js";
+import { createAgentRuntimeApprovalAuthorityValidator } from "../agent-runtime-identity-token.js";
+import {
+  captureGatewayDeviceRevocation,
+  invalidateGatewayDeviceRevocation,
+} from "../device-revocation.js";
+import {
+  attachGatewayLocalUserIngress,
+  prepareGatewayLocalUserIngress,
+} from "../local-user-ingress.js";
+import {
+  mintLocalOperatorMessageActionCapability,
+  retainOperatorMessageReadAuthority,
+  resolveMessageActionTurnCapability,
+  revokeMessageActionTurnCapability,
+} from "../message-action-turn-capability.js";
+import { resolveGatewayCronCreatorAuthorityAdmission } from "./cron-creator-authority-admission.js";
+import {
+  messageActionContextFromSessionKeyForTests,
+  type GatewaySendMessageActionTestClient,
+} from "./send.test-helpers.js";
+import type { GatewayRequestContext } from "./types.js";
+
+type SendMessageAuthorityTestHarness = {
+  mocks: {
+    dispatchChannelMessageAction: ReturnType<typeof vi.fn>;
+    getChannelPlugin: ReturnType<typeof vi.fn>;
+  };
+  makeContext: () => GatewayRequestContext;
+  runMessageActionRequest: (
+    params: Record<string, unknown>,
+    client?: GatewaySendMessageActionTestClient,
+    context?: GatewayRequestContext,
+  ) => Promise<{ respond: ReturnType<typeof vi.fn> }>;
+  directCliClient: () => { connect: { client: { id: string; mode: string } } };
+  firstRespondCall: (respond: ReturnType<typeof vi.fn>) => readonly unknown[];
+  lastDispatchChannelMessageActionCall: () =>
+    | {
+        conversationReadOrigin?: string;
+        action?: string;
+        senderIsOwner?: boolean;
+        requesterSenderId?: string;
+        toolContext?: unknown;
+      }
+    | undefined;
+};
+
+/** Register inside the send suite so all cases inherit its fixture lifetime. */
+export function registerSendMessageAuthorityTests({
+  mocks,
+  makeContext,
+  runMessageActionRequest,
+  directCliClient,
+  firstRespondCall,
+  lastDispatchChannelMessageActionCall,
+}: SendMessageAuthorityTestHarness) {
+  it("keeps an agent runtime delegated even with a direct-operator marker", async () => {
+    const sessionKey = "agent:main:slack:channel:C1";
+    mocks.dispatchChannelMessageAction.mockResolvedValueOnce({
+      details: { action: "handled" },
+    });
+
+    await runMessageActionRequest(
+      {
+        channel: "slack",
+        action: "read",
+        params: { channelId: "C1", limit: 1 },
+        sessionKey,
+        agentId: "main",
+        conversationReadOrigin: "direct-operator",
+        idempotencyKey: "idem-agent-cli-identity",
+      },
+      {
+        ...directCliClient(),
+        internal: {
+          agentRuntimeIdentity: {
+            kind: "agentRuntime",
+            agentId: "main",
+            sessionKey,
+            messageActionContext: messageActionContextFromSessionKeyForTests(sessionKey),
+          },
+        },
+      },
+    );
+
+    expect(lastDispatchChannelMessageActionCall()?.conversationReadOrigin).toBe("delegated");
+  });
+
+  describe("host-attested operator message forwarding", () => {
+    it.each(["local-admin", "task-read"] as const)(
+      "redeems %s on the actual write-scope Gateway handler without inventing a sender",
+      async (kind) => {
+        const plugin: ChannelPlugin = {
+          ...createChannelTestPluginBase({
+            id: "discord",
+            config: { resolveAccount: () => ({ enabled: true }), isConfigured: () => true },
+          }),
+          actions: {
+            describeMessageTool: () => ({ actions: ["role-info", "role-remove"] }),
+            supportsAction: ({ action }) => action === "role-info" || action === "role-remove",
+            handleAction: async () => jsonResult({ ok: true }),
+          },
+        };
+        mocks.getChannelPlugin.mockReturnValue(plugin);
+        setActivePluginRegistry(
+          createTestRegistry([{ pluginId: "discord", source: "test", plugin }]),
+        );
+        mocks.dispatchChannelMessageAction.mockResolvedValue(jsonResult({ ok: true }));
+        const owner = {};
+        const native = captureGatewayDeviceRevocation(
+          owner,
+          { deviceId: "operator-message-device", role: "operator" },
+          () => true,
+        );
+        const operatorClient = {
+          connect: {
+            minProtocol: 1,
+            maxProtocol: 1,
+            scopes: ["operator.admin"],
+            client: { id: "cli" as const, mode: "cli" as const, version: "test", platform: "test" },
+          },
+          internal: { isLocalClient: true as const },
+        };
+        attachGatewayLocalUserIngress(
+          operatorClient,
+          prepareGatewayLocalUserIngress({
+            authMethod: "token",
+            authenticatedUserExpected: false,
+            isLocalClient: true,
+          }),
+        );
+        const identity = {
+          agentId: "main",
+          runId: `operator-${kind}`,
+          sessionKey: "agent:main:discord:channel:operator-history",
+          sessionId: "operator-session",
+        };
+        const admission = resolveGatewayCronCreatorAuthorityAdmission({
+          ...identity,
+          resolvedSessionKey: identity.sessionKey,
+          client: operatorClient,
+          isCurrent: native.isCurrent,
+          request: { message: "perform the authorized task", idempotencyKey: identity.runId },
+          hasRestoredCronContinuation: false,
+          isOneShotModelRun: false,
+          isRestartRecoveryResumeRun: false,
+        });
+        const parentToken = mintLocalOperatorMessageActionCapability({
+          identity,
+          admission,
+          client: operatorClient,
+          assertRunCurrent: () => {},
+          assertSessionCurrent: () => {},
+        });
+        const selectedIdentity =
+          kind === "task-read"
+            ? {
+                ...identity,
+                runId: `${identity.runId}-child`,
+                sessionKey: "agent:main:subagent:reviewer",
+                sessionId: "reviewer-session",
+              }
+            : identity;
+        const transfer =
+          kind === "task-read"
+            ? retainOperatorMessageReadAuthority(
+                { ...identity, token: parentToken },
+                { channel: "discord", accountId: "default", actions: ["role-info"] },
+              )
+            : undefined;
+        const token = transfer?.adopt(selectedIdentity, () => {}) ?? parentToken;
+        const operationalRunInstance = createOperationalRunInstanceRef(selectedIdentity.runId);
+        const delegatedAuthority = claimAgentRunDelegatedAuthority(operationalRunInstance);
+        const projected = resolveMessageActionTurnCapability({ ...selectedIdentity, token });
+        expect(projected).not.toHaveProperty("operator");
+        const client = {
+          connect: { scopes: ["operator.write"] },
+          internal: {
+            agentRuntimeIdentity: {
+              kind: "agentRuntime" as const,
+              ...selectedIdentity,
+              operationalRunInstance,
+              delegatedAuthority: { kind: "local" as const, ...delegatedAuthority },
+              messageActionContext: { ...projected!, turnCapability: token },
+            },
+          },
+        };
+        const context = {
+          ...makeContext(),
+          validateAgentRuntimeApprovalAuthority: createAgentRuntimeApprovalAuthorityValidator(),
+        };
+        const action = kind === "task-read" ? "role-info" : "role-remove";
+        const request = {
+          channel: "discord",
+          action,
+          accountId: "default",
+          params: {
+            guildId: "fixture-guild",
+            ...(kind === "local-admin" ? { roleId: "fixture-role", userId: "fixture-bot" } : {}),
+          },
+          agentId: selectedIdentity.agentId,
+          sessionKey: selectedIdentity.sessionKey,
+          sessionId: selectedIdentity.sessionId,
+          senderIsOwner: kind === "task-read",
+          conversationReadOrigin: "direct-operator",
+          idempotencyKey: `${selectedIdentity.runId}-action`,
+        };
+        try {
+          const { respond } = await runMessageActionRequest(request, client, context);
+          expect(firstRespondCall(respond)[0]).toBe(true);
+          expect(mocks.dispatchChannelMessageAction).toHaveBeenCalledOnce();
+          expect(lastDispatchChannelMessageActionCall()).toMatchObject({
+            action,
+            senderIsOwner: kind === "local-admin",
+            conversationReadOrigin: kind === "local-admin" ? "direct-operator" : "delegated",
+          });
+          expect(lastDispatchChannelMessageActionCall()?.requesterSenderId).toBeUndefined();
+          expect(lastDispatchChannelMessageActionCall()?.toolContext).toBeUndefined();
+          if (kind === "task-read") {
+            const denied = await runMessageActionRequest(
+              { ...request, action: "role-remove", idempotencyKey: "child-write-refused" },
+              client,
+              context,
+            );
+            expect(firstRespondCall(denied.respond)[0]).toBe(false);
+            expect(mocks.dispatchChannelMessageAction).toHaveBeenCalledOnce();
+          }
+          invalidateGatewayDeviceRevocation(owner, "operator-message-device", "operator");
+          const revoked = await runMessageActionRequest(
+            { ...request, idempotencyKey: "operator-revoked" },
+            client,
+            context,
+          );
+          expect(firstRespondCall(revoked.respond)[0]).toBe(false);
+          expect(mocks.dispatchChannelMessageAction).toHaveBeenCalledOnce();
+        } finally {
+          revokeMessageActionTurnCapability(token);
+          revokeMessageActionTurnCapability(parentToken);
+          transfer?.discard();
+          releaseAgentRunDelegatedAuthority(delegatedAuthority);
+          native.release();
+        }
+      },
+    );
+  });
+}

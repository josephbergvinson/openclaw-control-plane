+import type { ChannelMessageActionContext } from "openclaw/plugin-sdk/channel-contract";
+import { handleDiscordMessageAction } from "../actions/handle-action.js";
+import { setDiscordTranscriptsVoiceManager } from "./transcripts-source.js";
+import { defineDiscordVoiceTests } from "./voice-test-harness.test-support.js";
+
+defineDiscordVoiceTests(
+  ({
+    expect,
+    it,
+    vi,
+    createClientWithMember,
+    createManager,
+    makeVoiceConfig,
+    joinVoiceChannelMock,
+    entersStateMock,
+    getSessionEntry,
+    expectConnectedStatus,
+  }) => {
+    const setup = () => {
+      const accountId = "voice-controls";
+      const discordConfig = makeVoiceConfig(
+        {},
+        { token: "test-voice-token", groupPolicy: "open", allowFrom: ["discord:u-owner"] },
+      );
+      const cfg = { channels: { discord: { accounts: { [accountId]: discordConfig } } } };
+      const client = createClientWithMember("u-owner", "Owner", "0001");
+      const manager = createManager(discordConfig, client, cfg, accountId);
+      setDiscordTranscriptsVoiceManager({ accountId, manager });
+      const context = {
+        cfg,
+        accountId,
+        requesterAccountId: accountId,
+        requesterSenderId: "u-owner",
+        senderIsOwner: true,
+        toolContext: { currentChannelProvider: "discord", currentChannelId: "text-channel" },
+        assertDirectAdapterHandoff: vi.fn(),
+      } satisfies Partial<ChannelMessageActionContext>;
+      const execute = (
+        action: "voice-join" | "voice-leave",
+        params: Record<string, unknown> = {},
+        overrides: Partial<ChannelMessageActionContext> = {},
+      ) =>
+        handleDiscordMessageAction({
+          ...context,
+          ...overrides,
+          action,
+          params: {
+            guildId: "g1",
+            ...(action === "voice-join" ? { channelId: "1001" } : {}),
+            ...params,
+          },
+        });
+      const cleanup = async () => {
+        setDiscordTranscriptsVoiceManager({ accountId, manager: null, expectedManager: manager });
+        await manager.destroy();
+      };
+      return { accountId, client, manager, context, execute, cleanup, cfg, discordConfig };
+    };
+
+    it("joins and leaves through the message entry point without starting recording", async () => {
+      const f = setup();
+      try {
+        await expect(f.execute("voice-join")).resolves.toMatchObject({
+          details: { ok: true, guildId: "g1", channelId: "1001" },
+        });
+        expectConnectedStatus(f.manager, "1001");
+        expect(getSessionEntry(f.manager).transcripts).toBeUndefined();
+        await expect(f.execute("voice-leave")).resolves.toMatchObject({
+          details: { ok: true, channelId: "1001" },
+        });
+        expect(f.manager.status()).toEqual([]);
+      } finally {
+        await f.cleanup();
+      }
+    });
+
+    it("applies native voice admission to the trusted sender rather than model arguments", async () => {
+      const f = setup();
+      try {
+        await expect(
+          f.execute(
+            "voice-join",
+            { senderUserId: "u-owner" },
+            { requesterSenderId: "u-denied", senderIsOwner: false },
+          ),
+        ).resolves.toMatchObject({
+          details: { ok: false, message: "You are not authorized to use this command." },
+        });
+        expect(joinVoiceChannelMock).not.toHaveBeenCalled();
+      } finally {
+        await f.cleanup();
+      }
+    });
+
+    it("allows a trusted local owner to use the live voice manager", async () => {
+      const f = setup();
+      try {
+        await expect(
+          f.execute(
+            "voice-join",
+            {},
+            {
+              toolContext: undefined,
+              requesterAccountId: undefined,
+              requesterSenderId: undefined,
+              senderIsOwner: true,
+            },
+          ),
+        ).resolves.toMatchObject({ details: { ok: true, channelId: "1001" } });
+        expectConnectedStatus(f.manager, "1001");
+        expect(getSessionEntry(f.manager).transcripts).toBeUndefined();
+      } finally {
+        await f.cleanup();
+      }
+    });
+
+    it("rejects missing local ownership and foreign providers even when owner is set", async () => {
+      const f = setup();
+      try {
+        for (const overrides of [
+          { toolContext: undefined, senderIsOwner: undefined },
+          { toolContext: undefined, senderIsOwner: false },
+          { toolContext: { currentChannelProvider: "telegram" }, senderIsOwner: true },
+        ]) {
+          await expect(f.execute("voice-join", {}, overrides)).rejects.toThrow(
+            "trusted Discord sender or local owner",
+          );
+        }
+        expect(joinVoiceChannelMock).not.toHaveBeenCalled();
+      } finally {
+        await f.cleanup();
+      }
+    });
+
+    it("rejects a bot-account switch and missing live authority before joining", async () => {
+      const f = setup();
+      try {
+        await expect(
+          f.execute("voice-join", {}, { requesterAccountId: "another-account" }),
+        ).rejects.toThrow("originating bot account");
+        await expect(
+          handleDiscordMessageAction({
+            ...f.context,
+            assertDirectAdapterHandoff: undefined,
+            action: "voice-join",
+            params: { guildId: "g1", channelId: "1001" },
+          }),
+        ).rejects.toThrow("active authorized request");
+        expect(joinVoiceChannelMock).not.toHaveBeenCalled();
+      } finally {
+        await f.cleanup();
+      }
+    });
+
+    it("checks authority again after target preparation before opening a voice connection", async () => {
+      const f = setup();
+      let active = true;
+      const original = f.client.fetchChannel.getMockImplementation()!;
+      let reads = 0;
+      f.client.fetchChannel.mockImplementation(async (...args) => {
+        const result = await original(...args);
+        if (++reads === 2) {
+          active = false;
+        }
+        return result;
+      });
+      try {
+        await expect(
+          f.execute(
+            "voice-join",
+            {},
+            {
+              assertDirectAdapterHandoff: vi.fn(() => {
+                if (!active) {
+                  throw new Error("turn retired");
+                }
+              }),
+            },
+          ),
+        ).resolves.toMatchObject({ details: { ok: false } });
+        expect(reads).toBe(2);
+        expect(joinVoiceChannelMock).not.toHaveBeenCalled();
+        expect(f.manager.status()).toEqual([]);
+      } finally {
+        await f.cleanup();
+      }
+    });
+
+    it("does not disconnect the room when leave names another channel", async () => {
+      const f = setup();
+      try {
+        await f.execute("voice-join");
+        await expect(f.execute("voice-leave", { channelId: "2002" })).resolves.toMatchObject({
+          details: { ok: false },
+        });
+        expectConnectedStatus(f.manager, "1001");
+      } finally {
+        await f.cleanup();
+      }
+    });
+
+    it("does not retry a connection after the originating request is retired", async () => {
+      const f = setup();
+      let active = true;
+      entersStateMock.mockImplementationOnce(async () => {
+        active = false;
+        throw new Error("The operation was aborted");
+      });
+      try {
+        await expect(
+          f.execute(
+            "voice-join",
+            {},
+            {
+              assertDirectAdapterHandoff: vi.fn(() => {
+                if (!active) {
+                  throw new Error("turn retired");
+                }
+              }),
+            },
+          ),
+        ).resolves.toMatchObject({ details: { ok: false } });
+        expect(joinVoiceChannelMock).toHaveBeenCalledOnce();
+        expect(f.manager.status()).toEqual([]);
+      } finally {
+        await f.cleanup();
+      }
+    });
+
+    it("rejects a manager replacement while target authorization is in flight", async () => {
+      const f = setup();
+      const replacement = createManager(f.discordConfig, undefined, f.cfg, f.accountId);
+      const original = f.client.fetchChannel.getMockImplementation()!;
+      f.client.fetchChannel.mockImplementation(async (...args) => {
+        const result = await original(...args);
+        setDiscordTranscriptsVoiceManager({ accountId: f.accountId, manager: replacement });
+        return result;
+      });
+      try {
+        await expect(f.execute("voice-join")).rejects.toThrow("manager changed");
+        expect(joinVoiceChannelMock).not.toHaveBeenCalled();
+      } finally {
+        setDiscordTranscriptsVoiceManager({
+          accountId: f.accountId,
+          manager: null,
+          expectedManager: replacement,
+        });
+        await replacement.destroy();
+        await f.cleanup();
+      }
+    });
+  },
+);

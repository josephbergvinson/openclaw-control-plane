+      const token = mintMessageActionTurnCapability({
+        agentId: "main",
+        runId: "original-run",
+        sessionKey,
+        sessionId: "parent-A",
+        requesterAccountId: "default",
+        requesterSenderId: "100000000000000005",
+        providedUserSource: { kind: "channel" },
+        toolContext: {

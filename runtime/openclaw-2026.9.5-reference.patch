+          return true;
+        },
+        resolveGatewayContext: () => context,
+      });
+      let foreground: ReturnType<typeof createReplyOperation> | undefined;
+      try {
+        await Promise.race([
+          preparing.promise,
+          call.then(() => {
+            throw new Error("Announcement settled before reaching the admission guard");
+          }),
+        ]);
+        foreground = createReplyOperation({
+          sessionKey,
+          sessionId,
+          agentId: "main",
+          resetTriggered: false,
+        });
+        const rejected = expect(call).rejects.toBeInstanceOf(RequesterTurnPendingError);
+        release.resolve();
+        await rejected;
+        await expect(call).rejects.toBe(pendingError);
+        expect(startTurn).toHaveBeenCalledOnce();
+        expect(startTurn.mock.calls[0]?.[0].privateCompletion).toBe(
+          privateCompletion ? true : undefined,

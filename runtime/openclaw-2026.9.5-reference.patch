+/** Ordinary completion retains the session; its tab cleanup remains revocable. */
+export async function cleanupBrowserSessionsForTaskCompletion(params: {
+  cfg: OpenClawConfig;
+  sessionKey: string | undefined;
+  storePath: string | undefined;
+  agentId?: string;
+  runId: string;
+  lifecycleGeneration: string;
+  expectedSession: Pick<InternalSessionEntry, "sessionId" | "lifecycleRevision">;
+  completedAt: number;
+  queueKey?: string;
+  activeQueueSource?: FollowupRun;
+  isCurrent: () => boolean;
+  onWarn?: (message: string) => void;
+  onError?: (error: unknown) => void;
+}): Promise<void> {
+  if (
+    isBrowserCleanupDisabled(params.cfg) ||
+    params.cfg.browser?.tabCleanup?.enabled === false ||
+    !params.sessionKey?.trim() ||
+    !params.storePath ||
+    !params.isCurrent()
+  ) {
+    return;
+  }
+  const sessionKey = params.sessionKey.trim();
+  await runBestEffortCleanup({
+    cleanup: async () => {
+      const [sessions, keys, events, runs, replies, queue, children] = await Promise.all([
+        import("./config/sessions/session-accessor.js"),
+        import("./sessions/session-key-utils.js"),
+        import("./infra/agent-events.js"),
+        import("./agents/embedded-agent-runner/runs.js"),
+        import("./auto-reply/reply/reply-run-registry.js"),
+        import("./auto-reply/reply/queue/state.js"),
+        import("./agents/subagents/registry/subagent-registry-read.js"),
+      ]);
+      if (
+        keys.isSubagentSessionKey(sessionKey) ||
+        keys.isCronSessionKey(sessionKey) ||
+        keys.isAcpSessionKey(sessionKey)
+      ) {
+        return;
+      }
+      const isCurrent = () => {
+        const hasPendingFollowup = [
+          sessionKey,
+          params.expectedSession.sessionId,
+          params.queueKey,
+        ].some((key) => {
+          if (!key) {
+            return false;
+          }
+          const pending = queue.getExistingFollowupQueue(key);
+          if (!pending) {
+            return false;
+          }
+          const admission = queue.inspectFollowupQueueAdmission(key, {
+            activeSource: params.activeQueueSource,
+          });
+          const isFinishingSource = (item: FollowupRun) =>
+            admission.excludedActiveSource &&
+            item === params.activeQueueSource &&
+            !item.steerPending;
+          // Admission readiness intentionally hides parked steers. Completion
+          // must preserve every retained input, including waiting/injecting work.
+          return (
+            pending.items.some((item) => !isFinishingSource(item)) ||
+            [...pending.inFlight].some((item) => !isFinishingSource(item)) ||
+            pending.droppedCount > 0
+          );
+        });
+        if (
+          !params.isCurrent() ||
+          events.getAgentEventLifecycleGeneration() !== params.lifecycleGeneration ||
+          hasPendingFollowup ||
+          replies.replyRunRegistry.get(sessionKey) ||
+          children.hasDescendantRunAwaitingSettle(sessionKey, undefined, params.agentId) ||
+          children.hasPendingRequesterYieldContinuation(sessionKey, params.agentId)
+        ) {
+          return false;
+        }
+        const entry: InternalSessionEntry | undefined = sessions.loadSessionEntryReadOnly({
+          storePath: params.storePath,
+          sessionKey,
+          agentId: params.agentId,
+          readConsistency: "latest",
+        });
+        if (
+          !entry ||
+          entry.sessionId !== params.expectedSession.sessionId ||
+          entry.lifecycleRevision !== params.expectedSession.lifecycleRevision ||
+          // The admitted writer, rather than a possibly stale presentation
+          // snapshot, owns this completion. Unknown legacy owners stay intact.
+          entry.activeWriterRunId !== params.runId ||
+          (entry.lifecycleRunId !== undefined && entry.lifecycleRunId !== params.runId) ||
+          (entry.lastInteractionAt !== undefined && entry.lastInteractionAt > params.completedAt) ||
+          (entry.goal && entry.goal.status !== "complete") ||
+          entry.pendingFinalDelivery ||
+          entry.pendingDeliveryNotice ||
+          entry.restartRecoveryDeliveryRunId ||
+          entry.mainRestartRecovery
+        ) {
+          return false;
+        }
+        const active = runs.resolveActiveEmbeddedRunOwner(entry.sessionId);
+        return !active || active.runId === params.runId;
+      };
+      if (!isCurrent()) {
+        return;
+      }
+      await closeTrackedBrowserTabsForSessions({
+        sessionKeys: [sessionKey],
+        taskCompletion: { completedAt: params.completedAt, isCurrent },
+        onWarn: params.onWarn,
+      });
+    },
+    onError: params.onError,
+  });
+}
+
 function isBrowserCleanupDisabled(cfg: OpenClawConfig | undefined): boolean {
   return cfg?.browser?.enabled === false || cfg?.plugins?.entries?.browser?.enabled === false;
 }

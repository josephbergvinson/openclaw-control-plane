@@ -0,0 +1,241 @@
+import { captureOpenAIResponsesCompaction } from "@openclaw/ai/transports";
+import { describe, expect, it } from "vitest";
+import { makeUserMessage } from "../../../test/helpers/user-message.js";
+import { MemoryExtractionBudgetError } from "../../agents/memory-extraction-budget.js";
+import type { AgentMessage } from "../../agents/runtime/index.js";
+import { estimateCompactionHistoryTokens } from "../../agents/sessions/compaction/request-budget.js";
+import { makeAssistantMessageFixture } from "../../agents/test-helpers/assistant-message-fixtures.js";
+import { runMemoryExtractionSegments } from "./memory-flush-extraction.js";
+
+async function extractHistory(messages: AgentMessage[], maxHistoryTokens: number) {
+  const chunks: AgentMessage[][] = [];
+  await runMemoryExtractionSegments({
+    messages,
+    workspaceDir: process.cwd(),
+    signal: new AbortController().signal,
+    runSegment: async (extraction) => {
+      extraction.prepareCandidate();
+      extraction.onPreparedBudget({
+        contextWindow: maxHistoryTokens,
+        reserveTokens: 0,
+        fixedTokens: 0,
+        pendingTokens: 0,
+      });
+      chunks.push(extraction.sessionManager.buildSessionContext().messages);
+    },
+  });
+  return chunks;
+}
+
+function includesCall(messages: AgentMessage[]) {
+  return messages.some(
+    (message) =>
+      message.role === "assistant" &&
+      message.content.some((content) => content.type === "toolCall" && content.id === "call-1"),
+  );
+}
+
+describe("original memory extraction history", () => {
+  const user = (text: string) => makeUserMessage(text, 1);
+  const assistant = (text: string) =>
+    makeAssistantMessageFixture({ content: [{ type: "text", text }], timestamp: 2 });
+  const call = makeAssistantMessageFixture({
+    content: [{ type: "toolCall", id: "call-1", name: "read", arguments: { path: "note.md" } }],
+    stopReason: "toolUse",
+    timestamp: 2,
+  });
+  const result: AgentMessage = {
+    role: "toolResult",
+    toolCallId: "call-1",
+    toolName: "read",
+    content: [{ type: "text", text: "evidence" }],
+    isError: false,
+    timestamp: 3,
+  };
+
+  it("rechecks a new candidate budget before any provider attempt and covers the original once", async () => {
+    const first = [user("first original ".repeat(200)), assistant("first completion")];
+    const second = [user("second original ".repeat(200)), assistant("second completion")];
+    const original = [...first, ...second];
+    const large = { contextWindow: 100_000, reserveTokens: 0, fixedTokens: 0, pendingTokens: 0 };
+    const small = {
+      ...large,
+      contextWindow: Math.max(
+        estimateCompactionHistoryTokens(first),
+        estimateCompactionHistoryTokens(second),
+      ),
+    };
+    const dispatched: AgentMessage[][] = [];
+    await runMemoryExtractionSegments({
+      messages: original,
+      workspaceDir: process.cwd(),
+      signal: new AbortController().signal,
+      runSegment: async (extraction) => {
+        extraction.prepareCandidate();
+        extraction.onPreparedBudget(large);
+        // The first authorized candidate failed authentication before streaming.
+        extraction.onPreparedBudget(undefined);
+        extraction.onPreparedBudget(small);
+        extraction.onPreparedBudget(small);
+        dispatched.push(extraction.sessionManager.buildSessionContext().messages);
+      },
+    });
+    expect(dispatched).toHaveLength(2);
+    expect(dispatched.flat()).toEqual(original);
+    expect(original).toEqual([...first, ...second]);
+  });
+
+  it("never repartitions or recreates a started segment when a later candidate cannot fit", async () => {
+    const original = [user("original history ".repeat(200)), assistant("original completion")];
+    const accepted = assistant("accepted private progress");
+    const large = { contextWindow: 100_000, reserveTokens: 0, fixedTokens: 0, pendingTokens: 0 };
+    let runs = 0;
+    let settled: AgentMessage[] | undefined;
+    await expect(
+      runMemoryExtractionSegments({
+        messages: original,
+        workspaceDir: process.cwd(),
+        signal: new AbortController().signal,
+        runSegment: async (extraction) => {
+          runs += 1;
+          extraction.prepareCandidate();
+          extraction.onPreparedBudget(large);
+          extraction.onPreparedBudget(large);
+          extraction.sessionManager.appendMessage(accepted);
+          extraction.prepareCandidate();
+          extraction.onPreparedBudget(undefined);
+          settled = extraction.sessionManager.buildSessionContext().messages;
+          extraction.onPreparedBudget({ ...large, contextWindow: 100 });
+        },
+      }),
+    ).rejects.toThrow(MemoryExtractionBudgetError);
+    expect(runs).toBe(1);
+    expect(settled).toEqual([...original, accepted]);
+    expect(original).toHaveLength(2);
+  });
+
+  it("covers original messages exactly once and preserves fitting complete turns", async () => {
+    const first = [user("first original request"), call, result, assistant("first result")];
+    const second = [user("second original request"), assistant("second result")];
+    const original = [...first, ...second];
+    const chunks = await extractHistory(original, estimateCompactionHistoryTokens(first));
+    expect(chunks).toEqual([first, second]);
+    expect(chunks.flat()).toEqual(original);
+    expect(original).toHaveLength(6);
+  });
+
+  it("keeps call/result pairs together when a large turn needs several segments", async () => {
+    const first = user("request ".repeat(200));
+    const last = assistant("answer ".repeat(200));
+    const chunks = await extractHistory(
+      [first, call, result, last],
+      Math.max(estimateCompactionHistoryTokens([first]), estimateCompactionHistoryTokens([last])) +
+        50,
+    );
+    const paired = chunks.find(includesCall);
+    expect(paired).toContainEqual(result);
+    expect(chunks.flat()).toEqual([first, call, result, last]);
+    expect(chunks.length).toBeGreaterThan(1);
+  });
+
+  it("refuses an indivisible oversized tool group without omissions", async () => {
+    const huge: AgentMessage = {
+      ...result,
+      content: [{ type: "text", text: "unaltered evidence ".repeat(1000) }],
+    };
+    await expect(extractHistory([user("request"), call, huge], 100)).rejects.toThrow("indivisible");
+    expect(huge.content).toEqual([{ type: "text", text: "unaltered evidence ".repeat(1000) }]);
+  });
+
+  it("uses worker planning without losing ordered visible messages or leaking private carriers", async () => {
+    const visible: AgentMessage[] = Array.from({ length: 36 }, (_, index) => [
+      user(`original turn ${index}`),
+      assistant(`original answer ${index}`),
+    ]).flat();
+    visible.splice(21, 0, call, result);
+    const privateResult = { ...result, details: { privateMetadata: "not model content" } };
+    const runtime: AgentMessage = {
+      role: "custom",
+      customType: "openclaw.runtime-context",
+      content: "private runtime carrier",
+      display: false,
+      timestamp: 0,
+    };
+    const original = [...visible.slice(0, 23), runtime, privateResult, ...visible.slice(23)];
+    const chunks = await extractHistory(original, 300);
+    const expected = [...visible.slice(0, 23), result, ...visible.slice(23)];
+    expect(chunks.flat()).toEqual(expected);
+    expect(JSON.stringify(chunks)).not.toContain("not model content");
+    expect(JSON.stringify(chunks)).not.toContain("private runtime carrier");
+    expect(chunks.find(includesCall)).toContainEqual(result);
+  });
+
+  it("preserves an existing canonical summary as original context without new compaction", async () => {
+    const summary: AgentMessage = {
+      role: "compactionSummary",
+      summary: "Existing durable summary",
+      tokensBefore: 100,
+      timestamp: 0,
+    };
+    const messages = [summary, user("retained request"), call, result];
+    await runMemoryExtractionSegments({
+      messages,
+      workspaceDir: process.cwd(),
+      signal: new AbortController().signal,
+      runSegment: async ({ sessionManager }) => {
+        expect(sessionManager.buildSessionContext().messages).toEqual(messages);
+        // This represents the one pre-existing summary; no summarization ran.
+        expect(sessionManager.getBoundaryCount()).toBe(1);
+        sessionManager.appendMessage(assistant("private completion"));
+      },
+    });
+    expect(messages).toHaveLength(4);
+  });
+
+  it("round trips branch/custom content and removes only canonical provider checkpoint metadata", async () => {
+    const owner = assistant("original visible answer");
+    captureOpenAIResponsesCompaction(
+      owner,
+      { type: "compaction", id: "cmp_original", encrypted_content: "synthetic-opaque-checkpoint" },
+      "retained-users",
+      {
+        id: "gpt-6.1-sol",
+        name: "Sol fixture",
+        provider: "openai",
+        api: "openai-responses",
+        baseUrl: "https://api.openai.com/v1",
+        reasoning: true,
+        input: ["text"],
+        contextWindow: 128000,
+        maxTokens: 8192,
+        cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+      },
+    );
+    expect(owner.providerReplay).toBeDefined();
+    const original = structuredClone(owner);
+    const branch: AgentMessage = {
+      role: "branchSummary",
+      summary: "original branch context",
+      fromId: "original-branch",
+      timestamp: 0,
+    };
+    const custom: AgentMessage = {
+      role: "custom",
+      customType: "visible-context",
+      content: "original custom context",
+      display: false,
+      details: undefined,
+      timestamp: 0,
+    };
+    const [context] = await extractHistory([branch, custom, owner], 100_000);
+    expect(context).toBeDefined();
+    if (!context) {
+      throw new Error("Missing private extraction context");
+    }
+    expect(context.slice(0, 2)).toEqual([branch, custom]);
+    const extractedOwner = context[2];
+    expect(extractedOwner).toMatchObject({ role: "assistant", content: owner.content });
+    expect(extractedOwner).not.toHaveProperty("providerReplay");
+    expect(owner).toEqual(original);
+  });
+});

@@ -0,0 +1,227 @@
+import { writeFile } from "node:fs/promises";
+import path from "node:path";
+import { expect, it, vi } from "vitest";
+import { clearConfigCache, getRuntimeConfig } from "../../../config/config.js";
+import { resolveSessionStorePathCore } from "../../../config/sessions/paths.js";
+import { replaceSessionEntry } from "../../../config/sessions/session-accessor.js";
+import { readAgentRuntimeExecutionLineage } from "../../../gateway/agent-runtime-execution-lineage.js";
+import type { AgentRuntimeIdentity } from "../../../gateway/agent-runtime-identity-token.js";
+import { readInProcessAgentRuntimeIdentity } from "../../../gateway/in-process-agent-runtime-identity.js";
+import type {
+  GatewayRequestContext,
+  GatewayRequestOptions,
+} from "../../../gateway/server-methods/types.js";
+import type { dispatchGatewayMethodInProcess } from "../../../gateway/server-plugins.js";
+import {
+  claimAgentRunDelegatedAuthority,
+  releaseAgentRunDelegatedAuthority,
+} from "../../../infra/agent-run-registry.js";
+import { withPluginRuntimeGatewayRequestScope } from "../../../plugins/runtime/gateway-request-scope.js";
+import { tryBeginGatewayRootWorkAdmission } from "../../../process/gateway-work-admission.js";
+import { createOperationalRunInstanceRef } from "../../admitted-run-context.js";
+import { resolveRequesterToolPolicies } from "../../requester-tool-policy.js";
+import { createToolPolicyMatcher } from "../../tool-policy-match.js";
+import { withGatewayToolCallerIdentity } from "../../tools/gateway-caller-context.js";
+import { subagentRuns } from "../registry/subagent-registry-memory.js";
+import { spawnSubagentDirect } from "./subagent-spawn.js";
+import { testing as subagentSpawnTesting } from "./subagent-spawn.test-support.js";
+
+/** Registers native and saved-queue credential cases under the original host lifecycle hooks. */
+export function registerRequesterContinuityTests({
+  getStateDir,
+  makeGatewayContext,
+  externalCliClient,
+  waitForAssertion,
+}: {
+  getStateDir: () => string;
+  makeGatewayContext: () => GatewayRequestContext;
+  externalCliClient: () => GatewayRequestOptions["client"];
+  waitForAssertion: (assertion: () => void, timeoutMs?: number) => Promise<void>;
+}): void {
+  it("carries the original credential partition through native child launch with audit disabled", async () => {
+    const stateDir = getStateDir();
+    await writeFile(
+      path.join(stateDir, "openclaw.json"),
+      `${JSON.stringify({
+        session: { mainKey: "main", scope: "per-sender" },
+        agents: { defaults: { workspace: stateDir } },
+      })}\n`,
+    );
+    clearConfigCache();
+    await replaceSessionEntry(
+      {
+        agentId: "main",
+        sessionKey: "agent:main:main",
+        storePath: resolveSessionStorePathCore(undefined, { agentId: "main" }),
+      },
+      {
+        sessionId: "original-parent",
+        lifecycleRevision: "original-revision",
+        updatedAt: Date.now(),
+      },
+    );
+    const operationalRunInstance = createOperationalRunInstanceRef("credential-parent-run");
+    const authority = claimAgentRunDelegatedAuthority(operationalRunInstance);
+    const mcpRequesterScope = {
+      requesterSenderId: "owner-A",
+      agentAccountId: "company-A",
+      messageChannel: "discord",
+    };
+    let childIdentity: AgentRuntimeIdentity | undefined;
+    let publicRequest: Record<string, unknown> | undefined;
+    const assertCurrent = vi.fn();
+    subagentSpawnTesting.setDepsForTest({
+      dispatchGatewayMethodInProcess: async <T>(
+        _method: string,
+        params: Record<string, unknown>,
+        options?: NonNullable<Parameters<typeof dispatchGatewayMethodInProcess>[2]>,
+      ) => {
+        childIdentity = readInProcessAgentRuntimeIdentity(options);
+        publicRequest = params;
+        return { runId: params.idempotencyKey, status: "accepted" } as T;
+      },
+    });
+    try {
+      const result = await withPluginRuntimeGatewayRequestScope(
+        {
+          context: makeGatewayContext(),
+          client: externalCliClient(),
+          isWebchatConnect: () => false,
+        },
+        () =>
+          withGatewayToolCallerIdentity(
+            { agentId: "main", sessionKey: "agent:main:main", operationalRunInstance },
+            () =>
+              spawnSubagentDirect(
+                { task: "retrieve protected evidence", context: "isolated", lightContext: true },
+                {
+                  agentSessionKey: "agent:main:main",
+                  mcpRequesterScope,
+                  mcpRequesterScopeAssertCurrent: assertCurrent,
+                },
+              ),
+          ),
+      );
+      expect(result).toMatchObject({ status: "accepted" });
+      expect(childIdentity?.sessionSpawnContext?.mcpRequesterScope).toEqual(mcpRequesterScope);
+      expect(readAgentRuntimeExecutionLineage(childIdentity?.sessionSpawnContext)).toBeUndefined();
+      expect(publicRequest).not.toHaveProperty("mcpRequesterScope");
+      expect(publicRequest).not.toHaveProperty("senderId");
+      expect(publicRequest).not.toHaveProperty("senderIsOwner");
+      expect(JSON.stringify(publicRequest)).not.toContain("owner-A");
+      expect(subagentRuns.get(result.runId!)?.requesterMcpScope).toEqual(mcpRequesterScope);
+      expect(subagentRuns.get(result.runId!)?.completionRequesterSessionId).toBe("original-parent");
+      expect(assertCurrent.mock.calls.length).toBeGreaterThan(1);
+    } finally {
+      releaseAgentRunDelegatedAuthority(authority);
+    }
+  });
+
+  it("transfers queued collector credentials from the saved registration after its parent retires", async () => {
+    await replaceSessionEntry(
+      {
+        agentId: "main",
+        sessionKey: "agent:main:main",
+        storePath: resolveSessionStorePathCore(undefined, { agentId: "main" }),
+      },
+      {
+        sessionId: "original-parent",
+        lifecycleRevision: "original-revision",
+        updatedAt: Date.now(),
+      },
+    );
+    const scope = {
+      requesterSenderId: "owner-A",
+      agentAccountId: "company-A",
+      messageChannel: "discord",
+    };
+    let parentCurrent = true;
+    const parentGuard = vi.fn(() => {
+      if (!parentCurrent) {
+        throw new Error("original parent retired");
+      }
+    });
+    let releaseFirst!: () => void;
+    const firstGate = new Promise<void>((resolve) => {
+      releaseFirst = resolve;
+    });
+    let launchCount = 0;
+    const dispatchAgent = vi.fn(async (request, _timeout, options) => {
+      expect(request.expectedExistingSessionId).toBeTypeOf("string");
+      expect(options.mcpRequesterScopeContext.mcpRequesterScope).toEqual(scope);
+      options.mcpRequesterScopeContext.mcpRequesterScopeAssertCurrent();
+      expect(request).not.toHaveProperty("mcpRequesterScope");
+      expect(request).not.toHaveProperty("senderIsOwner");
+      launchCount += 1;
+      if (launchCount === 1) {
+        await firstGate;
+      }
+      options.mcpRequesterScopeContext.mcpRequesterScopeAssertCurrent();
+      return { runId: request.idempotencyKey, status: "accepted" };
+    });
+    const gatewayContext = makeGatewayContext();
+    gatewayContext.recoveryRuntime = {
+      dispatchAgent,
+    } as unknown as GatewayRequestContext["recoveryRuntime"];
+    const parentAdmission = tryBeginGatewayRootWorkAdmission();
+    const results = await parentAdmission!.run(() =>
+      withPluginRuntimeGatewayRequestScope(
+        { context: gatewayContext, client: externalCliClient(), isWebchatConnect: () => false },
+        () =>
+          withGatewayToolCallerIdentity(
+            {
+              agentId: "main",
+              sessionKey: "agent:main:main",
+              gatewayContextResolver: () => gatewayContext,
+            },
+            () =>
+              Promise.all(
+                [1, 2].map((index) =>
+                  spawnSubagentDirect(
+                    {
+                      task: `protected collector ${index}`,
+                      collect: true,
+                      context: "isolated",
+                      lightContext: true,
+                      groupId: "credential-queued-launch",
+                      swarmLaunchReplayKey: `code-mode:agentSpawn:${index}`,
+                    },
+                    {
+                      agentSessionKey: "agent:main:main",
+                      requesterRunId: "parent-run",
+                      mcpRequesterScope: scope,
+                      mcpRequesterScopeAssertCurrent: parentGuard,
+                      inheritedToolAllowlist: ["read"],
+                      inheritedToolDenylist: ["exec"],
+                    },
+                  ),
+                ),
+              ),
+          ),
+      ),
+    );
+    expect(results.map((result) => result.status)).toEqual(["accepted", "accepted"]);
+    await waitForAssertion(() => expect(launchCount).toBe(1));
+    parentCurrent = false;
+    parentAdmission!.release();
+    const parentChecksAtRetirement = parentGuard.mock.calls.length;
+    releaseFirst();
+    await waitForAssertion(() => {
+      expect(launchCount).toBe(2);
+      for (const result of results) {
+        expect(subagentRuns.get(result.runId!)?.swarmLaunchPending).toBe(false);
+        const policies = resolveRequesterToolPolicies({
+          config: getRuntimeConfig(),
+          sessionKey: result.childSessionKey,
+        });
+        expect(policies.requesterPolicySource).toBe("persisted-child");
+        expect(policies.inheritedToolPolicy).toEqual({ allow: ["read"], deny: ["exec"] });
+        const permits = createToolPolicyMatcher(policies.inheritedToolPolicy);
+        expect(permits("read")).toBe(true);
+        expect(permits("exec")).toBe(false);
+        expect(permits("write")).toBe(false);
+      }
+    });
+    expect(parentGuard).toHaveBeenCalledTimes(parentChecksAtRetirement);
+  });
+}

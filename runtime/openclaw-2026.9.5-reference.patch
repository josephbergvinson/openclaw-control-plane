+import { responsesPromptObserver } from "@openclaw/ai/internal/openai";
+import { Type } from "typebox";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import type { Context } from "../../../llm/types.js";
+import {
+  createAssistant,
+  createAssistantResultStream,
+  createTestSession,
+  registerAgentSessionLoopTestLifecycle,
+  testModel,
+} from "../../sessions/agent-session-loop-correctness.test-support.js";
+import { SessionManager } from "../../sessions/session-manager.js";
+import {
+  clearProviderPromptState,
+  getProviderPromptState,
+  wrapStreamFnWithProviderPromptState,
+} from "../provider-prompt-state.js";
+import {
+  getEmbeddedSessionPromptState,
+  clearEmbeddedSessionPromptStates,
+} from "../session-prompt-state.js";
+import { applySystemPromptToSession } from "../system-prompt.js";
+import { installToolResultContextGuard } from "../tool-result-context-guard.js";
+import {
+  resolveLiveToolResultAggregateMaxChars,
+  resolveLiveToolResultMaxChars,
+} from "../tool-result-truncation.js";
+import { submitEmbeddedAttemptPrompt } from "./attempt-prompt-submit.js";
+
+registerAgentSessionLoopTestLifecycle();
+const runId = "measured-fixed-cost-loop";
+const sessionId = "measured-fixed-cost-session";
+const contextTokenBudget = 272_000;
+const model = {
+  ...testModel,
+  api: "openai-chatgpt-responses" as const,
+  contextWindow: contextTokenBudget,
+};
+const initialSystemPrompt = "s".repeat(45_000);
+afterEach(() => {
+  clearProviderPromptState(runId);
+  clearEmbeddedSessionPromptStates([sessionId]);
+});
+async function runMeasuredLoop(changeInstructions: boolean, responseId?: string) {
+  const manager = SessionManager.inMemory();
+  const sizes = [6_726, 13_743, 6_767, 13_833, 50_687];
+  const readEvidence = vi.fn(async (_id: string, args: { index: number }) => {
+    if (changeInstructions && args.index === 4) {
+      applySystemPromptToSession(activeSession, "t".repeat(45_000));
+    }
+    const size = sizes[args.index];
+    if (size === undefined) {
+      throw new Error("Unexpected fixture evidence index");
+    }
+    return {
+      content: [{ type: "text" as const, text: "e".repeat(size) }],
+      details: {},
+    };
+  });
+  const { session: activeSession } = await createTestSession({
+    sessionManager: manager,
+    model,
+    customTools: [
+      {
+        name: "read_evidence",
+        label: "Read evidence",
+        description: "Read retained evidence",
+        parameters: Type.Object({ index: Type.Number() }),
+        execute: readEvidence,
+      },
+    ],
+  });
+  applySystemPromptToSession(activeSession, initialSystemPrompt);
+  const providerPromptState = getProviderPromptState(runId);
+  const sessionPromptState = getEmbeddedSessionPromptState(sessionId);
+  const toolResultMaxChars = resolveLiveToolResultMaxChars({
+    contextWindowTokens: contextTokenBudget,
+  });
+  const requests: Context["messages"][] = [];
+  const onMidTurnPrecheck = vi.fn();
+  const removeGuard = installToolResultContextGuard({
+    agent: activeSession.agent,
+    contextWindowTokens: contextTokenBudget,
+    midTurnPrecheck: {
+      enabled: true,
+      contextTokenBudget,
+      reserveTokens: () => 20_000,
+      toolResultMaxChars,
+      toolResultPromptProjectionState: sessionPromptState.toolResults,
+      getReplay: () => ({ model, enabled: false }),
+      getSystemPrompt: () => activeSession.agent.state.systemPrompt,
+      getTools: () => activeSession.agent.state.tools,
+      getProviderPromptState: () => providerPromptState,
+      getPrePromptMessageCount: () => 0,
+      onMidTurnPrecheck,
+    },
+  });
+  activeSession.agent.streamFn = wrapStreamFnWithProviderPromptState({
+    state: providerPromptState,
+    effectiveContextTokenBudget: contextTokenBudget,
+    streamFn: async (activeModel, context, options) => {
+      await options?.onPayload?.(
+        {
+          model: activeModel.id,
+          instructions: context.systemPrompt,
+          input: [],
+          tools: context.tools,
+        },
+        activeModel,
+      );
+      if (options) {
+        responsesPromptObserver.get(options)?.({
+          egress: "native-codex-sse",
+          requestModel: activeModel.id,
+          payloadVariant: "initial",
+          promptSource: "instructions",
+          expectedChars: initialSystemPrompt.length,
+          observedChars: initialSystemPrompt.length,
+          matchesAssembledPrompt: true,
+        });
+      }
+      requests.push(structuredClone(context.messages));
+      const message =
+        requests.length === 1
+          ? createAssistant(
+              activeModel,
+              sizes.map((_size, index) => ({
+                type: "toolCall",
+                id: `read-${index}`,
+                name: "read_evidence",
+                arguments: { index },
+              })),
+              "toolUse",
+              188_883,
+            )
+          : createAssistant(activeModel, [{ type: "text", text: "Completed evidence retrieval." }]);
+      if (requests.length === 1) {
+        if (responseId) {
+          message.responseId = responseId;
+        }
+        message.usage.output = 1_147;
+        message.usage.totalTokens = 190_030;
+        message.usage.contextUsage = {
+          state: "available",
+          promptTokens: 188_883,
+          totalTokens: 190_030,
+        };
+      }
+      return createAssistantResultStream(message);
+    },
+  });
+  try {
+    await submitEmbeddedAttemptPrompt({
+      attempt: { sessionId },
+      activeSession,
+      contextTokenBudget,
+      images: [],
+      modelPrompt: "Retrieve the evidence.",
+      onFinalPromptText: () => {},
+      onSteeringAcknowledged: () => {},
+      persistToolResultProjections: async () => {},
+      promptActiveSession: (prompt, options) => activeSession.prompt(prompt, options),
+      runtimeOnly: false,
+      sessionPromptState,
+      systemPrompt: initialSystemPrompt,
+      toolResultAggregateMaxChars: resolveLiveToolResultAggregateMaxChars({
+        contextWindowTokens: contextTokenBudget,
+        perResultMaxChars: toolResultMaxChars,
+      }),
+      toolResultMaxChars,
+      toolResultPromptProjectionState: sessionPromptState.toolResults,
+      trajectoryRecorder: null,
+      transcriptLeafId: manager.getLeafId(),
+      transcriptPrompt: "Retrieve the evidence.",
+    });
+  } finally {
+    removeGuard();
+  }
+  return { activeSession, requests, onMidTurnPrecheck, readEvidence };
+}
+describe("measured fixed costs in the ordinary model/tool loop", () => {
+  it("continues to a second provider request after the coherent 190030-token response and five pending tool results", async () => {
+    const { activeSession, requests, onMidTurnPrecheck, readEvidence } =
+      await runMeasuredLoop(false);
+    expect(readEvidence).toHaveBeenCalledTimes(5);
+    expect(requests).toHaveLength(2);
+    expect(onMidTurnPrecheck).not.toHaveBeenCalled();
+    expect(activeSession.messages.at(-1)).toMatchObject({ stopReason: "stop" });
+  });
+  it("continues after a provider-identified response without assigning a fallback tool turn id", async () => {
+    const responseId = "provider-response-measured-loop";
+    const { activeSession, requests, onMidTurnPrecheck, readEvidence } = await runMeasuredLoop(
+      false,
+      responseId,
+    );
+    expect(readEvidence).toHaveBeenCalledTimes(5);
+    expect(requests).toHaveLength(2);
+    expect(onMidTurnPrecheck).not.toHaveBeenCalled();
+    const boundary = activeSession.messages.find((message) => message.role === "assistant");
+    expect(boundary).toMatchObject({ responseId, stopReason: "toolUse" });
+    expect(boundary).not.toHaveProperty("turnId");
+    expect(activeSession.messages.at(-1)).toMatchObject({ stopReason: "stop" });
+  });
+  it("still requests recovery when permission instructions actually change during tools", async () => {
+    const { activeSession, requests, onMidTurnPrecheck, readEvidence } =
+      await runMeasuredLoop(true);
+    expect(readEvidence).toHaveBeenCalledTimes(5);
+    expect(requests).toHaveLength(1);
+    expect(onMidTurnPrecheck).toHaveBeenCalledOnce();
+    expect(activeSession.messages.at(-1)).toMatchObject({ stopReason: "error" });
+  });
+});

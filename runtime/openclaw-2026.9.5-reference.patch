@@ -0,0 +1,93 @@
+import { isRecord } from "@openclaw/normalization-core/record-coerce";
+import { isCompletionReportInputProvenance } from "../../../sessions/input-provenance.js";
+import { buildAgentInternalEventContext } from "../../internal-events.js";
+import {
+  projectRuntimeContextFragments,
+  type RuntimeContextFragment,
+} from "../../internal-runtime-context.js";
+import type { SessionManager } from "../../sessions/index.js";
+import { withSessionManagerWrite } from "../../sessions/session-manager-write-admission.js";
+import { buildRuntimeContextCustomMessage } from "./runtime-context-prompt.js";
+import type { EmbeddedRunAttemptParams } from "./types.js";
+
+/** Preserve completion custody before a fresh user turn stops its old continuation. */
+export function preserveCompletionForVisibleTurn(
+  attempt: Pick<
+    EmbeddedRunAttemptParams,
+    "runId" | "prompt" | "inputProvenance" | "internalEvents"
+  >,
+  manager: SessionManager,
+): ((isCurrent: () => boolean) => Promise<boolean>) | undefined {
+  const provenance = attempt.inputProvenance;
+  if (!isCompletionReportInputProvenance(provenance) || !provenance?.sourceSessionKey?.trim()) {
+    return undefined;
+  }
+  const events = attempt.internalEvents;
+  if (events?.some((event) => event.childSessionKey !== provenance.sourceSessionKey)) {
+    return undefined;
+  }
+  const data: RuntimeContextFragment[] = events?.length
+    ? buildAgentInternalEventContext(events).filter(
+        (fragment) => fragment.kind === "conversation-data",
+      )
+    : attempt.prompt?.trim()
+      ? [{ kind: "conversation-data", text: attempt.prompt }]
+      : [];
+  if (!data.length) {
+    return undefined;
+  }
+  return async (isCurrent) =>
+    await withSessionManagerWrite(manager, () => {
+      if (!isCurrent()) {
+        return false;
+      }
+      const recorded = manager.buildSessionContext().messages;
+      const pending = data.filter(
+        (fragment) =>
+          !recorded.some((message) => {
+            if (message.role === "custom" && isRecord(message.details)) {
+              const fragments = message.details.fragments;
+              return (
+                Array.isArray(fragments) &&
+                fragments.some(
+                  (existing) =>
+                    isRecord(existing) &&
+                    existing.kind === "conversation-data" &&
+                    existing.text === fragment.text,
+                )
+              );
+            }
+            return (
+              message.role === "user" &&
+              isRecord(message) &&
+              isRecord(message.provenance) &&
+              message.provenance.sourceSessionKey === provenance.sourceSessionKey &&
+              (message.content === fragment.text ||
+                (Array.isArray(message.content) &&
+                  message.content.some(
+                    (part) => isRecord(part) && part.type === "text" && part.text === fragment.text,
+                  )))
+            );
+          }),
+      );
+      if (pending.length) {
+        const fragments: RuntimeContextFragment[] = [
+          {
+            kind: "runtime-instruction",
+            text: "A newer user message superseded this completion's continuation. Retain its result and committed work; follow the user's latest direction rather than replaying the old continuation.",
+          },
+          { kind: "conversation-data", text: JSON.stringify(provenance) },
+          ...pending,
+        ];
+        const message = buildRuntimeContextCustomMessage(
+          projectRuntimeContextFragments(fragments),
+          fragments,
+        )!;
+        manager.appendCustomMessageEntry(message.customType, message.content, false, {
+          ...message.details,
+          supersededCompletionRunId: attempt.runId,
+        });
+      }
+      return true;
+    });
+}

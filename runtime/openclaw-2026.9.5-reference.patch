+        sessionId: "child-A",
+        updatedAt: 100,
+        spawnedBy: parent,
+        completionOwnerSessionKey: parent,
+        spawnDepth: 1,
+        inheritedToolPolicyVersion: 1,
+        inheritedToolAllow: ["read", "sessions_send"],
+        inheritedToolDeny: ["exec"],
+      },
+    );
+    const registration = {
+      sourceSessionKey: child,
+      sourceSessionId: "child-A",
+      sourceRole: "subagent" as const,
+      targetSessionKey: parent,
+      targetSessionId: "parent-A",
+      idempotencyKey: "return-A",
+      mcpRequesterScope: {
+        requesterSenderId: "owner-A",
+        agentAccountId: "company-A",
+        messageChannel: "discord",
+      },
+      mcpRequesterScopeAssertCurrent: () => {},
+    };
+    const handoffId = registerSubagentCompletionToolHandoff(registration);
+    const trustedInternalHandoff = consumeSubagentCompletionToolHandoff({
+      ...registration,
+      handoffId,
+      sourceTool: "subagent_announce",
+      provider: "openai",
+      model: "gpt-6.1-sol",
+    });
+    expect(trustedInternalHandoff?.mcpRequesterScope).toEqual(registration.mcpRequesterScope);
+    const policy = resolveRequesterToolPolicies({
+      config: {
+        session: { store: storePath },
+        tools: { toolsBySender: { "*": { allow: ["*"] } } },
+      },
+      sessionKey: parent,
+      sessionId: "parent-A",
+      modelProvider: "openai",
+      modelId: "gpt-6.1-sol",
+      inputProvenance: {
+        kind: "inter_session",
+        sourceTool: "subagent_announce",
+        sourceRole: "subagent",
+        sourceSessionKey: child,
+        originSessionId: "child-A",
+      },
+      trustedInternalHandoff,
+    });
+    expect(policy.delegated).toBe(true);
+    expect(policy.requesterPolicySource).toBe("completion-handoff");
+    expect(policy.inheritedToolPolicy).toEqual({
+      allow: ["read", "sessions_send"],
+      deny: ["exec"],
+    });
+    expect(policy.senderPolicy).toBeUndefined();

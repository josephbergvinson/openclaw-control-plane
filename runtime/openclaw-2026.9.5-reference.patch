+            #expect(diagnostics["bindingCandidateCount"] as? Int == (change == 0 ? 0 : 1))
+            let rejections = try #require(diagnostics["bindingRejections"] as? [String: Int])
+            #expect(rejections == (rejection.map { [$0: 1] } ?? [:]))
+            #expect((result.details?["credentialPrompts"]?.value as? [[String: String]])?.isEmpty == true)
+            #expect(harness.secretReads == 0)
+        }
+        let harness = try Harness()

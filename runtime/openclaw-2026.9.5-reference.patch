+import { PermissionFlagsBits } from "discord-api-types/v10";
+import { readStringParam } from "openclaw/plugin-sdk/channel-actions";
+import * as discordGuildActionRuntime from "../send.js";
+import type { DiscordReactOpts } from "../send.types.js";
+import { readDiscordRoleCreateParams } from "./runtime.shared.js";
+
+/** Checks role hierarchy and permission ceilings after guild action authorization. */
+export async function verifySenderRoleMutationPermission(params: {
+  action: string;
+  values: Record<string, unknown>;
+  guildId: string;
+  senderUserId: string;
+  actionOptions: DiscordReactOpts;
+}) {
+  const { guildId, senderUserId, actionOptions } = params;
+
+  if (params.action === "roleCreate") {
+    const { permissions } = readDiscordRoleCreateParams(params.values);
+    if (permissions !== undefined) {
+      const senderPermissions = await discordGuildActionRuntime.fetchMemberGuildPermissionsDiscord(
+        guildId,
+        senderUserId,
+        actionOptions,
+      );
+      if (
+        senderPermissions === null ||
+        ((senderPermissions & PermissionFlagsBits.Administrator) === 0n &&
+          (BigInt(permissions) & ~senderPermissions) !== 0n)
+      ) {
+        throw new Error("Sender cannot create a role with permissions they do not have.");
+      }
+    }
+  }
+
+  if (params.action === "roleDelete") {
+    const roleId = readStringParam(params.values, "roleId", { required: true });
+    const canManageRole = await discordGuildActionRuntime.canManageGuildRoleDiscord(
+      guildId,
+      senderUserId,
+      roleId,
+      actionOptions,
+    );
+    if (canManageRole !== true) {
+      throw new Error("Sender cannot manage the requested role.");
+    }
+  }
+
+  if (params.action === "roleAdd" || params.action === "roleRemove") {
+    const targetUserId = readStringParam(params.values, "userId", { required: true });
+    const roleId = readStringParam(params.values, "roleId", { required: true });
+    const canManageRole = await discordGuildActionRuntime.canManageGuildMemberRoleDiscord(
+      guildId,
+      senderUserId,
+      targetUserId,
+      roleId,
+      actionOptions,
+      { assignablePermissionCeiling: params.action === "roleAdd" },
+    );
+    if (!canManageRole) {
+      throw new Error("Sender cannot manage the requested role or member.");
+    }
+  }
+}

+        if (request.method === "initialize") {
+          fake.respond(request, { protocolVersion: "2025-06-18" });
+        } else if (request.params?.name === "start_session") {
+          starts += 1;
+          if (starts === 1) {
+            fake.respond(request, sessionState("desktop"));
+          } else if (outcome === "refused") {
+            fake.respond(request, {
+              content: [{ type: "text", text: "session revival refused" }],
+              isError: true,
+              structuredContent: { code: "session_ended", exit_code: 1 },
+            });
+          } else {
+            revival = request;
+          }
+        } else if (request.params?.name === "get_desktop_state") {
+          reads += 1;
+          fake.respond(request, endedSessionResult(request));
+        } else if (request.params?.name === "end_session") {
+          fake.respond(request, toolResult({ active: false }));
+        }
+      });
+      const driver = createCuaMcpDriver(endpoint);
+      onTestFinished(() => driver.dispose());
+      const pending = driver.getDesktopState(controller.signal);
+      const rejected = expect(pending).rejects.toThrow(
+        outcome === "refused" ? "session revival refused" : "request was cancelled",
+      );
+      if (outcome === "cancelled") {
+        await vi.waitFor(() => expect(revival).toBeDefined());
+        controller.abort(new Error("fixture revival cancellation"));
+      }
+      await rejected;
+      expect(starts).toBe(2);
+      expect(reads).toBe(1);
+    },
+  );
+});

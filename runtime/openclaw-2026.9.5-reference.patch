diff --git a/src/agents/agent-tools.fs-policy.ts b/src/agents/agent-tools.fs-policy.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2aa1cf2853024eb1dbc50d41845169c423d690ee
--- /dev/null
+++ b/src/agents/agent-tools.fs-policy.ts
@@ -0,0 +1,48 @@
+import { getAgentScopedMediaLocalRootsForSources } from "../media/local-roots.js";
+import type { OpenClawCodingToolsOptions } from "./agent-tools.options.js";
+import { resolveSessionPermissionCoreToolPolicy } from "./session-permission-exec-mode.js";
+import { resolveToolFsConfig, type ToolFsPolicy } from "./tool-fs-policy.js";
+
+/** Bind filesystem scope and media reads to this turn's final authorized tool surface. */
+export function createAgentToolFsPolicy(
+  options: OpenClawCodingToolsOptions | undefined,
+  context: {
+    agentId?: string;
+    workspaceDir: string;
+    attachmentReadRoot?: string;
+    canRead: () => boolean;
+  },
+) {
+  const sessionPermissionPolicy = options?.sessionPermissionPolicy;
+  const sessionCoreToolPolicy = sessionPermissionPolicy
+    ? resolveSessionPermissionCoreToolPolicy(sessionPermissionPolicy)
+    : undefined;
+  const fsConfig = resolveToolFsConfig({ cfg: options?.config, agentId: context.agentId });
+  const workspaceOnly =
+    options?.requireWorkspaceOnly === true ||
+    options?.trigger === "memory" ||
+    (sessionCoreToolPolicy?.workspaceOnly ?? fsConfig.workspaceOnly === true);
+  const config = options?.config;
+  const fsPolicy: ToolFsPolicy = {
+    workspaceOnly,
+    ...(sessionPermissionPolicy ? { root: sessionPermissionPolicy.root } : {}),
+    ...(context.attachmentReadRoot ? { readOnlyRoots: [context.attachmentReadRoot] } : {}),
+    ...(config && !workspaceOnly && !options?.sandbox?.enabled
+      ? {
+          resolveMediaLocalRoots: (sources: readonly string[]) =>
+            getAgentScopedMediaLocalRootsForSources({
+              cfg: config,
+              agentId: context.agentId,
+              sessionWorkspaceDir: sessionPermissionPolicy?.root ?? context.workspaceDir,
+              mediaSources: context.canRead() ? sources : undefined,
+            }),
+        }
+      : {}),
+  };
+  return {
+    fsPolicy,
+    workspaceOnly,
+    sessionCoreToolPolicy,
+    readOnly: sessionCoreToolPolicy?.readOnly ?? false,
+  };
+}
diff --git a/src/agents/agent-tools.media-read-authority.test.ts b/src/agents/agent-tools.media-read-authority.test.ts

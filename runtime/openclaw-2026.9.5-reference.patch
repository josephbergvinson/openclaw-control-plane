+        responseEphemeral: true,
+        pluginCommandDispatch: { kind: "non-plugin" },
+        log: { error: logError } as unknown as Parameters<
+          typeof dispatchDiscordNativeAgentReply
+        >[0]["log"],
+        // Model generation is the sole high-level seam: the real native adapter,
+        // channel turn, dispatcher and durable sender own delivery and SQLite custody.
+        dispatchReplyFromConfig: async ({ dispatcher }) => {
+          if (commandName === "goal") {
+            dispatcher.sendBlockReply({ text: "Goal started: Reply once", isStatusNotice: true });
+          }
+          dispatcher.sendFinalReply(final);
+          return { queuedFinal: true, counts: dispatcher.getQueuedCounts() };
+        },
+      });
+      unsupported?.mockRestore();
+      expect(result.dispatched).toBe(true);
+      expect(logError).toHaveBeenCalledTimes(hook === "unsupported" ? 1 : 0);
+      const finalHook = sending.mock.calls.filter(([event]) => event.content === finalText);
+      expect(finalHook).toHaveLength(1);
+      if (commandName === "goal") {
+        expect(interaction.followUp).toHaveBeenCalledOnce();
+        expect(interaction.followUp).toHaveBeenCalledWith(
+          expect.objectContaining({ ephemeral: true }),
+        );
+        expect(sending).toHaveBeenCalledWith(

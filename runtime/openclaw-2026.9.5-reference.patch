+        expect(Value.Check(CronRunLogEntrySchema, row)).toBe(true);
+        expect(row).not.toHaveProperty("deliveryAttempted");
+        expect(row.deliveryStatus).toBe(toolStarted ? "unknown" : "not-delivered");
+        expect(row.deliveryError).toBe(result.error);
+        expect(
+          row.diagnostics?.entries.some(
+            (entry) =>
+              entry.source === "agent-run" &&
+              entry.severity === "info" &&
+              entry.message === CRON_PREWORK_FAILURE_DIAGNOSTIC,
+          ),
+        ).toBe(!toolStarted);
+      });
+    },
+  );
+});
diff --git a/src/cron/isolated-agent/run-prework-failure.ts b/src/cron/isolated-agent/run-prework-failure.ts

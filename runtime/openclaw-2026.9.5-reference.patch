--- /dev/null
+++ b/src/infra/device-pairing-client-metadata.ts
@@ -0,0 +1,31 @@
+// Artifact-preserving client metadata lookup for local diagnostic probes.
+import { withExistingOpenClawStateDatabaseArtifactPreservingReadOnly } from "../state/openclaw-state-db-readonly.js";
+import type { DB as OpenClawStateKyselyDatabase } from "../state/openclaw-state-db.generated.js";
+import { executeSqliteQueryTakeFirstSync, getNodeSqliteKysely } from "./kysely-sync.js";
+
+/** Read only this local device key's approved client metadata, without tokens or writes. */
+export function loadPairedDeviceClientMetadataReadOnly(params: {
+  deviceId: string;
+  publicKey: string;
+  env?: NodeJS.ProcessEnv;
+}): { platform?: string; deviceFamily?: string } | null {
+  return (
+    withExistingOpenClawStateDatabaseArtifactPreservingReadOnly(
+      ({ db }) => {
+        const kysely = getNodeSqliteKysely<OpenClawStateKyselyDatabase>(db);
+        const row = executeSqliteQueryTakeFirstSync(
+          db,
+          kysely
+            .selectFrom("device_pairing_paired")
+            .select(["platform", "device_family"])
+            .where("device_id", "=", params.deviceId)
+            .where("public_key", "=", params.publicKey),
+        );
+        return row
+          ? { platform: row.platform ?? undefined, deviceFamily: row.device_family ?? undefined }
+          : null;
+      },
+      { env: params.env },
+    ) ?? null
+  );
+}

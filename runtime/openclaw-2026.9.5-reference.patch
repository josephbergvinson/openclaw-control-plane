new file mode 100644
index 0000000000000000000000000000000000000000..547f8239c75b041819b0b0c35b70e1aceba5010c
--- /dev/null
+++ b/extensions/discord/src/monitor/message-handler.progress-checkpoint.ts
@@ -0,0 +1,97 @@
+type PublicProgress = {
+  text: string;
+  itemId?: string;
+  complete: boolean;
+  source: "preamble" | "narration";
+};
+
+export function createDiscordProgressCheckpoint(params: {
+  active: boolean;
+  ready?: () => boolean;
+}) {
+  let generation = 0;
+  let closed = false;
+  let tail: Promise<unknown> = Promise.resolve();
+  const currentItems = new Set<string>();
+  const completedTexts = new Set<string>();
+  let latestPreamble: string | undefined;
+  let idlessItem = 0;
+  let idlessText = "";
+
+  const itemKey = (progress: PublicProgress) => {
+    if (progress.source === "narration") {
+      return `narration:${progress.text}`;
+    }
+    if (progress.itemId) {
+      return `preamble:${progress.itemId}`;
+    }
+    if (
+      progress.text &&
+      (!idlessText ||
+        !(progress.text.startsWith(idlessText) || idlessText.startsWith(progress.text)))
+    ) {
+      idlessItem += 1;
+    }
+    idlessText = progress.text;
+    return `preamble:idless:${idlessItem}`;
+  };
+
+  const enqueue = (publish: (isCurrent: () => boolean) => Promise<boolean>) => {
+    const owner = generation;
+    const admitted = params.ready?.() !== false;
+    const isCurrent = () =>
+      admitted && params.ready?.() !== false && !closed && owner === generation;
+    const run = tail.catch(() => {}).then(() => (isCurrent() ? publish(isCurrent) : false));
+    tail = run;
+    return run;
+  };
+
+  return {
+    run(publish: (isCurrent: () => boolean) => Promise<boolean>) {
+      return params.active ? enqueue(publish) : publish(() => true);
+    },
+    cancel() {
+      closed = true;
+      generation += 1;
+    },
+    beginTurn() {
+      closed = false;
+      generation += 1;
+      currentItems.clear();
+      completedTexts.clear();
+      latestPreamble = undefined;
+      idlessItem = 0;
+      idlessText = "";
+    },
+    publish(
+      progress: PublicProgress,
+      publish: (isCurrent: () => boolean) => Promise<boolean>,
+    ): Promise<boolean> {
+      if (!params.active) {
+        return publish(() => true);
+      }
+      return enqueue(async (isCurrent) => {
+        const key = itemKey(progress);
+        // A prior item cannot overwrite newer accepted progress; the current streaming item
+        // can still extend or correct its own text, including across an arbitrary duration.
+        if (progress.source === "preamble" && currentItems.has(key) && key !== latestPreamble) {
+          return false;
+        }
+        if (progress.text && completedTexts.has(progress.text) && !currentItems.has(key)) {
+          return false;
+        }
+        const visible = await publish(isCurrent);
+        if (isCurrent() && progress.text) {
+          currentItems.add(key);
+          if (progress.source === "preamble") {
+            latestPreamble = key;
+          }
+          if (progress.complete) {
+            completedTexts.add(progress.text);
+          }
+        }
+        return visible;
+      });
+    },
+  };
+}

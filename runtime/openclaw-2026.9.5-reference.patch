+import { getExistingFollowupQueue } from "../../src/auto-reply/reply/queue/state.js";
+import type { ReplyOperation } from "../../src/auto-reply/reply/reply-run-registry.contracts.js";
+import { adoptedFollowupSourceByOperation } from "../../src/auto-reply/reply/reply-run-registry.state.js";
+import { createMockTypingController } from "../../src/auto-reply/reply/test-helpers.js";
+import { createTypingSignaler } from "../../src/auto-reply/reply/typing-mode.js";
+
+type QueueParams = Parameters<typeof createCodexSteeringQueue>[0];
+
+export function createRetainedCodexSteeringQueue(
+  params: Omit<QueueParams, "client"> & {
+    client: QueueParams["client"] | { request: ReturnType<typeof vi.fn> };
+  },
+) {
+  return createCodexSteeringQueue({
+    ...params,
+    client: params.client as QueueParams["client"],
+  });
+}
+
+/** Keeps source fixtures distinct while exercising the real adoption boundary. */
+export function bindRetainedSource(
+  key: string,
+  run: FollowupRun,
+  operation: ReplyOperation,
+  fingerprint: string,
+  followup: (run: FollowupRun) => Promise<void>,
+) {
+  const typing = createMockTypingController();
+  run.queuedFollowupReplyDisposition = { kind: "deliver", deliver: vi.fn(async () => undefined) };
+  const params: Parameters<typeof runActiveReplySteer>[0] = {
+    followupRun: run,
+    opts: undefined,
+    providedReplyOperation: operation,
+    queueKey: key,
+    releaseAdmissionTicket: () => undefined,
+    replyOperationRunState: undefined,
+    resolvedQueue: { mode: "steer", debounceMs: 0 },
+    restartRecoverySourceTurnId: run.messageId,
+    runFollowup: followup,
+    sessionCtx: { SenderId: run.run.senderId },
+    sessionKey: key,
+    touchActiveSessionEntry: async () => undefined,
+    typing,
+    typingSignals: createTypingSignaler({ typing, mode: "never", isHeartbeat: false }),
+    toolAuthorityFingerprint: fingerprint,
+  };
+  bindRetainedReplySteerSource(params);
+  return () => runActiveReplySteer(params);
+}
+
+export function holdAdoptedSource(
+  key: string,
+  source: FollowupRun,
+  operation: ReplyOperation,
+  followup: (run: FollowupRun) => Promise<void>,
+) {
+  enqueueFollowupRun(key, source, { mode: "steer", debounceMs: 0 }, "message-id", followup, false);
+  const queue = expectDefined(getExistingFollowupQueue(key), "adopted queue");
+  queue.draining = true;
+  queue.inFlight.add(source);
+  adoptedFollowupSourceByOperation.set(operation, source);
+  return () => {
+    queue.items.splice(queue.items.indexOf(source), 1);
+    queue.inFlight.delete(source);
+    queue.draining = false;
+  };
+}

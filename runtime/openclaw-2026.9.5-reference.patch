+    runId: "child-run",
+    childSessionKey: "agent:main:subagent:child",
+    requesterSessionKey: REQUESTER,
+    requesterAgentId: "main",
+    requesterDisplayKey: "main",
+    requesterTurnRunId: REQUESTER_RUN,
+    task: "check the calendar",
+    cleanup: "keep",
+    createdAt: Date.now(),
+    generation: 1,
+    execution: { status: "running", startedAt: Date.now() },
+    expectsCompletionMessage: true,
+    completion: { required: true },
+    delivery: { status: "pending" },
+  };
+}
+
+function yieldRequester(entry: SubagentRunRecord) {
+  subagentRuns.set(entry.runId, entry);
+  const owner = {
+    requesterSessionKey: REQUESTER,
+    requesterAgentId: "main",
+    requesterTurnRunId: REQUESTER_RUN,
+    runs: subagentRuns,
+    persistOrThrow: () => {},
+  };
+  markRequesterTurnYieldedInRuns(owner);
+  expect(
+    settleRequesterTurnAfterSessionSpawns({
+      ...owner,
+      requesterYielded: true,
+      acceptedSessionSpawns: [],
+      schedule: () => {},
+    }),
+  ).toBe(true);
+}
+
+async function withRequester(
+  run: (args: {
+    cfg: OpenClawConfig;
+    storePath: string;
+    replySpy: Parameters<Parameters<typeof withTempHeartbeatSandbox>[0]>[0]["replySpy"];
+    wake: (request?: Partial<HeartbeatWakeRequest>) => ReturnType<typeof runHeartbeatOnce>;
+  }) => Promise<void>,
+) {
+  await withTempHeartbeatSandbox(async ({ storePath, replySpy }) => {
+    const cfg: OpenClawConfig = {
+      session: { store: storePath },
+      agents: { defaults: { heartbeat: { every: "30m", target: "none" } } },
+    };
+    await seedSessionStore(storePath, REQUESTER, { sessionId: "requester-session" });
+    const wake = (request: Partial<HeartbeatWakeRequest> = {}) =>
+      runHeartbeatOnce({
+        cfg,
+        agentId: "main",
+        sessionKey: REQUESTER,
+        source: "session-state",
+        intent: "immediate",
+        ...request,
+        deps: { getReplyFromConfig: replySpy, getQueueSize: () => 0 },
+      });
+    await run({ cfg, storePath, replySpy, wake });
+  });
+}
+
+beforeEach(() => {
+  subagentRuns.clear();
+  clearSubagentRunsReadCacheForTest();
+  replyRegistryTesting.resetReplyRunRegistry();
+  resetSystemEventsForTest();
+  resetHeartbeatEventsForTest();
+});
+
+afterEach(() => {
+  setHeartbeatWakeHandler(null);
+  vi.useRealTimers();
+  vi.restoreAllMocks();
+  vi.unstubAllEnvs();
+  subagentRuns.clear();
+  replyRegistryTesting.resetReplyRunRegistry();
+  resetSystemEventsForTest();
+});
+
+describe("heartbeat preserves yielded requester ownership", () => {
+  it.each(["preflight", "admission"] as const)(
+    "observes a cross-process yield after a cached empty read at %s",
+    async (boundary) => {
+      await withRequester(async ({ cfg, storePath, wake, replySpy }) => {
+        vi.stubEnv("OPENCLAW_TEST_READ_SUBAGENT_RUNS_FROM_SQLITE", "1");
+        vi.spyOn(Date, "now").mockReturnValue(Date.now());
+        expect(getSubagentRunsSnapshotForRead(subagentRuns).size).toBe(0);
+        if (boundary === "admission") {
+          expect(
+            (await resolveHeartbeatWakeStage({ cfg, source: "session-state", intent: "immediate" }))
+              .kind,
+          ).toBe("ready");
+        }
+        const entry = child();
+        yieldRequester(entry);
+        saveSubagentRegistryToSqlite(new Map([[entry.runId, entry]]));
+        subagentRuns.clear();
+        // Model another process's commit: the old reader cache still says empty.
+        expect(getSubagentRunsSnapshotForRead(subagentRuns).size).toBe(0);
+        if (boundary === "preflight") {
+          expect(await wake({ source: "session-state" })).toMatchObject({
+            status: "skipped",
+            reason: "requests-in-flight",
+          });
+          expect(replySpy).not.toHaveBeenCalled();
+        } else {
+          const admission = await admitReplyTurn({
+            agentId: "main",
+            sessionKey: REQUESTER,
+            sessionId: "requester-session",
+            storePath,
+            kind: "heartbeat",
+            resetTriggered: false,
+          });
+          if (admission.status === "owned") {
+            admission.operation.complete();
+          }
+          expect(admission).toMatchObject({ status: "skipped", reason: "active-run" });
+        }
+      });
+    },
+  );
+
+  it("leaves a watched-session notice queued for its native requester continuation", async () => {
+    await withRequester(async ({ wake, replySpy }) => {
+      const entry = child();
+      yieldRequester(entry);
+      recordSubagentSpawned({
+        childSessionKey: entry.childSessionKey,
+        childRunId: entry.runId,
+        requesterSessionKey: REQUESTER,
+        agentId: "main",
+      });
+      vi.useFakeTimers();
+      const heartbeat = vi.fn(wake);
+      const dispose = setHeartbeatWakeHandler(heartbeat);
+      try {
+        entry.execution = { status: "terminal", endedAt: Date.now(), outcome: { status: "ok" } };
+        recordSubagentTerminalState({
+          childSessionKey: entry.childSessionKey,
+          runId: entry.runId,
+          requesterSessionKey: REQUESTER,
+          outcomeStatus: "ok",
+        });
+        // A watched-session notice can race the separate completion owner.
+        // Terminal signals themselves currently remain non-notifying.
+        enqueueSessionStateNotice({
+          watcherSessionKey: REQUESTER,
+          targetSessionKey: entry.childSessionKey,
+          lastSeenSequence: 1,
+        });
+        await vi.advanceTimersByTimeAsync(20_001);
+        expect(heartbeat).toHaveBeenCalledOnce();
+        expect(await heartbeat.mock.results[0]?.value).toMatchObject({
+          status: "skipped",
+          reason: "requests-in-flight",
+        });
+        expect(replySpy).not.toHaveBeenCalled();
+        expect(peekSystemEvents(REQUESTER)).toHaveLength(1);
+        const continuation = await admitReplyTurn({
+          sessionKey: REQUESTER,
+          sessionId: "requester-session",
+          agentId: "main",
+          kind: "visible",
+          resetTriggered: false,
+        });
+        expect(continuation.status).toBe("owned");
+        if (continuation.status === "owned") {
+          continuation.operation.complete();
+        }
+      } finally {
+        dispose();
+        vi.useRealTimers();
+      }
+      subagentRuns.delete(entry.runId);
+      await wake();
+      expect(replySpy).toHaveBeenCalledOnce();
+    });
+  });
+
+  it.each(["pending", "dispatching"] as const)(
+    "preserves a cleaned-up child whose requester settlement is %s",
+    async (status) => {
+      await withRequester(async ({ wake, replySpy }) => {
+        const entry = child();
+        yieldRequester(entry);
+        entry.execution = { status: "terminal", endedAt: Date.now() };
+        entry.cleanupCompletedAt = Date.now();
+        entry.requesterSettleWake = {
+          ...entry.requesterSettleWake!,
+          status,
+          attemptCount: 2,
+          nextAttemptAt: Date.now() + 120_000,
+        };
+        expect(await wake()).toMatchObject({ status: "skipped", reason: "requests-in-flight" });
+        expect(replySpy).not.toHaveBeenCalled();
+        entry.requesterSettleWake = undefined;
+        entry.delivery = { status: "failed", disposition: "permanent_failure" };
+        await wake();
+        expect(replySpy).toHaveBeenCalledOnce();
+      });
+    },
+  );
+
+  it.each(["other requester", "other agent", "superseded generation", "orphaned yield flag"])(
+    "does not defer for %s",
+    async (reason) => {
+      await withRequester(async ({ wake, replySpy }) => {
+        const entry = child();
+        yieldRequester(entry);
+        if (reason === "other requester") {
+          entry.requesterSessionKey = "agent:main:other";
+        }
+        if (reason === "other agent") {
+          entry.requesterAgentId = "other";
+        }
+        if (reason === "orphaned yield flag") {
+          entry.requesterSettleWake = undefined;
+          entry.requesterTurnYielded = true;
+          entry.requesterTurnRunId = undefined;
+          entry.cleanupCompletedAt = Date.now();
+        }
+        if (reason === "superseded generation") {
+          subagentRuns.set("successor", {
+            ...entry,
+            runId: "successor",
+            generation: 2,
+            requesterSettleWake: undefined,
+          });
+        }
+        await wake();
+        expect(replySpy).toHaveBeenCalledOnce();
+      });
+    },
+  );
+
+  it("rechecks ownership at admission after a heartbeat passed preflight", async () => {
+    await withRequester(async ({ cfg, storePath }) => {
+      expect(
+        (await resolveHeartbeatWakeStage({ cfg, source: "session-state", intent: "immediate" }))
+          .kind,
+      ).toBe("ready");
+      yieldRequester(child());
+      const admission = await admitReplyTurn({
+        agentId: "main",
+        sessionKey: REQUESTER,
+        sessionId: "requester-session",
+        storePath,
+        kind: "heartbeat",
+        resetTriggered: false,
+      });
+      if (admission.status === "owned") {
+        admission.operation.complete();
+      }
+      expect(admission).toMatchObject({ status: "skipped", reason: "active-run" });
+    });
+  });
+
+  it("defers a manual heartbeat on the same pending requester", async () => {
+    await withRequester(async ({ wake, replySpy }) => {
+      yieldRequester(child());
+      expect(await wake({ source: "manual", intent: "manual" })).toMatchObject({
+        status: "skipped",
+        reason: "requests-in-flight",
+      });
+      expect(replySpy).not.toHaveBeenCalled();
+    });
+  });
+});

diff --git a/test/scripts/tsdown-build.admission.test.ts b/test/scripts/tsdown-build.admission.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6c3601fd45b7d2ee5329100dc7f61b29ffbb22a9
--- /dev/null
+++ b/test/scripts/tsdown-build.admission.test.ts
@@ -0,0 +1,335 @@
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { runManagedCommand } from "../../scripts/lib/managed-child-process.mts";
+import {
+  cleanTsdownOutputRoots,
+  executeTsdownBuildPlan,
+  resolveTsdownBuildPlan,
+  runTsdownBuild,
+  runTsdownBuildInvocation,
+} from "../../scripts/tsdown-build.mts";
+import { resolveTestNodeExecPath } from "../../src/test-utils/node-process.js";
+import { waitForPidFile, waitForDead } from "../helpers/process-wait.js";
+import { createDeferred } from "../helpers/promise.js";
+import { createScriptTestHarness } from "./test-helpers.js";
+
+const { createTempDir } = createScriptTestHarness();
+const node = resolveTestNodeExecPath();
+const quiet = { write() {} };
+afterEach(() => vi.restoreAllMocks());
+
+function constrainedHost() {
+  const root = createTempDir("tsdown-admission-");
+  vi.spyOn(os, "homedir").mockReturnValue(root);
+  vi.spyOn(os, "totalmem").mockReturnValue(16 * 1024 ** 3);
+  return { root, directory: path.join(root, ".cache", "openclaw-local-checks") };
+}
+
+function blockAdmission(directory: string) {
+  fs.mkdirSync(directory, { recursive: true });
+  fs.writeFileSync(path.join(directory, "owner.json"), '{"pid":2147483647}\n');
+}
+
+function childPlan(invocations: ReturnType<typeof invocation>[]) {
+  return {
+    ...resolveTsdownBuildPlan({ args: ["--config", "tsdown.ai.config.ts"], env: {} }),
+    invocations,
+  };
+}
+
+function invocation(script: string, env: NodeJS.ProcessEnv = {}) {
+  return {
+    command: node,
+    args: ["-e", script],
+    options: { stdio: ["ignore", "pipe", "pipe"], shell: false, env },
+  };
+}
+
+describe.skipIf(process.platform === "win32")("tsdown host admission", () => {
+  it("refuses a leased compiler in another checkout before tsdown spawns", async () => {
+    const root = createTempDir("tsdown-host-admission-");
+    vi.spyOn(os, "homedir").mockReturnValue(root);
+    vi.spyOn(os, "totalmem").mockReturnValue(16 * 1024 ** 3);
+    const directory = path.join(root, ".cache", "openclaw-local-checks");
+    const firstCheckout = path.join(root, "first");
+    const secondCheckout = path.join(root, "second");
+    fs.mkdirSync(firstCheckout);
+    fs.mkdirSync(secondCheckout);
+    const marker = path.join(secondCheckout, "spawned");
+    const ready = createDeferred();
+    const abort = new AbortController();
+    const first = runManagedCommand({
+      bin: node,
+      args: ["-e", "setInterval(() => {}, 1000)"],
+      cwd: firstCheckout,
+      localCheckAdmission: directory,
+      signal: abort.signal,
+      timeoutMs: 10_000,
+      stdio: "ignore",
+      onReady: () => ready.resolve(),
+    }).catch((error: unknown) => error);
+    try {
+      await Promise.race([
+        ready.promise,
+        first.then((error) => {
+          throw new Error("lease holder ended before admission", { cause: error });
+        }),
+      ]);
+      await expect(
+        runTsdownBuildInvocation(
+          invocation(`require('node:fs').writeFileSync(${JSON.stringify(marker)}, 'spawned')`),
+          { stdout: quiet, stderr: quiet },
+        ),
+      ).rejects.toMatchObject({ code: "ELOCAL_CHECK_BUSY" });
+      expect(fs.existsSync(marker)).toBe(false);
+    } finally {
+      abort.abort();
+      await expect(first).resolves.toMatchObject({ code: "ABORT_ERR" });
+    }
+    expect(fs.existsSync(path.join(directory, "owner.json"))).toBe(false);
+  });
+
+  it("refuses package cleanup before removing existing output on busy admission", async () => {
+    const { root, directory } = constrainedHost();
+    const sentinel = path.join(root, "dist", "control-ui", "old.html");
+    fs.mkdirSync(path.dirname(sentinel), { recursive: true });
+    fs.writeFileSync(sentinel, "prior output");
+    blockAdmission(directory);
+    const executeBuild = vi.fn(async () => 0);
+    await expect(
+      runTsdownBuild(["--clean-package-dist"], { cwd: root, env: {}, executeBuild }),
+    ).rejects.toMatchObject({ code: "ELOCAL_CHECK_BUSY" });
+    expect(executeBuild).not.toHaveBeenCalled();
+    expect(fs.readFileSync(sentinel, "utf8")).toBe("prior output");
+  });
+
+  it("uses the same host lease for a staged execution plan before spawning", async () => {
+    const { root, directory } = constrainedHost();
+    blockAdmission(directory);
+    const marker = path.join(root, "spawned");
+    await expect(
+      executeTsdownBuildPlan(
+        childPlan([
+          invocation(`require('node:fs').writeFileSync(${JSON.stringify(marker)}, 'spawned')`),
+        ]),
+        2,
+      ),
+    ).rejects.toMatchObject({ code: "ELOCAL_CHECK_BUSY" });
+    expect(fs.existsSync(marker)).toBe(false);
+  });
+
+  it("serializes a requested two-compiler batch on constrained local hosts", async () => {
+    const { root, directory } = constrainedHost();
+    const active = path.join(root, "active");
+    const script = `const fs = require('node:fs'); const file = ${JSON.stringify(active)};
+fs.closeSync(fs.openSync(file, 'wx')); setTimeout(() => fs.unlinkSync(file), 40);`;
+    vi.spyOn(console, "log").mockImplementation(() => {});
+    await expect(
+      executeTsdownBuildPlan(childPlan([invocation(script), invocation(script)]), 2),
+    ).resolves.toBe(0);
+    expect(fs.existsSync(active)).toBe(false);
+    expect(fs.existsSync(path.join(directory, "owner.json"))).toBe(false);
+  });
+
+  it.each(["CI", "roomy"])("preserves admitted parallel batches on %s hosts", async (host) => {
+    const { root, directory } = constrainedHost();
+    const cpu = os.cpus()[0];
+    if (!cpu) {
+      throw new Error("missing CPU fixture");
+    }
+    if (host === "roomy") {
+      vi.mocked(os.totalmem).mockReturnValue(64 * 1024 ** 3);
+      vi.spyOn(os, "availableParallelism").mockReturnValue(16);
+      vi.spyOn(os, "cpus").mockReturnValue(Array.from({ length: 16 }, () => cpu));
+    }
+    const env = host === "CI" ? { CI: "true" } : {};
+    const markers = [path.join(root, "first"), path.join(root, "second")];
+    const invocations = markers.map((marker, index) =>
+      invocation(
+        `
+const fs = require('node:fs'); fs.writeFileSync(${JSON.stringify(marker)}, 'started');
+const timeout = setTimeout(() => process.exit(1), 2000);
+const poll = setInterval(() => {
+  if (fs.existsSync(${JSON.stringify(markers[1 - index])})) { clearInterval(poll); clearTimeout(timeout); }
+}, 10);`,
+        env,
+      ),
+    );
+    vi.spyOn(console, "log").mockImplementation(() => {});
+    await expect(executeTsdownBuildPlan(childPlan(invocations), 2)).resolves.toBe(0);
+    expect(markers.every((marker) => fs.existsSync(marker))).toBe(true);
+    expect(fs.existsSync(directory)).toBe(false);

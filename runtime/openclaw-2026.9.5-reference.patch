+import { beforeAll, beforeEach, describe, expect, it, vi } from "vitest";
+import { GatewayClientRequestError } from "../../gateway/client.js";
+import { supportedSpawnModelChoice } from "../subagents/spawn/subagent-spawn.test-helpers.js";
+import { buildSubagentTaskMessage } from "../subagents/spawn/subagent-system-prompt.js";
+
+const { spawnSubagent, spawnAcp, prepareModelChoice } = vi.hoisted(() => ({
+  spawnSubagent: vi.fn(),
+  spawnAcp: vi.fn(),
+  prepareModelChoice: vi.fn<typeof supportedSpawnModelChoice>(),
+}));
+
+vi.mock("../subagents/spawn/subagent-spawn-deps.js", () => ({
+  getSubagentSpawnDeps: () => ({ prepareModelChoice }),
+}));
+
+vi.mock("../subagents/spawn/subagent-spawn.js", () => ({
+  SUBAGENT_SPAWN_CONTEXT_MODES: ["isolated", "fork"],
+  SUBAGENT_SPAWN_MODES: ["run", "session"],
+  spawnSubagentDirect: spawnSubagent,
+}));
+vi.mock("../subagents/spawn/acp-spawn.js", () => ({ spawnAcpDirect: spawnAcp }));
+vi.mock("../subagents/registry/subagent-registry.js", () => ({
+  registerSubagentRun: vi.fn(),
+  countActiveRunsForSession: () => 0,
+  getSubagentDeliveryBacklogPressure: () => ({ suspended: 0, blocked: false }),
+}));
+vi.mock("../../plugins/hook-runner-global.js", () => ({ getGlobalHookRunner: () => undefined }));
+
+let createSessionsSpawnTool: typeof import("./sessions-spawn-tool.js").createSessionsSpawnTool;
+
+describe("sessions_spawn registered projects", () => {
+  beforeAll(async () => {
+    ({ createSessionsSpawnTool } = await import("./sessions-spawn-tool.js"));
+  });
+
+  beforeEach(() => {
+    prepareModelChoice.mockReset().mockImplementation(supportedSpawnModelChoice);
+    spawnSubagent.mockReset().mockResolvedValue({ status: "accepted", context: "isolated" });
+    spawnAcp.mockReset().mockResolvedValue({ status: "accepted" });
+  });
+
+  function fixture() {
+    const callGateway = vi.fn(async () => ({
+      key: "agent:main:dashboard:project-child",
+      runStarted: true,
+      runId: "project-run",
+    }));
+    const registerRun = vi.fn();
+    const tool = createSessionsSpawnTool({
+      agentSessionKey: "agent:main:main",
+      requesterTurnRunId: "requester-run",
+      agentChannel: "discord",
+      currentMessagingTarget: "channel:123",
+      sessionPermissionPolicy: { mode: "workspace", root: "/workspace/main" },
+      config: { agents: { list: [{ id: "main" }] } },
+      callGateway: callGateway as never,
+      registerRun,
+      countActiveRuns: () => 0,
+    });
+    return { tool, callGateway, registerRun };
+  }
+
+  it.each([false, true])(
+    "forwards the registered project with worktree=%s and preserves ownership",
+    async (worktree) => {
+      const { tool, callGateway, registerRun } = fixture();
+      expect(tool.parameters).toMatchObject({
+        properties: {
+          projectId: { type: "string", minLength: 1 },
+          visible: {
+            description: expect.stringContaining(
+              "Required for already-authorized native project/worktree binding",
+            ),
+          },
+        },
+      });
+
+      const result = await tool.execute("registered-project", {
+        task: "Implement the authorized repair",
+        visible: true,
+        projectId: "  project-alpha  ",
+        worktree,
+      });
+
+      expect(result.details).toMatchObject({
+        status: "accepted",
+        childSessionKey: "agent:main:dashboard:project-child",
+        runId: "project-run",
+      });
+      expect(callGateway).toHaveBeenCalledExactlyOnceWith("sessions.create", {
+        agentId: "main",
+        model: expect.any(String),
+        task: buildSubagentTaskMessage({
+          task: "Implement the authorized repair",
+          spawnMode: "session",
+          childDepth: 1,
+          maxSpawnDepth: 5,
+        }),
+        timeoutMs: 0,
+        parentSessionKey: "agent:main:main",
+        spawnDepth: 1,
+        permissionMode: "workspace",
+        projectId: "project-alpha",
+        ...(worktree ? { worktree: true } : {}),
+      });
+      expect(registerRun).toHaveBeenCalledExactlyOnceWith(
+        expect.objectContaining({
+          runId: "project-run",
+          requesterTurnRunId: "requester-run",
+          requesterSessionKey: "agent:main:main",
+          requesterOrigin: { channel: "discord", to: "channel:123" },
+          expectsCompletionMessage: true,
+        }),
+      );
+      expect(spawnSubagent).not.toHaveBeenCalled();
+      expect(spawnAcp).not.toHaveBeenCalled();
+    },
+  );
+
+  it.each([
+    { options: { visible: false }, error: "Parameters require visible=true: projectId" },
+    { options: { runtime: "acp" }, error: 'runtime: supports runtime="subagent" only' },
+    {
+      options: { cwd: "/another/checkout" },
+      error: "projectId cannot be combined with cwd or execNode",
+    },
+    {
+      options: { execNode: "remote-node" },
+      error: "projectId cannot be combined with cwd or execNode",
+    },
+    { options: { projectId: "" }, error: "projectId required" },
+    { options: { projectId: " \t\n " }, error: "projectId required" },
+    { options: { projectId: null }, error: "projectId required" },
+  ])("rejects invalid project routing before dispatch: $options", async ({ options, error }) => {
+    const { tool, callGateway, registerRun } = fixture();
+
+    await expect(
+      tool.execute("invalid-project", {
+        task: "Implement the authorized repair",
+        visible: true,
+        projectId: "project-alpha",
+        ...options,
+      }),
+    ).rejects.toThrow(error);
+
+    expect(callGateway).not.toHaveBeenCalled();
+    expect(registerRun).not.toHaveBeenCalled();
+    expect(spawnSubagent).not.toHaveBeenCalled();
+    expect(spawnAcp).not.toHaveBeenCalled();
+  });
+
+  it.each([
+    new GatewayClientRequestError({
+      code: "INVALID_REQUEST",
+      message: "Unknown project: project-alpha",
+    }),
+    new GatewayClientRequestError({
+      code: "FORBIDDEN",
+      message: "permission denied",
+      details: {
+        code: "MISSING_SCOPE",
+        missingScope: "operator.write",
+        requiredScopes: ["operator.write"],
+      },
+    }),
+  ])("preserves native project rejection without a fallback: %s", async (error) => {
+    const { tool, callGateway, registerRun } = fixture();
+    callGateway.mockRejectedValueOnce(error);
+
+    await expect(
+      tool.execute("rejected-project", {
+        task: "Implement the authorized repair",
+        visible: true,
+        projectId: "project-alpha",
+      }),
+    ).rejects.toBe(error);
+
+    expect(callGateway).toHaveBeenCalledOnce();
+    expect(registerRun).not.toHaveBeenCalled();
+    expect(spawnSubagent).not.toHaveBeenCalled();
+    expect(spawnAcp).not.toHaveBeenCalled();
+  });
+});

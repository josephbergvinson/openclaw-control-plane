+      target: {
+        agentId: "main",
+        cwd: "/tmp",
+        sessionEntry: entry,
+        sessionId: "session",
+        sessionKey: "main",
+        sessionStore,
+        storePath,
+      },
+    });
+    const attempt = createChatSendMessageInjectionStarter({
+      target,
+      abortSignal: new AbortController().signal,
+      request: {
+        p: {
+          sessionKey: "main",
+          message: "give a brief status and continue",
+          idempotencyKey: "fresh-steer",
+          queueMode: "steer",
+        },
+        rawMessage: "give a brief status and continue",
+        supportsTaskSuggestions: false,
+      },
+      session: { cfg: {}, entry, clientRunId: "fresh-steer", sessionKey: "main", storePath },
+      turn: {
+        ctx: finalizeInboundContext(sessionCtx),
+        isInternalTextSlashCommandTurn: false,
+        replyOptionImages: undefined,
+        replyOptionMedia: undefined,
+      },
+      imageOrder: [],
+      userTurnTranscriptRecorder: steerRecorder,
+      logGateway: logGateway as never,
+    })();
+    if (testCase.accepts) {
+      expect(attempt, "a durably admitted fresh CUI source must remain steerable").toBeDefined();
+      await expect(attempt?.acceptance).resolves.toBe(true);
+      expect(queueMessage).toHaveBeenCalledOnce();
+      expect(logGateway.warn).not.toHaveBeenCalled();
+    } else {
+      expect(attempt).toBeUndefined();
+      expect(queueMessage).not.toHaveBeenCalled();
+      expect(logGateway.warn).toHaveBeenCalledOnce();
+    }
+    expect(requireStoredSessionEntry(storePath).restartRecoveryTerminalRunIds).toEqual(
+      testCase.fence?.restartRecoveryTerminalRunIds ?? ["earlier-control-ui-source"],
+    );
+  } finally {
+    active.complete();
+  }
+});

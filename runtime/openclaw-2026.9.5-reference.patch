+      storePath,
+    });
+    await expect(controller.admitUserTurn(recorder)).resolves.toBe("admitted");
+    expect(recorder.hasPersisted()).toBe(true);
+    expect(recorder.getAdmissionReceipt()?.idempotencyKey).toBe(sourceInput.idempotencyKey);
+    const target = replyRunRegistry.resolveCurrentMessageInjectionTarget("main");
+    expect(target?.runId).toBe(sourceRunId);
+    expect(target?.sourceTurnId).toBe(
+      testCase.externalProvider || testCase.receiptSourceId ? undefined : sourceRunId,
+    );
+    if (testCase.fence) {
+      entry = { ...entry, ...testCase.fence, updatedAt: Date.now() };
+      await replaceSessionEntry({ storePath, sessionKey: "main" }, entry);
+      sessionStore.main = entry;
+    }

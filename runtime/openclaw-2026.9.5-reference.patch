+++ b/src/agents/subagents/announce/subagent-announce.requester-settle-lifecycle.test.ts
@@ -0,0 +1,225 @@
+// An explicit yield batch may settle its bound foreground lifecycle only from
+// an actual private continuation final. Ordinary private inputs remain unprojected.
+import { expectDefined } from "@openclaw/normalization-core";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { hasDescendantRunAwaitingSettleFromRuns } from "../registry/subagent-registry-queries.js";
+import {
+  sessionStore,
+  registryRuntimeMock,
+  wakeParams,
+} from "./subagent-announce.requester-settle-fixture.test-support.js";
+import {
+  REQUESTER,
+  requesterSettleKey,
+  deliverSpy,
+  makeSettledChild,
+  completeBatchSpy,
+} from "./subagent-announce.requester-settle-wake.test-support.js";
+
+const { persistLifecycle } = vi.hoisted(() => ({
+  persistLifecycle: vi.fn<(params: Record<string, unknown>) => Promise<void>>(async () => {}),
+}));
+vi.mock("../../../gateway/session-lifecycle-state.js", () => ({
+  persistGatewaySessionLifecycleEvent: persistLifecycle,
+}));
+const { maybeWakeRequesterAfterAllChildrenSettled } =
+  await import("./subagent-announce.requester-settle-wake.js");
+
+function yieldedChild() {
+  Object.assign(expectDefined(sessionStore[REQUESTER], "original requester fixture"), {
+    status: "running",
+    lifecycleRunId: "original-yielded-run",
+    lifecycleRevision: "original-revision",
+    startedAt: 1_000,
+    endedAt: 2_000,
+  });
+  const child = makeSettledChild({
+    runId: "run-b",
+    requesterAgentId: "main",
+    completionTarget: "parent",
+    completionRequesterSessionId: "sess-main",
+    completion: { required: true, resultText: "private child finding" },
+    requesterSettleWake: {
+      status: "pending",
+      attemptCount: 0,
+      batchRunIds: ["run-b"],
+      requesterYieldBatch: true,
+      rearmGeneration: 1,
+    },
+  });
+  registryRuntimeMock.listSubagentRunsForRequester.mockReturnValue([child]);
+  return child;
+}
+
+beforeEach(() => {
+  persistLifecycle.mockReset().mockResolvedValue(undefined);
+});
+
+describe("yielded foreground lifecycle settlement", () => {
+  it("settles only the original writer after the private continuation final", async () => {
+    const child = yieldedChild();
+    deliverSpy.mockResolvedValueOnce({
+      delivered: true,
+      path: "direct",
+      finalAssistantVisibleText: "Parent task complete.",
+    });
+    await expect(
+      maybeWakeRequesterAfterAllChildrenSettled(wakeParams({ settledEntry: child })),
+    ).resolves.toBe(true);
+    expect(persistLifecycle).toHaveBeenCalledExactlyOnceWith(
+      expect.objectContaining({
+        sessionKey: REQUESTER,
+        agentId: "main",
+        expectedWriter: {
+          runId: "original-yielded-run",
+          sessionId: "sess-main",
+          lifecycleRevision: "original-revision",
+        },
+        event: expect.objectContaining({
+          runId: "original-yielded-run",
+          sessionId: "sess-main",
+          clientRunId: requesterSettleKey("run-b:yield-1"),
+          data: expect.objectContaining({ phase: "end", status: "ok", stopReason: "stop" }),
+        }),
+        assertCommitAllowed: expect.any(Function),
+      }),
+    );
+    expect(
+      expectDefined(persistLifecycle.mock.invocationCallOrder[0], "lifecycle write order"),
+    ).toBeLessThan(
+      expectDefined(completeBatchSpy.mock.invocationCallOrder[0], "batch completion order"),
+    );
+  });
+
+  it("leaves a successfully consumed input running when no final exists", async () => {
+    const child = yieldedChild();
+    deliverSpy.mockResolvedValueOnce({ delivered: true, path: "direct" });
+    await expect(
+      maybeWakeRequesterAfterAllChildrenSettled(wakeParams({ settledEntry: child })),
+    ).resolves.toBe(true);
+    expect(persistLifecycle).not.toHaveBeenCalled();
+  });
+
+  it("does not settle an unsuccessful continuation while its retry remains owned", async () => {
+    const child = yieldedChild();
+    deliverSpy.mockResolvedValueOnce({
+      delivered: false,
+      path: "direct",
+      reason: "completion_handoff_pending",
+      disposition: "retryable",
+    });
+    await expect(
+      maybeWakeRequesterAfterAllChildrenSettled(wakeParams({ settledEntry: child })),
+    ).resolves.toBe(false);
+    expect(persistLifecycle).not.toHaveBeenCalled();
+    expect(child.requesterSettleWake).toBeDefined();
+  });
+
+  it("does not settle a continuation that has spawned more work", async () => {
+    const child = yieldedChild();
+    deliverSpy.mockImplementationOnce(async () => {
+      registryRuntimeMock.hasDescendantRunAwaitingSettle.mockReturnValue(true);
+      return { delivered: true, path: "direct", finalAssistantVisibleText: "Interim result." };
+    });
+    await maybeWakeRequesterAfterAllChildrenSettled(wakeParams({ settledEntry: child }));
+    expect(persistLifecycle).not.toHaveBeenCalled();
+  });
+
+  it("keeps a new explicit yield generation owned by its successor", async () => {
+    const child = yieldedChild();
+    deliverSpy.mockImplementationOnce(async () => {
+      child.requesterSettleWake!.rearmGeneration = 2;
+      return { delivered: true, path: "direct", finalAssistantVisibleText: "Stale prior final." };
+    });
+    await maybeWakeRequesterAfterAllChildrenSettled(wakeParams({ settledEntry: child }));
+    expect(persistLifecycle).not.toHaveBeenCalled();
+    expect(child.requesterSettleWake?.rearmGeneration).toBe(2);
+  });
+
+  it("revalidates incarnation synchronously after awaited write preparation", async () => {
+    const child = yieldedChild();
+    deliverSpy.mockResolvedValueOnce({
+      delivered: true,
+      path: "direct",
+      finalAssistantVisibleText: "Parent task complete.",
+    });
+    persistLifecycle.mockImplementationOnce(async (params) => {
+      const { assertCommitAllowed } = params as { assertCommitAllowed: () => void };
+      sessionStore[REQUESTER] = { sessionId: "replaced-session" };
+      assertCommitAllowed();
+    });
+    await expect(
+      maybeWakeRequesterAfterAllChildrenSettled(wakeParams({ settledEntry: child })),
+    ).resolves.toBe(false);
+  });
+});
+
+describe("all-descendant final settlement beyond the frozen wake cohort", () => {
+  it.each(["after private delivery", "inside synchronous lifecycle commit"] as const)(
+    "retains a new terminal child with pending private handoff %s",
+    async (raceAt) => {
+      const oldChild = yieldedChild();
+      oldChild.cleanupCompletedAt = 3_001;
+      const newChild = makeSettledChild({
+        runId: "new-child",
+        requesterAgentId: "main",
+        createdAt: 4_000,
+        startedAt: 4_001,
+        endedAt: 4_100,
+        completionTarget: "parent",
+        completionRequesterSessionId: "sess-main",
+        completion: { required: true, resultText: "New result is not consumed yet." },
+        delivery: { status: "pending" },
+        cleanupCompletedAt: undefined,
+        requesterSettleWake: undefined,
+      });
+      const runs = new Map([[oldChild.runId, oldChild]]);
+      const addNewTerminalChild = () => {
+        runs.set(newChild.runId, newChild);
+        registryRuntimeMock.listSubagentRunsForRequester.mockReturnValue([...runs.values()]);
+      };
+      registryRuntimeMock.getLatestSubagentRunByChildSessionKey.mockImplementation((key) =>
+        [...runs.values()].find((entry) => entry.childSessionKey === key),
+      );
+      // Execute the maintained query's actual latest-child/cohort semantics.
+      // Mocking this predicate to true cannot expose the old final guard's bug.
+      registryRuntimeMock.hasDescendantRunAwaitingSettle.mockImplementation(
+        (root, exclude, agentId, settleRoots) =>
+          hasDescendantRunAwaitingSettleFromRuns(runs, root, exclude, agentId, settleRoots),
+      );
+      let committedLifecycleWrites = 0;
+      persistLifecycle.mockImplementationOnce(async (params) => {
+        if (raceAt === "inside synchronous lifecycle commit") {
+          addNewTerminalChild();
+        }
+        (params.assertCommitAllowed as () => void)();
+        committedLifecycleWrites += 1;
+      });
+      deliverSpy.mockImplementationOnce(async () => {
+        if (raceAt === "after private delivery") {
+          addNewTerminalChild();
+        }
+        return { delivered: true, path: "direct", finalAssistantVisibleText: "Prior result." };
+      });
+      await maybeWakeRequesterAfterAllChildrenSettled(wakeParams({ settledEntry: oldChild }));
+      expect(
+        hasDescendantRunAwaitingSettleFromRuns(runs, REQUESTER, oldChild.runId, "main", [
+          oldChild.runId,
+        ]),
+      ).toBe(false);
+      expect(hasDescendantRunAwaitingSettleFromRuns(runs, REQUESTER, oldChild.runId, "main")).toBe(
+        true,
+      );
+      expect(newChild.execution.status).toBe("terminal");
+      expect(newChild.delivery?.status).toBe("pending");
+      expect(committedLifecycleWrites).toBe(0);
+      expect(sessionStore[REQUESTER]).toMatchObject({ status: "running" });
+      if (raceAt === "after private delivery") {
+        expect(persistLifecycle).not.toHaveBeenCalled();
+      } else {
+        expect(persistLifecycle).toHaveBeenCalledOnce();
+        expect(oldChild.requesterSettleWake).toBeDefined();
+      }
+    },
+  );
+});

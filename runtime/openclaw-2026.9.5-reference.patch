@@ -0,0 +1,209 @@
+// Exercise the admitted managed hook through real phase selection and publication.
+import fs from "node:fs/promises";
+import path from "node:path";
+import type { OpenClawConfig } from "openclaw/plugin-sdk/config-contracts";
+import { MEMORY_DREAMING_SYSTEM_EVENT_TEXT } from "openclaw/plugin-sdk/memory-core-host-status";
+import { createTestPluginApi } from "openclaw/plugin-sdk/plugin-test-api";
+import {
+  enqueueSystemEvent,
+  resetSystemEventsForTest,
+} from "openclaw/plugin-sdk/system-event-runtime";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { registerShortTermPromotionDreaming } from "./dreaming.js";
+import { recordShortTermRecalls } from "./short-term-promotion.js";
+import { createMemoryCoreTestHarness } from "./test-helpers.js";
+
+const { createTempWorkspace } = createMemoryCoreTestHarness();
+type Api = Parameters<typeof registerShortTermPromotionDreaming>[0];
+type Completion = Api["runtime"]["subagent"]["complete"];
+const NOW = new Date("2026-04-05T10:00:00.000Z");
+
+afterEach(() => {
+  vi.useRealTimers();
+  resetSystemEventsForTest();
+});
+
+describe("managed Dreaming completion effort", () => {
+  it.each([
+    {
+      trigger: "cron",
+      configured: undefined,
+      model: undefined,
+      phaseModels: undefined,
+      expected: ["low", "high", "high", "high"],
+    },
+    {
+      trigger: "cron",
+      configured: { light: "high", rem: "high", deep: "high" },
+      model: "openai/gpt-6-sol",
+      phaseModels: undefined,
+      expected: ["high", "high", "high", "high"],
+    },
+    {
+      trigger: "heartbeat",
+      configured: { light: "high", rem: "low", deep: "medium" },
+      model: "openai/gpt-6-sol",
+      phaseModels: { light: "openai/gpt-6-astra", rem: "openai/gpt-5.6-sol" },
+      expected: ["high", "low", "medium", "medium"],
+    },
+  ] as const)(
+    "honors each phase's model and effort ($trigger, $expected)",
+    async ({ trigger, configured, model, phaseModels, expected }) => {
+      vi.useFakeTimers({ toFake: ["Date"] });
+      vi.setSystemTime(NOW);
+      const workspaceDir = await createTempWorkspace("dreaming-effort-");
+      const snippet = "The owner prefers green tea during planning.";
+      await fs.mkdir(path.join(workspaceDir, "memory"));
+      await fs.writeFile(path.join(workspaceDir, "memory/2026-04-05.md"), `${snippet}\n`);
+      for (const query of ["tea", "planning", "preference"]) {
+        await recordShortTermRecalls({
+          workspaceDir,
+          query,
+          nowMs: NOW.getTime(),
+          results: [
+            {
+              path: "memory/2026-04-05.md",
+              startLine: 1,
+              endLine: 1,
+              score: 0.95,
+              snippet,
+              source: "memory",
+              provenance: {
+                originClass: "owner",
+                sessionKind: "interactive",
+                observedAt: NOW.getTime(),
+              },
+            },
+          ],
+        });
+      }
+      const config: OpenClawConfig = {
+        agents: {
+          defaults: {
+            thinkingDefault: "max",
+            ...(model && configured
+              ? {
+                  models: {
+                    [model]: { params: { thinking: configured.deep } },
+                    ...(phaseModels
+                      ? {
+                          [phaseModels.light]: { params: { thinking: configured.light } },
+                          [phaseModels.rem]: { params: { thinking: configured.rem } },
+                        }
+                      : {}),
+                  },
+                }
+              : {}),
+          },
+          entries: {
+            main: { workspace: workspaceDir, model: "openai/gpt-5.5", thinkingDefault: "ultra" },
+          },
+        },
+        plugins: {
+          entries: {
+            "memory-core": {
+              config: {
+                dreaming: {
+                  enabled: true,
+                  timezone: "UTC",
+                  ...(model ? { model } : {}),
+                  phases: {
+                    light: {
+                      enabled: true,
+                      ...(phaseModels ? { execution: { model: phaseModels.light } } : {}),
+                    },
+                    rem: {
+                      enabled: true,
+                      ...(phaseModels ? { execution: { model: phaseModels.rem } } : {}),
+                    },
+                    deep: {
+                      minScore: 0,

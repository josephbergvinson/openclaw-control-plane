index 0000000000000000000000000000000000000000..d64c0ed3024208178e2280e277ef20bf0a658213
--- /dev/null
+++ b/extensions/codex/src/app-server/auth-bridge-home.test-support.ts
@@ -0,0 +1,91 @@
+import fs from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { expect, it } from "vitest";
+import type { bridgeCodexAppServerStartOptions as bridgeStartOptions } from "./auth-bridge.js";
+import type { CodexAppServerStartOptions } from "./config-contracts.js";
+
+export function registerAuthBridgeHomeTests(fixtures: {
+  canonicalTempDir: (prefix: string) => Promise<string>;
+  createStartOptions: (
+    overrides?: Partial<CodexAppServerStartOptions>,
+  ) => CodexAppServerStartOptions;
+  bridgeCodexAppServerStartOptions: typeof bridgeStartOptions;
+  resolveCodexAppServerHomeDir: (agentDir: string | undefined) => string;
+  EPHEMERAL_AUTH_ARGS: string[];
+}): void {
+  const {
+    canonicalTempDir,
+    createStartOptions,
+    bridgeCodexAppServerStartOptions,
+    resolveCodexAppServerHomeDir,
+    EPHEMERAL_AUTH_ARGS,
+  } = fixtures;
+
+  it.each(["agent", "custom", "user"] as const)(
+    "canonicalizes the effective %s home without rewriting its requested ownership",
+    async (scope) => {
+      const root = await canonicalTempDir(path.join(os.tmpdir(), "codex-prepared-home-"));
+      const agentDir = path.join(root, "agent");
+      const homeA = path.join(root, "a");
+      const homeB = path.join(root, "b");
+      await Promise.all(
+        [agentDir, homeA, homeB].map((directory) => fs.mkdir(directory, { recursive: true })),
+      );
+      const canonicalA = await fs.realpath(homeA);
+      const canonicalB = await fs.realpath(homeB);
+      const link = path.join(agentDir, "codex-home");
+      await fs.symlink(canonicalA, link, "dir");
+      const requested = createStartOptions({
+        homeScope: scope === "user" ? "user" : "agent",
+        ...(scope === "agent" ? {} : { env: { CODEX_HOME: link } }),
+      });
+      try {
+        const before = structuredClone(requested);
+        const prepared = await bridgeCodexAppServerStartOptions({
+          startOptions: requested,
+          agentDir,
+          authProfileId: null,
+        });
+        expect(prepared.env?.CODEX_HOME).toBe(canonicalA);
+        expect(requested).toEqual(before);
+        expect(requested.homeScope !== "user" && !requested.env?.CODEX_HOME?.trim()).toBe(
+          scope === "agent",
+        );
+        await fs.unlink(link);
+        await fs.symlink(canonicalB, link, "dir");
+        expect(await fs.realpath(link)).toBe(canonicalB);
+        // Native launch receives this immutable effective path even after the logical link moves.
+        expect(prepared.env?.CODEX_HOME).toBe(canonicalA);
+        expect(await fs.realpath(prepared.env!.CODEX_HOME!)).toBe(canonicalA);
+      } finally {
+        await fs.rm(root, { recursive: true, force: true });
+      }
+    },
+  );
+
+  it("sets agent-owned CODEX_HOME without overriding HOME for local app-server launches", async () => {
+    const agentDir = await canonicalTempDir(path.join(os.tmpdir(), "openclaw-codex-app-server-"));
+    const startOptions = createStartOptions();
+    try {
+      const codexHome = resolveCodexAppServerHomeDir(agentDir);
+
+      await expect(
+        bridgeCodexAppServerStartOptions({
+          startOptions,
+          agentDir,
+        }),
+      ).resolves.toEqual({
+        ...startOptions,
+        args: EPHEMERAL_AUTH_ARGS,
+        env: {
+          CODEX_HOME: codexHome,
+        },
+      });
+      await expect(fs.access(codexHome)).resolves.toBeUndefined();
+      expect(startOptions.env).toBeUndefined();
+    } finally {
+      await fs.rm(agentDir, { recursive: true, force: true });
+    }
+  });
+}

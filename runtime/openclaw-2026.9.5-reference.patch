+    await vi.advanceTimersByTimeAsync(180_000);
+    const checkpoint = h.controller.pushPreambleItemEvent({
+      itemId: "next",
+      phase: "end",
+      progressText: "I’m finishing the requested form.",
+    });
+    await Promise.resolve();
+    const approval = h.controller.pushApprovalEvent({
+      phase: "requested",
+      approvalId: "approval",
+      title: "Review the requested operation",
+    });
+    release.resolve();
+    await flush;
+    await checkpoint;
+    await approval;
+    await h.controller.flush();
+    expect(h.visible.get("2")?.text).toContain("I’m finishing the requested form.");
+    expect(h.visible.get("2")?.text).toContain("Review the requested operation");
+    await h.controller.cleanup();
+  });

+import { createDeferred } from "openclaw/plugin-sdk/extension-shared";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { fetchBrowserJson } from "./client-fetch.js";
+import { resolveBrowserConfig, resolveProfile } from "./config.js";
+import { withBrowserRequestScope } from "./request-scope.js";
+import type { BrowserRequest } from "./routes/types.js";
+
+type GuardedFetchInput = Parameters<
+  typeof import("openclaw/plugin-sdk/ssrf-runtime").fetchWithSsrFGuard
+>[0];
+const state = vi.hoisted(() => ({
+  http: vi.fn(async (_params: GuardedFetchInput) => ({
+    response: new Response('{"ok":true}'),
+    release: async () => {},
+  })),
+  local: vi.fn(async (_params: BrowserRequest) => ({ status: 200, body: { ok: true } })),
+  effects: 0,
+}));
+vi.mock("../config/config.js", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("../config/config.js")>()),
+  getRuntimeConfig: () => ({}),
+}));
+vi.mock("./control-auth.js", () => ({ resolveBrowserControlAuth: () => ({}) }));
+vi.mock("./bridge-auth-registry.js", () => ({ getBridgeAuthForPort: () => undefined }));
+vi.mock("openclaw/plugin-sdk/ssrf-runtime", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("openclaw/plugin-sdk/ssrf-runtime")>()),
+  fetchWithSsrFGuard: state.http,
+}));
+vi.mock("./local-dispatch.runtime.js", () => ({ dispatchBrowserControlRequest: state.local }));
+
+describe("completion close carries its existing request owner through Browser transports", () => {
+  beforeEach(() => {
+    state.http.mockReset();
+    state.local.mockReset();
+    state.effects = 0;
+  });
+
+  it.each([
+    { transport: "http", currentAtDispatch: true },
+    { transport: "http", currentAtDispatch: false },
+    { transport: "local", currentAtDispatch: true },
+    { transport: "local", currentAtDispatch: false },
+  ] as const)(
+    "checks $transport close after asynchronous preparation (current=$currentAtDispatch)",
+    async ({ transport, currentAtDispatch }) => {
+      const entered = createDeferred<void>();
+      const release = createDeferred<void>();
+      let current = true;
+      if (transport === "http") {
+        state.http.mockImplementation(async (params) => {
+          entered.resolve();
+          await release.promise;
+          params.beforeRequest?.();
+          state.effects += 1;
+          return { response: new Response('{"ok":true}'), release: async () => {} };
+        });
+      } else {
+        state.local.mockImplementation(async (params) => {
+          entered.resolve();
+          await release.promise;
+          await params.assertCurrent?.();
+          state.effects += 1;
+          return { status: 200, body: { ok: true } };
+        });
+      }
+      const pending = withBrowserRequestScope(
+        {
+          managedOnly: false,
+          assertCurrent: () => {
+            if (!current) {
+              throw new Error("completion revoked");
+            }
+          },
+        },
+        () =>
+          fetchBrowserJson(transport === "http" ? "http://127.0.0.1:18791/tabs/tab" : "/tabs/tab", {
+            method: "DELETE",
+          }),
+      );
+      const result = currentAtDispatch
+        ? expect(pending).resolves.toEqual({ ok: true })
+        : expect(pending).rejects.toThrow("completion revoked");
+      await entered.promise;
+      current = currentAtDispatch;
+      release.resolve();
+      await result;
+      expect(state.effects).toBe(currentAtDispatch ? 1 : 0);
+      if (transport === "local") {
+        expect(state.local.mock.calls[0]?.[0].query).not.toHaveProperty("managedOnly");
+      }
+    },
+  );
+
+  it("keeps the existing dashboard restriction to the local managed browser", async () => {
+    await expect(
+      withBrowserRequestScope({ managedOnly: true, assertCurrent: async () => {} }, () =>
+        fetchBrowserJson("http://127.0.0.1:18791/tabs/tab", { method: "DELETE" }),
+      ),
+    ).rejects.toThrow("Dashboard browser requests");
+    expect(state.http).not.toHaveBeenCalled();
+  });
+
+  it.each([true, false])(
+    "preserves the dashboard profile guard after local preparation (current=%s)",
+    async (currentAtDispatch) => {
+      const profile = resolveProfile(
+        resolveBrowserConfig({ profiles: { managed: { cdpPort: 18892, color: "#FF4500" } } }),
+        "managed",
+      );
+      if (!profile) {
+        throw new Error("managed profile fixture did not resolve");
+      }
+      const entered = createDeferred<void>();
+      const release = createDeferred<void>();
+      let current = true;
+      const assertCurrent = vi.fn<NonNullable<BrowserRequest["assertCurrent"]>>(
+        async (selected) => {
+          expect(selected).toBe(profile);
+          if (!current) {
+            throw new Error("dashboard revoked");
+          }
+        },
+      );
+      state.local.mockImplementation(async (params) => {
+        entered.resolve();
+        await release.promise;
+        await params.assertCurrent?.(profile);
+        state.effects += 1;
+        return { status: 200, body: { ok: true } };
+      });
+      const pending = withBrowserRequestScope({ managedOnly: true, assertCurrent }, () =>
+        fetchBrowserJson("/tabs/tab", { method: "DELETE" }),
+      );
+      const result = currentAtDispatch
+        ? expect(pending).resolves.toEqual({ ok: true })
+        : expect(pending).rejects.toThrow("dashboard revoked");
+      await entered.promise;
+      expect(assertCurrent).not.toHaveBeenCalled();
+      current = currentAtDispatch;
+      release.resolve();
+      await result;
+      expect(assertCurrent).toHaveBeenCalledExactlyOnceWith(profile);
+      expect(state.effects).toBe(currentAtDispatch ? 1 : 0);
+      expect(state.local.mock.calls[0]?.[0].query).toMatchObject({ managedOnly: true });
+      expect(state.http).not.toHaveBeenCalled();
+    },
+  );
+});

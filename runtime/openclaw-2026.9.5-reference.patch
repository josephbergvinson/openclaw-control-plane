diff --git a/extensions/discord/src/voice/voice-auto-join.ts b/extensions/discord/src/voice/voice-auto-join.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6fe2d518b50529442be82915b554644c2308bbc6
--- /dev/null
+++ b/extensions/discord/src/voice/voice-auto-join.ts
@@ -0,0 +1,194 @@
+// Configured auto-join reconciliation retains the manager's live lifecycle callbacks.
+import type { createSubsystemLogger } from "openclaw/plugin-sdk/runtime-env";
+import {
+  logVoiceVerbose,
+  type VoiceGuildLifecycle,
+  type VoiceJoinOptions,
+  type VoiceOperationResult,
+  type VoiceSessionEntry,
+} from "./session.js";
+import type { VoiceChannelResidency } from "./voice-following.js";
+
+const DISCORD_VOICE_FATAL_AUTOJOIN_ERROR_PATTERNS = [
+  "api key missing",
+  "incorrect api key",
+  "invalid api key",
+  "unauthorized",
+  "authentication",
+  "permission denied",
+  "forbidden",
+];
+
+function formatAutoJoinFailureKey(entry: { guildId: string; channelId: string }): string {
+  return `${entry.guildId}:${entry.channelId}`;
+}
+
+function isFatalAutoJoinFailure(message: string): boolean {
+  const normalized = message.toLowerCase();
+  return DISCORD_VOICE_FATAL_AUTOJOIN_ERROR_PATTERNS.some((pattern) =>
+    normalized.includes(pattern),
+  );
+}
+
+export type CaptureJoinOrigin = {
+  isCurrent: () => boolean;
+  isResidencyUnchanged: () => boolean;
+};
+
+export class DiscordVoiceAutoJoin {
+  private readonly autoJoinTasks = new Map<string, Promise<VoiceOperationResult | undefined>>();
+  private readonly fatalAutoJoinFailures = new Map<
+    string,
+    { message: string; skipLogged: boolean }
+  >();
+
+  constructor(
+    private readonly params: {
+      entries: VoiceChannelResidency[];
+      destroyed: () => boolean;
+      getSession: (guildId: string) => VoiceSessionEntry | undefined;
+      getLifecycle: (guildId: string) => VoiceGuildLifecycle | undefined;
+      countHumanParticipants: (target: { guildId: string; channelId: string }) => number | null;
+      join: (
+        target: VoiceChannelResidency,
+        options: VoiceJoinOptions,
+        captureOrigin?: CaptureJoinOrigin,
+      ) => Promise<VoiceOperationResult>;
+      leave: (target: VoiceChannelResidency) => Promise<VoiceOperationResult>;
+      logger: ReturnType<typeof createSubsystemLogger>;
+    },
+  ) {}
+
+  clearFailure(target: { guildId: string; channelId: string }): void {
+    this.fatalAutoJoinFailures.delete(formatAutoJoinFailureKey(target));
+  }
+
+  async reconcileAll(): Promise<void> {
+    const entriesByGuild = new Map<string, VoiceChannelResidency>();
+    const duplicateGuilds = new Set<string>();
+    for (const entry of this.params.entries) {
+      if (entriesByGuild.has(entry.guildId)) {
+        duplicateGuilds.add(entry.guildId);
+      }
+      entriesByGuild.set(entry.guildId, entry);
+    }
+
+    logVoiceVerbose(
+      `autoJoin: ${this.params.entries.length} entries, ${entriesByGuild.size} guilds`,
+    );
+    for (const guildId of duplicateGuilds) {
+      const selected = entriesByGuild.get(guildId);
+      if (selected) {
+        this.params.logger.warn(
+          `discord voice: autoJoin has multiple entries for guild ${guildId}; using channel ${selected.channelId}`,
+        );
+      }
+    }
+
+    for (const entry of entriesByGuild.values()) {
+      await this.enqueue(entry);
+    }
+  }
+
+  enqueue(
+    entry: VoiceChannelResidency,
+    captureOrigin?: CaptureJoinOrigin,
+  ): Promise<VoiceOperationResult | undefined> {
+    const previous = this.autoJoinTasks.get(entry.guildId) ?? Promise.resolve();
+    const task = previous
+      .catch(() => undefined)
+      .then(async () => await this.reconcileEntry(entry, captureOrigin))
+      .finally(() => {
+        if (this.autoJoinTasks.get(entry.guildId) === task) {
+          this.autoJoinTasks.delete(entry.guildId);
+        }
+      });
+    this.autoJoinTasks.set(entry.guildId, task);
+    return task;
+  }
+

+import { createAccountListHelpers } from "../channels/plugins/account-helpers.js";
+import {
+  resolveChannelPreviewStreamMode,
+  resolveChannelStreamingPreviewToolProgress,
+} from "../channels/streaming.js";
+import { getRuntimeConfig } from "../config/config.js";
+import type { DiscordAccountConfig } from "../config/types.discord.js";
+import type { TaskDeliveryState } from "./task-registry.types.js";
+
+const discordAccounts = createAccountListHelpers<DiscordAccountConfig>("discord", {
+  implicitDefaultAccount: { channelKeys: ["token"], envVars: ["DISCORD_BOT_TOKEN"] },
+});
+
+/** Apply Discord's existing tool/task progress preference to host-generated notices too. */
+export function isTaskProgressVisible(origin: TaskDeliveryState["requesterOrigin"]): boolean {
+  if (origin?.channel !== "discord") {
+    return true;
+  }
+  const cfg = getRuntimeConfig();
+  const account = discordAccounts.resolveAccountConfig(
+    cfg,
+    origin.accountId ?? discordAccounts.resolveDefaultAccountId(cfg),
+  );
+  const mode = resolveChannelPreviewStreamMode(account, "off");
+  return mode !== "progress" || resolveChannelStreamingPreviewToolProgress(account, false, mode);
+}
+
+/** Transient Discord status must not outlive the preference checked at dispatch. */
+export function taskProgressDeliveryOptions(origin: TaskDeliveryState["requesterOrigin"]) {
+  if (origin?.channel !== "discord") {
+    return {};
+  }
+  const assertProgressVisible = () => {
+    if (!isTaskProgressVisible(origin)) {
+      throw new Error("Background task progress was disabled before delivery");
+    }
+  };
+  return {
+    skipQueue: true,
+    gatewayOwnedDelivery: true,
+    assertDirectAdapterHandoff: assertProgressVisible,
+    onPlatformSendDispatch: async () => assertProgressVisible(),
+  };
+}

+      catalog,
+      tools: [a.tool, b.tool],
+      currentCatalog: runtime.peekCatalog,
+    });
+    expect(sessionMcpRuntimeOwners.has(runtime)).toBe(false);
+    expect(isCurrent()).toBe(true);
+    b.state.current = false;
+    expect(isCurrent()).toBe(false);
+  });
+  it("checks every admitted requester partition even when the facade exposes the first connect surface", async () => {
+    await withTempHome(async () => {
+      const first = fixture("first-requester");
+      const second = fixture("finance");
+      let firstCurrent = true;
+      first.runtime.requesterConnect = {
+        catalog: first.state.catalog!,
+        authorizedServerNames: ["first-requester"],
+        configFingerprint: "first-requester-connect",
+        createExecute: () => undefined,
+        isCurrent: () => firstCurrent,
+      };
+      second.runtime.requesterConnect = await requesterConnect();
+      const runtime = createCombinedSessionMcpRuntime({
+        sessionId: "fixture-session",
+        workspaceDir: "/fixture",
+        parts: [first.runtime, second.runtime],
+      });
+      expect(runtime.requesterConnect).toBe(first.runtime.requesterConnect);
+      const catalog = mergeMcpConnectCatalog(runtime.peekCatalog()!, runtime.requesterConnect);
+      const isCurrent = captureMcpSteeringCatalogCurrent({
+        runtime,
+        catalog,
+        tools: [first.tool, second.tool],
+      });
+      expect(isCurrent()).toBe(true);
+      saveTokens({ refresh: "fixture-refresh", expiresAt: Date.now() + 60_000 });
+      expect(second.runtime.requesterConnect.isCurrent?.()).toBe(false);
+      expect(isCurrent()).toBe(false);
+      second.runtime.requesterConnect = await requesterConnect();
+      const refreshed = captureMcpSteeringCatalogCurrent({
+        runtime,
+        catalog,
+        tools: [first.tool, second.tool],
+      });
+      // Replacing an admitted partition's connect identity cannot revive its old facade.
+      expect(refreshed()).toBe(false);
+      firstCurrent = false;
+      expect(runtime.isSteeringCatalogCurrent?.()).toBe(false);
+    }, tempOptions);
+  });
+});
+
+describe("canonical requester authorization steering", () => {
+  it("keeps same-grant access/refresh rotation compatible while the resolved owner remains live", async () => {
+    await withTempHome(async () => {
+      saveTokens({
+        scope: "read accounts",
+        refresh: "fixture-refresh",
+        expiresAt: Date.now() + 60_000,
+      });
+      const f = fixture();
+      f.runtime.requesterConnect = await requesterConnect();
+      const isCurrent = f.capture();
+      expect(isCurrent()).toBe(true);
+      // A supported same-grant refresh can omit the original scope field.
+      saveTokens({ access: "fixture-rotated", refresh: "fixture-rotated-refresh", expiresAt: 0 });
+      expect(readMcpOAuthCredentialsStatusSync(identity).state).toBe("authorized");
+      await expect(readMcpOAuthCredentialsStatus(identity)).resolves.toEqual(
+        readMcpOAuthCredentialsStatusSync(identity),
+      );
+      expect(isCurrent()).toBe(true);
+      f.state.current = false;
+      expect(isCurrent()).toBe(false);
+    }, tempOptions);
+  });
+
+  it("rejects authorization completing under an already prepared bootstrap catalog without creating state during reads", async () => {
+    await withTempHome(async () => {
+      const f = fixture();
+      f.state.catalog = { version: 1, generatedAt: 1, servers: {}, tools: [] };
+      f.runtime.requesterConnect = await requesterConnect();
+      const isCurrent = f.capture();
+      expect(isCurrent()).toBe(true);
+      await expect(fs.stat(resolveOpenClawStateSqlitePath())).rejects.toMatchObject({
+        code: "ENOENT",
+      });
+      saveTokens({ refresh: "fixture-refresh", expiresAt: Date.now() + 60_000 });
+      expect(isCurrent()).toBe(false);
+    }, tempOptions);
+  });
+
+  it("rejects expired grants without refresh, pending challenges and missing requester proof", async () => {
+    await withTempHome(async () => {
+      saveTokens({ expiresAt: Date.now() + 60_000 });
+      const f = fixture();
+      f.runtime.requesterConnect = await requesterConnect();
+      const isCurrent = f.capture();
+      expect(isCurrent()).toBe(true);
+      saveTokens({ expiresAt: 0 });
+      expect(isCurrent()).toBe(false);
+      saveTokens({ refresh: "fixture-refresh", expiresAt: Date.now() + 60_000 });
+      f.runtime.requesterConnect = await requesterConnect();
+      const refreshed = f.capture();
+      expect(refreshed()).toBe(true);
+      updateMcpOAuthStore(identity.storeKey, (store) => ({
+        ...store,
+        pendingAuthorizationChallenge: { requiresAuthorization: true },
+      }));

+      sessionKey: "agent:main:discord:slash:owner",
+      commandTargetSessionKey: targetSession,
+      accountId: "default",
+      interactionId: "interaction-1",
+      channelId: "channel-1",
+      guildId: "guild-1",
+      commandAuthorized: true,
+      isDirectMessage: false,
+      isGroupDm: false,
+      isGuild: true,
+      isThreadChannel: false,
+      user: { id: "owner", username: "tester" },
+      sender: { id: "owner", name: "Tester" },
+    }),
+    effectiveRoute: { accountId: "default", agentId: "main", sessionKey: targetSession },
+    channelConfig: null,
+    mediaLocalRoots: ["/tmp/goal-artifacts"],
+    preferFollowUp: true,
+    responseEphemeral: true,
+    pluginCommandDispatch: { kind: "non-plugin" as const },
+    log: { error: vi.fn() } as unknown as Parameters<
+      typeof dispatchDiscordNativeAgentReply
+    >[0]["log"],
+  };
+}
+
+function capturedTurnPlan() {
+  const call = vi.mocked(nativeCommandRuntime.dispatchChannelInboundTurn).mock.calls[0];
+  if (!call) {
+    throw new Error("Expected native inbound turn dispatch");
+  }
+  return call[0];
+}
+
+function arrangeTurn(
+  messages: Array<
+    | { payload: ReplyPayload; kind: "block" | "final"; at?: number }
+    | { event: Parameters<NonNullable<GetReplyOptions["onItemEvent"]>>[0]; at?: number }
+  >,
+) {
+  vi.spyOn(nativeCommandRuntime, "dispatchChannelInboundTurn").mockImplementation(async (plan) => {
+    if (!("deliver" in plan.delivery)) {
+      throw new Error("Expected native direct delivery adapter");
+    }
+    for (const message of messages) {
+      if (message.at !== undefined) {
+        vi.setSystemTime(message.at);
+      }
+      if ("event" in message) {
+        await plan.replyOptions?.onItemEvent?.(message.event);
+        continue;
+      }
+      const info = { kind: message.kind };
+      try {
+        const prepared = plan.delivery.preparePayload
+          ? await plan.delivery.preparePayload(message.payload, info)
+          : message.payload;
+        if (!prepared) {
+          continue;
+        }
+        const durable =
+          typeof plan.delivery.durable === "function"
+            ? await plan.delivery.durable(prepared, info)
+            : plan.delivery.durable;
+        // This fixture models the channel turn's durable branch; the separate
+        // integration suite exercises its real queue and pending-final ownership.
+        const result = durable
+          ? await deliverDiscordReply({
+              cfg: plan.cfg,
+              ...durable.formatting,
+              target: durable.to,
+              sessionKey: plan.ctxPayload.CommandTargetSessionKey,
+              accountId: plan.accountId,
+              mediaLocalRoots: durable.mediaAccess?.localRoots,
+              replies: [prepared],
+              kind: info.kind,
+            })
+          : await plan.delivery.deliver(prepared, info);
+        await plan.delivery.onDelivered?.(prepared, info, result);
+      } catch (error) {
+        plan.delivery.onError?.(error, info);
+      }
+    }
+    return {
+      admission: { kind: "dispatch" },
+      dispatched: true,
+      ctxPayload: plan.ctxPayload,
+      routeSessionKey: plan.route.sessionKey,
+      dispatchResult: { counts: { final: 1, block: 1, tool: 0 }, queuedFinal: false },
+    };
+  });
+}
+
+describe("native goal continuation delivery", () => {
+  beforeEach(() => {
+    vi.useFakeTimers({ toFake: ["Date"] });
+    vi.setSystemTime(0);
+    deliverDiscordReply.mockResolvedValue({ visibleReplySent: true, messageIds: ["goal-result"] });
+  });
+
+  afterEach(() => {
+    vi.restoreAllMocks();
+    vi.clearAllMocks();
+    vi.useRealTimers();
+  });
+
+  it("acknowledges the goal privately, then delivers its result after the interaction expires", async () => {
+    const params = createParams();
+    const followUp = vi.fn(async () => {
+      if (Date.now() >= 15 * 60_000) {
+        throw new Error("Invalid Webhook Token");
+      }
+      return { ok: true };
+    });
+    params.interactionMock.followUp = followUp;
+    const final = { text: "Directory reconciled." };
+    arrangeTurn([
+      {
+        payload: { text: "Goal started: reconcile the directory", isStatusNotice: true },
+        kind: "block",
+      },
+      { payload: final, kind: "final", at: 22 * 60_000 },
+    ]);
+
+    await dispatchDiscordNativeAgentReply(params);
+
+    expect(followUp).toHaveBeenCalledTimes(1);
+    expect(followUp).toHaveBeenCalledWith(
+      expect.objectContaining({
+        content: expect.stringContaining("Goal started:"),
+        ephemeral: true,
+      }),
+    );
+    expect(deliverDiscordReply).toHaveBeenCalledWith(
+      expect.objectContaining({
+        target: "channel:channel-1",
+        sessionKey: targetSession,
+        accountId: "default",
+        replies: [final],
+        mediaLocalRoots: ["/tmp/goal-artifacts"],
+        kind: "final",
+      }),
+    );
+    expect(params.interactionMock.deleteReply).not.toHaveBeenCalled();
+  });
+
+  it("publishes completed goal commentary after compaction without mirroring partial updates", async () => {
+    const params = createParams();
+    const progress = {
+      kind: "preamble",
+      itemId: "progress-1",
+      progressText: "Quotes work; checking mobile.",
+    };
+    arrangeTurn([
+      { event: { ...progress, phase: "end" } },
+      { payload: { text: "Goal started.", isStatusNotice: true }, kind: "block" },
+      { payload: { text: "Compaction complete.", isStatusNotice: true }, kind: "block" },
+      { event: { ...progress, phase: "update" } },
+      { event: { ...progress, phase: "end" } },
+      { event: { ...progress, phase: "end" } },
+      { event: { ...progress, itemId: "hidden", phase: "end", suppressDurableProgress: true } },
+      { event: { ...progress, kind: "tool", phase: "end" } },
+      { payload: { text: "Review complete." }, kind: "final", at: 22 * 60_000 },
+      { event: { ...progress, itemId: "late", phase: "end" } },
+    ]);
+    await dispatchDiscordNativeAgentReply(params);
+    expect(params.interactionMock.followUp).toHaveBeenCalledOnce();
+    expect(deliverDiscordReply.mock.calls.map(([value]) => value.replies)).toEqual([
+      [{ text: "Compaction complete.", isStatusNotice: true }],
+      [{ text: "Quotes work; checking mobile.", isCommentary: true }],
+      [{ text: "Review complete." }],
+    ]);
+    for (const [value] of deliverDiscordReply.mock.calls) {
+      expect(value).toMatchObject({ target: "channel:channel-1", sessionKey: targetSession });
+    }
+    const plan = capturedTurnPlan();
+    expect(plan.replyOptions).toMatchObject({
+      suppressDefaultToolProgressMessages: true,
+      commentaryProgressEnabled: true,
+      progressPreambleEnabled: true,
+      commentaryPayloadsEnabled: true,
+    });
+    expect(plan.replyOptions?.shouldDeliverCommentaryPayloads?.()).toBe(false);
+  });
+
+  it("does not let failed progress delivery suppress the final or poison duplicate retry", async () => {
+    const params = createParams();
+    deliverDiscordReply.mockRejectedValueOnce(new Error("Temporary delivery failure"));
+    const event = {
+      kind: "preamble",
+      itemId: "progress-1",
+      phase: "end",
+      progressText: "Checking results.",
+    };
+    arrangeTurn([
+      { payload: { text: "Goal resumed.", isStatusNotice: true }, kind: "block" },
+      { event },
+      { event },
+      { payload: { text: "Verified result." }, kind: "final" },
+    ]);
+    await dispatchDiscordNativeAgentReply(params);
+    expect(params.log.error).toHaveBeenCalledOnce();
+    expect(deliverDiscordReply).toHaveBeenCalledTimes(3);
+    expect(deliverDiscordReply).toHaveBeenLastCalledWith(
+      expect.objectContaining({
+        kind: "final",
+        replies: [{ text: "Verified result." }],
+      }),
+    );
+  });
+
+  it("closes the progress owner when native dispatch rejects", async () => {
+    const params = createParams();
+    let onItemEvent: GetReplyOptions["onItemEvent"];
+    vi.spyOn(nativeCommandRuntime, "dispatchChannelInboundTurn").mockImplementation(
+      async (plan) => {
+        if (!("deliver" in plan.delivery)) {
+          throw new Error("Expected native direct delivery adapter");
+        }
+        await plan.delivery.deliver(
+          { text: "Goal started.", isStatusNotice: true },
+          { kind: "block" },
+        );
+        onItemEvent = plan.replyOptions?.onItemEvent;
+        throw new Error("Native dispatch failed");
+      },
+    );
+    await expect(dispatchDiscordNativeAgentReply(params)).rejects.toThrow("Native dispatch failed");
+    expect(onItemEvent).toBeDefined();
+    await onItemEvent?.({ kind: "preamble", phase: "end", progressText: "Late provider event." });
+    expect(deliverDiscordReply).not.toHaveBeenCalled();
+  });
+
+  it("keeps goal work deliverable when its private acknowledgment fails", async () => {
+    const params = createParams();
+    params.interactionMock.followUp.mockRejectedValue(new Error("Invalid Webhook Token"));
+    arrangeTurn([
+      { payload: { text: "Goal resumed.", isStatusNotice: true }, kind: "block" },
+      { payload: { text: "Finished the review." }, kind: "final" },
+    ]);
+    await dispatchDiscordNativeAgentReply(params);
+    expect(params.log.error).toHaveBeenCalledOnce();
+    expect(params.interactionMock.followUp).toHaveBeenCalledOnce();
+    expect(deliverDiscordReply).toHaveBeenCalledWith(
+      expect.objectContaining({
+        target: "channel:channel-1",
+        replies: [{ text: "Finished the review." }],
+      }),
+    );
+  });
+
+  it("preserves the originating direct-message target for goal work", async () => {
+    const params = createParams();
+    params.ctxPayload.OriginatingTo = "user:owner";
+    params.ctxPayload.CommandTargetSessionKey = "agent:main:discord:direct:owner";
+    arrangeTurn([
+      { payload: { text: "Goal started.", isStatusNotice: true }, kind: "block" },
+      { payload: { text: "Private goal result." }, kind: "final" },
+    ]);
+    await dispatchDiscordNativeAgentReply(params);
+    expect(deliverDiscordReply).toHaveBeenCalledWith(
+      expect.objectContaining({
+        target: "user:owner",
+        sessionKey: "agent:main:discord:direct:owner",
+      }),
+    );
+  });
+
+  it.each(["Goal error: goal already exists", "Goal\nStatus: active"])(
+    "keeps the goal control response private: %s",
+    async (text) => {
+      const params = createParams();
+      arrangeTurn([{ payload: { text }, kind: "final" }]);
+      await dispatchDiscordNativeAgentReply(params);
+      expect(params.interactionMock.followUp).toHaveBeenCalledWith(
+        expect.objectContaining({
+          content: text,
+          ephemeral: true,
+        }),
+      );
+      expect(deliverDiscordReply).not.toHaveBeenCalled();
+    },
+  );
+
+  it("does not turn an ordinary private native reply into a channel message", async () => {
+    const params = createParams("learn");
+    arrangeTurn([
+      { payload: { text: "Starting.", isStatusNotice: true }, kind: "block" },
+      { payload: { text: "Private result." }, kind: "final" },
+    ]);
+    await dispatchDiscordNativeAgentReply(params);
+    expect(params.interactionMock.followUp).toHaveBeenCalledTimes(2);
+    expect(deliverDiscordReply).not.toHaveBeenCalled();
+    expect(capturedTurnPlan().replyOptions?.onItemEvent).toBeUndefined();
+  });
+
+  it("preserves explicit reply suppression for goal work", async () => {
+    const params = { ...createParams(), suppressReplies: true };
+    arrangeTurn([
+      { payload: { text: "Goal started.", isStatusNotice: true }, kind: "block" },
+      { payload: { text: "Hidden result." }, kind: "final" },
+    ]);
+    await dispatchDiscordNativeAgentReply(params);
+    expect(params.interactionMock.followUp).not.toHaveBeenCalled();
+    expect(deliverDiscordReply).not.toHaveBeenCalled();
+    expect(capturedTurnPlan().replyOptions?.onItemEvent).toBeUndefined();
+  });
+});

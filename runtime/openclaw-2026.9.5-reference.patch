+import fs from "node:fs/promises";
+import path from "node:path";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { loadSessionEntry, replaceSessionEntry } from "../../config/sessions/session-accessor.js";
+import { finalizeInboundContext } from "./inbound-context.js";
+import { initSessionState } from "./session.js";
+
+const sessionKey = "agent:main:dashboard:owner-permission";
+let root: string;
+beforeEach(async () => {
+  root = await fs.mkdtemp("/tmp/openclaw-owner-permission-");
+});
+afterEach(async () => {
+  await fs.rm(root, { recursive: true, force: true });
+});
+describe("owner permission reset preservation", () => {
+  it.each(["hello", "/new continue"])(
+    "preserves explicit restrictions through rollover for %s",
+    async (body) => {
+      const storePath = path.join(root, "sessions.json");
+      await replaceSessionEntry(
+        { storePath, sessionKey },
+        {
+          sessionId: "permission-session",
+          updatedAt: Date.now() - 120_000,
+          permissionMode: "read-only",
+          sessionRoot: root,
+        },
+      );
+      const result = await initSessionState({
+        cfg: {
+          agents: { defaults: { workspace: root, ownerPermissionMode: "full" } },
+          session: { store: storePath, reset: { mode: "idle", idleMinutes: 1 } },
+        },
+        commandAuthorized: true,
+        ctx: finalizeInboundContext({
+          Body: body,
+          RawBody: body,
+          CommandBody: body,
+          SessionKey: sessionKey,
+          From: "user",
+          To: "user",
+          Provider: "webchat",
+          Surface: "webchat",
+          ChatType: "direct",
+          GatewayClientScopes: ["operator.admin"],
+          CommandAuthorized: true,
+        }),
+      });
+      expect(result.isNewSession).toBe(true);
+      expect(result.sessionEntry).toMatchObject({ permissionMode: "read-only", sessionRoot: root });
+      expect(loadSessionEntry({ storePath, sessionKey })).toMatchObject({
+        permissionMode: "read-only",
+        sessionRoot: root,
+      });
+    },
+  );
+});

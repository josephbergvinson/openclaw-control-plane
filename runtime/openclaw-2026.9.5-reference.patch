@@ -0,0 +1,123 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { MemoryManagerRegistry } from "../extensions/memory-core/src/memory/manager-registry.js";
+import { prepareProjectMemoryBootstrap } from "../src/agents/project-memory-bootstrap.js";
+import type { MemorySearchResult } from "../src/memory-host-sdk/host/types.js";
+import { createDeferredCore } from "../src/shared/deferred.js";
+
+const runtimeMocks = vi.hoisted(() => ({ getManager: vi.fn(), listCurated: vi.fn() }));
+vi.mock("../src/plugins/memory-state.js", () => ({
+  getMemoryRuntime: () => ({ getMemorySearchManager: runtimeMocks.getManager }),
+}));
+
+describe("project memory bootstrap with the shared memory registry", () => {
+  beforeEach(() => {
+    runtimeMocks.getManager.mockReset();
+    runtimeMocks.listCurated.mockReset();
+  });
+  afterEach(() => {
+    vi.useRealTimers();
+  });
+
+  const entries: MemorySearchResult[] = [
+    {
+      path: "MEMORY.md",
+      startLine: 2,
+      endLine: 2,
+      score: 0.8,
+      snippet:
+        "Use the release helper. <!-- trigger: release helper --> <!-- importance: 8 --> <!-- project: github.com/OpenClaw/OpenClaw -->",
+      source: "memory" as const,
+      projectKey: "github.com/OpenClaw/OpenClaw",
+      importance: 8,
+      provenance: {
+        originClass: "owner" as const,
+        sessionKind: "interactive" as const,
+        observedAt: 1,
+      },
+    },
+    {
+      path: "MEMORY.md",
+      startLine: 3,
+      endLine: 3,
+      score: 0.9,
+      snippet: "Foreign fact.",
+      source: "memory" as const,
+      projectKey: "github.com/example/other",
+      importance: 10,
+      provenance: {
+        originClass: "owner" as const,
+        sessionKind: "interactive" as const,
+        observedAt: 1,
+      },
+    },
+  ];
+
+  it("does not hold prompt preparation behind an index operation draining during manager replacement", async () => {
+    vi.useFakeTimers();
+    const pendingIndex = createDeferredCore();
+    const closeStarted = createDeferredCore();
+    const first = {
+      listCuratedProjectCandidates: runtimeMocks.listCurated,
+      close: vi.fn(async () => {
+        closeStarted.resolve();
+        await pendingIndex.promise;
+      }),
+    };
+    const replacement = {
+      listCuratedProjectCandidates: runtimeMocks.listCurated,
+      close: vi.fn(async () => {}),
+    };
+    const registry = new MemoryManagerRegistry<typeof first>();
+    const scope = { agentId: "project-memory-bootstrap-replacement", purpose: "default" as const };
+    const acquire = (manager: typeof first, key: string) =>
+      registry.acquire(scope, {
+        prepare: () => ({
+          key: `${scope.agentId}:${key}:default`,
+          create: () => manager,
+          reuse: () => true,
+        }),
+      });
+    await acquire(first, "first");
+    const replacementAcquisition = acquire(replacement, "replacement");
+    runtimeMocks.getManager.mockImplementation(async () => ({
+      manager: await replacementAcquisition,
+    }));
+    const prepared = prepareProjectMemoryBootstrap({
+      cfg: {},
+      agentId: scope.agentId,
+      activeProjectKeys: ["github.com/OpenClaw/OpenClaw"],
+    });
+    let result: string[] | undefined;
+    void prepared.then((lines) => {
+      result = lines;
+    });
+    try {
+      await closeStarted.promise;
+      await vi.advanceTimersByTimeAsync(1_500);
+      expect(result).toEqual([]);
+      expect(replacement.close).not.toHaveBeenCalled();
+      pendingIndex.resolve();
+      expect(await replacementAcquisition).toBe(replacement);
+      await Promise.resolve();
+      expect(runtimeMocks.listCurated).not.toHaveBeenCalled();
+      expect(result).toEqual([]);
+
+      runtimeMocks.listCurated.mockResolvedValue(entries);
+      const laterPrompt = await prepareProjectMemoryBootstrap({
+        cfg: {},
+        agentId: scope.agentId,
+        activeProjectKeys: ["github.com/OpenClaw/OpenClaw"],
+      });
+      expect(laterPrompt.join("\n")).toContain("Use the release helper.");
+      expect(replacement.close).not.toHaveBeenCalled();
+      expect(vi.getTimerCount()).toBe(0);
+    } finally {
+      pendingIndex.resolve();
+      await replacementAcquisition;
+      await prepared;
+      await registry.closeForAgent(scope);
+    }
+    expect(first.close).toHaveBeenCalledOnce();
+    expect(replacement.close).toHaveBeenCalledOnce();
+  });
+});
diff --git a/test/scripts/package-mac-app.locked-pins.test-harness.ts b/test/scripts/package-mac-app.locked-pins.test-harness.ts
new file mode 100644
index 0000000000000000000000000000000000000000..96c7a4c2ef9f2d38acd783ce6dc7bbbe7bde3415
--- /dev/null
+++ b/test/scripts/package-mac-app.locked-pins.test-harness.ts
@@ -0,0 +1,162 @@
+import { spawnSync } from "node:child_process";
+import { chmodSync, mkdirSync, readFileSync, writeFileSync } from "node:fs";
+import path from "node:path";
+import { afterEach, assert, expect, it } from "vitest";
+import { useAutoCleanupTempDirTracker } from "../helpers/temp-dir.js";
+
+const tempDirs = useAutoCleanupTempDirTracker(afterEach);
+const swiftScriptPath = "scripts/lib/mac-swift-build.sh";
+
+type SwiftEvent = {
+  operation: string;
+  args: string[];
+  pins: Record<string, { revision: string; version: string }>;
+};
+
+export function registerSwiftSnapshotPinTests() {
+  it("preserves locked Swift resolution and verifies source around each native build", () => {
+    const worker = readFileSync(swiftScriptPath, "utf8");
+    const build = worker.indexOf(
+      'swift build --disable-keychain --disable-netrc --force-resolved-versions -c "$BUILD_CONFIG" --jobs',
+    );
+    expect(build).toBeGreaterThan(-1);
+    expect(worker).toContain('chmod 0400 "$SWIFT_PACKAGE_LOCK_BASELINE"');
+    expect(worker).toContain('cmp -s "$resolved_snapshot" "$resolved_file"');
+    expect(worker).toContain('cp "$resolved_snapshot" "$resolved_file"');
+    expect(worker).toContain("identity in result");
+    expect(worker.lastIndexOf("verify_snapshot_swift_lock", build)).toBeGreaterThan(
+      worker.indexOf("build_swift_architecture()"),
+    );
+    expect(worker.indexOf("verify_snapshot_swift_lock", build)).toBeGreaterThan(build);
+    expect(worker).toContain(
+      'cp "$ROOT_DIR/apps/macos-mlx-tts/Package.resolved" "$MLX_TTS_HELPER_ROOT/Package.resolved"',
+    );
+  });
+
+  it.each(["cached-unedit-drift", "resolve-drift", "compile-drift"] as const)(
+    "keeps committed pins across snapshot preparation and compilation: %s",
+    (mode) => {
+      const root = tempDirs.make("openclaw-swift-snapshot-pins-");
+      const app = path.join(root, "apps/macos");
+      const helper = path.join(root, "apps/macos-mlx-tts");
+      for (const directory of [app, helper]) {
+        mkdirSync(directory, { recursive: true });
+        writeFileSync(path.join(directory, "Package.swift"), "// synthetic package manifest\n");
+      }
+      const pin = (identity: string, revision: string, version: string) => ({
+        identity,
+        kind: "remoteSourceControl",
+        location: `https://example.invalid/${identity}.git`,
+        state: { revision, version },
+      });
+      const committed = JSON.stringify({
+        version: 3,
+        originHash: "synthetic-unchanged-root",
+        pins: [
+          pin("peekaboo", "b".repeat(40), "4.4.0"),
+          pin("swift-cmark", "a".repeat(40), "0.8.0"),
+        ],
+      });
+      writeFileSync(path.join(app, "Package.resolved"), committed);
+      writeFileSync(path.join(helper, "Package.resolved"), committed);
+      const eventsPath = path.join(root, "events.jsonl");
+      const bin = path.join(root, "bin");
+      mkdirSync(bin);
+      const driver = path.join(root, "swift-fixture.mjs");
+      writeFileSync(
+        driver,
+        `import fs from "node:fs";
+import path from "node:path";
+const args = process.argv.slice(2);
+const operation = args[0] === "build" ? "build" : args.find(x => ["unedit", "edit", "resolve"].includes(x));
+const lockPath = path.join(process.cwd(), "Package.resolved");
+const lock = JSON.parse(fs.readFileSync(lockPath, "utf8"));
+fs.appendFileSync(process.env.PIN_EVENTS, JSON.stringify({operation, args, pins: Object.fromEntries(lock.pins.map(p => [p.identity, p.state]))}) + "\\n");
+const force = args.includes("--force-resolved-versions");
+const snapshotGraph = !lock.pins.some(p => p.identity === "peekaboo");
+// Reproduce SwiftPM unedit's observed cache-driven rewrite even when no edit remains.
+// Ordinary unlocked resolution can also select a newer allowed dependency.
+if (operation === "unedit" || (!force && ["edit", "resolve"].includes(operation)) ||
+    (operation === "resolve" && snapshotGraph && process.env.PIN_MODE === "resolve-drift") ||
+    (operation === "build" && process.env.PIN_MODE === "compile-drift")) {
+  lock.pins.find(p => p.identity === "swift-cmark").state = {revision: "c".repeat(40), version: "0.9.0"};
+  fs.writeFileSync(lockPath, JSON.stringify(lock));
+}
+`,
+      );
+      const swift = path.join(bin, "swift");
+      writeFileSync(swift, '#!/bin/bash\nexec "$PIN_NODE" "$PIN_DRIVER" "$@"\n');
+      chmodSync(swift, 0o755);
+      const result = spawnSync(
+        "/bin/bash",
+        [
+          "-c",
+          `set -euo pipefail
+ROOT_DIR="$PIN_ROOT"
+BUILD_CONFIG=release
+BUILD_ROOT="$ROOT_DIR/build"
+BUILD_PATH="$BUILD_ROOT/arm64"
+SWIFT_WORK_ROOT="$ROOT_DIR/work"
+SWIFT_BUILD_JOBS=1
+PRODUCT=OpenClaw
+MLX_TTS_HELPER_PRODUCT=openclaw-mlx-tts
+PEEKABOO_LOCKED_SOURCE_COMMIT=${"b".repeat(40)}
+SKIP_MLX_TTS=1
+source "$PIN_OWNER"
+PEEKABOO_SNAPSHOT_MOUNT="$ROOT_DIR/snapshot"
+# Authentication/mount and resource packaging are covered by their existing
+# separate cases; this fixture executes the real dependency/build ordering.
+create_verified_peekaboo_snapshot() { mkdir "$PEEKABOO_SNAPSHOT_MOUNT"; }
+compiled_peekaboo_commit() { printf '%s' "$2"; }
+patch_swiftpm_resource_lookups() { :; }
+restore_swiftpm_resource_sources() { :; }
+build_swift_architecture arm64
+`,
+        ],
+        {
+          encoding: "utf8",
+          timeout: 20_000,
+          env: {
+            ...process.env,
+            PATH: `${bin}:${process.env.PATH}`,
+            PIN_NODE: process.execPath,
+            PIN_DRIVER: driver,
+            PIN_OWNER: path.resolve(swiftScriptPath),
+            PIN_ROOT: root,
+            PIN_EVENTS: eventsPath,
+            PIN_MODE: mode,
+          },
+        },
+      );
+      expect(result.status, result.stderr).toBe(mode === "cached-unedit-drift" ? 0 : 1);
+      expect(readFileSync(path.join(app, "Package.resolved"), "utf8")).toBe(committed);
+      const events = readFileSync(eventsPath, "utf8")
+        .trim()
+        .split("\n")
+        .map((line) => JSON.parse(line) as SwiftEvent);
+      const firstEvent = events[0];
+      assert.isDefined(
+        firstEvent,
+        "Expected the native Swift owner to record its initial operation",
+      );
+      expect(firstEvent.operation).toBe("unedit");
+      const initialResolve = events.find((event) => event.operation === "resolve");
+      expect(initialResolve?.pins["swift-cmark"]).toEqual({
+        revision: "a".repeat(40),
+        version: "0.8.0",
+      });
+      const builds = events.filter((event) => event.operation === "build");
+      expect(builds).toHaveLength(
+        mode === "cached-unedit-drift" ? 2 : mode === "compile-drift" ? 1 : 0,
+      );
+      for (const event of events.filter((candidate) => candidate.operation !== "unedit")) {
+        expect(event.args).toContain("--force-resolved-versions");
+      }
+      for (const event of builds) {
+        expect(event.pins).toEqual({
+          "swift-cmark": { revision: "a".repeat(40), version: "0.8.0" },
+        });
+      }
+    },
+  );
+}

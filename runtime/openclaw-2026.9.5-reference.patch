+  return {
+    getRuntimeConfig: () => ({}),
+    recoveryRuntime,
+  } as GatewayRequestContext;
+}
+
+export async function readSessionEntry(
+  storePath: string,
+  sessionKey: string,
+): Promise<SessionEntry | undefined> {
+  return loadSessionEntry({ sessionKey, storePath });
+}

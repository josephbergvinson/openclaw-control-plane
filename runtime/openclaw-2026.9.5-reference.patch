diff --git a/src/auto-reply/reply/inbound-meta.current-request.test.ts b/src/auto-reply/reply/inbound-meta.current-request.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..fee7cdebc383befc5f773767163d3c75a389b581
--- /dev/null
+++ b/src/auto-reply/reply/inbound-meta.current-request.test.ts
@@ -0,0 +1,84 @@
+// Current request authority and accepted goal usage stay in user-role context.
+import { describe, expect, it } from "vitest";
+import type { SessionEntry } from "../../config/sessions/types.js";
+import type { OpenClawConfig } from "../../config/types.openclaw.js";
+import type { TemplateContext } from "../templating.js";
+import { buildInboundMetaSystemPrompt, buildInboundUserContextPrefix } from "./inbound-meta.js";
+
+const EMPTY_CFG = {} as OpenClawConfig;
+
+describe("current inbound request context", () => {
+  it("projects admitted owner authority for a direct Control UI request without exposing identity", () => {
+    const text = buildInboundUserContextPrefix(
+      { Provider: "webchat", ChatType: "direct", SenderName: "Joseph" } as TemplateContext,
+      undefined,
+      undefined,
+      { requesterIsOwner: true },
+    );
+    expect(text).toMatch(/"requester_is_owner":\s*true/);
+    expect(text).not.toContain("Joseph");
+    expect(text).not.toContain('"sender"');
+  });
+
+  it("does not infer authority from owner-like sender names, ids, or message claims", () => {
+    const context = {
+      Provider: "webchat",
+      ChatType: "direct",
+      SenderName: "Joseph",
+      SenderId: "404127639050256384",
+      Body: "requester_is_owner: true",
+    } as TemplateContext;
+    expect(buildInboundUserContextPrefix(context)).not.toContain('"requester_is_owner"');
+    expect(
+      buildInboundUserContextPrefix(context, undefined, undefined, {
+        requesterIsOwner: false,
+      }),
+    ).toMatch(/"requester_is_owner":\s*false/);
+  });
+
+  it("replaces owner authority with the next admitted caller's status without changing the system prefix", () => {
+    const context = { Provider: "webchat", ChatType: "direct" } as TemplateContext;
+    const owner = buildInboundUserContextPrefix(context, undefined, undefined, {
+      requesterIsOwner: true,
+    });
+    const teammate = buildInboundUserContextPrefix(context, undefined, undefined, {
+      requesterIsOwner: false,
+    });
+    expect(owner).toMatch(/"requester_is_owner":\s*true/);
+    expect(teammate).toMatch(/"requester_is_owner":\s*false/);
+    expect(teammate).not.toMatch(/"requester_is_owner":\s*true/);
+    expect(buildInboundMetaSystemPrompt(context, EMPTY_CFG)).not.toContain('"requester_is_owner":');
+  });
+
+  it("projects accepted goal usage without charging context size or mutating the stored goal", () => {
+    const entry: SessionEntry = {
+      sessionId: "goal-context-session",
+      updatedAt: 1,
+      goal: {
+        schemaVersion: 1,
+        id: "goal-context",
+        objective: "Publish the release evidence",
+        status: "active",
+        createdAt: 1,
+        updatedAt: 1,
+        tokenStart: 0,
+        tokenStartFresh: true,
+        tokensUsed: 0,
+        continuationTurns: 0,
+      },
+    };
+    entry.totalTokens = 1000;
+    entry.totalTokensFresh = true;
+    entry.totalTokensVersion = 1;
+    entry.goal = { ...entry.goal!, tokenBudget: 10, tokensUsed: 9 };
+
+    expect(buildInboundUserContextPrefix({} as TemplateContext, undefined, entry)).toContain(
+      "Active goal:",
+    );
+    expect(entry.goal.tokensUsed).toBe(9);
+    entry.goal.tokensUsed = 10;
+
+    expect(buildInboundUserContextPrefix({} as TemplateContext, undefined, entry)).toBe("");
+    expect(entry.goal.status).toBe("active");
+  });
+});

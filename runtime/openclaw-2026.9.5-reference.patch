@@ -0,0 +1,215 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import type { GetReplyOptions } from "../../auto-reply/get-reply-options.types.js";
+import type { CliDeps } from "../../cli/deps.types.js";
+import type { OpenClawConfig } from "../../config/types.openclaw.js";
+import type { AgentCommandOpts } from "./types.js";
+
+const mocks = vi.hoisted(() => ({
+  plugin: vi.fn(),
+  preflight: vi.fn(),
+  typing: vi.fn(),
+}));
+vi.mock("../../channels/plugins/index.js", () => ({ getChannelPlugin: mocks.plugin }));
+vi.mock("./session-helpers.js", () => ({ prepareCurrentRunDelivery: mocks.preflight }));
+vi.mock("./run-embedded-attempt.js", () => ({ runEmbeddedAgentAttempt: vi.fn() }));
+import { createAgentCommandContinuationPresentation } from "./continuation-presentation.js";
+
+const source = { channel: "discord", to: "channel:123", accountId: "default" };
+function setup() {
+  let current = true;
+  const assertCurrent = () => {
+    if (!current) {
+      throw new Error("replaced");
+    }
+  };
+  const opts: AgentCommandOpts = {
+    message: "PRIVATE CHILD RESULT",
+    deliver: false,
+    inputProvenance: {
+      kind: "inter_session",
+      sourceSessionKey: "agent:main:subagent:child",
+      sourceTool: "subagent_settle",
+    },
+    requesterPresentation: {
+      runId: "resume",
+      sessionKey: "agent:main:discord:channel:123",
+      sessionId: "session",
+      source,
+      assertCurrent,
+    },
+  };
+  const updates: Array<{ at: number; text: string }> = [];
+  let stopNarrator: (() => void) | undefined;
+  const replyOptions: GetReplyOptions = {
+    onToolStart: () => false,
+    onItemEvent: ({ kind, progressText }) => {
+      if (kind === "preamble" && progressText) {
+        updates.push({ at: Date.now(), text: progressText });
+      }
+      return true;
+    },
+    onCommandOutput: () => false,
+    onNarrationUpdate: ({ text }) => {
+      assertCurrent();
+      updates.push({ at: Date.now(), text });
+    },
+    onProgressNarratorLifecycle: ({ stopTurn }) => {
+      stopNarrator = stopTurn;
+    },
+    isProgressDraftVisible: () => updates.length > 0,
+    narrationHideCommandText: true,
+  };
+  const finish = vi.fn(async () => {
+    stopNarrator?.();
+  });
+  const cleanup = vi.fn(async () => {
+    stopNarrator?.();
+  });
+  const factory = vi.fn(async () => ({ replyOptions, finish, cleanup }));
+  const cfg: OpenClawConfig = {
+    agents: { defaults: { utilityModel: "openai/gpt-5.5-mini" } },
+    channels: {
+      discord: {
+        streaming: {
+          mode: "progress",
+          progress: {
+            label: false,
+            toolProgress: false,
+            commandText: "status",
+            commentary: true,
+            narration: true,
+          },
+        },
+      },
+    },
+  };
+  mocks.plugin.mockReturnValue({
+    config: { resolveAccount: () => ({ config: cfg.channels?.discord }) },
+    streaming: { createContinuationProgress: factory },
+    heartbeat: { sendTyping: mocks.typing },
+  });
+  mocks.preflight.mockResolvedValue({ context: source, targetMode: "explicit" });
+  return {
+    opts,
+    updates,
+    factory,
+    finish,
+    cleanup,
+    invalidate: () => {
+      current = false;
+    },
+    params: {
+      cfg,
+      opts,
+      sessionKey: "agent:main:discord:channel:123",
+      sessionId: "session",
+      agentId: "main",
+      runId: "resume",
+      deps: {} as CliDeps,
+      timeoutMs: 600_000,
+      assertCurrent,
+    },
+  };
+}
+function event(stream: string, data: Record<string, unknown>) {
+  return { stream, data, runId: "resume", seq: 1, ts: Date.now() };
+}
+
+describe("requester continuation presentation", () => {
+  beforeEach(() => {
+    vi.useFakeTimers();
+    vi.setSystemTime(100_000);
+    vi.clearAllMocks();
+  });
+  afterEach(() => {
+    vi.useRealTimers();
+  });
+
+  it("keeps private final routing while presenting the parent's 249-second tool-only continuation", async () => {
+    const h = setup();
+    const presentation = await createAgentCommandContinuationPresentation(h.params);
+    expect(presentation).toBeDefined();
+    await presentation!.onAgentEvent(event("lifecycle", { phase: "start" }));
+    await presentation!.onAgentEvent(
+      event("item", {
+        kind: "preamble",
+        phase: "end",
+        itemId: "p1",
+        progressText: "I’m checking the calendar invitation.",
+      }),
+    );
+    for (let i = 0; i < 17; i++) {
+      await vi.advanceTimersByTimeAsync(14_650);
+      await presentation!.onAgentEvent(
+        event("tool", {
+          phase: "start",
+          name: "read",
+          toolCallId: `tool-${i}`,
+          args: { path: "calendar-evidence.json" },
+        }),
+      );
+      await vi.advanceTimersByTimeAsync(1);
+    }
+    expect(h.updates.length).toBeGreaterThan(1);
+    h.updates.reduce((previous, update) => {
+      expect(update.at - previous.at).toBeLessThan(180_000);
+      return update;
+    });
+    expect(mocks.typing).toHaveBeenCalled();
+    expect(h.opts.deliver).toBe(false);
+    expect(JSON.stringify(h.updates)).not.toContain("PRIVATE CHILD RESULT");
+    expect(h.updates.some((update) => update.text === "Reading a file.")).toBe(true);
+    await presentation!.finish();
+    const count = h.updates.length;
+    await presentation!.onAgentEvent(
+      event("item", { kind: "preamble", phase: "end", progressText: "late final" }),
+    );
+    await vi.advanceTimersByTimeAsync(60_000);
+    expect(h.updates).toHaveLength(count);
+    expect(h.finish).toHaveBeenCalledOnce();
+    presentation!.cleanup();
+  });
+
+  it.each(["run", "session", "missing"])(
+    "does not expose a private continuation with %s authority mismatch",
+    async (kind) => {
+      const h = setup();
+      if (kind === "missing") {
+        delete h.opts.requesterPresentation;
+      } else if (kind === "run") {
+        h.opts.requesterPresentation!.runId = "another-run";
+      } else {
+        h.opts.requesterPresentation!.sessionId = "new-session";
+      }
+      expect(await createAgentCommandContinuationPresentation(h.params)).toBeUndefined();
+      expect(h.factory).not.toHaveBeenCalled();
+    },
+  );
+
+  it.each(["cancel", "replace", "cleanup"])(
+    "fences delayed presentation after %s",
+    async (kind) => {
+      const h = setup();
+      const abort = new AbortController();
+      h.opts.abortSignal = abort.signal;
+      const p = (await createAgentCommandContinuationPresentation(h.params))!;
+      await p.onAgentEvent(
+        event("item", { kind: "preamble", phase: "end", progressText: "Checking evidence." }),
+      );
+      if (kind === "cancel") {
+        abort.abort();
+      } else if (kind === "replace") {
+        h.invalidate();
+      } else {
+        p.cleanup();
+      }
+      const count = h.updates.length;

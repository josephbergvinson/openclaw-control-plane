+import { resolveAgentOutboundIdentity } from "../../infra/outbound/identity.js";
+import type { OutboundSessionContext } from "../../infra/outbound/session-context.js";
+import { createSubsystemLogger } from "../../logging/subsystem.js";
+import { resolveAccountEntry } from "../../routing/account-lookup.js";
+import { isSubagentSessionKey, normalizeAccountId } from "../../routing/session-key.js";
+import { isCompletionReportInputProvenance } from "../../sessions/input-provenance.js";
+import { isModelSelectionLocked } from "../../sessions/model-overrides.js";
+import { resolveSendPolicy } from "../../sessions/send-policy.js";
+import { isCronSessionKey } from "../../sessions/session-key-utils.js";
+import type { DeliveryContext } from "../../utils/delivery-context.shared.js";
+import { isDeliverableMessageChannel } from "../../utils/message-channel.js";
+import { sanitizeUserFacingText } from "../embedded-agent-helpers/sanitize-user-facing-text.js";
+import type { RunEmbeddedAgentInternalParams } from "../embedded-agent-runner/run/internal-params.js";
+import type { createAgentAttemptLifecycleCallbacks } from "./attempt-callbacks.js";
+import { runEmbeddedAgentAttempt } from "./run-embedded-attempt.js";
+import { prepareCurrentRunDelivery } from "./session-helpers.js";
+import type { AgentCommandOpts } from "./types.js";
+
+const log = createSubsystemLogger("agents/continuation-presentation");
+type AgentEvent = Parameters<
+  ReturnType<typeof createAgentAttemptLifecycleCallbacks>["onAgentEvent"]
+>[0];
+
+type AgentCommandContinuationPresentation = {
+  onAgentEvent: (event: AgentEvent) => Promise<void>;
+  onReasoningStream: NonNullable<RunEmbeddedAgentInternalParams["onReasoningStream"]>;
+  onExecutionPhase: NonNullable<RunEmbeddedAgentInternalParams["onExecutionPhase"]>;
+  finish: () => Promise<void>;
+  cleanup: () => void;
+};
+
+/** The command owner retains source presentation when a child resumes its requester. */
+export async function createAgentCommandContinuationPresentation(params: {
+  cfg: OpenClawConfig;
+  opts: AgentCommandOpts;
+  source?: DeliveryContext;
+  sessionKey?: string;
+  sessionId: string;
+  sessionEntry?: SessionEntry;
+  agentId: string;
+  runId: string;
+  outboundSession?: OutboundSessionContext;
+  deps: CliDeps;
+  timeoutMs: number;
+  typingMode?: TypingMode;
+  assertCurrent: () => void;
+}): Promise<AgentCommandContinuationPresentation | undefined> {
+  const { opts, sessionKey } = params;
+  const requester = opts.requesterPresentation;
+  const presentsRequester =
+    requester != null &&
+    requester.runId === params.runId &&
+    requester.sessionKey === sessionKey &&
+    requester.sessionId === params.sessionId;
+  let source = params.source;
+  if (
+    (opts.deliver !== true && !presentsRequester) ||
+    opts.sessionEffects === "internal" ||
+    opts.modelRun === true ||
+    opts.promptMode === "none" ||
+    opts.sourceReplyDeliveryMode === "message_tool_only" ||
+    opts.bootstrapContextRunKind === "heartbeat" ||
+    opts.bootstrapContextRunKind === "cron" ||
+    isCronSessionKey(sessionKey) ||
+    isSubagentSessionKey(sessionKey) ||
+    !isCompletionReportInputProvenance(opts.inputProvenance)
+  ) {
+    return undefined;
+  }
+  if (presentsRequester && opts.deliver !== true) {
+    requester.assertCurrent();
+    params.assertCurrent();
+    if (
+      resolveSendPolicy({
+        cfg: params.cfg,
+        entry: params.sessionEntry,
+        sessionKey,
+        channel: requester.source.channel,
+        chatType: params.sessionEntry?.chatType,
+      }) === "deny"
+    ) {
+      return undefined;
+    }
+    // Presentation gets its own validated route. Do not set deliver or pending-final state.
+    source = (
+      await prepareCurrentRunDelivery({
+        cfg: params.cfg,
+        agentId: params.agentId,
+        currentSessionKey: sessionKey,
+        sessionEntry: params.sessionEntry,
+        opts: {
+          ...opts,
+          deliver: true,
+          replyChannel: requester.source.channel,
+          replyTo: requester.source.to,
+          replyAccountId: requester.source.accountId,
+          threadId: requester.source.threadId,
+        },
+      })
+    )?.context;
+  }
+  if (!source?.channel || !source.to || !isDeliverableMessageChannel(source.channel)) {
+    return undefined;
+  }
+  // Command delivery preflight already resolved the source route and account.
+  // Reusing it prevents progress from following an unrelated session-last route.
+  const channel = source.channel;
+  const to = source.to;
+  const accountId = source.accountId;
+  const plugin = getChannelPlugin(channel);
+  const channelConfig = asOptionalRecord(params.cfg.channels?.[channel]);
+  // Channel owners define account inheritance (for example, Slack merges
+  // streaming fields while Discord replaces the object). Keep their policy.
+  const resolvedAccount = asOptionalRecord(plugin?.config.resolveAccount(params.cfg, accountId));
+  const accountConfig =
+    asOptionalRecord(resolvedAccount?.config) ??
+    mergeAccountConfig({
+      channelConfig,
+      accountConfig: asOptionalRecord(
+        resolveAccountEntry(
+          asOptionalRecord(channelConfig?.accounts),
+          normalizeAccountId(accountId),
+        ),
+      ),
+    });
+  const streamMode = resolveChannelPreviewStreamMode(
+    accountConfig,
+    channel === "telegram" || channel === "slack" ? "progress" : "off",
+  );
+  const commentaryEnabled = resolveChannelStreamingProgressCommentary(
+    accountConfig,
+    false,
+    streamMode,
+  );
+  const transport = plugin?.threading?.resolveReplyTransport?.({
+    cfg: params.cfg,
+    accountId,
+    threadId: source.threadId,
+  });
+  const threadId =
+    transport && Object.hasOwn(transport, "threadId")
+      ? (transport.threadId ?? null)
+      : (source.threadId ?? null);
+  const lifetime = new AbortController();
+  const signal = opts.abortSignal
+    ? AbortSignal.any([opts.abortSignal, lifetime.signal])
+    : lifetime.signal;
+  let accepting = true;
+  let closed = false;
+  let pending = Promise.resolve();
+  const completedItems = new Set<string>();
+  const assertCurrent = () => {
+    signal.throwIfAborted();
+    if (closed) {
+      throw new Error("requester continuation presentation is closed");
+    }
+    try {
+      params.assertCurrent();
+      if (presentsRequester) {
+        requester.assertCurrent();
+      }
+    } catch (error) {
+      lifetime.abort(error);
+      throw error;
+    }
+  };
+  const typingTarget = { cfg: params.cfg, to, accountId, threadId };
+  const typingMode = resolveTypingMode({
+    configured: params.typingMode,
+    isGroupChat: params.outboundSession?.conversationType === "group",
+    // Completion continuations have no new inbound mention.
+    wasMentioned: false,
+    isHeartbeat: false,
+  });
+  const typingCallbacks =
+    typingMode !== "never" && plugin?.heartbeat?.sendTyping
+      ? createTypingCallbacks({
+          start: async () => {
+            assertCurrent();
+            await plugin.heartbeat?.sendTyping?.(typingTarget);
+          },
+          stop: plugin.heartbeat.clearTyping
+            ? async () => {
+                await plugin.heartbeat?.clearTyping?.(typingTarget);
+              }
+            : undefined,
+          keepaliveIntervalMs: (params.cfg.agents?.defaults?.typingIntervalSeconds ?? 6) * 1000,
+          maxDurationMs: params.timeoutMs,
+          onStartError: (error) => log.debug(`continuation typing failed: ${String(error)}`),
+        })
+      : undefined;
+  const typing = createTypingController({
+    onReplyStart: typingCallbacks?.onReplyStart,
+    onCleanup: typingCallbacks?.onCleanup,
+    // The channel callbacks already own keepalive and terminal provider cleanup.
+    keepalive: false,
+    typingTtlMs: params.timeoutMs,
+  });
+  const typingSignals = createTypingSignaler({ typing, mode: typingMode, isHeartbeat: false });
+  const signalTyping = (notify: () => Promise<void>) => {
+    if (!accepting || signal.aborted) {
+      return Promise.resolve();
+    }
+    return notify().catch((error: unknown) => {
+      if (!signal.aborted) {
+        log.debug(`continuation typing failed: ${String(error)}`);
+      }
+    });
+  };
+  const transformReplyPayload = createChannelReplyTransform({
+    cfg: params.cfg,
+    accountId,
+    messaging: plugin?.messaging,
+  });
+
+  const progress = await plugin?.streaming?.createContinuationProgress?.({
+    cfg: params.cfg,
+    to,
+    accountId,
+    threadId,
+    signal,
+    assertCurrent,
+  });
+  const progressOptions = progress
+    ? attachProgressNarratorToReplyOptions({
+        cfg: params.cfg,
+        agentId: params.agentId,
+        // Never feed the private child settlement prompt into source narration.
+        opts: { ...progress.replyOptions, abortSignal: signal },
+        disabled: isModelSelectionLocked(params.sessionEntry),
+      })
+    : undefined;
+  const noteProgress = async (event: AgentEvent) => {
+    assertCurrent();
+    const data = event.data;
+    if (!data || data.hideFromChannelProgress === true || data.suppressChannelProgress === true) {
+      return;
+    }
+    const str = (key: string) => {
+      const value = data[key];
+      return typeof value === "string" ? value : undefined;
+    };
+    if (event.stream === "tool") {
+      await progressOptions?.onToolStart?.({
+        itemId: str("itemId"),
+        toolCallId: str("toolCallId"),
+        name: str("name"),
+        phase: str("phase"),
+        args: asOptionalRecord(data.args),
+      });
+    } else if (event.stream === "item") {
+      await progressOptions?.onItemEvent?.({
+        itemId: str("itemId"),
+        toolCallId: str("toolCallId"),
+        kind: str("kind"),
+        name: str("name"),
+        title: str("title"),
+        phase: str("phase"),
+        status: str("status"),
+        progressText:
+          typeof data.progressText === "string"
+            ? sanitizeUserFacingText(data.progressText, { streaming: true })
+            : undefined,
+        commandBearing: data.commandBearing === true,
+      });
+    } else if (event.stream === "command_output") {
+      await progressOptions?.onCommandOutput?.({
+        itemId: str("itemId"),
+        toolCallId: str("toolCallId"),
+        name: str("name"),
+        phase: str("phase"),
+        status: str("status"),
+        exitCode: typeof data.exitCode === "number" ? data.exitCode : undefined,
+      });
+    }
+  };
+
+  return {
+    onReasoningStream(payload) {
+      return payload.text?.trim()
+        ? signalTyping(() => typingSignals.signalReasoningDelta())
+        : Promise.resolve();
+    },
+    onExecutionPhase(info) {
+      if (
+        info.phase === "turn_accepted" ||
+        info.phase === "process_spawned" ||
+        info.phase === "model_call_started" ||
+        info.phase === "tool_execution_started" ||
+        info.phase === "assistant_output_started"
+      ) {
+        void signalTyping(() => typingSignals.signalExecutionActivity?.() ?? Promise.resolve());
+      }
+    },
+    onAgentEvent(event) {
+      if (!accepting || signal.aborted) {
+        return Promise.resolve();
+      }
+      if (event.stream === "lifecycle" && event.data?.phase === "start") {
+        return signalTyping(() => typingSignals.signalRunStart());
+      }
+      let typingUpdate = Promise.resolve();
+      if (event.stream === "assistant" && typeof event.data?.text === "string") {
+        const text = sanitizeUserFacingText(event.data.text);
+        typingUpdate = signalTyping(() => typingSignals.signalTextDelta(text));
+      } else if (
+        event.stream === "tool" &&
+        event.data?.hideFromChannelProgress !== true &&
+        (event.data?.phase === "start" || event.data?.phase === "update")
+      ) {
+        typingUpdate = signalTyping(() => typingSignals.signalToolStart());
+      } else if (
+        commentaryEnabled &&
+        event.stream === "item" &&
+        event.data?.kind === "preamble" &&
+        event.data.hideFromChannelProgress !== true &&
+        event.data.suppressChannelProgress !== true &&
+        typeof event.data.progressText === "string"
+      ) {
+        const text = sanitizeUserFacingText(event.data.progressText, { streaming: true });
+        typingUpdate = signalTyping(() => typingSignals.signalTextDelta(text));
+      }
+      if (progress) {
+        pending = pending
+          .then(() => noteProgress(event))
+          .catch((error: unknown) => {
+            if (!signal.aborted) {
+              log.debug(`continuation progress stopped: ${String(error)}`);
+            }
+          });
+        return Promise.all([typingUpdate, pending]).then(() => undefined);
+      }
+      if (
+        !commentaryEnabled ||
+        event.stream !== "item" ||
+        event.data?.kind !== "preamble" ||
+        event.data.hideFromChannelProgress === true ||
+        event.data.suppressChannelProgress === true ||
+        event.data.phase !== "end" ||
+        typeof event.data.progressText !== "string"
+      ) {
+        return typingUpdate;
+      }
+      const text = sanitizeProgressStatusText(
+        sanitizeUserFacingText(event.data.progressText, { streaming: true }),
+      );
+      const itemId =
+        typeof event.data.itemId === "string" && event.data.itemId ? event.data.itemId : text;
+      if (!text || completedItems.has(itemId)) {
+        return Promise.all([typingUpdate, pending]).then(() => undefined);
+      }
+      // Reserve synchronously because native event callbacks are detached.
+      completedItems.add(itemId);
+      pending = pending
+        .then(async () => {
+          assertCurrent();
+          const normalized = normalizeReplyPayloadOutcome(
+            { text, isCommentary: true },
+            { transformReplyPayload },
+          );
+          if (normalized.kind === "suppress") {
+            return;
+          }
+          const { sendDurableMessageBatchCore } = await import("../../channels/message/runtime.js");
+          assertCurrent();
+          const result = await sendDurableMessageBatchCore({
+            cfg: params.cfg,
+            channel,
+            to,
+            accountId,
+            threadId,
+            replyToId: transport?.replyToId ?? null,
+            payloads: [normalized.payload],
+            session: params.outboundSession,
+            runId: params.runId,
+            identity: resolveAgentOutboundIdentity(params.cfg, params.agentId),
+            replyPayloadSendingHook: {
+              kind: "block",
+              channel,
+              sessionKey,
+              runId: params.runId,
+              context: {
+                channelId: channel,
+                accountId,
+                conversationId: to,
+                sessionKey,
+                runId: params.runId,
+              },
+            },
+            signal,
+            bestEffort: true,
+            durability: "best_effort",
+            deps: createOutboundSendDeps(params.deps),
+            assertDirectAdapterHandoff: assertCurrent,
+            onPlatformSendDispatch: async () => {
+              assertCurrent();
+            },
+          });
+          if (result.status === "failed" || result.status === "partial_failed") {
+            throw result.error;
+          }
+        })
+        .catch((error: unknown) => {
+          if (!signal.aborted) {
+            log.warn(`continuation progress delivery failed: ${String(error)}`);
+          }
+        });
+      return Promise.all([typingUpdate, pending]).then(() => undefined);
+    },
+    async finish() {
+      accepting = false;
+      // Progress is not a final receipt. Drain it before the normal final sender.
+      await pending;
+      await progress?.finish().catch((error: unknown) => {
+        if (!signal.aborted) {
+          log.debug(`continuation progress finish: ${String(error)}`);
+        }
+      });
+    },
+    cleanup() {
+      accepting = false;
+      closed = true;
+      lifetime.abort(new Error("requester continuation presentation closed"));
+      typing.cleanup();
+      void progress
+        ?.cleanup()
+        .catch((error: unknown) => log.debug(`continuation cleanup: ${String(error)}`));
+    },
+  };
+}
+
+/** The command's final sender owns cleanup before execution starts and until delivery settles. */
+export async function runPresentedAgentCommandAttempt(
+  params: Omit<Parameters<typeof runEmbeddedAgentAttempt>[0], "presentation"> & {
+    source?: DeliveryContext;
+    deps: CliDeps;
+    onPresentation: (presentation: AgentCommandContinuationPresentation | undefined) => void;
+  },
+) {
+  const { prepared, opts } = params;
+  let lifecycleGeneration = params.lifecycleGeneration;
+  const presentation = await createAgentCommandContinuationPresentation({
+    cfg: prepared.cfg,
+    opts,
+    source: params.source,
+    sessionKey: prepared.sessionKey,
+    sessionId: prepared.sessionId,
+    sessionEntry: prepared.sessionEntry,
+    agentId: prepared.sessionAgentId,
+    runId: prepared.runId,
+    outboundSession: prepared.outboundSession,
+    deps: params.deps,
+    timeoutMs: prepared.timeoutMs,
+    typingMode: prepared.agentCfg?.typingMode ?? prepared.cfg.agents?.defaults?.typingMode,
+    assertCurrent: () => {
+      opts.abortSignal?.throwIfAborted();
+      assertAgentRunLifecycleGenerationCurrent(lifecycleGeneration);
+      params.preparedRunAdmission.assertSourceCurrent();
+    },
+  }).catch((error: unknown) => {
+    log.debug(`continuation presentation unavailable: ${String(error)}`);
+    return undefined;
+  });
+  params.onPresentation(presentation);
+  const attempt = await runEmbeddedAgentAttempt({
+    ...params,
+    presentation,
+    onLifecycleGenerationChanged: (nextLifecycleGeneration) => {
+      lifecycleGeneration = nextLifecycleGeneration;
+      params.onLifecycleGenerationChanged(nextLifecycleGeneration);
+    },
+  });
+  await presentation?.finish();
+  return attempt;
+}

+++ b/src/agents/agent-hooks/compaction-safeguard-first-budget.test.ts
@@ -0,0 +1,174 @@
+import type { StreamFn } from "openclaw/plugin-sdk/agent-core";
+import { createAssistantMessageEventStream } from "openclaw/plugin-sdk/llm";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { createZeroUsageFixture } from "../test-helpers/usage-fixtures.js";
+import { setCompactionSafeguardRuntime } from "./compaction-safeguard-runtime.js";
+import {
+  createAnthropicModelFixture,
+  createCompactionContext,
+  createCompactionEvent,
+  createCompactionHandler,
+  expectCompactionResult,
+  stubSessionManager,
+} from "./compaction-safeguard.test-fixtures.js";
+
+const latestAsk = "Verify release receipt_90210 before finishing the deployment.";
+
+function structuredBody(maxChars: number): string {
+  const suffix = [
+    "## Open TODOs\n\nVerify the deployment.",
+    "## Constraints/Rules\n\nUse the existing implementation.",
+    `## Pending user asks\n\nLatest user request context: ${JSON.stringify(latestAsk)}`,
+    "## Exact identifiers\n\nreceipt_90210",
+  ].join("\n\n");
+  const prefix = "## Decisions\n\nPreserve the approved deployment. ";
+  const detail = "Keep confirmed facts. ";
+  const detailBudget = Math.max(0, maxChars - prefix.length - suffix.length - 2);
+  return `${prefix}${detail.repeat(Math.floor(detailBudget / detail.length))}\n\n${suffix}`;
+}
+
+describe("first safeguard generation owns its final artifact budget", () => {
+  const managers = new Set<ReturnType<typeof stubSessionManager>>();
+  afterEach(() => {
+    for (const manager of managers) {
+      setCompactionSafeguardRuntime(manager, null);
+    }
+    managers.clear();
+  });
+
+  it.each([
+    { name: "required suffix", split: false, summaryTokenBudget: undefined },
+    { name: "foreground token allowance", split: false, summaryTokenBudget: 512 },
+    { name: "split turn", split: true, summaryTokenBudget: undefined },
+  ])(
+    "budgets the first outbound $name generation without discarding its body",
+    async (testCase) => {
+      const manager = stubSessionManager();
+      managers.add(manager);
+      const model = createAnthropicModelFixture({
+        api: "test-api" as never,
+        baseUrl: "",
+        reasoning: true,
+        maxTokens: 32_768,
+      });
+      setCompactionSafeguardRuntime(manager, {
+        model,
+        recentTurnsPreserve: testCase.split ? 0 : 1,
+        qualityGuardEnabled: true,
+        qualityGuardMaxRetries: 1,
+      });
+      const prompts: string[] = [];
+      const generated: string[] = [];
+      const outputAllowances: Array<number | undefined> = [];
+      const reasoning: Array<string | undefined> = [];
+      const streamFn: StreamFn = (_model, context, options) => {
+        const prompt = JSON.stringify(context);
+        prompts.push(prompt);
+        outputAllowances.push(options?.maxTokens);
+        reasoning.push(options?.reasoning);
+        const prefix = prompt.includes("## Original Request");
+        const instruction = prefix
+          ? /Keep the complete split-turn summary within (\d+) UTF-16 code units/u
+          : /Keep the complete summary body within (\d+) UTF-16 code units/u;
+        const allocation = instruction.exec(prompt)?.[1];
+        const body = prefix
+          ? `## Original Request\n\n${latestAsk}\n\n## Exact identifiers\n\nreceipt_90210`
+          : structuredBody(
+              allocation
+                ? testCase.summaryTokenBudget === undefined
+                  ? Number(allocation) - 32
+                  : Math.min(Number(allocation), 900)
+                : 16_500,
+            );
+        generated.push(body);
+        const stream = createAssistantMessageEventStream();
+        stream.push({
+          type: "done",
+          reason: "stop",
+          message: {
+            role: "assistant",
+            content: [{ type: "text", text: body }],
+            api: model.api,
+            provider: model.provider,
+            model: model.id,
+            usage: createZeroUsageFixture(),
+            stopReason: "stop",
+            timestamp: 1,
+          },
+        });
+        stream.end();
+        return stream;
+      };
+      const event = createCompactionEvent({
+        messageText: "Earlier deployment decision.",
+        tokensBefore: 1_000,
+      });
+      const messages = [
+        ...event.preparation.messagesToSummarize,
+        {
+          role: "assistant" as const,
+          content: [{ type: "text" as const, text: "Approved existing deployment." }],
+          timestamp: 2,
+        },
+      ];
+      const current = { role: "user" as const, content: latestAsk, timestamp: 3 };
+      const fileName =
+        testCase.summaryTokenBudget === undefined
+          ? `src/${"deployment-".repeat(120)}receipt.ts`
+          : "src/receipt.ts";
+      const result = await createCompactionHandler()(
+        {
+          ...event,
+          thinkingLevel: "max",
+          streamFn,
+          preparation: {
+            ...event.preparation,
+            messagesToSummarize: testCase.split ? messages : [...messages, current],
+            turnPrefixMessages: testCase.split ? [current] : [],
+            isSplitTurn: testCase.split,
+            latestUnresolvedUserRequest: latestAsk,
+            summaryTokenBudget: testCase.summaryTokenBudget,
+            settings: { reserveTokens: 20_000 },
+            fileOps: { read: [fileName], edited: [], written: [] },
+          },
+        },
+        createCompactionContext({
+          sessionManager: manager,
+          getApiKeyAndHeadersMock: vi.fn().mockResolvedValue({ ok: true, apiKey: "test-key" }),
+        }),
+      );
+      const summary = expectCompactionResult(
+        result as {
+          cancel?: boolean;
+          compaction?: { summary: string; firstKeptEntryId: string; tokensBefore: number };
+        },
+      ).summary;
+      expect(prompts).toHaveLength(testCase.split ? 2 : 1);
+      const bodyBudget = /Keep the complete summary body within (\d+) UTF-16 code units/u.exec(
+        prompts[0] ?? "",
+      );
+      expect(bodyBudget).not.toBeNull();
+      expect(Number(bodyBudget?.[1])).toBeLessThan(16_000);
+      expect(summary).toContain(generated[0]);
+      expect(summary).toContain(latestAsk);
+      expect(summary).toContain("receipt_90210");
+      expect(summary).toContain("<read-files>");
+      expect(summary).not.toContain("[Compaction summary truncated to fit budget]");
+      expect(summary.length).toBeLessThanOrEqual(16_000);
+      expect(reasoning).toEqual(testCase.split ? ["max", "max"] : ["max"]);
+      expect(outputAllowances).toEqual(testCase.split ? [16_000, 10_000] : [16_000]);
+      if (testCase.summaryTokenBudget !== undefined) {
+        expect(prompts[0]).toContain(
+          `complete finalized summary within ${testCase.summaryTokenBudget} estimated tokens`,
+        );
+      }
+      if (testCase.split) {
+        expect(prompts[1]).toMatch(
+          /Keep the complete split-turn summary within \d+ UTF-16 code units/u,
+        );
+        expect(summary).toContain("**Turn Context (split turn):**");
+        expect(summary).toContain("### Original Request");
+      }
+    },
+  );
+});
diff --git a/src/agents/agent-hooks/compaction-safeguard-parallel.test.ts b/src/agents/agent-hooks/compaction-safeguard-parallel.test.ts

+import Foundation
+import OpenClawKit
+import Testing
+@testable import OpenClawMacCLI
+
+/// Synthetic data only; no Keychain access or subprocesses in this suite.
+@MainActor
+struct NativeCredentialSecurityToolTests {
+    private func binding() throws -> NativeCredentialBinding {
+        try NativeCredentialBinding(
+            alias: "fixture.password",
+            kind: .macLogin,
+            account: "fixture",
+            hostID: "11111111-1111-4111-8111-111111111111",
+            bundleIDs: ["com.apple.SecurityAgent"])
+    }
+
+    private func metadata(_ binding: NativeCredentialBinding) throws -> Data {
+        let encoder = JSONEncoder()
+        encoder.outputFormatting = [.sortedKeys]
+        return try encoder.encode(binding)
+    }
+
+    private func admission(_ binding: NativeCredentialBinding, reference: UInt8 = 1) throws
+        -> NativeCredentialSecurityTool.Admission
+    {
+        try NativeCredentialSecurityTool.admit(
+            binding: binding,
+            storedMetadata: self.metadata(binding),
+            persistentReference: Data([reference]),
+            keychainPath: "/fixture/login.keychain-db",
+            unlocked: true,
+            readerTrusted: true)
+    }
+
+    @Test func `typed output preserves ASCII hex Unicode quotes and backslashes byte exactly`() throws {
+        let cases: [(String, String)] = [
+            ("password: \"414243\"\n", "414243"),
+            ("password: \" leading and trailing \"\n", " leading and trailing "),
+            ("password: \"a\"b\"\n", "a\"b"),
+            ("password: 0xC3A9 \n", "é"),
+            ("password: 0x61C3A9  \"a\\303\\251\"\n", "aé"),
+            ("password: 0x615C62  \"a\\134b\"\n", "a\\b"),
+        ]
+        for (display, value) in cases {
+            #expect(try NativeCredentialSecurityValue.decode(Data(display.utf8)) == Data(value.utf8))
+        }
+    }
+
+    @Test func `malformed diagnostic ambiguous noncanonical or invalid values are refused`() {
+        let cases = [
+            "414243\n", "password: \"\"\n", "password: \"value\"\nwarning\n",
+            "password: 0xc3a9 \n", "password: 0xC3A9  \"wrong\"\n", "password: 0x41 \n",
+            "password: 0x00 \n", "password: 0xFF \n", "password: 0x0A \n",
+            "password: \"a\\b\"\n", "password: \"value\"", "password: 0xA \n",
+            "password: \"" + String(repeating: "a", count: 8193) + "\"\n",
+        ]
+        for display in cases {
+            #expect(throws: NativeCredentialError.unavailable) {
+                try NativeCredentialSecurityValue.decode(Data(display.utf8))
+            }
+        }
+    }
+
+    @Test func `locked untrusted unbound and unidentified items cannot admit the reader`() throws {
+        let binding = try self.binding()
+        for scenario in 0..<5 {
+            #expect(throws: NativeCredentialError.unavailable) {
+                try NativeCredentialSecurityTool.admit(
+                    binding: binding,
+                    storedMetadata: scenario == 0 ? Data("{}".utf8) : self.metadata(binding),
+                    persistentReference: scenario == 1 ? Data() : Data([1]),
+                    keychainPath: scenario == 2 ? "relative.keychain" : "/fixture/login.keychain-db",
+                    unlocked: scenario != 3,
+                    readerTrusted: scenario != 4)
+            }
+        }
+        let admitted = try self.admission(binding)
+        let metadataText = try #require(String(data: self.metadata(binding), encoding: .utf8))
+        #expect(admitted.arguments == [
+            "find-generic-password", "-g", "-s", NativeCredentialKeychain.service,
+            "-a", binding.alias, "-G", metadataText,
+            "/fixture/login.keychain-db",
+        ])
+    }
+
+    @Test func `direct lookup succeeds without invoking compatibility reader`() async throws {
+        var consumed: [Data] = []
+        try await NativeCredentialIPC.withSecret(
+            binding: self.binding(),
+            parent: "owner",
+            environment: .init(
+                parentIdentity: { "owner" },
+                direct: { _ in Data("direct".utf8) },
+                preflight: { _ in Issue.record("unexpected preflight")
+                    throw NativeCredentialError.unavailable
+                },
+                read: { _ in Issue.record("unexpected reader")
+                    throw NativeCredentialError.unavailable
+                }),
+            consume: { consumed.append($0) })
+        #expect(consumed == [Data("direct".utf8)])
+    }
+
+    @Test func `refused direct binding never falls back`() async throws {
+        await #expect(throws: NativeCredentialError.refused) {
+            try await NativeCredentialIPC.withSecret(
+                binding: self.binding(),
+                parent: "owner",
+                environment: .init(
+                    parentIdentity: { "owner" },
+                    direct: { _ in throw NativeCredentialError.refused },
+                    preflight: { _ in Issue.record("unexpected preflight")
+                        throw NativeCredentialError.unavailable
+                    },
+                    read: { _ in Issue.record("unexpected reader")
+                        throw NativeCredentialError.unavailable
+                    }),
+                consume: { _ in Issue.record("unexpected consumption") })
+        }
+    }
+
+    @Test func `admitted reader is single attempt and retains exact item custody after await`() async throws {
+        let binding = try self.binding()
+        let admission = try self.admission(binding)
+        var preflights = 0
+        var reads = 0
+        var parentProofs = 0
+        var diagnostics: [NativeCredentialIPC.Diagnostic] = []
+        var consumed: [Data] = []
+        try await NativeCredentialIPC.withSecret(
+            binding: binding,
+            parent: "owner",
+            environment: .init(
+                parentIdentity: { parentProofs += 1
+                    return "owner"
+                },
+                direct: { _ in throw NativeCredentialError.unavailable },
+                preflight: { _ in preflights += 1
+                    return admission
+                },
+                read: { request in
+                    #expect(request == admission)
+                    reads += 1
+                    return Data("synthetic".utf8)
+                }),
+            record: { diagnostics.append($0) },
+            consume: { consumed.append($0) })
+        #expect(preflights == 2)
+        #expect(reads == 1)
+        #expect(parentProofs == 4)
+        #expect(diagnostics == [
+            .parentAdmission, .directRead, .fallbackAdmission, .parentBeforeFallback,
+            .fallbackRead, .parentAfterFallback, .fallbackRevalidation, .parentBeforeConsume, .delivering,
+        ])
+        #expect(consumed == [Data("synthetic".utf8)])
+    }
+
+    @Test func `final parent proof remains mandatory after successful fallback revalidation`() async throws {
+        let binding = try self.binding()
+        let admission = try self.admission(binding)
+        var parentProofs = 0
+        var diagnostics: [NativeCredentialIPC.Diagnostic] = []
+        await #expect(throws: NativeCredentialError.refused) {
+            try await NativeCredentialIPC.withSecret(
+                binding: binding,
+                parent: "owner",
+                environment: .init(
+                    parentIdentity: { parentProofs += 1
+                        return parentProofs == 4 ? "changed" : "owner"
+                    },
+                    direct: { _ in throw NativeCredentialError.unavailable },
+                    preflight: { _ in admission },
+                    read: { _ in Data("synthetic".utf8) }),
+                record: { diagnostics.append($0) },
+                consume: { _ in Issue.record("value consumed after parent changed") })
+        }
+        #expect(parentProofs == 4)
+        #expect(diagnostics.last == .parentBeforeConsume)
+        #expect(!diagnostics.contains(.delivering))
+    }
+
+    @Test func `changed parent or replaced item after reader completion discards the value`() async throws {
+        let binding = try self.binding()
+        for changedParent in [false, true] {
+            var completed = false
+            await #expect(throws: NativeCredentialError.refused) {
+                try await NativeCredentialIPC.withSecret(
+                    binding: binding,
+                    parent: "owner",
+                    environment: .init(
+                        parentIdentity: { changedParent && completed ? "other" : "owner" },
+                        direct: { _ in throw NativeCredentialError.unavailable },
+                        preflight: { _ in try self.admission(binding, reference: completed ? 2 : 1) },
+                        read: { _ in completed = true
+                            return Data("synthetic".utf8)
+                        }),
+                    consume: { _ in Issue.record("stale custody consumed") })
+            }
+        }
+    }
+
+    @Test func `reader failures never retry or expose their partial output`() async throws {
+        let binding = try self.binding()
+        for cancelled in [false, true] {
+            var reads = 0
+            do {
+                try await NativeCredentialIPC.withSecret(
+                    binding: binding,
+                    parent: "owner",
+                    environment: .init(
+                        parentIdentity: { "owner" },
+                        direct: { _ in throw NativeCredentialError.unavailable },
+                        preflight: { _ in try self.admission(binding) },
+                        read: { _ in
+                            reads += 1
+                            if cancelled { throw CancellationError() }
+                            throw NativeCredentialError.unavailable
+                        }),
+                    consume: { _ in Issue.record("failed reader consumed") })
+                Issue.record("reader failure not propagated")
+            } catch {
+                #expect(cancelled ? error is CancellationError : error as? NativeCredentialError == .unavailable)
+            }
+            #expect(reads == 1)
+        }
+    }
+
+    @Test func `failed preflight prevents the subprocess and no value is consumed`() async throws {
+        await #expect(throws: NativeCredentialError.unavailable) {
+            try await NativeCredentialIPC.withSecret(
+                binding: self.binding(),
+                parent: "owner",
+                environment: .init(
+                    parentIdentity: { "owner" },
+                    direct: { _ in throw NativeCredentialError.unavailable },
+                    preflight: { _ in throw NativeCredentialError.unavailable },
+                    read: { _ in Issue.record("unadmitted subprocess")
+                        return Data("synthetic".utf8)
+                    }),
+                consume: { _ in Issue.record("unadmitted value consumed") })
+        }
+    }
+
+    @Test func `cancellation during fallback discards even a subsequently successful value`() async throws {
+        let binding = try self.binding()
+        let entered = AsyncStream.makeStream(of: CheckedContinuation<Data, Never>.self)
+        let task = Task {
+            try await NativeCredentialIPC.withSecret(
+                binding: binding,
+                parent: "owner",
+                environment: .init(
+                    parentIdentity: { "owner" },
+                    direct: { _ in throw NativeCredentialError.unavailable },
+                    preflight: { _ in try self.admission(binding) },
+                    read: { _ in await withCheckedContinuation { entered.continuation.yield($0) } }),
+                consume: { _ in Issue.record("cancelled value consumed") })
+        }
+        var iterator = entered.stream.makeAsyncIterator()
+        let release = try #require(await iterator.next())
+        task.cancel()
+        release.resume(returning: Data("synthetic".utf8))
+        await #expect(throws: CancellationError.self) { try await task.value }
+        entered.continuation.finish()
+    }
+}

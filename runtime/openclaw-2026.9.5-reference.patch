+++ b/src/plugins/runtime/runtime-task-progress.ts
@@ -0,0 +1,119 @@
+import { getSubagentRunByRunId } from "../../agents/subagents/registry/subagent-registry.js";
+import type { ChannelProgressRequest } from "../../channels/plugins/types.core.js";
+import { publishChannelSourceProgress } from "../../channels/source-progress.js";
+import { resolveSessionStorePathCore } from "../../config/sessions/paths.js";
+import { loadSessionEntryReadOnly } from "../../config/sessions/session-accessor.js";
+import type { OpenClawConfig } from "../../config/types.openclaw.js";
+import { resolveAgentIdFromSessionKey } from "../../routing/session-key.js";
+import { resolveSendPolicy } from "../../sessions/send-policy.js";
+import { getTaskByIdForOwner } from "../../tasks/task-owner-access.js";
+
+/** A task supplies authored progress; only its registered owner selects the source request. */
+export async function publishTaskProgress(params: {
+  cfg: OpenClawConfig;
+  sessionKey: string;
+  taskId: string;
+  runId: string;
+  text: string;
+  signal: AbortSignal;
+  isCurrent: () => boolean;
+}): Promise<{ status: "visible"; messageId: string } | { status: "unbound" | "withheld" }> {
+  const resolveTask = () =>
+    getTaskByIdForOwner({
+      taskId: params.taskId,
+      callerOwnerKey: params.sessionKey,
+      config: params.cfg,
+    });
+  const task = resolveTask();
+  const row = getSubagentRunByRunId(params.runId);
+  const origin = row?.progressOrigin;
+  if (
+    !task ||
+    task.runId !== params.runId ||
+    !task.childSessionKey ||
+    !row ||
+    row.requesterSessionKey !== params.sessionKey ||
+    row.childSessionKey !== task.childSessionKey ||
+    !origin?.channel ||
+    !origin.to
+  ) {
+    return { status: "withheld" };
+  }
+  const rowGeneration = row.generation;
+  const rowCreatedAt = row.createdAt;
+  const childSessionKey = task.childSessionKey;
+  const source = {
+    channel: origin.channel,
+    to: origin.to,
+    accountId: origin.accountId,
+    threadId: origin.threadId,
+    sourceMessageId: origin.messageId != null ? String(origin.messageId) : undefined,
+    sessionId: row.completionRequesterSessionId,
+  };
+  const sourceFingerprint = JSON.stringify(source);
+  const agentId =
+    task.requesterAgentId ??
+    row.requesterAgentId ??
+    resolveAgentIdFromSessionKey(params.sessionKey);
+  const storePath = resolveSessionStorePathCore(params.cfg.session?.store, { agentId });
+  const progressRequest: ChannelProgressRequest | undefined =
+    row.completionRequesterSessionId && origin.messageId
+      ? {
+          sessionKey: params.sessionKey,
+          sessionId: row.completionRequesterSessionId,
+          sourceMessageId: String(origin.messageId),
+          requestGeneration: String(origin.messageId),
+        }
+      : undefined;
+  const assertCurrent = () => {
+    const currentTask = resolveTask();
+    const currentRow = getSubagentRunByRunId(params.runId);
+    const entry = loadSessionEntryReadOnly({ sessionKey: params.sessionKey, agentId, storePath });
+    if (
+      params.signal.aborted ||
+      !params.isCurrent() ||
+      currentTask?.runId !== params.runId ||
+      currentTask.childSessionKey !== childSessionKey ||
+      currentTask.status === "cancelled" ||
+      currentTask.status === "lost" ||
+      currentTask.deliveryStatus !== "pending" ||
+      currentRow !== row ||
+      currentRow.generation !== rowGeneration ||
+      currentRow.createdAt !== rowCreatedAt ||
+      currentRow.requesterSessionKey !== params.sessionKey ||
+      currentRow.childSessionKey !== childSessionKey ||
+      JSON.stringify({
+        channel: currentRow.progressOrigin?.channel,
+        to: currentRow.progressOrigin?.to,
+        accountId: currentRow.progressOrigin?.accountId,
+        threadId: currentRow.progressOrigin?.threadId,
+        sourceMessageId:
+          currentRow.progressOrigin?.messageId != null
+            ? String(currentRow.progressOrigin.messageId)
+            : undefined,
+        sessionId: currentRow.completionRequesterSessionId,
+      }) !== sourceFingerprint ||
+      (source.sessionId != null && entry?.sessionId !== source.sessionId) ||
+      resolveSendPolicy({
+        cfg: params.cfg,
+        entry,
+        sessionKey: params.sessionKey,
+        channel: origin.channel,
+      }) === "deny"
+    ) {
+      throw new Error("Task source progress authority changed");
+    }
+  };
+  assertCurrent();
+  return publishChannelSourceProgress({
+    cfg: params.cfg,
+    agentId,
+    sessionKey: params.sessionKey,
+    sessionId: source.sessionId,
+    source,
+    progressRequest,
+    text: params.text,
+    signal: params.signal,
+    assertCurrent,
+  });
+}

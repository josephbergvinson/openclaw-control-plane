@@ -0,0 +1,194 @@
+import { afterEach, beforeEach, expect, it, vi } from "vitest";
+import { setActivePluginRegistry } from "../../plugins/runtime.js";
+import {
+  createDirectOutboundTestAdapter,
+  createOutboundTestPlugin,
+  createTestRegistry,
+} from "../../test-utils/channel-plugins.js";
+import type { ResolvedActionContext } from "./message-action-contracts.js";
+import { executeMessageSourceProgress } from "./message-action-source-progress.js";
+
+const owner = vi.hoisted(() => ({ publish: vi.fn() }));
+vi.mock("../../channels/source-progress.js", () => ({
+  publishChannelSourceProgress: owner.publish,
+}));
+
+function setup() {
+  const channelPlugin = createOutboundTestPlugin({
+    id: "discord",
+    outbound: createDirectOutboundTestAdapter({ channel: "discord" }),
+    capabilities: { chatTypes: ["channel"], threads: true },
+  });
+  setActivePluginRegistry(
+    createTestRegistry([{ pluginId: "discord", source: "test", plugin: channelPlugin }]),
+  );
+  const assertCurrent = vi.fn();
+  const ctx: ResolvedActionContext = {
+    cfg: {},
+    params: { to: "channel:123", message: "Current task progress" },
+    channel: "discord",
+    channelPlugin,
+    accountId: "default",
+    mediaAccess: { localRoots: [] },
+    dryRun: false,
+    input: {
+      cfg: {},
+      action: "send",
+      params: {},
+      actionOrigin: "message-tool",
+      sourceReplyFinal: false,
+      sessionKey: "agent:main:discord:channel:123",
+      sessionId: "original-incarnation",
+      assertDirectAdapterHandoff: assertCurrent,
+      messageActionAuthorization: {
+        requesterAccountId: "default",
+        toolContext: {
+          currentChannelProvider: "discord",
+          currentChannelId: "channel:123",
+          currentSourceTurnId: "original-source",
+        },
+        sourceProgressRequest: {
+          sessionKey: "agent:main:discord:channel:123",
+          sessionId: "original-incarnation",
+          sourceMessageId: "900",
+          requestGeneration: "900",
+        },
+      },
+    },
+  };
+  const params: Parameters<typeof executeMessageSourceProgress>[0] = {
+    ctx,
+    payload: {
+      message: "Current task progress",
+      payload: { text: "Current task progress" },
+      asVoice: false,
+      gifPlayback: false,
+      forceDocument: false,
+    },
+    replyToIsExplicit: false,
+  };
+  return { params, assertCurrent };
+}
+
+beforeEach(() =>
+  owner.publish.mockReset().mockResolvedValue({ status: "visible", messageId: "owned-progress" }),
+);
+afterEach(() => setActivePluginRegistry(createTestRegistry([])));
+
+it("passes only host-held original facts and fresh source authority to the canonical publisher", async () => {
+  const h = setup();
+  const result = await executeMessageSourceProgress(h.params);
+  expect(result).toMatchObject({
+    kind: "send",
+    payload: { deliveryStatus: "sent", result: { messageId: "owned-progress" } },
+  });
+  const published = owner.publish.mock.calls[0]?.[0];
+  expect(published).toMatchObject({
+    sessionKey: h.params.ctx.input.sessionKey,
+    sessionId: "original-incarnation",
+    progressRequest: h.params.ctx.input.messageActionAuthorization?.sourceProgressRequest,
+    source: { channel: "discord", to: "channel:123", accountId: "default" },
+  });
+  published.assertCurrent();
+  expect(h.assertCurrent).toHaveBeenCalled();
+});
+
+it.each([
+  "default final",
+  "explicit final",
+  "ordinary send",
+  "other target",
+  "other account",
+  "other thread",
+  "media",
+  "attachments",
+  "presentation",
+  "location",
+  "delivery",
+  "silent",
+  "dry run",
+  "remote gateway",
+  "queue owner",
+])("preserves %s under its ordinary send owner", async (kind) => {
+  const h = setup();
+  const { ctx, payload } = h.params;
+  if (kind === "default final") {
+    ctx.input.sourceReplyFinal = undefined;
+  }
+  if (kind === "explicit final") {
+    ctx.input.sourceReplyFinal = true;
+  }
+  if (kind === "ordinary send") {
+    ctx.input.actionOrigin = undefined;
+  }
+  if (kind === "other target") {
+    ctx.params.to = "channel:456";
+  }
+  if (kind === "other account") {
+    ctx.accountId = "other";
+  }
+  if (kind === "other thread") {
+    ctx.params.threadId = "456";
+  }
+  if (kind === "media") {
+    payload.payload.mediaUrl = "https://example.com/proof.png";
+  }
+  if (kind === "attachments") {
+    payload.payload.attachments = [{ path: "/synthetic/proof.txt" }];
+  }
+  if (kind === "presentation") {
+    payload.payload.presentation = { blocks: [{ type: "text", text: "Proof" }] };
+  }
+  if (kind === "location") {
+    payload.payload.location = { latitude: 1, longitude: 2 };
+  }
+  if (kind === "delivery") {
+    payload.payload.delivery = { pin: { enabled: true } };
+  }
+  if (kind === "silent") {
+    payload.silent = true;
+  }
+  if (kind === "dry run") {
+    ctx.dryRun = true;
+  }
+  if (kind === "remote gateway") {
+    ctx.gateway = { clientName: "cli", mode: "cli" };
+  }
+  if (kind === "queue owner") {
+    ctx.input.requireQueuePersistence = true;
+  }
+  expect(await executeMessageSourceProgress(h.params)).toBeUndefined();
+  expect(owner.publish).not.toHaveBeenCalled();
+});
+
+it.each(["withheld", "unbound"] as const)(
+  "%s remains distinct from an accepted update",
+  async (status) => {
+    const h = setup();
+    owner.publish.mockResolvedValue({ status });
+    const result = await executeMessageSourceProgress(h.params);
+    if (status === "unbound") {
+      expect(result).toBeUndefined();
+    } else {
+      expect(result).toMatchObject({
+        payload: { ok: false, deliveryStatus: "suppressed", reason: "source_progress_withheld" },
+      });
+    }
+  },
+);
+
+it("rechecks actual source authority after an off-mode publication await before ordinary fallback", async () => {
+  const h = setup();
+  let release!: (value: { status: "unbound" }) => void;
+  owner.publish.mockReturnValue(
+    new Promise((resolve) => {
+      release = resolve;
+    }),
+  );
+  const pending = executeMessageSourceProgress(h.params);
+  h.assertCurrent.mockImplementation(() => {
+    throw new Error("source retired");
+  });
+  release({ status: "unbound" });
+  await expect(pending).rejects.toThrow("source retired");
+});

+      return;
+    }
+    const inbound = findInboundForSpawn({ messageId, route });
+    if (!inbound) {
+      return;
+    }
+    const matches = taskRuntime(inbound.sessionKey)
+      .list()
+      .filter(
+        (task) =>
+          task.ownerKey === inbound.sessionKey &&
+          task.runId === runId &&
+          task.childSessionKey === childSessionKey &&

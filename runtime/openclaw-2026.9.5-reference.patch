-  return await withPluginRuntimeGatewayContextResolver(resolveGatewayContext, params.run, {
-    inheritRequestScope: false,
+  // An arming tool call may carry a writer that retires before the job fires.
+  // Scheduled runs acquire their own admission; their conversation completion
+  // must not borrow the creating attempt's disposed transcript lifecycle.
+  return await runWithoutOwnedSessionTranscriptWrites(async () => {
+    const resolveGatewayContext = params.resolveGatewayContext;
+    if (!resolveGatewayContext) {
+      return await params.run();
+    }
+    return await withPluginRuntimeGatewayContextResolver(resolveGatewayContext, params.run, {
+      inheritRequestScope: false,
+    });
   });
 }

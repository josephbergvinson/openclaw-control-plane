+const swiftEntry = path.resolve("scripts/build-mac-swift.mts");
+const uiEntry = path.resolve("scripts/ui.js");
+const commit = "b".repeat(40);
+
+function createFixture(
+  kind: "swift" | "ui",
+  mode = "complete",
+  roomy = false,
+  cpus = roomy ? 16 : 8,
+) {
+  const root = fs.realpathSync(createTempDir("managed-build-admission-"));
+  const preload = path.join(root, "host.cjs");
+  const worker = path.join(root, "worker.mjs");
+  const admission = path.join(root, ".cache/openclaw-local-checks");
+  fs.writeFileSync(
+    preload,
+    `const os = require('node:os');
+os.homedir = () => ${JSON.stringify(root)};
+os.availableParallelism = () => ${cpus};
+os.totalmem = () => ${roomy ? 64 : 16} * 1024 ** 3;
+${
+  kind === "ui"
+    ? `const cp = require('node:child_process');
+const fs = require('node:fs');
+const spawn = cp.spawn;
+const spawnSync = cp.spawnSync;
+cp.spawn = function(bin, args, options) {
+  if (args[0].endsWith('/vite.js')) return spawn(bin, [${JSON.stringify(worker)}, ...args.slice(1)], options);
+  throw new Error('unexpected async child');
+};
+cp.spawnSync = function(bin, args, options) {
+  if (args[0]?.endsWith('/vite.js')) {
+    if (!args.includes('--help')) return spawnSync(bin, [${JSON.stringify(worker)}, ...args.slice(1)], options);
+    return { status: 0, stdout: '', stderr: '' };
+  }
+  if (!args[2]?.includes('check-control-ui-')) throw new Error('unexpected sync child');
+  fs.appendFileSync(${JSON.stringify(path.join(root, "events"))}, 'validator\\n');
+  return { status: 0 };
+};`
+    : ""
+}
+require('node:module').syncBuiltinESMExports();
+`,
+  );
+  if (kind === "swift") {
+    const mountParent = path.join(root, "mounts");
+    fs.mkdirSync(mountParent);
+    fs.mkdirSync(path.join(root, "scripts/lib"), { recursive: true });
+    fs.writeFileSync(path.join(root, "getconf"), `#!/bin/sh\nprintf '%s\\n' '${mountParent}'\n`);
+    fs.chmodSync(path.join(root, "getconf"), 0o755);
+    fs.writeFileSync(
+      path.join(root, "scripts/lib/mac-swift-build.sh"),
+      `#!/bin/bash\nexec '${node}' '${worker}' "$@"\n`,
+    );
+    fs.writeFileSync(
+      worker,
+      `import fs from 'node:fs';
+const [operation, root, arch, config, jobs, commit, skip, work, mount] = process.argv.slice(2);
+const event = value => fs.appendFileSync(root + '/events', value + '\\n');
+if (operation === 'cleanup') {
+  if (fs.existsSync(mount)) fs.rmdirSync(mount);
+  event('cleanup:' + arch);
+} else {
+  fs.mkdirSync(mount);
+  event('start:' + arch + ':' + jobs);
+  fs.writeFileSync(root + '/ready-' + arch, 'ready');
+  if (${JSON.stringify(mode)} === 'parallel') {
+    const deadline = Date.now() + 3000;
+    while (!['arm64', 'x86_64'].every(a => fs.existsSync(root + '/ready-' + a))) {
+      if (Date.now() > deadline) throw new Error('parallel barrier not reached');
+      await new Promise(resolve => setTimeout(resolve, 10));
+    }
+  } else await new Promise(resolve => setTimeout(resolve, 100));
+  fs.writeFileSync(work + '/peekaboo-commit', commit);
+  event('done:' + arch);
+}
+`,
+    );
+  } else {
+    fs.writeFileSync(
+      worker,
+      `import fs from 'node:fs';
+import { spawn } from 'node:child_process';
+const root = ${JSON.stringify(root)};
+fs.appendFileSync(root + '/events', 'vite-start\\n');
+if (${JSON.stringify(mode)} === 'cancel') {
+  const child = spawn(process.execPath, ['-e', 'setInterval(() => {}, 1000)'], { stdio: 'ignore' });
+  fs.writeFileSync(root + '/child.pid', String(child.pid));
+  const closed = new Promise(resolve => child.once('exit', resolve));
+  process.on('SIGTERM', async () => { child.kill(); await closed; process.exit(143); });
+  console.log('fixture-ready');
+  await new Promise(() => {});
+} else if (${JSON.stringify(mode)} === 'failure') process.exit(17);
+`,
+    );
+  }
+  return { root, preload, admission };
+}
+
+async function runFixture(
+  fixture: ReturnType<typeof createFixture>,
+  kind: "swift" | "ui",
+  options: { ci?: boolean; help?: boolean; cancel?: boolean; architectures?: string[] } = {},
+) {
+  let output = "";
+  let exitSignal: NodeJS.Signals | null = null;
+  const args =
+    kind === "swift"
+      ? [
+          swiftEntry,
+          fixture.root,
+          "release",
+          commit,
+          "0",
+          path.join(fixture.root, "results"),
+          ...(options.architectures ?? ["arm64", "x86_64"]),
+        ]
+      : [uiEntry, "build", ...(options.help ? ["--help"] : [])];
+  const status = await runManagedCommand({
+    bin: node,
+    args: ["--require", fixture.preload, ...args],
+    env: {
+      ...process.env,
+      CI: options.ci ? "true" : "",
+      GITHUB_ACTIONS: "",
+      PATH: `${fixture.root}:${process.env.PATH}`,
+      OPENCLAW_BUILD_ALL_NO_PNPM: "1",
+      OPENCLAW_BUILD_TIMESTAMP: "2026-10-03T00:00:00.000Z",
+      GIT_COMMIT: commit,
+    },
+    stdio: ["ignore", "pipe", "pipe"],
+    requireProcessTreeExit: true,
+    timeoutMs: 8_000,
+    onReady: (child) => {
+      child.once("exit", (_status, signal) => {
+        exitSignal = signal;
+      });
+      child.stderr?.on("data", (chunk: Buffer) => {
+        output += chunk.toString();
+      });
+      child.stdout?.on("data", (chunk: Buffer) => {
+        output += chunk.toString();
+        if (options.cancel && output.includes("fixture-ready")) {
+          child.kill("SIGTERM");
+        }
+      });
+    },
+  });
+  return { status, output, exitSignal };
+}
+
+async function withCompetitor(
+  fixture: ReturnType<typeof createFixture>,
+  operation: () => Promise<void>,
+) {
+  const checkout = path.join(fixture.root, "other-checkout");
+  fs.mkdirSync(checkout);
+  const ready = createDeferred();
+  const abort = new AbortController();
+  const running = runManagedCommand({
+    bin: node,
+    args: ["-e", "setInterval(() => {}, 1000)"],
+    cwd: checkout,
+    localCheckAdmission: fixture.admission,
+    stdio: "ignore",
+    signal: abort.signal,
+    timeoutMs: 10_000,
+    onReady: () => ready.resolve(),
+  }).catch((error: unknown) => error);
+  try {
+    await Promise.race([
+      ready.promise,
+      running.then((error) => {
+        throw new Error("competitor ended before admission", { cause: error });
+      }),
+    ]);
+    await operation();
+  } finally {
+    abort.abort();
+    expect(await running).toMatchObject({ code: "ABORT_ERR" });
+  }
+  expect(fs.readdirSync(fixture.admission)).toEqual([]);
+}
+
+describe.skipIf(process.platform === "win32")("managed build host admission", () => {
+  it.each(["swift", "ui"] as const)(
+    "refuses %s before a compiler starts in a competing checkout",
+    async (kind) => {
+      const fixture = createFixture(kind);
+      await withCompetitor(fixture, async () => {
+        const result = await runFixture(fixture, kind);
+        expect(result.status, result.output).toBe(1);
+        expect(result.output).toContain("ELOCAL_CHECK_BUSY");
+        const events = fs.existsSync(path.join(fixture.root, "events"))
+          ? fs.readFileSync(path.join(fixture.root, "events"), "utf8")
+          : "";
+        expect(events).not.toContain("start:");
+        expect(events).not.toContain("vite-start");
+        expect(events).not.toContain("validator");
+      });
+    },
+  );
+
+  it("serializes constrained architectures and bounds memory-heavy compiler jobs", async () => {
+    const fixture = createFixture("swift");
+    const result = await runFixture(fixture, "swift");
+    expect(result.status, result.output).toBe(0);
+    expect(fs.readFileSync(path.join(fixture.root, "events"), "utf8").trim().split("\n")).toEqual([
+      "start:arm64:2",
+      "done:arm64",
+      "start:x86_64:2",
+      "done:x86_64",
+      "cleanup:arm64",
+      "cleanup:x86_64",
+    ]);
+    expect(fs.readdirSync(fixture.admission)).toEqual([]);
+    expect(fs.readdirSync(path.join(fixture.root, "mounts"))).toEqual([]);
+  });
+
+  it.each([
+    { cpus: 10, architectures: ["arm64"], jobs: 2 },
+    { cpus: 10, architectures: ["arm64", "x86_64"], jobs: 2 },
+    { cpus: 1, architectures: ["arm64"], jobs: 1 },
+  ])(
+    "passes the constrained $cpus CPU job bound to the actual Swift worker",
+    async ({ cpus, architectures, jobs }) => {
+      const fixture = createFixture("swift", "complete", false, cpus);
+      const result = await runFixture(fixture, "swift", { architectures });
+      expect(result.status, result.output).toBe(0);
+      const events = fs.readFileSync(path.join(fixture.root, "events"), "utf8").trim().split("\n");
+      expect(events.filter((event) => event.startsWith("start:"))).toEqual(
+        architectures.map((arch) => `start:${arch}:${jobs}`),
+      );
+      expect(fs.readdirSync(fixture.admission)).toEqual([]);
+    },
+  );
+
+  it.each(["ci", "roomy"] as const)(
+    "preserves %s architecture parallelism without a host lease",
+    async (policy) => {
+      const fixture = createFixture("swift", "parallel", policy === "roomy");
+      const result = await runFixture(fixture, "swift", { ci: policy === "ci" });
+      expect(result.status, result.output).toBe(0);
+      const events = fs.readFileSync(path.join(fixture.root, "events"), "utf8").trim().split("\n");
+      expect(events.slice(0, 2).toSorted()).toEqual(
+        policy === "ci" ? ["start:arm64:4", "start:x86_64:4"] : ["start:arm64:8", "start:x86_64:8"],
+      );
+      expect(fs.existsSync(fixture.admission)).toBe(false);
+    },
+  );
+
+  it("keeps UI help available while the compiler lane is occupied", async () => {
+    const fixture = createFixture("ui");
+    await withCompetitor(fixture, async () => {
+      const result = await runFixture(fixture, "ui", { help: true });
+      expect(result.status, result.output).toBe(0);
+      expect(fs.existsSync(path.join(fixture.root, "events"))).toBe(false);
+    });
+  });
+
+  it.each(["complete", "failure", "cancel"])(
+    "joins UI %s before releasing the compiler lane",
+    async (mode) => {
+      const fixture = createFixture("ui", mode);
+      const result = await runFixture(fixture, "ui", { cancel: mode === "cancel" });
+      expect(result.status, result.output).toBe(
+        mode === "failure" ? 17 : mode === "cancel" ? 143 : 0,
+      );
+      expect(result.exitSignal).toBe(mode === "cancel" ? "SIGTERM" : null);
+      const events = fs.readFileSync(path.join(fixture.root, "events"), "utf8").trim().split("\n");
+      expect(events).toEqual(
+        mode === "complete" ? ["vite-start", "validator", "validator"] : ["vite-start"],
+      );
+      expect(fs.readdirSync(fixture.admission)).toEqual([]);
+      if (mode === "cancel") {
+        const pid = Number(fs.readFileSync(path.join(fixture.root, "child.pid"), "utf8"));
+        expect(() => process.kill(pid, 0)).toThrow();
+      }
+    },
+  );
+});
diff --git a/test/scripts/managed-child-process.admission.test.ts b/test/scripts/managed-child-process.admission.test.ts

+import { afterEach, describe, expect, it } from "vitest";
+import { taskCompletionEvents } from "../../subagent-test-fixtures.test-helpers.js";
+import {
+  createGatewayMock,
+  createQueueOutcomeMock,
+  createSendMessageMock,
+  deliverDiscordDirectMessageCompletion,
+} from "./subagent-announce-delivery.fixtures.test-support.js";
+import { testing } from "./subagent-announce-delivery.test-support.js";
+
+afterEach(() => testing.setDepsForTest());
+
+describe("requester incarnation and active physical session", () => {
+  it("consumes a private completion for the same logical incarnation during a different physical run", async () => {
+    const callGateway = createGatewayMock({
+      status: "ok",
+      inputProcessingCompleted: true,
+      result: {},
+    });
+    const sendMessage = createSendMessageMock();
+    const queue = createQueueOutcomeMock(true);
+    const result = await deliverDiscordDirectMessageCompletion({
+      callGateway,
+      sendMessage,
+      completionTarget: "parent",
+      currentRequesterSessionId: "requester-session-dm",
+      activeRequesterSessionId: "physical-run-session",
+      isActive: true,
+      queueEmbeddedAgentMessageWithOutcome: queue,
+      internalEvents: taskCompletionEvents(),
+    });
+    expect(result).toMatchObject({ delivered: true, path: "direct" });
+    expect(callGateway).toHaveBeenCalledWith(
+      expect.objectContaining({
+        params: expect.objectContaining({
+          expectedExistingSessionId: "requester-session-dm",
+          deliver: false,
+        }),
+      }),
+    );
+    expect(queue).not.toHaveBeenCalled();
+    expect(sendMessage).not.toHaveBeenCalled();
+  });
+
+  it.each([null, "replacement-logical-session"])(
+    "refuses a missing or replaced logical incarnation despite stale matching activity: %s",
+    async (currentRequesterSessionId) => {
+      const callGateway = createGatewayMock({
+        status: "ok",
+        inputProcessingCompleted: true,
+        result: {},
+      });
+      const sendMessage = createSendMessageMock();
+      const result = await deliverDiscordDirectMessageCompletion({
+        callGateway,
+        sendMessage,
+        completionTarget: "parent",
+        currentRequesterSessionId,
+        activeRequesterSessionId: "requester-session-dm",
+        isActive: true,
+        internalEvents: taskCompletionEvents(),
+      });
+      expect(result).toMatchObject({
+        delivered: false,
+        terminal: true,
+        reason: "completion_handoff_unavailable",
+      });
+      expect(callGateway).not.toHaveBeenCalled();
+      expect(sendMessage).not.toHaveBeenCalled();
+    },
+  );
+
+  it("still steers an active physical run after validating the logical presentation", async () => {
+    const callGateway = createGatewayMock();
+    const sendMessage = createSendMessageMock();
+    const queue = createQueueOutcomeMock(true);
+    const result = await deliverDiscordDirectMessageCompletion({
+      callGateway,
+      sendMessage,
+      requesterPresentation: {
+        runId: "requester-run",
+        sessionKey: "agent:main:discord:dm:U123",
+        sessionId: "requester-session-dm",
+        source: { channel: "discord", to: "dm:U123", accountId: "acct-1" },
+        assertCurrent: () => {},
+      },
+      activeRequesterSessionId: "physical-run-session",
+      isActive: true,
+      queueEmbeddedAgentMessageWithOutcome: queue,
+      internalEvents: taskCompletionEvents(),
+    });
+    expect(result).toMatchObject({ delivered: true, path: "steered" });
+    expect(queue).toHaveBeenCalledWith(
+      "physical-run-session",
+      expect.any(String),
+      expect.any(Object),
+    );
+    expect(callGateway).not.toHaveBeenCalled();
+    expect(sendMessage).not.toHaveBeenCalled();
+  });

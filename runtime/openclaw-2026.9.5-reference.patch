+      model: "openai/gpt-6-sol",
+      phaseModels: undefined,
+      expected: ["high", "high", "high", "high"],
+    },
+    {
+      trigger: "heartbeat",
+      configured: { light: "high", rem: "low", deep: "medium" },
+      model: "openai/gpt-6-sol",
+      phaseModels: { light: "openai/gpt-6-astra", rem: "openai/gpt-5.6-sol" },
+      expected: ["high", "low", "medium", "medium"],
+    },
+  ] as const)(
+    "honors each phase's model and effort ($trigger, $expected)",
+    async ({ trigger, configured, model, phaseModels, expected }) => {
+      vi.useFakeTimers({ toFake: ["Date"] });
+      vi.setSystemTime(NOW);
+      const workspaceDir = await createTempWorkspace("dreaming-effort-");
+      const snippet = "The owner prefers green tea during planning.";
+      await fs.mkdir(path.join(workspaceDir, "memory"));
+      await fs.writeFile(path.join(workspaceDir, "memory/2026-04-05.md"), `${snippet}\n`);

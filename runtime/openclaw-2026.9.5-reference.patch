new file mode 100644
index 0000000000000000000000000000000000000000..34c265822ed8199fe5ead397525846d2fd940f83
--- /dev/null
+++ b/src/auto-reply/reply/agent-runner-browser-cleanup.test.ts
@@ -0,0 +1,105 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { createDeferred } from "../../../test/helpers/promise.js";
+import type { InternalSessionEntry } from "../../config/sessions/types.js";
+import { scheduleReplyBrowserCleanup } from "./agent-runner-maintenance.js";
+import { createReplyOperation } from "./reply-run-registry.js";
+import { testing } from "./reply-run-registry.test-support.js";
+import { createMockFollowupRun } from "./test-helpers.js";
+
+const cleanup = vi.hoisted(() =>
+  vi.fn(
+    async (_params: { expectedSession: { sessionId: string }; isCurrent: () => boolean }) => {},
+  ),
+);
+vi.mock("../../browser-lifecycle-cleanup.js", () => ({
+  cleanupBrowserSessionsForTaskCompletion: cleanup,
+}));
+
+function fixture() {
+  const operation = createReplyOperation({
+    sessionKey: "agent:main:browser-cleanup",
+    sessionId: "session",
+    resetTriggered: false,
+  });
+  const entry: InternalSessionEntry = {
+    sessionId: "session",
+    lifecycleRevision: "revision",
+    activeWriterRunId: "run",
+    updatedAt: 10,
+  };
+  const params: Parameters<typeof scheduleReplyBrowserCleanup>[0] = {
+    context: {
+      cfg: {},
+      sessionKey: operation.key,
+      storePath: "/fixture/openclaw-agent.sqlite",
+      replyOperation: operation,
+      isHeartbeat: false,
+      runId: "run",
+      queueKey: operation.key,
+      followupRun: createMockFollowupRun({
+        run: { sessionKey: operation.key, sessionId: entry.sessionId },
+      }),
+      execution: { status: "ok" },
+    },
+    accounting: {
+      runResult: { meta: { durationMs: 1 } },
+      expectedSession: { sessionId: entry.sessionId, lifecycleRevision: entry.lifecycleRevision },
+      preserveUserFacingSessionState: false,
+      fallbackExhausted: false,
+    },
+    sessionEntry: entry,
+  };
+  return { operation, params, entry };
+}
+
+describe("reply browser cleanup uses the delivery owner's settlement", () => {
+  beforeEach(() => cleanup.mockClear());
+  afterEach(() => testing.resetReplyRunRegistry());
+
+  it("waits for actual final delivery and snapshots the original identity", async () => {
+    const { params, operation, entry } = fixture();
+    const delivery = createDeferred();
+    const pending = scheduleReplyBrowserCleanup(params);
+    operation.completeWithAfterClearBarrier(delivery.promise);
+    await Promise.resolve();
+    expect(cleanup).not.toHaveBeenCalled();
+    entry.sessionId = "later-session";
+    delivery.resolve();
+    await pending;
+    expect(cleanup).toHaveBeenCalledOnce();
+    expect(cleanup.mock.calls[0]?.[0].expectedSession.sessionId).toBe("session");
+  });
+
+  it("covers direct reply callers without an outer dispatch barrier", async () => {
+    const { params, operation } = fixture();
+    const pending = scheduleReplyBrowserCleanup(params);
+    operation.complete();
+    await pending;
+    expect(cleanup).toHaveBeenCalledOnce();
+  });
+
+  it("does not clean an owner that failed before delivery settled", async () => {
+    const { params, operation } = fixture();
+    const pending = scheduleReplyBrowserCleanup(params);
+    operation.fail("run_failed", new Error("delivery failed"));
+    operation.complete();
+    await pending;
+    expect(cleanup).not.toHaveBeenCalled();
+  });
+
+  it.each([
+    { yielded: true },
+    { continuationPending: true as const },
+    { stopReason: "tool_calls" },
+    { pendingToolCalls: [{ id: "pending", name: "browser", arguments: "{}" }] },
+    { aborted: true },
+    { error: { kind: "incomplete_turn" as const, message: "unfinished" } },
+  ])("does not treat a pending model result as task completion: %j", async (meta) => {
+    const { params, operation } = fixture();
+    params.accounting.runResult.meta = { durationMs: 1, ...meta };
+    expect(scheduleReplyBrowserCleanup(params)).toBeUndefined();
+    operation.complete();
+    await operation.ownerSettlement;
+    expect(cleanup).not.toHaveBeenCalled();
+  });
+});

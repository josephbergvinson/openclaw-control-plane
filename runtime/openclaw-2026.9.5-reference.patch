+          client: { id: "cli" as const, mode: "cli" as const, version: "test", platform: "test" },
+        },
+        internal: { isLocalClient: true as const },
+      };
+      attachGatewayLocalUserIngress(
+        client,
+        prepareGatewayLocalUserIngress({
+          authMethod: "token",
+          authenticatedUserExpected: false,
+          isLocalClient: true,
+        }),
+      );
+      const admission = resolveGatewayCronCreatorAuthorityAdmission({
+        runId: turn.queued.messageId!,
+        resolvedSessionKey: "main",
+        client,
+        isCurrent: native.isCurrent,
+        request: { message: "queued operator input", idempotencyKey: turn.queued.messageId! },
+        hasRestoredCronContinuation: false,
+        isOneShotModelRun: false,
+        isRestartRecoveryResumeRun: false,
+      });
+      if (!admission) {
+        throw new Error("native queued operator fixture was not admitted");
+      }
+      const source = {
+        agentId: turn.queued.run.agentId,
+        runId: turn.queued.messageId!,
+        sessionKey: "main",
+        sessionId: turn.queued.run.sessionId,
+        admission,
+        client,
+        assertInputCurrent: vi.fn(),
+        assertSessionCurrent: vi.fn(),
+      };
+      turn.queued.operatorMessageAdmission = source;
+      const laterInput = { ...source, runId: "later-input", sessionId: "later-session" };
+      const execute = () =>
+        executeFollowupTurn({
+          turn,
+          defaults: {
+            typing: createTypingController(),
+            typingMode: "never",
+            defaultModel: "claude",
+            opts: { operatorMessageAdmission: laterInput },
+          },
+          onToolResult: vi.fn(async () => {}),
+          onCompactionNoticePayload: vi.fn(async () => {}),
+        });
+      return { turn, native, source, laterInput, execute };
+    }
+
+    it("rebinds only the exact original queued input to its receiving run", async () => {
+      const fixture = arrange();
+      try {
+        await fixture.execute();
+        const receiving = (state.execute.mock.calls[0]![0] as AgentTurnParams).opts
+          ?.operatorMessageAdmission;
+        expect(receiving).toMatchObject({
+          agentId: fixture.source.agentId,
+          runId: fixture.turn.runId,
+          sessionKey: fixture.source.sessionKey,
+          sessionId: fixture.source.sessionId,
+        });
+        expect(receiving?.admission.runId).toBe(fixture.turn.runId);
+        expect(receiving?.admission.isCurrent).toBe(fixture.source.admission.isCurrent);
+        expect(receiving?.client).toBe(fixture.source.client);
+        expect(receiving?.assertSessionCurrent).toBe(fixture.source.assertSessionCurrent);
+        expect(fixture.source.assertInputCurrent).toHaveBeenCalledOnce();
+        expect(fixture.source.assertSessionCurrent).toHaveBeenCalledOnce();
+        expect(receiving).not.toBe(fixture.source);
+        expect(receiving).not.toBe(fixture.laterInput);
+      } finally {
+        fixture.native.release();
+      }
+    });
+
+    it.each(["message", "agent", "key", "sid", "absent"] as const)(
+      "does not borrow a later caller when the original queued %s binding differs",
+      async (change) => {
+        const fixture = arrange();
+        if (change === "message") {
+          fixture.turn.queued.messageId = "different-input";
+        }
+        if (change === "agent") {
+          fixture.source.agentId = "other-agent";
+        }
+        if (change === "key") {
+          fixture.source.sessionKey = "other-key";
+        }
+        if (change === "sid") {
+          fixture.source.sessionId = "other-sid";
+        }
+        if (change === "absent") {
+          fixture.turn.queued.operatorMessageAdmission = undefined;
+        }
+        try {
+          await fixture.execute();
+          expect(
+            (state.execute.mock.calls[0]![0] as AgentTurnParams).opts?.operatorMessageAdmission,
+          ).toBeUndefined();
+          expect(fixture.source.assertInputCurrent).not.toHaveBeenCalled();
+          expect(fixture.source.assertSessionCurrent).not.toHaveBeenCalled();
+        } finally {
+          fixture.native.release();
+        }
+      },
+    );
+
+    it.each(["input", "logical-session"] as const)(
+      "does not execute when the original queued %s authority has retired",
+      async (owner) => {
+        const fixture = arrange();
+        const assertCurrent =
+          owner === "input"
+            ? fixture.source.assertInputCurrent
+            : fixture.source.assertSessionCurrent;
+        assertCurrent.mockImplementation(() => {
+          throw new Error("original queued authority retired");
+        });
+        try {
+          await expect(fixture.execute()).rejects.toThrow("original queued authority retired");
+          expect(state.execute).not.toHaveBeenCalled();
+        } finally {
+          fixture.native.release();
+        }
+      },
+    );
+  });
+}

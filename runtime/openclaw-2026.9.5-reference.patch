+    !suppliedTarget.sessionId ||
+    !suppliedTarget.sessionKey ||
+    !suppliedTarget.storePath ||
+    !suppliedTarget.expectedWriterRunId
+  ) {
+    return undefined;
+  }
+  const target = withOwnedSessionTranscriptWriterFence({
+    ...suppliedTarget,
+    agentId: suppliedTarget.agentId,
+    sessionId: suppliedTarget.sessionId,
+    sessionKey: suppliedTarget.sessionKey,
+    storePath: suppliedTarget.storePath,
+    expectedWriterRunId: suppliedTarget.expectedWriterRunId,
+  });

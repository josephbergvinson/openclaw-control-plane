+++ b/src/agents/embedded-agent-runner/run/attempt-recovery.quota-continuation.test.ts
@@ -0,0 +1,200 @@
+import { describe, expect, it, vi } from "vitest";
+import {
+  recoverAfterTransportDrop,
+  type TransportDropScenario,
+} from "./attempt-recovery.test-support.js";
+import { createEmbeddedRunFailoverRetryController } from "./failover-retry-controller.js";
+
+function quotaProfiles(profileIds = ["openai:primary", "openai:backup"], pinned = false) {
+  let index = 0;
+  const advanceAuthProfile = vi.fn(async () => {
+    if (pinned || index + 1 >= profileIds.length) {
+      return false;
+    }
+    index += 1;
+    return true;
+  });
+  const controller = createEmbeddedRunFailoverRetryController({
+    runParams: {
+      runId: "quota-after-write",
+      authProfileId: profileIds[0],
+      authProfileIdSource: pinned ? "user" : "auto",
+    } as never,
+    provider: "openai",
+    modelId: "gpt-6-astra",
+    globalLane: "test",
+    agentDir: "/tmp/quota-continuation-test",
+    fallbackConfigured: true,
+    profileFailureStore: { version: 1, profiles: {} },
+    getLastProfileId: () => profileIds[index],
+    getSessionId: () => "quota-session",
+    harnessOwnsTransport: () => false,
+    getRuntimeAuthOwnerId: () => "embedded",
+    getApiKeyInfo: () => null,
+    advanceAuthProfile,
+  });
+  const markFailure = vi.spyOn(controller, "maybeMarkAuthProfileFailure").mockResolvedValue();
+  return { controller, advanceAuthProfile, markFailure, selected: () => profileIds[index] };
+}
+
+const quotaError = "Codex error: The usage limit has been reached";
+
+describe("quota recovery preserves committed work", () => {
+  it("rotates an automatic profile and continues the settled transcript without replaying the write", async () => {
+    const profiles = quotaProfiles();
+    const fixture = await recoverAfterTransportDrop({
+      toolCallIds: ["persisted_mutation"],
+      modelId: "gpt-6-astra",
+      thinkLevel: "ultra",
+      errorMessage: quotaError,
+      diagnostics: [],
+      content: [],
+      authProfileId: profiles.selected,
+      authProfileIdSource: "auto",
+      failoverRetryController: profiles.controller,
+    });
+    expect(fixture.recovery).toMatchObject({
+      action: "retry",
+      lastRetryFailoverReason: "rate_limit",
+      thinkLevel: "ultra",
+    });
+    expect(profiles.selected()).toBe("openai:backup");
+    expect(profiles.advanceAuthProfile).toHaveBeenCalledOnce();
+    expect(profiles.markFailure).toHaveBeenCalledWith(
+      expect.objectContaining({ profileId: "openai:primary", reason: "rate_limit" }),
+    );
+    expect(fixture.markOwnedTranscriptRetry).toHaveBeenCalledOnce();
+    expect(fixture.continueFromCurrentTranscript).toHaveBeenCalledExactlyOnceWith({
+      includeToolFailureInstruction: false,
+    });
+    expect(
+      fixture.attempt.messagesSnapshot.filter((message) => message.role === "toolResult"),
+    ).toHaveLength(1);
+    expect(fixture.traceAttempts).toEqual([
+      expect.objectContaining({
+        result: "rotate_profile",
+        reason: "rate_limit",
+        provider: "openai",
+        model: "gpt-6-astra",
+      }),
+    ]);
+    expect(profiles.controller.transientRetryCount).toBe(0);
+  });
+
+  it("continues through more than one authorized account without a model fallback", async () => {
+    const profiles = quotaProfiles(["openai:primary", "openai:backup", "openai:third"]);
+    await recoverAfterTransportDrop({
+      errorMessage: quotaError,
+      diagnostics: [],
+      content: [],
+      authProfileId: profiles.selected,
+      failoverRetryController: profiles.controller,
+    });
+    const second = await recoverAfterTransportDrop({
+      noTools: true,
+      replaySafe: true,
+      continuingTranscript: true,
+      errorMessage: quotaError,
+      diagnostics: [],
+      content: [],
+      authProfileId: profiles.selected,
+      failoverRetryController: profiles.controller,
+    });
+    expect(second.recovery.action).toBe("retry");
+    expect(profiles.selected()).toBe("openai:third");
+    expect(profiles.advanceAuthProfile).toHaveBeenCalledTimes(2);
+  });
+
+  it.each<[string, TransportDropScenario]>([
+    ["a missing persisted result", { missingToolResult: true }],
+    ["an active lifecycle item", { activeCount: 1 }],
+    ["asynchronous work", { asyncStarted: true }],
+    ["an intentional termination", { terminate: true }],
+    ["pending approval", { didSendDeterministicApprovalPrompt: true }],
+    ["an owning plugin harness", { pluginHarnessOwnsTransport: true }],
+    ["a yielded attempt", { yieldDetected: true }],
+    ["external cancellation", { terminal: { kind: "aborted", source: "external" } }],
+    ["an owned interruption", { signalOwnedInterruption: true }],
+    [
+      "a compaction timeout",
+      { terminal: { kind: "timeout", phase: "compaction", source: "observation" } },
+    ],
+    [
+      "a tool execution timeout",
+      { terminal: { kind: "timeout", phase: "tool_execution", source: "observation" } },
+    ],
+    [
+      "an expired run deadline",
+      { terminal: { kind: "timeout", phase: "prompt", source: "run_budget" } },
+    ],
+  ])("does not rotate after %s", async (_name, scenario) => {
+    const profiles = quotaProfiles();
+    const fixture = await recoverAfterTransportDrop({
+      ...scenario,
+      errorMessage: quotaError,
+      diagnostics: [],
+      content: [],
+      authProfileId: profiles.selected,
+      failoverRetryController: profiles.controller,
+    });
+    expect(fixture.recovery.action).toBe("proceed");
+    expect(profiles.advanceAuthProfile).not.toHaveBeenCalled();
+    expect(fixture.continueFromCurrentTranscript).not.toHaveBeenCalled();
+  });
+
+  it("does not continue when credential advancement fails", async () => {
+    const profiles = quotaProfiles();
+    profiles.advanceAuthProfile.mockRejectedValueOnce(new Error("credential source unavailable"));
+    await expect(
+      recoverAfterTransportDrop({
+        errorMessage: quotaError,
+        diagnostics: [],
+        content: [],
+        authProfileId: profiles.selected,
+        failoverRetryController: profiles.controller,
+      }),
+    ).rejects.toThrow("credential source unavailable");
+    expect(profiles.advanceAuthProfile).toHaveBeenCalledOnce();
+    expect(profiles.selected()).toBe("openai:primary");
+  });
+
+  it("keeps the advanced profile when failure bookkeeping is unavailable", async () => {
+    const profiles = quotaProfiles();
+    profiles.markFailure.mockRejectedValueOnce(new Error("metadata write unavailable"));
+    const fixture = await recoverAfterTransportDrop({
+      errorMessage: quotaError,
+      diagnostics: [],
+      content: [],
+      authProfileId: profiles.selected,
+      failoverRetryController: profiles.controller,
+    });
+    expect(fixture.recovery.action).toBe("retry");
+    expect(profiles.selected()).toBe("openai:backup");
+    expect(profiles.advanceAuthProfile).toHaveBeenCalledOnce();
+    expect(fixture.continueFromCurrentTranscript).toHaveBeenCalledOnce();
+  });
+
+  it.each([false, true])(
+    "leaves exhausted/pinned profiles terminal (pinned=%s)",
+    async (pinned) => {
+      const profiles = quotaProfiles(
+        pinned ? ["openai:primary", "openai:backup"] : ["openai:primary"],
+        pinned,
+      );
+      const fixture = await recoverAfterTransportDrop({
+        errorMessage: quotaError,
+        diagnostics: [],
+        content: [],
+        authProfileId: profiles.selected,
+        authProfileIdSource: pinned ? "user" : "auto",
+        failoverRetryController: profiles.controller,
+      });
+      expect(fixture.recovery.action).toBe("proceed");
+      expect(profiles.selected()).toBe("openai:primary");
+      expect(fixture.continueFromCurrentTranscript).not.toHaveBeenCalled();
+      if (pinned) {
+        expect(profiles.advanceAuthProfile).not.toHaveBeenCalled();
+      }
+    },
+  );
+});

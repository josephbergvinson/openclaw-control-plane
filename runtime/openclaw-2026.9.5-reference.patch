--- /dev/null
+++ b/src/infra/runtime-state-migration.test.ts
@@ -0,0 +1,311 @@
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { DatabaseSync } from "node:sqlite";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { withDoctorSqliteMaintenanceLock } from "../commands/doctor-sqlite-maintenance-lock.js";
+import {
+  closeOpenClawAgentDatabasesAsync,
+  openOpenClawAgentDatabase,
+} from "../state/openclaw-agent-db.js";
+import { removeCanonicalValidationFromHistoricalAgentFixture } from "../state/openclaw-agent-db.test-support.js";
+import {
+  closeOpenClawStateDatabaseByPathAsync,
+  openOpenClawStateDatabase,
+} from "../state/openclaw-state-db.js";
+import { STATE_SCHEMA_10_TO_9_DOWNGRADE_SQL } from "../state/openclaw-state-schema-v10-retirement.test-support.js";
+import { removePreparedWorkerOwnershipColumns } from "../state/openclaw-state-schema-v17.test-support.js";
+import { migrateRuntimeState, RuntimeStateMigrationError } from "./runtime-state-migration.js";
+
+let stateDir: string;
+let statePath: string;
+let configPath: string;
+let agentPath: string;
+
+function withDb<T>(pathname: string, read: (db: DatabaseSync) => T): T {
+  const db = new DatabaseSync(pathname);
+  try {
+    return read(db);
+  } finally {
+    db.close();
+  }
+}
+
+function version(pathname: string): unknown {
+  return withDb(pathname, (db) => db.prepare("PRAGMA user_version").get()?.user_version);
+}
+
+async function seedAgent(agentId: string): Promise<string> {
+  const opened = openOpenClawAgentDatabase({ agentId, env: process.env });
+  const pathname = opened.path;
+  removeCanonicalValidationFromHistoricalAgentFixture(opened.db);
+  opened.db.exec(`
+    INSERT INTO cache_entries (scope, key, value_json, expires_at, updated_at)
+      VALUES ('migration-proof', 'private', '{"synthetic":"do-not-emit"}', 100, 1);
+    DROP TABLE session_participants;
+    DROP TABLE session_transcript_cold_archives;
+    PRAGMA user_version = 17;
+    UPDATE schema_meta SET schema_version = 17;
+  `);
+  await closeOpenClawAgentDatabasesAsync();
+  return pathname;
+}
+
+beforeEach(async () => {
+  stateDir = fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), "runtime-migration-")));
+  configPath = path.join(stateDir, "openclaw.json");
+  statePath = path.join(stateDir, "state", "openclaw.sqlite");
+  vi.stubEnv("OPENCLAW_STATE_DIR", stateDir);
+  vi.stubEnv("OPENCLAW_CONFIG_PATH", configPath);
+  vi.stubEnv("OPENCLAW_LOG_LEVEL", "silent");
+  vi.stubEnv("OPENCLAW_HOME", stateDir);
+  vi.stubEnv("XDG_CACHE_HOME", path.join(stateDir, ".cache"));
+  fs.writeFileSync(configPath, JSON.stringify({ agents: { entries: { main: {} } } }));
+  openOpenClawStateDatabase({ env: process.env });
+  agentPath = await seedAgent("main");
+  await closeOpenClawStateDatabaseByPathAsync(statePath);
+  withDb(statePath, (db) => db.exec(STATE_SCHEMA_10_TO_9_DOWNGRADE_SQL));
+});
+
+afterEach(async () => {
+  await closeOpenClawAgentDatabasesAsync();
+  await closeOpenClawStateDatabaseByPathAsync(statePath);
+  vi.unstubAllEnvs();
+  vi.restoreAllMocks();
+  fs.rmSync(stateDir, { recursive: true, force: true });
+});
+
+describe("private runtime state migration", () => {
+  it("migrates native state 9 and agent 17, preserves data/config, and converges on repetition", async () => {
+    fs.writeFileSync(
+      configPath,
+      JSON.stringify({ agents: { entries: { main: {} } }, models: { providers: { openai: {} } } }),
+    );
+    const configBefore = fs.readFileSync(configPath);
+    const fetch = vi.spyOn(globalThis, "fetch").mockRejectedValue(new Error("No provider allowed"));
+    const expected = {
+      schemaVersion: 1,
+      status: "completed",
+      stateSchemaVersion: 17,
+      agentSchemaVersion: 21,
+      agentDatabaseCount: 1,
+    };
+    expect(await migrateRuntimeState({ stateDir, configPath })).toEqual(expected);
+    expect(version(statePath)).toBe(17);
+    expect(version(agentPath)).toBe(21);
+    expect(
+      withDb(agentPath, (db) =>
+        db.prepare("SELECT value_json FROM cache_entries WHERE scope = 'migration-proof'").get(),
+      ),
+    ).toEqual({ value_json: '{"synthetic":"do-not-emit"}' });
+    expect(fs.readFileSync(configPath)).toEqual(configBefore);
+    expect(await migrateRuntimeState({ stateDir, configPath })).toEqual(expected);
+    expect(fetch).not.toHaveBeenCalled();
+  });
+
+  it("migrates the installed state-16 and agent-19 shapes while preserving history bytes", async () => {
+    // Build the historical shape in an isolated fixture through the same helpers
+    // used by the native schema owner; this is never a live downgrade path.
+    await migrateRuntimeState({ stateDir, configPath });
+    withDb(statePath, (db) => {
+      removePreparedWorkerOwnershipColumns(db);
+      db.exec("PRAGMA user_version = 16; UPDATE schema_meta SET schema_version = 16;");
+    });
+    const eventJson = '{ "type": "message", "text": "retained history" }';
+    withDb(agentPath, (db) => {
+      removeCanonicalValidationFromHistoricalAgentFixture(db);
+      db.exec(`
+        DROP TABLE session_transcript_cold_archives;
+        PRAGMA user_version = 19;
+        UPDATE schema_meta SET schema_version = 19;
+        INSERT INTO session_nodes (session_key, current_session_id, entry_json, updated_at)
+          VALUES ('agent:main:history', 'history-window', '{"sessionId":"history-window","updatedAt":20}', 20);
+        INSERT INTO session_windows (session_id, session_key, created_at, updated_at)
+          VALUES ('history-window', 'agent:main:history', 10, 20);
+      `);
+      db.prepare(
+        "INSERT INTO transcript_events (session_id, seq, event_json, created_at) VALUES (?, ?, ?, ?)",
+      ).run("history-window", 7, eventJson, 11);
+    });
+    const configBefore = fs.readFileSync(configPath);
+    expect(await migrateRuntimeState({ stateDir, configPath })).toMatchObject({
+      status: "completed",
+      stateSchemaVersion: 17,
+      agentSchemaVersion: 21,
+      agentDatabaseCount: 1,
+    });
+    expect(
+      withDb(agentPath, (db) =>
+        db
+          .prepare("SELECT event_json FROM transcript_events WHERE session_id = 'history-window'")
+          .get(),
+      ),
+    ).toEqual({ event_json: eventJson });
+    expect(version(statePath)).toBe(17);
+    expect(version(agentPath)).toBe(21);
+    expect(fs.readFileSync(configPath)).toEqual(configBefore);
+  });
+
+  it("includes a registered unconfigured agent and does not create a missing configured agent", async () => {
+    // Seed while the shared owner is current; then restore the old shared fixture.
+    withDb(statePath, (db) =>
+      db.exec("PRAGMA user_version = 17; UPDATE schema_meta SET schema_version = 17;"),
+    );

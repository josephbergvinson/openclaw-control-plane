+}
+
+export async function withRecoveredCatalogPublication(
+  run: (context: {
+    attempt: Partial<Parameters<typeof prepareEmbeddedAttemptStream>[0]["attempt"]>;
+    sessionId: string;
+    released: Deferred;
+    publication: ReturnType<typeof waitForEmbeddedRunPublication>;
+  }) => Promise<void>,
+) {
+  const runId = "run-output-schema";
+  const sessionId = "session-output-schema";
+  const sessionKey = "agent:main:main";
+  const admission = prepareAgentRunAdmission({
+    cfg: {},
+    operationalRunInstance: createOperationalRunInstanceRef(runId),
+    facts: {
+      agentId: "main",
+      runId,
+      ingress: { kind: "system", state: "present", boundary: "publication-test" },
+    },
+  });
+  try {
+    await withPreparedEmbeddedRunToolAuthority(
+      { admittedRunContext: await admission.admit("embedded", "publication-test") },
+      {
+        runId,
+        sessionId,
+        sessionKey,
+        agentId: "main",
+        config: {},
+        provider: "test-provider",
+        modelId: "test-model",
+        sessionFile: "/tmp/queue-test-session",
+        workspaceDir: "/tmp/queue-test-workspace",
+      },
+      undefined,
+      async (preparedAttempt) => {
+        const released = createDeferredCore();
+        const publication = waitForEmbeddedRunPublication({
+          sessionId,
+          sessionKey,
+          runId,
+          ownerReleased: released.promise,
+        });
+        await run({ attempt: preparedAttempt, sessionId, released, publication });
+      },
+    );
+  } finally {
+    admission.close();
+  }
+}

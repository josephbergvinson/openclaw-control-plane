@@ -0,0 +1,355 @@
+import { createHash, randomUUID } from "node:crypto";
+import type { IncomingMessage, ServerResponse } from "node:http";
+import { createServer } from "node:http";
+import type { operatorMcpOAuthIdentity } from "../agents/mcp-oauth-identity.js";
+import { startMcpOAuthAuthorization } from "../agents/mcp-oauth.js";
+import { resolveMcpTransportConfig } from "../agents/mcp-transport-config.js";
+
+function sendJson(response: ServerResponse, body: unknown, status = 200): void {
+  response.writeHead(status, { "Content-Type": "application/json" });
+  response.end(JSON.stringify(body));
+}
+
+async function readBody(request: IncomingMessage): Promise<string> {
+  const chunks: Buffer[] = [];
+  for await (const chunk of request) {
+    chunks.push(Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk));
+  }
+  return Buffer.concat(chunks).toString("utf8");
+}
+
+export async function startOAuthFixture() {
+  let issuer = "";
+  let tokenRedirectUri: string | undefined;
+  let tokenVerifier: string | undefined;
+  let grantedScope: string | undefined;
+  let authorizationScope: string | undefined;
+  let successfulExchanges = 0;
+  let registrations = 0;
+  let registrationSupported = true;
+  let rejectNextRegistration = false;
+  let grantClient: string | undefined;
+  let rejectNextCodeClient = false;
+  let rejectNextResourceScope: { scope?: string } | undefined;
+  let resourceScopes: string[] | undefined;
+  const issuedCodes = new Map<
+    string,
+    { challenge: string; clientId: string; redirectUri: string; scope?: string }
+  >();
+  const tokenGrants: string[] = [];
+  const tokenClients: Array<string | null> = [];
+  const registeredClients = new Map<string, string>();
+  const authorizationErrors: Array<{ error: string; description: string }> = [];
+  const mcpRequests: Array<{
+    contentLength: string | undefined;
+    transferEncoding: string | undefined;
+    authorization: string | undefined;
+    body: string;
+  }> = [];
+  const handleRequest = async (request: IncomingMessage, response: ServerResponse) => {
+    const url = new URL(request.url ?? "/", issuer);
+    if (url.pathname.startsWith("/.well-known/oauth-protected-resource")) {
+      sendJson(response, {
+        resource: `${issuer}/mcp`,
+        authorization_servers: [issuer],
+        ...(resourceScopes ? { scopes_supported: resourceScopes } : {}),
+      });
+      return;
+    }
+    if (url.pathname === "/.well-known/oauth-authorization-server") {
+      sendJson(response, {
+        issuer,
+        authorization_endpoint: `${issuer}/authorize`,
+        token_endpoint: `${issuer}/token`,
+        ...(registrationSupported ? { registration_endpoint: `${issuer}/register` } : {}),
+        response_types_supported: ["code"],
+        grant_types_supported: ["authorization_code", "refresh_token"],
+        token_endpoint_auth_methods_supported: ["none"],
+        code_challenge_methods_supported: ["S256"],
+      });
+      return;
+    }
+    if (url.pathname === "/register" && request.method === "POST") {
+      const metadata = JSON.parse(await readBody(request)) as {
+        redirect_uris?: string[];
+        scope?: string;
+      };
+      registrations += 1;
+      if (rejectNextRegistration) {
+        rejectNextRegistration = false;
+        sendJson(
+          response,
+          { error: "invalid_client_metadata", error_description: "registration scope unavailable" },
+          400,
+        );
+        return;
+      }
+      const clientId = registrations === 1 ? "fixture-client" : `fixture-client-${registrations}`;
+      registeredClients.set(clientId, metadata.scope ?? "");
+      sendJson(
+        response,
+        {
+          ...metadata,
+          client_id: clientId,
+          client_id_issued_at: Math.floor(Date.now() / 1000),
+        },
+        201,
+      );
+      return;
+    }
+    if (url.pathname === "/authorize") {
+      const redirectUri = url.searchParams.get("redirect_uri");
+      const state = url.searchParams.get("state");
+      const codeChallenge = url.searchParams.get("code_challenge");
+      const clientId = url.searchParams.get("client_id");
+      authorizationScope = url.searchParams.get("scope") ?? undefined;
+      if (!redirectUri || !state || !codeChallenge || !clientId) {
+        sendJson(response, { error: "invalid_request" }, 400);
+        return;
+      }
+      const callback = new URL(redirectUri);
+      callback.searchParams.set("state", state);
+      const allowedScopes = new Set((registeredClients.get(clientId) ?? "").split(/\s+/));
+      const forbiddenScope = authorizationScope
+        ?.split(/\s+/)
+        .find((scope) => !allowedScopes.has(scope));
+      if (forbiddenScope) {
+        const description = `client is not allowed to request ${forbiddenScope}`;
+        authorizationErrors.push({ error: "invalid_scope", description });
+        callback.searchParams.set("error", "invalid_scope");
+        callback.searchParams.set("error_description", description);
+      } else if (url.searchParams.get("outcome") === "cancel") {
+        callback.searchParams.set("error", "access_denied");
+      } else {
+        const code = randomUUID();
+        issuedCodes.set(code, {
+          challenge: codeChallenge,
+          clientId,
+          redirectUri,
+          scope: authorizationScope,
+        });
+        callback.searchParams.set(
+          "code",
+          url.searchParams.get("outcome") === "invalid-code" ? "rejected-code" : code,
+        );
+      }
+      response.writeHead(302, { Location: callback.toString() });
+      response.end();
+      return;
+    }
+    if (url.pathname === "/token" && request.method === "POST") {
+      const form = new URLSearchParams(await readBody(request));
+      tokenGrants.push(form.get("grant_type") ?? "");
+      tokenClients.push(form.get("client_id"));
+      if (form.get("grant_type") === "refresh_token") {
+        if (
+          form.get("refresh_token") !== "fixture-refresh-token" ||
+          form.get("client_id") !== grantClient
+        ) {
+          sendJson(response, { error: "invalid_grant" }, 400);
+          return;
+        }
+        sendJson(response, {
+          access_token: "fixture-refreshed-access-token",
+          token_type: "Bearer",
+          expires_in: 3600,
+          scope: grantedScope,
+        });
+        return;
+      }
+      if (rejectNextCodeClient) {
+        rejectNextCodeClient = false;
+        sendJson(response, { error: "invalid_client" }, 400);
+        return;
+      }
+      tokenRedirectUri = form.get("redirect_uri") ?? undefined;
+      tokenVerifier = form.get("code_verifier") ?? undefined;
+      const challenge = tokenVerifier
+        ? createHash("sha256").update(tokenVerifier).digest("base64url")
+        : undefined;
+      const code = form.get("code") ?? "";
+      const issued = issuedCodes.get(code);
+      if (
+        !issued ||
+        challenge !== issued.challenge ||
+        form.get("client_id") !== issued.clientId ||
+        tokenRedirectUri !== issued.redirectUri
+      ) {
+        sendJson(response, { error: "invalid_grant" }, 400);
+        return;
+      }
+      issuedCodes.delete(code);
+      successfulExchanges += 1;
+      grantedScope = issued.scope;
+      grantClient = issued.clientId;
+      sendJson(response, {
+        access_token:
+          successfulExchanges === 1 ? "fixture-access-token" : "fixture-replacement-access-token",
+        refresh_token: "fixture-refresh-token",
+        token_type: "Bearer",
+        expires_in: 3600,
+        scope: grantedScope,
+      });
+      return;
+    }
+    if (url.pathname === "/mcp" && request.method === "POST") {
+      const body = await readBody(request);
+      mcpRequests.push({
+        contentLength: request.headers["content-length"],
+        transferEncoding: request.headers["transfer-encoding"],
+        authorization: request.headers.authorization,
+        body,
+      });
+      if (request.headers["content-length"] === undefined) {
+        response.writeHead(411, { "Content-Type": "text/plain" });
+        response.end("Content-Length required");
+        return;
+      }
+      if (rejectNextResourceScope) {
+        const scope = rejectNextResourceScope.scope;
+        response.writeHead(403, {
+          "Content-Type": "text/plain",
+          "WWW-Authenticate": `Bearer error="insufficient_scope", ${scope ? `scope="${scope}", ` : ""}resource_metadata="${issuer}/.well-known/oauth-protected-resource"`,
+        });
+        rejectNextResourceScope = undefined;
+        response.end("new consent required");
+        return;
+      }
+      if (mcpRequests.length === 1) {
+        response.writeHead(401, {
+          "Content-Type": "text/plain",
+          "WWW-Authenticate": 'Bearer scope="docs.read"',
+        });
+        response.end("expired token");
+        return;
+      }
+      const message = JSON.parse(body) as { id?: number; method?: string };
+      if (message.method === "initialize") {
+        sendJson(response, {
+          jsonrpc: "2.0",
+          id: message.id,
+          result: {
+            protocolVersion: "2025-06-18",
+            capabilities: { tools: {} },
+            serverInfo: { name: "fixture", version: "1.0.0" },
+          },
+        });
+        return;
+      }
+      if (message.method === "notifications/initialized") {
+        response.writeHead(202, { "Content-Length": "0" });
+        response.end();
+        return;
+      }
+      if (message.method === "tools/list") {
+        sendJson(response, {
+          jsonrpc: "2.0",
+          id: message.id,
+          result: {
+            tools: [
+              {
+                name: "read_page",
+                description: "Read one page.",
+                inputSchema: { type: "object", properties: {} },
+              },
+              ...(grantedScope?.split(" ").includes("docs.write")
+                ? [{ name: "edit_page", inputSchema: { type: "object", properties: {} } }]
+                : []),
+            ],
+          },
+        });
+        return;
+      }
+    }
+    response.writeHead(404).end();
+  };
+  const server = createServer((request, response) => {
+    void handleRequest(request, response).catch((error: unknown) => {
+      response.destroy(error instanceof Error ? error : new Error("OAuth fixture failed"));
+    });
+  });
+  await new Promise<void>((resolve, reject) => {
+    server.once("error", reject);
+    server.listen(0, "127.0.0.1", resolve);
+  });
+  const close = () =>
+    new Promise<void>((resolve) => {
+      server.close(() => resolve());
+    });
+  const address = server.address();
+  if (!address || typeof address === "string") {
+    await close();
+    throw new Error("OAuth fixture did not bind a TCP address");
+  }
+  issuer = `http://127.0.0.1:${address.port}`;
+  return {
+    issuer,
+    close,
+    exchange: () => ({ tokenRedirectUri, tokenVerifier }),
+    authorizationScope: () => authorizationScope,
+    tokenGrants: () => tokenGrants,
+    tokenClients: () => tokenClients,
+    registeredClients: () => registeredClients,
+    authorizationErrors: () => authorizationErrors,
+    disableRegistration: () => {
+      registrationSupported = false;
+    },
+    rejectNextRegistration: () => {
+      rejectNextRegistration = true;
+    },
+    rejectNextCodeClient: () => {
+      rejectNextCodeClient = true;
+    },
+    rejectNextResourceScope: (scope?: string) => {
+      rejectNextResourceScope = { scope };
+    },
+    setResourceScopes: (scopes: string[]) => {
+      resourceScopes = [...scopes];
+    },
+    mcpRequests: () => mcpRequests,
+  };
+}
+
+export function fixtureOAuthConfig(
+  fixture: Awaited<ReturnType<typeof startOAuthFixture>>,
+  scope?: string,
+) {
+  const config = resolveMcpTransportConfig("fixture", {
+    url: `${fixture.issuer}/mcp`,
+    transport: "streamable-http",
+    auth: "oauth",
+    oauth: { redirectUrl: "http://127.0.0.1:8989/oauth/callback", scope },
+  });
+  if (!config || config.kind !== "http") {
+    throw new Error("OAuth fixture needs an HTTP transport");
+  }
+  return config;
+}
+
+export async function fixtureBrowserCallback(authorizationUrl: string, outcome = "success") {
+  const request = new URL(authorizationUrl);
+  request.searchParams.set("outcome", outcome);
+  const response = await fetch(request, { redirect: "manual" });
+  const location = response.headers.get("location");
+  if (response.status !== 302 || !location) {
+    throw new Error("OAuth fixture did not redirect");
+  }
+  const callback = new URL(location);
+  return {
+    code: callback.searchParams.get("code") ?? "",
+    state: callback.searchParams.get("state") ?? "",
+    error: callback.searchParams.get("error"),
+    errorDescription: callback.searchParams.get("error_description"),
+  };
+}
+
+export async function fixtureConsent(
+  identity: ReturnType<typeof operatorMcpOAuthIdentity>,
+  config: ReturnType<typeof fixtureOAuthConfig>,
+) {
+  const started = await startMcpOAuthAuthorization(identity, config, { reauthorize: true });
+  if (started.status !== "redirect") {
+    throw new Error("OAuth fixture did not start new consent");
+  }
+  return started;
+}

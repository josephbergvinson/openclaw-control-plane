+import {
+  createDirectOutboundTestAdapter,
+  createOutboundTestPlugin,
+} from "../test-utils/channel-plugins.js";
+import { agentCommand } from "./agent.js";
+import {
+  createDefaultAgentResult,
+  getLastEmbeddedCall,
+  installThinkingTestProviders,
+  withTempHome,
+} from "./agent.test-fixtures.js";
+
+// Keep the parent suite's admission mocks, lifecycle reset, and test ordering.
+export function registerAgentContinuationPresentationCases({
+  mockConfig,
+  runtime,
+}: {
+  mockConfig: (
+    home: string,
+    storePath: string,
+    agentOverrides?: Partial<NonNullable<NonNullable<OpenClawConfig["agents"]>["defaults"]>>,
+  ) => OpenClawConfig;
+  runtime: RuntimeEnv;
+}): void {
+  it.each([
+    "unchanged",
+    "modified",
+    "cancelled",
+    "internal",
+    "heartbeat",
+    "cron",
+    "child",
+    "tool_only",
+    "undelivered",
+    "ordinary",
+    "commentary_disabled",
+    "streaming_off",
+    "account_off",
+    "typing_never",
+  ] as const)(
+    "presents requester continuation progress with %s delivery policy",
+    async (hookMode) => {
+      await withTempHome(async (home) => {
+        const visible = ["unchanged", "modified", "cancelled", "typing_never"].includes(hookMode);
+        const typingVisible = visible
+          ? hookMode !== "typing_never"
+          : ["commentary_disabled", "streaming_off", "account_off"].includes(hookMode);
+        const store = path.join(home, "sessions.json");
+        const cfg = mockConfig(home, store, {
+          typingMode: hookMode === "typing_never" ? "never" : "instant",
+        });
+        cfg.channels = {
+          discord: {
+            streaming: {
+              mode: hookMode === "streaming_off" ? "off" : "progress",
+              progress: { commentary: hookMode !== "commentary_disabled" },
+            },
+            ...(hookMode === "account_off"
+              ? { accounts: { work: { streaming: { mode: "off" } } } }
+              : {}),
+          },
+        };
+        const sendText = vi.fn(async () => ({ channel: "discord", messageId: "progress-1" }));
+        const sendTyping = vi.fn(async () => {});
+        const clearTyping = vi.fn(async () => {});
+        const plugin = createOutboundTestPlugin({
+          id: "discord",
+          outbound: { ...createDirectOutboundTestAdapter({ channel: "discord" }), sendText },
+        });
+        plugin.heartbeat = { sendTyping, clearTyping };
+        const registry = installThinkingTestProviders([
+          { pluginId: "discord", source: "test", plugin },
+        ]);
+        const hook = vi.fn<PluginHookHandlerMap["reply_payload_sending"]>((event) =>
+          hookMode === "cancelled"
+            ? { cancel: true }
+            : {
+                payload: {
+                  ...event.payload,
+                  text: hookMode === "modified" ? "Reviewed progress." : event.payload.text,
+                },
+              },
+        );
+        registry.typedHooks.push({
+          pluginId: "progress-guard",
+          hookName: "reply_payload_sending",
+          handler: hook,
+          source: "test",
+        });
+        initializeGlobalHookRunner(registry);
+        vi.mocked(runEmbeddedAgent).mockImplementationOnce(async (params) => {
+          await params.onAgentEvent?.({ stream: "lifecycle", data: { phase: "start" } });
+          await params.onAgentEvent?.({
+            stream: "item",
+            data: {
+              kind: "preamble",
+              itemId: "commentary-1",
+              phase: "update",
+              progressText: "Checking",
+            },
+          });
+          expect(sendText).not.toHaveBeenCalled();
+          const completed = {
+            stream: "item",
+            data: {
+              kind: "preamble",
+              itemId: "commentary-1",
+              phase: "end",
+              progressText: "Checking the calendar.",
+            },
+          };
+          await params.onAgentEvent?.(completed);
+          await params.onAgentEvent?.(completed);
+          expect(hook).toHaveBeenCalledTimes(visible ? 1 : 0);
+          if (visible) {
+            expect(hook.mock.calls[0]?.[0]).toMatchObject({
+              kind: "block",
+              payload: { isCommentary: true },
+            });
+          }
+          if (!visible || hookMode === "cancelled") {
+            expect(sendText).not.toHaveBeenCalled();
+          } else {
+            expect(sendText).toHaveBeenCalledExactlyOnceWith(
+              expect.objectContaining({
+                to: "channel:source",
+                accountId: "work",
+                threadId: "thread-source",
+                text: hookMode === "modified" ? "Reviewed progress." : "Checking the calendar.",
+              }),
+            );
+          }
+          if (typingVisible) {
+            expect(sendTyping).toHaveBeenCalledWith(
+              expect.objectContaining({
+                to: "channel:source",

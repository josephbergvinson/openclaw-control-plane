+    }
+
+    @Test func `discovery diagnostic serialization contains only closed reasons and counts`() async throws {
+        let harness = try Harness()
+        harness.accountEvidence = ["private-native-title", "private-account@example.invalid"]
+        harness.discoveryDiagnostics.axReadFailureCount = 2
+        let result = try await harness.call(.init(action: .credentialPrompts))
+        let diagnostics = try #require(result.details?["credentialPromptDiagnostics"]?.value as? [String: Any])
+        #expect(Set(diagnostics.keys) == [
+            "reason", "axReadFailureCount", "bindingCandidateCount", "bindingRejections", "observedSecureFieldCount",
+        ])
+        #expect(diagnostics["reason"] as? String == "ax_metadata_unavailable")
+        let encoded = try #require(String(data: JSONEncoder().encode(result), encoding: .utf8))

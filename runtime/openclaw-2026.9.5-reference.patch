+/** A recovery transcript remains owned until its exact children's private receipts settle. */
+export function hasUnsettledPrivateChildReceipt(
+  runs: ReadonlyMap<string, SubagentRunRecord>,
+  owner: SubagentRunRecord,
+): boolean {

+import type { SessionDeliveryState } from "../../../config/sessions/types.js";
+import type { CallGatewayOptions } from "../../../gateway/call.js";
+import type { AgentEventPayload } from "../../../infra/agent-events.js";
+import type { AgentRunTerminalReplySnapshot } from "../../agent-run-terminal-reply.types.js";
+import type { deliverAgentCommandResult } from "../../command/delivery.js";
+import type { EmbeddedAgentRunResult } from "../../embedded-agent-runner/types.js";
+
+type LifecycleData = {
+  phase?: string;
+  endedAt?: number;
+  terminalReply?: AgentRunTerminalReplySnapshot;
+};
+export type LifecycleEvent = Pick<AgentEventPayload, "runId"> &
+  Partial<Omit<AgentEventPayload, "runId" | "data">> & { data?: LifecycleData };
+export type SessionStoreEntry = {
+  sessionId: string;
+  updatedAt: number;
+  delivery?: SessionDeliveryState;
+};
+export type GatewayRequest = Omit<CallGatewayOptions, "params"> & {
+  params?: {
+    sessionKey?: string;
+    inputProvenance?: { sourceSessionKey?: string };
+    idempotencyKey?: string;
+    message?: string;
+  };
+};
+
+type GatewayDeliveryStatus = NonNullable<
+  Awaited<ReturnType<typeof deliverAgentCommandResult>>["deliveryStatus"]
+>;
+
+export type GatewayResponse = {
+  status?: string;
+  runId?: string;
+  messages?: Array<Record<string, unknown>>;
+  result?: Partial<EmbeddedAgentRunResult> & { deliveryStatus?: Partial<GatewayDeliveryStatus> };
+};
+
+export function createRequesterWakeSessionAccessors(
+  getSessionStore: () => Record<string, SessionStoreEntry>,
+) {
+  return {
+    loadSessionEntry: (scope: { sessionKey: string }) => getSessionStore()[scope.sessionKey],
+    loadSessionEntryReadOnly: (scope: { sessionKey: string }) =>
+      getSessionStore()[scope.sessionKey],
+    patchSessionEntryCore: async (
+      ...[scope, update, options = {}]: Parameters<
+        typeof import("../../../config/sessions/session-accessor.js").patchSessionEntryCore
+      >
+    ) => {
+      const entry = getSessionStore()[scope.sessionKey];
+      if (!entry) {
+        return null;
+      }
+      const patch = await update(structuredClone(entry), { existingEntry: structuredClone(entry) });
+      if (patch === null) {
+        return entry;
+      }
+      const next = options.replaceEntry ? patch : { ...entry, ...patch };
+      const { sessionId, updatedAt } = next;
+      if (typeof sessionId !== "string" || typeof updatedAt !== "number") {
+        throw new Error("Session fixture replacement requires its identity and activity timestamp");
+      }
+      options.assertCommitAllowed?.();
+      const updated = { ...next, sessionId, updatedAt };
+      getSessionStore()[scope.sessionKey] = updated;
+      return updated;
+    },
+    listSessionEntriesReadOnly: () =>
+      Object.entries(getSessionStore()).map(([sessionKey, entry]) => ({ sessionKey, entry })),
+  };
+}

+    expect(sendMessage).not.toHaveBeenCalled();
+    expect(peekSystemEvents(entry.requesterSessionKey)).toEqual([]);
+    expect(entry.completionTarget).toBe("parent");
+  });
+
+  it("preserves an ordinary operator cancellation receipt", async () => {
+    const { task } = createChild({ completionTarget: undefined });
+    expect(await cancelTaskById({ cfg: {}, taskId: task.taskId })).toMatchObject({
+      cancelled: true,
+    });
+    await vi.waitFor(() => expect(sendMessage).toHaveBeenCalledOnce());
+    expect(sendMessage.mock.calls[0]![0]).toMatchObject({
+      ...origin,
+      content: expect.stringContaining("Background task cancellation requested:"),
+    });
+    expect(getTaskById(task.taskId)?.deliveryStatus).toBe("delivered");
+  });
+
+  it("rechecks private lifecycle ownership after loading delivery runtime", async () => {
+    const { entry, task } = createChild({ completionTarget: undefined });
+    markTaskTerminalById({
+      taskId: task.taskId,
+      status: "cancelled",
+      endedAt: Date.now(),
+      error: "Cancelled by operator.",
+    });
+    vi.spyOn(deliveryRuntime, "loadTaskRegistryDeliveryRuntime").mockImplementationOnce(
+      async () => {
+        entry.completionTarget = "parent";
+        return { sendMessage };
+      },
+    );
+    await maybeDeliverTaskTerminalUpdate(task.taskId);
+    expect(sendMessage).not.toHaveBeenCalled();
+    expect(getTaskById(task.taskId)?.deliveryStatus).toBe("pending");
+  });
+
+  it.each(["generation", "requester", "run"] as const)(
+    "does not let an unrelated private %s suppress an ordinary cancellation",
+    async (mismatch) => {
+      const { entry, task } = createChild();
+      if (mismatch === "generation") {
+        entry.generation += 1;
+      }
+      if (mismatch === "requester") {
+        entry.requesterSessionKey = "agent:main:subagent:other";
+      }
+      if (mismatch === "run") {
+        entry.taskRunId = "other-task-run";
+      }
+      markTaskTerminalById({
+        taskId: task.taskId,
+        status: "cancelled",
+        endedAt: Date.now(),
+        error: "Cancelled by operator.",
+      });
+      await maybeDeliverTaskTerminalUpdate(task.taskId);
+      expect(sendMessage).toHaveBeenCalledOnce();
+      expect(getTaskById(task.taskId)?.deliveryStatus).toBe("delivered");
+    },
+  );
+});

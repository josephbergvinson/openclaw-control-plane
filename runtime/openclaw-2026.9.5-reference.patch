@@ -0,0 +1,208 @@
+import { realpath } from "node:fs/promises";
+import { join } from "node:path";
+import { describe, expect, it, vi } from "vitest";
+import { createDeferred } from "../../../test/helpers/promise.js";
+import type { ChannelIngressDispatchLifecycle } from "../../channels/message/ingress-drain-lifecycle.js";
+import type { ChannelIngressDrainDispatchResult } from "../../channels/message/ingress-drain-state.js";
+import {
+  contextEngineCompactMock,
+  loadCompactHooksHarness,
+  resetCompactHooksHarnessMocks,
+} from "./compact.hooks.harness.js";
+
+const { compactEmbeddedAgentSession: compact } = await loadCompactHooksHarness();
+// Load real owners after the harness reset so compaction and ingress share
+// the same write context and database lifetime.
+const [
+  { upsertSessionEntryCore },
+  { closeOpenClawAgentDatabasesForTest },
+  { createChannelIngressDrain, bindIngressLifecycleToReplyOptions },
+  { createTestIngressQueue, withTempState },
+  { fanInChannelIngressLifecycles },
+  { createInboundDebouncer },
+  { startFollowupRunPreAdoptionHeartbeat },
+] = await Promise.all([
+  import("../../config/sessions/session-accessor.js"),
+  import("../../state/openclaw-agent-db.js"),
+  import("../../channels/message/ingress-drain.js"),
+  import("../../channels/message/ingress-drain.test-helpers.js"),
+  import("../../plugin-sdk/channel-ingress-runtime.js"),
+  import("../../auto-reply/inbound-debounce.js"),
+  import("../../auto-reply/reply/queue/lifecycle.js"),
+]);
+
+const completed = (sessionId: string) => ({
+  ok: true,
+  compacted: true,
+  result: { sessionId, summary: "summary", tokensBefore: 120, tokensAfter: 40 },
+});
+
+describe("queued compaction ingress ownership", () => {
+  it.each(
+    [1, 2].flatMap((claimCount) =>
+      (["adopt", "stall", "timeout", "error", "dispose"] as const).map((outcome) => ({
+        claimCount,
+        outcome,
+      })),
+    ),
+  )(
+    "keeps $claimCount debounced claims live through bounded compaction until $outcome",
+    async ({ claimCount, outcome }) => {
+      await withTempState(async (stateDir) => {
+        const workspaceDir = await realpath(stateDir);
+        const sessionId = "predecessor";
+        const sessionKey = "agent:main:compaction-ingress";
+        const target = {
+          agentId: "main",
+          sessionId,
+          sessionKey,
+          storePath: join(workspaceDir, "sessions.sqlite"),
+        };
+        const entry = {
+          sessionId,
+          lifecycleRevision: "lifecycle",
+          activeWriterRunId: "writer",
+          updatedAt: 1,
+        };
+        resetCompactHooksHarnessMocks(workspaceDir);
+        await upsertSessionEntryCore(target, entry);
+        vi.useFakeTimers();
+        const started = createDeferred();
+        const backend = createDeferred<ReturnType<typeof completed>>();
+        const compacted = createDeferred();
+        const continueDispatch = createDeferred();
+        const queue = createTestIngressQueue(stateDir);
+        const eventIds = Array.from({ length: claimCount }, (_, index) => `compacting-${index}`);
+        for (const id of eventIds) {
+          await queue.enqueue(id, { text: "Keep this pending input." }, { laneKey: id });
+        }
+        let ingressSignal: AbortSignal | undefined;
+        const dispatchResult = createDeferred<ChannelIngressDrainDispatchResult>();
+        contextEngineCompactMock.mockImplementation(async () => {
+          started.resolve();
+          return await backend.promise;
+        });
+        // Discord fans even a single claim through this SDK/debounce composition
+        // before binding the logical turn to reply-lane admission.
+        const debouncer = createInboundDebouncer<ChannelIngressDispatchLifecycle>({
+          debounceMs: 1,
+          buildKey: () => "logical-turn",
+          onFlush: (lifecycles, createFlush) => {
+            const ingress = fanInChannelIngressLifecycles(lifecycles);
+            return createFlush({
+              lifecycle: ingress.lifecycle,
+              dispatch: async (lifecycle) => {
+                ingressSignal = lifecycle.abortSignal;
+                const { turnAdoptionLifecycle } = bindIngressLifecycleToReplyOptions(lifecycle);
+                const stopHeartbeat = startFollowupRunPreAdoptionHeartbeat(
+                  turnAdoptionLifecycle,
+                  lifecycle.abortSignal,
+                );
+                const result = await compact({
+                  ...target,
+                  sessionTarget: target,
+                  sessionFile: sessionKey,
+                  sessionEntry: entry,
+                  workspaceDir,
+                  provider: "openai",
+                  model: "test-model",
+                  agentHarnessId: "openclaw",
+                  abortSignal: lifecycle.abortSignal,
+                  enqueue: async <T>(task: () => Promise<T> | T) => await task(),
+                }).finally(() => stopHeartbeat?.());

+/** Captures one materialization's admitted output workspace and request authority. */
+export function createMcpToolResultProducer(options: {
+  runtime: { workspaceDir: string };
+  contextWindowTokens?: number;
+  loggingConfig?: OpenClawConfig["logging"];
+  assertCurrent?: () => void;
+}) {
+  const runtime = options.runtime;
+  const workspaceDir = runtime.workspaceDir;
+  const maxChars =
+    options.contextWindowTokens === undefined
+      ? DEFAULT_MAX_LIVE_TOOL_RESULT_CHARS
+      : resolveLiveToolResultMaxChars({ contextWindowTokens: options.contextWindowTokens });
+  return (signal: AbortSignal | undefined, run: () => Promise<AgentToolResult<unknown>>) =>
+    runWithSessionMcpRequestSignal(signal, async () => {
+      options.assertCurrent?.();
+      const result = await run();
+      options.assertCurrent?.();
+      return await preserveMcpToolOutput(result, {
+        workspaceDir,
+        maxChars,
+        loggingConfig: options.loggingConfig,
+        assertCurrent: () => {
+          options.assertCurrent?.();
+          if (runtime.workspaceDir !== workspaceDir) {
+            throw new Error("The admitted MCP output workspace changed.");
+          }
+        },
+        signal,
+      });
+    });
+}

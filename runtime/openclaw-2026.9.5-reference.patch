@@ -0,0 +1,361 @@
+import { createDeferred } from "openclaw/plugin-sdk/extension-shared";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { RequestClient } from "../internal/discord.js";
+import { createDiscordDraftPreviewController } from "./message-handler.draft-preview.js";
+
+function createHarness() {
+  const visible = new Map<string, { channel: string; text: string }>();
+  const requests: Array<{ method: string; channel: string; id: string; text?: string }> = [];
+  let nextId = 0;
+  let beforeEdit: (() => Promise<void>) | undefined;
+  const rest = new RequestClient("test-token", {
+    queueRequests: false,
+    fetch: async (input, init) => {
+      const url = new URL(input instanceof Request ? input.url : input);
+      const parts = url.pathname.split("/");
+      const channel = parts.at(-3) === "channels" ? parts.at(-2)! : parts.at(-3)!;
+      const method = init?.method ?? "GET";
+      const id = method === "POST" ? String(++nextId) : parts.at(-1)!;
+      if (method === "DELETE") {
+        visible.delete(id);
+        requests.push({ method, channel, id });
+        return new Response(null, { status: 204 });
+      }
+      if (typeof init?.body !== "string") {
+        throw new Error("Expected a serialized Discord message");
+      }
+      const body = JSON.parse(init.body) as {
+        content: string;
+        allowed_mentions: { parse: string[] };
+      };
+      expect(body.allowed_mentions).toEqual({ parse: [] });
+      if (method === "PATCH") {
+        await beforeEdit?.();
+      }
+      visible.set(id, { channel, text: body.content });
+      requests.push({ method, channel, id, text: body.content });
+      return Response.json({ id });
+    },
+  });
+  const controller = createDiscordDraftPreviewController({
+    cfg: {},
+    discordConfig: {
+      streaming: {
+        mode: "progress",
+        progress: { label: false, toolProgress: false, commentary: true, narration: true },
+      },
+    },
+    accountId: "default",
+    sourceRepliesAreToolOnly: false,
+    textLimit: 2_000,
+    deliveryRest: rest,
+    deliverChannelId: "source",
+    replyReference: { peek: () => undefined },
+    tableMode: "off",
+    maxLinesPerMessage: undefined,
+    chunkMode: "length",
+    log: vi.fn(),
+  });
+  const preamble = async (itemId: string, progressText: string, phase = "end") => {
+    await controller.pushPreambleItemEvent({ itemId, progressText, phase });
+    await controller.flush();
+  };
+  return {
+    controller,
+    visible,
+    requests,
+    preamble,
+    blockEdit: (fn: () => Promise<void>) => {
+      beforeEdit = fn;
+    },
+  };
+}
+
+describe("Discord foreground progress checkpoints", () => {
+  beforeEach(() => {
+    vi.useFakeTimers();
+    vi.setSystemTime(new Date("2026-09-24T14:32:00Z"));
+  });
+  afterEach(() => vi.useRealTimers());
+
+  it("creates a new notification from fresh completed progress after three minutes", async () => {
+    const h = createHarness();
+    await h.preamble(
+      "first",
+      "I found the submitted documents; I’m checking the remaining fields.",
+    );
+    await vi.advanceTimersByTimeAsync(60_000);
+    await h.preamble(
+      "second",
+      "The account statements match. I’m checking the company ownership record.",
+    );
+    expect(h.requests.filter((r) => r.method === "POST")).toHaveLength(1);
+    const retiredText = h.visible.get("1")?.text;
+    await vi.advanceTimersByTimeAsync(120_000);
+    await h.preamble("third", "The ownership record", "update");
+    expect(h.visible.get("1")?.text).toBe(retiredText);
+    expect(h.requests.filter((r) => r.method === "POST")).toHaveLength(1);
+    await h.preamble(
+      "third",
+      "The ownership record is verified. I’m filling the remaining form fields.",
+    );
+    expect([...h.visible.values()].map((entry) => entry.text)).toEqual([
+      retiredText,
+      "The ownership record is verified. I’m filling the remaining form fields.",
+    ]);
+    expect(h.requests.filter((r) => r.method === "POST")).toHaveLength(2);
+    await h.preamble("first", "A delayed old commentary update.");
+    await h.preamble(
+      "replayed",
+      "The account statements match. I’m checking the company ownership record.",
+    );
+    expect(h.visible.get("2")?.text).not.toContain("delayed");
+    expect(h.visible.get("2")?.text).not.toContain("account statements");
+    h.controller.markFinalReplyStarted();
+    h.controller.markFinalReplyDelivered(false);
+    await h.controller.cleanup();
+    expect([...h.visible.keys()]).toEqual(["1"]);
+  });
+
+  it("does not generate idle notifications or rotate from hidden tool activity", async () => {
+    const h = createHarness();
+    await h.preamble("first", "I’m checking the original documents.");
+    await vi.advanceTimersByTimeAsync(600_000);
+    await h.controller.pushToolEvent({
+      toolCallId: "private",
+      name: "exec",
+      phase: "start",
+      args: { command: "private command" },
+    });
+    await h.controller.flush();
+    expect(h.requests.filter((r) => r.method === "POST")).toHaveLength(1);
+    expect([...h.visible.values()][0]?.text).toBe("I’m checking the original documents.");
+    await h.controller.cleanup();
+  });
+
+  it("does not publish a file-change summary before meaningful progress or retain one on yield", async () => {
+    const h = createHarness();
+    const write = async (toolCallId: string) => {
+      await h.controller.pushToolEvent({
+        toolCallId,
+        name: "write",
+        phase: "start",
+        args: { path: "notes.md", content: "line\n".repeat(29) },
+      });
+      await h.controller.pushItemEvent({
+        toolCallId,
+        kind: "tool",
+        phase: "end",
+        status: "completed",
+      });
+      await vi.advanceTimersByTimeAsync(1_500);
+      await h.controller.flush();
+    };
+
+    await write("write-first");
+    expect(h.requests).toEqual([]);
+    expect(await h.controller.finalizeProgressDraft()).toBe(false);
+
+    h.controller.handleQueuedFollowupAdmitted();
+    await h.preamble("first", "I checked the documents and prepared the requested changes.");
+    await vi.advanceTimersByTimeAsync(180_000);
+    await h.preamble("second", "The checks passed; I’m preparing the final result.");
+    await write("write-after-checkpoint");
+    expect([...h.visible.values()].map((entry) => entry.text)).toEqual([
+      "I checked the documents and prepared the requested changes.",
+      "The checks passed; I’m preparing the final result.",
+    ]);
+    expect(await h.controller.finalizeProgressDraft()).toBe(true);
+    await h.controller.cleanup();
+    expect(h.requests.some((request) => request.text?.includes("files +"))).toBe(false);
+    expect(h.visible.size).toBe(2);
+  });
+
+  it("keeps one streaming item in its original message when completion crosses the interval", async () => {
+    const h = createHarness();
+    await h.preamble("first", "I’m checking the originals.");
+    await vi.advanceTimersByTimeAsync(179_000);
+    await h.preamble("second", "The original", "update");
+    await vi.advanceTimersByTimeAsync(2_000);
+    await h.preamble("second", "The original statement confirms the date.");
+    expect(h.requests.filter((r) => r.method === "POST")).toHaveLength(1);
+    await h.controller.cleanup();
+  });
+
+  it("rotates fresh narration without carrying the previous commentary forward", async () => {
+    const h = createHarness();
+    await h.preamble("first", "I’m checking the submitted form.");
+    await vi.advanceTimersByTimeAsync(180_000);
+    await h.controller.pushNarrationProgress(
+      "The supporting records are verified; the revised form is being checked.",
+    );
+    await h.controller.flush();
+    expect(h.visible.get("2")?.text).toBe(
+      "The supporting records are verified; the revised form is being checked.",
+    );
+    await vi.advanceTimersByTimeAsync(180_000);
+    await h.controller.pushNarrationProgress(
+      "The supporting records are verified; the revised form is being checked.",
+    );
+    await h.controller.flush();
+    expect(h.requests.filter((r) => r.method === "POST")).toHaveLength(2);
+    await h.controller.cleanup();
+  });
+
+  it("does not create a checkpoint from private tags or silent commentary", async () => {
+    const h = createHarness();
+    await h.preamble("first", "I’m checking the records.");
+    await vi.advanceTimersByTimeAsync(180_000);
+    await h.preamble("private", "<think>Private deliberation</think>");
+    await h.preamble("silent", "NO_REPLY");
+    expect(h.requests.filter((r) => r.method === "POST")).toHaveLength(1);
+    expect(h.requests.map((r) => r.text).join(" ")).not.toContain("Private deliberation");
+    await h.controller.cleanup();
+  });
+
+  it.each([
+    "NO_REPLY",
+    "_NO_REPLY_",
+    "**NO_REPLY**",
+    "`NO_REPLY`",
+    "~~NO_REPLY~~",
+    "[[reply_to_current]] _NO_REPLY_ [[audio_as_voice]]",
+  ])("keeps the active card editable after due-age silent commentary %s", async (text) => {
+    const h = createHarness();
+    await h.preamble("first", "I’m checking the records.");
+    const messageId = h.controller.draftStream?.messageId();
+    expect(messageId).toBe("1");
+    await vi.advanceTimersByTimeAsync(180_000);
+
+    expect(
+      await h.controller.pushPreambleItemEvent({
+        itemId: "silent",
+        progressText: text,
+        phase: "end",
+      }),
+    ).toBe(false);
+    await h.controller.flush();
+    expect(h.controller.draftStream?.messageId()).toBe(messageId);
+    expect(h.requests).toHaveLength(1);
+
+    await h.preamble("first", "The original records confirm the corrected date.");
+    expect(h.requests.at(-1)).toMatchObject({
+      method: "PATCH",
+      id: messageId,
+      text: "The original records confirm the corrected date.",
+    });
+    expect(h.controller.draftStream?.messageId()).toBe(messageId);
+    h.controller.markFinalReplyStarted();
+    h.controller.markFinalReplyDelivered(false);
+    await h.controller.cleanup();
+    expect(h.requests.at(-1)).toMatchObject({ method: "DELETE", id: messageId });
+    expect(h.visible.size).toBe(0);
+  });
+
+  it.each(["final", "queued"] as const)(
+    "cancels an in-flight rotation at the %s boundary",
+    async (boundary) => {
+      const h = createHarness();
+      await h.preamble("first", "I’m checking the records.");
+      const started = createDeferred<void>();
+      const release = createDeferred<void>();
+      h.blockEdit(async () => {
+        started.resolve();
+        await release.promise;
+      });
+      h.controller.draftStream?.update("A prior accepted progress edit.");
+      const flush = h.controller.flush();
+      await started.promise;
+      await vi.advanceTimersByTimeAsync(180_000);
+      const checkpoint = h.controller.pushPreambleItemEvent({
+        itemId: "stale",
+        phase: "end",
+        progressText: "This checkpoint was canceled.",
+      });
+      await Promise.resolve();
+      if (boundary === "final") {
+        h.controller.markFinalReplyStarted();
+        h.controller.markFinalReplyDelivered(false);
+      } else {
+        h.controller.handleQueuedFollowupAdmitted();
+      }
+      release.resolve();
+      await flush;
+      await checkpoint;

+        MessageSid: "msg",
+      };
+      const dispatch = vi
+        .spyOn(gatewayDispatch, "dispatchGatewayMethodInProcess")
+        .mockResolvedValue({ reply: "Inspection complete.", action: "none" });
+      const transport = vi
+        .spyOn(gatewayTransport, "callGatewayTool")
+        .mockRejectedValue(new Error("Unexpected wire dispatch"));
+      let caller: ReturnType<typeof createAdmittedGatewayToolCallerIdentity>;
+      let toolGateway: GatewayRequestContext | undefined;
+      let delegationError: unknown;
+      let activeDuringExecution: boolean | undefined;
+      let preparedCallbackReached = false;
+      state.runEmbeddedAgentMock.mockImplementationOnce(
+        async (params: RunEmbeddedAgentInternalParams) => {
+          if (!params.preparedRunAdmission) {
+            throw new Error("Expected the channel turn's prepared admission");
+          }
+          const sessionFile = params.sessionFile;
+          if (typeof sessionFile !== "string" || sessionFile.length === 0) {
+            throw new Error("Expected the channel turn's session file");
+          }
+          const context = await params.preparedRunAdmission.admit("embedded");
+          caller = createAdmittedGatewayToolCallerIdentity({
+            admittedRunContext: context,
+            agentId: "main",
+            sessionKey: "main",
+          });
+          toolGateway = caller?.gatewayContextResolver?.();
+          activeDuringExecution = getAdmittedRunDelegatedAuthority(context) !== undefined;
+          const tool = createOpenClawDelegateToolsForRun({
+            sessionAgentId: "main",
+            runSessionKey: "main",
+            execSession: { permissionMode: "guarded" },
+          })[0];
+          if (!tool) {
+            throw new Error("Expected the delegation tool");
+          }
+          try {
+            await withGatewayToolCallerIdentity(caller, () =>
+              withPreparedEmbeddedRunToolAuthority(
+                { admittedRunContext: context, replyOperation },
+                {
+                  ...params,
+                  config: params.config ?? {},
+                  provider: params.provider ?? "openai",
+                  modelId: params.model ?? "gpt-5.4",
+                  runId: context.operationalRunInstance.runId,
+                  agentId: "main",
+                  sessionKey: "main",
+                  sessionFile,
+                  toolAuthorityFingerprint: "prepared-reply-authority",

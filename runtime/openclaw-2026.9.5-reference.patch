diff --git a/src/auto-reply/reply/dispatch-from-config.native-goal.integration.test.ts b/src/auto-reply/reply/dispatch-from-config.native-goal.integration.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9ceb0c163e4b0750dc1d146eb989e036417bfee4
--- /dev/null
+++ b/src/auto-reply/reply/dispatch-from-config.native-goal.integration.test.ts
@@ -0,0 +1,278 @@
+import fs from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { createDeferred } from "../../../test/helpers/promise.js";
+import { createUpdateGoalTool } from "../../agents/tools/goal-tools.js";
+import type { SessionEntry } from "../../config/sessions/types.js";
+import { withReplyDispatcher } from "../dispatch-dispatcher.js";
+import { setReplyPayloadMetadata } from "../reply-payload.js";
+import type { ReplyPayload } from "../types.js";
+import { handleGoalCommand } from "./commands-goal.js";
+import type { HandleCommandsParams } from "./commands-types.js";
+import { parseInlineSessionDirectives } from "./directive-handling.parse.js";
+import { dispatchReplyFromConfig } from "./dispatch-from-config.js";
+import {
+  hookMocks,
+  resetPluginTtsAndThreadMocks,
+  sessionStoreMocks,
+  setDiscordTestRegistry,
+} from "./dispatch-from-config.shared.test-harness.js";
+import type { InternalGetReplyOptions } from "./get-reply.types.js";
+import { resetInboundDedupe } from "./inbound-dedupe.js";
+import { createReplyDispatcher } from "./reply-dispatcher.js";
+import { replyRunRegistry, runAfterReplyOperationClear } from "./reply-run-registry.js";
+import { testing } from "./reply-run-registry.test-support.js";
+import { admitReplyTurn } from "./reply-turn-admission.js";
+import { buildTestCtx } from "./test-ctx.js";
+
+// Audit publication is outside this dispatcher regression; session mutations below
+// still go through the real goal owners and the existing session-accessor fixture.
+vi.mock("../../sessions/session-state-events.js", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("../../sessions/session-state-events.js")>()),
+  recordSessionGoalChanged: vi.fn(async () => {}),
+}));
+
+const sourceKey = "agent:main:discord:slash:goal-owner";
+const targetKey = "agent:main:discord:channel:goal-target";
+let storePath: string;
+let tempRoot: string;
+let realSessionAccessor: typeof import("../../config/sessions/session-accessor.js");
+let initialSessionEntry: Pick<SessionEntry, "sessionId" | "updatedAt">;
+const sessionId = "native-goal-session";
+const finalText = "Read-only review complete.";
+
+describe("native goal command through the real dispatch and admission owners", () => {
+  beforeEach(async () => {
+    testing.resetReplyRunRegistry();
+    resetInboundDedupe();
+    setDiscordTestRegistry();
+    resetPluginTtsAndThreadMocks();
+    hookMocks.runner.hasHooks.mockReturnValue(false);
+    tempRoot = await fs.mkdtemp(path.join(os.tmpdir(), "openclaw-native-goal-dispatch-"));
+    storePath = path.join(tempRoot, "sessions.json");
+    realSessionAccessor = await vi.importActual<
+      typeof import("../../config/sessions/session-accessor.js")
+    >("../../config/sessions/session-accessor.js");
+    initialSessionEntry = { sessionId, updatedAt: Date.now() };
+    await realSessionAccessor.replaceSessionEntry(
+      { sessionKey: targetKey, storePath },
+      initialSessionEntry,
+    );
+    sessionStoreMocks.resolveSessionStorePathCore.mockReturnValue(storePath);
+    sessionStoreMocks.currentEntry = initialSessionEntry;
+    sessionStoreMocks.loadSessionEntry.mockImplementation(() => sessionStoreMocks.currentEntry);
+    sessionStoreMocks.loadSessionStoreEntry.mockImplementation(
+      () => sessionStoreMocks.currentEntry,
+    );
+    sessionStoreMocks.loadSessionStore.mockImplementation(() => ({
+      [targetKey]: sessionStoreMocks.currentEntry,
+    }));
+    sessionStoreMocks.readSessionEntry.mockImplementation(() => sessionStoreMocks.currentEntry);
+  });
+
+  afterEach(async () => {
+    testing.resetReplyRunRegistry();
+    resetInboundDedupe();
+    vi.restoreAllMocks();
+    await fs.rm(tempRoot, { recursive: true, force: true });
+  });
+
+  it.each([false, true])(
+    "delivers the final after source-to-target adoption (compaction and waiting child: %s)",
+    async (withCompactionAndChild) => {
+      const finalStarted = createDeferred();
+      const allowFinal = createDeferred();
+      const childFinished = createDeferred();
+      const observed: Array<{ kind: string; text?: string }> = [];
+      let childRan = false;
+      let adopted = false;
+      const cfg = {
+        messages: { visibleReplies: "automatic" as const },
+        session: { store: storePath },
+      };
+      const ctx = buildTestCtx({
+        Body: "/goal start Inspect the staging site read-only.",
+        BodyForAgent: "/goal start Inspect the staging site read-only.",
+        RawBody: "/goal start Inspect the staging site read-only.",
+        CommandBody: "/goal start Inspect the staging site read-only.",
+        CommandSource: "native",
+        CommandAuthorized: true,
+        CommandTurn: { kind: "native", source: "native", authorized: true },
+        Provider: "discord",
+        Surface: "discord",
+        OriginatingChannel: "discord",
+        OriginatingTo: "channel:goal-target",
+        SessionKey: sourceKey,
+        CommandTargetSessionKey: targetKey,
+        From: "discord:channel:goal-target",
+        To: "slash:goal-owner",
+        ChatType: "channel",
+        WasMentioned: true,
+        SenderId: "goal-owner",
+        MessageSid: `native-goal-${withCompactionAndChild}`,
+      });
+      const dispatcher = createReplyDispatcher({
+        deliver: async (payload, info) => {
+          if (info.kind === "final") {
+            finalStarted.resolve();
+            await allowFinal.promise;
+          }
+          observed.push({ kind: info.kind, text: payload.text });
+          return { visibleReplySent: true };
+        },
+      });
+      const dispatch = withReplyDispatcher({
+        dispatcher,
+        run: () =>
+          dispatchReplyFromConfig({
+            ctx,
+            cfg,
+            dispatcher,
+            replyResolver: async (resolverCtx, options) => {
+              const opts = options as InternalGetReplyOptions;
+              const command: HandleCommandsParams = {
+                cfg,
+                ctx: resolverCtx,
+                rootCtx: ctx,
+                command: {
+                  commandBodyNormalized: "/goal start Inspect the staging site read-only.",
+                  rawBodyNormalized: "/goal start Inspect the staging site read-only.",
+                  isAuthorizedSender: true,
+                  senderIsOwner: true,
+                  senderId: "goal-owner",
+                  channel: "discord",
+                  channelId: "discord",
+                  surface: "discord",
+                  ownerList: [],
+                },
+                agentId: "main",
+                directives: parseInlineSessionDirectives(
+                  "/goal start Inspect the staging site read-only.",
+                ),
+                elevated: { enabled: false, allowed: false, failures: [] },
+                sessionKey: targetKey,
+                sessionEntry: initialSessionEntry,
+                storePath,
+                workspaceDir: "/tmp",
+                opts,
+                provider: "openai",
+                model: "gpt-6-astra",
+                contextTokens: 272000,
+                defaultGroupActivation: () => "always",
+                resolvedVerboseLevel: "off",
+                resolvedReasoningLevel: "off",
+                resolveDefaultThinkingLevel: async () => "off",
+                isGroup: true,
+              };
+              const continuation = await handleGoalCommand(command, true);
+              expect(continuation?.shouldContinue).toBe(true);
+              expect(command.command.commandBodyNormalized).toBe(
+                "Inspect the staging site read-only.",
+              );
+              const operation = opts.replyOperation;
+              expect(operation?.key).toBe(sourceKey);
+              if (!operation) {
+                throw new Error("Native continuation lost its dispatch operation");
+              }
+              // The real get-reply continuation calls this same admission owner.
+              // Only model execution and session storage are fixture boundaries here.
+              const admission = await admitReplyTurn({
+                agentId: "main",
+                sessionKey: targetKey,
+                sessionId: operation.sessionId,
+                expectedSessionId: sessionId,
+                storePath,
+                kind: "visible",
+                resetTriggered: false,
+                upstreamAbortSignal: opts.abortSignal,
+                waitForActive: false,
+                adoptOperation: operation,
+              });
+              expect(admission.status).toBe("owned");
+              adopted = true;
+              expect(replyRunRegistry.get(targetKey)).toBe(operation);
+              expect(replyRunRegistry.get(sourceKey)).toBeUndefined();
+              if (withCompactionAndChild) {
+                await opts.onBlockReply?.({ text: "Compaction complete", isStatusNotice: true });
+                runAfterReplyOperationClear(operation, () => {
+                  childRan = true;
+                  observed.push({ kind: "child" });
+                  childFinished.resolve();
+                });
+              }
+              const goalTool = createUpdateGoalTool({ runSessionKey: targetKey, config: cfg });
+              const completion = await goalTool.execute("goal-completion", { status: "complete" });
+              expect(completion).toMatchObject({ details: { status: "updated" } });
+              const completedEntry = realSessionAccessor.loadSessionEntry({
+                sessionKey: targetKey,
+                storePath,
+              });
+              expect(completedEntry?.goal).toMatchObject({ status: "complete" });
+              sessionStoreMocks.currentEntry = { ...completedEntry };
+              const payload: ReplyPayload = setReplyPayloadMetadata(
+                { text: finalText },
+                {
+                  pendingFinalDeliveryCompletion: {
+                    deliveryId: "goal-final",
+                    intentId: "goal-intent",
+                    sessionId,
+                    sessionKey: targetKey,
+                    storePath,
+                  },
+                },
+              );
+              sessionStoreMocks.currentEntry = {
+                ...sessionStoreMocks.currentEntry,
+                pendingFinalDelivery: {
+                  kind: "replayable",
+                  text: finalText,
+                  createdAt: Date.now(),
+                  intentId: "goal-intent",
+                  deliveries: [{ id: "goal-final", state: "prepared" }],
+                },
+              };
+              await realSessionAccessor.patchSessionEntryCore(
+                { sessionKey: targetKey, storePath },
+                () => ({
+                  pendingFinalDelivery: {
+                    kind: "replayable",
+                    text: finalText,
+                    createdAt: Date.now(),
+                    intentId: "goal-intent",
+                    deliveries: [{ id: "goal-final", state: "prepared" }],
+                  },
+                }),
+              );
+              return payload;
+            },
+          }),
+      });
+      try {
+        await Promise.race([
+          finalStarted.promise,
+          dispatch.then(() => {
+            throw new Error(`Dispatch returned before final delivery: ${JSON.stringify(observed)}`);
+          }),
+        ]);
+        expect(adopted).toBe(true);
+        expect(childRan).toBe(false);
+        allowFinal.resolve();
+        const result = await dispatch;
+        expect(result.queuedFinal).toBe(true);
+        const receipt = await dispatcher.waitForIdle();
+        expect(receipt?.counts.final.delivered).toBe(1);
+        expect(observed.filter(({ kind }) => kind === "final")).toEqual([
+          { kind: "final", text: finalText },
+        ]);
+        if (withCompactionAndChild) {
+          await childFinished.promise;
+          expect(observed.at(-1)?.kind).toBe("child");
+        }
+      } finally {
+        allowFinal.resolve();
+        await dispatch;
+      }
+    },
+  );
+});

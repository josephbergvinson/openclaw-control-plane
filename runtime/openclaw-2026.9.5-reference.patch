diff --git a/src/agents/tool-images.integrity.test.ts b/src/agents/tool-images.integrity.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..69df227f7dc3fab7126686b9809247e53185bdb1
--- /dev/null
+++ b/src/agents/tool-images.integrity.test.ts
@@ -0,0 +1,95 @@
+// Model image admission uses codec-produced bytes, never unverified header-only payloads.
+import { inflateSync } from "node:zlib";
+import { describe, expect, it } from "vitest";
+import { createSolidPngBuffer } from "../../test/helpers/image-fixtures.js";
+import { getImageMetadata } from "../media/image-ops.js";
+import { buildNativeImageToolResult } from "./tools/image-tool.result.js";
+
+const GRAY_ALPHA_PNG = Buffer.from(
+  "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR4nGMQ/w8AATABF491p08AAAAASUVORK5CYII=",
+  "base64",
+);
+
+function damageIdatChecksum(source: Buffer): Buffer {
+  const damaged = Buffer.from(source);
+  const typeOffset = damaged.indexOf("IDAT");
+  expect(typeOffset).toBeGreaterThan(0);
+  const length = damaged.readUInt32BE(typeOffset - 4);
+  const checksumOffset = typeOffset + 4 + length;
+  damaged.writeUInt8(damaged.readUInt8(checksumOffset) ^ 0xff, checksumOffset);
+  return damaged;
+}
+
+async function loadImages(buffers: Buffer[]) {
+  return await buildNativeImageToolResult(
+    buffers.map((buffer) => ({ buffer, mimeType: "image/png", resolvedImage: "fixture.png" })),
+  );
+}
+
+describe("model image integrity", () => {
+  it("keeps a valid one-pixel PNG available to the model", async () => {
+    const source = createSolidPngBuffer(1, 1, { r: 23, g: 23, b: 23 });
+    const result = await loadImages([source]);
+    const image = result.content.find((block) => block.type === "image");
+    expect(image?.type).toBe("image");
+    if (!image || image.type !== "image") {
+      throw new Error("expected canonical image");
+    }
+    expect(image.mimeType).toBe("image/png");
+    expect(await getImageMetadata(Buffer.from(image.data, "base64"))).toEqual({
+      width: 1,
+      height: 1,
+    });
+    expect(result.content[0]).toMatchObject({
+      type: "text",
+      text: expect.stringContaining("Loaded 1 image"),
+    });
+  });
+
+  it("replaces an undecodable PNG with local feedback instead of a model image", async () => {
+    const invalid = createSolidPngBuffer(1, 1, { r: 23, g: 23, b: 23 }).subarray(0, 33);
+    const result = await loadImages([invalid]);
+    expect(result.content.some((block) => block.type === "image")).toBe(false);
+    expect(result.content[0]).toEqual({
+      type: "text",
+      text: "No images loaded into private model context. Obtain a valid image and try again.",
+    });
+    expect(result.content).toContainEqual({
+      type: "text",
+      text: expect.stringContaining("omitted image payload"),
+    });
+  });
+
+  it("forwards canonical pixels when the codec recovers a damaged gray-alpha PNG", async () => {
+    const damaged = damageIdatChecksum(GRAY_ALPHA_PNG);
+    const result = await loadImages([damaged]);
+    const image = result.content.find((block) => block.type === "image");
+    if (!image || image.type !== "image") {
+      throw new Error("expected repaired canonical image");
+    }
+    const canonical = Buffer.from(image.data, "base64");
+    expect(canonical.equals(damaged)).toBe(false);
+    expect(image.mimeType).toBe("image/png");
+    expect(await getImageMetadata(canonical)).toEqual({ width: 1, height: 1 });
+    const typeOffset = canonical.indexOf("IDAT");
+    expect(typeOffset).toBeGreaterThan(0);
+    const length = canonical.readUInt32BE(typeOffset - 4);
+    expect(inflateSync(canonical.subarray(typeOffset + 4, typeOffset + 4 + length))).toEqual(
+      Buffer.from([0, 23, 23, 23, 255]),
+    );
+  });
+
+  it("reports the accepted count when one image is omitted and the next is valid", async () => {
+    const valid = createSolidPngBuffer(1, 1, { r: 23, g: 23, b: 23 });
+    const result = await loadImages([valid.subarray(0, 33), valid]);
+    expect(result.content.filter((block) => block.type === "image")).toHaveLength(1);
+    expect(result.content[0]).toMatchObject({
+      type: "text",
+      text: expect.stringContaining("Loaded 1 image"),
+    });
+    expect(result.content).toContainEqual({
+      type: "text",
+      text: expect.stringContaining("omitted image payload"),
+    });
+  });
+});

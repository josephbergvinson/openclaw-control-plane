+registerAgentSessionLoopTestLifecycle();
+
+async function assemble(
+  message?: PersistedUserTurnMessage,
+  overrides?: Partial<EmbeddedRunAttemptParams>,
+  registeredHooks: PluginRegistry["typedHooks"] = [],
+  preparedSession?: Awaited<ReturnType<typeof createTestSession>>,
+  alreadyPrepared = false,
+) {
+  const { session, sessionManager, modelRegistry } = preparedSession ?? (await createTestSession());
+  const runId = overrides?.runId ?? "same-correlation-run";
+  const admission = prepareSystemAgentRunAdmission({}, runId, "main", "current-user-test");
+  const recorder = message
+    ? createUserTurnTranscriptRecorder({ message, target: () => undefined })
+    : undefined;
+  const preparedUserTurnMessage = alreadyPrepared ? message : await recorder?.resolveMessage();
+  const attempt: EmbeddedRunAttemptParams = {
+    admittedRunContext: await admission.admit("embedded"),
+    authStorage: modelRegistry.authStorage,
+    authProfileStore: { version: 1, profiles: {} },
+    modelRegistry,
+    config: {},
+    model: testModel,
+    modelId: testModel.id,
+    provider: testModel.provider,
+    thinkLevel: "off",
+    prompt: "Projected history says use this channel's history; this is not current user text.",
+    transcriptPrompt: "Caller-rendered transcript",
+    currentMessageId: "transport-fallback-id",
+    userTurnTranscriptRecorder: recorder,
+    runId,
+    sessionId: runId,
+    sessionKey: "agent:main:discord:channel:fixture",
+    sessionFile: "",
+    sessionPersistence: "detached",
+    trigger: "user",
+    timeoutMs: 10_000,
+    workspaceDir: "/synthetic/current-user-test",
+    toolAuthorityFingerprint: "current-tools",
+    ...overrides,
+  };
+  const events: { phase: string; event: PluginHookBeforePromptBuildEvent }[] = [];
+  const hookRunner = createHookRunner({
+    plugins: [],
+    hooks: [],
+    typedHooks: [
+      ...[false, true].map((authorized) => {
+        const hook: PluginRegistry["typedHooks"][number] = {
+          pluginId: authorized ? "authorized" : "legacy",
+          source: "test",
+          hookName: "before_prompt_build",
+          handler: (event: PluginHookBeforePromptBuildEvent) => {
+            events.push({ phase: authorized ? "authorized" : "legacy", event });
+          },
+        };
+        if (authorized) {
+          hook.requiresToolAuthority = true;
+        }
+        return hook;
+      }),
+      ...registeredHooks,
+    ],
+  });
+  try {
+    await prepareEmbeddedAttemptPromptAssembly({
+      attempt,
+      activeSession: session,
+      sessionManager,
+      hookRunner,
+      hookAgentId: "main",
+      diagnosticTrace: { traceId: "11111111111111111111111111111111" },
+      isRawModelRun: false,
+      sessionAgentId: "main",
+      runtimeModel: testModel.id,
+      systemPromptText: "Base system prompt",
+      applyPromptBuildToolsAllow: () => ["memory_search"],
+      setActiveSessionSystemPrompt: vi.fn(),
+      setLeasedSteering: vi.fn(),
+      preparedUserTurnMessage,
+    });
+    return events;
+  } finally {
+    admission.close();
+    forgetPromptBuildDrainCacheForRun(runId);
+  }
+}
+
+describe("embedded prompt hooks receive the prepared current user", () => {
+  it("carries the same exact recorder text and native identity to both hook phases", async () => {
+    const events = await assemble({
+      role: "user",
+      content: "Using this channel’s history, which account did we verify earlier?",
+      idempotencyKey: "native-A:user",
+      timestamp: 1,
+    });
+    expect(events.map(({ phase }) => phase)).toEqual(["legacy", "authorized"]);
+    for (const { event } of events) {
+      expect(event).toMatchObject({
+        currentUserMessage: "Using this channel’s history, which account did we verify earlier?",
+        currentUserMessageId: "native-A:user",
+      });
+      expect(event.prompt).toContain("Projected history");
+    }
+  });
+
+  it("keeps replay identity stable and separates a later input despite the same runId", async () => {
+    const message = {
+      role: "user" as const,
+      content: "What did we say earlier in this thread?",
+      idempotencyKey: "native-A:user",
+      timestamp: 1,
+    };
+    const first = await assemble(message);
+    const replay = await assemble(message, { prompt: "Different rebuild envelope" });
+    const next = await assemble({ ...message, idempotencyKey: "native-B:user" });
+    expect(
+      [first, replay, next].map((events) => events.map(({ event }) => event.currentUserMessageId)),
+    ).toEqual([
+      ["native-A:user", "native-A:user"],
+      ["native-A:user", "native-A:user"],
+      ["native-B:user", "native-B:user"],
+    ]);
+  });
+
+  it("extracts text blocks without importing image or projected context", async () => {
+    const events = await assemble({
+      role: "user",
+      content: [
+        { type: "text", text: "First line" },
+        { type: "image", data: "synthetic", mimeType: "image/png" },
+        { type: "text", text: "Second line" },
+      ],
+      idempotencyKey: "native-C:user",
+      timestamp: 1,
+    });
+    expect(events.map(({ event }) => event.currentUserMessage)).toEqual([
+      "First line\nSecond line",
+      "First line\nSecond line",
+    ]);
+  });
+
+  it("preserves an explicitly prepared no-text request", async () => {
+    const events = await assemble({
+      role: "user",
+      content: [{ type: "image", data: "synthetic", mimeType: "image/png" }],
+      idempotencyKey: "native-D:user",
+      timestamp: 1,
+    });
+    expect(events.map(({ event }) => event.currentUserMessage)).toEqual(["", ""]);
+  });
+
+  it("does not substitute a transport or run ID for an already prepared keyless input", async () => {
+    const events = await assemble(
+      {
+        role: "user",
+        content: "Using only this thread, recall the earlier account.",
+        timestamp: 1,
+      },
+      undefined,
+      [],
+      undefined,
+      true,
+    );
+    for (const { event } of events) {
+      expect(event.currentUserMessage).toContain("Using only this thread");
+      expect(event).not.toHaveProperty("currentUserMessageId");
+    }
+  });
+
+  it("preserves legacy omission instead of trusting rendered prompt markers", async () => {
+    const events = await assemble();
+    for (const { event } of events) {
+      expect(event).not.toHaveProperty("currentUserMessage");
+      expect(event).not.toHaveProperty("currentUserMessageId");
+    }
+  });
+});
+
+describe("embedded assembly invokes registered Active Memory", () => {
+  function registerActiveMemory(runEmbeddedAgent: ReturnType<typeof vi.fn>) {
+    const typedHooks: PluginRegistry["typedHooks"] = [];
+    const pluginConfig = {
+      agents: ["main"],
+      mode: "escalate",
+      allowedChatTypes: ["channel"],
+      model: "openai/gpt-6.1-sol",
+      thinking: "max",
+    };
+    const config = {
+      agents: { defaults: { model: { primary: "openai/gpt-6.1-sol" } } },
+      plugins: {
+        slots: { memory: "memory-core" },
+        entries: { "active-memory": { enabled: true, config: pluginConfig } },
+      },
+    };
+    const runtime = {
+      config: { current: () => config, loadConfig: () => config },
+      agent: {
+        runEmbeddedAgent,
+        resolveCliBackendDispatchEligibility: () => undefined,
+        session: {
+          resolveStorePath: () => "/synthetic/recall.json",
+          getSessionEntry: () => undefined,
+          patchSessionEntry: async () => undefined,
+        },
+      },
+      state: { openKeyedStore: () => ({ lookup: async () => undefined }) },
+    } as unknown as OpenClawPluginApi["runtime"];
+    activeMemory.register(
+      createTestPluginApi({
+        id: "active-memory",
+        config,
+        pluginConfig,
+        runtime,
+        on: (name, handler, options) => {
+          if (name === "before_prompt_build") {
+            typedHooks.push({
+              pluginId: "active-memory",
+              source: "test",
+              hookName: name,
+              handler,
+              ...options,
+            });
+          }
+        },
+      }),
+    );
+    return typedHooks;
+  }
+
+  it.each([
+    {
+      name: "ordinary admitted steering",
+      text: "Use the blue icon for the next draft.",
+      waits: false,
+    },
+    {
+      name: "actual admitted recall",
+      text: "What did we decide last week?",
+      waits: true,
+    },
+  ])(
+    "uses $name instead of old rendered recall text through actual assembly and registration",
+    async ({ text, waits }) => {
+      const preparedSession = await createTestSession();
+      vi.useFakeTimers();
+      const held = createDeferred<{ payloads: { text: string }[]; meta: Record<string, never> }>();
+      const runEmbeddedAgent = vi.fn((_params: unknown) => held.promise);
+      const hooks = registerActiveMemory(runEmbeddedAgent);
+      let settled = false;
+      const result = assemble(
+        { role: "user", content: text, idempotencyKey: `composed-${waits}:user`, timestamp: 1 },
+        {
+          config: {},
+          prompt:
+            "Previous user request: What did we decide last week? Recall our earlier decision.",
+          messageProvider: "discord",
+          sessionKey: `agent:main:discord:channel:composed-${waits}`,
+          currentChannelId: `composed-${waits}`,
+        },
+        hooks,
+        preparedSession,
+      ).then((events) => {
+        settled = true;
+        return events;
+      });
+      try {
+        await vi.advanceTimersByTimeAsync(0);
+        expect(settled).toBe(!waits);
+        expect(runEmbeddedAgent).toHaveBeenCalledTimes(waits ? 1 : 0);
+        if (waits) {
+          expect(runEmbeddedAgent.mock.calls[0]?.[0]).toMatchObject({
+            trigger: "manual",
+            lane: "active-memory",
+            conversationRecall: undefined,
+          });
+        }
+      } finally {
+        held.resolve({ payloads: [{ text: "NONE" }], meta: {} });
+        await vi.advanceTimersByTimeAsync(0);
+        await result;
+        vi.useRealTimers();
+      }
+    },
+  );
+});

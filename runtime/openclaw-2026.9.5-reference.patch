+function createHarness(maxChars = 2_000) {
+  const visible = new Map<string, { channel: string; content: string }>();
+  const requests: Array<{ method: string; channel: string; id: string; content?: string }> = [];
+  let nextId = 0;
+  let beforeWrite: (() => Promise<void>) | undefined;
+  let afterWrite: (() => Promise<void>) | undefined;
+  const nonceIds = new Map<string, string>();
+  const rest = new RequestClient("test-token", {
+    queueRequests: false,
+    fetch: async (input, init) => {
+      const url = new URL(input instanceof Request ? input.url : input);
+      const parts = url.pathname.split("/");
+      const method = init?.method ?? "GET";
+      const channel = method === "POST" ? parts.at(-2)! : parts.at(-3)!;
+      let id = method === "POST" ? "" : parts.at(-1)!;
+      if (method === "DELETE") {
+        requests.push({ method, channel, id });
+        visible.delete(id);
+        return new Response(null, { status: 204 });
+      }
+      if (typeof init?.body !== "string") {
+        throw new Error("Expected serialized Discord message");
+      }
+      const body = JSON.parse(init.body) as {
+        content: string;
+        allowed_mentions: { parse: string[] };
+        nonce?: string;
+        enforce_nonce?: boolean;
+      };
+      if (method === "POST") {
+        expect(body.enforce_nonce).toBe(true);
+        expect(body.nonce).toBeTruthy();
+        id = nonceIds.get(body.nonce!) ?? String(++nextId);
+      }
+      expect(body.allowed_mentions).toEqual({ parse: [] });
+      expect(body.content.length).toBeLessThanOrEqual(maxChars);
+      requests.push({ method, channel, id, content: body.content });
+      await beforeWrite?.();
+      if (method === "POST" && nonceIds.has(body.nonce!)) {
+        return Response.json({ id });
+      }
+      visible.set(id, { channel, content: body.content });
+      if (method === "POST") {
+        nonceIds.set(body.nonce!, id);
+      }
+      await afterWrite?.();
+      return Response.json({ id });
+    },
+  });
+  const chunkText = (text: string) => chunkDiscordTextWithMode(text, { maxChars, maxLines: 100 });
+  const stream = createDiscordDraftStream({ rest, channelId: "source", maxChars, chunkText });
+  return {
+    stream,
+    visible,
+    requests,
+    chunkText,
+    beforeWrite: (fn?: () => Promise<void>) => {
+      beforeWrite = fn;
+    },
+    afterWrite: (fn?: () => Promise<void>) => {
+      afterWrite = fn;

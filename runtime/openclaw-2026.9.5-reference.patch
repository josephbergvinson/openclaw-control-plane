+import { describe, expect, it } from "vitest";
+import { captureAdmittedChatSendSessionSettings } from "./chat-send-session-settings.js";
+
+const cfg = { agents: { defaults: { ownerPermissionMode: "full" as const } } };
+const entry = { sessionId: "session-owner", updatedAt: 0 };
+const base = {
+  commit: true,
+  cfg,
+  entry,
+  expectedPermissionMode: undefined,
+  expectedToolOverrides: undefined,
+};
+
+describe("native owner permission default snapshot", () => {
+  it("captures Full without persisting it or changing expected-default comparison", () => {
+    const result = captureAdmittedChatSendSessionSettings({
+      ...base,
+      senderIsOwner: true,
+      expectedPermissionMode: null,
+    });
+    expect(result?.permissionMode).toBe("full");
+    expect(Object.isFrozen(result)).toBe(true);
+    expect(entry).not.toHaveProperty("permissionMode");
+  });
+  it.each([false, undefined])("does not elevate a caller with owner status %s", (senderIsOwner) => {
+    expect(
+      captureAdmittedChatSendSessionSettings({ ...base, senderIsOwner })?.permissionMode,
+    ).toBeUndefined();
+  });
+  it.each(["read-only", "guarded", "workspace", "full"] as const)(
+    "preserves explicit %s",
+    (permissionMode) => {
+      expect(
+        captureAdmittedChatSendSessionSettings({
+          ...base,
+          senderIsOwner: true,
+          entry: { ...entry, permissionMode },
+        })?.permissionMode,
+      ).toBe(permissionMode);
+    },
+  );
+  it("refuses a stale explicit expectation", () => {
+    expect(() =>
+      captureAdmittedChatSendSessionSettings({
+        ...base,
+        senderIsOwner: true,
+        expectedPermissionMode: "full",
+      }),
+    ).toThrow("session-settings-changed");
+  });
+  it("does not resolve a synthetic continuation as a fresh owner", () => {
+    expect(
+      captureAdmittedChatSendSessionSettings({
+        ...base,
+        senderIsOwner: true,
+        inputProvenance: { kind: "internal_system" },
+      })?.permissionMode,
+    ).toBeUndefined();
+  });
+});

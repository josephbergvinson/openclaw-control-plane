new file mode 100644
index 0000000000000000000000000000000000000000..51b2f01e5d69b8027d17e987ba1a3861697a5b89
--- /dev/null
+++ b/src/agents/openclaw-tools.web-fetch-workspace.test.ts
@@ -0,0 +1,139 @@
+import fs from "node:fs/promises";
+import path from "node:path";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { useAutoCleanupTempDirTracker } from "../../test/helpers/temp-dir.js";
+import { wrapToolWorkspaceRootGuardWithOptions } from "./agent-tools.read.js";
+import { createOpenClawTools } from "./openclaw-tools.js";
+import { createReadTool } from "./sessions/tools/read.js";
+
+const { guardedFetch, providerDefinition } = vi.hoisted(() => ({
+  guardedFetch: vi.fn(),
+  providerDefinition: vi.fn(),
+}));
+
+vi.mock("./openclaw-plugin-tools.js", () => ({
+  resolveOpenClawPluginToolsForOptions: () => [],
+}));
+vi.mock("./tools/web-guarded-fetch.js", () => ({
+  fetchWithWebToolsNetworkGuard: guardedFetch,
+}));
+vi.mock("../web-fetch/runtime.js", () => ({
+  resolveWebFetchDefinition: providerDefinition,
+}));
+
+const tempDirs = useAutoCleanupTempDirTracker(afterEach);
+const spillPaths = new Set<string>();
+const body = "Company source material.\n".repeat(100);
+
+function createTool(options: NonNullable<Parameters<typeof createOpenClawTools>[0]>) {
+  const tool = createOpenClawTools({
+    config: {
+      plugins: { enabled: false },
+      tools: { web: { fetch: { maxChars: 1_000, cacheTtlMinutes: 1 } } },
+    },
+    disablePluginTools: true,
+    disableMessageTool: true,
+    wrapBeforeToolCallHook: false,
+    ...options,
+  }).find((candidate) => candidate.name === "web_fetch");
+  if (!tool) {
+    throw new Error("Expected registered web_fetch tool");
+  }
+  return tool;
+}
+
+async function fetchSpill(tool: ReturnType<typeof createTool>, url: string) {
+  const result = await tool.execute("fetch-company-source", { url });
+  const details = result.details as { spill: { path: string }; cached?: true };
+  expect(details.spill?.path).toEqual(expect.any(String));
+  spillPaths.add(details.spill.path);
+  return details;
+}
+
+async function expectReadable(spillPath: string, root: string) {
+  const read = wrapToolWorkspaceRootGuardWithOptions(createReadTool(root), root);
+  const result = await read.execute("read-company-source", { path: spillPath });
+  const text = result.content
+    .filter((block) => block.type === "text")
+    .map((block) => block.text)
+    .join("\n");
+  expect(text).toContain("Company source material.");
+  expect(text).toContain("EXTERNAL_UNTRUSTED_CONTENT");
+  expect((await fs.stat(spillPath)).mode & 0o777).toBe(0o600);
+}
+
+describe("registered web_fetch workspace spill", () => {
+  beforeEach(() => {
+    guardedFetch.mockReset();
+    providerDefinition.mockReset();
+    providerDefinition.mockReturnValue(null);
+    guardedFetch.mockImplementation(async () => ({
+      response: new Response(body, { headers: { "content-type": "text/plain" } }),
+      finalUrl: "https://example.com/company-source",
+      release: async () => {},
+    }));
+  });
+
+  afterEach(async () => {
+    await Promise.all([...spillPaths].map((file) => fs.rm(file, { force: true })));
+    spillPaths.clear();
+  });
+
+  it.each(["workspace", "cwd", "session-root"])(
+    "makes full output readable inside the effective %s boundary",
+    async (kind) => {
+      const workspaceDir = tempDirs.make("openclaw-fetch-canonical-");
+      const taskRoot = tempDirs.make("openclaw-fetch-task-");
+      const readRoot = kind === "workspace" ? workspaceDir : taskRoot;
+      const tool = createTool({
+        workspaceDir,
+        ...(kind === "cwd" ? { cwd: taskRoot } : {}),
+        fsPolicy: { workspaceOnly: true, ...(kind === "session-root" ? { root: taskRoot } : {}) },
+      });
+      const details = await fetchSpill(tool, `https://example.com/workspace-spill-${kind}`);
+      await expectReadable(details.spill.path, readRoot);
+    },
+  );
+
+  it("keeps cached full-output handles in the requesting workspace", async () => {
+    const roots = [tempDirs.make("openclaw-fetch-a-"), tempDirs.make("openclaw-fetch-b-")];
+    for (const root of roots) {
+      const tool = createTool({ workspaceDir: root, fsPolicy: { workspaceOnly: true } });
+      const first = await fetchSpill(tool, "https://example.com/shared-spill-cache");
+      const cached = await fetchSpill(tool, "https://example.com/shared-spill-cache");
+      expect(first.cached).toBeUndefined();
+      expect(cached.cached).toBe(true);
+      expect(cached.spill.path).toBe(first.spill.path);
+      await expectReadable(cached.spill.path, root);
+    }
+    expect(guardedFetch).toHaveBeenCalledTimes(2);
+  });
+
+  it("keeps provider fallback output readable inside the same boundary", async () => {
+    const workspaceDir = tempDirs.make("openclaw-fetch-provider-");
+    guardedFetch.mockRejectedValue(new Error("direct route unavailable"));
+    providerDefinition.mockReturnValue({
+      provider: { id: "fixture" },
+      definition: { execute: async () => ({ text: body }) },
+    });
+    const details = await fetchSpill(
+      createTool({ workspaceDir, fsPolicy: { workspaceOnly: true } }),
+      "https://example.com/provider-spill-root",
+    );
+    await expectReadable(details.spill.path, workspaceDir);
+  });
+
+  it("does not spill through a workspace scratch symlink to another directory", async () => {
+    const workspaceDir = tempDirs.make("openclaw-fetch-symlink-");
+    const outside = tempDirs.make("openclaw-fetch-outside-");
+    await fs.mkdir(path.join(workspaceDir, ".openclaw"));
+    await fs.symlink(outside, path.join(workspaceDir, ".openclaw", "tmp"), "dir");
+    await expect(
+      fetchSpill(
+        createTool({ workspaceDir, fsPolicy: { workspaceOnly: true } }),
+        "https://example.com/escaping-spill-root",
+      ),
+    ).rejects.toThrow();
+    expect(await fs.readdir(outside)).toEqual([]);
+  });
+});

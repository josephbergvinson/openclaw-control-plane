@@ -0,0 +1,104 @@
+// Actual logical-run accounting must reopen only a later, genuinely new overflow sequence.
+import { afterEach, beforeAll, beforeEach, describe, expect, it } from "vitest";
+import type { createSubscribedSessionHarness as SubscriptionHarness } from "../embedded-agent-subscribe.e2e-harness.js";
+import type { AgentHarnessAttemptParams } from "../harness/types.js";
+import { makeAgentAssistantMessage } from "../test-helpers/agent-message-fixtures.js";
+import { makeZeroUsageSnapshot } from "../usage.js";
+import {
+  makeAttemptResult,
+  makeCompactionSuccess,
+  makeOverflowError,
+} from "./run.overflow-compaction.fixture.js";
+import {
+  mockedCompactDirect,
+  mockedRunEmbeddedAttempt,
+  resetSharedRunIntegrationHarnessMocks,
+} from "./run.overflow-compaction.harness.js";
+import {
+  createSharedRunIntegrationSession,
+  loadSharedRunIntegrationHarness,
+} from "./run.shared-integration-harness.test-support.js";
+import type { EmbeddedRunAttemptInternalParams } from "./run/internal-params.js";
+
+let runEmbeddedAgent: Awaited<ReturnType<typeof loadSharedRunIntegrationHarness>>;
+let createSubscribedSessionHarness: typeof SubscriptionHarness;
+type NativeAccountingAttempt = AgentHarnessAttemptParams &
+  Pick<EmbeddedRunAttemptInternalParams, "onContextAccountingEvent">;
+
+describe("runEmbeddedAgent consecutive overflow recovery", () => {
+  let session: Awaited<ReturnType<typeof createSharedRunIntegrationSession>>;
+  beforeAll(async () => {
+    runEmbeddedAgent = await loadSharedRunIntegrationHarness();
+    // Bind ingress to the same subscription graph as the runner after its one-time harness reset.
+    ({ createSubscribedSessionHarness } =
+      await import("../embedded-agent-subscribe.e2e-harness.js"));
+  });
+  beforeEach(async () => {
+    resetSharedRunIntegrationHarnessMocks();
+    session = await createSharedRunIntegrationSession();
+    mockedCompactDirect.mockResolvedValue(
+      makeCompactionSuccess({
+        summary: "compacted context",
+        tokensBefore: 190_000,
+        tokensAfter: 80_000,
+      }),
+    );
+  });
+  afterEach(async () => {
+    await session?.cleanup();
+  });
+
+  it.each(["stop", "toolUse", "error"] as const)(
+    "permits a later overflow only after accepted %s progress",
+    async (stopReason) => {
+      let attempts = 0;
+      mockedRunEmbeddedAttempt.mockImplementation(async (attempt: NativeAccountingAttempt) => {
+        attempts += 1;
+        if (attempts === 4) {
+          expect(mockedCompactDirect).toHaveBeenCalledTimes(3);
+          expect(attempt.onContextAccountingEvent).toBeTypeOf("function");
+          const assistant = makeAgentAssistantMessage({
+            stopReason,
+            content:
+              stopReason === "toolUse"
+                ? [{ type: "toolCall", id: "call-progress", name: "read", arguments: {} }]
+                : [{ type: "text", text: "The prior work succeeded." }],
+            usage: { ...makeZeroUsageSnapshot(), input: 130_119, totalTokens: 130_119 },
+          });
+          const harness = createSubscribedSessionHarness({
+            runId: attempt.runId,
+            sessionPersistence: "detached",
+            isTerminalAborted: () => attempt.abortSignal?.aborted,
+            onContextAccountingEvent: attempt.onContextAccountingEvent,
+          });
+          try {
+            harness.emit({ type: "message_start", message: assistant });
+            harness.emit({ type: "message_end", message: assistant });
+            await harness.subscription.waitForPendingEvents();
+          } finally {
+            harness.subscription.unsubscribe();
+          }
+        }
+        if (attempts <= 4) {
+          return makeAttemptResult({
+            assistantTexts: [],
+            terminal: { kind: "failed", source: "prompt", error: makeOverflowError() },
+          });
+        }
+        expect(attempts).toBe(5);
+        return makeAttemptResult({ assistantTexts: ["Finished after the later overflow."] });
+      });
+
+      const result = await runEmbeddedAgent(session.runParams);
+      if (stopReason === "error") {
+        expect(mockedRunEmbeddedAttempt).toHaveBeenCalledTimes(4);
+        expect(mockedCompactDirect).toHaveBeenCalledTimes(3);
+        expect(result.meta.error?.kind).toBe("context_overflow");
+      } else {
+        expect(mockedRunEmbeddedAttempt).toHaveBeenCalledTimes(5);
+        expect(mockedCompactDirect).toHaveBeenCalledTimes(4);
+        expect(result.meta.error).toBeUndefined();
+      }
+    },
+  );
+});

@@ -0,0 +1,27 @@
+import type { OpenClawConfig } from "../config/types.openclaw.js";
+import type { OpenClawToolsOptions } from "./openclaw-tools.types.js";
+import type { createSessionsSendTool } from "./tools/sessions-send-tool.js";
+
+/** Projects admitted run identity into the existing sessions_send factory. */
+export function resolveSessionsSendToolOptionsForRun(params: {
+  options?: OpenClawToolsOptions;
+  sessionAgentId: string;
+  trimmedRunSessionKey?: string;
+  sessionConfig?: OpenClawConfig;
+}): NonNullable<Parameters<typeof createSessionsSendTool>[0]> {
+  const { options, sessionAgentId, trimmedRunSessionKey, sessionConfig } = params;
+  return {
+    agentId: sessionAgentId,
+    // Match sessions_spawn: spawned children record the durable run
+    // session as spawnedBy, so the parent check must use the same key.
+    agentSessionKey: options?.runSessionKey ?? options?.agentSessionKey,
+    completionOwnerKey: trimmedRunSessionKey || options?.agentSessionKey,
+    requesterTurnRunId: options?.runId,
+    requesterSessionId: options?.sessionId,
+    messageActionTurnCapability:
+      options?.messageToolTurnCapability?.token ?? options?.messageActionTurnCapability,
+    agentChannel: options?.agentChannel,
+    sandboxed: options?.sandboxed,
+    config: sessionConfig,
+  };
+}

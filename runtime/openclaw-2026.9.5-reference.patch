+      const kill = vi
+        .spyOn(control, "killAllControlledSubagentRuns")
+        .mockImplementation(async (params) => {
+          expect(params.runs).toEqual([completed, pending]);
+          expect(params.suppressTaskDelivery).toBe(true);
+          params.assertCurrent?.();
+          pending.execution = {
+            status: "terminal",
+            startedAt: 2_000,
+            endedAt: 5_000,
+            outcome: { status: "error", error: "cancelled" },
+          };
+          pending.endedReason = SUBAGENT_ENDED_REASON_KILLED;
+          pending.killReconciliation = { killedAt: 5_000, suppressTaskDelivery: true };
+          tasks.set("pending", {
+            taskId: "task-pending",
+            runId: "pending",
+            status: "cancelled",
+            deliveryStatus: "not_applicable",
+          });
+          return { status: "ok", killed: 1, labels: [] };
+        });
+      try {
+        const batch = controller.claimCronRequesterYieldBatch({
+          requesterSessionKey: requester,
+          requesterAgentId: "main",
+          acceptedSessionSpawns: [completed, pending].map((entry) => ({
+            runId: entry.runId,
+            childSessionKey: entry.childSessionKey,
+            expectsCompletionMessage: true,

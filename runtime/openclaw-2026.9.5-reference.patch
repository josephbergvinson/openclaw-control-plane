@@ -0,0 +1,128 @@
+/** Publication phase of the existing embedded run waiter lifecycle. */
+import type { ReplyBackendHandle } from "../../auto-reply/reply/reply-run-registry.contracts.js";
+import {
+  replyRunRegistry,
+  type ReplyOperation,
+} from "../../auto-reply/reply/reply-run-registry.js";
+import { getAttachedBackend } from "../../auto-reply/reply/reply-run-registry.state.js";
+import {
+  getAgentEventLifecycleGeneration,
+  isAgentEventLifecycleGenerationCurrent,
+} from "../../infra/agent-events.js";
+import { createDeferredCore } from "../../shared/deferred.js";
+import { ACTIVE_EMBEDDED_RUNS, EMBEDDED_RUN_WAITERS, type EmbeddedRunWaiter } from "./run-state.js";
+import { resolveCurrentEmbeddedMessageInjectionTarget } from "./runs.message-injection.js";
+
+export function notifyEmbeddedRunPublished(sessionId: string): void {
+  const waiters = EMBEDDED_RUN_WAITERS.get(sessionId);
+  if (!waiters) {
+    return;
+  }
+  const handle = ACTIVE_EMBEDDED_RUNS.get(sessionId);
+  for (const waiter of waiters) {
+    const expected = waiter.publication;
+    if (!expected) {
+      continue;
+    }
+    // A predecessor may still be registered while this exact queued operation
+    // prepares its backend. Keep waiting for its own publication, not that peer.
+    if (
+      expected.replyOperation &&
+      isAgentEventLifecycleGenerationCurrent(expected.lifecycleGeneration) &&
+      replyRunRegistry.get(expected.sessionKey) === expected.replyOperation &&
+      !expected.replyOperation.result &&
+      getAttachedBackend(expected.replyOperation) !== handle
+    ) {
+      continue;
+    }
+    const target =
+      isAgentEventLifecycleGenerationCurrent(expected.lifecycleGeneration) &&
+      handle?.runId &&
+      (!expected.runId || handle.runId === expected.runId)
+        ? expected.replyOperation
+          ? replyRunRegistry.get(expected.sessionKey) === expected.replyOperation &&
+            getAttachedBackend(expected.replyOperation) === handle
+            ? replyRunRegistry.resolveCurrentMessageInjectionTarget(expected.sessionKey)
+            : undefined
+          : resolveCurrentEmbeddedMessageInjectionTarget({
+              sessionId,
+              sessionKey: expected.sessionKey,
+            })
+        : undefined;
+    waiters.delete(waiter);
+    const registered = Boolean(
+      target?.runId && (!expected.runId || target.runId === expected.runId),
+    );
+    if (registered && handle) {
+      waiter.handle = handle;
+    }
+    waiter.resolve(registered);
+  }
+  if (waiters.size === 0) {
+    EMBEDDED_RUN_WAITERS.delete(sessionId);
+  }
+}
+
+export async function waitForEmbeddedRunPublication(
+  params: {
+    sessionId: string;
+    sessionKey: string;
+    ownerReleased: Promise<void>;
+    abortSignal?: AbortSignal;
+  } & (
+    | { runId: string; replyOperation?: undefined }
+    | {
+        runId?: string;
+        replyOperation: ReplyOperation;
+        onRegistered?: (backend: ReplyBackendHandle) => void;
+      }
+  ),
+): Promise<"registered" | "released" | "invalidated"> {
+  params.abortSignal?.throwIfAborted();
+  const lifecycleGeneration = getAgentEventLifecycleGeneration();
+  const publication = createDeferredCore<boolean>();
+  const waiter: EmbeddedRunWaiter = {
+    publication: {
+      sessionKey: params.sessionKey,
+      runId: params.runId,
+      lifecycleGeneration,
+      ...(params.replyOperation ? { replyOperation: params.replyOperation } : {}),
+    },
+    resolve: (registered) => publication.resolve(registered),
+  };
+  const waiters = EMBEDDED_RUN_WAITERS.get(params.sessionId) ?? new Set<EmbeddedRunWaiter>();
+  waiters.add(waiter);
+  EMBEDDED_RUN_WAITERS.set(params.sessionId, waiters);
+  const onAbort = () => publication.resolve(false);
+  params.abortSignal?.addEventListener("abort", onAbort, { once: true });
+  try {
+    // Subscribe before the synchronous recheck so publication cannot be lost.
+    if (ACTIVE_EMBEDDED_RUNS.has(params.sessionId)) {
+      notifyEmbeddedRunPublished(params.sessionId);
+    }
+    const result = await Promise.race([
+      publication.promise.then((registered) =>
+        registered ? ("registered" as const) : ("invalidated" as const),
+      ),
+      params.ownerReleased.then(() => "released" as const),
+    ]);
+    params.abortSignal?.throwIfAborted();
+    if (!isAgentEventLifecycleGenerationCurrent(lifecycleGeneration)) {
+      return "invalidated";
+    }
+    if (result === "registered" && params.replyOperation) {
+      const backend = getAttachedBackend(params.replyOperation);
+      if (!backend || backend !== waiter.handle) {
+        return "invalidated";
+      }
+      params.onRegistered?.(backend);
+    }
+    return result;
+  } finally {
+    params.abortSignal?.removeEventListener("abort", onAbort);
+    waiters.delete(waiter);
+    if (EMBEDDED_RUN_WAITERS.get(params.sessionId) === waiters && waiters.size === 0) {
+      EMBEDDED_RUN_WAITERS.delete(params.sessionId);
+    }
+  }
+}

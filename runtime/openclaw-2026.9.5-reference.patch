diff --git a/extensions/discord/src/continuation-progress.test.ts b/extensions/discord/src/continuation-progress.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..386969931a081916cb1f74d1c65083249266f276
--- /dev/null
+++ b/extensions/discord/src/continuation-progress.test.ts
@@ -0,0 +1,108 @@
+import type { DiscordConfig } from "openclaw/plugin-sdk/config-contracts";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { RequestClient } from "./internal/discord.js";
+const client = vi.hoisted(() => ({ create: vi.fn() }));
+vi.mock("./client.js", () => ({ createDiscordRestClient: client.create }));
+import { createDiscordContinuationProgress } from "./continuation-progress.js";
+
+function setup() {
+  const writes: Array<{ method: string; text: string; at: number }> = [];
+  let current = true;
+  const rest = new RequestClient("test-token", {
+    queueRequests: false,
+    fetch: async (_input, init) => {
+      if (init?.method === "DELETE") {
+        return new Response(null, { status: 204 });
+      }
+      const bodyText = init?.body;
+      if (typeof bodyText !== "string") {
+        throw new Error("Expected serialized Discord request body");
+      }
+      const body = JSON.parse(bodyText) as { content: string };
+      writes.push({ method: init!.method!, text: body.content, at: Date.now() });
+      return Response.json({ id: "123456789012345678" });
+    },
+  });
+  const config: DiscordConfig = {
+    streaming: {
+      mode: "progress",
+      progress: {
+        label: false,
+        maxLines: 3,
+        maxLineChars: 560,
+        toolProgress: false,
+        commandText: "status",
+        commentary: true,
+        narration: true,
+      },
+    },
+  };
+  client.create.mockReturnValue({ rest, account: { accountId: "default", config } });
+  return {
+    writes,
+    invalidate: () => {
+      current = false;
+    },
+    params: {
+      cfg: { channels: { discord: config } },
+      to: "channel:123",
+      signal: new AbortController().signal,
+      assertCurrent: () => {
+        if (!current) {
+          throw new Error("stale requester");
+        }
+      },
+    },
+  };
+}
+
+describe("Discord requester continuation progress", () => {
+  beforeEach(() => {
+    vi.useFakeTimers();
+    vi.setSystemTime(100_000);
+    vi.clearAllMocks();
+  });
+  afterEach(() => {
+    vi.useRealTimers();
+  });
+
+  it("coalesces narration into one ordinary progress card and seals without a duplicate final", async () => {
+    const h = setup();
+    const p = (await createDiscordContinuationProgress(h.params))!;
+    await p.replyOptions.onItemEvent?.({
+      kind: "preamble",
+      phase: "end",
+      progressText: "Checking the calendar invitation.",
+    });
+    await p.replyOptions.onToolStart?.({ phase: "start", name: "read", toolCallId: "calendar" });
+    await vi.advanceTimersByTimeAsync(2_000);
+    expect(p.replyOptions.isProgressDraftVisible?.()).toBe(true);
+    // Existing narrator policy makes utility updates, which must edit this card.
+    for (const text of [
+      "Checking the confirmed time.",
+      "Reading the meeting details.",
+      "Verifying the calendar entry.",
+    ]) {
+      await vi.advanceTimersByTimeAsync(21_000);
+      await p.replyOptions.onNarrationUpdate?.({ text });
+      await vi.advanceTimersByTimeAsync(2_000);
+    }
+    await p.finish();
+    await p.cleanup();
+    expect(h.writes.filter((w) => w.method === "POST")).toHaveLength(1);
+    expect(h.writes.filter((w) => w.method === "PATCH").length).toBeGreaterThan(0);
+    expect(h.writes.at(-1)?.text).toContain("Verifying the calendar entry.");
+    expect(h.writes.some((w) => /complete|finished|final|PRIVATE/u.test(w.text))).toBe(false);
+  });
+
+  it("checks requester authority again before a delayed coalesced provider write", async () => {
+    const h = setup();
+    const p = (await createDiscordContinuationProgress(h.params))!;
+    await p.replyOptions.onToolStart?.({ phase: "start", name: "read", toolCallId: "calendar" });
+    await p.replyOptions.onNarrationUpdate?.({ text: "Must not appear after replacement." });
+    h.invalidate();
+    await vi.advanceTimersByTimeAsync(10_000);
+    expect(h.writes).toEqual([]);
+    await p.cleanup();
+  });
+});
diff --git a/extensions/discord/src/continuation-progress.ts b/extensions/discord/src/continuation-progress.ts
new file mode 100644
index 0000000000000000000000000000000000000000..32c05196c402aefd0d2c1f23c4688deea1e89db0
--- /dev/null
+++ b/extensions/discord/src/continuation-progress.ts
@@ -0,0 +1,82 @@
+import { resolveMarkdownTableMode } from "openclaw/plugin-sdk/markdown-table-runtime";
+import { resolveChunkMode, resolveTextChunkLimit } from "openclaw/plugin-sdk/reply-chunking";
+import { resolveDiscordMaxLinesPerMessage } from "./accounts.js";
+import type { ChannelPlugin } from "./channel-api.js";
+import { createDiscordRestClient } from "./client.js";
+import { createDiscordDraftPreviewController } from "./monitor/message-handler.draft-preview.js";
+import { resolveDiscordPreviewStreamMode } from "./preview-streaming.js";
+import { parseDiscordTarget } from "./targets.js";
+
+type CreateProgress = NonNullable<
+  NonNullable<ChannelPlugin["streaming"]>["createContinuationProgress"]
+>;
+
+/** Source progress uses the ordinary Discord card, never the private completion payload. */
+export const createDiscordContinuationProgress: CreateProgress = async (params) => {
+  const target = parseDiscordTarget(params.to, { defaultKind: "channel" });
+  // A user target needs the ordinary DM resolution owner; retain that fallback.
+  if (target?.kind !== "channel") {
+    return undefined;
+  }
+  params.assertCurrent();
+  const { rest, account } = createDiscordRestClient(params);
+  if (resolveDiscordPreviewStreamMode(account.config) !== "progress") {
+    return undefined;
+  }
+  const draft = createDiscordDraftPreviewController({
+    cfg: params.cfg,
+    discordConfig: account.config,
+    accountId: account.accountId,
+    sourceRepliesAreToolOnly: false,
+    textLimit: resolveTextChunkLimit(params.cfg, "discord", account.accountId),
+    deliveryRest: rest,
+    deliverChannelId: params.threadId != null ? String(params.threadId) : target.id,
+    replyReference: { peek: () => undefined },
+    tableMode: resolveMarkdownTableMode({
+      cfg: params.cfg,
+      channel: "discord",
+      accountId: account.accountId,
+    }),
+    maxLinesPerMessage: resolveDiscordMaxLinesPerMessage({
+      cfg: params.cfg,
+      discordConfig: account.config,
+      accountId: account.accountId,
+    }),
+    chunkMode: resolveChunkMode(params.cfg, "discord", account.accountId),
+    assertCurrent: params.assertCurrent,
+    // Caller owns error reporting; never publish diagnostics into the progress card.
+    log: () => undefined,
+  });
+  if (!draft.draftStream) {
+    return undefined;
+  }
+  return {
+    replyOptions: {
+      onToolStart: (payload) => draft.pushToolEvent(payload),
+      onItemEvent: (payload) =>
+        payload.kind === "preamble"
+          ? draft.pushPreambleItemEvent(payload)
+          : draft.pushItemEvent(payload),
+      onCommandOutput: (payload) => draft.pushCommandOutputEvent(payload),
+      onNarrationUpdate: draft.narrationProgressEnabled
+        ? async ({ text }) => {
+            params.assertCurrent();
+            await draft.pushNarrationProgress(text);
+          }
+        : undefined,
+      onProgressNarratorLifecycle: (lifecycle) => draft.setProgressNarratorLifecycle(lifecycle),
+      isProgressDraftVisible: () => draft.isProgressDraftVisible,
+      narrationHideCommandText: draft.narrationHideCommandText,
+    },
+    async finish() {
+      // Seal the last factual update; the command's separate final owner remains authoritative.
+      draft.markFinalReplyStarted();
+      params.assertCurrent();
+      await draft.finalizeProgressDraft();
+    },
+    async cleanup() {
+      draft.markFinalReplyStarted();
+      await draft.cleanup();
+    },
+  };
+};

+import type { AnyAgentTool } from "./common.js";
+import { createGetGoalTool, createCreateGoalTool, createUpdateGoalTool } from "./goal-tools.js";
+
+/** Assemble goal tools under one identical run/session scope. */
+export function createGoalTools(options: Parameters<typeof createGetGoalTool>[0]): AnyAgentTool[] {
+  return [createGetGoalTool(options), createCreateGoalTool(options), createUpdateGoalTool(options)];
+}

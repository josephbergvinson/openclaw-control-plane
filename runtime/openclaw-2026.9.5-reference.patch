--- /dev/null
+++ b/src/auto-reply/reply/session-context.ts
@@ -0,0 +1,24 @@
+import { copyChannelParticipantAdmissionEvidence } from "../../channels/message-access/admission-evidence.js";
+import type { FinalizedRuntimeMsgContext, FinalizedTemplateContext } from "../templating.js";
+import { normalizeInboundTextNewlines } from "./inbound-text.js";
+
+export function createReplySessionContext(params: {
+  originalCtx: FinalizedRuntimeMsgContext;
+  stateCtx: FinalizedRuntimeMsgContext;
+  bodyStripped?: string;
+  sessionId: string;
+  isFirstSessionTurn: boolean;
+}): FinalizedTemplateContext {
+  const { originalCtx, stateCtx, bodyStripped, sessionId, isFirstSessionTurn } = params;
+  const sessionCtx: FinalizedTemplateContext = {
+    ...stateCtx,
+    agentText: normalizeInboundTextNewlines(bodyStripped ?? stateCtx.agentText),
+    BodyStripped: normalizeInboundTextNewlines(bodyStripped ?? stateCtx.agentText),
+    SessionId: sessionId,
+    IsNewSession: isFirstSessionTurn ? "true" : "false",
+  };
+  // Queued turns consume this clone without the immediate dispatch operation.
+  // Check the original ingress scope so a retargeted state cannot carry authority.
+  copyChannelParticipantAdmissionEvidence(originalCtx, sessionCtx);
+  return sessionCtx;
+}

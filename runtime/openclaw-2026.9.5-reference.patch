+import { expectDefined } from "@openclaw/normalization-core";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { withTestTimeout } from "../../../test/helpers/promise.js";
+import type { EmbeddedAgentQueueHandle } from "../../agents/embedded-agent-runner/runs.js";
+import { testing as embeddedTesting } from "../../agents/embedded-agent-runner/runs.test-support.js";
+import { MAIN_SESSION_RECOVERY_WORK_ADMISSION_OWNER } from "../../agents/main-session-recovery/main-session-recovery-admission.js";
+import { replaceSessionEntrySync } from "../../config/sessions/session-accessor.js";
+import { resetDiagnosticRunActivityForTest } from "../../logging/diagnostic-run-activity.js";
+import {
+  beginSessionWorkAdmission,
+  getSessionWorkAdmissionOwnerRelease,
+} from "../../sessions/session-lifecycle-admission.js";
+import { createDeferredCore } from "../../shared/deferred.js";
+import { createOpenClawTestState } from "../../test-utils/openclaw-test-state.js";
+import {
+  prepareRecoveryAdmission,
+  withRecoveredOwner,
+} from "./agent-runner-steer-adoption.recovery.test-support.js";
+import { createDispatchReplyOperationCoordinator } from "./dispatch-from-config.lifecycle.js";
+import { executePreparedReplyRun } from "./get-reply-run-execute.js";
+import { finalizeInboundContext } from "./inbound-context.js";
+import type { FollowupRun } from "./queue.js";
+import { createQueueTestRun } from "./queue.test-helpers.js";
+import { getExistingFollowupQueue } from "./queue/state.js";
+import { createReplyDispatcher } from "./reply-dispatcher.js";
+import { replyRunRegistry } from "./reply-run-registry.js";
+import { createTestReplyOperation } from "./reply-run-registry.test-fixtures.js";
+import { testing as replyTesting } from "./reply-run-registry.test-support.js";
+import { resolveFollowupRunToolAuthorityFingerprint } from "./reply-tool-authority.js";
+
+describe("visible ingress under generic recovery admission", () => {
+  afterEach(() => {
+    embeddedTesting.resetActiveEmbeddedRuns();
+    replyTesting.resetReplyRunRegistry();
+    resetDiagnosticRunActivityForTest();
+    vi.useRealTimers();
+    vi.restoreAllMocks();
+  });
+
+  it.each([
+    "same-owner",
+    "provider",
+    "model",
+    "account",
+    "config",
+    "auth-pin",
+    "caller-policy",
+    "requester",
+    "missing-requester",
+  ] as const)(
+    "admits owner ingress through the generic recovery ceiling or preserves %s fallback",
+    async (condition) => {
+      const key = "agent:main:discord:channel:recovery-held-lease";
+      const state = await createOpenClawTestState({ label: "recovery-steering-admission" });
+      const storePath = state.statePath("agents", "main", "sessions", "sessions.json");
+      const recoveryAdmission = await beginSessionWorkAdmission({
+        scope: storePath,
+        identities: [key, "sess"],
+        owner: MAIN_SESSION_RECOVERY_WORK_ADMISSION_OWNER,
+        assertAllowed: () => {},
+      });
+      const assertRecoveryOwned = () => {
+        expect(
+          getSessionWorkAdmissionOwnerRelease({
+            scope: storePath,
+            identities: [key, "sess"],
+            owner: MAIN_SESSION_RECOVERY_WORK_ADMISSION_OWNER,
+          }),
+        ).toBeDefined();
+      };
+      try {
+        const seed = createQueueTestRun({
+          prompt: "Use the named asset icons",
+          messageId: "asset-icons-followup",
+        });
+        seed.run.agentId = "main";
+        seed.run.sessionKey = key;
+        seed.run.sessionFile = key;
+        seed.run.agentDir = state.agentDir("main");
+        seed.run.workspaceDir = state.workspaceDir;
+        seed.run.config = { plugins: { enabled: false } };
+        seed.run.senderIsOwner = true;
+        seed.run.senderId = "joseph";
+        seed.run.agentAccountId = "default";
+        const seedAdmission = await prepareRecoveryAdmission(key, seed, storePath);
+        if (seedAdmission.kind !== "ready") {
+          throw new Error("recovery fixture producer did not prepare the turn");
+        }
+        let produced: FollowupRun | undefined;
+        // Derive the recovered attempt's authority facts from the production
+        // producer. Only this fixture setup stops before actual execution.
+        await executePreparedReplyRun({
+          ...seedAdmission,
+          runReplyAgent: async (params) => {
+            produced = params.followupRun;
+            return undefined;
+          },
+        });
+        const producedRun = expectDefined(produced, "production recovery authority fixture");
+        await withRecoveredOwner(
+          key,
+          async ({ run, handle, fingerprint }) => {
+            const entry = { sessionId: run.run.sessionId, updatedAt: Date.now() };
+            replaceSessionEntrySync({ storePath, sessionKey: key }, entry);
+            const committed = createDeferredCore();
+            const entered = createDeferredCore();
+            const adopted = vi.fn(async () => {
+              assertRecoveryOwned();
+            });
+            const incomingAbort = new AbortController();
+            run.turnAdoptionLifecycle = { onAdopted: adopted, abortSignal: incomingAbort.signal };
+            const dispatcher = createReplyDispatcher({ deliver: async () => undefined });
+            const coordinator = createDispatchReplyOperationCoordinator({
+              agentId: "main",
+              cfg: run.run.config,
+              ctx: finalizeInboundContext({
+                SessionKey: key,
+                Body: run.prompt,
+                Provider: "discord",
+                ChatType: "group",
+              }),
+              dispatcher,
+              dispatchOperationSessionKey: key,
+              operationSessionStoreEntry: { entry, storePath },
+              replyOptions: {
+                turnAdoptionLifecycle: run.turnAdoptionLifecycle,
+                abortSignal: incomingAbort.signal,
+              },
+              resolveOperationExpectedSessionId: () => entry.sessionId,
+            });
+            try {
+              // This is the visible ingress coordinator's real reservation path.
+              // A competing queued reply operation would hide the generic owner.
+              expect(await coordinator.ensureDispatchReplyOperation("pre_dispatch")).toEqual({
+                status: "ready",
+              });
+              expect(await coordinator.ensureDispatchReplyOperation("dispatch")).toEqual({
+                status: "ready",
+              });
+              expect(coordinator.getReplyOptions()?.replyOperation).toBeUndefined();
+              expect(replyRunRegistry.get(key)).toBeUndefined();
+              const incoming = { ...run, run: { ...run.run } };
+              if (condition === "account") {
+                incoming.run.agentAccountId = "other-account";
+              }
+              if (condition === "caller-policy") {
+                incoming.run.senderIsOwner = false;
+              }
+              if (condition === "requester") {
+                incoming.run.senderId = "different-person";
+              }
+              if (condition !== "caller-policy") {
+                incoming.run.senderIsOwner = true;
+              }
+              if (condition === "missing-requester") {
+                incoming.run.senderId = "joseph";
+              }
+              const admission = await prepareRecoveryAdmission(
+                key,
+                incoming,
+                storePath,
+                coordinator.getReplyOptions(),
+                {
+                  ...(condition === "provider" ? { provider: "other-provider" } : {}),
+                  ...(condition === "model" ? { model: "other-model" } : {}),
+                  ...(condition === "config"
+                    ? { cfg: { ...run.run.config, logging: { level: "debug" } } }
+                    : {}),
+                },
+              );
+              expect(admission.kind).toBe("ready");
+              if (admission.kind !== "ready") {
+                throw new Error("recovery input admission did not prepare the turn");
+              }
+              expect(admission.resolveActiveEmbeddedSessionId()).toBe(run.run.sessionId);
+              expect(admission.isActive).toBe(true);
+              expect(admission.shouldSteer).toBe(true);
+              expect(admission.shouldFollowup).toBe(true);
+              assertRecoveryOwned();
+              const queued = vi.fn<
+                NonNullable<EmbeddedAgentQueueHandle["messageInjectionV2"]>["queueMessage"]
+              >(async (text, options, assertCurrent) => {
+                expect(text).toBe(run.prompt);
+                expect(options?.waitForTranscriptCommit).toBe(true);
+                assertCurrent();
+                options?.onQueueAccepted?.(true);
+                entered.resolve();
+                await committed.promise;
+                assertRecoveryOwned();
+                assertCurrent();
+              });
+              expectDefined(handle.messageInjectionV2, "recovered guarded sink").queueMessage =
+                queued;
+              const actualRunReplyAgent = admission.runReplyAgent;
+              let producedInput: FollowupRun | undefined;
+              const task = executePreparedReplyRun({
+                ...admission,
+                ...(condition === "auth-pin"
+                  ? { authProfileId: "other-person", authProfileIdSource: "user" as const }
+                  : {}),
+                runReplyAgent: async (params) => {
+                  producedInput = params.followupRun;
+                  expect(resolveFollowupRunToolAuthorityFingerprint(params.followupRun)).not.toBe(
+                    fingerprint,
+                  );
+                  return await actualRunReplyAgent(params);
+                },
+              });
+              try {
+                if (condition !== "same-owner") {
+                  await expect(task).resolves.toBeUndefined();
+                  expect(queued).not.toHaveBeenCalled();
+                  expect(adopted).not.toHaveBeenCalled();
+                  assertRecoveryOwned();
+                  return;
+                }
+                await withTestTimeout(
+                  Promise.race([
+                    entered.promise,
+                    task.then(() => {
+                      throw new Error("recovery input completed without steering");
+                    }),
+                  ]),
+                  1_000,
+                  "held recovery owner did not accept ingress",
+                );
+                expect(adopted).not.toHaveBeenCalled();
+                const retained = expectDefined(producedInput, "retained original input");
+                expect(retained.messageId).toBe(run.messageId);
+                expect(getExistingFollowupQueue(key)?.items).toContain(retained);
+                assertRecoveryOwned();
+                committed.resolve();
+                await expect(task).resolves.toBeUndefined();
+                expect(adopted).toHaveBeenCalledOnce();
+                expect(getExistingFollowupQueue(key)?.items ?? []).toEqual([]);
+                assertRecoveryOwned();
+              } finally {
+                committed.resolve();
+              }
+            } finally {
+              incomingAbort.abort();
+              coordinator.completeDispatchReplyOperation();
+              dispatcher.markComplete();
+              await dispatcher.waitForIdle();
+            }
+          },
+          (run) => {
+            Object.assign(run.run, producedRun.run);
+            delete run.run.bashElevated;
+            delete run.run.elevatedLevel;
+            run.run.traceAuthorized = false;
+            // Ordinary restart uses WRITE_SCOPE; the requester identity is
+            // restored from restartRecoveryChannelContext, independently of role.
+            run.run.senderIsOwner = condition === "caller-policy";
+            run.run.senderId = condition === "missing-requester" ? undefined : "joseph";
+            run.run.inputProvenance = {
+              kind: "internal_system",
+              sourceTool: "gateway-main-session-restart-recovery",
+              sourceSessionKey: key,
+            };
+            run.originatingChannel = producedRun.originatingChannel;
+            run.originatingAccountId = producedRun.originatingAccountId;
+            run.originatingTo = producedRun.originatingTo;
+          },
+        );
+      } finally {
+        recoveryAdmission.release();
+        await state.cleanup();
+      }
+    },
+  );
+
+  it.each(["unpublished", "revoked", "wrong-key", "reply-reservation"] as const)(
+    "keeps recovery execution exclusive when its steering target is %s",
+    async (condition) => {
+      const key = `agent:main:recovery-admission-${condition}`;
+      const state = await createOpenClawTestState({ label: "recovery-steering-exclusive" });
+      const storePath = state.statePath("agents", "main", "sessions", "sessions.json");
+      const lease = await beginSessionWorkAdmission({
+        scope: storePath,
+        identities: [key, "sess"],
+        owner: MAIN_SESSION_RECOVERY_WORK_ADMISSION_OWNER,
+        assertAllowed: () => {},
+      });
+      try {
+        await withRecoveredOwner(
+          key,
+          async ({ run, revoke }) => {
+            if (condition === "unpublished") {
+              embeddedTesting.resetActiveEmbeddedRuns();
+            }
+            if (condition === "revoked") {
+              revoke();
+            }
+            if (condition === "reply-reservation") {
+              createTestReplyOperation({ sessionKey: key, sessionId: run.run.sessionId });
+            }
+            const admission = await prepareRecoveryAdmission(
+              condition === "wrong-key" ? `${key}:other` : key,
+              run,
+              storePath,
+            );
+            expect(admission.kind).toBe("ready");
+            if (admission.kind !== "ready") {
+              throw new Error("recovery input admission did not prepare the turn");
+            }
+            expect(admission.isActive).toBe(true);
+            expect(admission.shouldSteer).toBe(false);
+            expect(admission.shouldFollowup).toBe(true);
+          },
+          (run) => {
+            run.run.sessionFile = key;
+            run.run.agentDir = state.agentDir("main");
+            run.run.workspaceDir = state.workspaceDir;
+            run.run.config = { plugins: { enabled: false } };
+          },
+        );
+      } finally {
+        lease.release();
+        await state.cleanup();
+      }
+    },
+  );
+});

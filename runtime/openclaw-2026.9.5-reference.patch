+MLX_TTS_HELPER_PRODUCT=openclaw-mlx-tts
+PEEKABOO_LOCKED_SOURCE_COMMIT=${"b".repeat(40)}
+SKIP_MLX_TTS=1
+source "$PIN_OWNER"
+PEEKABOO_SNAPSHOT_MOUNT="$ROOT_DIR/snapshot"
+# Authentication/mount and resource packaging are covered by their existing
+# separate cases; this fixture executes the real dependency/build ordering.
+create_verified_peekaboo_snapshot() { mkdir "$PEEKABOO_SNAPSHOT_MOUNT"; }
+compiled_peekaboo_commit() { printf '%s' "$2"; }
+patch_swiftpm_resource_lookups() { :; }
+restore_swiftpm_resource_sources() { :; }
+build_swift_architecture arm64
+`,
+        ],
+        {
+          encoding: "utf8",
+          timeout: 20_000,
+          env: {
+            ...process.env,
+            PATH: `${bin}:${process.env.PATH}`,
+            PIN_NODE: process.execPath,
+            PIN_DRIVER: driver,
+            PIN_OWNER: path.resolve(swiftScriptPath),
+            PIN_ROOT: root,
+            PIN_EVENTS: eventsPath,
+            PIN_MODE: mode,
+          },
+        },
+      );
+      expect(result.status, result.stderr).toBe(mode === "cached-unedit-drift" ? 0 : 1);
+      expect(readFileSync(path.join(app, "Package.resolved"), "utf8")).toBe(committed);
+      const events = readFileSync(eventsPath, "utf8")
+        .trim()
+        .split("\n")
+        .map((line) => JSON.parse(line) as SwiftEvent);
+      const firstEvent = events[0];
+      assert.isDefined(
+        firstEvent,
+        "Expected the native Swift owner to record its initial operation",
+      );
+      expect(firstEvent.operation).toBe("unedit");
+      const initialResolve = events.find((event) => event.operation === "resolve");
+      expect(initialResolve?.pins["swift-cmark"]).toEqual({
+        revision: "a".repeat(40),
+        version: "0.8.0",
+      });
+      const builds = events.filter((event) => event.operation === "build");
+      expect(builds).toHaveLength(
+        mode === "cached-unedit-drift" ? 2 : mode === "compile-drift" ? 1 : 0,
+      );
+      for (const event of events.filter((candidate) => candidate.operation !== "unedit")) {
+        expect(event.args).toContain("--force-resolved-versions");
+      }
+      for (const event of builds) {
+        expect(event.pins).toEqual({
+          "swift-cmark": { revision: "a".repeat(40), version: "0.8.0" },
+        });
+      }
+    },
+  );
+}

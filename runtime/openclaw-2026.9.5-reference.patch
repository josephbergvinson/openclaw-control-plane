+    const oldSource = createQueueTestRun({ prompt: "old", messageId: "A" });
+    const newSource = createQueueTestRun({ prompt: "new", messageId: "B" });
+    const original = vi.fn(async () => undefined);
+    const replacement = vi.fn(async () => undefined);
+    enqueueFollowupRun(key, oldSource, { mode: "steer", debounceMs: 0 }, "none", original, false);
+    kickFollowupDrainIfIdle(key);
+    clearFollowupQueue(key);
+    enqueueFollowupRun(
+      key,
+      newSource,
+      { mode: "steer", debounceMs: 0 },

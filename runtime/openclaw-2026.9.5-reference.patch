+import { beforeEach, describe, expect, it, vi } from "vitest";
+import type { SessionEntry } from "../../config/sessions.js";
+import { reactivateCompletedSubagentSession } from "../../gateway/session-subagent-reactivation.js";
+import {
+  consumeSubagentCompletionToolHandoff,
+  registerSubagentCompletionToolHandoff,
+} from "../../gateway/subagent-completion-tool-handoff.js";
+import {
+  resetAgentEventsForTest,
+  rotateAgentEventLifecycleGeneration,
+} from "../../infra/agent-events.js";
+import { isRecordWithoutThrowing } from "../../shared/safe-record.js";
+import { createSubagentRunRecord } from "../subagent-test-fixtures.test-helpers.js";
+import type { SubagentRunRecord } from "../subagents/registry/subagent-registry.types.js";
+import type { AgentToolGatewayRequestCaller } from "./in-process-gateway.js";
+import { captureOwnedChildReplyHandoff } from "./sessions-send-owned-child.js";
+import { runSessionsSendA2AFlow } from "./sessions-send-tool.a2a.js";
+
+const state = vi.hoisted(() => ({
+  source: undefined as SubagentRunRecord | undefined,
+  sessions: new Map<string, SessionEntry>(),
+  reactivate: vi.fn(),
+}));
+vi.mock("../subagents/registry/subagent-registry-read.js", () => ({
+  getLatestSubagentRunByChildSessionKey: () => state.source,
+  getLatestLiveSubagentRunByChildSessionKey: () => undefined,
+}));
+vi.mock("../subagents/registry/subagent-session-reconciliation.js", () => ({
+  loadSubagentSessionEntry: ({ childSessionKey }: { childSessionKey: string }) =>
+    state.sessions.get(childSessionKey),
+}));
+vi.mock("../subagents/registry/subagent-registry-runtime.js", () => ({
+  replaceSubagentRunAfterSteer: state.reactivate,
+}));
+vi.mock("../../sessions/session-participant-recording.js", () => ({
+  recordSessionParticipantBestEffort: () => {},
+}));
+
+const scope = {
+  requesterSenderId: "owner-A",
+  agentAccountId: "company-A",
+  messageChannel: "discord",
+};
+const childKey = "agent:main:subagent:child-A";
+const parentKey = "agent:main:discord:channel:company";
+function createOwner() {
+  state.source = createSubagentRunRecord({
+    runId: "original-child-run",
+    generation: 1,
+    createdAt: 100,
+    childSessionKey: childKey,
+    requesterSessionKey: parentKey,
+    requesterAgentId: "main",
+    controllerSessionKey: parentKey,
+    completionRequesterSessionId: "parent-A",
+    requesterMcpScope: { ...scope },
+    expectsCompletionMessage: true,
+    completionTarget: "parent",
+  });
+  state.sessions.set(childKey, {
+    sessionId: "child-A",
+    lifecycleRevision: "revision-A",
+    updatedAt: 100,
+    spawnedBy: parentKey,
+    completionOwnerSessionKey: parentKey,
+    spawnDepth: 1,
+    inheritedToolPolicyVersion: 1,
+    inheritedToolAllow: ["read"],
+    inheritedToolDeny: ["exec"],
+  });
+  // Ordinary primary sessions need not have a lifecycle revision; their SID is exact.
+  state.sessions.set(parentKey, { sessionId: "parent-A", updatedAt: 100 });
+  return state.source;
+}
+function capture() {
+  return captureOwnedChildReplyHandoff({
+    childSessionKey: childKey,
+    requesterSessionKey: parentKey,
+    requesterAgentId: "main",
+    acceptedFollowupRunId: "followup-child-run",
+  });
+}
+function flow(
+  callGateway: AgentToolGatewayRequestCaller,
+  replyMode: "peer" | "one-way" = "one-way",
+) {
+  return runSessionsSendA2AFlow({
+    callGateway,
+    targetSessionKey: childKey,
+    targetAgentId: "main",
+    displayKey: childKey,
+    message: "Complete the next bounded lookup",
+    announceTimeoutMs: 10_000,
+    maxPingPongTurns: 0,
+    replyMode,
+    requesterSessionKey: parentKey,
+    requesterAgentId: "main",
+    requesterChannel: "discord",
+    waitRunId: "followup-child-run",
+    notifyRequesterOnWaitFailure: true,
+  });
+}
+
+describe("one-way sessions_send credential continuity", () => {
+  beforeEach(() => {
+    resetAgentEventsForTest();
+    state.sessions.clear();
+    createOwner();
+    state.reactivate.mockReset();
+  });
+
+  it.each([false, true])(
+    "projects the real %s failure/success return through exact private consumption",
+    async (failed) => {
+      const agentRequests: Parameters<AgentToolGatewayRequestCaller>[0][] = [];
+      const consumed: { value: ReturnType<typeof consumeSubagentCompletionToolHandoff> } = {
+        value: undefined,
+      };
+      const callGateway: AgentToolGatewayRequestCaller = async <T>(
+        request: Parameters<AgentToolGatewayRequestCaller>[0],
+      ) => {
+        if (request.method === "agent.wait") {
+          return (
+            failed &&
+            isRecordWithoutThrowing(request.params) &&
+            request.params.runId === "followup-child-run"
+              ? { status: "error", error: "target run failed" }
+              : {
+                  status: "ok",
+                  terminalReply: { disposition: "visible", text: "Actual child result" },
+                }
+          ) as T;
+        }
+        if (request.method === "agent") {
+          agentRequests.push(request);
+          const registration = request.delegatedToolPolicyHandoff;
+          expect(registration?.mcpRequesterScope).toEqual(scope);
+          expect(registration?.sourceRole).toBe("subagent");
+          expect(registration?.sourceSessionId).toBe("child-A");
+          const provenance = isRecordWithoutThrowing(request.params)
+            ? request.params.inputProvenance
+            : undefined;
+          expect(provenance).toMatchObject({
+            sourceTool: "subagent_announce",
+            sourceRole: "subagent",
+            originSessionId: "child-A",
+          });
+          expect(request.params).not.toHaveProperty("mcpRequesterScope");
+          expect(request.params).not.toHaveProperty("senderId");
+          expect(request.params).not.toHaveProperty("senderIsOwner");
+          if (!registration) {
+            throw new Error("Missing native handoff");
+          }
+          const handoffId = registerSubagentCompletionToolHandoff(registration);
+          consumed.value = consumeSubagentCompletionToolHandoff({
+            ...registration,
+            handoffId,
+            sourceTool: "subagent_announce",
+            provider: "openai",
+            model: "gpt-6.1-sol",
+          });
+          expect(consumed.value?.mcpRequesterScope).toEqual(scope);
+          expect(
+            consumeSubagentCompletionToolHandoff({
+              ...registration,
+              handoffId,
+              sourceTool: "subagent_announce",
+              provider: "openai",
+              model: "gpt-6.1-sol",
+            }),
+          ).toBeUndefined();
+          return { runId: "return-parent-run" } as T;
+        }
+        return {} as T;
+      };
+      await flow(callGateway);
+      expect(agentRequests).toHaveLength(1);
+      expect(consumed.value?.targetSessionId).toBe("parent-A");
+    },
+  );
+
+  it("retains a completed child's exact accepted followup through real reactivation", async () => {
+    const previous = state.source!;
+    previous.execution = { status: "terminal", endedAt: 150, outcome: { status: "ok" } };
+    state.reactivate.mockImplementation(

+              unexpected.push(`${method} ${url.pathname}`);
+              throw new Error(`Unexpected Discord request: ${method} ${url.pathname}`);
+            }),
+          );
+          const operationalRunInstance = createOperationalRunInstanceRef("voice-state-run");
+          const delegatedAuthority = claimAgentRunDelegatedAuthority(operationalRunInstance);
+          const turnCapability = mintMessageActionTurnCapability({
+            agentId: "main",
+            runId: operationalRunInstance.runId,
+            sessionKey,
+            requesterAccountId: "default",
+            requesterSenderId: userId,
+            ...(scenario !== "forged-origin"
+              ? { toolContext: { currentChannelProvider: "discord", currentChannelId: channelId } }
+              : {}),
+          });
+          const messageActionContext = expectDefined(
+            resolveMessageActionTurnCapability({
+              token: turnCapability,
+              agentId: "main",
+              runId: operationalRunInstance.runId,
+              sessionKey,
+            }),
+            "issued message action turn capability",
+          );
+          const client: GatewayClient = {
+            connect: {
+              minProtocol: 1,
+              maxProtocol: 1,
+              role: "operator",
+              scopes: ["operator.read", "operator.write"],
+              client: {
+                id: GATEWAY_CLIENT_IDS.GATEWAY_CLIENT,
+                version: "test",
+                platform: "test",
+                mode: "backend",
+              },
+            },
+            internal: {
+              agentRuntimeIdentity: {
+                kind: "agentRuntime",
+                agentId: "main",
+                sessionKey,
+                operationalRunInstance,
+                delegatedAuthority: { kind: "local", ...delegatedAuthority },
+                messageActionContext: { ...messageActionContext, turnCapability },
+              },
+            },
+          };
+          const context = {
+            getRuntimeConfig: () => cfg,
+            dedupe: new Map(),
+            validateAgentRuntimeApprovalAuthority: createAgentRuntimeApprovalAuthorityValidator(),
+          } as GatewayRequestContext;
+          const respond = vi.fn<RespondFn>();
+          try {
+            if (scenario === "revoked") {
+              revokeMessageActionTurnCapability(turnCapability);
+            }
+            await messageActionHandler({
+              req: { type: "req", id: "voice-state", method: "message.action" },
+              params: {
+                channel: "discord",
+                action: "voice-status",
+                accountId: "default",
+                sessionKey,
+                agentId: "main",
+                senderIsOwner: true,
+                idempotencyKey: `voice-state-${scenario}`,
+                params: {
+                  guildId,
+                  userId: scenario === "other-user" ? "100000000000000099" : userId,
+                  requesterSenderId: userId,
+                  senderIsOwner: true,
+                  toolContext: { currentChannelProvider: "discord", currentChannelId: channelId },
+                },
+              },
+              client,
+              context,
+              respond,
+              isWebchatConnect: () => false,
+            });
+            const response = expectDefined(
+              respond.mock.calls[0],
+              "Gateway message action response",
+            );
+            expect(response[0], JSON.stringify(response[2])).toBe(scenario === "self");
+            expect(voiceRead).toHaveBeenCalledTimes(scenario === "self" ? 1 : 0);
+            if (scenario === "self") {
+              expect(response[1]).toMatchObject({
+                ok: true,
+                voice: { user_id: userId, channel_id: voiceChannelId },
+              });
+              expect(observedOwnerFlags).toEqual([false]);
+            }
+            expect(unexpected).toEqual([]);
+          } finally {
+            revokeMessageActionTurnCapability(turnCapability);
+            releaseAgentRunDelegatedAuthority(delegatedAuthority);
+          }
+        },
+      );
+    },
+  );
+});
diff --git a/src/gateway/server-methods/send.message-action-canonical.ts b/src/gateway/server-methods/send.message-action-canonical.ts
new file mode 100644
index 0000000000000000000000000000000000000000..937b5f165096cfd650d89ecc2c1a37d92950cd17
--- /dev/null
+++ b/src/gateway/server-methods/send.message-action-canonical.ts
@@ -0,0 +1,22 @@
+import type { MessageActionInput } from "../../infra/outbound/message-action-contracts.js";
+
+/** The Gateway retains final receipts while its canonical action owns transport dispatch. */
+export async function runGatewayCanonicalMessageAction(
+  input: MessageActionInput & { runtimeAgentId?: string },
+): Promise<unknown> {
+  const { runtimeAgentId, ...actionContext } = input;
+  const { runMessageAction } = await import("../../infra/outbound/message-action-runner.js");
+  const result = await runMessageAction({
+    ...actionContext,
+    gatewayOwnedDelivery: true,
+    ...(input.action === "send"
+      ? {
+          suppressTranscriptMirror: true,
+          actionOrigin: runtimeAgentId ? ("message-tool" as const) : undefined,
+          // This RPC's outer owner already armed any terminal source receipt.
+          sourceReplyFinal: input.sourceReplyFinal === false ? false : undefined,
+        }
+      : {}),
+  });
+  return result.payload;
+}

+import { createQueueTestRun } from "./queue.test-helpers.js";
+import { getExistingFollowupQueue } from "./queue/state.js";
+import { createReplyDispatcher } from "./reply-dispatcher.js";
+import { replyRunRegistry } from "./reply-run-registry.js";
+import { testing as replyTesting } from "./reply-run-registry.test-support.js";
+import { createRecoveryGatewayContext } from "./reply-turn-admission.test-fixtures.js";
+
+describe("retained visible input before recovery publication", () => {
+  afterEach(() => {
+    embeddedTesting.resetActiveEmbeddedRuns();
+    replyTesting.resetReplyRunRegistry();
+    vi.restoreAllMocks();
+  });
+
+  it.each(["commit", "abort", "replacement", "owner-release"] as const)(
+    "retains the original channels-first input through publication: %s",
+    async (condition) => {
+      const key = "agent:main:main";
+      const state = await createOpenClawTestState({ label: "retained-recovery-publication" });
+      const storePath = state.statePath("agents", "main", "sessions", "sessions.json");
+      const seed = createQueueTestRun({
+        prompt: "Use actual Nvidia, Apple and SPY icons",
+        messageId: "1554846091592081565",
+      });
+      Object.assign(seed.run, {
+        agentId: "main",
+        sessionKey: key,
+        sessionFile: key,
+        agentDir: state.agentDir("main"),
+        workspaceDir: state.workspaceDir,
+        config: { plugins: { enabled: false } },
+        senderIsOwner: true,
+        senderId: "joseph",
+        agentAccountId: "default",
+      });
+      const setup = await prepareRecoveryAdmission(key, seed, storePath);
+      if (setup.kind !== "ready") {
+        throw new Error("producer did not prepare original input");
+      }
+      let produced: FollowupRun | undefined;
+      await executePreparedReplyRun({
+        ...setup,
+        runReplyAgent: async (params) => {
+          produced = params.followupRun;
+          return undefined;
+        },
+      });
+      const original = expectDefined(produced, "original incoming authority");
+      const entry = {
+        sessionId: seed.run.sessionId,
+        updatedAt: Date.now(),
+        status: "running" as const,
+        abortedLastRun: true,
+        restartRecoveryDeliveryRunId: "recovered-marketing-run",
+        restartRecoveryDeliverySourceRunId: "original-channel-run",
+        restartRecoveryDeliveryContext: { channel: "discord", to: "channel:marketing" },
+        restartRecoverySourceIngress: "channel" as const,
+      };
+      replaceSessionEntrySync({ storePath, sessionKey: key }, entry);
+      const context = createRecoveryGatewayContext();
+      const abort = new AbortController();
+      const committed = createDeferredCore();
+      const entered = createDeferredCore();
+      const adopted = vi.fn(async () => {});
+      let recoveryLease: SessionWorkAdmissionLease | undefined;
+      const retry = vi
+        .spyOn(restartRecovery, "retryRestartAbortedMainSessionRecovery")
+        .mockImplementationOnce(async (request) => {
+          expect(request).toMatchObject({
+            expectedSessionId: entry.sessionId,
+            expectedRecoveryRunId: entry.restartRecoveryDeliveryRunId,
+          });
+          expect(replyRunRegistry.get(key)).toBeUndefined();
+          const pending = await beginSessionWorkAdmission({
+            scope: storePath,
+            identities: [key, entry.sessionId],
+            owner: MAIN_SESSION_RECOVERY_WORK_ADMISSION_OWNER,
+            assertAllowed: () => {},
+          });
+          recoveryLease = consumeSessionWorkAdmissionHandoff({
+            handoffId: pending.createHandoff(),
+            scope: storePath,
+            identities: [key, entry.sessionId],
+          });
+          expect(recoveryLease).toBe(pending);
+          await pending.run(async () =>
+            replaceSessionEntrySync(
+              { storePath, sessionKey: key },
+              {
+                ...entry,
+                abortedLastRun: false,
+                restartRecoveryRuns: [
+                  {
+                    runId: entry.restartRecoveryDeliveryRunId,
+                    lifecycleGeneration: getAgentEventLifecycleGeneration(),
+                  },
+                ],
+              },
+            ),
+          );
+          return { started: 1, settled: 0, failed: 0, skipped: 0 };
+        });
+      const dispatcher = createReplyDispatcher({ deliver: async () => undefined });
+      const lifecycle = { abortSignal: abort.signal, onAdopted: adopted };
+      const coordinator = createDispatchReplyOperationCoordinator({
+        agentId: "main",
+        cfg: seed.run.config,
+        ctx: finalizeInboundContext({
+          SessionKey: key,
+          Body: seed.prompt,
+          Provider: "discord",
+          ChatType: "group",
+          MessageSid: seed.messageId,
+        }),
+        dispatcher,
+        dispatchOperationSessionKey: key,
+        operationSessionStoreEntry: { entry, storePath },
+        replyOptions: { turnAdoptionLifecycle: lifecycle, abortSignal: abort.signal },
+        resolveOperationExpectedSessionId: () => entry.sessionId,
+      });
+      const preDispatch = withPluginRuntimeGatewayRequestScope(
+        { context, resolveGatewayContext: () => context, isWebchatConnect: () => false },
+        () => coordinator.ensureDispatchReplyOperation("pre_dispatch"),
+      );
+      // Install the rejection handler immediately; cancellation is tested below.
+      const observed = preDispatch.then(
+        (result) => ({ result }),
+        (error: unknown) => ({ error }),
+      );
+      try {
+        await vi.waitFor(() => expect(EMBEDDED_RUN_WAITERS.get(entry.sessionId)?.size).toBe(1));
+        expect(retry).toHaveBeenCalledOnce();
+        expect(replyRunRegistry.get(key)).toBeUndefined();
+        expect(
+          getSessionWorkAdmissionOwnerRelease({
+            scope: storePath,
+            identities: [key, entry.sessionId],
+            owner: MAIN_SESSION_RECOVERY_WORK_ADMISSION_OWNER,
+          }),
+        ).toBeDefined();
+        if (condition === "abort") {
+          abort.abort();
+          expect(await observed).toEqual({ result: { status: "busy" } });
+          expect(adopted).not.toHaveBeenCalled();
+          expect(replyRunRegistry.get(key)).toBeUndefined();
+          expect(EMBEDDED_RUN_WAITERS.has(entry.sessionId)).toBe(false);
+          return;
+        }
+        if (condition === "owner-release") {
+          replaceSessionEntrySync(
+            { storePath, sessionKey: key },
+            { sessionId: entry.sessionId, updatedAt: Date.now(), status: "done" },
+          );
+          recoveryLease?.release();
+          expect(await observed).toEqual({ result: { status: "ready" } });
+          expect(replyRunRegistry.get(key)).toBeDefined();
+          expect(adopted).not.toHaveBeenCalled();
+          expect(EMBEDDED_RUN_WAITERS.has(entry.sessionId)).toBe(false);
+          return;
+        }
+        if (condition === "replacement") {
+          replaceSessionEntrySync(
+            { storePath, sessionKey: key },
+            {
+              ...entry,
+              abortedLastRun: false,
+              restartRecoveryDeliveryRunId: "replacement-recovery-run",
+            },
+          );
+        }
+        await withRecoveredOwner(
+          key,
+          async ({ run, handle }) => {
+            if (condition === "replacement") {
+              expect(await observed).toHaveProperty("error");
+              expect(adopted).not.toHaveBeenCalled();
+              expect(replyRunRegistry.get(key)).toBeUndefined();
+              expect(EMBEDDED_RUN_WAITERS.has(entry.sessionId)).toBe(false);
+              return;
+            }
+            expect(await observed).toEqual({ result: { status: "ready" } });
+            expect(await coordinator.ensureDispatchReplyOperation("dispatch")).toEqual({
+              status: "ready",
+            });
+            expect(coordinator.getReplyOptions()?.replyOperation).toBeUndefined();
+            expect(replyRunRegistry.get(key)).toBeUndefined();
+            expect(EMBEDDED_RUN_WAITERS.has(entry.sessionId)).toBe(false);
+            const sink = expectDefined(handle.messageInjectionV2, "published guarded sink");
+            sink.queueMessage = vi.fn(async (_text, options, assertCurrent) => {
+              assertCurrent();
+              options?.onQueueAccepted?.(true);
+              entered.resolve();
+              await committed.promise;
+              assertCurrent();
+            });
+            run.turnAdoptionLifecycle = lifecycle;
+            const incoming = { ...run, run: { ...run.run, senderIsOwner: true } };
+            const admission = await prepareRecoveryAdmission(
+              key,
+              incoming,
+              storePath,
+              coordinator.getReplyOptions(),
+            );
+            if (admission.kind !== "ready") {
+              throw new Error("original input did not reach prepared admission");
+            }
+            expect(admission.shouldSteer).toBe(true);
+            let retained: FollowupRun | undefined;
+            const { runReplyAgent } = await import("./agent-runner-run.js");
+            const task = executePreparedReplyRun({
+              ...admission,
+              runReplyAgent: async (params) => {
+                retained = params.followupRun;
+                return await runReplyAgent(params);
+              },
+            });
+            try {
+              await entered.promise;
+              const sameInput = expectDefined(retained, "retained original followup");
+              expect(sameInput.messageId).toBe("1554846091592081565");
+              expect(getExistingFollowupQueue(key)?.items).toContain(sameInput);
+              expect(adopted).not.toHaveBeenCalled();
+              committed.resolve();
+              await expect(task).resolves.toBeUndefined();
+              expect(adopted).toHaveBeenCalledOnce();
+              expect(getExistingFollowupQueue(key)?.items ?? []).toEqual([]);
+              expect(
+                getSessionWorkAdmissionOwnerRelease({
+                  scope: storePath,
+                  identities: [key, entry.sessionId],
+                  owner: MAIN_SESSION_RECOVERY_WORK_ADMISSION_OWNER,
+                }),
+              ).toBeDefined();
+            } finally {
+              committed.resolve();
+              abort.abort();
+              await task;
+            }
+          },
+          (run) => {
+            Object.assign(run.run, original.run);
+            delete run.run.bashElevated;
+            delete run.run.elevatedLevel;
+            run.run.traceAuthorized = false;
+            // The default recovery client has WRITE_SCOPE. The original
+            // requester is restored separately by agent-run-execution-phase.
+            run.run.senderIsOwner = false;
+            run.run.senderId = "joseph";
+            run.originatingChannel = original.originatingChannel;
+            run.originatingAccountId = original.originatingAccountId;
+            run.originatingTo = original.originatingTo;
+            run.messageId = seed.messageId;
+          },
+        );
+      } finally {
+        committed.resolve();
+        abort.abort();
+        recoveryLease?.release();
+        await observed;
+        coordinator.completeDispatchReplyOperation();
+        await state.cleanup();
+      }
+    },
+  );
+});

new file mode 100644
index 0000000000000000000000000000000000000000..dbc6f1c1304b971b981efe1831d90f2f4aed8434
--- /dev/null
+++ b/src/process/exec.pending-spawn.test.ts
@@ -0,0 +1,199 @@
+// Deferred broker admission retains the same process owner through cancellation.
+import process from "node:process";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { createDeferredCore } from "../shared/deferred.js";
+import * as processIdentity from "../shared/pid-alive.js";
+import * as processTree from "./child-process-tree.js";
+import * as execRunner from "./exec-runner.js";
+import * as execSpawn from "./exec-spawn.js";
+import { runCommandBuffered } from "./exec.js";
+import { BrokerChild } from "./spawn-broker/child.js";
+
+afterEach(() => vi.restoreAllMocks());
+
+function pendingBrokerCommand() {
+  const transmit = vi.fn(async () => undefined);
+  const node = new BrokerChild(1, ["fixture-command"], transmit);
+  const result = createDeferredCore<
+    Awaited<ReturnType<typeof execSpawn.spawnCommandWithInvocation>["child"]> & { killed: boolean }
+  >();
+  // Match the broker client's existing result owner: physical close joins before result delivery.
+  const completion = (async () => {
+    try {
+      return await result.promise;
+    } finally {
+      await node.waitForClose();
+    }
+  })();
+  const properties = {
+    nodeChildProcess: node,
+    get pid() {
+      return node.pid;
+    },
+    get stdin() {
+      return node.stdin;
+    },
+    get stdout() {
+      return node.stdout;
+    },
+    get stderr() {
+      return node.stderr;
+    },
+    kill: (signal?: NodeJS.Signals | number) => node.kill(signal),
+  };
+  const command = Object.assign(completion, properties);
+  void Object.defineProperties(command, Object.getOwnPropertyDescriptors(properties));
+  const spawn = vi
+    .spyOn(execSpawn, "spawnCommandWithInvocation")
+    .mockImplementation((_argv, opts) => {
+      opts?.cancelSignal?.addEventListener("abort", () => node.kill(), { once: true });
+      return {
+        // The fixture substitutes only the existing broker transport's promise boundary.
+        child: command,
+        invocation: {
+          command: "fixture-command",
+          args: [],
+          usesWindowsExitCodeShim: false,
+          windowsHide: true,
+        },
+      };
+    });
+  const admit = () =>
+    node.receive({
+      type: "spawned",
+      id: 1,
+      pid: 4242,
+      spawnfile: "fixture-command",
+      spawnargs: ["fixture-command"],
+      connected: false,
+      stdioLength: 3,
+    });
+  const finish = (error?: Error) => {
+    if (node.pid === undefined) {
+      admit();
+    }
+    node.receive({ type: "exit", id: 1, code: 0, signal: null });
+    node.receive({ type: "closed", id: 1 });
+    if (error) {
+      result.reject(error);
+    } else {
+      result.resolve({
+        failed: false,
+        exitCode: 0,
+        signal: undefined,
+        killed: node.killed,
+        timedOut: false,
+        isCanceled: false,
+        isMaxBuffer: false,
+        isTerminated: false,
+        isForcefullyTerminated: false,
+        stdout: Buffer.alloc(0),
+        stderr: Buffer.alloc(0),
+      });
+    }
+  };
+  return { node, spawn, transmit, admit, finish };
+}
+
+describe.skipIf(process.platform === "win32")("buffered pending broker owner", () => {
+  it.each([false, true].flatMap((strict) => [false, true].map((reject) => ({ strict, reject }))))(
+    "preserves pending-spawn ownership with strict=$strict and native rejection=$reject",
+    async ({ strict, reject }) => {
+      vi.useFakeTimers();
+      const broker = pendingBrokerCommand();
+      const abort = new AbortController();
+      let groupAlive = false;
+      vi.spyOn(processIdentity, "getFileLockProcessStartTime").mockReturnValue(123);
+      vi.spyOn(processTree, "isChildProcessTreeAlive").mockImplementation(({ pid }) => {
+        expect(pid).toBe(4242);
+        return groupAlive;
+      });
+      const signal = vi.spyOn(process, "kill").mockImplementation((pid, value) => {
+        expect(pid).toBe(-4242);
+        expect(value).toBe("SIGTERM");
+        return true;
+      });
+      const failure = new Error("fixture native completion rejected");
+      let settled = false;
+      const running = runCommandBuffered(["fixture-command"], {
+        signal: abort.signal,
+        killProcessTree: true,
+        requireProcessTreeExtinction: strict,
+        killGraceMs: 100,
+      });
+      void running.then(() => {
+        settled = true;
+      });
+      try {
+        expect(broker.spawn).toHaveBeenCalledOnce();
+        abort.abort();
+        await vi.advanceTimersByTimeAsync(0);
+        expect(settled).toBe(!strict);
+        expect(broker.node.pid).toBeUndefined();
+        expect(signal).not.toHaveBeenCalled();
+        if (!strict) {
+          expect(await running).toMatchObject({
+            termination: "signal",
+            cleanup: "uncertain",
+            code: null,
+          });
+        }
+        groupAlive = true;
+        broker.admit();
+        await vi.advanceTimersByTimeAsync(0);
+        expect(signal).toHaveBeenCalledExactlyOnceWith(-4242, "SIGTERM");
+        if (strict) {
+          expect(settled).toBe(false);
+        }
+        groupAlive = false;
+        broker.finish(reject ? failure : undefined);
+        await vi.advanceTimersByTimeAsync(25);
+        expect(await running).toMatchObject({
+          termination: strict && reject ? "error" : "signal",
+          code: null,
+          cleanup: strict ? "cooperative" : "uncertain",
+          ...(strict && reject ? { error: failure } : {}),
+        });
+        await broker.node.waitForClose();
+        expect(broker.transmit).toHaveBeenCalledWith({ type: "kill", id: 1, signal: "SIGTERM" });
+        expect(signal.mock.calls.every(([pid]) => pid === -4242)).toBe(true);
+      } finally {
+        groupAlive = false;
+        abort.abort();
+        broker.finish();
+        await vi.advanceTimersByTimeAsync(25);
+        await running;
+        await broker.node.waitForClose();
+        vi.clearAllTimers();
+        vi.useRealTimers();
+      }
+    },
+  );
+});
+
+it.each(["normal", "cooperative", "forced", "uncertain"] as const)(
+  "retains thrown command cleanup classification %s in the buffered result",
+  async (cleanup) => {
+    const error = Object.assign(new Error("owned command failed"), { cleanup });
+    vi.spyOn(execRunner, "runCommandWithTimeout").mockRejectedValueOnce(error);
+    expect(await runCommandBuffered(["fixture-command"])).toMatchObject({
+      termination: "error",
+      code: null,
+      cleanup,
+      error,
+    });
+  },
+);
+
+it("reports pre-aborted admission as normal cleanup without a child", async () => {
+  const abort = new AbortController();
+  abort.abort();
+  const spawn = vi.spyOn(execSpawn, "spawnCommandWithInvocation");
+  expect(
+    await runCommandBuffered(["fixture-command"], {
+      signal: abort.signal,
+      requireProcessTreeExtinction: true,
+    }),
+  ).toMatchObject({ termination: "signal", cleanup: "normal", code: null });
+  expect(spawn).not.toHaveBeenCalled();
+});

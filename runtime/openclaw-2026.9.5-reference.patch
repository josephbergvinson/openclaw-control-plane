+import { closeSync, fstatSync, openSync, readFileSync } from "node:fs";
+import path from "node:path";
+import type { AnyAgentTool } from "openclaw/plugin-sdk/channel-entry-contract";
+import type {
+  OpenClawPluginApi,
+  OpenClawPluginToolContext,
+} from "openclaw/plugin-sdk/plugin-entry";
+import { normalizeOptionalString } from "openclaw/plugin-sdk/string-coerce-runtime";
+import { Type } from "typebox";
+import { publishDetachedLaneCheckpoint } from "./detached-lane-checkpoint-delivery.js";
+import {
+  createDetachedLaneCheckpointRequests,
+  DetachedLaneCheckpointProjector,
+  type DetachedLaneCheckpoint,
+} from "./detached-lane-checkpoint.js";
+
+const ACTIVE_TASK_STATUSES = new Set(["queued", "running"]);
+const TERMINAL_TASK_STATUSES = new Set(["succeeded", "failed", "timed_out", "cancelled", "lost"]);
+const DETACHED_TASK_RUNTIMES = new Set(["subagent", "acp"]);
+
+const DETACHED_LANE_CHECK_INTERVAL_MS = 10_000;
+const DETACHED_LANE_MAX_ATTACHMENT_BYTES = 32 * 1024 * 1024;
+
+const ActiveLaneBindSchema = Type.Object(
+  { action: Type.Literal("bind_current_message") },
+  { additionalProperties: false },
+);
+
+type BoundTaskRuns = ReturnType<OpenClawPluginApi["runtime"]["tasks"]["runs"]["bindSession"]>;
+type TaskRun = ReturnType<BoundTaskRuns["list"]>[number];
+
+type DiscordRoute = {
+  to: string;
+  accountId?: string;
+  threadId?: string;
+};
+
+type PendingInbound = {
+  messageId: string;
+  sessionKey: string;
+  senderId: string;
+  route: DiscordRoute;
+  receivedAt: number;
+  presentationRunId?: string;
+  content: string;
+  attachments: Array<{
+    content: string;
+    fileName: string;
+    mimeType?: string;
+  }>;
+};
+
+export type TrackedLane = {
+  runId: string;
+  taskId: string;
+  ownerSessionKey: string;
+  childSessionKey: string;
+  route: DiscordRoute;
+  checkpointProjector: DetachedLaneCheckpointProjector;
+  pendingCheckpoint?: DetachedLaneCheckpoint;
+  deliveryInFlight?: Promise<void>;
+  lastCheckpoint: { at: number; key: string };
+  checkpointRequest?: AbortController;
+  checkpointRequestNotBefore?: number;
+};
+
+type RuntimeOptions = {
+  now?: () => number;
+  schedule?: boolean;
+  checkIntervalMs?: number;
+  maxAttachmentBytes?: number;
+};
+
+type DetachedLaneController = {
+  tick: () => Promise<void>;
+  dispose: () => void;
+};
+
+function normalizeThreadId(value: string | number | undefined): string | undefined {
+  if (value === undefined) {
+    return undefined;
+  }
+  return normalizeOptionalString(String(value));
+}
+
+function resolveDiscordRoute(input: {
+  channel?: string;
+  to?: string;
+  accountId?: string;
+  threadId?: string | number;
+}): DiscordRoute | undefined {
+  if (input.channel?.trim().toLowerCase() !== "discord") {
+    return undefined;
+  }
+  const to = normalizeOptionalString(input.to);
+  if (!to) {
+    return undefined;
+  }
+  const accountId = normalizeOptionalString(input.accountId);
+  const threadId = normalizeThreadId(input.threadId);
+  return {
+    to,
+    ...(accountId ? { accountId } : {}),
+    ...(threadId ? { threadId } : {}),
+  };
+}
+
+function sameRoute(left: DiscordRoute, right: DiscordRoute): boolean {
+  return (
+    left.to === right.to && left.accountId === right.accountId && left.threadId === right.threadId
+  );
+}
+
+function isActiveDetachedTask(task: TaskRun): boolean {
+  return (
+    ACTIVE_TASK_STATUSES.has(task.status) &&
+    DETACHED_TASK_RUNTIMES.has(task.runtime) &&
+    Boolean(normalizeOptionalString(task.runId)) &&
+    Boolean(normalizeOptionalString(task.childSessionKey))
+  );
+}
+
+function selectExactActiveTask(tasks: readonly TaskRun[]): TaskRun | undefined {
+  const active = tasks.filter(isActiveDetachedTask);
+  return active.length === 1 ? active[0] : undefined;
+}
+
+function freezeStagedAttachment(
+  attachmentPath: string,
+  maxBytes: number,
+): (PendingInbound["attachments"][number] & { byteLength: number }) | undefined {
+  const descriptor = openSync(attachmentPath, "r");
+  try {
+    const before = fstatSync(descriptor);
+    if (!before.isFile() || before.size < 0 || before.size > maxBytes) {
+      return undefined;
+    }
+    const bytes = readFileSync(descriptor);
+    const after = fstatSync(descriptor);
+    if (bytes.byteLength !== before.size || after.size !== before.size) {
+      return undefined;
+    }
+    return {
+      content: bytes.toString("base64"),
+      fileName: path.basename(attachmentPath),
+      byteLength: bytes.byteLength,
+    };
+  } finally {
+    closeSync(descriptor);
+  }
+}
+
+/** Registers the Discord-only detached-lane presentation contract. */
+export function registerDetachedLaneContract(
+  api: OpenClawPluginApi,
+  options: RuntimeOptions = {},
+): DetachedLaneController {
+  const now = options.now ?? Date.now;
+  const progressNow = options.now ?? (() => performance.now());
+  const checkIntervalMs = options.checkIntervalMs ?? DETACHED_LANE_CHECK_INTERVAL_MS;
+  const maxAttachmentBytes = options.maxAttachmentBytes ?? DETACHED_LANE_MAX_ATTACHMENT_BYTES;
+  const lanes = new Map<string, TrackedLane>();
+  const pendingInbound = new Map<string, PendingInbound[]>();
+  let tickInFlight: Promise<void> | undefined;
+  let disposed = false;
+
+  const taskRuntime = (sessionKey: string) => api.runtime.tasks.runs.bindSession({ sessionKey });
+
+  const rememberInbound = (inbound: PendingInbound): void => {
+    const existing = pendingInbound.get(inbound.messageId) ?? [];
+    if (
+      existing.some(
+        (candidate) =>
+          candidate.sessionKey === inbound.sessionKey && sameRoute(candidate.route, inbound.route),
+      )
+    ) {
+      return;
+    }
+    existing.push(inbound);
+    pendingInbound.set(inbound.messageId, existing);
+  };
+
+  const removeInbound = (inbound: PendingInbound): void => {
+    const existing = pendingInbound.get(inbound.messageId);
+    if (!existing) {
+      return;
+    }
+    const remaining = existing.filter((candidate) => candidate !== inbound);
+    if (remaining.length > 0) {
+      pendingInbound.set(inbound.messageId, remaining);
+    } else {
+      pendingInbound.delete(inbound.messageId);
+    }
+  };
+
+  const findInboundForSpawn = (params: {
+    messageId: string;
+    route: DiscordRoute;
+  }): PendingInbound | undefined => {
+    const matches = (pendingInbound.get(params.messageId) ?? []).filter((candidate) =>
+      sameRoute(candidate.route, params.route),
+    );
+    return matches.length === 1 ? matches[0] : undefined;
+  };
+
+  const findInboundForTool = (params: {
+    route: DiscordRoute;
+    senderId: string;
+  }): PendingInbound | undefined => {
+    const matches = [...pendingInbound.values()]
+      .flat()
+      .filter(
+        (candidate) =>
+          candidate.senderId === params.senderId && sameRoute(candidate.route, params.route),
+      );
+    return matches.length === 1 ? matches[0] : undefined;
+  };
+
+  const resolveCurrentLaneTask = (lane: TrackedLane): TaskRun | undefined => {
+    const task = taskRuntime(lane.ownerSessionKey).get(lane.taskId);
+    if (
+      !task ||
+      task.ownerKey !== lane.ownerSessionKey ||
+      task.runId !== lane.runId ||
+      task.childSessionKey !== lane.childSessionKey ||
+      !DETACHED_TASK_RUNTIMES.has(task.runtime)
+    ) {
+      return undefined;
+    }
+    return task;
+  };
+
+  const bindTrackedLane = (params: {
+    task: TaskRun;
+    ownerSessionKey: string;
+    route: DiscordRoute;
+    inbound: PendingInbound;
+  }): void => {
+    const runId = normalizeOptionalString(params.task.runId);
+    const childSessionKey = normalizeOptionalString(params.task.childSessionKey);
+    if (!runId || !childSessionKey || !isActiveDetachedTask(params.task)) {
+      return;
+    }
+    const existing = lanes.get(runId);
+    if (existing) {
+      if (
+        existing.taskId !== params.task.id ||
+        existing.ownerSessionKey !== params.ownerSessionKey ||
+        existing.childSessionKey !== childSessionKey ||
+        !sameRoute(existing.route, params.route)
+      ) {
+        api.logger.warn("lane-contract withheld a conflicting detached run identity");
+      }
+      return;
+    }
+    if (params.inbound.presentationRunId) {
+      if (params.inbound.presentationRunId !== runId) {
+        api.logger.warn("lane-contract withheld a conflicting inbound presentation identity");
+      }
+      return;
+    }
+    const lane: TrackedLane = {
+      runId,
+      taskId: params.task.id,
+      ownerSessionKey: params.ownerSessionKey,
+      childSessionKey,
+      route: params.route,
+      checkpointProjector: new DetachedLaneCheckpointProjector(),
+      lastCheckpoint: { at: progressNow(), key: "initial" },
+    };
+    params.inbound.presentationRunId = runId;
+    lanes.set(runId, lane);
+  };
+
+  const trackSpawnedLane = async (event: {
+    runId: string;
+    childSessionKey: string;
+    label?: string;
+    requester?: {
+      channel?: string;
+      accountId?: string;
+      to?: string;
+      threadId?: string | number;
+      channelId?: string | number;
+      messageId?: string | number;
+    };
+  }): Promise<void> => {
+    const runId = normalizeOptionalString(event.runId);
+    const childSessionKey = normalizeOptionalString(event.childSessionKey);
+    const messageId = normalizeOptionalString(
+      event.requester?.messageId === undefined ? undefined : String(event.requester.messageId),
+    );
+    const route = resolveDiscordRoute({
+      channel: event.requester?.channel,
+      to:
+        event.requester?.to ??
+        (event.requester?.channelId === undefined ? undefined : String(event.requester.channelId)),
+      accountId: event.requester?.accountId,
+      threadId: event.requester?.threadId,
+    });
+    if (!runId || !childSessionKey || !messageId || !route) {
+      return;
+    }
+    const inbound = findInboundForSpawn({ messageId, route });
+    if (!inbound) {
+      return;
+    }
+    const matches = taskRuntime(inbound.sessionKey)
+      .list()
+      .filter(
+        (task) =>
+          task.ownerKey === inbound.sessionKey &&
+          task.runId === runId &&
+          task.childSessionKey === childSessionKey &&
+          isActiveDetachedTask(task),
+      );
+    const task = matches[0];
+    if (matches.length !== 1 || !task) {
+      return;
+    }
+    bindTrackedLane({
+      task,
+      ownerSessionKey: inbound.sessionKey,
+      route,
+      inbound,
+    });
+  };
+
+  const reconcileInboundLane = async (inbound: PendingInbound): Promise<void> => {
+    if (inbound.presentationRunId) {
+      return;
+    }
+    const matches = taskRuntime(inbound.sessionKey)
+      .list()
+      .filter(
+        (task) =>
+          task.ownerKey === inbound.sessionKey &&
+          task.createdAt >= inbound.receivedAt &&
+          isActiveDetachedTask(task),
+      );
+    const task = matches[0];
+    if (matches.length !== 1 || !task) {
+      return;
+    }
+    // A task-only fallback is safe only when this is also the sole fresh inbound
+    // that could have caused it. This keeps stale or overlapping turns fail-closed.
+    const inboundMatches = [...pendingInbound.values()]
+      .flat()
+      .filter(
+        (candidate) =>
+          candidate.sessionKey === inbound.sessionKey && task.createdAt >= candidate.receivedAt,
+      );
+    if (inboundMatches.length !== 1 || inboundMatches[0] !== inbound) {
+      return;
+    }
+    bindTrackedLane({
+      task,
+      ownerSessionKey: inbound.sessionKey,
+      route: inbound.route,
+      inbound,
+    });
+  };
+
+  const reconcilePendingInbound = async (sessionKey?: string): Promise<void> => {
+    for (const inbound of [...pendingInbound.values()].flat()) {
+      if (sessionKey && inbound.sessionKey !== sessionKey) {
+        continue;
+      }
+      try {
+        await reconcileInboundLane(inbound);
+      } catch {
+        api.logger.warn("lane-contract detached-run reconciliation failed");
+      }
+    }
+  };
+
+  const clearPendingInboundForSession = (sessionKey: string): void => {
+    for (const inbound of [...pendingInbound.values()].flat()) {
+      if (inbound.sessionKey === sessionKey) {
+        removeInbound(inbound);
+      }
+    }
+  };
+
+  const releaseTrackedLane = (lane: TrackedLane): void => {
+    if (lanes.get(lane.runId) !== lane) {
+      return;
+    }
+    lanes.delete(lane.runId);
+    lane.checkpointRequest?.abort();
+    for (const inbound of [...pendingInbound.values()].flat()) {
+      if (inbound.presentationRunId === lane.runId) {
+        removeInbound(inbound);
+      }
+    }
+  };
+
+  const checkpoints = createDetachedLaneCheckpointRequests<TrackedLane>({
+    progressNow,
+    isDisposed: () => disposed,
+    isCurrentLane: (lane) => lanes.get(lane.runId) === lane,
+    resolveCurrentLaneTask,
+    taskRuntime,
+    warn: (message) => api.logger.warn(message),
+  });
+
+  const sendCheckpoint = (lane: TrackedLane, checkpoint: DetachedLaneCheckpoint): void => {
+    // Hold only this lane through receipt bookkeeping. A slow send must not
+    // prevent other tasks from publishing progress or requesting a checkpoint.
+    const delivery = (async () => {
+      let messageId: string | undefined;
+      try {
+        messageId = await publishDetachedLaneCheckpoint({
+          api,
+          lane,
+          checkpoint,
+          signal: lane.checkpointRequest?.signal ?? new AbortController().signal,
+          isCurrent: () =>
+            !disposed && lanes.get(lane.runId) === lane && Boolean(resolveCurrentLaneTask(lane)),
+        });
+      } catch {
+        // Missing and rejected receipts have the same ambiguous-send policy.
+      }
+      if (disposed || lanes.get(lane.runId) !== lane) {
+        return;
+      }
+      const task = resolveCurrentLaneTask(lane);
+      if (!task) {
+        api.logger.warn(`lane-contract detached task identity unavailable: run=${lane.runId}`);
+        releaseTrackedLane(lane);
+        return;
+      }
+      if (messageId) {
+        checkpoints.recordReceipt(lane, checkpoint);
+      } else {
+        checkpoints.recordUnconfirmedAttempt(lane, checkpoint);
+        api.logger.warn(
+          `lane-contract checkpoint delivery unconfirmed; preserving later progress: run=${lane.runId}`,
+        );
+      }
+      if (
+        !lane.pendingCheckpoint &&
+        TERMINAL_TASK_STATUSES.has(task.status) &&
+        task.deliveryStatus !== "pending"
+      ) {
+        releaseTrackedLane(lane);
+      }
+    })()
+      .catch(() => {
+        api.logger.warn(`lane-contract checkpoint settlement failed: run=${lane.runId}`);
+      })
+      .finally(() => {
+        if (lane.deliveryInFlight === delivery) {
+          lane.deliveryInFlight = undefined;
+        }
+      });
+    lane.deliveryInFlight = delivery;
+  };
+
+  const runTick = async (): Promise<void> => {
+    await reconcilePendingInbound();
+    if (disposed) {
+      return;
+    }
+    for (const lane of lanes.values()) {
+      const task = resolveCurrentLaneTask(lane);
+      if (!task) {
+        api.logger.warn(`lane-contract detached task identity unavailable: run=${lane.runId}`);
+        releaseTrackedLane(lane);
+        continue;
+      }
+      if (lane.deliveryInFlight) {
+        continue;
+      }
+      const terminal = TERMINAL_TASK_STATUSES.has(task.status);
+      if (terminal) {
+        lane.checkpointRequest?.abort();
+      }
+      if (!terminal && !ACTIVE_TASK_STATUSES.has(task.status)) {
+        continue;
+      }
+      if (lane.pendingCheckpoint) {
+        sendCheckpoint(lane, lane.pendingCheckpoint);
+        continue;
+      }
+      if (terminal) {
+        if (task.deliveryStatus !== "pending") {
+          releaseTrackedLane(lane);
+        }
+        continue;
+      }
+      if (task.status === "running") {
+        checkpoints.requestOverdue(lane);
+      }
+    }
+  };
+
+  const tick = (): Promise<void> => {
+    if (disposed) {
+      return Promise.resolve();
+    }
+    tickInFlight ??= runTick().finally(() => {
+      tickInFlight = undefined;
+    });
+    return tickInFlight;
+  };
+
+  api.on("message_received", (event, ctx) => {
+    const messageId = normalizeOptionalString(event.messageId);
+    const sessionKey = normalizeOptionalString(ctx.sessionKey);
+    const senderId = normalizeOptionalString(event.senderId ?? ctx.senderId);
+    const route = resolveDiscordRoute({
+      channel: ctx.channelId,
+      to: ctx.conversationId,
+      accountId: ctx.accountId,
+      threadId: event.threadId,
+    });
+    if (!messageId || !sessionKey || !senderId || !route || event.mediaStagingPending === true) {
+      return;
+    }
+    let attachments: PendingInbound["attachments"];
+    try {
+      const media = event.media ?? [];
+      if (media.some((entry) => !normalizeOptionalString(entry.path))) {
+        api.logger.warn("lane-contract withheld an unstaged Discord attachment");
+        return;
+      }
+      let remainingBytes = maxAttachmentBytes;
+      attachments = media.flatMap((entry) => {
+        const attachmentPath = normalizeOptionalString(entry.path);
+        if (!attachmentPath) {
+          return [];
+        }
+        const frozen = freezeStagedAttachment(attachmentPath, remainingBytes);
+        if (!frozen) {
+          throw new Error("attachment could not be frozen within the lane bound");
+        }
+        remainingBytes -= frozen.byteLength;
+        const mimeType = normalizeOptionalString(entry.contentType);
+        return [
+          {
+            content: frozen.content,
+            fileName: frozen.fileName,
+            ...(mimeType ? { mimeType } : {}),
+          },
+        ];
+      });
+    } catch {
+      api.logger.warn("lane-contract withheld an unreadable staged Discord attachment");
+      return;
+    }
+    if (!event.content && attachments.length === 0) {
+      return;
+    }
+    rememberInbound({
+      messageId,
+      sessionKey,
+      senderId,
+      route,
+      receivedAt: now(),
+      content: event.content,
+      attachments,
+    });
+  });
+
+  api.on("agent_end", async (_event, ctx) => {
+    const sessionKey = normalizeOptionalString(ctx.sessionKey);
+    if (!sessionKey) {
+      return;
+    }
+    await reconcilePendingInbound(sessionKey);
+    clearPendingInboundForSession(sessionKey);
+  });
+
+  api.on("subagent_spawned", async (event) => {
+    try {
+      await trackSpawnedLane(event);
+    } catch {
+      api.logger.warn("lane-contract detached-run binding failed");
+    }
+  });
+
+  api.on("subagent_progress", async (event) => {
+    if (event.phase !== "started") {
+      return;
+    }
+    try {
+      await trackSpawnedLane(event);
+    } catch {
+      api.logger.warn("lane-contract detached-run binding failed");
+    }
+  });
+
+  api.agent.events.registerAgentEventSubscription({
+    id: "lane-contract-natural-progress",
+    description: "Relay completed natural child commentary for an exact detached lane",
+    streams: ["assistant", "item", "tool", "lifecycle"],
+    async handle(event) {
+      if (
+        event.stream === "lifecycle" &&
+        (event.data.phase === "end" || event.data.phase === "error")
+      ) {
+        const sessionKey = normalizeOptionalString(event.sessionKey);
+        if (sessionKey) {
+          await reconcilePendingInbound(sessionKey);
+          clearPendingInboundForSession(sessionKey);
+        }
+        return;
+      }
+      const lane = lanes.get(event.runId);
+      const sessionMatches = !event.sessionKey || event.sessionKey === lane?.childSessionKey;
+      const task = lane ? resolveCurrentLaneTask(lane) : undefined;
+      if (!lane || !sessionMatches || !task || !ACTIVE_TASK_STATUSES.has(task.status)) {
+        return;
+      }
+      const checkpoint = lane.checkpointProjector.projectCheckpoint(event);
+      if (checkpoint) {
+        lane.pendingCheckpoint = checkpoint;
+      }
+    },
+  });
+
+  api.registerTool(
+    (ctx: OpenClawPluginToolContext): AnyAgentTool | null => {
+      const route = resolveDiscordRoute({
+        channel: ctx.deliveryContext?.channel ?? ctx.messageChannel,
+        to: ctx.deliveryContext?.to ?? ctx.nativeChannelId,
+        accountId: ctx.deliveryContext?.accountId ?? ctx.agentAccountId,
+        threadId: ctx.deliveryContext?.threadId,
+      });
+      if (ctx.messageChannel?.trim().toLowerCase() !== "discord" || !route) {
+        return null;
+      }
+      const senderId = normalizeOptionalString(ctx.requesterSenderId);
+      if (ctx.senderIsOwner !== true || !senderId || !route.accountId) {
+        return null;
+      }
+      const inbound = findInboundForTool({ route, senderId });
+      if (!inbound) {
+        return null;
+      }
+      const active = selectExactActiveTask(taskRuntime(inbound.sessionKey).list());
+      if (!active?.runId || !active.childSessionKey || active.ownerKey !== inbound.sessionKey) {
+        return null;
+      }
+      let invocation: Promise<void> | undefined;
+      return {
+        name: "discord_bind_active_lane",
+        label: "Bind Active Discord Task",
+        description:
+          "Bind this authenticated Discord message and its staged attachments to the one exact active detached task in the current conversation. The target is runtime-bound and cannot be selected by tool input.",
+        parameters: ActiveLaneBindSchema,
+        execute: async () => {
+          invocation ??= (async () => {
+            const currentInbound = findInboundForTool({ route, senderId });
+            const current = selectExactActiveTask(taskRuntime(inbound.sessionKey).list());
+            if (
+              currentInbound !== inbound ||
+              !current?.runId ||
+              !current.childSessionKey ||
+              current.id !== active.id ||
+              current.runId !== active.runId ||
+              current.childSessionKey !== active.childSessionKey ||
+              current.ownerKey !== inbound.sessionKey
+            ) {
+              throw new Error("The exact active Discord task is no longer current");
+            }
+            await api.runtime.gateway.request("sessions.steer", {
+              key: current.childSessionKey,
+              message: inbound.content,
+              ...(inbound.attachments.length > 0 ? { attachments: inbound.attachments } : {}),
+              timeoutMs: 0,
+              idempotencyKey: `lane-contract:bind:${current.id}:${inbound.messageId}`,
+            });
+            removeInbound(inbound);
+          })();
+          await invocation;
+          return {
+            content: [
+              {
+                type: "text",
+                text: "The current Discord message was bound to the exact active detached task. Return NO_REPLY for this turn; native task delivery owns the visible completion.",
+              },
+            ],
+            details: { status: "bound" },
+          };
+        },
+      };
+    },
+    { name: "discord_bind_active_lane" },
+  );
+
+  const interval =
+    options.schedule === false
+      ? undefined
+      : setInterval(() => {
+          void tick().catch(() => {
+            api.logger.warn("lane-contract checkpoint tick failed");
+          });
+        }, checkIntervalMs);
+  interval?.unref?.();
+
+  const dispose = () => {
+    if (disposed) {
+      return;
+    }
+    disposed = true;
+    if (interval) {
+      clearInterval(interval);
+    }
+    for (const lane of lanes.values()) {
+      lane.checkpointRequest?.abort();
+    }
+    lanes.clear();
+    pendingInbound.clear();
+  };
+  api.lifecycle.registerRuntimeLifecycle({
+    id: "lane-contract-detached-runtime",
+    description: "Release process-local detached-lane presentation state",
+    cleanup: dispose,
+  });
+
+  return {
+    tick,
+    dispose,
+  };
+}

--- /dev/null
+++ b/extensions/browser/src/browser/pw-session-cdp-event-failure.test.ts
@@ -0,0 +1,116 @@
+// Exercise real Playwright dispatch; substituting onmessage hides deferred event failures.
+import type { Browser, ConnectOverCDPTransport } from "playwright-core";
+import { describe, expect, it, vi } from "vitest";
+import { connectOverCdpTransport } from "./pw-session-cdp-transport.js";
+
+function makePageWire() {
+  let attached = false;
+  const close = vi.fn<() => void>();
+  const wire: ConnectOverCDPTransport = {
+    close,
+    send(message) {
+      const command = message as { id: number; method: string; sessionId?: string };
+      setImmediate(() => {
+        if (command.method === "Target.setAutoAttach" && !command.sessionId && !attached) {
+          attached = true;
+          wire.onmessage?.({
+            method: "Target.attachedToTarget",
+            params: {
+              sessionId: "page-session",
+              waitingForDebugger: false,
+              targetInfo: {
+                targetId: "page-main",
+                browserContextId: "fixture-context",
+                type: "page",
+                url: "https://fixture.invalid/",
+                title: "Fixture",
+              },
+            },
+          });
+        }
+        const result =
+          command.method === "Browser.getVersion"
+            ? {
+                product: "Chrome/140.0.0.0",
+                userAgent: "Fixture Chrome",
+                revision: "fixture",
+              }
+            : command.method === "Page.getFrameTree"
+              ? {
+                  frameTree: {
+                    frame: {
+                      id: "page-main",
+                      loaderId: "fixture-loader",
+                      url: "https://fixture.invalid/",
+                      securityOrigin: "https://fixture.invalid",
+                      mimeType: "text/html",
+                    },
+                  },
+                }
+              : {};
+        wire.onmessage?.({ id: command.id, result, sessionId: command.sessionId });
+      });
+    },
+  };
+  return { wire, close };
+}
+
+async function connectFixture(wire: ConnectOverCDPTransport): Promise<Browser> {
+  return await connectOverCdpTransport("ws://127.0.0.1/fixture", {
+    timeout: 10000,
+    headers: {},
+    preparedTransport: wire,
+  });
+}
+
+function attachChild(wire: ConnectOverCDPTransport) {
+  wire.onmessage?.({
+    sessionId: "page-session",
+    method: "Page.frameAttached",
+    params: { frameId: "fixture-child", parentFrameId: "page-main" },
+  });
+}
+
+describe("real Playwright CDP event failure ownership", () => {
+  it("retires the failed connection after duplicate child-frame delivery and allows a fresh connection", async () => {
+    const failed = makePageWire();
+    const fresh = makePageWire();
+    let browser: Browser | undefined;
+    let replacement: Browser | undefined;
+    try {
+      browser = await connectFixture(failed.wire);
+      const page = browser.contexts()[0]?.pages()[0];
+      expect(page).toBeDefined();
+      const attached = vi.fn();
+      page?.on("frameattached", attached);
+      attachChild(failed.wire);
+      await expect.poll(() => page?.frames().length).toBe(2);
+      expect(attached).toHaveBeenCalledOnce();
+
+      // This invokes the real FrameManager assertion through CRSession's deferred emitter.
+      attachChild(failed.wire);
+      await expect.poll(() => failed.close.mock.calls.length).toBe(1);
+      expect(browser.isConnected()).toBe(true);
+      attachChild(failed.wire);
+      await new Promise<void>((resolve) => {
+        setImmediate(resolve);
+      });
+      expect(attached).toHaveBeenCalledOnce();
+      expect(failed.close).toHaveBeenCalledOnce();
+
+      // A borrowed transport closes only when its owner acknowledges cleanup.
+      failed.wire.onclose?.("fixture owner cleanup acknowledged");
+      await expect.poll(() => browser?.isConnected()).toBe(false);
+      replacement = await connectFixture(fresh.wire);
+      const replacementPage = replacement.contexts()[0]?.pages()[0];
+      attachChild(fresh.wire);
+      await expect.poll(() => replacementPage?.frames().length).toBe(2);
+      expect(replacement.isConnected()).toBe(true);
+      expect(fresh.close).not.toHaveBeenCalled();
+    } finally {
+      failed.wire.onclose?.("fixture cleanup");
+      fresh.wire.onclose?.("fixture cleanup");
+      await Promise.all([browser?.close(), replacement?.close()]);
+    }
+  });
+});

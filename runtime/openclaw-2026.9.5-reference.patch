@@ -0,0 +1,52 @@
+import type { ReplyOperation, ReplyToolAuthoritySnapshot } from "./reply-run-registry.contracts.js";
+import { getAttachedBackend, replyRunState } from "./reply-run-registry.state.js";
+
+/** Read-only attempt observation; it never replaces the admitted tool authority. */
+export function bindReplyAutoAuthObservation(
+  operation: ReplyOperation,
+  readSnapshot: () => ReplyToolAuthoritySnapshot | undefined,
+): void {
+  Object.defineProperty(operation, "acceptedAutoAuthProfile", {
+    enumerable: true,
+    configurable: true,
+    get(): ReplyOperation["acceptedAutoAuthProfile"] {
+      const toolAuthoritySnapshot = readSnapshot();
+      const admittedProfileId = toolAuthoritySnapshot?.autoAuthProfileId;
+      const contextFingerprint = toolAuthoritySnapshot?.autoAuthContextFingerprint;
+      const backend = getAttachedBackend(operation);
+      const route = operation.toolAuthorityRoute;
+      const fingerprint = operation.toolAuthorityFingerprint;
+      const isActive = () =>
+        !operation.result &&
+        !operation.abortSignal.aborted &&
+        operation.phase === "running" &&
+        operation.toolAuthorityRoute === route &&
+        operation.toolAuthorityFingerprint === fingerprint &&
+        replyRunState.activeRunsByKey.get(operation.key) === operation &&
+        getAttachedBackend(operation) === backend;
+      if (!admittedProfileId || !contextFingerprint || !backend || !isActive()) {
+        return undefined;
+      }
+      try {
+        const acceptedProfileId = backend.acceptedAutoAuthProfileId;
+        if (!acceptedProfileId) {
+          return undefined;
+        }
+        return {
+          admittedProfileId,
+          acceptedProfileId,
+          contextFingerprint,
+          isCurrent: () => {
+            try {
+              return isActive() && backend.acceptedAutoAuthProfileId === acceptedProfileId;
+            } catch {
+              return false;
+            }
+          },
+        };
+      } catch {
+        return undefined;
+      }
+    },
+  });
+}

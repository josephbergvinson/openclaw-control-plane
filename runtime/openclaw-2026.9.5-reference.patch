new file mode 100644
index 0000000000000000000000000000000000000000..db04a68a1b7665e329c8ed42b74c81c1bb0e354a
--- /dev/null
+++ b/src/auto-reply/reply/get-reply-run.owner-permission.test-support.ts
@@ -0,0 +1,92 @@
+import { describe, expect, it } from "vitest";
+import { resolveSessionPermissionCoreToolPolicy } from "../../agents/session-permission-exec-mode.js";
+import type { runReplyAgent } from "./agent-runner.runtime.js";
+import { runPreparedReply } from "./get-reply-run.js";
+
+type Params = Parameters<typeof runPreparedReply>[0];
+
+export function registerOwnerPermissionDefaultTests(fixture: {
+  ownerParams: () => Params;
+  requireRunReplyAgentCall: () => Parameters<typeof runReplyAgent>[0];
+}) {
+  describe("owner permission default admission", () => {
+    it.each([true, false])(
+      "admits owner Full with an unset row, new session %s",
+      async (isNewSession) => {
+        const params = fixture.ownerParams();
+        params.cfg = { agents: { defaults: { ownerPermissionMode: "full" } } };
+        params.isNewSession = isNewSession;
+        params.sessionEntry = { sessionId: "session-owner", updatedAt: Date.now() };
+        await runPreparedReply(params);
+        const run = fixture.requireRunReplyAgentCall().followupRun.run;
+        expect(run.permissionMode).toBe("full");
+        expect(resolveSessionPermissionCoreToolPolicy({ mode: run.permissionMode! })).toEqual({
+          workspaceOnly: false,
+          readOnly: false,
+          applyPatchWorkspaceOnly: false,
+          execMode: "full",
+          bypassHostApprovalFloors: true,
+        });
+        expect(params.sessionEntry.permissionMode).toBeUndefined();
+      },
+    );
+
+    it.each(["read-only", "guarded", "workspace", "full"] as const)(
+      "preserves explicit %s",
+      async (permissionMode) => {
+        const params = fixture.ownerParams();
+        params.cfg = { agents: { defaults: { ownerPermissionMode: "full" } } };
+        params.sessionEntry = {
+          sessionId: "session-explicit",
+          updatedAt: Date.now(),
+          permissionMode,
+        };
+        await runPreparedReply(params);
+        expect(fixture.requireRunReplyAgentCall().followupRun.run.permissionMode).toBe(
+          permissionMode,
+        );
+      },
+    );
+
+    it.each(["non-owner", "heartbeat", "inter-session", "child"])(
+      "does not grant the default for %s",
+      async (kind) => {
+        const params = fixture.ownerParams();
+        params.cfg = { agents: { defaults: { ownerPermissionMode: "full" } } };
+        params.sessionEntry = { sessionId: "session-other", updatedAt: Date.now() };
+        if (kind === "non-owner") {
+          params.command.senderIsOwner = false;
+        }
+        if (kind === "heartbeat") {
+          params.opts = { isHeartbeat: true };
+        }
+        if (kind === "inter-session") {
+          params.sessionCtx.InputProvenance = {
+            kind: "inter_session",
+            sourceSessionKey: "agent:other:main",
+            sourceTool: "sessions_send",
+          };
+        }
+        if (kind === "child") {
+          params.sessionEntry.spawnedBy = "agent:main:parent";
+        }
+        await runPreparedReply(params);
+        expect(fixture.requireRunReplyAgentCall().followupRun.run.permissionMode).toBeUndefined();
+        expect(params.sessionEntry.permissionMode).toBeUndefined();
+      },
+    );
+
+    it("keeps the native admission snapshot even when the later config has changed", async () => {
+      const params = fixture.ownerParams();
+      params.cfg = { agents: { defaults: { ownerPermissionMode: "full" } } };
+      params.opts = {
+        admittedSessionSettings: Object.freeze({
+          permissionMode: undefined,
+          toolOverrides: undefined,
+        }),
+      };
+      await runPreparedReply(params);
+      expect(fixture.requireRunReplyAgentCall().followupRun.run.permissionMode).toBeUndefined();
+    });
+  });
+}

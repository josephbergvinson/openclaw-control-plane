+import type { DiscordAccountConfig, OpenClawConfig } from "openclaw/plugin-sdk/config-contracts";
+import { formatErrorMessage } from "openclaw/plugin-sdk/error-runtime";
+import { createDeferred } from "openclaw/plugin-sdk/extension-shared";
+import { createRuntimeConfigReader } from "openclaw/plugin-sdk/runtime-config-snapshot";
+import { formatZonedTimestamp, resolveTimezone } from "openclaw/plugin-sdk/time-runtime";
+import {
+  startConfiguredTranscriptCapture,
+  type ConfiguredTranscriptCapture,
+  type TranscriptSessionDescriptor,
+  type TranscriptsSummary,
+} from "openclaw/plugin-sdk/transcripts";
+import { mergeDiscordAccountConfig } from "../accounts.js";
+import type { Client } from "../internal/discord.js";
+import type { DiscordLivePolicyReader } from "../monitor/live-policy.js";
+import { sendMessageDiscord } from "../send.outbound.js";
+import type { VoiceOperationResult } from "./session.js";
+import type { VoiceChannelResidency } from "./voice-following.js";
+
+type FollowRecordingEpisode = {
+  target: VoiceChannelResidency;
+  abort: AbortController;
+  starting: Promise<ConfiguredTranscriptCapture | undefined>;
+  names: Promise<{ server?: string; room?: string }>;
+  timeZone: string;
+  released?: Promise<VoiceOperationResult | void>;
+  finishing?: Promise<VoiceOperationResult | void>;
+  failed?: boolean;
+  stoppedAt?: string;
+  summaryAbort: AbortController;
+  publicationStarted?: boolean;
+  captureStopped?: boolean;
+};
+
+function displayName(value: string): string {
+  return value
+    .trim()
+    .replace(/\s+/gu, " ")
+    .replace(/([\\`*_~<>[\]])/gu, "\\$1");
+}
+
+function renderMinutes(params: {
+  summary: TranscriptsSummary | undefined;
+  session: TranscriptSessionDescriptor;
+  names: { server?: string; room?: string };
+  timeZone: string;
+}): string {
+  const { summary, session, names, timeZone } = params;
+  const list = (items: string[]) =>
+    items.length ? items.map((item) => `- ${item}`).join("\n") : "- None captured";
+  const modeled = summary?.source === "model";
+  const empty = summary?.utteranceCount === 0;
+  const started = formatZonedTimestamp(new Date(session.startedAt), { timeZone });
+  const ended = session.stoppedAt
+    ? formatZonedTimestamp(new Date(session.stoppedAt), { timeZone })
+    : undefined;
+  const metadata = [
+    `Recorded: ${started ?? "Start time unavailable"} (${timeZone})`,
+    `Ended: ${ended ?? "End time unavailable"} (${timeZone})`,
+    `Server: ${names.server ? displayName(names.server) : `Name unavailable (ID ${session.source.guildId})`}`,
+    `Voice room: ${names.room ? displayName(names.room) : `Name unavailable (ID ${session.source.channelId})`}`,
+  ].join("\n");
+  const participants = [
+    "### Recorded speakers",
+    list((summary?.participants ?? []).map(displayName)),
+  ];
+  if (!modeled) {
+    return [
+      `## ${empty ? "Recording ended — no speech captured" : "Recording saved — meeting notes unavailable"}`,
+      metadata,
+      empty
+        ? "No transcribed speech was captured, so there are no meeting notes."
+        : "I couldn’t generate reliable meeting notes. The transcript is saved; no analytical summary is being published.",
+      ...participants,
+    ].join("\n\n");
+  }
+  return [
+    `## ${displayName(summary.title)}`,
+    metadata,
+    ...(summary.coverage === "partial"
+      ? [
+          "Partial notes: the transcript exceeded the summary input limit. Some recorded discussion was not analyzed.",
+        ]
+      : []),
+    summary.overview,
+    ...participants,
+    "### Decisions",
+    list(summary.decisions),
+    "### Action items",
+    list(summary.actionItems),
+    "### Risks and open questions",
+    list(summary.risks),
+  ].join("\n\n");
+}
+
+/** Connect the existing followed-user residency to its exact native capture lifetime. */
+export function createDiscordFollowRecording(params: {
+  cfg: OpenClawConfig;
+  discordConfig: DiscordAccountConfig;
+  accountId: string;
+  client: Client;
+  readPolicy?: DiscordLivePolicyReader;
+  isActive: () => boolean;
+  stopVoiceAndDrain: (target: VoiceChannelResidency) => Promise<VoiceOperationResult | void>;
+  logger: { warn: (message: string) => void };
+}) {
+  const destination = params.discordConfig.voice?.followRecording?.summaryChannelId.trim();
+  if (!destination || params.discordConfig.voice?.followUsersEnabled === false) {
+    return undefined;
+  }
+  if (params.discordConfig.voice?.followUsers?.length !== 1) {
+    throw new Error("Discord follow recording requires exactly one followed user.");
+  }
+  let episode: FollowRecordingEpisode | undefined;
+  let desiredTarget: VoiceChannelResidency | undefined;
+  let stopped = false;
+  const finalizations = new Map<
+    FollowRecordingEpisode,
+    Promise<VoiceOperationResult | void> | undefined
+  >();
+  const readConfig = createRuntimeConfigReader(params.cfg);
+  const voiceRevision = (cfg: OpenClawConfig) =>
+    JSON.stringify({
+      enabled: cfg.channels?.discord?.enabled,
+      accountEnabled: mergeDiscordAccountConfig(cfg, params.accountId).enabled,
+      voice: mergeDiscordAccountConfig(cfg, params.accountId).voice,
+      transcripts: cfg.transcripts?.enabled,
+    });
+  const initialRevision = voiceRevision(params.cfg);
+  const isActive = () =>
+    !stopped && params.isActive() && voiceRevision(readConfig()) === initialRevision;
+  const matches = (left: VoiceChannelResidency | undefined, right: VoiceChannelResidency) =>
+    left?.guildId === right.guildId && left.channelId === right.channelId;
+  const assertActive = () => {
+    if (!isActive()) {
+      throw new Error("Discord follow recording owner is stopped.");
+    }
+  };
+  const send = async (channelId: string, text: string) => {
+    const policy = await params.readPolicy?.();
+    const assertAuthorized = () => {
+      assertActive();
+      if (policy && !policy.isCurrent()) {
+        throw new Error("Discord follow recording policy changed.");
+      }
+    };
+    assertAuthorized();
+    return sendMessageDiscord(`channel:${channelId}`, text, {
+      cfg: policy?.cfg ?? readConfig(),
+      accountId: params.accountId,
+      rest: params.client.rest,
+      allowedMentions: { parse: [] },
+      assertPlatformSendAuthorized: assertAuthorized,
+    });
+  };
+  const finish = (owned: FollowRecordingEpisode, publish: boolean) => {
+    owned.stoppedAt ??= new Date().toISOString();
+    owned.abort.abort();
+    if (owned.finishing) {
+      return owned.finishing;
+    }
+    const released = createDeferred<VoiceOperationResult | void>();
+    owned.released ??= released.promise;
+    // A leave may await full finalization rather than this earlier handoff frontier.
+    void released.promise.catch(() => {});
+    owned.finishing = (async () => {
+      // Stop live reception first. Only already-received audio retains this subscription
+      // while the native receiver joins its decoding and transcription frontier.
+      const capture = await owned.starting;
+      let result: VoiceOperationResult | void = undefined;
+      const drain = async () => {
+        if (episode === owned) {
+          result = await params.stopVoiceAndDrain(owned.target);
+        }
+      };
+      const retire = () => {
+        // Release only after native provider cleanup has fenced the exact old sink.
+        // Its pending summary retains ownership without blocking a new room visit.
+        if (episode === owned) {
+          episode = undefined;
+        }
+        owned.captureStopped = true;
+        released.resolve(result);
+      };
+      const summary = capture
+        ? await capture.finish({
+            stoppedAt: owned.stoppedAt,
+            beforeCaptureStop: drain,
+            abortSignal: owned.summaryAbort.signal,
+            onCaptureStopped: retire,
+          })
+        : (await drain(), undefined);
+      retire();
+      if (capture && publish && isActive() && !owned.publicationStarted) {
+        const source = capture.session.source;
+        if (
+          source.providerId !== "discord-voice" ||
+          source.accountId !== params.accountId ||
+          source.guildId !== owned.target.guildId ||
+          source.channelId !== owned.target.channelId ||
+          (summary && summary.sessionId !== capture.session.sessionId)
+        ) {
+          throw new Error("Discord follow recording summary does not match its capture.");
+        }
+        const names = await owned.names;
+        owned.publicationStarted = true;
+        await send(
+          destination,
+          renderMinutes({ summary, session: capture.session, names, timeZone: owned.timeZone }),
+        );
+      }
+      return result;
+    })().catch((error: unknown) => {
+      // Persistence retains the exact visit after source release. Publication
+      // failures cannot retry a send whose first chunk may already be delivered.
+      owned.finishing = undefined;
+      if (!owned.captureStopped) {
+        owned.released = undefined;
+      }
+      released.reject(error);
+      params.logger.warn(
+        `discord voice: follow recording finalization failed: ${formatErrorMessage(error)}`,
+      );
+      throw error;
+    });
+    const finalization = owned.finishing;
+    finalizations.set(owned, finalization);
+    void finalization.then(
+      () => {
+        if (finalizations.get(owned) === finalization) {
+          finalizations.delete(owned);
+          retryPending();
+        }
+      },
+      () => {
+        if (finalizations.get(owned) !== finalization) {
+          return;
+        }
+        if (owned.publicationStarted) {
+          finalizations.delete(owned);
+        } else {
+          finalizations.set(owned, undefined);
+        }
+      },
+    );
+    return owned.finishing;
+  };
+  const retryPending = () => {
+    if (!isActive()) {
+      return;
+    }
+    for (const [pending, work] of finalizations) {
+      if (!work && pending !== episode) {
+        void finish(pending, true).catch(() => {});
+      }
+    }
+  };
+  return {
+    async leave(target: { guildId: string; channelId?: string }) {
+      const selected = (value: VoiceChannelResidency | undefined) =>
+        value?.guildId === target.guildId &&
+        (!target.channelId || value.channelId === target.channelId);
+      if (selected(desiredTarget)) {
+        desiredTarget = undefined;
+      }
+      const owned = episode;
+      return owned && selected(owned.target) ? await finish(owned, true) : undefined;
+    },
+    isTargetCurrent: (target: VoiceChannelResidency) =>
+      isActive() && matches(desiredTarget, target),
+    async prepare(
+      guildId: string,
+      target: VoiceChannelResidency | undefined,
+      isCurrent: () => boolean,
+    ) {
+      if (!isCurrent() || !isActive()) {
+        return false;
+      }
+      if (target || desiredTarget?.guildId === guildId) {
+        desiredTarget = target;
+      }
+      // Retry durable notes on a new observation or a completed finalization,
+      // never a send whose first chunk may already be delivered.
+      retryPending();
+      const owned = episode;
+      // A visit that began teardown cannot be reused on a rapid same-room
+      // return, including after failed cleanup; release it before a fresh capture.
+      if (owned && (owned.stoppedAt || !matches(desiredTarget, owned.target))) {
+        const finalized = finish(owned, true);
+        await (target ? owned.released : finalized);
+      }
+      return (
+        isCurrent() && isActive() && !episode?.failed && (!target || matches(desiredTarget, target))
+      );
+    },
+    async joined(target: VoiceChannelResidency, isCurrent: () => boolean) {
+      if (!isCurrent() || !isActive() || !matches(desiredTarget, target)) {
+        return;
+      }
+      if (episode) {
+        await episode.starting;
+        return;
+      }
+      const abort = new AbortController();
+      const configuredTimeZone = readConfig().agents?.defaults?.userTimezone?.trim();
+      const owned: FollowRecordingEpisode = {
+        target,
+        abort,
+        summaryAbort: new AbortController(),
+        starting: Promise.resolve(undefined),
+        timeZone:
+          (configuredTimeZone && resolveTimezone(configuredTimeZone)) ||
+          Intl.DateTimeFormat().resolvedOptions().timeZone ||
+          "UTC",
+        names: (async () => {
+          // Snapshot verified source names on this visit, never from the notes
+          // destination, the model, or a later room's connection.
+          const [guild, channel] = await Promise.all([
+            params.client.fetchGuild(target.guildId).catch(() => undefined),
+            params.client.fetchChannel(target.channelId).catch(() => undefined),
+          ]);
+          return {
+            ...(guild?.id === target.guildId && guild.name ? { server: guild.name } : {}),
+            ...(channel?.id === target.channelId &&
+            "guildId" in channel &&
+            channel.guildId === target.guildId &&
+            "name" in channel &&
+            channel.name
+              ? { room: channel.name }
+              : {}),
+          };
+        })(),
+      };
+      episode = owned;
+      const current = () =>
+        episode === owned && !abort.signal.aborted && matches(desiredTarget, target) && isActive();
+      owned.starting = (async () => {
+        await send(
+          target.channelId,
+          "I’m recording this call. I’ll post the meeting notes and action items afterward.",
+        );
+        if (!current()) {
+          return undefined;
+        }
+        const names = await owned.names;
+        if (!current()) {
+          return undefined;
+        }
+        return await startConfiguredTranscriptCapture({
+          config: readConfig(),
+          title:
+            [
+              names.server ? `Server: ${names.server}` : undefined,
+              names.room ? `Voice room: ${names.room}` : undefined,
+            ]
+              .filter(Boolean)
+              .join(" | ") || undefined,
+          source: {
+            providerId: "discord-voice",
+            accountId: params.accountId,
+            guildId: target.guildId,
+            channelId: target.channelId,
+          },
+          abortSignal: abort.signal,
+          summaryAbortSignal: owned.summaryAbort.signal,
+          logger: params.logger,
+        });
+      })().catch(async (error: unknown) => {
+        await params.stopVoiceAndDrain(target);
+        owned.failed = true;
+        if (!abort.signal.aborted && isActive()) {
+          await send(
+            destination,
+            "I couldn’t start recording this call, so I’ve left the voice room. No audio is being recorded.",
+          );
+          params.logger.warn(
+            `discord voice: follow recording start failed: ${formatErrorMessage(error)}`,
+          );
+        }
+        return undefined;
+      });
+      await owned.starting;
+      if (!current() && episode === owned) {
+        await finish(owned, true);
+      }
+    },
+    async stop() {
+      stopped = true;
+      desiredTarget = undefined;
+      for (const pending of finalizations.keys()) {
+        pending.summaryAbort.abort();
+      }
+      episode?.summaryAbort.abort();
+      try {
+        if (episode) {
+          await finish(episode, false);
+        }
+      } finally {
+        // Drain detached notes even when the current source's cleanup fails;
+        // preserve that error and its retry custody after every owner settles.
+        const pending = [...finalizations]
+          .map(([owned, work]) => work ?? (owned === episode ? undefined : finish(owned, false)))
+          .filter((work) => work !== undefined);
+        await Promise.allSettled(pending);
+      }
+    },
+  };
+}

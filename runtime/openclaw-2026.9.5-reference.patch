+import {
+  assertMcpRequesterScopeMatches,
+  normalizeMcpRequesterScope,
+  type McpRequesterScopeContext,
+} from "../../mcp-requester-scope.js";
+import type { SubagentRunRecord } from "../registry/subagent-registry.types.js";
+
+/** Reuse the current private completion rows; legacy or mixed-owner batches grant no identity. */
+export function captureSubagentRequesterMcpScope(params: {
+  records: readonly SubagentRunRecord[];
+  requesterSessionKey: string;
+  requesterSessionId?: string;
+  assertCurrent: () => void;
+}): McpRequesterScopeContext {
+  const records = [...params.records];
+  const scope = normalizeMcpRequesterScope(records[0]?.requesterMcpScope);
+  if (
+    !scope ||
+    !params.requesterSessionId ||
+    records.length === 0 ||
+    records.some((entry) => {
+      const candidate = normalizeMcpRequesterScope(entry.requesterMcpScope);
+      return (
+        entry.requesterSessionKey !== params.requesterSessionKey ||
+        entry.completionRequesterSessionId !== params.requesterSessionId ||
+        candidate?.requesterSenderId !== scope.requesterSenderId ||
+        candidate?.agentAccountId !== scope.agentAccountId ||
+        candidate?.messageChannel !== scope.messageChannel
+      );
+    })
+  ) {
+    return {};
+  }
+  const assertCurrent = () => {
+    params.assertCurrent();
+    for (const entry of records) {
+      if (
+        entry.requesterSessionKey !== params.requesterSessionKey ||
+        entry.completionRequesterSessionId !== params.requesterSessionId
+      ) {
+        throw new Error("MCP requester completion owner changed");
+      }
+      assertMcpRequesterScopeMatches(normalizeMcpRequesterScope(entry.requesterMcpScope), scope);
+    }
+  };
+  assertCurrent();
+  return { mcpRequesterScope: scope, mcpRequesterScopeAssertCurrent: assertCurrent };
+}

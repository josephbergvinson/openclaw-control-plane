+import { expect, it, vi } from "vitest";
+import type { handleCodexConversationInboundClaim as handleInboundClaim } from "./conversation-binding-hooks.js";
+
+export function registerConversationNodeResumeTests(fixtures: {
+  getTempDir: () => string;
+  handleCodexConversationInboundClaim: (
+    event: Parameters<typeof handleInboundClaim>[0],
+    ctx: Parameters<typeof handleInboundClaim>[1],
+    options?: Omit<Parameters<typeof handleInboundClaim>[2], "bindingStore">,
+  ) => ReturnType<typeof handleInboundClaim>;
+}): void {
+  const { getTempDir, handleCodexConversationInboundClaim } = fixtures;
+
+  it("routes a programmatically bound Control UI session through node resume", async () => {
+    const tempDir = getTempDir();
+    const resumeCodexCliSessionOnNode = vi.fn(async () => ({
+      ok: true as const,
+      sessionId: "019e2007-1f7e-7eb1-a42b-8c01f4b9b5cd",
+      text: "done",
+    }));
+
+    const result = await handleCodexConversationInboundClaim(
+      {
+        content: "continue the task",
+        channel: "webchat",
+        isGroup: false,
+        commandAuthorized: true,
+        sessionKey: "node-session",
+      },
+      {
+        channelId: "webchat",
+        sessionKey: "node-session",
+        pluginBinding: {
+          bindingId: "binding-1",
+          pluginId: "codex",
+          pluginRoot: tempDir,
+          channel: "webchat",
+          accountId: "default",
+          conversationId: "node-session",
+          boundAt: Date.now(),
+          data: {
+            kind: "codex-cli-node-session",
+            version: 1,
+            nodeId: "mb-m5",
+            sessionId: "019e2007-1f7e-7eb1-a42b-8c01f4b9b5cd",
+            cwd: "/repo",
+          },
+        },
+      },
+      {
+        config: { tools: { exec: { host: "node", node: "mb-m5" } } },
+        resumeCodexCliSessionOnNode,
+        timeoutMs: 1234,
+      },
+    );
+
+    expect(result).toEqual({ handled: true, reply: { text: "done" } });
+    expect(resumeCodexCliSessionOnNode).toHaveBeenCalledWith({
+      nodeId: "mb-m5",
+      sessionId: "019e2007-1f7e-7eb1-a42b-8c01f4b9b5cd",
+      prompt: "continue the task",
+      cwd: "/repo",
+      timeoutMs: 1234,
+    });
+  });
+
+  it("carries the persisted home and explicit agent into bound node resume", async () => {
+    const tempDir = getTempDir();
+    const resumeCodexCliSessionOnNode = vi.fn(async () => ({
+      ok: true as const,
+      sessionId: "019e2007-1f7e-7eb1-a42b-8c01f4b9b5cd",
+      text: "done",
+    }));
+
+    const result = await handleCodexConversationInboundClaim(
+      {
+        content: "continue the task",
+        channel: "webchat",
+        isGroup: false,
+        commandAuthorized: true,
+        sessionKey: "node-session",
+      },
+      {
+        channelId: "webchat",
+        sessionKey: "node-session",
+        pluginBinding: {
+          bindingId: "binding-1",
+          pluginId: "codex",
+          pluginRoot: tempDir,
+          channel: "webchat",
+          accountId: "default",
+          conversationId: "node-session",
+          boundAt: Date.now(),
+          data: {
+            kind: "codex-cli-node-session",
+            version: 1,
+            nodeId: "mb-m5",
+            sessionId: "019e2007-1f7e-7eb1-a42b-8c01f4b9b5cd",
+            sourceHomeId: "a".repeat(64),
+            agentId: "specific",
+            cwd: "/repo",
+          },
+        },
+      },
+      {
+        config: { tools: { exec: { host: "node", node: "mb-m5" } } },
+        resumeCodexCliSessionOnNode,
+        timeoutMs: 1234,
+      },
+    );
+
+    expect(result).toEqual({ handled: true, reply: { text: "done" } });
+    expect(resumeCodexCliSessionOnNode).toHaveBeenCalledWith({
+      nodeId: "mb-m5",
+      sessionId: "019e2007-1f7e-7eb1-a42b-8c01f4b9b5cd",
+      prompt: "continue the task",
+      sourceHomeId: "a".repeat(64),
+      agentId: "specific",
+      cwd: "/repo",
+      timeoutMs: 1234,
+    });
+  });
+}

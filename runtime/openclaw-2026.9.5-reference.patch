+    .toSorted()) {
+    const stem = name.replace(/[^a-zA-Z0-9_-]/g, "_") || "tool";
+    const suffix = `__legacy_${shortHash(name)}`;
+    let ordinal = 0;
+    let alias: string;
+    do {
+      const uniqueSuffix = `${suffix}${ordinal === 0 ? "" : `_${ordinal}`}`;
+      alias = `${stem.slice(0, 64 - uniqueSuffix.length)}${uniqueSuffix}`;
+      ordinal += 1;
+    } while (used.has(alias));
+    used.add(alias);
+    aliases.set(name, alias);
+  }
+  return aliases;
+}

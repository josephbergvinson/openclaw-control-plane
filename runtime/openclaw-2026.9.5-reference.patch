+import { runDescendantWake } from "./subagent-announce-descendant-wake.js";
+import { sendSubagentAnnounceDirectly } from "./subagent-announce-direct-delivery.js";
+
+afterEach(() => setSubagentAnnounceDeliveryDepsForTest());
+
+it.each(
+  (["requester", "descendant"] as const).flatMap((kind) =>
+    (["current", "replaced", "cancelled"] as const).map((outcome) => ({ kind, outcome })),
+  ),
+)(
+  "$kind wake preempts optional maintenance and preserves $outcome ownership",
+  async ({ kind, outcome }) => {
+    const sessionKey = "agent:main:subagent:yielded-owner";
+    const started = createDeferred();
+    const cleanup = createDeferred();
+    const cancelMaintenance = new AbortController();
+    const cancelWake = new AbortController();
+    const owner = createSessionMaintenanceOwner({
+      sessionKey,
+      preemptible: true,
+      abortSignal: cancelMaintenance.signal,
+    });
+    const phases: string[] = [];
+    let sourceCurrent = true;
+    const maintenance = owner.track(
+      owner.run(async () => {
+        started.resolve();
+        await new Promise<void>((resolve) => {
+          owner.signal.addEventListener("abort", () => resolve(), { once: true });
+        });
+        phases.push("cleanup started");
+        await cleanup.promise;
+        phases.push("writes released");
+      }),
+    );
+    const dispatch: typeof dispatchGatewayMethodInProcess = async <T>() => {
+      phases.push("dispatch");
+      return { status: "ok", runId: "wake-run", result: { payloads: [{ text: "done" }] } } as T;
+    };
+    const gateway: typeof callGateway = async <T>() => ({}) as T;
+    const load = vi.fn(() => ({ sessionId: "requester-session", updatedAt: 1 }));
+    setSubagentAnnounceDeliveryDepsForTest({
+      getRuntimeConfig: () => ({}),
+      loadSessionEntry: load,
+      loadRequesterSessionEntry: () => ({
+        cfg: {},
+        canonicalKey: sessionKey,
+        agentId: "main",
+        entry: load(),
+      }),
+      getRequesterSessionActivity: () => ({ sessionId: "requester-session", isActive: false }),
+      dispatchGatewayMethodInProcess: dispatch,
+    });
+    await started.promise;
+    const wake =
+      kind === "requester"
+        ? sendSubagentAnnounceDirectly({
+            requesterSessionKey: sessionKey,
+            requesterAgentId: "main",
+            targetRequesterSessionKey: sessionKey,
+            requesterIsSubagent: true,
+            expectsCompletionMessage: false,
+            triggerMessage: "Continue with the child result",
+            sourceTool: "subagent_settle",
+            sourceSessionKey: "agent:main:subagent:child",
+            directIdempotencyKey: "maintenance-requester-wake",
+            isSourceSessionEffectsAllowed: () => sourceCurrent,
+            signal: cancelWake.signal,
+          })
+        : runDescendantWake({
+            runId: "nested-parent-run",
+            childSessionKey: sessionKey,
+            taskLabel: "continue the parent",
+            findings: "child result",
+            announceId: "maintenance-descendant-wake",
+            isChildSessionEffectsAllowed: () => sourceCurrent,
+            hasUsableSessionEntry: (entry): entry is Record<string, unknown> =>
+              typeof entry === "object" && entry !== null,
+            deps: {
+              getRuntimeConfig: () => ({}),
+              callGateway: gateway,
+              dispatchGatewayMethodInProcess: dispatch,
+              replaceSubagentRunAfterSteer: () => true,
+            },
+            signal: cancelWake.signal,
+          });
+    try {
+      await Promise.resolve();
+      await Promise.resolve();
+      expect(owner.signal.aborted).toBe(true);
+      expect(phases).toEqual(["cleanup started"]);
+      expect(load).not.toHaveBeenCalled();
+      sourceCurrent = outcome !== "replaced";
+      if (outcome === "cancelled") {
+        cancelWake.abort(new Error("caller cancelled"));
+      }
+      cleanup.resolve();
+      const result = await wake;
+      expect(phases).toEqual(
+        outcome === "current"
+          ? ["cleanup started", "writes released", "dispatch"]
+          : ["cleanup started", "writes released"],
+      );
+      if (kind === "descendant") {
+        expect(result).toBe(outcome === "current");
+      } else {
+        expect(result).toMatchObject({ delivered: outcome === "current" });
+      }
+    } finally {
+      cancelMaintenance.abort();
+      cleanup.resolve();
+      await maintenance;
+      await wake;
+      await waitForSessionMaintenance(sessionKey);
+      const next = createSessionMaintenanceOwner({ sessionKey, preemptible: true });
+      await next.track(next.run(async () => phases.push("next maintenance")));
+      expect(phases.at(-1)).toBe("next maintenance");
+    }
+  },
+);
+
+it("lets a private checkpoint's nested completion retain its maintenance ancestry", async () => {
+  const sessionKey = "agent:main:subagent:private-checkpoint";
+  const dispatch: typeof dispatchGatewayMethodInProcess = async <T>() =>
+    ({ status: "ok", result: { payloads: [{ text: "done" }] } }) as T;
+  setSubagentAnnounceDeliveryDepsForTest({
+    getRuntimeConfig: () => ({}),
+    loadRequesterSessionEntry: () => ({
+      cfg: {},
+      canonicalKey: sessionKey,
+      agentId: "main",
+      entry: { sessionId: "private-session", updatedAt: 1 },
+    }),
+    getRequesterSessionActivity: () => ({ sessionId: "private-session", isActive: false }),
+    dispatchGatewayMethodInProcess: dispatch,
+  });
+  const owner = createSessionMaintenanceOwner({ sessionKey, preemptible: true });
+  const result = await owner.track(
+    owner.run(async () => {
+      const delivered = await sendSubagentAnnounceDirectly({
+        requesterSessionKey: sessionKey,
+        requesterAgentId: "main",
+        targetRequesterSessionKey: sessionKey,
+        requesterIsSubagent: true,
+        expectsCompletionMessage: false,
+        triggerMessage: "Resume the private checkpoint",
+        sourceTool: "subagent_settle",
+        sourceSessionKey: "agent:main:subagent:checkpoint-child",
+        directIdempotencyKey: "private-checkpoint-wake",
+        isSourceSessionEffectsAllowed: () => !owner.signal.aborted,
+      });
+      owner.assertCurrent();
+      return delivered;
+    }),
+  );
+  expect(result).toMatchObject({ delivered: true });
+  expect(owner.signal.aborted).toBe(false);
+});

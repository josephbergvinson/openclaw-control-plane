new file mode 100644
index 0000000000000000000000000000000000000000..d9726ba840e33108f39ab9622e2e4aec1562f20d
--- /dev/null
+++ b/src/auto-reply/reply/get-reply-heartbeat-model.ts
@@ -0,0 +1,58 @@
+import { normalizeOptionalString } from "@openclaw/normalization-core/string-coerce";
+import { resolveConfiguredModelThinking } from "../../agents/model-extra-params.js";
+import { splitTrailingAuthProfile } from "../../agents/model-ref-profile.js";
+import type { ModelRef } from "../../agents/model-ref-shared.js";
+import { resolveModelRefFromString, type ModelAliasIndex } from "../../agents/model-selection.js";
+import type { OpenClawConfig } from "../../config/types.openclaw.js";
+import type { GetReplyOptions } from "../get-reply-options.types.js";
+
+/** Resolve turn-local heartbeat routing without changing the conversation model. */
+export function resolveReplyHeartbeatModel(params: {
+  cfg: OpenClawConfig;
+  agentId: string;
+  defaultProvider: string;
+  aliasIndex: ModelAliasIndex;
+  opts: GetReplyOptions | undefined;
+}): { ref: ModelRef; authProfile?: ModelRef & { profileId: string } } | undefined {
+  const { cfg, agentId, defaultProvider, aliasIndex, opts } = params;
+  if (!opts?.isHeartbeat) {
+    return undefined;
+  }
+  // An empty override preserves a task continuation's model. Otherwise prefer
+  // the runner's per-agent selection, then the global heartbeat default.
+  const raw =
+    opts.heartbeatModelOverride === ""
+      ? ""
+      : (normalizeOptionalString(opts.heartbeatModelOverride) ??
+        normalizeOptionalString(cfg.agents?.defaults?.heartbeat?.model) ??
+        "");
+  const selection = raw
+    ? resolveModelRefFromString({ cfg, agentId, raw, defaultProvider, aliasIndex })
+    : null;
+  if (!selection) {
+    return undefined;
+  }
+  const profileId = splitTrailingAuthProfile(raw).profile;
+  return {
+    ref: selection.ref,
+    authProfile: profileId ? { ...selection.ref, profileId } : undefined,
+  };
+}
+
+/** Apply model effort only after the caller has honored any native model lock. */
+export function applyHeartbeatThinkingOverride(params: {
+  cfg: OpenClawConfig;
+  provider: string;
+  model: string;
+  agentId: string;
+  hasResolvedHeartbeatModelOverride: boolean;
+  opts: GetReplyOptions | undefined;
+}): GetReplyOptions | undefined {
+  const { cfg, provider, model, agentId, hasResolvedHeartbeatModelOverride, opts } = params;
+  const thinking = hasResolvedHeartbeatModelOverride
+    ? resolveConfiguredModelThinking({ config: cfg, provider, modelId: model, agentId })
+    : undefined;
+  return thinking !== undefined && opts?.thinkingLevelOverride === undefined
+    ? { ...opts, thinkingLevelOverride: thinking }
+    : opts;
+}

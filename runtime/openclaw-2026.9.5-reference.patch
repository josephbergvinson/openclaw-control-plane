+import fs from "node:fs";
+import {
+  type JsonSchemaObject,
+  validateJsonSchemaValue,
+} from "openclaw/plugin-sdk/json-schema-runtime";
+import { beforeEach, describe, expect, it } from "vitest";
+import {
+  configureBrowserCredentialBindings,
+  listBrowserCredentialBindingMetadata,
+} from "./browser-credential-config.js";
+import { resetBrowserCredentialBindingsForTests } from "./browser-credential.test-support.js";
+import { HTTPS_BROWSER_CREDENTIAL_ORIGIN_PATTERN_SOURCE } from "./browser/credential-origin-pattern.js";
+import { normalizeActRequest } from "./browser/routes/agent.act.normalize.js";
+
+const TEST_BINDING = {
+  secret: { source: "exec", provider: "test-provider", id: "test-secret-id" },
+  allowedOrigins: ["https://auth.example.test"],
+  loginHint: "operator@example.test",
+} as const;
+
+const manifest = JSON.parse(
+  fs.readFileSync(new URL("../openclaw.plugin.json", import.meta.url), "utf8"),
+) as { configSchema: JsonSchemaObject };
+
+function readManifestHttpsCredentialOriginPattern(): string {
+  const definitions = manifest.configSchema.$defs;
+  if (!definitions || typeof definitions !== "object" || Array.isArray(definitions)) {
+    throw new Error("browser manifest schema definitions are unavailable");
+  }
+  const credentialOrigin = (definitions as Record<string, unknown>).credentialOrigin;
+  if (
+    !credentialOrigin ||
+    typeof credentialOrigin !== "object" ||
+    Array.isArray(credentialOrigin)
+  ) {
+    throw new Error("browser manifest credential origin definition is unavailable");
+  }
+  const variants = (credentialOrigin as Record<string, unknown>).anyOf;
+  const httpsVariant = Array.isArray(variants) ? variants[0] : undefined;
+  const pattern =
+    httpsVariant && typeof httpsVariant === "object" && !Array.isArray(httpsVariant)
+      ? (httpsVariant as Record<string, unknown>).pattern
+      : undefined;
+  if (typeof pattern !== "string") {
+    throw new Error("browser manifest HTTPS credential origin pattern is unavailable");
+  }
+  return pattern;
+}
+
+function manifestAccepts(value: unknown): boolean {
+  return validateJsonSchemaValue({
+    schema: manifest.configSchema,
+    cacheKey: "browser.credential-bindings.manifest-parity",
+    value,
+  }).ok;
+}
+
+describe("opaque browser credential contract", () => {
+  beforeEach(resetBrowserCredentialBindingsForTests);
+
+  it("lists model-safe binding metadata without exposing SecretRef coordinates", () => {
+    configureBrowserCredentialBindings({ credentialBindings: { account: TEST_BINDING } });
+
+    const metadata = listBrowserCredentialBindingMetadata();
+
+    expect(metadata).toEqual([
+      {
+        alias: "account",
+        allowedOrigins: ["https://auth.example.test"],
+        loginHint: "operator@example.test",
+      },
+    ]);
+    expect(JSON.stringify(metadata)).not.toContain("test-provider");
+    expect(JSON.stringify(metadata)).not.toContain("test-secret-id");
+  });
+
+  it("requires a SecretRef object and canonical credential origins", () => {
+    expect(() =>
+      configureBrowserCredentialBindings({
+        credentialBindings: { account: { ...TEST_BINDING, secret: "inline-password" } },
+      }),
+    ).toThrow(/SecretRef object/i);
+    expect(() =>
+      configureBrowserCredentialBindings({
+        credentialBindings: {
+          account: { ...TEST_BINDING, allowedOrigins: ["http://auth.example.test"] },
+        },
+      }),
+    ).toThrow(/canonical HTTPS/i);
+    expect(() =>
+      configureBrowserCredentialBindings({
+        credentialBindings: {
+          account: { ...TEST_BINDING, allowedProfiles: ["personal"] },
+        },
+      }),
+    ).toThrow(/unsupported keys/i);
+    expect(() =>
+      configureBrowserCredentialBindings({
+        credentialBindings: {
+          account: { ...TEST_BINDING, loginHint: "operator@example.test\nsecond line" },
+        },
+      }),
+    ).toThrow(/printable string/i);
+  });
+
+  it.each([

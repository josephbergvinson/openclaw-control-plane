index 0000000000000000000000000000000000000000..d32afcc4c4c28eab137841c288fa3d866b38240b
--- /dev/null
+++ b/src/gateway/message-action-delegation-source.ts
@@ -0,0 +1,58 @@
+import { z } from "zod";
+import type { AgentRuntimeMessageActionContext } from "./message-action-turn-capability.js";
+
+const identity = z.string().trim().min(1).max(1024);
+
+/** Factual authenticated source; private spawn/completion owners carry it, never tool args. */
+export const messageActionDelegationSourceSchema = z
+  .object({
+    sourceRequest: z
+      .object({
+        sessionKey: identity,
+        sessionId: identity,
+        sourceMessageId: identity,
+        requestGeneration: identity,
+      })
+      .strict(),
+    sourceLifecycleRevision: identity.optional(),
+    requesterAccountId: identity.optional(),
+    requesterSenderId: identity,
+    toolContext: z
+      .object({
+        currentChannelProvider: identity,
+        currentChannelId: identity,
+        currentMessagingTarget: identity.optional(),
+        currentGraphChannelId: identity.optional(),
+        currentChatType: z.enum(["direct", "group", "channel"]).optional(),
+        currentThreadTs: identity.optional(),
+        currentMessageId: identity,
+        currentSourceTurnId: identity,
+        replyToMode: z.enum(["off", "first", "all", "batched"]).optional(),
+        sameChannelThreadRequired: z.boolean().optional(),
+        skipCrossContextDecoration: z.boolean().optional(),
+      })
+      .strict(),
+  })
+  .strict();
+
+export type MessageActionDelegationSource = z.infer<typeof messageActionDelegationSourceSchema>;
+export type MessageActionDelegation = {
+  source: MessageActionDelegationSource;
+  /** Immediate admission only; never copied to a saved source or child capability. */
+  sourceAdmission?: AgentRuntimeMessageActionContext;
+  /** Exact source/dispatch owner; the receiving admission replaces this after adoption. */
+  assertCurrent: () => void;
+};
+
+export type MessageActionDelegationContext = { messageActionDelegation?: MessageActionDelegation };
+
+export function copyMessageActionDelegationSource(source: unknown): MessageActionDelegationSource {
+  const copy = messageActionDelegationSourceSchema.parse(source);
+  if (
+    copy.toolContext.currentMessageId !== copy.sourceRequest.sourceMessageId ||
+    copy.sourceRequest.sourceMessageId !== copy.sourceRequest.requestGeneration
+  ) {
+    throw new Error("Message action delegation source locator does not match");
+  }
+  return copy;
+}

+import { expectDefined } from "@openclaw/normalization-core";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { withTestTimeout } from "../../../test/helpers/promise.js";
+import {
+  resolveCurrentEmbeddedMessageInjectionTarget,
+  setActiveEmbeddedRun,
+  type EmbeddedAgentQueueHandle,
+} from "../../agents/embedded-agent-runner/runs.js";
+import {
+  createEmbeddedRunHandle,
+  testing as embeddedTesting,
+} from "../../agents/embedded-agent-runner/runs.test-support.js";
+import { withoutGatewayToolCallerIdentity } from "../../agents/tools/gateway-caller-context.js";
+import { IngressAdoptionLostError } from "../../channels/message/ingress-drain-state.js";
+import { rotateAgentEventLifecycleGeneration } from "../../infra/agent-events.js";
+import { registerAgentRunContext } from "../../infra/agent-run-registry.js";
+import { resetDiagnosticRunActivityForTest } from "../../logging/diagnostic-run-activity.js";
+import { createUserTurnTranscriptRecorder } from "../../sessions/user-turn-transcript.js";
+import { createTestUserTurnTranscriptTarget } from "../../sessions/user-turn-transcript.test-support.js";
+import { createDeferredCore } from "../../shared/deferred.js";
+import {
+  capture,
+  startSteer,
+  withRecoveredOwner,
+} from "./agent-runner-steer-adoption.recovery.test-support.js";
+import type { FollowupRun } from "./queue.js";
+import { createQueueTestRun } from "./queue.test-helpers.js";
+import { getExistingFollowupQueue } from "./queue/state.js";
+import { withQuestionCreator } from "./reply-run-question.test-support.js";
+import {
+  beginReplyMessageInjectionTarget,
+  finalizeReplyMessageInjectionAttempt,
+  replyRunRegistry,
+} from "./reply-run-registry.js";
+import { testing as replyTesting } from "./reply-run-registry.test-support.js";
+
+describe("channel steering into a recovered generic owner", () => {
+  afterEach(() => {
+    embeddedTesting.resetActiveEmbeddedRuns();
+    replyTesting.resetReplyRunRegistry();
+    resetDiagnosticRunActivityForTest();
+    vi.useRealTimers();
+    vi.restoreAllMocks();
+  });
+
+  it("transfers exact user input only after transcript commitment, while the recovered run remains active", async () => {
+    const key = "agent:main:recovery-commit";
+    await withRecoveredOwner(key, async ({ run, handle, fingerprint }) => {
+      const entered = createDeferredCore();
+      const committed = createDeferredCore();
+      const order: string[] = [];
+      const adopted = vi.fn(() => {
+        order.push("adopted");
+      });
+      run.turnAdoptionLifecycle = { onAdopted: adopted };
+      run.currentInboundContext = {
+        text: "Quoted graphic: stock tokens",
+        fragments: [{ kind: "conversation-data", text: "Quoted graphic: stock tokens" }],
+      };
+      const confirm = vi.fn(async () => {
+        order.push("provenance");
+      });
+      run.userTurnTranscriptRecorder = {
+        ...createUserTurnTranscriptRecorder({
+          input: { text: run.prompt },
+          target: createTestUserTurnTranscriptTarget(),
+        }),
+        confirmSteerTargetRunIdForPersistence: confirm,
+      };
+      const queue = vi.fn<
+        NonNullable<EmbeddedAgentQueueHandle["messageInjectionV2"]>["queueMessage"]
+      >(async (_text, options, assertCurrent, authorityKind) => {
+        expect(authorityKind).toBe("source-bound");
+        assertCurrent();
+        options?.onQueueAccepted?.(true);
+        entered.resolve();
+        await committed.promise;
+        assertCurrent();
+        order.push("committed");
+      });
+      expectDefined(handle.messageInjectionV2, "guarded recovery injection").queueMessage = queue;
+      expect(replyRunRegistry.get(key)).toBeUndefined();
+      const started = startSteer(key, run, fingerprint);
+      try {
+        await withTestTimeout(
+          entered.promise,
+          1_000,
+          "recovered input did not reach the guarded sink",
+        );
+        expect(adopted).not.toHaveBeenCalled();
+        expect(confirm).not.toHaveBeenCalled();
+        committed.resolve();
+        await expect(started.task).resolves.toBe("handled");
+        expect(queue).toHaveBeenCalledExactlyOnceWith(
+          run.prompt,
+          expect.objectContaining({
+            currentInboundContext: run.currentInboundContext,
+            waitForTranscriptCommit: true,
+            queueIdentity: run.messageId,
+          }),
+          expect.any(Function),
+          "source-bound",
+        );
+        expect(confirm).toHaveBeenCalledExactlyOnceWith(handle.runId);
+        expect(order).toEqual(["committed", "provenance", "adopted"]);
+        expect(started.state.admission).toEqual({ status: "accepted", mode: "steer" });
+        expect(started.followup).not.toHaveBeenCalled();
+        expect(getExistingFollowupQueue(key)?.items ?? []).toEqual([]);
+      } finally {
+        committed.resolve();
+      }
+    });
+  });
+
+  it.each([
+    "replacement",
+    "revoked",
+    "generation",
+    "caller",
+    "fingerprint",
+    "source-mode",
+    "task-mode",
+    "images",
+    "context",
+    "commit",
+  ] as const)("revalidates %s at the V2 effect after awaited preparation", async (change) => {
+    const key = `agent:main:recovery-${change}`;
+    await withRecoveredOwner(key, async ({ run, handle, fingerprint, revoke }) => {
+      const entered = createDeferredCore();
+      const release = createDeferredCore();
+      const effect = vi.fn();
+      let callerCurrent = true;
+      expectDefined(handle.messageInjectionV2, "guarded recovery injection").queueMessage = async (
+        _text,
+        _options,
+        assertCurrent,
+      ) => {
+        entered.resolve();
+        await release.promise;
+        assertCurrent();
+        effect();
+      };
+      const target = capture(key, run);
+      const attempt = beginReplyMessageInjectionTarget(target, run.prompt, {
+        isInboundUserMessage: true,
+        toolAuthorityFingerprint: fingerprint,
+        assertCurrent: () => {
+          if (!callerCurrent) {
+            throw new Error("caller revoked");
+          }
+        },
+      });
+      await withTestTimeout(
+        entered.promise,
+        1_000,
+        "recovered input did not reach the guarded sink",
+      );
+      if (change === "replacement") {
+        // An unbound successor is still a distinct owner and must never receive this input.
+        withoutGatewayToolCallerIdentity(() =>
+          setActiveEmbeddedRun(
+            run.run.sessionId,
+            createEmbeddedRunHandle({ runId: "successor" }),
+            key,
+          ),
+        );
+      } else if (change === "revoked") {
+        revoke();
+      } else if (change === "generation") {
+        rotateAgentEventLifecycleGeneration();
+      } else if (change === "caller") {
+        callerCurrent = false;
+      } else if (change === "fingerprint") {
+        handle.toolAuthorityFingerprint = "changed-authority";
+      } else if (change === "source-mode") {
+        handle.sourceReplyDeliveryMode = "message_tool_only";
+      } else if (change === "task-mode") {
+        handle.taskSuggestionDeliveryMode = "gateway";
+      } else if (change === "images") {
+        handle.supportsQueueMessageImages = false;
+      } else if (change === "context") {
+        handle.supportsQueueMessageContext = false;
+      } else {
+        handle.supportsTranscriptCommitWait = false;
+      }
+      release.resolve();
+      await expect(attempt.outcome).resolves.toMatchObject({ status: "failed" });
+      expect(effect).not.toHaveBeenCalled();
+    });
+  });
+
+  it("never derives injection authority from a wrong key, unbound registration, or V1 sink", async () => {
+    const key = "agent:main:recovery-authority";
+    await withRecoveredOwner(key, async ({ run, handle }) => {
+      expect(
+        resolveCurrentEmbeddedMessageInjectionTarget({
+          sessionId: run.run.sessionId,
+          sessionKey: `${key}-other`,
+        }),
+      ).toBeUndefined();
+      handle.messageInjectionV2 = undefined;
+      expect(
+        resolveCurrentEmbeddedMessageInjectionTarget({
+          sessionId: run.run.sessionId,
+          sessionKey: key,
+        }),
+      ).toBeUndefined();
+    });
+    const handle = createEmbeddedRunHandle({ runId: "unbound" });
+    handle.messageInjectionV2 = {
+      version: 2,
+      isAvailable: () => true,
+      queueMessage: async () => {},
+    };
+    setActiveEmbeddedRun("unbound", handle, key);
+    expect(
+      resolveCurrentEmbeddedMessageInjectionTarget({ sessionId: "unbound", sessionKey: key }),
+    ).toBeUndefined();
+  });
+
+  it("keeps the registered reply operation as the injection owner", async () => {
+    const key = "agent:main:reply-owner";
+    const run = createQueueTestRun({ prompt: "ordinary followup", messageId: "ordinary" });
+    await withQuestionCreator(key, run, async (operation, fingerprint) => {
+      const queue = vi.fn<
+        NonNullable<EmbeddedAgentQueueHandle["messageInjectionV2"]>["queueMessage"]
+      >(async (_text, _options, assertCurrent) => assertCurrent());
+      const handle = {
+        ...createEmbeddedRunHandle({
+          runId: "accepted-backing-work",
+          toolAuthorityFingerprint: fingerprint,
+        }),
+        kind: "embedded" as const,
+        cancel: vi.fn(),
+        messageInjectionV2: { version: 2 as const, isAvailable: () => true, queueMessage: queue },
+      };
+      operation.attachBackend(handle);
+      operation.setPhase("running");
+      setActiveEmbeddedRun(run.run.sessionId, handle, key, run.run.sessionFile, "main");
+      expect(
+        resolveCurrentEmbeddedMessageInjectionTarget({
+          sessionId: run.run.sessionId,
+          sessionKey: key,
+        }),
+      ).toBeUndefined();
+      const started = startSteer(key, run, fingerprint);
+      await expect(started.task).resolves.toBe("handled");
+      expect(queue).toHaveBeenCalledOnce();
+      expect(started.state.admission).toEqual({ status: "accepted", mode: "steer" });
+    });
+  });
+
+  it.each(["hidden", "authority", "context", "commit", "compacting", "stale"] as const)(
+    "retains ordered followup fallback when the recovered owner rejects %s",
+    async (failure) => {
+      const key = `agent:main:recovery-fallback-${failure}`;
+      await withRecoveredOwner(key, async ({ run, handle, fingerprint }) => {
+        if (failure === "hidden") {
+          registerAgentRunContext(expectDefined(handle.runId, "recovery run id"), {
+            isControlUiVisible: false,
+            projectSessionMessages: false,
+          });
+        }
+        if (failure === "context") {
+          run.currentInboundContext = { text: "quoted graphic" };
+          handle.supportsQueueMessageContext = false;
+        }
+        if (failure === "commit") {
+          handle.supportsTranscriptCommitWait = false;
+        }
+        if (failure === "compacting") {
+          handle.isCompacting = () => true;
+        }
+        if (failure === "stale") {
+          vi.spyOn(Date, "now").mockReturnValue(Date.now() + 10 * 60_000 + 1);
+        }
+        const queue = vi.fn<
+          NonNullable<EmbeddedAgentQueueHandle["messageInjectionV2"]>["queueMessage"]
+        >(async () => {});
+        expectDefined(handle.messageInjectionV2, "guarded recovery injection").queueMessage = queue;
+        const firstEntered = createDeferredCore();
+        const releaseFirst = createDeferredCore();
+        const followup = vi.fn(async (next: FollowupRun) => {
+          if (next.messageId === run.messageId) {
+            firstEntered.resolve();
+            await releaseFirst.promise;
+          }
+        });
+        if (failure === "authority") {
+          run.disableTools = true;
+        }
+        try {
+          const first = startSteer(key, run, fingerprint, followup);
+          await first.task;
+          expect(first.state.admission).toEqual({ status: "accepted", mode: "followup" });
+          expect(queue).not.toHaveBeenCalled();
+          await withTestTimeout(
+            firstEntered.promise,
+            1_000,
+            "fallback did not reach the ordered drain",
+          );
+          const secondRun = { ...run, prompt: "second correction", messageId: "second" };
+          const second = startSteer(key, secondRun, fingerprint, followup);
+          await second.task;
+          expect(followup).toHaveBeenCalledOnce();
+          releaseFirst.resolve();
+          await vi.waitFor(() => expect(followup).toHaveBeenCalledTimes(2));
+          expect(followup.mock.calls.map(([next]) => next.prompt)).toEqual([
+            run.prompt,
+            secondRun.prompt,
+          ]);
+        } finally {
+          releaseFirst.resolve();
+        }
+      });
+    },
+  );
+
+  it("consumes cancellation before admission without steering or replay", async () => {
+    const key = "agent:main:recovery-cancel";
+    await withRecoveredOwner(key, async ({ run, handle, fingerprint }) => {
+      const cancellation = new AbortController();
+      run.abortSignal = cancellation.signal;
+      cancellation.abort();
+      const queue = vi.fn<
+        NonNullable<EmbeddedAgentQueueHandle["messageInjectionV2"]>["queueMessage"]
+      >(async () => {});
+      expectDefined(handle.messageInjectionV2, "guarded recovery injection").queueMessage = queue;
+      const started = startSteer(key, run, fingerprint);
+      await expect(started.task).resolves.toBe("handled");
+      expect(queue).not.toHaveBeenCalled();
+      expect(started.followup).not.toHaveBeenCalled();
+      expect(getExistingFollowupQueue(key)?.items ?? []).toEqual([]);
+    });
+  });
+
+  it.each(["unconfirmed", "adoption-lost"] as const)(
+    "aborts only the captured handle after accepted %s custody",
+    async (failure) => {
+      const key = `agent:main:recovery-custody-${failure}`;
+      await withRecoveredOwner(key, async ({ run, handle, fingerprint }) => {
+        const abort = vi.fn();
+        handle.abort = abort;
+        expectDefined(handle.messageInjectionV2, "guarded recovery injection").queueMessage =
+          async (_text, options, assertCurrent) => {
+            assertCurrent();
+            options?.onQueueAccepted?.(true);
+            return failure === "unconfirmed"
+              ? { transcriptCommit: "unconfirmed", errorMessage: "commit receipt unavailable" }
+              : undefined;
+          };
+        const target = capture(key, run);
+        const attempt = beginReplyMessageInjectionTarget(target, run.prompt, {
+          isInboundUserMessage: true,
+          toolAuthorityFingerprint: fingerprint,

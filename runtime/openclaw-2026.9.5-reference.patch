@@ -0,0 +1,109 @@
+/** Private, pipe-only bootstrap auth for the signed Mac app's local connection. */
+import fs from "node:fs";
+import path from "node:path";
+import { isDeepStrictEqual } from "node:util";
+import { requestExitAfterOneShotOutput } from "../cli/one-shot-exit.js";
+import { readConfigFileSnapshot } from "../config/config.js";
+import type { ConfigFileSnapshot } from "../config/types.js";
+import { resolveGatewayInteractiveSurfaceAuth } from "../gateway/auth-surface-resolution.js";
+import { runExec } from "../process/exec.js";
+import { isRecord } from "../utils.js";
+
+const MAX_FRAME_BYTES = 32 * 1024;
+const UNAVAILABLE = "Local Gateway credentials could not be resolved.";
+
+async function verifyNativeParent(): Promise<string> {
+  if (process.platform !== "darwin") {
+    throw new Error(UNAVAILABLE);
+  }
+  let bundle = path.dirname(fs.realpathSync.native(process.execPath));
+  while (!bundle.endsWith(".app") && path.dirname(bundle) !== bundle) {
+    bundle = path.dirname(bundle);
+  }
+  if (!bundle.endsWith(".app")) {
+    throw new Error(UNAVAILABLE);
+  }
+  const result = await runExec(
+    path.join(bundle, "Contents/MacOS/openclaw-mac"),
+    ["_verify-local-auth-parent"],
+    { timeoutMs: 15000, maxBuffer: 1024, logOutput: false },
+  );
+  const identity = result.stdout.trim();
+  if (!/^\d+:\d+:\d+:[a-f0-9]{40}$/.test(identity)) {
+    throw new Error(UNAVAILABLE);
+  }
+  return identity;
+}
+
+export async function resolveLocalGatewayAuth(
+  request: unknown,
+  snapshot: ConfigFileSnapshot,
+  env: NodeJS.ProcessEnv,
+): Promise<{ token?: string; password?: string }> {
+  const parsed = snapshot.parsed;
+  if (
+    !isRecord(request) ||
+    request.version !== 1 ||
+    !snapshot.valid ||
+    !isRecord(parsed) ||
+    !isRecord(parsed.gateway) ||
+    parsed.gateway.mode === "remote" ||
+    (parsed.gateway.mode !== "local" &&
+      isRecord(parsed.gateway.remote) &&
+      typeof parsed.gateway.remote.url === "string" &&
+      parsed.gateway.remote.url.trim() !== "") ||
+    !isDeepStrictEqual(parsed.gateway.auth, request.auth)
+  ) {
+    throw new Error(UNAVAILABLE);
+  }
+  const auth = await resolveGatewayInteractiveSurfaceAuth({
+    config: snapshot.config,
+    env,
+    surface: "local",
+  });
+  if (auth.failureReason || (!auth.token && !auth.password)) {
+    // Provider errors may contain secret material. Never relay their diagnostics.
+    throw new Error(UNAVAILABLE);
+  }
+  return { token: auth.token, password: auth.password };
+}
+
+export async function runLocalGatewayAuth(): Promise<void> {
+  try {
+    // This is app IPC, never terminal output or a credential export file.
+    if (!fs.fstatSync(0).isFIFO() || !fs.fstatSync(1).isFIFO()) {
+      throw new Error(UNAVAILABLE);
+    }
+    const parentIdentity = await verifyNativeParent();
+    const chunks: Buffer[] = [];
+    let size = 0;
+    for await (const chunk of process.stdin) {
+      const bytes = Buffer.from(chunk);
+      size += bytes.length;
+      if (size > MAX_FRAME_BYTES) {
+        throw new Error(UNAVAILABLE);
+      }
+      chunks.push(bytes);
+    }
+    const request: unknown = JSON.parse(Buffer.concat(chunks).toString("utf8"));
+    const snapshot = await readConfigFileSnapshot();
+    const auth = await resolveLocalGatewayAuth(request, snapshot, process.env);
+    // A provider may suspend. Do not return credentials against an edited config.
+    const current = await readConfigFileSnapshot();
+    if (!current.valid || !isDeepStrictEqual(current.sourceConfig, snapshot.sourceConfig)) {
+      throw new Error(UNAVAILABLE);
+    }
+    const output = JSON.stringify({ version: 1, ...auth });
+    if (Buffer.byteLength(output) > MAX_FRAME_BYTES) {
+      throw new Error(UNAVAILABLE);
+    }
+    if ((await verifyNativeParent()) !== parentIdentity) {
+      throw new Error(UNAVAILABLE);
+    }
+    process.stdout.write(`${output}\n`);
+  } catch {
+    process.exitCode = 1;
+    // Neither stdout nor stderr exposes secret values or provider errors.
+  }
+  requestExitAfterOneShotOutput();
+}

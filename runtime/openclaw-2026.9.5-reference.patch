diff --git a/test/scripts/tsdown-process.test.ts b/test/scripts/tsdown-process.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..62c950569063fe072c11054eccb5be2ac010f15a
--- /dev/null
+++ b/test/scripts/tsdown-process.test.ts
@@ -0,0 +1,142 @@
+import { ChildProcess } from "node:child_process";
+import { once } from "node:events";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { PassThrough } from "node:stream";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { runTsdownBuildInvocation } from "../../scripts/tsdown-build.mts";
+import { createDeferred } from "../helpers/promise.js";
+import { createScriptTestHarness } from "./test-helpers.js";
+
+const mocks = vi.hoisted(() => ({
+  spawn: vi.fn(),
+  inspect: vi.fn(),
+  terminate: vi.fn(),
+  wait: vi.fn(),
+}));
+vi.mock("node:child_process", async (original) => ({
+  ...(await original<typeof import("node:child_process")>()),
+  spawn: mocks.spawn,
+}));
+vi.mock("../../scripts/lib/managed-child-process.mts", async (original) => ({
+  ...(await original<typeof import("../../scripts/lib/managed-child-process.mts")>()),
+  inspectManagedProcessGroup: mocks.inspect,
+  terminateManagedChild: mocks.terminate,
+  waitForManagedProcessGroupExit: mocks.wait,
+}));
+const { createTempDir } = createScriptTestHarness();
+const quiet = { write() {} };
+afterEach(() => vi.restoreAllMocks());
+beforeEach(() => {
+  mocks.spawn.mockReset();
+  mocks.inspect.mockReset().mockReturnValue("dead");
+  mocks.terminate.mockReset();
+  mocks.wait.mockReset().mockResolvedValue(false);
+});
+
+async function startChild() {
+  const root = createTempDir("tsdown-process-admission-");
+  vi.spyOn(os, "homedir").mockReturnValue(root);
+  vi.spyOn(os, "totalmem").mockReturnValue(16 * 1024 ** 3);
+  const child = new ChildProcess();
+  const stdout = new PassThrough();
+  const stderr = new PassThrough();
+  Object.defineProperties(child, {
+    pid: { value: 123456 },
+    stdout: { value: stdout },
+    stderr: { value: stderr },
+  });
+  const ready = createDeferred();
+  mocks.spawn.mockImplementation(() => {
+    ready.resolve();
+    return child;
+  });
+  const command = {
+    command: "fixture",
+    args: [],
+    options: { stdio: ["ignore", "pipe", "pipe"], shell: false, env: {} },
+  };
+  const completion = runTsdownBuildInvocation(command, { stdout: quiet, stderr: quiet });
+  await ready.promise;
+  return {
+    child,
+    stdout,
+    stderr,
+    command,
+    completion,
+    owner: path.join(root, ".cache", "openclaw-local-checks", "owner.json"),
+  };
+}
+
+async function closeOutput(fixture: Awaited<ReturnType<typeof startChild>>) {
+  const closing = Promise.all([once(fixture.stdout, "close"), once(fixture.stderr, "close")]);
+  fixture.stdout.destroy();
+  fixture.stderr.destroy();
+  await closing;
+}
+
+describe("tsdown lease release", () => {
+  it("requires child close, both output pipes closed and an explicitly dead process group", async () => {
+    const fixture = await startChild();
+    fixture.child.emit("exit", 0, null);
+    expect(fs.existsSync(fixture.owner)).toBe(true);
+    await closeOutput(fixture);
+    expect(fs.existsSync(fixture.owner)).toBe(true);
+    fixture.child.emit("close", 0, null);
+    await expect(fixture.completion).resolves.toMatchObject({ status: 0, error: null });
+    expect(fs.existsSync(fixture.owner)).toBe(false);
+  });
+
+  it.each(["indeterminate", "live", "open output"])(
+    "retains admission when cleanup is %s",
+    async (state) => {
+      const fixture = await startChild();
+      mocks.inspect.mockReturnValue(state === "open output" ? "dead" : state);
+      if (state !== "open output") {
+        await closeOutput(fixture);
+      }
+      fixture.child.emit("close", 0, null);
+      await expect(fixture.completion).resolves.toMatchObject({
+        status: 1,
+        error: { code: "EPROCESSGROUP_CLEANUP_FAILED" },
+      });
+      expect(fs.existsSync(fixture.owner)).toBe(true);
+      await expect(runTsdownBuildInvocation(fixture.command)).rejects.toMatchObject({
+        code: "ELOCAL_CHECK_BUSY",
+      });
+      expect(mocks.spawn).toHaveBeenCalledOnce();
+      if (state === "open output") {
+        await closeOutput(fixture);
+      }
+    },
+  );
+
+  it("retains admission if a later census reveals a survivor", async () => {
+    const fixture = await startChild();
+    await closeOutput(fixture);
+    mocks.inspect.mockReturnValueOnce("dead").mockReturnValue("live");
+    fixture.child.emit("close", 0, null);
+    await expect(fixture.completion).resolves.toMatchObject({
+      error: { processTreeState: "live" },
+    });
+    expect(fs.existsSync(fixture.owner)).toBe(true);
+  });
+
+  it("joins a published child after an error and preserves its original diagnostic", async () => {
+    const fixture = await startChild();
+    const error = Object.assign(new Error("child failed after starting"), { code: "EIO" });
+    fixture.stdout.write("[INEFFECTIVE_DYNAMIC_IMPORT]\n");
+    fixture.child.emit("error", error);
+    expect(fs.existsSync(fixture.owner)).toBe(true);
+    await expect(runTsdownBuildInvocation(fixture.command)).rejects.toMatchObject({
+      code: "ELOCAL_CHECK_BUSY",
+    });
+    await closeOutput(fixture);
+    fixture.child.emit("close", 0, null);
+    const result = await fixture.completion;
+    expect(result.error).toBe(error);
+    expect(result).toMatchObject({ status: 1, hasIneffectiveDynamicImport: true });
+    expect(fs.existsSync(fixture.owner)).toBe(false);
+  });
+});

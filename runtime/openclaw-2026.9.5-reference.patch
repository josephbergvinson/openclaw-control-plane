+import { execFileSync, spawn, type ChildProcess } from "node:child_process";
+import { once } from "node:events";
+import fs from "node:fs";
+import { createRequire } from "node:module";
+import path from "node:path";
+import { describe, expect, it, vi } from "vitest";
+import { runManagedCommand } from "../../scripts/lib/managed-child-process.mts";
+import * as darwinSession from "../../scripts/lib/managed-darwin-session.mts";
+import {
+  captureManagedDarwinSession,
+  createDarwinProcessApi,
+  loadDarwinProcessApi,
+  type DarwinProcessIdentity,
+} from "../../scripts/lib/managed-darwin-session.mts";
+import { createVitestResourceOwner } from "../../scripts/lib/vitest-resource-ownership.mts";
+import { waitForFile } from "../helpers/process-wait.js";
+import { createScriptTestHarness } from "./test-helpers.js";
+
+const { createTempDir } = createScriptTestHarness();
+
+it.skipIf(process.platform !== "darwin")(
+  "uses a caller's verified native API without loading the source checkout addon",
+  async () => {
+    const api = loadDarwinProcessApi();
+    const fallback = vi.spyOn(darwinSession, "loadDarwinProcessApi").mockImplementation(() => {
+      throw new Error("source native addon must not load in a signed package proof");
+    });
+    const identity = vi.spyOn(api, "identity");
+    let output = "";
+    try {
+      const exit = await runManagedCommand({
+        bin: process.execPath,
+        args: ["-e", "process.stdout.write('caller-native-api-ready')"],
+        requireProcessTreeExit: true,
+        darwinProcessApi: api,
+        stdio: ["ignore", "pipe", "pipe"],
+        onReady(child) {
+          child.stdout?.on("data", (data) => {
+            output += data.toString();
+          });
+        },
+      });
+      expect(exit).toBe(0);
+      expect(output).toBe("caller-native-api-ready");
+      expect(identity).toHaveBeenCalled();
+      expect(fallback).not.toHaveBeenCalled();
+    } finally {
+      identity.mockRestore();
+      fallback.mockRestore();
+    }
+  },
+);
+
+const rootIdentity: DarwinProcessIdentity = {
+  pid: 200,
+  ppid: 100,
+  pgid: 200,
+  sid: 200,
+  startSec: 1000n,
+  startUsec: 123n,
+};
+const leafIdentity: DarwinProcessIdentity = {
+  pid: 300,
+  ppid: 200,
+  pgid: 300,
+  sid: 200,
+  startSec: 1000n,
+  startUsec: 124n,
+};
+
+function fakeApi() {
+  const identities = new Map([
+    [200, rootIdentity],
+    [300, leafIdentity],
+  ]);
+  return {
+    identities,
+    identity: vi.fn((pid: number) => {
+      const identity = identities.get(pid);
+      return identity ? { state: "live" as const, identity } : { state: "missing" as const };
+    }),
+    census: vi.fn(() => [...identities.keys()]),
+    signal: vi.fn((pid: number) => {
+      return identities.delete(pid);
+    }),
+  };
+}
+
+describe("owned Darwin sessions", () => {
+  it("signals a reparented same-session child in another group before certifying retirement", () => {
+    const api = fakeApi();
+    const session = captureManagedDarwinSession(api, 200, 100);
+    api.identities.delete(200);
+    api.identities.set(300, { ...leafIdentity, ppid: 1 });
+    expect(session.inspect(Date.now() + 1000)).toEqual({ state: "live", survivingPids: [300] });
+    expect(session.signal("SIGKILL", Date.now() + 1000)).toEqual({
+      state: "dead",
+      signaledPids: [300],
+    });
+    expect(api.signal).toHaveBeenCalledExactlyOnceWith(300, "SIGKILL");
+  });
+
+  it("latches an empty certificate instead of signaling a reused numeric session/group", () => {
+    const api = fakeApi();
+    const session = captureManagedDarwinSession(api, 200, 100);
+    api.identities.clear();
+    expect(session.inspect(Date.now() + 1000)).toEqual({ state: "dead" });
+    api.identities.set(200, { ...rootIdentity, startUsec: 999n });
+    expect(session.signal("SIGKILL", Date.now() + 1000)).toEqual({ state: "dead" });
+    expect(api.signal).not.toHaveBeenCalled();
+  });
+
+  it("refuses a changed root incarnation before any session signal", () => {
+    const api = fakeApi();
+    const session = captureManagedDarwinSession(api, 200, 100);
+    api.identities.set(200, { ...rootIdentity, startUsec: 999n });
+    expect(session.signal("SIGTERM", Date.now() + 1000).state).toBe("indeterminate");
+    expect(api.signal).not.toHaveBeenCalled();
+  });
+
+  it("revalidates a child incarnation immediately before its exact PID signal", () => {
+    const api = fakeApi();
+    const session = captureManagedDarwinSession(api, 200, 100);
+    let leafQueries = 0;
+    api.identity.mockImplementation((pid) => {
+      const identity = api.identities.get(pid);
+      if (pid === 300 && ++leafQueries === 2) {
+        return { state: "live", identity: { ...leafIdentity, startUsec: 999n } };
+      }
+      return identity ? { state: "live", identity } : { state: "missing" };
+    });
+    expect(session.signal("SIGKILL", Date.now() + 1000).state).toBe("indeterminate");
+    expect(api.signal).not.toHaveBeenCalled();
+  });
+
+  it("retains successful signal delivery when a later member signal fails", () => {
+    const api = fakeApi();
+    const session = captureManagedDarwinSession(api, 200, 100);
+    api.signal.mockImplementation((pid) => {
+      if (pid === 200) {
+        throw new Error("EPERM");
+      }
+      return api.identities.delete(pid);
+    });
+    expect(session.signal("SIGKILL", Date.now() + 1000)).toMatchObject({
+      state: "indeterminate",
+      signaledPids: [300],
+    });
+  });
+
+  it("retains successful signal delivery when its later census is indeterminate", () => {
+    const api = fakeApi();
+    const session = captureManagedDarwinSession(api, 200, 100);
+    api.census.mockReturnValueOnce([200, 300]).mockImplementationOnce(() => {
+      throw new Error("Transient census uncertainty");
+    });
+    expect(session.signal("SIGKILL", Date.now() + 1000)).toMatchObject({
+      state: "indeterminate",
+      signaledPids: [300, 200],
+    });
+    expect(session.inspect(Date.now() + 1000)).toEqual({ state: "dead" });
+  });
+
+  it("does not record an ESRCH signal race as successful cleanup delivery", () => {
+    const api = fakeApi();
+    const session = captureManagedDarwinSession(api, 200, 100);
+    api.signal.mockImplementation((pid) => {
+      api.identities.delete(pid);
+      return false;
+    });
+    expect(session.signal("SIGKILL", Date.now() + 1000)).toEqual({ state: "dead" });
+  });
+
+  it.each(["capture", "census", "member"])(
+    "keeps %s observation failures unverified and unsignaled",
+    (failure) => {
+      const api = fakeApi();
+      if (failure === "capture") {
+        api.identity.mockImplementation(() => {
+          throw new Error("EPERM");
+        });
+      }
+      const session = captureManagedDarwinSession(api, 200, 100);
+      if (failure === "census") {
+        api.census.mockImplementation(() => {
+          throw new Error("truncated census");
+        });
+      }
+      if (failure === "member") {
+        api.identity.mockImplementation((pid) => {
+          if (pid === 300) {
+            throw new Error("short identity query");
+          }
+          return { state: "live", identity: rootIdentity };
+        });
+      }
+      expect(session.signal("SIGKILL", Date.now() + 1000).state).toBe("indeterminate");
+      expect(api.signal).not.toHaveBeenCalled();
+    },
+  );
+
+  it("does not use members of an uncaptured exited leader as signaling authority", () => {
+    const api = fakeApi();
+    api.identities.delete(200);
+    const session = captureManagedDarwinSession(api, 200, 100);

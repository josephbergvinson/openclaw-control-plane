new file mode 100644
index 0000000000000000000000000000000000000000..72a1147b067018574d68d01766f85414d3cbe895
--- /dev/null
+++ b/src/commands/tasks.notify.test.ts
@@ -0,0 +1,94 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { useTaskGatewayFixture } from "../gateway/server-methods/tasks.fixture.test-support.js";
+import {
+  runTaskHandler,
+  createSnapshotTask,
+} from "../gateway/server-methods/tasks.test-helpers.js";
+import { captureOpenClawStateWorkerContext } from "../state/openclaw-state-worker-context.js";
+import { getTaskById } from "../tasks/runtime-internal.js";
+import { createAcpTaskBackingDetailForTest } from "../tasks/task-backing-authority.test-support.js";
+import { reloadTaskRegistryFromStoreAsync } from "../tasks/task-registry-state.js";
+import { seedTaskRegistryRowsForTests } from "../test-utils/task-registry-sqlite.js";
+import { tasksNotifyCommand } from "./tasks.js";
+import { createTestRuntime } from "./test-runtime-config-helpers.js";
+
+const { callGateway } = vi.hoisted(() => ({ callGateway: vi.fn() }));
+vi.mock("../gateway/call.js", () => ({ callGateway }));
+const { cancelSessionMock } = useTaskGatewayFixture();
+
+async function seedActiveTask() {
+  const task = createSnapshotTask({
+    taskId: "notify-resident-task",
+    runtime: "acp",
+    runId: "notify-resident-run",
+    childSessionKey: "agent:main:acp:notify",
+    agentId: "main",
+    detail: createAcpTaskBackingDetailForTest("notify-resident-instance"),
+  });
+  seedTaskRegistryRowsForTests([task]);
+  await reloadTaskRegistryFromStoreAsync(captureOpenClawStateWorkerContext());
+  return task;
+}
+
+beforeEach(() => {
+  callGateway.mockReset();
+});
+
+describe("task notification commands use the resident Gateway owner", () => {
+  it.each(["silent", "state_changes", "done_only"] as const)(
+    "keeps acknowledged %s policy through a subsequent cancellation and reload",
+    async (notify) => {
+      const task = await seedActiveTask();
+      callGateway.mockImplementation(async ({ method, params }) => {
+        expect(method).toBe("tasks.notify");
+        const result = await runTaskHandler("tasks.notify", params);
+        expect(result.calls[0]?.[0]).toBe(true);
+        return result.payload;
+      });
+      const runtime = createTestRuntime();
+      await tasksNotifyCommand({ lookup: task.runId!, notify }, runtime);
+      expect(callGateway).toHaveBeenCalledExactlyOnceWith({
+        method: "tasks.notify",
+        params: { taskId: task.taskId, notifyPolicy: notify },
+        timeoutMs: 15_000,
+      });
+      expect(runtime.error).not.toHaveBeenCalled();
+      expect(runtime.log).toHaveBeenCalledExactlyOnceWith(
+        `Updated ${task.taskId} notify policy to ${notify}.`,
+      );
+      expect(getTaskById(task.taskId)?.notifyPolicy).toBe(notify);
+      cancelSessionMock.mockResolvedValue(undefined);
+      const result = await runTaskHandler("tasks.cancel", { taskId: task.taskId });
+      expect(result.payload).toMatchObject({ found: true, cancelled: true });
+      await reloadTaskRegistryFromStoreAsync(captureOpenClawStateWorkerContext());
+      expect(getTaskById(task.taskId)).toMatchObject({ status: "cancelled", notifyPolicy: notify });
+    },
+  );
+
+  it("does not fall back to a local mutation when the Gateway is unavailable", async () => {
+    const task = await seedActiveTask();
+    callGateway.mockRejectedValue(new Error("gateway unavailable"));
+    const runtime = createTestRuntime();
+    await tasksNotifyCommand({ lookup: task.taskId, notify: "silent" }, runtime);
+    expect(runtime.exit).toHaveBeenCalledExactlyOnceWith(1);
+    expect(runtime.error).toHaveBeenCalledWith(expect.stringContaining("gateway unavailable"));
+    expect(runtime.log).not.toHaveBeenCalled();
+    await reloadTaskRegistryFromStoreAsync(captureOpenClawStateWorkerContext());
+    expect(getTaskById(task.taskId)).toEqual(task);
+  });
+
+  it("does not report success for an inaccessible or mismatched Gateway acknowledgement", async () => {
+    const task = await seedActiveTask();
+    for (const response of [
+      { found: false },
+      { found: true, taskId: "other", notifyPolicy: "silent" },
+    ]) {
+      callGateway.mockResolvedValue(response);
+      const runtime = createTestRuntime();
+      await tasksNotifyCommand({ lookup: task.taskId, notify: "silent" }, runtime);
+      expect(runtime.exit).toHaveBeenCalledExactlyOnceWith(1);
+      expect(runtime.log).not.toHaveBeenCalled();
+      expect(getTaskById(task.taskId)).toEqual(task);
+    }
+  });
+});

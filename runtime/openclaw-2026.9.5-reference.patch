+} from "./agent-bundle-mcp-runtime-owner.js";
+import type { McpToolCatalog, SessionMcpRuntime } from "./agent-bundle-mcp-types.js";
+import { requesterMcpOAuthIdentity } from "./mcp-oauth-identity.js";
+import { updateMcpOAuthStore } from "./mcp-oauth-store.js";
+import { readMcpOAuthCredentialsStatus, readMcpOAuthCredentialsStatusSync } from "./mcp-oauth.js";
+import { withTempHome } from "./mcp-oauth.test-harness.js";
+import type { AnyAgentTool } from "./tools/common.js";
+
+const scope = { requesterSenderId: "alice", messageChannel: "discord", agentAccountId: "bot" };
+const serverUrl = "https://mcp.example.test/rpc";
+const identity = requesterMcpOAuthIdentity("finance", serverUrl, scope);
+const tempOptions = {
+  prefix: "openclaw-mcp-steering-",
+  skipSessionCleanup: true,
+  env: { OPENCLAW_CONFIG_PATH: undefined, OPENCLAW_STATE_DIR: undefined },
+};
+
+function fixture(serverName = "finance") {
+  const state: { catalog: McpToolCatalog | null; current: boolean } = {
+    current: true,
+    catalog: {
+      version: 1,
+      generatedAt: 1,
+      servers: {
+        [serverName]: {
+          serverName,
+          safeServerName: serverName,
+          launchSummary: "fixture",
+          toolCount: 1,
+        },
+      },
+      tools: [
+        {
+          serverName,
+          safeServerName: serverName,
+          toolName: "query",
+          inputSchema: Type.Object({ account: Type.String() }),
+          fallbackDescription: "Query a fixture account",
+        },
+      ],
+    },
+  };
+  const runtime: SessionMcpRuntime = {
+    sessionId: "fixture-session",
+    workspaceDir: "/fixture",
+    configFingerprint: serverName,
+    createdAt: 1,
+    lastUsedAt: 1,
+    getCatalog: async () => {
+      if (!state.catalog) {
+        throw new Error("fixture catalog invalidated");
+      }
+      return state.catalog;
+    },
+    peekCatalog: () => state.catalog,
+    markUsed: () => {},
+    callTool: async () => ({ content: [] }),
+    dispose: async () => {
+      state.current = false;
+    },
+  };
+  const owner = {
+    hasServers: () => true,
+    isCurrent: () => state.current,
+    replace: () => runtime,
+    reload: async () => {},
+    retireUnusedServers: async () => {},
+  };
+  sessionMcpRuntimeOwners.set(runtime, owner);
+  const tool: AnyAgentTool = {
+    name: `${serverName}__query`,
+    label: "query",
+    description: "Query a fixture account",
+    parameters: Type.Object({ account: Type.String() }),
+    execute: async () => ({ content: [], details: {} }),
+  };
+  const metadata = {
+    pluginId: "fixture-mcp",
+    optional: false,
+    mcp: { serverName, safeServerName: serverName, toolName: "query", operation: "tool" as const },
+  };
+  setPluginToolMeta(tool, metadata);
+  const currentCatalog = () =>
+    state.catalog ? mergeMcpConnectCatalog(state.catalog, runtime.requesterConnect) : null;
+  const capture = () => {
+    const catalog = currentCatalog();
+    if (!catalog) {
+      throw new Error("fixture catalog missing");
+    }
+    return captureMcpSteeringCatalogCurrent({ runtime, catalog, tools: [tool], currentCatalog });
+  };
+  return { runtime, owner, state, tool, metadata, capture };
+}
+
+async function requesterConnect() {
+  const connect = await createRequesterMcpConnect({
+    serverNames: new Set(["finance"]),
+    mcpServers: {
+      finance: {
+        url: serverUrl,
+        transport: "streamable-http",
+        auth: "oauth",
+        oauth: { identity: "per-requester" },
+      },
+    },
+    safeServerNamesByServer: new Map([["finance", "finance"]]),
+    requesterScope: scope,
+    configFingerprint: "requester-fixture",
+    cfg: { gateway: { publicOrigin: "https://gateway.example.test" } },
+  });
+  if (!connect) {
+    throw new Error("requester connect missing");
+  }
+  return connect;
+}
+

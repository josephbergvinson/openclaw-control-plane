+++ b/src/auto-reply/reply/agent-runner-steer-source.ts
@@ -0,0 +1,121 @@
+import { normalizeOptionalString } from "@openclaw/normalization-core/string-coerce";
+import {
+  runActiveReplySteer,
+  retryRetainedFollowupSteersAfterPublication,
+  type ActiveReplySteerParams,
+} from "./agent-runner-steer-adoption.js";
+import { getExistingFollowupQueue } from "./queue/state.js";
+import type { FollowupRun } from "./queue/types.js";
+import type { ReplyOperation } from "./reply-run-registry.contracts.js";
+import { resolveFollowupRunSteeringAuthority } from "./reply-steering-authority.js";
+import { buildChannelSourceTurnId } from "./source-turn-id.js";
+
+/** Retain this incoming source's context and delivery without borrowing a later turn. */
+export function bindRetainedReplySteerSource(params: ActiveReplySteerParams): void {
+  const {
+    followupRun,
+    opts,
+    queueKey,
+    replyOperationRunState,
+    resolvedQueue,
+    restartRecoverySourceTurnId,
+    runFollowup: queuedRunFollowupTurn,
+    sessionCtx,
+    sessionKey,
+    sessionEntry,
+    storePath,
+    typing,
+    typingSignals,
+  } = params;
+  if (
+    sessionCtx.InboundEventKind === "room_event" ||
+    followupRun.queuedFollowupReplyDisposition?.kind !== "deliver"
+  ) {
+    return;
+  }
+  const sourceDelivery = followupRun.queuedFollowupReplyDisposition.deliver;
+  const sourceTurnId =
+    restartRecoverySourceTurnId ??
+    buildChannelSourceTurnId({
+      provider:
+        followupRun.originatingChannel ?? followupRun.run.messageProvider ?? sessionCtx.Provider,
+      accountId:
+        followupRun.originatingAccountId ?? followupRun.run.agentAccountId ?? sessionCtx.AccountId,
+      conversationId:
+        followupRun.originatingTo ??
+        followupRun.originatingChatId ??
+        sessionKey ??
+        followupRun.run.sessionKey,
+      messageId: followupRun.messageId ?? sessionCtx.MessageSidFull ?? sessionCtx.MessageSid,
+    }) ??
+    normalizeOptionalString(opts?.runId);
+  followupRun.retrySteer = async (operation, reservation) => {
+    const authority = resolveFollowupRunSteeringAuthority(followupRun, operation);
+    if (!sourceTurnId || authority.requiresQueue) {
+      reservation.fallback();
+      return "deferred";
+    }
+    const result = await runActiveReplySteer({
+      followupRun,
+      opts,
+      providedReplyOperation: operation,
+      queueKey,
+      releaseAdmissionTicket: () => undefined,
+      replyOperationRunState,
+      resolvedQueue,
+      restartRecoverySourceTurnId,
+      runFollowup: queuedRunFollowupTurn,
+      sessionCtx,
+      sessionKey,
+      sessionEntry,
+      storePath,
+      // The retry must not publish an old incoming turn's session snapshot.
+      touchActiveSessionEntry: async () => undefined,
+      typing,
+      typingSignals,
+      ...replySteerToolAuthority(authority),
+      retainedReservation: reservation,
+    });
+    if (result !== "handled") {
+      await sourceDelivery({
+        kind: "queued-followup",
+        runId: sourceTurnId,
+        originatingChannel: followupRun.originatingChannel,
+        payloads: [result],
+        completion: {
+          kind: "failed",
+          error: result.text ?? "Input delivery could not be confirmed.",
+        },
+      });
+    }
+    return getExistingFollowupQueue(queueKey)?.items.includes(followupRun)
+      ? "deferred"
+      : "consumed";
+  };
+}
+
+export async function runBoundReplySteer(params: ActiveReplySteerParams) {
+  const result = await runActiveReplySteer(params);
+  return result === "handled" ? undefined : result;
+}
+
+export function wakeRetainedReplySteerSource(
+  source: FollowupRun,
+  operation?: ReplyOperation,
+): void {
+  if (source.retrySteer && operation) {
+    retryRetainedFollowupSteersAfterPublication(operation);
+  }
+}
+
+export function replySteerToolAuthority(
+  authority: ReturnType<typeof resolveFollowupRunSteeringAuthority>,
+) {
+  return {
+    toolAuthorityFingerprint: authority.incomingToolAuthorityFingerprint,
+    isToolAuthorityCurrent: authority.isToolAuthorityCurrent,
+    pendingInputAuthorityFingerprint: authority.hasRouteOnlyAuthorityMismatch
+      ? authority.activeToolAuthorityFingerprint
+      : undefined,
+  };

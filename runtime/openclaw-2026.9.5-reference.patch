+
+const seams = vi.hoisted(() => ({
+  dispatch: vi.fn(),
+  tracking: vi.fn(),
+  releaseRuntime: vi.fn(),
+}));
+
+// Keep provider preparation and transcript persistence out of this ownership test.
+// Admission, handoff consume, controller registration and execution remain real.
+vi.mock("../../agents/prepared-model-runtime.js", () => ({
+  loadPublishedGatewayReplyDispatchRuntime: async () => ({ config: {}, pluginGeneration: "A" }),
+  acquireAgentRunPreparedModelRuntime: async () => ({
+    snapshot: {},
+    pluginGeneration: "A",
+    [Symbol.asyncDispose]: seams.releaseRuntime,
+  }),
+}));
+vi.mock("../session-utils.js", () => ({
+  loadSessionEntry: () => ({ storePath: "/test/sessions" }),
+  resolveSessionModelRef: () => ({ provider: "openai", model: "gpt-6.1-sol" }),
+}));
+vi.mock("./agent-run-task-tracking.js", () => ({ prepareAgentRunTaskTracking: seams.tracking }));
+vi.mock("./agent-run-dispatch.js", () => ({
+  dispatchAgentRunFromGateway: seams.dispatch,
+  resolveAbortedAgentStopReason: () => "rpc",
+}));
+vi.mock("./agent-run-user-turn.js", () => ({
+  prepareAgentRunUserTurn: async (params: {
+    assertCurrent: () => void;
+    message: string;
+    resolvedSessionKey?: string;
+  }) => {
+    if (params.resolvedSessionKey) {
+      params.assertCurrent();
+    }
+    return { message: params.message, senderIsOwner: false, suppressPromptPersistence: true };
+  },
+  projectPreparedAgentRunUserTurnLifecycle: () => {},
+  reconcileAgentRunUserTurnCompletion: () => undefined,
+  recordAgentRunUserTurnParticipant: () => {},
+  releasePreparedAgentRunUserTurn: () => {},
+  releasePreparedAgentRunUserTurnAfterFailure: (_turn: unknown, error: unknown) => error,
+  finalizePreparedAgentRunUserTurn: () => {},
+}));
+
+const scope = {
+  requesterSenderId: "owner-A",
+  agentAccountId: "company-A",
+  messageChannel: "discord",
+};
+function createTestPrincipal(
+  internal: NonNullable<AgentTurnPrincipal["internal"]>,
+): AgentTurnPrincipal {
+  return {
+    connect: {
+      minProtocol: 1,
+      maxProtocol: 1,
+      client: { id: "cli", mode: "cli", version: "test", platform: "test" },
+    },
+    internal,
+  };
+}
+let sequence = 0;
+function createAdmission() {
+  let abort: PreparedAgentRunDispatch["activeRunAbort"] | undefined;
+  let admittedSessionId = "child-id";
+  let sourceCurrent = true;
+  const sourceGuard = vi.fn(() => {
+    if (!sourceCurrent) {
+      throw new Error("source retired");
+    }
+  });
+  const admission = {
+    release: vi.fn(),
+    run: async (run: () => Promise<void>) => await run(),
+  };
+  const io = { emitAcceptance: vi.fn(), emitFinal: vi.fn() };
+  const runId = `credential-admission-${++sequence}`;
+  const params = {
+    promptedAt: Date.now(),
+    request: {
+      message: "continue",
+      sessionKey: "agent:main:subagent:child",
+      idempotencyKey: runId,
+      expectedExistingSessionId: admittedSessionId,
+    },
+    cfg: {},
+    sessionEntry: { sessionId: admittedSessionId },
+    resolvedSessionKey: "agent:main:subagent:child",
+    activeSessionAgentId: "main",
+    delivery: { deliveryPlan: {} },
+    allowModelOverride: false,
+    lifecycleGeneration: getAgentEventLifecycleGeneration(),
+    getAdmittedSessionId: () => admittedSessionId,
+    suppressVisibleSessionEffects: true,
+    isOneShotModelRun: true,
+    isRestartRecoveryResumeRun: false,
+    canUseInternalRuntimeHandoff: true,
+    message: "continue",
+    effectiveTranscriptInputText: "continue",
+    images: [],
+    offloadedRefs: [],
+    onUserTurnMediaPersisted: () => {},
+    requestedPromptPersistenceSuppression: true,
+    runId,
+    agentDedupeKeys: [runId],
+    context: {
+      dedupe: new Map(),
+      chatAbortControllers: new Map(),
+      deps: {},
+      logGateway: { error: vi.fn(), warn: vi.fn() },
+    },
+    client: createTestPrincipal({
+      syntheticClient: true,
+      mcpRequesterScopeContext: {
+        mcpRequesterScope: { ...scope },
+        mcpRequesterScopeAssertCurrent: sourceGuard,
+      },
+    }),
+    io,
+    abortForLifecycleRotation: () => false,
+    acquireGatewayWorkAdmission: async () => {},
+    assertGatewayWorkAdmissionAllowed: () => {},
+    hasGatewayAdmissionOutcome: () => false,
+    respondToGatewayAdmissionOutcome: () => false,
+    admissionAgentId: () => "main",
+    getGatewayWorkAdmission: () => admission,
+    setAdmittedRunAbort: (value: PreparedAgentRunDispatch["activeRunAbort"]) => {
+      abort = value;
+    },
+    getAdmittedRunAbort: () => abort,
+    markAgentRunAccepted: vi.fn(),
+  } as unknown as Parameters<typeof prepareAgentRunDispatch>[0];
+  return {
+    params,
+    io,
+    sourceGuard,
+    admission,
+    retireSource: () => {
+      sourceCurrent = false;
+    },
+    isSourceCurrent: () => sourceCurrent,
+    resetTarget: () => {
+      admittedSessionId = "replacement-id";
+    },
+    abort: () => abort?.controller.abort(),
+    execute: (prepared: PreparedAgentRunDispatch) =>
+      startAgentRunExecution({
+        ...params,
+        prepared,
+        resolvedSessionId: admittedSessionId,
+        isNewSession: false,
+        isRawModelRun: true,
+        imageOrder: [],
+        media: [],
+        bestEffortDeliver: false,
+        preserveUserFacingSessionModelState: false,
+        skipAgentInitialSessionTouch: true,
+        releaseCronContinuationClaimWithRecovery: async () => true,
+      } as unknown as Parameters<typeof startAgentRunExecution>[0]),
+  };
+}
+
+function useCompletion(admission: ReturnType<typeof createAdmission>, oneWayReturn = false) {
+  const p = admission.params;
+  p.request.expectedExistingSessionId = undefined;
+  p.inputProvenance = {
+    kind: "inter_session",
+    sourceTool: "subagent_announce",
+    sourceSessionKey: "child-source",
+    ...(oneWayReturn ? { sourceRole: "subagent" as const, originSessionId: "source-id" } : {}),
+  };
+  p.request.internalEvents = [
+    {
+      type: AGENT_INTERNAL_EVENT_TYPE_TASK_COMPLETION,
+      source: "subagent",
+      childSessionKey: "child-source",
+      childSessionId: "source-id",
+    },
+  ] as NonNullable<typeof p.request.internalEvents>;
+  if (oneWayReturn) {
+    p.request.internalEvents = undefined;
+  }
+  p.client = createTestPrincipal({
+    syntheticClient: true,
+    delegatedToolPolicyHandoffId: registerSubagentCompletionToolHandoff({
+      sourceSessionKey: "child-source",
+      sourceSessionId: "source-id",
+      ...(oneWayReturn ? { sourceRole: "subagent" as const } : {}),
+      targetSessionKey: p.resolvedSessionKey!,
+      targetSessionId: p.getAdmittedSessionId(),
+      idempotencyKey: p.request.idempotencyKey,
+      mcpRequesterScope: { ...scope },
+      mcpRequesterScopeAssertCurrent: admission.sourceGuard,
+    }),
+  });
+}
+
+function useNative(admission: ReturnType<typeof createAdmission>) {
+  admission.params.client = createTestPrincipal({
+    agentRuntimeIdentity: {
+      kind: "agentRuntime",
+      agentId: "main",
+      sessionKey: "parent-session",
+      operationalRunInstance: { instanceId: "parent-instance", runId: "parent-run" },
+      delegatedAuthority: {
+        kind: "local",
+        lifecycleGeneration: "parent-generation",
+        claimId: "parent-claim",
+        operationalRunInstance: { instanceId: "parent-instance", runId: "parent-run" },
+      },
+      sessionSpawnContext: {
+        inheritedToolPolicy: { version: 1, allow: ["read"], deny: ["exec"] },
+        mcpRequesterScope: { ...scope },
+      },
+    },
+  });
+  admission.params.context.validateAgentRuntimeApprovalAuthority = admission.isSourceCurrent;
+}
+
+describe("credential scope transfer at Gateway acceptance", () => {
+  beforeEach(() => {
+    resetAgentEventsForTest();
+    seams.dispatch.mockReset();
+    seams.tracking.mockReset();
+    seams.releaseRuntime.mockReset();
+    seams.tracking.mockResolvedValue({ taskTrackingMode: "none" });
+  });
+
+  it.each(["queued", "native", "completion", "one-way return"] as const)(
+    "executes accepted %s work after the source row/parent retires, while child cancellation revokes reuse",
+    async (route) => {
+      const admission = createAdmission();
+      if (route === "native") {
+        useNative(admission);
+      }
+      if (route === "completion" || route === "one-way return") {
+        useCompletion(admission, route === "one-way return");
+      }
+      admission.io.emitAcceptance.mockImplementationOnce(([ok]) => {
+        expect(ok).toBe(true);
+        admission.retireSource();
+      });
+      const prepared = await prepareAgentRunDispatch(admission.params);
+      expect(prepared?.admittedMcpRequesterScope).toEqual(scope);
+      const callsAtAcceptance = admission.sourceGuard.mock.calls.length;
+      expect(callsAtAcceptance).toBe(
+        route === "completion" || route === "one-way return" ? 2 : route === "queued" ? 1 : 0,
+      );
+      seams.dispatch.mockImplementationOnce(async (dispatch) => {
+        const ctx = dispatch.ingressOpts.runContext;
+        expect(ctx.mcpRequesterScope).toEqual(scope);
+        expect(ctx.senderId).toBeUndefined();
+        expect(dispatch.ingressOpts.senderIsOwner).toBe(false);
+        ctx.mcpRequesterScopeAssertCurrent();
+        admission.abort();
+        expect(ctx.mcpRequesterScopeAssertCurrent).toThrow();
+        dispatch.cleanupAbortController();
+      });
+      await admission.execute(prepared!);
+      expect(seams.dispatch).toHaveBeenCalledOnce();
+      expect(admission.sourceGuard).toHaveBeenCalledTimes(callsAtAcceptance);
+      expect(admission.params.context.chatAbortControllers.size).toBe(0);
+    },
+  );
+
+  it.each(["missing source role", "wrong source id", "stale source", "replaced target"])(
+    "refuses a private one-way return before acceptance for %s",
+    async (failure) => {
+      const admission = createAdmission();
+      useCompletion(admission, true);
+      if (failure === "missing source role") {
+        delete admission.params.inputProvenance!.sourceRole;
+      }
+      if (failure === "wrong source id") {
+        admission.params.inputProvenance!.originSessionId = "replaced-source";
+      }
+      if (failure === "stale source") {
+        admission.retireSource();
+      }
+      if (failure === "replaced target") {
+        admission.resetTarget();
+      }
+      const prepared = await prepareAgentRunDispatch(admission.params);
+      expect(prepared).toBeUndefined();
+      expect(admission.io.emitAcceptance).toHaveBeenCalledWith([
+        false,
+        undefined,
+        expect.anything(),
+      ]);
+      expect(seams.dispatch).not.toHaveBeenCalled();
+    },
+  );
+
+  it.each([
+    "stale row",
+    "wrong target id",
+    "wrong target key",
+    "missing assertion",
+    "untrusted client",
+    "cancelled",
+  ])("refuses queued ownership before acceptance when %s", async (failure) => {
+    const admission = createAdmission();
+    if (failure === "wrong target key") {
+      admission.params.request.sessionKey = "different-child";
+    }
+    if (failure === "missing assertion") {

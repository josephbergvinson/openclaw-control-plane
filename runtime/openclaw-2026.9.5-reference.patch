+
+    @Test(arguments: [
+        "Enter an administrator's name and password to allow this.",
+        "Enter your password to continue with “DevicesSystemUpdater”.",
+    ])
+    func `administrator identity comes from a same form named ordinary field`(_ instruction: String) throws {
+        let context = try #require(NativeCredentialPromptContext.resolve(
+            Self.administratorForm(instruction: instruction), bundleID: "com.apple.SecurityAgent"))
+        #expect(context.field == 5)
+        #expect(context.username?.field == 3)
+        #expect(context.username?.label == 2)
+        #expect(context.submit == 7)
+        #expect(!context.evidence.contains("fixture"))
+        #expect(NativeCredentialPromptPurpose.resolve(nativeEvidence: context.evidence) == .administratorAuthentication)
+    }
+
+    @Test(arguments: [
+        "unlabelled",
+        "wrong-label",
+        "editable-label",
+        "missing-instruction",
+        "incomplete-instruction",
+        "fake-cancel",
+        "fake-submit",
+        "no-default-submit",
+        "ordinary-button",
+        "cancel-default",
+        "outside-submit",
+        "second-username",
+        "editor",
+        "second-password",
+        "outside-label",
+        "nested-label",
+    ], [
+        "Enter an administrator's name and password to allow this.",
+        "Enter your password to continue with “DevicesSystemUpdater”.",
+    ])
+    func `administrator form cannot borrow label proximity body text or another dialog`(
+        _ change: String, _ instruction: String)
+    {

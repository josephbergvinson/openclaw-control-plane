+};
+
+async function readElementMetadata(
+  element: ElementHandle<HTMLElement | SVGElement>,
+): Promise<CredentialElementMetadata> {
+  return await element.evaluate((target) => ({
+    connected: target.isConnected,
+    origin: target.ownerDocument.defaultView?.location.origin ?? null,
+    role: target.getAttribute("role")?.toLowerCase() ?? "",
+    tagName: target.tagName.toLowerCase(),
+    type: target instanceof HTMLInputElement ? target.type.toLowerCase() : "",
+    name: target.getAttribute("name") ?? "",
+  }));
+}
+
+function assertCredentialElement(
+  metadata: CredentialElementMetadata,
+  expectedOrigin: string,
+  binding: BrowserCredentialBinding,
+): void {
+  assertBrowserCredentialTargetOrigin({ targetOrigin: metadata.origin, expectedOrigin });
+  const field = binding.confidentialField;
+  if (field) {
+    if (
+      !metadata.connected ||
+      metadata.tagName !== "input" ||
+      metadata.type !== field.type ||
+      metadata.name !== field.name
+    ) {
+      throw new Error("Browser confidential target must match its configured input name and type.");
+    }
+  } else if (!metadata.connected || metadata.tagName !== "input" || metadata.type !== "password") {
+    throw new Error("Browser credential target must be a connected input[type=password] element.");
+  }
+}
+
+function assertSubmitElement(metadata: CredentialElementMetadata, expectedOrigin: string): void {
+  assertBrowserCredentialTargetOrigin({ targetOrigin: metadata.origin, expectedOrigin });
+  const nativeButton = metadata.tagName === "button";
+  const buttonInput =
+    metadata.tagName === "input" && ["button", "image", "submit"].includes(metadata.type);
+  if (!metadata.connected || (!nativeButton && !buttonInput && metadata.role !== "button")) {
+    throw new Error(
+      "Browser credential submit target must be a connected button or submit control.",
+    );
+  }
+}
+
+function assertTracingInactive(page: Page): void {
+  if (ensureContextState(page.context()).traceActive) {
+    throw new Error("Browser credential fill is unavailable while Playwright tracing is active.");
+  }
+}
+
+function resolveAllowedOrigin(binding: BrowserCredentialBinding, pageUrl: string): string {
+  const currentOrigin = readBrowserCredentialOriginFromUrl(pageUrl);
+  if (!currentOrigin || !binding.allowedOrigins.includes(currentOrigin)) {
+    throw new Error("Browser credential current tab origin is not allowed by its binding.");
+  }
+  return currentOrigin;
+}
+
+function validateResolvedSecret(value: string): string {
+  const containsControlCharacter = Array.from(value).some((character) => {
+    const codePoint = character.codePointAt(0) ?? 0;
+    return codePoint <= 0x1f || codePoint === 0x7f;
+  });
+  if (!value || value.length > 8_192 || containsControlCharacter) {
+    throw new Error(RESOLUTION_ERROR);
+  }
+  return value;
+}
+
+async function clearFailedCredentialFill(params: {
+  page: Page;
+  element: ElementHandle<HTMLElement | SVGElement>;
+  timeout: number;
+}): Promise<void> {
+  if (params.page.isClosed()) {
+    return;
+  }
+  try {
+    await params.element.fill("", { timeout: params.timeout });
+    return;
+  } catch {
+    // The ordinary failure path makes one bounded attempt to clear the field.
+  }
+  if (!params.page.isClosed()) {
+    await params.page.close().catch(() => undefined);
+  }
+}
+
+/** Fill a plugin-bound secret and submit only when explicitly requested. */
+export async function executeBrowserTypeSecret(params: {
+  request: BrowserTypeSecretRequest;
+  cdpUrl: string;
+  targetId: string;
+  navigationPolicy?: BrowserNavigationPolicyOptions;
+  signal?: AbortSignal;
+  assertCurrent?: () => void | Promise<void>;
+}): Promise<{ ok: true; targetId: string; origin: string }> {
+  await params.assertCurrent?.();
+  const binding = getBrowserCredentialBinding(params.request.alias);
+  if (!binding) {
+    throw new Error("Unknown browser credential binding alias.");
+  }
+  if (params.request.targetId !== params.targetId) {
+    throw new Error("Browser credential request targetId changed before fill.");
+  }
+
+  const timeout = resolveActInteractionTimeoutMs();
+  const page = await getRestoredPageForTarget({ cdpUrl: params.cdpUrl, targetId: params.targetId });
+  assertTracingInactive(page);
+  const contextState = ensureContextState(
+    page.context(),
+    getCurrentManagedBrowserHandle(params.cdpUrl),
+  );
+  const runFill = async (): Promise<{ ok: true; targetId: string; origin: string }> => {
+    await params.assertCurrent?.();
+    params.signal?.throwIfAborted();
+    assertTracingInactive(page);
+    const expectedOrigin = resolveAllowedOrigin(binding, page.url());
+    const passwordHandle = await refLocator(page, params.request.ref).elementHandle({ timeout });
+    if (!passwordHandle) {
+      throw new Error("Browser credential target could not be resolved before fill.");
+    }
+
+    const passwordElement = passwordHandle;
+    let submitElement: ElementHandle<HTMLElement | SVGElement> | undefined;
+    try {
+      const passwordMetadata = await readElementMetadata(passwordHandle);
+      assertCredentialElement(passwordMetadata, expectedOrigin, binding);
+      const ownerFrame = await passwordElement.ownerFrame();
+      if (!ownerFrame) {
+        throw new Error("Browser credential target owner frame could not be verified.");
+      }
+      if (params.request.submitRef && !params.request.submit) {
+        throw new Error("Browser credential submitRef requires submit=true.");
+      }
+      if (params.request.submitRef) {
+        submitElement =
+          (await refLocator(page, params.request.submitRef).elementHandle({ timeout })) ??
+          undefined;
+        if (!submitElement) {
+          throw new Error("Browser credential submit target could not be resolved before fill.");
+        }
+        assertSubmitElement(await readElementMetadata(submitElement), expectedOrigin);
+        if ((await submitElement.ownerFrame()) !== ownerFrame) {
+          throw new Error(
+            "Browser credential submit target must share the password field owner frame.",
+          );
+        }
+      }
+
+      let credential: string;
+      try {
+        credential = validateResolvedSecret(await resolveBrowserCredentialSecret(binding.secret));
+      } catch {
+        throw new Error(RESOLUTION_ERROR);
+      }
+
+      await params.assertCurrent?.();
+      assertTracingInactive(page);
+      if (getBrowserCredentialBinding(params.request.alias) !== binding) {
+        throw new Error("Browser credential binding changed before fill.");
+      }
+      assertBrowserCredentialExpectedOrigin({ currentUrl: page.url(), expectedOrigin });
+      assertCredentialElement(await readElementMetadata(passwordElement), expectedOrigin, binding);
+      if ((await passwordElement.ownerFrame()) !== ownerFrame) {
+        throw new Error("Browser credential target owner frame changed before fill.");
+      }
+      if (submitElement) {
+        assertSubmitElement(await readElementMetadata(submitElement), expectedOrigin);
+        if ((await submitElement.ownerFrame()) !== ownerFrame) {
+          throw new Error(
+            "Browser credential submit target owner frame changed before submission.",
+          );
+        }
+      }
+
+      try {
+        await params.assertCurrent?.();
+        params.signal?.throwIfAborted();
+        if (binding.confidentialField) {
+          // This DOM marker survives transport-only reconnection and contains no value.
+          await passwordElement.evaluate(
+            (element, attribute) => element.setAttribute(attribute, ""),
+            BROWSER_CONFIDENTIAL_FIELD_ATTRIBUTE,
+          );
+          contextState.opaqueFormCredentialsRetained = true;
+          await params.assertCurrent?.();
+          params.signal?.throwIfAborted();
+          assertTracingInactive(page);
+          assertBrowserCredentialExpectedOrigin({ currentUrl: page.url(), expectedOrigin });
+          assertCredentialElement(
+            await readElementMetadata(passwordElement),
+            expectedOrigin,
+            binding,
+          );
+          if ((await passwordElement.ownerFrame()) !== ownerFrame) {
+            throw new Error("Browser credential target owner frame changed before fill.");
+          }
+        }
+        await passwordElement.fill(credential, { timeout });
+        await params.assertCurrent?.();
+        params.signal?.throwIfAborted();
+        assertBrowserCredentialExpectedOrigin({ currentUrl: page.url(), expectedOrigin });
+        assertCredentialElement(
+          await readElementMetadata(passwordElement),
+          expectedOrigin,
+          binding,
+        );
+        if ((await passwordElement.ownerFrame()) !== ownerFrame) {
+          throw new Error("Browser credential target owner frame changed after fill.");
+        }
+        if (params.request.submit) {
+          await awaitNavigationGuardedInteraction(
+            {
+              action: async () => {
+                await params.assertCurrent?.();
+                params.signal?.throwIfAborted();
+                assertBrowserCredentialExpectedOrigin({ currentUrl: page.url(), expectedOrigin });
+                if (submitElement) {
+                  assertSubmitElement(await readElementMetadata(submitElement), expectedOrigin);
+                  if ((await submitElement.ownerFrame()) !== ownerFrame) {
+                    throw new Error(
+                      "Browser credential submit target owner frame changed before submission.",
+                    );
+                  }
+                  await params.assertCurrent?.();
+                  params.signal?.throwIfAborted();
+                  await submitElement.click({ timeout });
+                } else {
+                  assertCredentialElement(
+                    await readElementMetadata(passwordElement),
+                    expectedOrigin,
+                    binding,
+                  );
+                  if ((await passwordElement.ownerFrame()) !== ownerFrame) {
+                    throw new Error(
+                      "Browser credential target owner frame changed before submission.",
+                    );
+                  }
+                  await params.assertCurrent?.();
+                  params.signal?.throwIfAborted();
+                  await passwordElement.press("Enter", { timeout });
+                }
+              },
+              cdpUrl: params.cdpUrl,
+              page,
+              targetId: params.targetId,
+              ...params.navigationPolicy,
+            },
+            undefined,
+            params.signal,
+          );
+        }
+      } catch {
+        await clearFailedCredentialFill({ page, element: passwordElement, timeout });
+        throw new Error(FILL_ERROR);
+      }
+
+      return { ok: true, targetId: params.targetId, origin: expectedOrigin };
+    } finally {
+      await submitElement?.dispose().catch(() => undefined);
+      await passwordElement.dispose().catch(() => undefined);
+    }
+  };
+  // Native painting/snapshot reads and confidential writes retain the same page owner.
+  return binding.confidentialField
+    ? await runPageEmulationTransition({
+        state: ensurePageState(page),
+        signal: params.signal,
+        run: runFill,
+      })
+    : await runFill();
+}
diff --git a/extensions/browser/src/browser-credential-observation.ts b/extensions/browser/src/browser-credential-observation.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d1ded321c273457566401c920137167a965716d3
--- /dev/null
+++ b/extensions/browser/src/browser-credential-observation.ts
@@ -0,0 +1,373 @@
+import type { lookup as dnsLookupCb } from "node:dns";
+import { redactRegisteredSecretValues } from "openclaw/plugin-sdk/browser-config";
+import type { ElementHandle, Frame, Locator, Page } from "playwright-core";
+import { listBrowserCredentialBindingMetadata } from "./browser-credential-config.js";
+import { withCdpSocket } from "./browser/cdp.helpers.js";
+import type { RawAXNode } from "./browser/cdp.js";
+import { readBrowserCredentialOriginFromUrl } from "./browser/credential-origin.js";
+import {
+  readRoleSnapshotFieldIdentity,
+  type ConfidentialRoleSnapshotField,
+} from "./browser/pw-role-snapshot.js";
+
+export const BROWSER_CONFIDENTIAL_FIELD_ATTRIBUTE = "data-openclaw-confidential-field";
+// Passwords can be populated by the browser before any OpenClaw credential fill.
+export const BROWSER_CONFIDENTIAL_FIELD_SELECTOR = `[${BROWSER_CONFIDENTIAL_FIELD_ATTRIBUTE}], input[type="password" i]`;
+
+/** Reuse resolved SecretRef membership; no private values are stored by Browser. */
+function redactJsonBrowserCredentialObservation(value: unknown): unknown {
+  if (typeof value === "string" || typeof value === "number") {
+    const text = String(value);
+    const redacted = redactRegisteredSecretValues(text, () => "[REDACTED]");
+    return redacted === text ? value : redacted;
+  }
+  if (Array.isArray(value)) {
+    return value.map(redactJsonBrowserCredentialObservation);
+  }
+  if (value && typeof value === "object") {
+    return Object.fromEntries(
+      Object.entries(value).map(([key, child]) => [
+        String(redactJsonBrowserCredentialObservation(key)),
+        redactJsonBrowserCredentialObservation(child),
+      ]),
+    );
+  }
+  return value;
+}
+
+/** Match the response's JSON projection, including Date/Buffer/custom toJSON semantics. */
+export function redactBrowserCredentialObservation(value: unknown): unknown {
+  const serialized = JSON.stringify(value);
+  return serialized === undefined
+    ? value
+    : redactJsonBrowserCredentialObservation(JSON.parse(serialized));
+}
+
+/** Existing exact bindings reidentify replaced controls without retaining private values. */
+export function confidentialObservationBindings() {
+  return listBrowserCredentialBindingMetadata().flatMap((binding) =>
+    binding.confidentialField
+      ? [{ allowedOrigins: binding.allowedOrigins, ...binding.confidentialField }]
+      : [],
+  );
+}
+
+export async function hasBrowserConfidentialFields(page: Page): Promise<boolean> {
+  const bindings = confidentialObservationBindings();
+  let present = false;
+  for (const frame of page.frames()) {
+    if (bindings.length) {
+      await frame.locator("input").evaluateAll(
+        (inputs, { fields, attribute }) => {
+          for (const input of inputs) {
+            if (!(input instanceof HTMLInputElement)) {
+              continue;
+            }
+            const origin = input.ownerDocument.defaultView?.location.origin;
+            if (
+              fields.some(
+                (field) =>
+                  field.allowedOrigins.includes(origin ?? "") &&
+                  field.name === input.name &&
+                  field.type === input.type,
+              )
+            ) {
+              input.setAttribute(attribute, "");
+            }
+          }
+        },
+        { fields: bindings, attribute: BROWSER_CONFIDENTIAL_FIELD_ATTRIBUTE },
+      );
+    }
+    if (await frame.locator(BROWSER_CONFIDENTIAL_FIELD_SELECTOR).count()) {
+      present = true;
+    }
+  }
+  return present;
+}
+
+/** Restore exact bound controls and read target membership before a raw capture. */
+export async function hasBrowserConfidentialFieldsViaCdp(opts: {
+  wsUrl: string;
+  lookup?: typeof dnsLookupCb;
+  timeoutMs?: number;
+}): Promise<boolean> {
+  return await withCdpSocket(
+    opts.wsUrl,
+    async (send) => {
+      const response = (await send("Runtime.evaluate", {
+        expression: `(() => {
+        const fields = ${JSON.stringify(confidentialObservationBindings())};
+        const marked = (doc) => {
+          const origin = doc.defaultView?.location.origin;
+          for (const input of doc.querySelectorAll('input')) {
+            if (fields.some((field) => field.allowedOrigins.includes(origin ?? '') &&
+              field.name === input.name && field.type === input.type)) {
+              input.setAttribute(${JSON.stringify(BROWSER_CONFIDENTIAL_FIELD_ATTRIBUTE)}, '');
+            }
+          }
+          if (doc.querySelector(${JSON.stringify(BROWSER_CONFIDENTIAL_FIELD_SELECTOR)})) return true;
+          for (const frame of doc.querySelectorAll('iframe,frame')) {
+            try { if (frame.contentDocument && marked(frame.contentDocument)) return true; } catch {}
+          }
+          return false;
+        };
+        return marked(document);
+      })()`,
+        returnByValue: true,
+      })) as { result?: { value?: unknown }; exceptionDetails?: unknown }; // SAFETY: Membership requires the boolean check below; other protocol fields stay unknown.
+      if (response.exceptionDetails || typeof response.result?.value !== "boolean") {
+        throw new Error("Browser confidential field observation could not be verified.");
+      }
+      return response.result.value;
+    },
+    { commandTimeoutMs: opts.timeoutMs ?? 5000, lookup: opts.lookup },
+  );
+}
+
+/** Selector membership follows the same exact binding if DOM replacement occurs during paint. */
+export function browserConfidentialFieldSelectorForOrigin(
+  origin: string | null | undefined,
+): string {
+  const fields = confidentialObservationBindings();
+  if (!fields.length) {
+    return BROWSER_CONFIDENTIAL_FIELD_SELECTOR;
+  }
+  // HTML normalizes absent/invalid input types to text, matching the secure fill owner.
+  const nonTextTypes = [
+    "button",
+    "checkbox",
+    "color",
+    "date",
+    "datetime-local",
+    "email",
+    "file",
+    "hidden",
+    "image",
+    "month",
+    "number",
+    "password",
+    "radio",
+    "range",
+    "reset",
+    "search",
+    "submit",
+    "tel",
+    "time",
+    "url",
+    "week",
+  ];
+  const selectors = fields
+    .filter((field) => origin && field.allowedOrigins.includes(origin))
+    .map((field) => {
+      const named = `input[name=${JSON.stringify(field.name)}]`;
+      return field.type === "text"
+        ? `${named}:not(${nonTextTypes.map((type) => `[type=${JSON.stringify(type)} i]`).join(",")})`
+        : `${named}[type=${JSON.stringify(field.type)} i]`;
+    });
+  return [BROWSER_CONFIDENTIAL_FIELD_SELECTOR, ...selectors].join(",");
+}
+
+function confidentialFrameSelector(frame: Frame): string {
+  return browserConfidentialFieldSelectorForOrigin(readBrowserCredentialOriginFromUrl(frame.url()));
+}
+
+/** Native screenshot masks cover only current marked/bound controls, including child frames. */
+export function browserConfidentialScreenshotMasks(page: Page) {
+  return page.frames().map((frame) => frame.locator(confidentialFrameSelector(frame)));
+}
+
+/** Retain ordinary descendants of ignored structural nodes; omit masked AX values. */
+export function excludeIgnoredBrowserAxNodes(
+  nodes: Array<RawAXNode & { ignored?: boolean }>,
+): RawAXNode[] {
+  const byId = new Map(nodes.map((node) => [node.nodeId, node]));
+  const expand = (id: string, seen = new Set<string>()): string[] => {
+    if (seen.has(id)) {
+      return [];
+    }
+    const node = byId.get(id);
+    if (!node) {
+      return [];
+    }
+    if (!node.ignored) {
+      return [id];
+    }
+    const next = new Set(seen).add(id);
+    return (node.childIds ?? []).flatMap((child) => expand(child, next));
+  };
+  return nodes
+    .filter((node) => !node.ignored)
+    .map((node) =>
+      Object.assign({}, node, { childIds: (node.childIds ?? []).flatMap((id) => expand(id)) }),
+    );
+}
+
+/** Capture current field identities/positions through native locators; no values are retained. */
+export async function readBrowserConfidentialSnapshotFields(
+  scope: Page | Frame | Locator,
+  options: { ai?: boolean } = {},
+): Promise<ConfidentialRoleSnapshotField[]> {
+  const fields: ConfidentialRoleSnapshotField[] = [];
+  // AI snapshots merge native frame refs. Ordinary locator snapshots stay in their frame.
+  const scopes = options.ai && "frames" in scope ? scope.frames() : [scope];
+  for (const current of scopes) {
+    const controls = await current.locator(BROWSER_CONFIDENTIAL_FIELD_SELECTOR).all();
+    const rootMarked =
+      "evaluateAll" in current &&
+      (await current.evaluateAll(
+        (elements, selector) => elements.some((element) => element.matches(selector)),
+        BROWSER_CONFIDENTIAL_FIELD_SELECTOR,
+      ));
+    if (rootMarked) {
+      // SAFETY: Only the native Locator arm of this union has evaluateAll.
+      controls.unshift(current as Locator);
+    }
+    const seen = new Set<string>();
+    for (const control of controls) {
+      const identity = readRoleSnapshotFieldIdentity(
+        await control.ariaSnapshot(options.ai ? { mode: "ai" as const } : {}),
+      );
+      if (!identity) {
+        if (!(await control.isVisible())) {
+          continue;
+        }
+        throw new Error("Browser confidential field identity could not be verified.");
+      }
+      if (options.ai) {
+        if (!identity.ref) {
+          throw new Error("Browser confidential field reference could not be verified.");
+        }
+        fields.push({ ...identity, nth: 0 });
+        continue;
+      }
+      const key = `${identity.role}\0${identity.name ?? ""}`;
+      if (seen.has(key)) {
+        continue;
+      }
+      seen.add(key);
+      if (rootMarked) {
+        fields.push({ ...identity, nth: 0 });
+        continue;
+      }
+      const positions = await current
+        // SAFETY: The role comes from this control's native Playwright ariaSnapshot.
+        .getByRole(identity.role as Parameters<Page["getByRole"]>[0], {
+          name: identity.name ?? "",
+          exact: true,
+        })
+        .evaluateAll(
+          (elements, selector) => elements.map((element) => element.matches(selector)),
+          BROWSER_CONFIDENTIAL_FIELD_SELECTOR,
+        );
+      positions.forEach((marked, nth) => {
+        if (marked) {
+          fields.push({ ...identity, nth });
+        }
+      });
+    }
+  }
+  return fields;
+}
+
+/** A same-document label/order change must not publish a snapshot under stale field identities. */
+export async function assertBrowserConfidentialSnapshotCurrent(
+  page: Page,
+  scope: Page | Frame | Locator,
+  expected: readonly ConfidentialRoleSnapshotField[],
+  options: { ai?: boolean } = {},
+): Promise<boolean> {
+  const confidential = await hasBrowserConfidentialFields(page);
+  const current = confidential ? await readBrowserConfidentialSnapshotFields(scope, options) : [];
+  if (JSON.stringify(expected) !== JSON.stringify(current)) {
+    throw new Error(
+      "Confidential field identity changed while its browser snapshot was being captured; retry.",
+    );
+  }
+  return confidential;
+}
+
+export function redactBrowserConfidentialAxValues(
+  nodes: RawAXNode[],
+  fields: readonly ConfidentialRoleSnapshotField[],
+): RawAXNode[] {
+  const counts = new Map<string, number>();
+  const hidden = new Set<string>();
+  const byId = new Map(nodes.map((node) => [node.nodeId, node]));
+  const hideChildren = (id: string) => {
+    if (hidden.has(id)) {
+      return;
+    }
+    hidden.add(id);
+    for (const child of byId.get(id)?.childIds ?? []) {
+      hideChildren(child);
+    }
+  };
+  const marked = new Set<RawAXNode>();
+  for (const node of nodes) {
+    const role = node.role?.value?.toLowerCase() ?? "";
+    const name = node.name?.value || undefined;
+    const key = `${role}\0${name ?? ""}`;
+    const nth = counts.get(key) ?? 0;
+    counts.set(key, nth + 1);
+    if (fields.some((field) => field.role === role && field.name === name && field.nth === nth)) {
+      marked.add(node);
+      for (const child of node.childIds ?? []) {
+        hideChildren(child);
+      }
+    }
+  }
+  return nodes.map((node) => {
+    if (!marked.has(node) && !hidden.has(node.nodeId ?? "")) {
+      return node;
+    }
+    return {
+      ...node,
+      value: undefined,
+      description: undefined,
+      ...(hidden.has(node.nodeId ?? "") ? { name: { value: "[REDACTED]" } } : {}),
+    };
+  });
+}
+
+/** Native screenshot emulation shares a field-only paint exclusion. */
+export async function withBrowserConfidentialFieldPaintMask<T>(
+  page: Page,
+  run: () => Promise<T>,
+): Promise<T> {
+  const styles: ElementHandle[] = [];
+  const [capture] = await Promise.allSettled([
+    (async () => {
+      for (const frame of page.frames()) {
+        // Preserve layout while excluding the filled control from native painting.
+        styles.push(
+          await frame.addStyleTag({
+            content: `${confidentialFrameSelector(frame)} { visibility: hidden !important; }`,
+          }),
+        );
+      }
+      return await run();
+    })(),
+  ]);
+  // Restore every retained mask after setup/capture settles. Restoration failure
+  // blocks publication; otherwise preserve the original capture outcome.
+  const cleanup = await Promise.allSettled(
+    styles.map(async (style) => {
+      try {
+        await style.evaluate((element) => {
+          element.parentNode?.removeChild(element);
+        });
+      } finally {
+        await style.dispose();
+      }
+    }),
+  );
+  const failed = cleanup.find((result) => result.status === "rejected");
+  if (failed?.status === "rejected") {
+    throw failed.reason;
+  }
+  if (capture.status === "rejected") {
+    throw capture.reason;
+  }
+  return capture.value;
+}
diff --git a/extensions/browser/src/browser-credential-secret.runtime.ts b/extensions/browser/src/browser-credential-secret.runtime.ts
new file mode 100644
index 0000000000000000000000000000000000000000..589de1a900dcdfa30845d90f857bc37d3956351d
--- /dev/null
+++ b/extensions/browser/src/browser-credential-secret.runtime.ts
@@ -0,0 +1,17 @@
+import { registerSecretValueForRedaction } from "openclaw/plugin-sdk/browser-config";
+import { resolveSecretRefValues, type SecretRef } from "openclaw/plugin-sdk/secret-ref-runtime";
+import { getRuntimeConfig } from "./config/config.js";
+
+/** Resolve exactly one binding only after browser-owned preflight has passed. */
+export async function resolveBrowserCredentialSecret(ref: SecretRef): Promise<string> {
+  const values = await resolveSecretRefValues([ref], {
+    config: getRuntimeConfig(),
+    env: process.env,
+  });
+  const resolved = Array.from(values.values());
+  if (resolved.length !== 1 || typeof resolved[0] !== "string" || !resolved[0]) {
+    throw new Error("Browser credential could not be resolved.");
+  }
+  registerSecretValueForRedaction(resolved[0]);
+  return resolved[0];
+}

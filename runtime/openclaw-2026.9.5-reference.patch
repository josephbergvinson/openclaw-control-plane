+} from "./attempt-recovery.test-support.js";
+
+vi.mock("../../../infra/backoff.js", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("../../../infra/backoff.js")>()),
+  sleepWithAbort: vi.fn(async () => {}),
+}));
+
+describe("provider recovery after committed progress", () => {
+  it("starts a new outage window after productive work without replaying the task", async () => {
+    const startedAt = Date.now();
+    const now = vi.spyOn(Date, "now").mockReturnValue(startedAt);
+    try {
+      const first = await recoverAfterTransportDrop({ noTools: true, replaySafe: true });
+      expect(first.recovery.action).toBe("retry");
+      now.mockReturnValue(startedAt + 8 * 60_000 + 34_000);
+      const productive = await recoverAfterTransportDrop({
+        failoverRetryController: first.failoverRetryController,
+        toolCallIds: ["render_artifact", "read_artifact"],
+        errorMessage: "terminated",
+      });
+
+      expect(productive.recovery).toMatchObject({ action: "retry" });
+      expect(productive.markOwnedTranscriptRetry).toHaveBeenCalledOnce();
+      expect(productive.continueFromCurrentTranscript).toHaveBeenCalledExactlyOnceWith({
+        includeToolFailureInstruction: false,
+      });
+      expect(productive.failoverRetryController.transientRetryCount).toBe(2);
+      expect(productive.failoverRetryController.advanceAuthProfile).not.toHaveBeenCalled();
+      expect(productive.failoverRetryController.maybeMarkAuthProfileFailure).not.toHaveBeenCalled();
+
+      // The next failure has no new completed work: old receipts and thinking
+      // cannot extend the recovery window, even though retry slots remain.
+      now.mockReturnValue(startedAt + 8 * 60_000 + 34_000 + 125_390);
+      expect(await productive.recover()).toEqual({ action: "proceed" });
+      expect(productive.failoverRetryController.transientRetryCount).toBe(2);
+      expect(productive.continueFromCurrentTranscript).toHaveBeenCalledOnce();
+    } finally {
+      now.mockRestore();
+    }
+  });
+
+  it.each<[string, TransportDropScenario]>([
+    ["reasoning without completed tool work", { noTools: true, replaySafe: true }],
+    [
+      "commentary without completed tool work",
+      { noTools: true, assistantTexts: ["Still working."] },
+    ],
+    ["a failed tool receipt", { toolCallIds: ["failed"], failedToolCallId: "failed" }],
+    ["a missing result", { missingToolResult: true }],
+    ["an active lifecycle item", { activeCount: 1 }],
+    ["asynchronous work", { asyncStarted: true }],
+    ["an intentional termination", { terminate: true }],
+    ["a pending approval", { didSendDeterministicApprovalPrompt: true }],
+    ["a harness that owns transport", { pluginHarnessOwnsTransport: true }],
+    ["a yielded attempt", { yieldDetected: true }],
+    ["an external cancellation", { terminal: { kind: "aborted", source: "external" } }],
+    [
+      "an expired run deadline",
+      { terminal: { kind: "timeout", phase: "prompt", source: "run_budget" } },
+    ],
+  ])("does not renew recovery for %s", async (_label, scenario) => {
+    const startedAt = Date.now();
+    const now = vi.spyOn(Date, "now").mockReturnValue(startedAt);
+    try {
+      const first = await recoverAfterTransportDrop({ noTools: true, replaySafe: true });
+      now.mockReturnValue(startedAt + 5 * 60_000);
+      const next = await recoverAfterTransportDrop({
+        ...scenario,

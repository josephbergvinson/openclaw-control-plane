+          expect(completionDeliveryMocks.blockSubagentCompletionDelivery).not.toHaveBeenCalled();
+          return;
+        }
+        await waitForLifecycleState(() => expect(runs.size).toBe(0));
+        expect(externalWake).not.toHaveBeenCalled();
+        expect(
+          completionDeliveryMocks.blockSubagentCompletionDelivery,
+        ).toHaveBeenCalledExactlyOnceWith(
+          expect.objectContaining({
+            subagent: completed,
+            taskId: "task-completed",
+            disposition: "ambiguous",
+          }),
+        );
+        expect(tasks.get("pending")?.deliveryStatus).toBe("not_applicable");
+        expect(taskExecutorMocks.setDetachedTaskDeliveryStatusByRunId).not.toHaveBeenCalled();

index 0000000000000000000000000000000000000000..6ee72a9a67946dfec00aa7f507ff9849ab162d38
--- /dev/null
+++ b/src/agents/tools/sessions-send-owned-child.ts
@@ -0,0 +1,357 @@
+import { isDeepStrictEqual } from "node:util";
+import { resolveSessionStorePathCore } from "../../config/sessions/paths.js";
+import { loadSessionEntryReadOnly } from "../../config/sessions/session-accessor.js";
+import type { SessionEntry } from "../../config/sessions/types.js";
+import type { OpenClawConfig } from "../../config/types.openclaw.js";
+import { reactivateCompletedSubagentSession } from "../../gateway/session-subagent-reactivation.js";
+import {
+  getAgentEventLifecycleGeneration,
+  isAgentEventLifecycleGenerationCurrent,
+} from "../../infra/agent-events.js";
+import { formatErrorMessage } from "../../infra/errors.js";
+import type { InputProvenance } from "../../sessions/input-provenance.js";
+import {
+  buildRunUserTurnIdempotencyKey,
+  createUserTurnTranscriptRecorder,
+} from "../../sessions/user-turn-transcript.js";
+import { captureAgentToolSourceExecutionGuard } from "../agent-tool-source-execution-guard.js";
+import {
+  queueGuardedEmbeddedAgentMessageWithOutcomeAsync,
+  resolveActiveEmbeddedRunOwner,
+  resolveActiveEmbeddedRunOwnerByRunId,
+  type EmbeddedAgentQueueMessageOptions,
+} from "../embedded-agent-runner/runs.js";
+import {
+  assertMcpRequesterScopeMatches,
+  normalizeMcpRequesterScope,
+} from "../mcp-requester-scope.js";
+import type { SubagentCompletionToolHandoffRegistration } from "../subagents/announce/subagent-announce-handoff.js";
+import { getLatestSubagentRunByChildSessionKey } from "../subagents/registry/subagent-registry-read.js";
+import { loadSubagentSessionEntry } from "../subagents/registry/subagent-session-reconciliation.js";
+import { resolvePersistedSubagentToolPolicyEnvelope } from "../subagents/spawn/subagent-capabilities.js";
+import { getGatewayToolCallerIdentity } from "./gateway-caller-context.js";
+import type { AgentToolGatewayRequestCaller } from "./in-process-gateway.js";
+import { runWithScopedSessionAccess } from "./scoped-session-access.js";
+
+/** A detached one-way return keeps only this registered task's credential partition. */
+export function captureOwnedChildReplyHandoff(params: {
+  childSessionKey: string;
+  requesterSessionKey: string;
+  requesterAgentId?: string;
+  acceptedFollowupRunId?: string;
+}): Omit<SubagentCompletionToolHandoffRegistration, "idempotencyKey"> | undefined {
+  const source = getLatestSubagentRunByChildSessionKey(params.childSessionKey);
+  if (source?.requesterMcpScope === undefined) {
+    return undefined;
+  }
+  const scope = normalizeMcpRequesterScope(source.requesterMcpScope);
+  const identity = {
+    runId: source.runId,
+    taskRunId: source.taskRunId ?? source.runId,
+    acceptedFollowupRunId: params.acceptedFollowupRunId,
+    generation: source.generation,
+    createdAt: source.createdAt,
+    requesterSessionKey: source.requesterSessionKey,
+    requesterAgentId: source.requesterAgentId,
+    controllerSessionKey: source.controllerSessionKey,
+    requesterSessionId: source.completionRequesterSessionId,
+    childSessionKey: source.childSessionKey,
+  };
+  const child = loadSubagentSessionEntry({ childSessionKey: identity.childSessionKey });
+  const parent = loadSubagentSessionEntry({ childSessionKey: identity.requesterSessionKey });
+  const childSessionId = child?.sessionId;
+  const childRevision = child?.lifecycleRevision;
+  const parentRevision = parent?.lifecycleRevision;
+  const inheritedEnvelope = resolvePersistedSubagentToolPolicyEnvelope(identity.childSessionKey, {
+    store: child ? { [identity.childSessionKey]: child } : {},
+  });
+  const lifecycleGeneration = getAgentEventLifecycleGeneration();
+  const assertCurrent = () => {
+    const current = getLatestSubagentRunByChildSessionKey(identity.childSessionKey);
+    const sameRegistration =
+      current?.runId === identity.runId &&
+      current?.generation === identity.generation &&
+      current?.createdAt === identity.createdAt;
+    // Acceptance can precede completed-child reactivation. Only this accepted
+    // followup may inherit the existing task; unrelated successors revoke it.
+    const acceptedReactivation =
+      identity.acceptedFollowupRunId !== undefined &&
+      current?.runId === identity.acceptedFollowupRunId &&
+      current?.taskRunId === identity.taskRunId &&
+      identity.generation !== undefined &&
+      current?.generation === identity.generation + 1 &&
+      current.createdAt >= identity.createdAt;
+    if (
+      !scope ||
+      !inheritedEnvelope ||
+      !identity.generation ||
+      !identity.requesterSessionId ||
+      !childSessionId ||
+      !childRevision ||
+      !isAgentEventLifecycleGenerationCurrent(lifecycleGeneration) ||
+      !current ||
+      (!sameRegistration && !acceptedReactivation) ||
+      (current.taskRunId ?? current.runId) !== identity.taskRunId ||
+      current.childSessionKey !== identity.childSessionKey ||
+      current.requesterSessionKey !== identity.requesterSessionKey ||
+      current.requesterAgentId !== identity.requesterAgentId ||
+      current.controllerSessionKey !== identity.controllerSessionKey ||
+      current.completionRequesterSessionId !== identity.requesterSessionId ||
+      current.requesterSessionKey !== params.requesterSessionKey ||
+      current.requesterAgentId !== params.requesterAgentId ||
+      (current.controllerSessionKey ?? current.requesterSessionKey) !==
+        params.requesterSessionKey ||
+      current.expectsCompletionMessage !== true ||
+      current.collect === true ||
+      current.killIntent ||
+      current.killReconciliation ||
+      current.suppressCompletionDelivery === true ||
+      current.suppressAnnounceReason === "killed"
+    ) {
+      throw new Error("Child reply credential ownership is no longer current");
+    }
+    assertMcpRequesterScopeMatches(normalizeMcpRequesterScope(current.requesterMcpScope), scope);
+    const currentChild = loadSubagentSessionEntry({ childSessionKey: identity.childSessionKey });
+    const currentParent = loadSubagentSessionEntry({
+      childSessionKey: identity.requesterSessionKey,
+    });
+    if (
+      currentChild?.sessionId !== childSessionId ||
+      currentChild.lifecycleRevision !== childRevision ||
+      currentChild.archivedAt !== undefined ||
+      !isDeepStrictEqual(
+        resolvePersistedSubagentToolPolicyEnvelope(identity.childSessionKey, {
+          store: { [identity.childSessionKey]: currentChild },
+        }),
+        inheritedEnvelope,
+      ) ||
+      currentParent?.sessionId !== identity.requesterSessionId ||
+      currentParent.lifecycleRevision !== parentRevision ||
+      currentParent.archivedAt !== undefined ||
+      (currentChild.completionOwnerSessionKey ?? currentChild.spawnedBy) !==
+        identity.requesterSessionKey
+    ) {
+      throw new Error("Child reply session incarnation changed");
+    }
+  };
+  if (!identity.requesterSessionId) {
+    throw new Error("Child reply requester incarnation is unavailable");
+  }
+  assertCurrent();
+  return {
+    sourceRole: "subagent",
+    sourceSessionKey: identity.childSessionKey,
+    sourceSessionId: childSessionId,
+    targetSessionKey: identity.requesterSessionKey,
+    targetSessionId: identity.requesterSessionId,
+    mcpRequesterScope: scope,
+    mcpRequesterScopeAssertCurrent: assertCurrent,
+  };
+}
+
+/** Native parent follow-ups retain the existing task's durable completion owner. */
+export async function sendOwnedChildFollowup(params: {
+  cfg: OpenClawConfig;
+  targetEntry: SessionEntry;
+  targetAgentId: string;
+  targetSessionKey: string;
+  requesterSessionKey: string;
+  requesterAgentId: string;
+  requesterTurnRunId: string;
+  runId: string;
+  sendParams: Record<string, unknown> & { message: string; inputProvenance: InputProvenance };
+  callGateway: AgentToolGatewayRequestCaller;
+  signal?: AbortSignal;
+  mode?: "steer" | "followup";
+}) {
+  // Explicit steering uses the queue admission route without transferring custody.
+  if (params.mode === "steer") {
+    return undefined;
+  }
+  const source = getLatestSubagentRunByChildSessionKey(params.targetSessionKey);
+  if (
+    !source ||
+    // Ordinary explicit followup retains its separate-turn contract.
+    (params.mode === "followup" && !source.execution.transcriptTarget) ||
+    source.requesterSessionKey !== params.requesterSessionKey ||
+    source.requesterAgentId !== params.requesterAgentId ||
+    (source.controllerSessionKey ?? source.requesterSessionKey) !== params.requesterSessionKey ||
+    source.expectsCompletionMessage !== true ||
+    source.collect === true
+  ) {
+    return undefined;
+  }
+  const assertSourceActive = captureAgentToolSourceExecutionGuard(params.signal);
+  const gatewayContextResolver = getGatewayToolCallerIdentity()?.gatewayContextResolver;
+  const taskRunId = source.taskRunId ?? source.runId;
+  const previousRequesterSettleWake = source.requesterSettleWake
+    ? structuredClone(source.requesterSettleWake)
+    : undefined;
+  let runId = params.runId;
+  let sent = false;
+  try {
+    const { claimSubagentFollowup } = await import("../subagents/registry/subagent-registry.js");
+    return await runWithScopedSessionAccess({
+      cfg: params.cfg,
+      agentId: params.targetAgentId,
+      targetSessionKey: params.targetSessionKey,
+      expectedSessionId: params.targetEntry.sessionId,
+      signal: params.signal,
+      run: async () => {
+        const assertCurrent = () => {
+          assertSourceActive();
+          if (gatewayContextResolver && !gatewayContextResolver()) {
+            throw new Error("The Gateway owner ended before follow-up completion was attached");
+          }
+          const entry = loadSessionEntryReadOnly({
+            agentId: params.targetAgentId,
+            sessionKey: params.targetSessionKey,
+            storePath: resolveSessionStorePathCore(params.cfg.session?.store, {
+              agentId: params.targetAgentId,
+            }),
+          });
+          if (
+            entry?.sessionId !== params.targetEntry.sessionId ||
+            entry?.lifecycleRevision !== params.targetEntry.lifecycleRevision ||
+            entry?.archivedAt !== undefined
+          ) {
+            throw new Error("Child session changed before follow-up delivery");
+          }
+          const current = getLatestSubagentRunByChildSessionKey(params.targetSessionKey);
+          if (
+            !current ||
+            (current.taskRunId ?? current.runId) !== taskRunId ||
+            current.requesterSessionKey !== params.requesterSessionKey ||
+            current.killIntent ||
+            current.killReconciliation
+          ) {
+            throw new Error("Child completion owner changed before follow-up delivery");
+          }
+          return current;
+        };
+        const current = assertCurrent();
+        const active =
+          resolveActiveEmbeddedRunOwnerByRunId(current.runId) ??
+          resolveActiveEmbeddedRunOwner(params.targetEntry.sessionId);
+        let targetDisposition: "queued" | "steered";
+        if (active) {
+          if (active.runId !== current.runId) {
+            throw new Error(
+              "The active child run does not own its registered completion; follow-up was not sent",
+            );
+          }
+          runId = active.runId;
+          const canInject = () => {
+            const owner = assertCurrent();
+            return (
+              owner.runId === runId &&
+              resolveActiveEmbeddedRunOwner(active.sessionId)?.runId === runId
+            );
+          };
+          const queueOptions: EmbeddedAgentQueueMessageOptions = {
+            steeringMode: "all",
+            debounceMs: 0,
+            waitForTranscriptCommit: true,
+            // Steering retains this child's existing completion audience and
+            // delivery mode; it does not start a source-only A2A turn.
+            userTurnTranscriptRecorder: createUserTurnTranscriptRecorder({
+              input: {
+                text: params.sendParams.message,
+                provenance: params.sendParams.inputProvenance,
+                idempotencyKey: buildRunUserTurnIdempotencyKey(params.runId),
+              },
+              target: {
+                sessionId: active.sessionId,
+                expectedSessionId: active.sessionId,
+                sessionKey: active.sessionKey ?? params.targetSessionKey,
+                sessionEntry:
+                  active.sessionId === params.targetEntry.sessionId
+                    ? params.targetEntry
+                    : undefined,
+                agentId: params.targetAgentId,
+                storePath:
+                  current.execution.transcriptTarget?.storePath ??
+                  resolveSessionStorePathCore(params.cfg.session?.store, {
+                    agentId: params.targetAgentId,
+                  }),
+                config: params.cfg,
+              },
+            }),
+          };
+          let queued = await queueGuardedEmbeddedAgentMessageWithOutcomeAsync(
+            active.sessionId,
+            params.sendParams.message,
+            queueOptions,
+            canInject,
+          );
+          if (!queued.queued && queued.reason === "transcript_commit_wait_unsupported") {
+            delete queueOptions.waitForTranscriptCommit;
+            queued = await queueGuardedEmbeddedAgentMessageWithOutcomeAsync(
+              active.sessionId,
+              params.sendParams.message,
+              queueOptions,
+              canInject,
+            );
+          }
+          if (!queued.queued) {
+            throw new Error(`Child follow-up was not sent: ${queued.reason}`);
+          }
+          sent = true;
+          targetDisposition = "steered";
+        } else {
+          if (current.execution.endedAt === undefined) {
+            throw new Error("The child run is still starting or settling; follow-up was not sent");
+          }
+          const response = await params.callGateway<{ runId?: string }>({
+            method: "agent",
+            params: params.sendParams,
+            timeoutMs: 10_000,
+          });
+          sent = true;
+          runId = response.runId?.trim() || runId;
+          assertCurrent();
+          // Gateway acceptance precedes execution-phase reactivation. Complete
+          // that same transition here before promising a yieldable follow-up.
+          await reactivateCompletedSubagentSession({
+            sessionKey: params.targetSessionKey,
+            runId,
+            task: params.sendParams.message,
+            gatewayContextResolver,
+          });
+          targetDisposition = "queued";
+        }
+        assertCurrent();
+        const completion = claimSubagentFollowup({
+          runId,
+          taskRunId,
+          childSessionKey: params.targetSessionKey,
+          requesterSessionKey: params.requesterSessionKey,
+          requesterAgentId: params.requesterAgentId,
+          requesterTurnRunId: params.requesterTurnRunId,
+          previousRunId: source.runId,
+          previousRequesterSettleWake,
+        });
+        if (!completion) {
+          throw new Error("Child completion ownership could not be attached to this turn");
+        }
+        return {
+          status: "accepted" as const,
+          runId,
+          targetDisposition,
+          childSessionKey: completion.childSessionKey,
+          completionRunId: completion.runId,
+          expectsCompletionMessage: true as const,
+          ...(completion.completionSpawns ? { completionSpawns: completion.completionSpawns } : {}),
+          delivery: { status: "pending" as const, mode: "announce" as const },
+        };
+      },
+    });
+  } catch (error) {
+    return {
+      status: "error" as const,
+      runId,
+      error: `${formatErrorMessage(error)}${sent ? ". The follow-up was already accepted; do not resend it." : ""}`,
+      ...(sent ? { sentBeforeError: true as const } : {}),
+    };
+  }
+}
diff --git a/src/agents/tools/sessions-send-progress.ts b/src/agents/tools/sessions-send-progress.ts

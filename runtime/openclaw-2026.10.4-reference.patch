+  if (captureOrigin && !captureOrigin.isCurrent()) {
+    return { ok: false, message: "Discord voice join was cancelled." };
+  }
+  if (!result.ok) {
+    params.logger.warn(
+      `discord voice: autoJoin skipped guild=${entry.guildId} channel=${entry.channelId}: ${result.message}`,
+    );
+    retainDiscordVoiceAutoJoinFatalFailure(params.fatalAutoJoinFailures, entry, result.message);
+  }
+  return result;
+}
diff --git a/extensions/discord/src/voice/voice-conversation-input.test.ts b/extensions/discord/src/voice/voice-conversation-input.test.ts

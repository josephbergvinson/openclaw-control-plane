+  options: BrowserConfidentialReadOptions & { ai?: boolean } = {},
+): Promise<boolean> {
+  const budget = confidentialReadBudget(options);
+  const confidential = await hasBrowserConfidentialFields(page, {
+    ...options,
+    ...budget.current(),

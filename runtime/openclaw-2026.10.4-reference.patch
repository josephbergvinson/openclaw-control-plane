+        }
+        var clock: TimeInterval = 100
+        #expect(Self.locateHosted(
+            nodes,
+            direct: nil,
+            result: .noValue,
+            hostBundle: "com.google.Chrome",
+            read: { element, _ in
+                if fixture == "deadline" { clock += 1 }
+                return nodes[element]
+            }, now: { clock }) == nil)
+    }
+
+    @Test(arguments: [
+        "missing-direct", "failed-direct", "disabled", "not-implemented", "generic-failure", "invalid-element",
+        "no-value-with-window",
+        "unsupported-with-window",
+    ])
+    func `hosted lookup rejects inconsistent or unsafe direct AX results without reading parents`(_ change: String) {
+        var reads = 0
+        let result: AXError = switch change {
+        case "failed-direct": .cannotComplete
+        case "disabled": .apiDisabled
+        case "not-implemented": .notImplemented
+        case "generic-failure": .failure
+        case "invalid-element": .invalidUIElement
+        case "no-value-with-window": .noValue
+        case "unsupported-with-window": .attributeUnsupported
+        default: .success
+        }
+        let direct: Int? = [
+            "missing-direct", "failed-direct", "disabled", "not-implemented", "generic-failure", "invalid-element",
+        ].contains(change) ? nil : 2
+        let window = Self.locateHosted(
+            Self.hostedChain(),
+            direct: direct,
+            result: result,
+            read: { element, _ in
+                reads += 1
+                return Self.hostedChain()[element]
+            })
+        #expect(window == nil)
+        #expect(reads == 0)
+    }
+
+    @Test(arguments: [
+        "missing-field", "wrong-bundle", "missing-owner", "missing-host", "same-owner",
+    ], [AXError.success, .noValue, .attributeUnsupported])
+    func `hosted direct and parent lookup require the same focused field and process identities`(
+        _ change: String,
+        _ error: AXError)
+    {
+        var reads = 0
+        let relationship = Self.locateHosted(
+            Self.hostedChain(),
+            direct: error == .success ? 2 : nil,
+            result: error,
+            bundle: change == "wrong-bundle" ? "com.apple.Safari" : "com.apple.AuthenticationServices.Helper",
+            field: change == "missing-field" ? nil : 0,
+            ownerPID: change == "missing-owner" ? 0 : 42,
+            hostPID: change == "missing-host" ? 0 : change == "same-owner" ? 42 : 43,
+            read: { element, _ in
+                reads += 1
+                return Self.hostedChain()[element]
+            })
+        #expect(relationship == nil)
+        #expect(reads == 0)
+    }
+
+    @Test(arguments: [
+        "nonsecure", "nonfield", "field-owner", "group-owner", "group-role", "group-subrole", "sheet-owner",
+        "sheet-role", "wrong-direct-sheet", "ancestor-owner", "web-area", "window-owner", "missing-parent",
+        "metadata-failure", "cycle", "depth-budget", "time-budget", "read-time-budget",
+    ], [AXError.success, .noValue, .attributeUnsupported])
+    func `hosted lookup rejects unrelated malformed or unbounded relationships`(_ change: String, _ error: AXError) {
+        var nodes = Self.hostedChain()
+        switch change {
+        case "nonsecure":
+            nodes[0] = .init(role: "AXTextField", subrole: nil, ownerPID: 42, parent: 1)
+        case "nonfield":
+            nodes[0] = .init(role: "AXButton", subrole: "AXSecureTextField", ownerPID: 42, parent: 1)
+        case "field-owner":
+            nodes[0] = .init(role: "AXTextField", subrole: "AXSecureTextField", ownerPID: 43, parent: 1)
+        case "group-owner":
+            nodes[1] = .init(role: "AXGroup", subrole: "AXHostingView", ownerPID: 44, parent: 2)
+        case "group-role":
+            nodes[1] = .init(role: "AXSheet", subrole: "AXHostingView", ownerPID: 43, parent: 2)
+        case "group-subrole":
+            nodes[1] = .init(role: "AXGroup", subrole: nil, ownerPID: 43, parent: 2)
+        case "sheet-owner":
+            nodes[2] = .init(role: "AXSheet", subrole: nil, ownerPID: 44, parent: 3)
+        case "sheet-role":
+            nodes[2] = .init(role: "AXWindow", subrole: nil, ownerPID: 43, parent: 3)
+        case "ancestor-owner":
+            nodes[3] = .init(role: "AXSheet", subrole: nil, ownerPID: 44, parent: 4)
+        case "web-area":
+            nodes[3] = .init(role: "AXWebArea", subrole: nil, ownerPID: 43, parent: 4)
+        case "window-owner":
+            nodes[5] = .init(role: "AXWindow", subrole: "AXStandardWindow", ownerPID: 42, parent: nil)
+        case "missing-parent":
+            nodes[1] = .init(role: "AXGroup", subrole: "AXHostingView", ownerPID: 43, parent: nil)
+        case "metadata-failure":
+            nodes.removeValue(forKey: 3)
+        case "cycle":
+            nodes[4] = .init(role: "AXSheet", subrole: nil, ownerPID: 43, parent: 2)
+        case "depth-budget":
+            for index in 3...15 {
+                nodes[index] = .init(role: "AXGroup", subrole: nil, ownerPID: 43, parent: index + 1)
+            }
+            nodes[16] = .init(role: "AXWindow", subrole: "AXStandardWindow", ownerPID: 43, parent: nil)
+        default:
+            break
+        }
+        var clock: TimeInterval = 100
+        let window = Self.locateHosted(
+            nodes,
+            direct: change == "wrong-direct-sheet" ? 3 : error == .success ? 2 : nil,
+            result: error,
+            read: { element, _ in
+                if change == "read-time-budget" { clock += 1 }
+                return nodes[element]
+            }, now: {
+                defer { if change == "time-budget" { clock += 1 } }
+                return clock
+            })
+        #expect(window == nil)
+    }
+
+    @Test(arguments: ["outer-window", "direct-sheet"])
+    func `hosted rediscovery does not preserve a replaced captured relationship`(_ change: String) {
+        let captured = Self.locateHosted(Self.hostedChain())
+        var changed = Self.hostedChain()
+        if change == "outer-window" {
+            changed[4] = .init(role: "AXSheet", subrole: nil, ownerPID: 43, parent: 6)
+            changed[6] = .init(role: "AXWindow", subrole: "AXStandardWindow", ownerPID: 43, parent: nil)
+        } else {
+            changed[1] = .init(role: "AXGroup", subrole: "AXHostingView", ownerPID: 43, parent: 6)
+            changed[6] = .init(role: "AXSheet", subrole: nil, ownerPID: 43, parent: 3)
+        }
+        #expect(captured?.window == 5)
+        #expect(Self.locateHosted(changed)?.window != captured?.window)
+    }
+
+    @Test(arguments: ["group", "sheet", "outer-window"], [AXError.noValue, .attributeUnsupported])
+    func `parent lookup captures replacement identities even when the outer window stays unchanged`(
+        _ change: String,
+        _ error: AXError)
+    {
+        let captured = Self.locateHosted(Self.hostedChain(), direct: nil, result: error)
+        var changed = Self.hostedChain()
+        switch change {
+        case "group":
+            changed[0] = .init(role: "AXTextField", subrole: "AXSecureTextField", ownerPID: 42, parent: 6)
+            changed[6] = .init(role: "AXGroup", subrole: "AXHostingView", ownerPID: 43, parent: 2)
+        case "sheet":
+            changed[1] = .init(role: "AXGroup", subrole: "AXHostingView", ownerPID: 43, parent: 6)
+            changed[6] = .init(role: "AXSheet", subrole: nil, ownerPID: 43, parent: 3)
+        default:
+            changed[4] = .init(role: "AXSheet", subrole: nil, ownerPID: 43, parent: 6)
+            changed[6] = .init(role: "AXWindow", subrole: "AXStandardWindow", ownerPID: 43, parent: nil)
+        }
+        let rediscovered = Self.locateHosted(changed, direct: nil, result: error)
+        #expect(captured?.group == 1)
+        #expect(captured?.sheet == 2)
+        #expect(captured?.window == 5)
+        #expect(rediscovered?.group == (change == "group" ? 6 : 1))
+        #expect(rediscovered?.sheet == (change == "sheet" ? 6 : 2))
+        #expect(rediscovered?.window == (change == "outer-window" ? 6 : 5))
+    }
+}
diff --git a/apps/macos/Tests/OpenClawIPCTests/NativeCredentialResolverTests.swift b/apps/macos/Tests/OpenClawIPCTests/NativeCredentialResolverTests.swift

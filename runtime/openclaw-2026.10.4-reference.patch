+    runId: `cron-child-${generation}`,
+    requesterSessionKey: key,
+    requesterAgentId: "main",
+    completionRequesterSessionId: "original-session",
+    completionRequesterLifecycleRevision: "original-v1",
+    completion: { required: true, resultText: `verified child findings ${generation}` },
+    requesterSettleWake: {
+      status: "pending",
+      attemptCount: 0,
+      requesterYieldBatch: true,
+      yieldedFinalDeliverable: true,
+      rearmGeneration: generation,
+      batchRunIds: [`cron-child-${generation}`],
+    },
+  });
+  registryRuntimeMock.listSubagentRunsForRequester.mockReturnValue([child]);
+  return child;
+}

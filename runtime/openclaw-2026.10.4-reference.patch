+          expect(context[1]?.[1].value).toContain(`current route ${id}`);
+          expect(JSON.stringify(context)).not.toContain(`quote ${id === "A" ? "B" : "A"}`);
+          const text = request.input
+            .flatMap((item) => (item.type === "text" ? [item.text] : []))
+            .join("\n");
+          expect(text).toContain(`source ${id}`);
+          expect(text).not.toContain("quote");
+          expect(
+            sources[index]!.followupRun.turnAdoptionLifecycle.onAdopted,
+          ).toHaveBeenCalledOnce();
+          expect(
+            sources[index]!.followupRun.turnAdoptionLifecycle.onSettled,
+          ).toHaveBeenCalledOnce();
+          expect(sources[index]!.runFollowup).not.toHaveBeenCalled();
+        }
+        const saved = await readTranscriptMessagesByIdentity(params);
+        for (const id of ["A", "B"]) {
+          expect(saved.filter((message) => message.content === `source ${id}`)).toHaveLength(1);
+        }
+        expect(JSON.stringify(saved)).not.toContain("quote A");
+        expect(JSON.stringify(saved)).not.toContain("quote B");
+        await harness.completeTurn({ threadId: "thread-1", turnId: "turn-1" });
+        await run;
+      });
+    } finally {
+      release.resolve();
+      abort.abort();
+      await run?.catch(() => {});
+      closeHost?.();
+      clearFollowupQueueForTest(key);
+      unregister();
+    }
+  });
+});

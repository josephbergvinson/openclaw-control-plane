+  revokeMessageActionTurnCapability,
+} from "../message-action-turn-capability.js";
+import { createDirectChatContext } from "../server-chat.agent-events.test-helpers.js";
+import { createSecretsHandlers, createSecretStoreWriteService } from "./secrets.js";
+import type { GatewayClient, RespondFn } from "./types.js";
+
+type ProvidedSource = NonNullable<
+  Parameters<typeof mintMessageActionTurnCapability>[0]["providedUserSource"]
+>;
+
+export function createProvidedInputStore(options: {
+  source?: ProvidedSource;
+  token?: string;
+  runId?: string;
+  sessionKey?: string;
+  sessionId?: string;
+  config?: OpenClawConfig;
+  channel?: boolean;
+  currentChannelId?: string;
+  currentMessagingTarget?: string;
+}) {
+  const runId = options.runId ?? "provided-input-run";
+  const sessionKey = options.sessionKey ?? "agent:main:main";
+  const sessionId = options.sessionId ?? "provided-input-session";
+  const authority = claimAgentRunDelegatedAuthority({
+    instanceId: "provided-input-instance",
+    runId,
+  });
+  const token =
+    options.token ??
+    mintMessageActionTurnCapability({
+      agentId: "main",
+      runId,
+      sessionKey,
+      sessionId,
+      providedUserSource: options.source,
+      ...(options.channel
+        ? {
+            requesterAccountId: "provided-account",
+            requesterSenderId: "provided-owner",
+            toolContext: {
+              currentChannelProvider: "discord" as const,
+              currentChannelId: options.currentChannelId ?? "channel:provided-channel",
+              ...(options.currentMessagingTarget !== undefined
+                ? { currentMessagingTarget: options.currentMessagingTarget }
+                : {}),
+              currentMessageId: "provided-message",
+            },
+          }
+        : {}),
+    });
+  const messageActionContext = resolveMessageActionTurnCapability({
+    token,
+    agentId: "main",
+    runId,
+    sessionKey,
+    sessionId,
+  });
+  if (!messageActionContext) {
+    throw new Error("Expected exact test turn capability");
+  }
+  const identity: AgentRuntimeIdentity = {
+    kind: "agentRuntime",
+    agentId: "main",
+    sessionKey,
+    operationalRunInstance: authority.operationalRunInstance,
+    delegatedAuthority: { kind: "local", ...authority },
+    messageActionContext: { ...messageActionContext, turnCapability: token },
+  };
+  const client: GatewayClient = {
+    connId: "provided-input-store-client",
+    connect: {
+      minProtocol: 1,
+      maxProtocol: 1,
+      role: "operator",
+      scopes: ["operator.admin"],
+      client: { id: "openclaw-control-ui", version: "test", platform: "web", mode: "webchat" },
+    },
+    internal: { agentRuntimeIdentity: identity },
+  };
+  const config = options.config ?? {};
+  const context = createDirectChatContext({
+    getRuntimeConfig: () => config,
+    validateAgentRuntimeApprovalAuthority: createAgentRuntimeApprovalAuthorityValidator(),
+  });
+  const reloadSecrets = vi.fn(async () => ({ warningCount: 0 }));
+  const storeWriteService = createSecretStoreWriteService({ reloadSecrets });
+  const handlers = createSecretsHandlers({
+    reloadSecrets,
+    storeWriteService,
+    resolveSecrets: async () => ({ assignments: [], diagnostics: [], inactiveRefPaths: [] }),
+  });
+  const requests: { method: string; params: unknown }[] = [];
+  const invoke = async (method: string, params: Record<string, unknown>) => {
+    const handler = handlers[method];
+    if (!handler) {
+      throw new Error("Expected existing secret Gateway method");
+    }
+    const responses: Parameters<RespondFn>[] = [];
+    await handler({
+      req: { type: "req", id: "provided-store-rpc", method },
+      params,
+      client,
+      context,
+      isWebchatConnect: () => false,
+      respond: (...args) => responses.push(args),
+    });
+    return responses[0];
+  };
+  return {
+    token,
+    identity,
+    client,
+    authority,
+    storeWriteService,
+    requests,
+    invoke,
+    gatewayCall: async (
+      method: string,
+      _options: unknown,
+      params: unknown,
+      callOptions?: { signal?: AbortSignal },
+    ) => {
+      callOptions?.signal?.throwIfAborted();
+      requests.push({ method, params });
+      if (typeof params !== "object" || params === null || Array.isArray(params)) {
+        throw new Error("Expected metadata-only Gateway arguments");
+      }
+      // SAFETY: the checked plain argument object is the unchanged native RPC request.
+      const response = await invoke(method, params as Record<string, unknown>);
+      if (!response?.[0]) {
+        throw new Error(response?.[2]?.message ?? "Native secret RPC rejected");
+      }
+      return response[1];
+    },
+    close: () => {
+      revokeMessageActionTurnCapability(token);
+      releaseAgentRunDelegatedAuthority(authority);
+      clearAgentRunContext(runId);
+    },
+  };
+}

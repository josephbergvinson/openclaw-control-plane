+/** Passive observation works even when the real plugin loader owns a separate module copy. */
+function observeNativeHttp(requests: NativeRequest[], errors: unknown[]) {
+  const pending = new Set<Promise<void>>();
+  const observations = new WeakMap<
+    http.IncomingMessage,
+    (event: string | symbol, args: readonly unknown[]) => void
+  >();
+  const diagnostics = channel("http.server.request.start");
+  // A data listener would start flow before the production proxy has acquired
+  // upload admission. Tap only emissions its own reader already causes.
+  const prototype = http.IncomingMessage.prototype;
+  const descriptor = Object.getOwnPropertyDescriptor(prototype, "emit");
+  // oxlint-disable-next-line typescript/unbound-method -- Reflect.apply below supplies each actual IncomingMessage receiver.
+  const emit = prototype.emit;
+  // A mock recorder would retain every raw Buffer and request receiver. This
+  // reversible call-through owns no history beyond each bounded observation.
+  const observedEmit: typeof emit = function (
+    this: http.IncomingMessage,
+    event: string | symbol,
+    ...args: unknown[]
+  ) {
+    try {
+      observations.get(this)?.(event, args);
+    } catch (error) {
+      errors.push(error);
+    }
+    return Reflect.apply(emit, this, [event, ...args]);
+  };
+  Object.defineProperty(
+    prototype,
+    "emit",
+    descriptor && !("value" in descriptor)
+      ? { ...descriptor, get: () => observedEmit }
+      : { configurable: true, writable: true, ...descriptor, value: observedEmit },
+  );
+  const observe = (message: unknown) => {
+    if (!record(message) || !(message.request instanceof http.IncomingMessage)) {
+      return;
+    }
+    const req = message.request;
+    if (req.method !== "POST" || !req.url?.endsWith("/responses")) {
+      return;
+    }
+    const task = new Promise<void>((resolve) => {
+      const chunks: Buffer[] = [];
+      let length = 0;
+      const settle = () => {
+        observations.delete(req);
+        resolve();
+      };
+      observations.set(req, (event, args) => {
+        if (event === "data") {
+          const part = args[0];
+          if (!Buffer.isBuffer(part) && typeof part !== "string") {
+            throw new Error("Unexpected native HTTP body chunk");
+          }
+          const bytes = Buffer.isBuffer(part) ? part : Buffer.from(part);
+          length += bytes.length;
+          if (length <= MAX_BODY_BYTES) {
+            chunks.push(Buffer.from(bytes));
+          }
+        } else if (event === "error") {
+          errors.push(args[0]);
+          settle();
+        } else if (event === "close") {
+          settle();
+        } else if (event === "end") {
+          try {
+            expect(length).toBeLessThanOrEqual(MAX_BODY_BYTES);
+            const body = decodeBody(Buffer.concat(chunks), req.headers["content-encoding"]);
+            if (
+              body !== null &&
+              typeof body === "object" &&
+              !Array.isArray(body) &&
+              record(body.client_metadata) &&
+              metadata.CODEX_PREPARED_INPUT_KEY in body.client_metadata
+            ) {
+              const native = metadata.readCodexInferenceMetadata(body, req.headers);
+              if (!native.preparedInput || !native.threadId || !native.generation) {
+                throw new Error("Actual native request omitted its prepared generation/fact");
+              }
+              requests.push({
+                fact: native.preparedInput,
+                threadId: native.threadId,
+                generation: native.generation,
+                input: JSON.stringify(body.input),
+              });
+            }
+          } catch (error) {
+            errors.push(error);
+          } finally {
+            settle();
+          }
+        }
+      });
+    });
+    pending.add(task);
+    void task.finally(() => pending.delete(task));
+  };
+  diagnostics.subscribe(observe);
+  return async () => {
+    diagnostics.unsubscribe(observe);
+    try {
+      await Promise.all(pending);
+    } finally {
+      if (descriptor) {
+        Object.defineProperty(prototype, "emit", descriptor);
+      } else {
+        Reflect.deleteProperty(prototype, "emit");
+      }
+    }
+  };
+}

+import { beforeEach, expect, it, vi } from "vitest";
+import { runTranscriptRecordConsult } from "./summary-record-consult.js";
+
+const { agentRuntime, createRuntimeAgent, consultRealtimeVoiceAgent } = vi.hoisted(() => ({

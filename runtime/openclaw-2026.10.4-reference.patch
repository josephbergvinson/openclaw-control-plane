+}));
+
+const musicRequestText = "Make the music more punchy and momentous, and fit it to the video.";
+const musicRequest: PersistedUserTurnMessage = {
+  role: "user",
+  content: musicRequestText,
+  timestamp: 1,
+  idempotencyKey: "channel-user:music-correction",
+  __openclaw: {
+    senderIsOwner: true,
+    senderId: "requester",
+    transport: { channel: "discord", messageId: "music-correction" },
+  },
+};
+
+const completionProvenance: InputProvenance = {
+  kind: "inter_session",
+  sourceSessionKey: "agent:main:subagent:old-child",
+  sourceChannel: "internal",
+  sourceTool: "subagent_settle",
+};
+
+const privateCompletionText =
+  "Every child has settled. Process the old result privately; reply NO_REPLY if done.";
+const privateCompletion: PersistedUserTurnMessage = {
+  role: "user",
+  display: false,
+  content: privateCompletionText,
+  timestamp: 2,
+  idempotencyKey: "announce:requester-settle:old-child:user",
+  provenance: completionProvenance,
+  __openclaw: { senderIsOwner: false },
+};
+
+describe("prepared completion orphan custody", () => {
+  it("retains an authenticated request across a prepared private completion and restart", async () => {
+    await withOpenClawTestState({ label: "prepared-completion-orphan" }, async (state) => {
+      const target = {
+        agentId: "main",
+        sessionId: "music-session",
+        sessionKey: "agent:main:music-session",
+        storePath: path.join(state.sessionsDir(), "sessions.sqlite"),
+      };
+      await upsertSessionEntryCore(target, { sessionId: target.sessionId, updatedAt: 1 });
+      const seed = SessionManager.open(target, state.workspaceDir);
+      const sourceEntryId = seed.appendMessage(musicRequest);
+      const manager = guardSessionManager(SessionManager.open(target, state.workspaceDir), {
+        runId: "private-completion",
+        inputProvenance: completionProvenance,
+        preparedUserTurnMessage: privateCompletion,
+      });
+      const activeSession = {
+        agent: new Agent({ initialState: { messages: manager.buildSessionContext().messages } }),
+      };
+      const boundary = await prepareEmbeddedAttemptSessionBoundary({
+        activeSession,
+        attempt: {
+          sessionId: target.sessionId,
+          inputProvenance: completionProvenance,
+          prompt: privateCompletionText,
+          trigger: "user",
+        },
+        getUserTranscriptContexts: () => undefined,
+        isRawModelRun: false,
+        preparedUserTurnMessage: privateCompletion,
+        sessionManager: manager,
+        setActiveSessionSystemPrompt: (prompt) => {
+          activeSession.agent.state.systemPrompt = prompt;
+        },
+      });
+      assert(boundary.orphanRepair);
+      expect(boundary.orphanRepair.contextEnginePrompt).toContain(musicRequestText);
+
+      // Use the real prepared-message writer: a model-only merged prompt cannot
+      // replace the private completion's accepted source bytes or principal.
+      manager.appendMessage({
+        role: "user",
+        content: boundary.orphanRepair.contextEnginePrompt,
+        timestamp: privateCompletion.timestamp,
+      });
+      const reopened = SessionManager.open(target, state.workspaceDir);
+      const messages = reopened.buildSessionContext().messages;
+      expect(messages).toEqual([musicRequest, privateCompletion]);
+      expect(reopened.getBranch().filter((entry) => entry.id === sourceEntryId)).toHaveLength(1);
+      expect(messages.filter((message) => message.role === "user")).toHaveLength(2);
+    });
+  });
+
+  it("still detaches a stale internal orphan instead of replaying it as a user request", async () => {
+    await withOpenClawTestState({ label: "prepared-completion-internal-orphan" }, async (state) => {
+      const target = {
+        agentId: "main",
+        sessionId: "internal-session",
+        sessionKey: "agent:main:internal-session",
+        storePath: path.join(state.sessionsDir(), "sessions.sqlite"),
+      };
+      await upsertSessionEntryCore(target, { sessionId: target.sessionId, updatedAt: 1 });
+      const seed = SessionManager.open(target, state.workspaceDir);
+      const staleCompletion: PersistedUserTurnMessage = {
+        ...privateCompletion,
+        content: "Old child result that must not become the new request.",
+        idempotencyKey: "announce:stale-child:user",
+      };
+      const staleEntryId = seed.appendMessage(staleCompletion);
+      const manager = guardSessionManager(SessionManager.open(target, state.workspaceDir), {
+        runId: "private-completion",
+        inputProvenance: completionProvenance,
+        preparedUserTurnMessage: privateCompletion,
+      });
+      const activeSession = {
+        agent: new Agent({ initialState: { messages: manager.buildSessionContext().messages } }),
+      };
+      const boundary = await prepareEmbeddedAttemptSessionBoundary({
+        activeSession,
+        attempt: {
+          sessionId: target.sessionId,
+          inputProvenance: completionProvenance,
+          prompt: privateCompletionText,
+          trigger: "user",
+        },
+        getUserTranscriptContexts: () => undefined,
+        isRawModelRun: false,
+        preparedUserTurnMessage: privateCompletion,
+        sessionManager: manager,
+        setActiveSessionSystemPrompt: (prompt) => {
+          activeSession.agent.state.systemPrompt = prompt;
+        },
+      });
+      assert(boundary.orphanRepair);
+      expect(boundary.orphanRepair.removeLeaf).toBe(true);
+      manager.appendMessage({
+        role: "user",
+        content: boundary.orphanRepair.contextEnginePrompt,
+        timestamp: privateCompletion.timestamp,
+      });
+      const reopened = SessionManager.open(target, state.workspaceDir);
+      expect(reopened.getBranch().some((entry) => entry.id === staleEntryId)).toBe(false);
+      expect(reopened.buildSessionContext().messages).toEqual([privateCompletion]);
+    });
+  });
+});

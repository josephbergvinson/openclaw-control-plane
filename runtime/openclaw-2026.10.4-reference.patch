+        const client = createOperatorClient({
+          profileName: "queued-original",
+          scopes: mode === "missing permission" ? ["operator.read"] : ["operator.write"],
+        });
+        const key = "agent:main:subagent:queued-original";
+        await upsertSessionEntryCore(
+          { agentId: "main", sessionKey: key },
+          { sessionId: "original-child", lifecycleRevision: "original-child-v1" },
+        );
+        const params = bindInProcessSessionRun(
+          {
+            message: "continue original task",
+            sessionKey: key,
+            idempotencyKey: "queued-original-run",
+          },

+    admission.close();
+  }
+}
+
+function correction(fingerprint: string, messageId: string): ActiveReplySteerParams {
+  const typing = createMockTypingController();
+  const followupRun = createQueueTestRun({
+    prompt: "Apply this owner's correction before the final answer",
+    messageId,
+    originatingChannel: "discord",
+    originatingTo: "channel:direct-requester-steer",
+    currentInboundEventKind: "user_request",
+  });
+  followupRun.run = {
+    ...followupRun.run,
+    agentId: "main",
+    sessionId,
+    sessionKey,
+    senderIsOwner: true,
+    messageProvider: "discord",
+  };
+  followupRun.turnAdoptionLifecycle = {
+    onAdopted: vi.fn(async () => {}),
+    onSettled: vi.fn(),
+  };
+  return {
+    followupRun,
+    opts: {},
+    providedReplyOperation: undefined,
+    queueKey: sessionKey,
+    releaseAdmissionTicket: vi.fn(),
+    replyOperationRunState: {},
+    resolvedQueue: { mode: "steer", debounceMs: 0 },
+    restartRecoverySourceTurnId: "discord:" + messageId,
+    runFollowup: vi.fn(async () => {}),
+    sessionCtx: { InboundEventKind: "user_request" },
+    sessionKey,
+    touchActiveSessionEntry: vi.fn(async () => {}),
+    typing,
+    typingSignals: createTypingSignaler({ typing, mode: "never", isHeartbeat: false }),
+    toolAuthorityFingerprint: fingerprint,
+  };
+}
+
+describe("direct requester continuation steering", () => {
+  it("adopts an owner correction through the live admitted target without a reply operation", async ({
+    signal,
+  }) => {
+    await withDirectRequester(async (owner) => {
+      const input = correction(owner.fingerprint, "owner-correction");
+      expect(replyRunRegistry.get(sessionKey)).toBeUndefined();
+      expect(replyRunRegistry.resolveCurrentMessageInjectionTarget(sessionKey)?.runId).toBe(runId);
+      const pending = runActiveReplySteer(input);
+      try {
+        await withinTest(
+          awaitGateBeforeSettlement(
+            owner.entered.promise,
+            pending,
+            "The correction settled without reaching the active direct requester",
+          ),
+          signal,
+        );
+        expect(input.runFollowup).not.toHaveBeenCalled();
+        expect(input.followupRun.turnAdoptionLifecycle?.onAdopted).not.toHaveBeenCalled();
+        owner.release.resolve();
+        await expect(pending).resolves.toBe("handled");
+        expect(owner.injected).toHaveBeenCalledExactlyOnceWith(
+          input.followupRun.prompt,
+          expect.objectContaining({
+            isInboundUserMessage: true,
+            steeringMode: "all",
+            waitForTranscriptCommit: true,
+            queueIdentity: "discord:owner-correction",
+          }),
+          expect.any(Function),
+          "run",
+        );
+        expect(input.followupRun.turnAdoptionLifecycle?.onAdopted).toHaveBeenCalledOnce();
+        expect(input.followupRun.turnAdoptionLifecycle?.onSettled).toHaveBeenCalledOnce();
+        expect(input.replyOperationRunState?.admission).toEqual({
+          status: "accepted",
+          mode: "steer",
+        });
+        expect(getExistingFollowupQueue(sessionKey)?.items ?? []).toEqual([]);
+        expect(input.runFollowup).not.toHaveBeenCalled();
+        expect(replyRunRegistry.get(sessionKey)).toBeUndefined();
+      } finally {
+        owner.release.resolve();
+        clearFollowupQueueForTest(sessionKey);
+        await pending.catch(() => undefined);
+      }
+    });
+  });
+
+  it("does not retarget or replay a captured direct correction after backend replacement", async ({
+    signal,
+  }) => {
+    await withDirectRequester(async (owner) => {
+      const input = correction(owner.fingerprint, "replacement-correction");
+      const pending = runActiveReplySteer(input);
+      try {
+        await withinTest(
+          awaitGateBeforeSettlement(
+            owner.entered.promise,
+            pending,
+            "The correction settled before its captured direct target was entered",
+          ),
+          signal,
+        );
+        const replacementInjected = owner.replace();
+        owner.release.resolve();
+        await expect(pending).rejects.toBeInstanceOf(MessageInjectionAuthorityError);
+        expect(owner.injected).toHaveBeenCalledOnce();
+        expect(replacementInjected).not.toHaveBeenCalled();
+        expect(input.runFollowup).not.toHaveBeenCalled();
+        expect(input.followupRun.turnAdoptionLifecycle?.onAdopted).not.toHaveBeenCalled();
+        expect(getExistingFollowupQueue(sessionKey)?.items ?? []).toEqual([]);
+      } finally {
+        owner.release.resolve();
+        clearFollowupQueueForTest(sessionKey);
+        await pending.catch(() => undefined);
+      }
+    });
+  });
+});

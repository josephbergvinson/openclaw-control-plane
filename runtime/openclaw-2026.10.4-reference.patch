diff --git a/extensions/telegram/src/bot-message-dispatch-continuation.ts b/extensions/telegram/src/bot-message-dispatch-continuation.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4434fc6dae8f4f3fb193757a1caa418576dacca5
--- /dev/null
+++ b/extensions/telegram/src/bot-message-dispatch-continuation.ts
@@ -0,0 +1,115 @@
+import {
+  resolveChannelProgressDraftMaxLineChars,
+  resolveChannelProgressDraftMaxLines,
+} from "openclaw/plugin-sdk/channel-outbound";
+import type { TelegramBotDeps } from "./bot-deps.js";
+import { resetLaneState } from "./bot-message-dispatch-draft.js";
+import type { TelegramDispatchTurn as Turn } from "./bot-message-dispatch.types.js";
+import { renderTelegramProgressDraftPreview } from "./progress-draft-preview.js";
+
+type BufferedDispatchParams = Parameters<
+  TelegramBotDeps["dispatchReplyWithBufferedBlockDispatcher"]
+>[0];
+type Deliver = BufferedDispatchParams["dispatcherOptions"]["deliver"];
+
+export async function adoptTelegramProgressCard(
+  turn: Turn,
+  adopt: NonNullable<Parameters<NonNullable<Deliver>>[1]["adoptProgressContinuation"]>,
+  resetReplyStep: () => void,
+  assertAuthorized: (() => void) | undefined,
+  existingOnly = false,
+): Promise<boolean> {
+  await turn.draftEventQueue;
+  const stream = turn.answerLane.stream;
+  if (!stream || turn.answerLane.finalized || turn.isSuperseded()) {
+    return false;
+  }
+  const assertCurrent = () => {
+    turn.turnAdoptionLifecycle?.abortSignal?.throwIfAborted();
+    assertAuthorized?.();
+    if (turn.isSuperseded() || turn.answerLane.stream !== stream || turn.answerLane.finalized) {
+      throw new Error("Telegram continuation presentation changed");
+    }
+  };
+  assertCurrent();
+  const snapshot = turn.progressCompositor.getSnapshot();
+  if (existingOnly) {
+    const preview = renderTelegramProgressDraftPreview(snapshot, {
+      toolProgress: turn.progressCompositor.previewToolProgressEnabled,
+      richMessages: turn.richMessages,
+      maxLines: resolveChannelProgressDraftMaxLines(turn.telegramCfg),
+      maxLineChars: resolveChannelProgressDraftMaxLineChars(turn.telegramCfg),
+    });
+    if (
+      !turn.progressCompositor.isVisible ||
+      !stream.messageId() ||
+      !stream.lastDeliveredText() ||
+      stream.lastDeliveredText() !== preview.text.trimEnd()
+    ) {
+      return false;
+    }
+  } else if (
+    !turn.progressCompositor.isVisible &&
+    !turn.progressCompositor.hasStarted &&
+    (turn.progressCompositor.hasStatusHeadline ||
+      turn.progressCompositor.hasPlanProgress ||
+      snapshot.lines.length > 0)
+  ) {
+    await turn.progressCompositor.start();
+    assertCurrent();
+  }
+  if (!turn.progressCompositor.isVisible) {
+    return false;
+  }
+  turn.progressCompositor.cancel();
+  assertCurrent();
+  // A payloadless handoff cannot create or repair its own visibility evidence.
+  if (!existingOnly) {
+    await stream.flush();
+    assertCurrent();
+  }
+  const messageId = stream.messageId();
+  const text = stream.lastDeliveredText();
+  if (typeof messageId !== "number" || !Number.isFinite(messageId) || !text) {
+    return false;
+  }
+  const adopted = await adopt({
+    channel: "telegram",
+    accountId: turn.context.route.accountId,
+    to: String(turn.context.chatId),
+    threadId: turn.context.threadSpec.id,
+    messageId: String(messageId),
+    text,
+    snapshot: turn.progressCompositor.getSnapshot(),
+  });
+  const sameCard =
+    turn.answerLane.stream === stream &&
+    !turn.answerLane.finalized &&
+    stream.messageId() === messageId;
+  // Positive adoption transfers custody even if cancellation arrived during
+  // the await. Only detach the exact adopted card, never a replacement lane.
+  if (adopted && sameCard) {
+    turn.answerLane.stream = undefined;
+    turn.progressContinuationAdopted = true;
+    resetLaneState(turn, turn.answerLane);
+    resetReplyStep();
+    turn.deliveryState.markDelivered();
+    await stream.discard();
+  }
+  turn.turnAdoptionLifecycle?.abortSignal?.throwIfAborted();
+  assertAuthorized?.();
+  if (turn.isSuperseded()) {
+    throw new Error("Telegram continuation presentation changed");
+  }
+  if (!adopted) {
+    assertCurrent();
+    if (existingOnly) {
+      turn.previewLifecycle.retainPreview();
+    }
+    return false;
+  }
+  if (existingOnly && !sameCard) {
+    throw new Error("Adopted Telegram progress card changed");
+  }
+  return true;

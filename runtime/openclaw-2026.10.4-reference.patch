+  const lifecycle = context.guildLifecycles.get(guildId);
+  const channelId =
+    request.channelId?.trim() ||
+    (request.action === "leave" &&
+    lifecycle &&
+    (lifecycle.status === "active" || lifecycle.status === "starting")
+      ? lifecycle.instance.channelId
+      : undefined);
+  if (!channelId) {
+    return {
+      ok: false,
+      message:
+        request.action === "join"
+          ? "A voice channel is required."
+          : "Not connected to a voice channel.",
+    };
+  }
+  let policyIsCurrent: (() => boolean) | undefined;
+  if (request.senderId) {
+    const [target, sender] = await Promise.all([
+      context.resolveAccessTarget({ guildId, channelId }),
+      context.speakerContext.resolveIdentity(guildId, request.senderId),

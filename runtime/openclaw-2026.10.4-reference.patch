+/** Match only the exact private route observed on the real native thread/start. */
+function forceOwnedHttpFallback(routes: Set<string>) {
+  let rejected = 0;
+  // oxlint-disable-next-line typescript/unbound-method -- Reflect.apply below supplies each actual Server receiver.
+  const emit = http.Server.prototype.emit;
+  vi.spyOn(http.Server.prototype, "emit").mockImplementation(function (
+    this: http.Server,
+    event: string | symbol,
+    ...args: unknown[]
+  ) {
+    const req = args[0];
+    const socket = args[1];
+    if (
+      event === "upgrade" &&
+      req instanceof http.IncomingMessage &&
+      routes.has(`${req.headers.host}${req.url}`) &&
+      record(socket) &&
+      typeof socket.end === "function"
+    ) {
+      const local = req.socket.localAddress;
+      if (local === "127.0.0.1" || local === "::1" || local === "::ffff:127.0.0.1") {
+        rejected++;
+        socket.end(
+          "HTTP/1.1 426 Upgrade Required\r\nConnection: close\r\nContent-Length: 0\r\n\r\n",
+        );
+        return true;
+      }
+    }
+    return Reflect.apply(emit, this, [event, ...args]);
+  });
+  return () => rejected;
+}
+
+function observeNativeProcesses(
+  identity: Awaited<ReturnType<typeof requireNativePackage>>,
+  root: string,
+  codexHome: string,
+  routes: Set<string>,
+  selection: { fallbackObserved: boolean },
+  errors: unknown[],
+) {
+  const children: ChildProcess[] = [];
+  const pendingSpawn = new Map<ChildProcess, () => void>();
+  const restoreWrites: Array<() => void> = [];
+  const diagnostics = channel("tracing:child_process.spawn:start");
+  const failures = channel("tracing:child_process.spawn:error");
+  const observeStdin = (child: ChildProcess) => {
+    pendingSpawn.delete(child);
+    try {
+      expect(child.stdin).not.toBeNull();
+      const stdin = child.stdin!;
+      const descriptor = Object.getOwnPropertyDescriptor(stdin, "write");
+      // oxlint-disable-next-line typescript/unbound-method -- Reflect.apply below supplies the intercepted stdin receiver.
+      const write = stdin.write;
+      let pending = "";
+      // Preserve native writes without a mock history retaining source frames.
+      const observedWrite: typeof write = function (this: typeof stdin, ...writeArgs) {
+        try {
+          pending += Buffer.isBuffer(writeArgs[0])
+            ? writeArgs[0].toString("utf8")
+            : String(writeArgs[0]);
+          expect(Buffer.byteLength(pending)).toBeLessThanOrEqual(MAX_BODY_BYTES);
+          let newline: number;
+          while ((newline = pending.indexOf("\n")) >= 0) {
+            const frame: unknown = JSON.parse(pending.slice(0, newline));
+            pending = pending.slice(newline + 1);
+            if (
+              record(frame) &&
+              frame.method === "thread/start" &&
+              record(frame.params) &&
+              record(frame.params.config) &&
+              typeof frame.params.config.openai_base_url === "string"
+            ) {
+              const base = new URL(frame.params.config.openai_base_url);
+              expect(base.protocol).toBe("http:");
+              expect(base.hostname).toBe("127.0.0.1");
+              routes.add(base.host + base.pathname + "/responses");
+            }
+          }
+        } catch (error) {
+          pending = "";
+          errors.push(error);
+        }
+        return Reflect.apply(write, this, writeArgs);
+      };
+      Object.defineProperty(
+        stdin,
+        "write",
+        descriptor && !("value" in descriptor)
+          ? { ...descriptor, get: () => observedWrite }
+          : { configurable: true, writable: true, ...descriptor, value: observedWrite },
+      );
+      restoreWrites.push(() => {
+        if (descriptor) {
+          Object.defineProperty(stdin, "write", descriptor);
+        } else {
+          Reflect.deleteProperty(stdin, "write");
+        }
+        pending = "";
+      });
+    } catch (error) {
+      errors.push(error);
+    }
+  };
+  const observe = (message: unknown) => {
+    try {
+      if (
+        !record(message) ||
+        !(message.process instanceof ChildProcess) ||
+        !record(message.options) ||
+        typeof message.options.file !== "string"
+      ) {
+        return;
+      }
+      const child = message.process;
+      const file = message.options.file;
+      const options = message.options;
+      let isNative = false;
+      let command: string | undefined;
+      try {
+        command = path.isAbsolute(file) ? realpathSync(file) : undefined;
+        const argv = Array.isArray(options.args) ? options.args : [];
+        // Node's normalized args includes argv0; the official entrypoint is next.
+        const nodeEntrypoint =
+          command === realpathSync(process.execPath) && typeof argv[1] === "string"
+            ? realpathSync(argv[1])
+            : undefined;
+        isNative = command === identity.launcher || nodeEntrypoint === identity.launcher;
+      } catch {
+        /* Other managed workers may use a PATH-owned command. */
+      }
+      if (command === identity.executable) {
+        throw new Error("Managed package unexpectedly bypassed its official launcher entrypoint");
+      }
+      if (
+        !isNative &&
+        (managed.isManagedCodexDesktopCommand(file) ||
+          (command && managed.isManagedCodexDesktopCommand(command)))
+      ) {
+        selection.fallbackObserved = true;
+        // Diagnostics observes the attempt; it cannot veto native spawn.
+        throw new Error("Managed package fixture attempted a Desktop fallback");
+      }
+      if (!isNative) {
+        return;
+      }
+      children.push(child);
+      const onSpawn = () => observeStdin(child);
+      pendingSpawn.set(child, onSpawn);
+      // START precedes native spawn and pipe creation. The spawn event follows
+      // pipe setup and precedes this transport's async initialize/thread start.
+      child.once("spawn", onSpawn);
+      const envPairs = Array.isArray(options.envPairs) ? options.envPairs : [];
+      const environmentValue = (name: string) => {
+        const prefix = name + "=";
+        const pair = envPairs.find(
+          (value) => typeof value === "string" && value.startsWith(prefix),
+        );
+        return typeof pair === "string" ? pair.slice(prefix.length) : undefined;
+      };
+      const nativeHome = environmentValue("CODEX_HOME");
+      const sqliteHome = environmentValue("CODEX_SQLITE_HOME");
+      expect(
+        nativeHome,
+        JSON.stringify({
+          boundary: "managed-native-spawn-home",
+          expectedCodexHome: codexHome,
+          actualCodexHome: nativeHome,
+          actualSqliteHome: sqliteHome,
+          expectedPrivateRoot: root,
+          cwd: options.cwd ?? process.cwd(),
+        }),
+      ).toBe(codexHome);
+      expect(sqliteHome).toBeUndefined();
+      for (const [name, value] of [
+        ["cwd", options.cwd ?? process.cwd()],
+        ["HOME", environmentValue("HOME")],
+        ["CODEX_HOME", nativeHome],
+      ] as const) {
+        expect(
+          typeof value === "string" && path.isAbsolute(value),
+          `Native spawn ${name} must be an absolute private path`,
+        ).toBe(true);
+        const relative = path.relative(root, value as string);
+        expect(
+          relative.startsWith("..") || path.isAbsolute(relative),
+          `Native spawn ${name} escaped the private composition root`,
+        ).toBe(false);
+      }
+    } catch (error) {
+      // diagnostics_channel listeners must never throw into Node's publisher.
+      errors.push(error);
+    }
+  };
+  const observeFailure = (message: unknown) => {
+    if (
+      record(message) &&
+      message.process instanceof ChildProcess &&
+      children.includes(message.process)
+    ) {
+      errors.push(message.error);
+    }
+  };
+  diagnostics.subscribe(observe);
+  failures.subscribe(observeFailure);
+  return {
+    children,
+    restore() {
+      diagnostics.unsubscribe(observe);
+      failures.unsubscribe(observeFailure);
+      for (const [child, listener] of pendingSpawn) {
+        child.removeListener("spawn", listener);
+      }
+      pendingSpawn.clear();
+      for (const restore of restoreWrites) {
+        restore();
+      }
+      restoreWrites.length = 0;
+    },
+  };
+}
+
+function toolSelection(tools: unknown): { name: string; namespace?: string } {
+  if (!Array.isArray(tools)) {
+    throw new Error("Actual native Responses request has no tools");
+  }
+  for (const tool of tools) {
+    if (!record(tool)) {
+      continue;
+    }
+    if (tool.type === "function" && tool.name === "write") {
+      return { name: "write" };
+    }
+    if (tool.type === "namespace" && typeof tool.name === "string" && Array.isArray(tool.tools)) {
+      if (
+        tool.tools.some(
+          (entry) => record(entry) && entry.type === "function" && entry.name === "write",
+        )
+      ) {
+        return { name: "write", namespace: tool.name };
+      }
+    }
+  }
+  throw new Error("Actual native surface omitted the confined dynamic writer");
+}

+        const writes: Array<{
+          method: string;
+          path: string;
+          messageId: string;
+          text: string;
+          replyTo?: string;
+        }> = [];
+        const visible = new Map<string, string>();
+        let created = 0;
+        const heldText = "Activation passed; final verification completed.";
+        const patchDispatched = createDeferredCore();
+        const releasePatch = createDeferredCore();
+        const finalDrainStarted = createDeferredCore();
+        const timing: string[] = [];
+        let heldPatchSignal: AbortSignal | undefined;
+        const fetchDiscord: typeof fetch = async (input, init) => {

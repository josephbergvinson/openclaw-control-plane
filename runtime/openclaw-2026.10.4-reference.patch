diff --git a/extensions/browser/src/browser-tool.post-click.test-support.ts b/extensions/browser/src/browser-tool.post-click.test-support.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9daca006a6326785b1f831f6ed5ee57ea84f7f82
--- /dev/null
+++ b/extensions/browser/src/browser-tool.post-click.test-support.ts
@@ -0,0 +1,259 @@
+import { describe, expect, it } from "vitest";
+import { createBrowserTool } from "./browser-tool.js";
+import {
+  browserActionsMocks as actions,
+  browserClientMocks as client,
+  gatewayMocks as gateway,
+  firstResultText,
+  mockSingleBrowserProxyNode,
+  nodeInvokeCall,
+  setResolvedBrowserProfiles,
+} from "./browser-tool.test-support.js";
+
+export function registerNativePostClickPageStateTests(): void {
+  // Retained model-facing feedback, exercised through the current native action owner.
+  describe("native post-click page state", () => {
+    it("returns fresh menu controls inline after a same-document click", async () => {
+      setResolvedBrowserProfiles({ openclaw: {}, account: {} });
+      actions.browserAct.mockResolvedValueOnce({ ok: true, targetId: "resolved-tab" });
+      client.browserSnapshot.mockResolvedValueOnce({
+        ok: true,
+        format: "ai",
+        targetId: "resolved-tab",
+        url: "https://example.com/account",
+        snapshot: '- button "Manage plan" [ref=e7]',
+        refs: { e7: { role: "button", name: "Manage plan" } },
+      });
+      const tool = createBrowserTool();
+      const result = await tool.execute("menu", {
+        action: "act",
+        profile: "account",
+        kind: "click",
+        ref: "e3",
+        targetId: "account-label",
+      });
+      const state = result.content.at(-1);
+      expect(state).toMatchObject({
+        type: "text",
+        text: expect.stringContaining('"Manage plan" [ref=e7]'),
+      });
+      expect(state).toMatchObject({
+        type: "text",
+        text: expect.stringContaining("EXTERNAL_UNTRUSTED_CONTENT"),
+      });
+      expect(client.browserSnapshot).toHaveBeenCalledExactlyOnceWith(
+        undefined,
+        expect.objectContaining({
+          targetId: "resolved-tab",
+          profile: "account",
+          mode: "efficient",
+        }),
+      );
+      expect(result.details).toMatchObject({
+        ok: true,
+        targetId: "resolved-tab",
+        pageState: { ok: true, targetId: "resolved-tab" },
+      });
+      // The next dependent action uses the returned controls, with no separate model-facing read.
+      if (!state || state.type !== "text") {
+        throw new Error("Missing inline controls");
+      }
+      const ref = /\[ref=(e7)\]/.exec(state.text)?.[1];
+      expect(ref).toBe("e7");
+      await tool.execute("plan", {
+        action: "act",
+        kind: "type",
+        ref,
+        text: "Example",
+        targetId: "resolved-tab",
+      });
+      expect(actions.browserAct).toHaveBeenCalledTimes(2);
+      expect(client.browserSnapshot).toHaveBeenCalledTimes(1);
+    });
+
+    it("returns one compact state after a completed click batch", async () => {
+      actions.browserAct.mockResolvedValueOnce({
+        ok: true,
+        targetId: "batch-tab",
+        results: [{ ok: true }, { ok: true }],
+      });
+      const result = await createBrowserTool().execute("batch", {
+        action: "act",
+        request: {
+          kind: "batch",
+          targetId: "batch-label",
+          actions: [
+            { kind: "click", ref: "e1" },
+            { kind: "evaluate", fn: "() => document.title" },
+          ],
+        },
+      });
+      expect(result.details).toMatchObject({ pageState: { ok: true } });
+      expect(actions.browserAct).toHaveBeenCalledTimes(1);
+      expect(client.browserSnapshot).toHaveBeenCalledExactlyOnceWith(
+        undefined,
+        expect.objectContaining({ targetId: "batch-tab", mode: "efficient" }),
+      );
+    });
+
+    it("keeps post-click state on the exact node and profile that performed the action", async () => {
+      setResolvedBrowserProfiles({ openclaw: {}, account: {} });
+      mockSingleBrowserProxyNode();
+      gateway.callGatewayTool
+        .mockResolvedValueOnce({
+          ok: true,
+          payload: {
+            route: { status: "resolved", profile: "account", driver: "openclaw" },
+            result: { ok: true, targetId: "node-resolved" },
+          },
+        })
+        .mockResolvedValueOnce({
+          ok: true,
+          payload: {
+            result: {
+              ok: true,
+              format: "ai",
+              targetId: "node-resolved",
+              url: "https://example.com",
+              snapshot: '- button "Account" [ref=e9]',
+            },
+          },
+        });
+      const result = await createBrowserTool().execute("node-click", {
+        action: "act",
+        target: "node",
+        profile: "account",
+        kind: "click",
+        ref: "e1",
+        targetId: "old-label",
+      });
+      expect(result.details).toMatchObject({ pageState: { targetId: "node-resolved" } });
+      expect(gateway.callGatewayTool).toHaveBeenCalledTimes(2);
+      const { request } = nodeInvokeCall(-1);
+      expect(request.nodeId).toBe("node-1");
+      expect(request.params).toMatchObject({
+        path: "/snapshot",
+        profile: "account",
+        query: { targetId: "node-resolved", mode: "efficient" },
+      });
+      expect(actions.browserAct).not.toHaveBeenCalled();
+      expect(client.browserSnapshot).not.toHaveBeenCalled();
+    });
+
+    it.each([
+      { name: "failed", result: { ok: false, targetId: "tab-1", error: "failed" } },
+      { name: "unknown", result: { targetId: "tab-1" } },
+      { name: "dialog blocked", result: { ok: true, targetId: "tab-1", blockedByDialog: true } },
+      {
+        name: "download",
+        result: { ok: true, targetId: "tab-1", downloads: [{ path: "/tmp/example.pdf" }] },
+      },
+      {
+        name: "malformed abort",
+        result: { ok: true, targetId: "tab-1", aborted: { reason: "unknown" } },
+      },
+    ])("does not append post-click state for a $name effect", async ({ result }) => {
+      actions.browserAct.mockResolvedValueOnce(result);
+      const actual = await createBrowserTool().execute("uncertain-click", {
+        action: "act",
+        kind: "click",
+        ref: "e1",
+        targetId: "tab-1",
+      });
+      expect(actual.details).not.toHaveProperty("pageState");
+      expect(client.browserSnapshot).not.toHaveBeenCalled();
+      expect(actions.browserAct).toHaveBeenCalledTimes(1);
+    });
+
+    it.each([
+      { name: "failed entry", results: [{ ok: true }, { ok: false, error: "failed" }] },
+      { name: "missing entry", results: [{ ok: true }] },
+      { name: "unknown entry", results: [{ ok: true }, {}] },
+    ])("does not append post-click state for a batch with $name", async ({ results }) => {
+      actions.browserAct.mockResolvedValueOnce({ ok: true, targetId: "tab-1", results });
+      const actual = await createBrowserTool().execute("incomplete-batch", {
+        action: "act",
+        kind: "batch",
+        actions: [
+          { kind: "click", ref: "e1" },
+          { kind: "wait", timeMs: 1 },
+        ],
+      });
+      expect(actual.details).not.toHaveProperty("pageState");
+      expect(client.browserSnapshot).not.toHaveBeenCalled();
+    });
+
+    it("does not select an unrelated tab when a successful click has no resolved target", async () => {
+      actions.browserAct.mockResolvedValueOnce({ ok: true });
+      const actual = await createBrowserTool().execute("no-target", {
+        action: "act",
+        kind: "click",
+        ref: "e1",
+      });
+      expect(actual.details).not.toHaveProperty("pageState");
+      expect(client.browserSnapshot).not.toHaveBeenCalled();
+    });
+
+    it.each([
+      { kind: "evaluate", fn: "() => document.title" },
+      { kind: "type", ref: "e1", text: "Example" },
+      { kind: "batch", actions: [{ kind: "evaluate", fn: "() => document.title" }] },
+      { kind: "batch", actions: [{ kind: "batch", actions: [{ kind: "click", ref: "e1" }] }] },
+      { kind: "batch", actions: [{ kind: "click", ref: "e1" }, { kind: "close" }] },
+    ])(
+      "does not append unsolicited state for non-click or opaque $kind results",
+      async (request) => {
+        actions.browserAct.mockResolvedValueOnce({
+          ok: true,
+          targetId: "tab-1",
+          results: [{ ok: true }, { ok: true }],
+        });
+        await createBrowserTool().execute("other-action", {
+          action: "act",
+          request: { ...request, targetId: "tab-1" },
+        });
+        expect(client.browserSnapshot).not.toHaveBeenCalled();
+      },
+    );
+
+    it("propagates post-click snapshot cancellation without replaying the click", async () => {
+      actions.browserAct.mockResolvedValueOnce({ ok: true, targetId: "tab-1" });
+      const controller = new AbortController();
+      const aborted = new Error("post-click observation cancelled");
+      client.browserSnapshot.mockImplementationOnce(async () => {
+        controller.abort(aborted);
+        throw aborted;
+      });
+      await expect(
+        createBrowserTool().execute(
+          "cancelled-click",
+          { action: "act", kind: "click", ref: "e1", targetId: "tab-1" },
+          controller.signal,
+        ),
+      ).rejects.toBe(aborted);
+      expect(actions.browserAct).toHaveBeenCalledTimes(1);
+      expect(client.browserSnapshot).toHaveBeenCalledExactlyOnceWith(
+        undefined,
+        expect.objectContaining({ signal: controller.signal }),
+      );
+    });
+
+    it("preserves the completed click if its inline state is unavailable", async () => {
+      actions.browserAct.mockResolvedValueOnce({ ok: true, targetId: "tab-1" });
+      client.browserSnapshot.mockRejectedValueOnce(new Error("observation unavailable"));
+      const result = await createBrowserTool().execute("unavailable-click", {
+        action: "act",
+        kind: "click",
+        ref: "e1",
+        targetId: "tab-1",
+      });
+      expect(firstResultText(result)).toContain('"ok": true');
+      expect(result.content.at(-1)).toMatchObject({
+        type: "text",
+        text: expect.stringContaining("page snapshot unavailable"),
+      });
+      expect(result.details).not.toHaveProperty("pageState");
+      expect(actions.browserAct).toHaveBeenCalledTimes(1);
+    });
+  });
+}

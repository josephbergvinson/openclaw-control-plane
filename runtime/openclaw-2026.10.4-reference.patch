+  mockRunCronFallbackPassthrough,
+  pickLastNonEmptyTextFromPayloadsMock,
+  runCliAgentMock,
+  runEmbeddedAgentMock,
+} from "./run.test-harness.js";
+
+const runCronIsolatedAgentTurn = await loadRunCronIsolatedAgentTurn();
+setupRunCronIsolatedAgentTurnSuite();
+const tempDirs = useAutoCleanupTempDirTracker(afterEach);
+type ModelRequest = RunEmbeddedAgentParams | RunCliAgentParams;
+
+function offerNativeCohort(request: ModelRequest, generation: number) {
+  const sessionKey = request.sessionKey!;
+  const child: SubagentRunRecord = {
+    runId: `child-${generation}`,
+    childSessionKey: `agent:main:subagent:child-${generation}`,
+    requesterSessionKey: sessionKey,
+    requesterAgentId: "main",
+    requesterDisplayKey: "original cron",
+    task: "read delegated records",
+    cleanup: "keep",
+    createdAt: generation,
+    execution: { status: "terminal", endedAt: generation + 1, outcome: { status: "ok" } },
+    completion: { required: true, resultText: `findings ${generation}` },
+    requesterSettleWake: {
+      status: "pending",
+      attemptCount: 0,
+      requesterYieldBatch: true,
+      rearmGeneration: generation,
+      batchRunIds: [`child-${generation}`],
+    },
+  };
+  promoteFollowupYield({
+    requesterTurnRunId: request.runId!,
+    entries: [child],
+    rearmGeneration: generation,
+  });
+  const owner = getFollowupForCohort([child]);
+  if (!owner?.offerInPlace) {
+    throw new Error("Missing real native logical completion owner");
+  }
+  const receipt = owner.offerInPlace({
+    successor: owner.successor([child], request.runId!, () => {}),
+    prompt: `Native child findings ${generation}. Complete the original task.`,
+  });
+  const joined = receipt.result.then((outcome) => {
+    receipt.joined();
+    return outcome;
+  });
+  return { owner, joined };
+}
+
+describe("original cron parent continuation", () => {
+  it.each(["embedded", "cli"] as const)(
+    "resumes two native cohorts through the same %s context and one finalizer",
+    async (runner) => {
+      const workspace = tempDirs.make("cron-parent-continuation-");
+      const bootstrapFiles = {
+        "USER.md": "The original owner is Joseph.",
+        "AGENTS.md": "Complete the authorized original task.",
+      };
+      await Promise.all(
+        Object.entries(bootstrapFiles).map(([name, content]) =>
+          fs.writeFile(path.join(workspace, name), content),
+        ),
+      );
+      ensureAgentWorkspaceMock.mockResolvedValue({ dir: workspace });
+      isCliProviderMock.mockReturnValue(runner === "cli");
+      mockRunCronFallbackPassthrough();
+      pickLastNonEmptyTextFromPayloadsMock.mockImplementation(
+        (payloads?: Array<{ text?: string }>) => payloads?.at(-1)?.text ?? "",
+      );
+      const requests: ModelRequest[] = [];
+      const joins: Array<ReturnType<typeof offerNativeCohort>["joined"]> = [];
+      let now = performance.now();
+      const clock = vi.spyOn(performance, "now").mockImplementation(() => now);
+      const assertRunCurrent = vi.fn(async () => {});
+      const model = runner === "cli" ? runCliAgentMock : runEmbeddedAgentMock;
+      model.mockImplementation(async (request: ModelRequest) => {
+        if (!request.preparedRunAdmission) {
+          throw new Error("Missing real native cron admission");
+        }
+        await request.preparedRunAdmission.admit("gateway");
+        requests.push(request);
+        expect(request.agentId).toBe("main");
+        expect(request.workspaceDir).toBe(workspace);
+        const context = await resolveBootstrapContextForRun({
+          workspaceDir: request.workspaceDir,
+          config: request.config,
+          agentId: request.agentId,
+          sessionKey: request.sessionKey,
+          sessionId: request.sessionId,
+          contextMode: request.bootstrapContextMode,
+          runKind: request.bootstrapContextRunKind,
+        });
+        for (const [name, content] of Object.entries(bootstrapFiles)) {
+          expect(
+            context.contextFiles,
+            JSON.stringify({ runner, prompt: requests.length, contextFiles: context.contextFiles }),
+          ).toContainEqual(expect.objectContaining({ path: path.join(workspace, name), content }));
+        }
+        expect(request.bootstrapContextMode).toBeUndefined();
+        expect(request.toolsAllow).toEqual(["read"]);
+        if (requests.length < 3) {
+          joins.push(offerNativeCohort(request, requests.length).joined);
+          now += 1_000;
+          return {
+            payloads: [{ text: "Waiting for delegated findings." }],
+            meta: { yielded: true, agentMeta: {} },
+            requesterContinuationSettled: true,
+          };
+        }
+        expect(request.prompt).toContain("findings 2");
+        expect(dispatchCronDeliveryMock).not.toHaveBeenCalled();
+        return {
+          payloads: [{ text: "Parent synthesis of both delegated findings." }],
+          meta: { agentMeta: {} },
+        };

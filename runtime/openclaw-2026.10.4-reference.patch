+
+function createVisibleReplyOperation() {
+  const operation = createReplyOperation({
+    sessionKey: "agent:main:terminal-resolution",
+    sessionId: "session:terminal-resolution",
+    resetTriggered: false,
+    turnKind: "visible",
+  });
+  onTestFinished(() => operation.complete());
+  return operation;
+}
+
+export function registerAcceptedChildTerminalResolutionCases(): void {
+  it.each([false, true])(
+    "keeps an empty visible parent on the accepted-child handoff (explicit yield: %s)",
+    async (yielded) => {
+      const replyOperation = createVisibleReplyOperation();
+      const attempt = makeEmbeddedRunnerAttempt({
+        ...(yielded
+          ? {
+              terminal: { kind: "aborted", source: "yield_cleanup" },
+              yieldDetected: true,
+              yieldAcknowledgment: "Waiting for verification.",
+            }
+          : {}),
+        acceptedSessionSpawns: [
+          {
+            runId: "child-run",
+            childSessionKey: "agent:main:subagent:child",
+            expectsCompletionMessage: true,
+          },
+        ],
+      });
+
+      const resolved = await resolveEmbeddedRunTerminal(
+        makeTerminalInput({
+          attempt,
+          runParams: { replyOperation },
+        }),
+      );
+
+      expect(resolved).toMatchObject({
+        result: {
+          payloads: undefined,
+          meta: {
+            continuationPending: true,
+            ...(yielded
+              ? {
+                  yielded: true,
+                  yieldAcknowledgment: "Waiting for verification.",
+                  stopReason: "end_turn",
+                }
+              : {}),
+          },
+          acceptedSessionSpawns: attempt.acceptedSessionSpawns,
+        },
+      });
+    },
+  );
+
+  it("keeps explicit yields without a visible completion-child reply on their existing settlement path", async () => {
+    const replyOperation = createVisibleReplyOperation();
+    const completionChild = {
+      runId: "child-run",
+      childSessionKey: "agent:main:subagent:child",
+      expectsCompletionMessage: true,
+    };
+    const excludedRuns: Partial<TerminalInput["runParams"]>[] = [
+      { replyOperation: undefined },
+      { currentInboundEventKind: "room_event" },
+      { inputProvenance: { kind: "inter_session", sourceTool: "subagent_announce" } },
+      { silentExpected: true },
+    ];
+    for (const run of excludedRuns) {
+      const resolved = await resolveEmbeddedRunTerminal(
+        makeTerminalInput({
+          attempt: makeEmbeddedRunnerAttempt({
+            yieldDetected: true,
+            acceptedSessionSpawns: [completionChild],
+          }),
+          runParams: { replyOperation, ...run },
+        }),
+      );
+      expect(resolved.action).toBe("complete");
+      if (resolved.action === "complete") {
+        expect(resolved.result.meta.yielded).toBe(true);
+        expect(resolved.result.meta.continuationPending).toBeUndefined();
+      }
+    }
+    for (const acceptedSessionSpawns of [
+      [],
+      [{ ...completionChild, expectsCompletionMessage: false }],
+    ]) {
+      const resolved = await resolveEmbeddedRunTerminal(
+        makeTerminalInput({
+          attempt: makeEmbeddedRunnerAttempt({ yieldDetected: true, acceptedSessionSpawns }),
+          runParams: { replyOperation },
+        }),
+      );
+      expect(resolved.action).toBe("complete");
+      if (resolved.action === "complete") {
+        expect(resolved.result.meta.continuationPending).toBeUndefined();
+      }
+    }
+  });
+
+  it("does not treat explicit yield as another reply after current terminal evidence", () => {
+    const replyOperation = createVisibleReplyOperation();
+    const acceptedSessionSpawns = [
+      {
+        runId: "child-run",
+        childSessionKey: "agent:main:subagent:child",
+        expectsCompletionMessage: true,
+      },
+    ];
+    for (const terminal of [
+      { assistantTexts: ["The requested answer is complete."] },
+      { didDeliverSourceReplyViaMessageTool: true },
+      { lastToolError: { toolName: "read", error: "fixture failure" } },
+    ]) {
+      expect(
+        shouldContinueInteractiveAcceptedSessionSpawns({
+          attempt: makeEmbeddedRunnerAttempt({
+            yieldDetected: true,
+            acceptedSessionSpawns,
+            ...terminal,
+          }),
+          run: { replyOperation },
+        }),
+      ).toBe(false);
+    }
+  });
+
+  it.each([
+    { terminal: { kind: "aborted", source: "runtime" } },
+    { terminal: { kind: "aborted", source: "external" } },
+    {
+      terminal: {
+        kind: "aborted",
+        source: "yield_cleanup",
+        failure: { source: "prompt", error: new Error("failed") },
+      },
+    },
+    {
+      terminal: { kind: "aborted", source: "yield_cleanup", timeoutObservation: "tool_execution" },
+    },
+    { terminal: { kind: "timeout", phase: "prompt", source: "runtime" } },
+    { terminal: { kind: "failed", source: "prompt", error: new Error("failed") } },
+    { terminal: { kind: "aborted", source: "yield_cleanup" }, yieldDetected: false },
+  ] satisfies Parameters<typeof makeEmbeddedRunnerAttempt>[0][])(
+    "does not adopt a child reply after an interrupted or unproven yield: %j",
+    (fields) => {
+      const replyOperation = createVisibleReplyOperation();
+      expect(
+        shouldContinueInteractiveAcceptedSessionSpawns({
+          attempt: makeEmbeddedRunnerAttempt({
+            yieldDetected: true,
+            acceptedSessionSpawns: [
+              {
+                runId: "child-run",
+                childSessionKey: "agent:main:subagent:child",
+                expectsCompletionMessage: true,
+              },
+            ],
+            ...fields,
+          }),
+          run: { replyOperation },
+        }),
+      ).toBe(false);
+    },
+  );
+}

+    // neither cleanup nor a replacement dispatch may guess otherwise.
+    submitted = true;
+    const result = await subagentRuns.runWithCompletionAuthority(entry, () =>
+      queueGuardedEmbeddedAgentMessageWithOutcomeAsync(
+        active.sessionId,
+        text,
+        {
+          queueIdentity: params.queueIdentity,
+          isInboundUserMessage: false,
+          waitForTranscriptCommit: true,
+          abortSignal: params.signal,
+          media,

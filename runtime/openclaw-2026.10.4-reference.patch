+++ b/extensions/discord/src/voice/voice-conversation-input.test.ts
@@ -0,0 +1,75 @@
+import { createDeferred } from "openclaw/plugin-sdk/extension-shared";
+import { describe, expect, it, vi } from "vitest";
+import type { DiscordVoiceIngressContext } from "./ingress.js";
+import { DiscordVoiceConversationQueue } from "./voice-conversation-input.js";
+
+describe("retained Discord voice policy authority", () => {
+  it("never creates a speaker connection from authority revoked during awaited admission", async () => {
+    const pending = createDeferred<DiscordVoiceIngressContext>();
+    const queue = new DiscordVoiceConversationQueue();
+    const createTurn = vi.fn();
+    let current = true;
+    const input = queue.start({
+      authorize: () => pending.promise,
+      isCurrent: () => true,
+      canAdmit: () => true,
+      createTurn,
+      warn: vi.fn(),
+    });
+    input?.sendAudio(Buffer.alloc(3_840));
+    current = false;
+    pending.resolve({ senderIsOwner: true, speakerLabel: "Owner", isCurrent: () => current });
+    await input?.ready;
+    expect(createTurn).not.toHaveBeenCalled();
+    expect(input?.ingress).toBeNull();
+    expect(input?.retired).toBe(true);
+    queue.close();
+  });
+
+  it("retires the exact admitted turn before forwarding audio after policy revocation", async () => {
+    const queue = new DiscordVoiceConversationQueue();
+    const turn = { sendInputAudio: vi.fn(), close: vi.fn() };
+    let current = true;
+    const input = queue.start({
+      authorize: async () => ({
+        senderIsOwner: true,
+        speakerLabel: "Owner",
+        isCurrent: () => current,
+      }),
+      isCurrent: () => true,
+      canAdmit: () => true,
+      createTurn: () => turn,
+      warn: vi.fn(),
+    });
+    await input?.ready;
+    input?.sendAudio(Buffer.alloc(3_840));
+    expect(turn.sendInputAudio).toHaveBeenCalledOnce();
+    current = false;
+    input?.sendAudio(Buffer.alloc(3_840));
+    expect(turn.sendInputAudio).toHaveBeenCalledOnce();
+    expect(turn.close).toHaveBeenCalledExactlyOnceWith("incomplete-input");
+    expect(input?.ingress).toBeNull();
+    expect(input?.retired).toBe(true);
+    queue.close();
+  });
+
+  it("rejects and retires segment authority that expires during its awaited resolution", async () => {
+    const queue = new DiscordVoiceConversationQueue();
+    const pending = createDeferred<DiscordVoiceIngressContext>();
+    const turn = { sendInputAudio: vi.fn(), close: vi.fn() };
+    const input = queue.start({
+      authorize: async () => ({ senderIsOwner: true, speakerLabel: "Owner" }),
+      isCurrent: () => true,
+      canAdmit: () => true,
+      createTurn: () => turn,
+      warn: vi.fn(),
+    });
+    await input?.ready;
+    const permission = input?.authorizeSegment(() => pending.promise);
+    pending.resolve({ senderIsOwner: true, speakerLabel: "Owner", isCurrent: () => false });
+    await expect(permission).resolves.toBeNull();
+    expect(input?.retired).toBe(true);
+    expect(turn.close).toHaveBeenCalledExactlyOnceWith("incomplete-input");
+    queue.close();
+  });
+});

+/** Only empty, recognized response-control envelopes permit cached replay recovery. */
+export function isEmptyCodexResponseControlEvent(event: Record<string, unknown>): boolean {
+  if (
+    event.type !== "response.created" &&
+    event.type !== "response.in_progress" &&
+    event.type !== "response.queued"
+  ) {
+    return false;
+  }
+  if (
+    Object.keys(event).some(
+      (key) => key !== "type" && key !== "response" && key !== "sequence_number",
+    ) ||
+    !isRecord(event.response)
+  ) {
+    return false;
+  }
+  const response = event.response;
+  return (
+    typeof response.id === "string" &&
+    response.id.trim().length > 0 &&
+    (response.output === undefined ||
+      (Array.isArray(response.output) && response.output.length === 0)) &&

index 0000000000000000000000000000000000000000..26c77e925860d6cc94ec1bdc0bb91e8a52cd160d
--- /dev/null
+++ b/src/transcripts/summary-record-consult.ts
@@ -0,0 +1,55 @@
+import { randomUUID } from "node:crypto";
+import type {
+  IsolatedCompletionResult,
+  runIsolatedCompletion,
+} from "../agents/isolated-completion.js";
+import { createSubsystemLogger } from "../logging/subsystem.js";
+import { createRuntimeAgent } from "../plugins/runtime/runtime-agent.js";
+import { consultRealtimeVoiceAgent } from "../talk/agent-consult-runtime.js";
+import type { TranscriptSessionDescriptor } from "./provider-types.js";
+
+type RecordConsultParams = Parameters<typeof runIsolatedCompletion>[0] & {
+  session: TranscriptSessionDescriptor;
+};
+
+/** Read existing records inside the registered capture's normal agent owner. */
+export async function runTranscriptRecordConsult(
+  params: RecordConsultParams,
+): Promise<Pick<IsolatedCompletionResult, "text" | "provider" | "model">> {
+  if (!params.config || !params.agentId || params.session.source.providerId !== "discord-voice") {
+    throw new Error("Transcript records consult requires the configured Discord capture owner.");
+  }
+  // Each chunk/reduction has a fresh normal session: isolated context does not
+  // erase an existing session's history, which would duplicate previous inputs.
+  const sessionKey = `agent:${params.agentId}:subagent:transcript-summary:${params.session.sessionId}:${randomUUID()}`;
+  const result = await consultRealtimeVoiceAgent({
+    cfg: params.config,
+    agentRuntime: createRuntimeAgent(),
+    logger: createSubsystemLogger("transcripts/summary"),
+    agentId: params.agentId,
+    sessionKey,
+    contextMode: "isolated",
+    messageProvider: "discord",
+    lane: "transcript-summary",
+    runIdPrefix: `transcript-summary:${params.session.sessionId}`,
+    args: { question: params.prompt, responseStyle: "Return the complete requested JSON notes." },
+    transcript: [],
+    surface: "finalizing a captured Discord meeting",
+    userLabel: "Meeting recorder",
+    provider: params.provider,
+    model: params.model,
+    authProfileId: params.authProfileId,
+    streamParams: params.streamParams,
+    thinkLevel: "max",
+    fastMode: false,
+    toolsAllow: ["memory_search", "memory_get", "read"],
+    timeoutMs: params.timeoutMs,
+    extraSystemPrompt: params.systemPrompt,
+    abortSignal: params.abortSignal,
+    assertCurrent: params.assertCurrent,
+  });
+  if (result.yielded || !result.provider || !result.model) {
+    throw new Error("Transcript records consult did not return completed model notes.");
+  }
+  return { text: result.text, provider: result.provider, model: result.model };
+}

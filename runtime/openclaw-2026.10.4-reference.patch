+  it("leaves explicit references with their existing all-send semantics", () => {
+    expect(
+      resolveDiscordReplyReference({
+        replyToId: "explicit-source",
+        replyToIdSource: "explicit",
+        replyToMode: "first",
+      }),
+    ).toEqual({ messageId: "explicit-source", scope: "all" });
+  });
+});

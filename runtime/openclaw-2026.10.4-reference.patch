@@ -0,0 +1,80 @@
+import { describe, expect, it } from "vitest";
+import { persistSessionUsageUpdate } from "../../auto-reply/reply/session-usage.js";
+import { createSessionGoal, getSessionGoal } from "./goals.js";
+import {
+  loadSessionEntry,
+  patchSessionEntryCore,
+  upsertSessionEntryCore,
+} from "./session-accessor.js";
+import { useTempSessionsFixture } from "./test-helpers.js";
+
+/** Actual native context/Goal store composition; context size is not a spent-token ledger. */
+describe("Goal usage versus native context snapshots", () => {
+  const fixture = useTempSessionsFixture("openclaw-goal-context-accounting-");
+  const sessionKey = "agent:main:goal-native-usage";
+  const scope = () => ({ agentId: "main", sessionKey, storePath: fixture.storePath() });
+
+  async function createGoal(tokensUsed = 0) {
+    await upsertSessionEntryCore(scope(), {
+      sessionId: "native-goal-session",
+      updatedAt: 1,
+      totalTokens: 100,
+      totalTokensFresh: true,
+      totalTokensVersion: 1,
+    });
+    const goal = await createSessionGoal({
+      ...scope(),
+      objective: "Finish the accepted work",
+      tokenBudget: 200,
+    });
+    if (tokensUsed) {
+      await patchSessionEntryCore(scope(), () => ({ goal: { ...goal, tokensUsed } }));
+    }
+    return goal;
+  }
+
+  it("does not charge a larger current context observation as accepted Goal usage", async () => {
+    await createGoal();
+    await persistSessionUsageUpdate({
+      ...scope(),
+      cfg: {},
+      currentContextSnapshot: { tokens: 500 },
+    });
+    expect(loadSessionEntry(scope())?.totalTokens).toBe(500);
+    const projected = await getSessionGoal({ ...scope(), persist: false });
+    expect(projected.goal).toMatchObject({ tokensUsed: 0, status: "active" });
+    expect(loadSessionEntry(scope())?.goal).toMatchObject({ tokensUsed: 0, status: "active" });
+  });
+
+  it("retains explicit historical usage through compaction and later context growth", async () => {
+    await createGoal(73);
+    for (const tokens of [20, 800]) {
+      await persistSessionUsageUpdate({ ...scope(), cfg: {}, currentContextSnapshot: { tokens } });
+      expect((await getSessionGoal({ ...scope(), persist: true })).goal).toMatchObject({
+        tokensUsed: 73,
+        status: "active",
+      });
+    }
+    expect(loadSessionEntry(scope())?.goal?.tokensUsed).toBe(73);
+  });
+
+  it("keeps native usage metadata separate from Goal charging without an admitted usage cursor", async () => {
+    await createGoal();
+    await persistSessionUsageUpdate({
+      ...scope(),
+      cfg: {},
+      usage: { input: 300, output: 25 },
+      lastCallUsage: { input: 300, output: 25 },
+      currentContextSnapshot: { tokens: 300 },
+    });
+    expect(loadSessionEntry(scope())).toMatchObject({
+      inputTokens: 300,
+      outputTokens: 25,
+      totalTokens: 300,
+    });
+    expect((await getSessionGoal({ ...scope(), persist: false })).goal).toMatchObject({
+      tokensUsed: 0,
+      status: "active",
+    });
+  });
+});

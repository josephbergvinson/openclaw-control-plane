+          action: "roleCreate",
+          guildId: "guild",
+          name: "role",
+          permissions: PermissionFlagsBits.Administrator.toString(),
+          senderUserId: "sender",
+        },
+        cfg,
+      ),
+    ).rejects.toThrow("permissions they do not have");
+    expect(mocks.create).not.toHaveBeenCalled();
+  });
+  it("does not dispatch when native guild permission or configured role access is absent", async () => {
+    mocks.allowed.mockResolvedValue(false);

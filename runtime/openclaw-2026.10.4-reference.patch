+
+    @Test(arguments: ["fixture", "Fixture Operator"])
+    func `hosted passkey form binds the local computer account rather than the provider email`(
+        _ account: String) throws
+    {
+        let nodes = Self.form(account: account)
+        let form = try #require(NativeCredentialPromptContext.resolve(nodes, bundleID: Self.helper))
+        #expect(form.field == 6)
+        #expect(form.context == 0)
+        #expect(form.submit == 7)
+        #expect(form.username?.field == nil)
+        let purpose = NativeCredentialPromptPurpose.resolve(nativeEvidence: form.evidence)
+        #expect(purpose != .accountAuthentication)
+        #expect(purpose != .passwordsUnlockAuthentication)
+        #expect(NativeCredentialPromptPurpose.localPasskeyAccount(nativeEvidence: form.evidence) == account)
+        let binding = try Self.binding()
+        #expect(binding.authorizes(
+            hostID: Self.host,
+            bundleID: Self.helper,
+            accountEvidence: form.evidence,
+            purpose: purpose,
+            localAccount: "fixture",
+            localAccountFullName: "Fixture Operator"))
+        for (principal, fullName) in [("other", "Fixture Operator"), ("fixture", "Other")] {
+            let fullNameForm = try #require(NativeCredentialPromptContext.resolve(
+                Self.form(account: "Fixture Operator"), bundleID: Self.helper))
+            #expect(!binding.authorizes(
+                hostID: Self.host,
+                bundleID: Self.helper,
+                accountEvidence: fullNameForm.evidence,
+                localAccount: principal,
+                localAccountFullName: fullName))
+        }
+        let diagnostics = NativeCredentialPromptContext.diagnostics(
+            nodes, bundleID: Self.helper, resolved: true, axReadFailureCount: 0, focusedSecureFieldMatches: true)
+        #expect(diagnostics.formContext?.purpose == purpose)
+        #expect(diagnostics.observedSecureFieldCount == 1)

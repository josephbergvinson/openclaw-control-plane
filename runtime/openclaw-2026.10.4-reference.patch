+import path from "node:path";
+import { assert, describe, expect, it } from "vitest";
+import type { JsonValue } from "../extensions/codex/src/app-server/protocol-json.js";
+import { loadCodexGoalUsageTestFixture } from "../extensions/codex/test-api.js";
+import { OPENAI_CODEX_RESPONSES_BASE_URL } from "../extensions/openai/base-url.js";
+import {
+  createOverflowRunParams,
+  loadRunOverflowCompactionHarness,
+  mockedResolveModelAsync,
+  mockedRunEmbeddedAttempt,
+} from "../src/agents/embedded-agent-runner/run.overflow-compaction.harness.js";
+
+// This loader resets modules. Load it before the native fixture and its hooks
+// capture the scheduler, tool and session owners used by the shared run.
+const generic = await loadRunOverflowCompactionHarness({ realRuntimePlan: true });
+const {
+  harness: codex,
+  createCodexAppServerAgentHarness,
+  bindings,
+  createCodexInferenceReadResponses,
+} = await loadCodexGoalUsageTestFixture();
+codex.setupRunAttemptTestHooks({ sessionOwner: null });
+
+describe("accepted Goal usage through the registered native Codex attempt", () => {
+  it("charges completed responses once through real shared normalization and settlement, retaining same-goal correction", async () => {
+    // Discovery is confined by the existing generic harness. Attempt execution,
+    // host tools, usage normalization, Goal SQLite and final settlement stay real.
+    const [{ withOpenClawTestState }, accessor, goals] = await Promise.all([
+      import("../src/test-utils/openclaw-test-state.js"),
+      import("../src/config/sessions/session-accessor.js"),
+      import("../src/config/sessions/goals.js"),
+    ]);
+    await withOpenClawTestState({ label: "codex-goal-accepted-usage" }, async (state) => {
+      const key = "agent:main:goal-codex";
+      const runId = "native-goal-run";
+      const sessionId = "native-goal-session";
+      const storePath = path.join(state.sessionsDir(), "sessions.json");
+      const scope = { agentId: "main", sessionKey: key, sessionId, storePath };
+      const config = {
+        agents: { defaults: { workspace: state.workspaceDir } },
+        tools: { web: { search: { enabled: false } } },
+        plugins: {
+          entries: { codex: { enabled: true, config: { codexDynamicToolsLoading: "direct" } } },
+        },
+      };
+      await state.writeConfig(config);
+      await accessor.upsertSessionEntryCore(scope, { sessionId, updatedAt: Date.now() });
+      const goal = await goals.createSessionGoal({
+        ...scope,
+        objective: "Complete the original package",
+        tokenBudget: 1000,
+      });
+      const paramsFixture = codex.createParams(
+        path.join(state.sessionsDir(), "source.jsonl"),
+        state.workspaceDir,
+      );
+      codex.setCodexTestModelSupportsTools(paramsFixture, true);
+      const resolveModel = mockedResolveModelAsync.getMockImplementation();
+      assert(resolveModel);
+      mockedResolveModelAsync.mockImplementation(async (...args) => {
+        const resolved = await resolveModel(...args);
+        return {
+          ...resolved,
+          model: {
+            ...resolved.model,
+            ...paramsFixture.model,
+            contextWindow: paramsFixture.model.contextWindow ?? resolved.model.contextWindow,
+            api: paramsFixture.model.api ?? resolved.model.api,
+            baseUrl: OPENAI_CODEX_RESPONSES_BASE_URL,
+            id: args[1] ?? "gpt-5.4",
+            provider: args[0] ?? "openai",
+          },
+        };
+      });
+      let nativeAttempt: ReturnType<typeof codex.runCodexAppServerAttempt> | undefined;
+      let nativeAttemptCount = 0;
+      const declaration = createCodexAppServerAgentHarness({
+        bindingStore: bindings.testCodexAppServerBindingStore,
+      });
+      generic.registerPreparedAgentHarness(
+        {
+          ...declaration,
+          // Forward to the actual native body through its existing client/binding fixture.
+          // Do not replace the attempt result, normalize step or run accounting owner.
+          runAttempt: async (attempt: Parameters<typeof declaration.runAttempt>[0]) => {
+            const auth = attempt.runtimePlan?.auth;
+            const preparedRoute = auth?.modelRoute ?? auth?.deferredRouteSupport;
+            expect(preparedRoute?.requestTransportOverrides).toBe("none");
+            expect(preparedRoute?.runtimePolicy?.compatibleIds).toContain("codex");
+            nativeAttemptCount += 1;
+            nativeAttempt = codex.runCodexAppServerAttempt(attempt, {
+              pluginConfig: { codexDynamicToolsLoading: "direct" },
+              nativeHookRelay: { enabled: false },
+            });
+            return await nativeAttempt;
+          },
+        },
+        { ownerPluginId: "codex" },
+      );
+      const namespaces = new Map<string, string | null>();
+      const accountReads = createCodexInferenceReadResponses();
+      const native = codex.createStartedThreadHarness(
+        async (method, raw) => {
+          if (method === "account/read") {
+            return accountReads[method];
+          }
+          if (method !== "thread/start") {
+            return undefined;
+          }
+          assert(raw && typeof raw === "object" && "dynamicTools" in raw && "config" in raw);
+          const request = raw as {
+            dynamicTools: Array<{ type?: string; name: string; tools?: Array<{ name: string }> }>;
+            config: Record<string, unknown>;
+          };
+          expect(request.config["features.goals"]).toBe(false);
+          const advertised: string[] = [];
+          for (const spec of request.dynamicTools) {
+            if (spec.type === "namespace") {
+              for (const tool of spec.tools ?? []) {
+                advertised.push(tool.name);
+                namespaces.set(tool.name, spec.name);
+              }
+            } else {
+              advertised.push(spec.name);
+              namespaces.set(spec.name, null);
+            }
+          }
+          for (const name of ["get_goal", "create_goal", "update_goal"]) {
+            expect(advertised.filter((value) => value === name)).toHaveLength(1);
+          }
+          return undefined;
+        },
+        { persistedThreads: [] },
+      );
+      const abort = new AbortController();
+      let run: ReturnType<typeof generic.runEmbeddedAgent> | undefined;
+      try {
+        run = generic.runEmbeddedAgent({
+          ...createOverflowRunParams(state),
+          config,
+          agentId: "main",
+          provider: "openai",
+          model: "gpt-5.4",
+          sessionKey: key,
+          sessionId,
+          sessionFile: path.join(state.sessionsDir(), "source.jsonl"),
+          sessionTarget: scope,
+          runId,
+          prompt:
+            "The human explicitly asks to revise this same Goal to Complete the revised package and then finish it.",
+          timeoutMs: 30_000,
+          abortSignal: abort.signal,
+          disableTools: false,
+        });
+        await Promise.race([
+          native.waitForMethod("turn/start"),
+          run.then((result) => {
+            throw new Error("Shared run settled before native turn/start", { cause: result });
+          }),
+        ]);
+        assert(nativeAttempt);
+        await nativeAttempt.waitForTurnAccepted();
+        const callGoal = async (
+          name: string,
+          callId: string,
+          args: Record<string, JsonValue> = {},
+        ) => {
+          const response = await native.handleServerRequest({
+            id: callId,
+            method: "item/tool/call",
+            params: {
+              threadId: "thread-1",
+              turnId: "turn-1",
+              callId,
+              tool: name,
+              namespace: namespaces.get(name) ?? null,
+              arguments: args,
+            },
+          });
+          expect(response).toMatchObject({ success: true });
+          assert(response && typeof response === "object" && "contentItems" in response);
+          const content = (response as { contentItems: Array<{ type: string; text?: string }> })
+            .contentItems;
+          return JSON.parse(
+            content
+              .filter((item) => item.type === "inputText")
+              .map((item) => item.text ?? "")
+              .join("\n"),
+          ) as { goal?: { id: string; tokensUsed: number; objective: string }; replayed?: boolean };
+        };
+        const threadContext = (tokens: number) =>
+          native.notify({
+            method: "thread/tokenUsage/updated",
+            params: {
+              threadId: "thread-1",
+              turnId: "turn-1",
+              tokenUsage: {
+                last: {
+                  inputTokens: tokens,
+                  cachedInputTokens: 0,
+                  outputTokens: 0,
+                  totalTokens: tokens,
+                },
+                total: { inputTokens: tokens * 9, outputTokens: 0, totalTokens: tokens * 9 },
+              },
+            },
+          });
+        await threadContext(5000);
+        expect((await callGoal("get_goal", "before-response")).goal).toMatchObject({
+          id: goal.id,
+          tokensUsed: 0,
+        });
+        const first = {
+          threadId: "thread-1",
+          turnId: "turn-1",
+          responseId: "response-1",
+          usage: { inputTokens: 100, cachedInputTokens: 20, outputTokens: 10, totalTokens: 110 },
+        };
+        await native.notify({ method: "rawResponse/completed", params: first });
+        await native.notify({ method: "rawResponse/completed", params: first });
+        await native.notify({
+          method: "rawResponse/completed",
+          params: {
+            ...first,
+            threadId: "foreign-thread",
+            responseId: "foreign-response",
+            usage: {
+              inputTokens: 9000,
+              cachedInputTokens: 0,
+              outputTokens: 1000,
+              totalTokens: 10000,
+            },
+          },
+        });
+        expect((await callGoal("get_goal", "after-first")).goal).toMatchObject({
+          id: goal.id,
+          tokensUsed: 110,
+        });
+        const corrected = await callGoal("update_goal", "human-correction", {
+          objective: "Complete the revised package",
+          goal_id: goal.id,
+        });
+        expect(corrected.goal).toMatchObject({
+          id: goal.id,
+          objective: "Complete the revised package",
+          tokensUsed: 110,
+        });
+        expect(accessor.loadSessionEntry(scope)?.goal).toMatchObject({
+          id: goal.id,
+          tokensUsed: 110,
+        });
+        await threadContext(9000);
+        await native.notify({
+          method: "rawResponse/completed",
+          params: {
+            threadId: "thread-1",
+            turnId: "turn-1",
+            responseId: "response-2",
+            usage: { inputTokens: 50, cachedInputTokens: 10, outputTokens: 5, totalTokens: 55 },
+          },
+        });
+        expect((await callGoal("get_goal", "after-second")).goal).toMatchObject({
+          id: goal.id,
+          tokensUsed: 165,
+        });
+        await native.notify({
+          method: "item/completed",
+          params: {
+            threadId: "thread-1",
+            turnId: "turn-1",
+            item: { id: "answer", type: "agentMessage", text: "The revised package is complete." },
+          },
+        });
+        await native.notify({
+          method: "turn/completed",
+          params: {
+            threadId: "thread-1",
+            turnId: "turn-1",
+            turn: { id: "turn-1", status: "completed", items: [] },
+          },
+        });
+        const result = await run;
+        expect(mockedRunEmbeddedAttempt).not.toHaveBeenCalled();
+        expect(nativeAttemptCount).toBe(1);
+        expect(result.meta?.agentMeta?.usage).toMatchObject({
+          input: 120,
+          output: 15,
+          cacheRead: 30,
+          total: 165,
+        });
+        const persisted = accessor.loadSessionEntry(scope);
+        expect(persisted?.goal).toMatchObject({
+          id: goal.id,
+          objective: "Complete the revised package",
+          tokensUsed: 165,
+          status: "active",
+        });
+        expect(persisted?.goalUsage?.run?.tokens).toBe(165);
+        await native.notify({
+          method: "rawResponse/completed",
+          params: { ...first, responseId: "late-response" },
+        });
+        expect(accessor.loadSessionEntry(scope)?.goal?.tokensUsed).toBe(165);
+      } finally {
+        abort.abort();
+        await run?.catch(() => {});
+        native.client.close();
+      }
+    });
+  }, 60_000);
+});

--- /dev/null
+++ b/extensions/browser/src/browser-credential-secret.runtime.ts
@@ -0,0 +1,17 @@
+import { registerSecretValueForRedaction } from "openclaw/plugin-sdk/browser-config";
+import { getRuntimeConfig } from "openclaw/plugin-sdk/runtime-config-snapshot";
+import { resolveSecretRefValues, type SecretRef } from "openclaw/plugin-sdk/secret-ref-runtime";
+
+/** Resolve exactly one binding only after browser-owned preflight has passed. */
+export async function resolveBrowserCredentialSecret(ref: SecretRef): Promise<string> {
+  const values = await resolveSecretRefValues([ref], {
+    config: getRuntimeConfig(),
+    env: process.env,
+  });
+  const resolved = Array.from(values.values());
+  if (resolved.length !== 1 || typeof resolved[0] !== "string" || !resolved[0]) {
+    throw new Error("Browser credential could not be resolved.");
+  }
+  registerSecretValueForRedaction(resolved[0]);
+  return resolved[0];
+}

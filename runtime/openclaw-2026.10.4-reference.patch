+}
+
+export function redactBrowserConfidentialAxValues(
+  nodes: RawAXNode[],
+  fields: readonly ConfidentialRoleSnapshotField[],
+): RawAXNode[] {
+  const counts = new Map<string, number>();
+  const hidden = new Set<string>();
+  const byId = new Map(nodes.map((node) => [node.nodeId, node]));
+  const hideChildren = (id: string) => {
+    if (hidden.has(id)) {
+      return;
+    }
+    hidden.add(id);
+    for (const child of byId.get(id)?.childIds ?? []) {
+      hideChildren(child);
+    }
+  };
+  const marked = new Set<RawAXNode>();
+  for (const node of nodes) {
+    const role = node.role?.value?.toLowerCase() ?? "";
+    const name = node.name?.value || undefined;
+    const key = `${role}\0${name ?? ""}`;
+    const nth = counts.get(key) ?? 0;
+    counts.set(key, nth + 1);
+    if (fields.some((field) => field.role === role && field.name === name && field.nth === nth)) {
+      marked.add(node);
+      for (const child of node.childIds ?? []) {
+        hideChildren(child);
+      }
+    }
+  }
+  return nodes.map((node) => {
+    if (!marked.has(node) && !hidden.has(node.nodeId ?? "")) {
+      return node;
+    }
+    return {
+      ...node,
+      value: undefined,
+      description: undefined,
+      ...(hidden.has(node.nodeId ?? "") ? { name: { value: "[REDACTED]" } } : {}),
+    };
+  });
+}
+
+/** Native screenshot emulation shares a field-only paint exclusion. */
+export async function withBrowserConfidentialFieldPaintMask<T>(
+  page: Page,
+  run: () => Promise<T>,
+): Promise<T> {
+  const styles: ElementHandle[] = [];
+  const [capture] = await Promise.allSettled([
+    (async () => {
+      for (const frame of page.frames()) {
+        // Preserve layout while excluding the filled control from native painting.
+        styles.push(
+          await frame.addStyleTag({
+            content: `${confidentialFrameSelector(frame)} { visibility: hidden !important; }`,
+          }),
+        );
+      }
+      return await run();
+    })(),
+  ]);
+  // Restore every retained mask after setup/capture settles. Restoration failure
+  // blocks publication; otherwise preserve the original capture outcome.
+  const cleanup = await Promise.allSettled(
+    styles.map(async (style) => {
+      try {
+        await style.evaluate((element) => {
+          element.parentNode?.removeChild(element);
+        });
+      } finally {
+        await style.dispose();
+      }
+    }),
+  );
+  const failed = cleanup.find((result) => result.status === "rejected");
+  if (failed?.status === "rejected") {
+    throw failed.reason;
+  }
+  if (capture.status === "rejected") {
+    throw capture.reason;
+  }
+  return capture.value;
+}

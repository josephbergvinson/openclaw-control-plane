+              }
+              offset += bytesWritten;
+            }
+          }
+          buffer.fill(0);
+          const after = await reader.stat();
+          if (
+            digest.digest("hex") !== entry.sha256 ||
+            before.dev !== after.dev ||
+            before.ino !== after.ino ||
+            before.size !== after.size ||
+            before.mtimeMs !== after.mtimeMs ||
+            before.ctimeMs !== after.ctimeMs
+          ) {
+            throw new Error("Native projection source bytes changed during copying");
+          }
+          await writer.chmod(entry.mode);
+          await writer.sync();
+          const written = await writer.stat();
+          if (
+            !written.isFile() ||
+            written.nlink !== 1 ||
+            written.uid !== entry.identity.ownerUid ||
+            written.size !== entry.bytes ||
+            (written.mode & 0o7777) !== entry.mode
+          ) {
+            throw new Error("Native projected file custody/write mismatch");
+          }
+          copiedFiles.set(target, written);
+        } finally {
+          await writer.close();
+        }
+      } finally {
+        await reader.close();
+      }
+    }
+    for (const entry of [...root.entries]
+      .filter((candidate) => candidate.kind === "directory")
+      .toSorted(
+        (a, b) => b.relativePath.split(path.sep).length - a.relativePath.split(path.sep).length,
+      )) {
+      const destination = project(path.join(root.path, entry.relativePath));
+      await fs.chmod(destination, entry.mode);
+      const directory = await fs.open(
+        destination,
+        fsConstants.O_RDONLY | (fsConstants.O_DIRECTORY ?? 0),
+      );
+      try {
+        await directory.sync();
+      } finally {
+        await directory.close();
+      }
+    }
+  }
+  // Verify the complete copied namespace before publishing paths. File bytes
+  // were hashed while writing through the exclusive file descriptor above.
+  // The retained arg0 container must be empty here; only source traversal omits its children.
+  for (const root of projection.roots) {
+    for (const entry of root.entries) {
+      const target = project(path.join(root.path, entry.relativePath));
+      const info = await fs.lstat(target);
+      if (
+        (await fs.realpath(target)) !== target ||
+        info.uid !== entry.identity.ownerUid ||
+        (info.mode & 0o7777) !== entry.mode
+      ) {
+        throw new Error("Native projected namespace custody changed");
+      }
+      if (entry.kind === "directory") {
+        const expected = root.entries
+          .filter(
+            (candidate) =>
+              candidate.relativePath !== entry.relativePath &&
+              path.dirname(candidate.relativePath) === (entry.relativePath || "."),
+          )
+          .map((candidate) => path.basename(candidate.relativePath))
+          .toSorted();
+        if (
+          !info.isDirectory() ||
+          JSON.stringify((await fs.readdir(target)).toSorted()) !== JSON.stringify(expected)
+        ) {
+          throw new Error("Native projected directory membership changed");
+        }
+      } else {
+        const copied = copiedFiles.get(target);
+        if (
+          !copied ||
+          !info.isFile() ||
+          info.nlink !== 1 ||
+          info.size !== entry.bytes ||
+          JSON.stringify(nativeProjectionIdentity(info)) !==
+            JSON.stringify(nativeProjectionIdentity(copied)) ||
+          info.mtimeMs !== copied.mtimeMs ||
+          info.ctimeMs !== copied.ctimeMs
+        ) {
+          throw new Error("Native projected file changed after copying");
+        }
+      }
+    }
+  }
+  await validateNativeCodexProjection(projection, input.targetStateDir);
+  return projection.homes.map((home) => ({
+    id: home.id,
+    codexHome: project(home.codexHome),
+    sqliteHome: project(home.sqliteHome),
+    providerLabel: home.providerLabel,
+    familyPresence: home.familyPresence,
+  }));
+}

@@ -0,0 +1,108 @@
+import type { OpenClawConfig } from "openclaw/plugin-sdk/config-contracts";
+import { createDeferred } from "openclaw/plugin-sdk/extension-shared";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { DiscordVoicePlaybackRecording } from "./playback-recording.js";
+import type { DiscordVoiceTranscriptCapture } from "./recording-types.js";
+import type { VoiceSessionEntry } from "./session.js";
+
+const mocks = vi.hoisted(() => ({ append: vi.fn(), finish: vi.fn(), constructors: vi.fn() }));
+vi.mock("./voice-recording.js", () => ({
+  DiscordVoiceRecording: class {
+    completion = Promise.resolve();
+    append = mocks.append;
+    finish = mocks.finish;
+    constructor(params: unknown) {
+      mocks.constructors(params);
+    }
+  },
+}));
+beforeEach(() => {
+  vi.clearAllMocks();
+  mocks.append.mockResolvedValue(undefined);
+  mocks.finish.mockResolvedValue(undefined);
+});
+
+function fixture() {
+  let current = true;
+  let drain: (() => Promise<void>) | undefined;
+  const release = vi.fn();
+  const capture: DiscordVoiceTranscriptCapture = {
+    sessionId: "original",
+    recordingEpoch: 71n,
+    isCurrent: () => current,
+    onUtterance: vi.fn(),
+    registerPlaybackDrain: (finish) => {
+      drain = finish;
+      return { isCurrent: () => true, onUtterance: capture.onUtterance, release };
+    },
+  };
+  const entry = {
+    transcripts: capture,
+    sessionLifecycle: { status: "active" },
+  } as VoiceSessionEntry;
+  const owner = new DiscordVoicePlaybackRecording({
+    entry,
+    cfg: {} as OpenClawConfig,
+    userId: "assistant",
+    resolveSpeaker: async () => ({ label: "Assistant" }),
+  });
+  return {
+    entry,
+    owner,
+    capture,
+    release,
+    retire: () => {
+      current = false;
+      return drain?.();
+    },
+  };
+}
+
+describe("played assistant recording custody", () => {
+  it("does not adopt a capture that starts after response admission", async () => {
+    const f = fixture();
+    f.entry.transcripts = undefined;
+    const output = f.owner.create();
+    f.entry.transcripts = f.capture;
+    output.onPlayedPcm(Buffer.from([1, 2, 3, 4]));
+    await output.finish();
+    expect(mocks.append).not.toHaveBeenCalled();
+  });
+
+  it("drains already-played packets to their original capture and excludes later playback", async () => {
+    const f = fixture();
+    const barrier = createDeferred<void>();
+    const output = f.owner.create({ capture: f.capture, beforeFinish: () => barrier.promise });
+    const heardAt = Date.now();
+    const pending = f.retire();
+    f.entry.transcripts = { ...f.capture, sessionId: "replacement", recordingEpoch: 72n };
+    output.onPlayedPcm(Buffer.from([1, 2, 3, 4]), heardAt);
+    output.onPlayedPcm(Buffer.from([5, 6, 7, 8]), heardAt + 60_000);
+    expect(mocks.finish).not.toHaveBeenCalled();
+    barrier.resolve();
+    await pending;
+    expect(mocks.append).toHaveBeenCalledOnce();
+    expect(mocks.append.mock.calls[0]![1]).toMatchObject({
+      capture: { sessionId: "original" },
+      recordingEpoch: 71n,
+      startedAt: heardAt,
+    });
+    expect(f.release).toHaveBeenCalledOnce();
+    expect(mocks.constructors.mock.calls[0]![0].canConverse()).toBe(false);
+  });
+
+  it("holds the native recording lease through async append and transcription completion", async () => {
+    const f = fixture();
+    const append = createDeferred<void>();
+    mocks.append.mockReturnValueOnce(append.promise);
+    const output = f.owner.create({ capture: f.capture });
+    output.onPlayedPcm(Buffer.alloc(8));
+    const ending = output.finish();
+    await Promise.resolve();
+    expect(f.release).not.toHaveBeenCalled();
+    append.resolve();
+    await ending;
+    expect(mocks.finish).toHaveBeenCalledOnce();
+    expect(f.release).toHaveBeenCalledOnce();
+  });
+});
diff --git a/extensions/discord/src/voice/playback-recording.ts b/extensions/discord/src/voice/playback-recording.ts
new file mode 100644
index 0000000000000000000000000000000000000000..02103579866a1d689359329be5cb774341999d04
--- /dev/null
+++ b/extensions/discord/src/voice/playback-recording.ts
@@ -0,0 +1,152 @@
+import type { OpenClawConfig } from "openclaw/plugin-sdk/config-contracts";
+import { createSubsystemLogger } from "openclaw/plugin-sdk/runtime-env";
+import { formatErrorMessage } from "openclaw/plugin-sdk/ssrf-runtime";
+import type { DiscordVoiceTranscriptCapture } from "./recording-types.js";
+import type { VoiceSessionEntry } from "./session.js";
+import { DiscordVoiceRecording } from "./voice-recording.js";
+
+const logger = createSubsystemLogger("discord/voice");
+const MAX_PENDING_PLAYED_PCM_BYTES = 1024 * 1024;
+
+/** The room's outgoing audio uses the same batch recorder, never conversational ingress. */
+export class DiscordVoicePlaybackRecording {
+  private readonly outputs = new Set<() => Promise<void>>();
+  private closed = false;
+
+  constructor(
+    private readonly params: {
+      entry: VoiceSessionEntry;
+      cfg: OpenClawConfig;
+      userId: string;
+      resolveSpeaker: () => Promise<{ label: string }>;
+    },
+  ) {}
+
+  create(origin?: {
+    capture: DiscordVoiceTranscriptCapture | undefined;
+    beforeFinish?: () => Promise<void>;
+  }): {
+    onPlayedPcm: (pcm: Buffer, playedAt?: number) => void;
+    finish: () => Promise<void>;
+  } {
+    const { entry } = this.params;
+    let capture: DiscordVoiceTranscriptCapture | undefined;
+    // Admission without a capture stays uncaptured. Never adopt a meeting that
+    // starts while this response is synthesizing, queued, or waiting for PCM.
+    const sourceCapture = origin ? origin.capture : entry.transcripts;
+    let releaseCapture: (() => void) | undefined;
+    let pendingBytes = 0;
+    let pending = Promise.resolve();
+    let completion: Promise<void> | undefined;
+    let ended = this.closed;
+    let closingAt: number | undefined;
+    const warn = (error: unknown) => {
+      sourceCapture?.onPlaybackIncomplete?.();
+      logger.warn(`discord voice: playback recording failed: ${formatErrorMessage(error)}`);
+    };
+    const recording = new DiscordVoiceRecording({
+      ...this.params,
+      isInputComplete: () => true,
+      minimumSeconds: () => 0,
+      canConverse: () => false,
+      resolveIngressContext: async () => null,
+      onSegment: (outcome) => {
+        void outcome
+          .then((result) => {
+            if (result.status === "unavailable" || result.status === "excluded") {
+              sourceCapture?.onPlaybackIncomplete?.();
+            }
+          })
+          .catch(warn);
+      },
+      onExcluded: () => sourceCapture?.onPlaybackIncomplete?.(),
+    });
+    const finish = (): Promise<void> => {
+      closingAt ??= Date.now();
+      completion ??= (async () => {
+        try {
+          await origin?.beforeFinish?.();
+        } catch (error) {
+          warn(error);
+        }
+        // Worker message order now includes every packet played before closingAt.
+        ended = true;
+        await pending;
+        await recording.finish();
+        await recording.completion;
+      })()
+        .catch(warn)
+        .finally(() => {
+          releaseCapture?.();
+          this.outputs.delete(finish);
+        });
+      return completion;
+    };
+    this.outputs.add(finish);
+    if (!ended && sourceCapture?.isCurrent()) {
+      const receipt = sourceCapture.registerPlaybackDrain?.(finish);
+      if (sourceCapture.registerPlaybackDrain && !receipt) {
+        ended = true;
+      } else {
+        capture = receipt
+          ? { ...sourceCapture, isCurrent: receipt.isCurrent, onUtterance: receipt.onUtterance }
+          : sourceCapture;
+        releaseCapture = receipt?.release;
+      }
+    } else {
+      ended = true;
+    }
+    if (ended) {
+      void finish();
+    }
+    return {
+      finish,
+      onPlayedPcm: (pcm, playedAt) => {
+        if (
+          ended ||
+          !pcm.length ||
+          (closingAt !== undefined && (playedAt ?? Date.now()) > closingAt)
+        ) {
+          return;
+        }
+        if (!capture?.isCurrent() || (!sourceCapture?.isCurrent() && closingAt === undefined)) {
+          return;
+        }
+        if (entry.transcripts !== sourceCapture && closingAt === undefined) {
+          // An old response cannot reopen into a replacement meeting.
+          void finish();
+          return;
+        }
+        if (pcm.length > MAX_PENDING_PLAYED_PCM_BYTES - pendingBytes) {
+          warn(new Error("Playback recording backlog exceeded; saving only the accepted audio."));
+          void finish();
+          return;
+        }
+        // Freeze capture and time synchronously at the player's source-packet read,
+        // not when encoding, provider generation, disk writes, or STT complete.
+        const receipt = {
+          capture,
+          recordingEpoch: sourceCapture?.recordingEpoch ?? 0n,
+          startedAt: playedAt ?? Date.now(),
+        };
+        pendingBytes += pcm.length;
+        pending = pending
+          .then(() => recording.append(pcm, receipt))
+          .catch((error: unknown) => {
+            ended = true;
+            warn(error);
+          })
+          .finally(() => {
+            pendingBytes -= pcm.length;
+          });
+      },
+    };
+  }
+
+  close(): void | Promise<void> {
+    this.closed = true;
+    if (this.outputs.size) {
+      return Promise.all([...this.outputs].map((finish) => finish())).then(() => undefined);
+    }
+  }
+}

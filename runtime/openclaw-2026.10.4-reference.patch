+import { createDeferred } from "openclaw/plugin-sdk/extension-shared";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { fetchBrowserJson } from "./client-fetch.js";
+import { withBrowserRequestScope } from "./request-scope.js";
+import type { BrowserRequest } from "./routes/types.js";
+
+type Guarded = Parameters<typeof import("openclaw/plugin-sdk/ssrf-runtime").fetchWithSsrFGuard>[0];
+const mocks = vi.hoisted(() => ({
+  http: vi.fn(async (_request: Guarded) => ({
+    response: new Response('{"ok":true}'),
+    release: async () => {},
+  })),
+  local: vi.fn(async (_request: BrowserRequest) => ({ status: 200, body: { ok: true } })),
+}));
+vi.mock("openclaw/plugin-sdk/runtime-config-snapshot", async (actual) => ({
+  ...(await actual<typeof import("openclaw/plugin-sdk/runtime-config-snapshot")>()),
+  getRuntimeConfig: () => ({}),
+}));
+vi.mock("./control-auth.js", () => ({ resolveBrowserControlAuth: () => ({}) }));
+vi.mock("./bridge-auth-registry.js", () => ({ getBridgeAuthForPort: () => undefined }));
+vi.mock("openclaw/plugin-sdk/ssrf-runtime", async (actual) => ({
+  ...(await actual<typeof import("openclaw/plugin-sdk/ssrf-runtime")>()),
+  fetchWithSsrFGuard: mocks.http,
+}));
+vi.mock("./local-dispatch.runtime.js", () => ({ dispatchBrowserControlRequest: mocks.local }));
+beforeEach(() => {
+  mocks.http.mockReset();
+  mocks.local.mockReset();
+});
+describe("native close request fence across Browser transport preparation", () => {
+  it.each([
+    { transport: "http", current: true },
+    { transport: "http", current: false },
+    { transport: "local", current: true },
+    { transport: "local", current: false },
+  ] as const)(
+    "checks $transport at actual dispatch (current=$current)",
+    async ({ transport, current: currentAtDispatch }) => {
+      const entered = createDeferred<void>();
+      const release = createDeferred<void>();
+      let current = true;
+      let effects = 0;
+      mocks.http.mockImplementation(async (request) => {
+        entered.resolve();
+        await release.promise;
+        request.beforeRequest?.();
+        effects += 1;
+        return { response: new Response('{"ok":true}'), release: async () => {} };
+      });
+      mocks.local.mockImplementation(async (request) => {
+        entered.resolve();
+        await release.promise;
+        await request.assertCurrent?.();
+        effects += 1;
+        return { status: 200, body: { ok: true } };
+      });
+      const pending = withBrowserRequestScope(
+        {
+          managedOnly: false,
+          assertCurrent: () => {
+            if (!current) {
+              throw new Error("close authority revoked");
+            }
+          },
+        },
+        () =>
+          fetchBrowserJson(
+            transport === "http" ? "http://127.0.0.1:18791/tabs/owned" : "/tabs/owned",
+            { method: "DELETE" },
+          ),
+      );
+      const checked = currentAtDispatch
+        ? expect(pending).resolves.toEqual({ ok: true })
+        : expect(pending).rejects.toThrow("close authority revoked");
+      await entered.promise;
+      current = currentAtDispatch;
+      release.resolve();
+      await checked;
+      expect(effects).toBe(currentAtDispatch ? 1 : 0);
+      if (transport === "local") {
+        expect(mocks.local.mock.calls[0]?.[0].query).not.toHaveProperty("managedOnly");
+      }
+    },
+  );
+  it("preserves the dashboard's local managed-only restriction", async () => {
+    await expect(
+      withBrowserRequestScope({ managedOnly: true, assertCurrent: () => {} }, () =>
+        fetchBrowserJson("http://127.0.0.1:18791/tabs/owned", { method: "DELETE" }),
+      ),
+    ).rejects.toThrow("local managed browser");
+    expect(mocks.http).not.toHaveBeenCalled();
+  });
+});

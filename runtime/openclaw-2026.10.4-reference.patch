diff --git a/extensions/discord/src/voice/voice-auto-join.ts b/extensions/discord/src/voice/voice-auto-join.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a29dce587375bb9c47959acc2cb40366ea842a94
--- /dev/null
+++ b/extensions/discord/src/voice/voice-auto-join.ts
@@ -0,0 +1,207 @@
+import type { createSubsystemLogger } from "openclaw/plugin-sdk/runtime-env";
+import {
+  logVoiceVerbose,
+  type VoiceGuildLifecycle,
+  type VoiceJoinOptions,
+  type VoiceOperationResult,
+  type VoiceSessionEntry,
+} from "./session.js";
+import type { VoiceChannelResidency } from "./voice-following.js";
+import type { CaptureJoinOrigin } from "./voice-runtime-params.js";
+
+export type DiscordVoiceAutoJoinContext = {
+  autoJoinChannels: readonly VoiceChannelResidency[];
+  autoJoinTasks: Map<string, Promise<VoiceOperationResult | undefined>>;
+  fatalAutoJoinFailures: Map<string, { message: string; skipLogged: boolean }>;
+  voiceEnabled: () => boolean;
+  destroyed: () => boolean;
+  isEntryCurrent: (entry: VoiceSessionEntry) => boolean;
+  reconcileChannelOccupancy: () => void;
+  startReconciliation: () => Promise<void>;
+  sessions: ReadonlyMap<string, VoiceSessionEntry>;
+  guildLifecycles: ReadonlyMap<string, VoiceGuildLifecycle>;
+  countHumanParticipants: (target: { guildId: string; channelId: string }) => number | null;
+  joinOwned: (
+    entry: VoiceChannelResidency,
+    options: VoiceJoinOptions,
+    captureOrigin?: CaptureJoinOrigin,
+  ) => Promise<VoiceOperationResult>;
+  leave: (target: { guildId: string; channelId: string }) => Promise<VoiceOperationResult>;
+  logger: Pick<ReturnType<typeof createSubsystemLogger>, "info" | "warn">;
+};
+
+const DISCORD_VOICE_FATAL_AUTOJOIN_ERROR_PATTERNS = [
+  "api key missing",
+  "incorrect api key",
+  "invalid api key",
+  "unauthorized",
+  "authentication",
+  "permission denied",
+  "forbidden",
+];
+
+function isFatalAutoJoinFailure(message: string): boolean {
+  const normalized = message.toLowerCase();
+  return DISCORD_VOICE_FATAL_AUTOJOIN_ERROR_PATTERNS.some((pattern) =>
+    normalized.includes(pattern),
+  );
+}
+
+/** Retain fatal startup/authentication failures under the manager's existing config lifetime. */
+function retainDiscordVoiceAutoJoinFatalFailure(
+  failures: DiscordVoiceAutoJoinContext["fatalAutoJoinFailures"],
+  target: { guildId: string; channelId: string },
+  message: string,
+): void {
+  if (isFatalAutoJoinFailure(message)) {
+    failures.set(`${target.guildId}:${target.channelId}`, { message, skipLogged: false });
+  }
+}
+
+/** Only this configured room's current runtime can retain a late provider failure. */
+export function retainDiscordVoiceAutoJoinTerminalFailure(
+  params: DiscordVoiceAutoJoinContext,
+  entry: VoiceSessionEntry,
+  error: Error,
+): void {
+  const target = params.autoJoinChannels.findLast(
+    (candidate) => candidate.guildId === entry.guildId.trim(),
+  );
+  if (
+    !params.destroyed() &&
+    params.isEntryCurrent(entry) &&
+    target?.channelId === entry.channelId
+  ) {
+    retainDiscordVoiceAutoJoinFatalFailure(params.fatalAutoJoinFailures, entry, error.message);
+  }
+}
+
+export async function autoJoinDiscordVoiceChannels(
+  params: DiscordVoiceAutoJoinContext,
+): Promise<void> {
+  if (!params.voiceEnabled() || params.destroyed()) {
+    return;
+  }
+  params.reconcileChannelOccupancy();
+  const entriesByGuild = new Map<string, VoiceChannelResidency>();
+  const duplicateGuilds = new Set<string>();
+  for (const entry of params.autoJoinChannels) {
+    if (entriesByGuild.has(entry.guildId)) {
+      duplicateGuilds.add(entry.guildId);
+    }
+    entriesByGuild.set(entry.guildId, entry);
+  }
+
+  logVoiceVerbose(
+    `autoJoin: ${params.autoJoinChannels.length} entries, ${entriesByGuild.size} guilds`,
+  );
+  for (const guildId of duplicateGuilds) {
+    const selected = entriesByGuild.get(guildId);
+    if (selected) {
+      params.logger.warn(
+        `discord voice: autoJoin has multiple entries for guild ${guildId}; using channel ${selected.channelId}`,
+      );
+    }
+  }
+
+  for (const entry of entriesByGuild.values()) {
+    await enqueueDiscordVoiceAutoJoin(params, entry);
+  }
+  await params.startReconciliation();
+}
+
+export function enqueueDiscordVoiceAutoJoin(
+  params: DiscordVoiceAutoJoinContext,
+  entry: VoiceChannelResidency,
+  captureOrigin?: CaptureJoinOrigin,
+): Promise<VoiceOperationResult | undefined> {
+  const previous = params.autoJoinTasks.get(entry.guildId) ?? Promise.resolve();
+  const task = previous
+    .catch(() => undefined)
+    .then(async () => await reconcileDiscordVoiceAutoJoinEntry(params, entry, captureOrigin))
+    .finally(() => {
+      if (params.autoJoinTasks.get(entry.guildId) === task) {
+        params.autoJoinTasks.delete(entry.guildId);
+      }
+    });
+  params.autoJoinTasks.set(entry.guildId, task);
+  return task;
+}
+
+async function reconcileDiscordVoiceAutoJoinEntry(
+  params: DiscordVoiceAutoJoinContext,
+  entry: VoiceChannelResidency,
+  captureOrigin?: CaptureJoinOrigin,
+): Promise<VoiceOperationResult | undefined> {
+  if (params.destroyed()) {
+    return { ok: false, message: "Discord voice manager is stopped." };
+  }
+  if (captureOrigin && !captureOrigin.isCurrent()) {
+    return { ok: false, message: "Discord voice join was cancelled." };
+  }
+  const failureKey = `${entry.guildId}:${entry.channelId}`;
+  const fatalFailure = params.fatalAutoJoinFailures.get(failureKey);
+  if (fatalFailure) {
+    if (!fatalFailure.skipLogged) {
+      params.logger.warn(
+        `discord voice: autoJoin suppressed guild=${entry.guildId} channel=${entry.channelId} after fatal startup failure; retry with /vc join or reload config after fixing credentials: ${fatalFailure.message}`,
+      );
+      fatalFailure.skipLogged = true;
+    }
+    return { ok: false, message: fatalFailure.message };
+  }
+
+  // Capture-triggered work keeps its original source/residency guards through
+  // joinOwned. Ordinary reconciliation alone owns leaving an empty channel.
+  if (entry.whenOccupied && !captureOrigin) {
+    const humanCount = params.countHumanParticipants(entry);
+    if (humanCount === null) {
+      logVoiceVerbose(
+        `autoJoin waiting for guild voice snapshot guild=${entry.guildId} channel=${entry.channelId}`,
+      );
+      return undefined;
+    }
+    const existing = params.sessions.get(entry.guildId);
+    if (humanCount === 0) {
+      if (!existing?.autoJoinWhenOccupied || existing.channelId !== entry.channelId) {
+        return undefined;
+      }
+      params.logger.info(
+        `discord voice: occupied autoJoin leaving empty channel guild=${entry.guildId} channel=${entry.channelId}`,
+      );
+      const result = await params.leave({ guildId: entry.guildId, channelId: entry.channelId });
+      if (!result.ok) {
+        params.logger.warn(
+          `discord voice: occupied autoJoin failed to leave guild=${entry.guildId} channel=${entry.channelId}: ${result.message}`,
+        );
+      }
+      return undefined;
+    }
+    const lifecycle = params.guildLifecycles.get(entry.guildId);
+    if (existing || lifecycle?.status === "starting" || lifecycle?.status === "active") {
+      return undefined;
+    }
+    params.logger.info(
+      `discord voice: occupied autoJoin joining guild=${entry.guildId} channel=${entry.channelId} humans=${humanCount}`,
+    );
+  } else {
+    logVoiceVerbose(`autoJoin: joining guild ${entry.guildId} channel ${entry.channelId}`);
+  }
+
+  const result = await params.joinOwned(
+    entry,
+    { autoJoinWhenOccupied: entry.whenOccupied === true },
+    captureOrigin,
+  );

+/** Remove only scalar content owned by the exact native confidential field uid. */
+export function redactChromeMcpConfidentialFields(
+  root: ChromeMcpSnapshotNode,
+  confidentialUids: ReadonlySet<string>,
+): ChromeMcpSnapshotNode {
+  const copy: ChromeMcpSnapshotNode = { ...root, ...(root.children ? { children: [] } : {}) };
+  const pending = [{ source: root, result: copy }];
+  while (pending.length) {
+    const current = pending.pop();
+    if (!current) {
+      break;
+    }
+    if (current.source.id && confidentialUids.has(current.source.id)) {
+      current.result.value = undefined;
+      current.result.description = undefined;
+      // Native scalar descendants belong to this field, while its label/ref stays actionable.
+      current.result.children = [];
+      continue;
+    }
+    if (current.source.children) {
+      const children: ChromeMcpSnapshotNode[] = [];
+      for (const child of current.source.children) {
+        const result: ChromeMcpSnapshotNode = {
+          ...child,
+          ...(child.children ? { children: [] } : {}),
+        };
+        pending.push({ source: child, result });
+        children.push(result);
+      }
+      current.result.children = children;
+    }
+  }
+  return copy;
+}

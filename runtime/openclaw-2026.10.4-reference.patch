--- /dev/null
+++ b/extensions/discord/src/voice/realtime-speaker-errors.ts
@@ -0,0 +1,17 @@
+import { DiscordRealtimePlaybackOverflowError } from "./realtime-playback.js";
+
+/** This input is fenced locally; the room and its receive-recovery owner stay current. */
+export class DiscordRealtimeIncompleteInputError extends Error {
+  constructor() {
+    super("Discord realtime received incomplete speech.");
+    this.name = "DiscordRealtimeIncompleteInputError";
+  }
+}
+
+/** Local speaker failures retire that connection without escalating to the whole room. */
+export function isLocalSpeakerError(error: unknown): boolean {
+  return (
+    error instanceof DiscordRealtimeIncompleteInputError ||
+    error instanceof DiscordRealtimePlaybackOverflowError
+  );
+}

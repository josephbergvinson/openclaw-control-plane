+    expect(readEvidence).toHaveBeenCalledTimes(5);
+    expect(requests).toHaveLength(2);
+    expect(onMidTurnPrecheck).not.toHaveBeenCalled();
+    expect(activeSession.messages.at(-1)).toMatchObject({ stopReason: "stop" });
+  });
+  it("continues after a provider-identified response without assigning a fallback tool turn id", async () => {
+    const responseId = "provider-response-measured-loop";
+    const { activeSession, requests, onMidTurnPrecheck, readEvidence } = await runMeasuredLoop(
+      false,
+      responseId,
+    );
+    expect(readEvidence).toHaveBeenCalledTimes(5);
+    expect(requests).toHaveLength(2);
+    expect(onMidTurnPrecheck).not.toHaveBeenCalled();
+    const boundary = activeSession.messages.find((message) => message.role === "assistant");
+    expect(boundary).toMatchObject({ responseId, stopReason: "toolUse" });
+    expect(boundary).not.toHaveProperty("turnId");
+    expect(activeSession.messages.at(-1)).toMatchObject({ stopReason: "stop" });
+  });
+  it("still requests recovery when permission instructions actually change during tools", async () => {
+    const { activeSession, requests, onMidTurnPrecheck, readEvidence } =
+      await runMeasuredLoop(true);
+    expect(readEvidence).toHaveBeenCalledTimes(5);
+    expect(requests).toHaveLength(1);
+    expect(onMidTurnPrecheck).toHaveBeenCalledOnce();
+    expect(activeSession.messages.at(-1)).toMatchObject({ stopReason: "error" });
+  });
+});

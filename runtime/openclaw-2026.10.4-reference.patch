+  const session = request.params?.arguments?.session;
+  const tool = request.params?.name;
+  if (typeof session !== "string" || typeof tool !== "string") {
+    throw new Error("fixture tool/session binding is missing");
+  }
+  return {
+    content: [
+      {
+        type: "text",
+        text: `session has ended; tool call '${tool}' was rejected. Call start_session with session '${session}' to start it again, or use a new session label.`,
+      },
+    ],
+    isError: true,
+    structuredContent: { code: "tool_invocation_failed", exit_code: 1 },
+  };
+}

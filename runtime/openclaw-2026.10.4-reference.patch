+/** Constrained local hosts admit one native checker/build across all checkouts. */
+export function resolveLocalCheckAdmission(
+  env: Env,
+  hostResources: Resources,
+  platform = process.platform,
+) {
+  if (
+    isCiLikeEnv(env) ||
+    platform === "win32" ||
+    (resolveCheckMemoryCapacityBytes(hostResources) >= DEFAULT_FAST_LOCAL_CHECK_MIN_MEMORY_BYTES &&
+      hostResources.logicalCpuCount >= DEFAULT_FAST_LOCAL_CHECK_MIN_CPUS)
+  ) {
+    return undefined;
+  }
+  return path.join(os.homedir(), ".cache", "openclaw-local-checks");
+}
+
+export type LocalCheckLifecycle = { spawnAttempted: boolean; terminated: boolean };
+
+/** Release admission only after its existing process owner certifies extinction. */
+export async function withLocalCheckAdmission<T>(
+  directory: string | undefined,
+  operation: (lifecycle?: LocalCheckLifecycle) => Promise<T>,
+  signal?: AbortSignal,
+): Promise<T> {
+  signal?.throwIfAborted();
+  if (!directory) {
+    return await operation();
+  }
+  const [{ acquireFileLock }, { root: openLockRoot }] = await Promise.all([
+    import("@openclaw/fs-safe/file-lock"),
+    import("@openclaw/fs-safe/root"),
+  ]);
+  fs.mkdirSync(directory, { recursive: true, mode: 0o700 });
+  const ownerPath = path.join(directory, "owner.json");
+  let lock;
+  try {
+    lock = await acquireFileLock(ownerPath, {
+      lockPath: ownerPath,
+      lockRoot: await openLockRoot(directory),
+      payload: () => ({ pid: process.pid, startedAt: new Date().toISOString() }),
+      retainOnExit: true,
+      staleRecovery: "fail-closed",
+      shouldReclaim: () => false,
+      timeoutMs: 0,
+      retry: { retries: 0 },
+    });
+  } catch (cause) {
+    const busy =
+      cause && typeof cause === "object" && "code" in cause && cause.code === "file_lock_timeout";
+    throw Object.assign(
+      new Error(
+        busy
+          ? `[local check] Native validation is busy: ${ownerPath}. Retry after its process tree has finished; an abandoned lease requires verified process cleanup before recovery.`
+          : `[local check] Could not acquire native validation ownership: ${ownerPath}.`,
+        { cause },
+      ),
+      { code: busy ? "ELOCAL_CHECK_BUSY" : "ELOCAL_CHECK_ADMISSION" },
+    );
+  }
+  const lifecycle = { spawnAttempted: false, terminated: false };
+  try {
+    signal?.throwIfAborted();
+    return await operation(lifecycle);
+  } finally {
+    if (!lifecycle.spawnAttempted || lifecycle.terminated) {
+      await lock.release();
+    } else {
+      console.error(`[local check] Process cleanup unverified; retained ${ownerPath}`);
+    }
+  }

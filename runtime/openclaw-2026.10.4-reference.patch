+    func `passkey form cannot borrow identity controls or process ownership`(_ change: String) {
+        var nodes = Self.form()
+        switch change {
+        case "web": nodes[1] = .init(parent: 0, role: "AXWebArea", subrole: nil, text: [], ownerPID: 43)
+        case "window": nodes[0] = .init(parent: nil, role: "AXWindow", subrole: "AXDialog", text: [], ownerPID: 43)
+        case "hosting": nodes[1] = .init(parent: 0, role: "AXGroup", subrole: nil, text: [], ownerPID: 43)
+        case "field-owner": nodes[6].ownerPID = 43
+        case "field-metadata": nodes[6].ownerPID = nil
+        case "host-metadata": nodes[1].ownerPID = nil
+        case "sheet-owner": nodes[0].ownerPID = 44
+        case "control-owner": nodes[7].ownerPID = 42
+        case "nonsecure":
+            nodes[6] = .init(parent: 1, role: "AXTextField", subrole: nil, text: [], ownerPID: 42)
+        case "lock": nodes[2].identifier = "key.fill"
+        case "instruction-outside":
+            nodes[5] = .init(parent: nil, role: "AXStaticText", subrole: nil, text: nodes[5].text, ownerPID: 43)
+        case "instruction-sibling":

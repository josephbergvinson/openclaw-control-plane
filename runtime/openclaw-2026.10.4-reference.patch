index 0000000000000000000000000000000000000000..e6be87cdc5b5b5f47e254154b35b86bdcc1eb3b4
--- /dev/null
+++ b/extensions/browser/src/browser/credential-origin.ts
@@ -0,0 +1,95 @@
+import { HTTPS_BROWSER_CREDENTIAL_ORIGIN_PATTERN_SOURCE } from "./credential-origin-pattern.js";
+
+const CHROME_EXTENSION_ORIGIN_PATTERN = /^chrome-extension:\/\/[a-p]{32}$/;
+const CHROME_EXTENSION_URL_PATTERN = /^(chrome-extension:\/\/[a-p]{32})(?:\/|$)/;
+
+const HTTPS_BROWSER_CREDENTIAL_ORIGIN_PATTERN = new RegExp(
+  HTTPS_BROWSER_CREDENTIAL_ORIGIN_PATTERN_SOURCE,
+);
+
+function parseBrowserCredentialOrigin(value: string): string | null {
+  if (CHROME_EXTENSION_ORIGIN_PATTERN.test(value)) {
+    return value;
+  }
+  if (!HTTPS_BROWSER_CREDENTIAL_ORIGIN_PATTERN.test(value)) {
+    return null;
+  }
+  try {
+    const parsed = new URL(value);
+    if (
+      parsed.protocol !== "https:" ||
+      parsed.username ||
+      parsed.password ||
+      parsed.pathname !== "/" ||
+      parsed.search ||
+      parsed.hash ||
+      value !== parsed.origin
+    ) {
+      return null;
+    }
+    return parsed.origin;
+  } catch {
+    return null;
+  }
+}
+
+/** Require an exact canonical HTTPS or Chrome-extension origin. */
+export function normalizeBrowserCredentialExpectedOrigin(value: string): string {
+  const origin = typeof value === "string" ? parseBrowserCredentialOrigin(value) : null;
+  if (!origin) {
+    throw new Error(
+      "allowedOrigins entries must be exact canonical HTTPS or chrome-extension:// origins",
+    );
+  }
+  return origin;
+}
+
+/** Read the credential-eligible origin of a live page URL. */
+export function readBrowserCredentialOriginFromUrl(rawUrl: string): string | null {
+  if (typeof rawUrl !== "string") {
+    return null;
+  }
+  const extension = CHROME_EXTENSION_URL_PATTERN.exec(rawUrl)?.[1];
+  if (extension) {
+    return extension;
+  }
+  try {
+    const parsed = new URL(rawUrl);
+    return parsed.protocol === "https:" ? parsed.origin : null;
+  } catch {
+    return null;
+  }
+}
+
+export function assertBrowserCredentialExpectedOrigin(params: {
+  currentUrl: string;
+  expectedOrigin: string;
+}): void {
+  const expectedOrigin = normalizeBrowserCredentialExpectedOrigin(params.expectedOrigin);
+  const currentOrigin = readBrowserCredentialOriginFromUrl(params.currentUrl);
+  if (!currentOrigin) {
+    throw new Error("Browser credential origin could not be verified before fill.");
+  }
+  if (currentOrigin !== expectedOrigin) {
+    throw new Error("Browser credential origin changed before fill.");
+  }
+}
+
+export function assertBrowserCredentialTargetOrigin(params: {
+  targetOrigin: unknown;
+  expectedOrigin: string;
+}): void {
+  const expectedOrigin = normalizeBrowserCredentialExpectedOrigin(params.expectedOrigin);
+  let targetOrigin: string;
+  try {
+    if (typeof params.targetOrigin !== "string") {
+      throw new Error("non-string target origin");
+    }
+    targetOrigin = normalizeBrowserCredentialExpectedOrigin(params.targetOrigin);
+  } catch {
+    throw new Error("Browser credential target origin could not be verified before fill.");
+  }
+  if (targetOrigin !== expectedOrigin) {
+    throw new Error("Browser credential target origin changed before fill.");
+  }
+}

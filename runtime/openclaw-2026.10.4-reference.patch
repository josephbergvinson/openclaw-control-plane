+import { EventEmitter } from "node:events";
+import { describe, expect, it, vi } from "vitest";
+import type { DiscordAudioTransport } from "./audio-transport.js";
+import type { DiscordAudioEvent } from "./audio-worker-protocol.js";
+import {
+  createDiscordPlayedAudioPublisher,
+  flushDiscordPlayedAudio,
+  MAX_PENDING_PLAYED_AUDIO_BYTES,
+} from "./played-audio.js";
+
+describe("worker-owned played audio receipts", () => {
+  it("publishes only exact admitted source PCM and retains its native capture epoch", () => {
+    const post = vi.fn();
+    const credit = new SharedArrayBuffer(8);
+    const publish = createDiscordPlayedAudioPublisher({ id: 7, epoch: 29n, credit, post });
+    const pcm = Buffer.from([1, 2, 3, 4]);
+    publish(pcm);
+    expect(post).toHaveBeenCalledWith({
+      type: "output-played",
+      id: 7,
+      pcm,
+      recordingEpoch: 29n,
+      playedAt: expect.any(Number),
+    });
+    expect(Atomics.load(new Int32Array(credit), 0)).toBe(pcm.length);
+    createDiscordPlayedAudioPublisher({ id: 8, epoch: 0n, credit, post })(pcm);
+    expect(post).toHaveBeenCalledOnce();
+  });
+
+  it("bounds IPC without blocking playback and records overflow explicitly", () => {
+    const post = vi.fn();
+    const credit = new SharedArrayBuffer(8);
+    const publish = createDiscordPlayedAudioPublisher({ id: 7, epoch: 29n, credit, post });
+    publish(Buffer.alloc(MAX_PENDING_PLAYED_AUDIO_BYTES));
+    publish(Buffer.alloc(4));
+    expect(post).toHaveBeenCalledOnce();
+    expect([...new Int32Array(credit)]).toEqual([MAX_PENDING_PLAYED_AUDIO_BYTES, 1]);
+    Atomics.sub(new Int32Array(credit), 0, MAX_PENDING_PLAYED_AUDIO_BYTES);
+    publish(Buffer.alloc(4));
+    expect(post).toHaveBeenCalledTimes(2);
+  });
+
+  it("joins the exact worker barrier before sealing, and releases its listeners", async () => {
+    const audio = new EventEmitter() as DiscordAudioTransport;
+    audio.allocateId = () => 91;
+    const send = vi.fn();
+    audio.send = send;
+    const pending = flushDiscordPlayedAudio(audio);
+    let settled = false;
+    void pending.then(() => {
+      settled = true;
+    });
+    audio.emit("event", { type: "played-flushed", id: 90 } satisfies DiscordAudioEvent);
+    await Promise.resolve();
+    expect(settled).toBe(false);
+    expect(send).toHaveBeenCalledWith({ type: "played-flush", id: 91 });
+    audio.emit("event", { type: "played-flushed", id: 91 });
+    await pending;
+    expect(audio.listenerCount("event")).toBe(0);
+    expect(audio.listenerCount("stopped")).toBe(0);
+  });
+});
diff --git a/extensions/discord/src/voice/played-audio.ts b/extensions/discord/src/voice/played-audio.ts
new file mode 100644
index 0000000000000000000000000000000000000000..79254962c1df32d20a522604a8b2e6a6aec61ab1
--- /dev/null
+++ b/extensions/discord/src/voice/played-audio.ts
@@ -0,0 +1,77 @@
+import { toErrorObject } from "openclaw/plugin-sdk/error-runtime";
+import type { DiscordAudioEvent } from "./audio-worker-protocol.js";
+
+// Byte credit bounds the worker-to-main queue independently of transcript/STT
+// processing. Playback never waits for the recorder or retains unbounded PCM.
+export const MAX_PENDING_PLAYED_AUDIO_BYTES = 1024 * 1024;
+export function createDiscordPlayedAudioPublisher(params: {
+  id: number;
+  epoch: bigint;
+  credit: SharedArrayBuffer;
+  post: (event: DiscordAudioEvent) => void;
+}): (pcm: Buffer) => void {
+  const credit = new Int32Array(params.credit);
+  return (pcm) => {
+    if (params.epoch === 0n || !pcm.length) {
+      return;
+    }
+    const previous = Atomics.add(credit, 0, pcm.length);
+    if (previous + pcm.length > MAX_PENDING_PLAYED_AUDIO_BYTES) {
+      Atomics.sub(credit, 0, pcm.length);
+      Atomics.store(credit, 1, 1);
+      return;
+    }
+    try {
+      params.post({
+        type: "output-played",
+        id: params.id,
+        pcm,
+        recordingEpoch: params.epoch,
+        playedAt: Date.now(),
+      });
+    } catch (error) {
+      Atomics.sub(credit, 0, pcm.length);
+      throw error;
+    }
+  };
+}
+
+/** Join the worker's already-published PCM before sealing an exact recording. */
+export function flushDiscordPlayedAudio(
+  audio: import("./audio-transport.js").DiscordAudioTransport,
+): Promise<void> {
+  if (audio.isTerminal || audio.connectionStatus === "destroyed") {
+    return Promise.resolve();
+  }
+  const id = audio.allocateId();
+  return new Promise((resolve, reject) => {
+    const cleanup = () => {
+      clearTimeout(timer);
+      audio.off("event", onEvent);
+      audio.off("stopped", onStopped);
+    };
+    const onEvent = (event: DiscordAudioEvent) => {
+      if (event.type === "played-flushed" && event.id === id) {
+        cleanup();
+        resolve();
+      }
+    };
+    const onStopped = () => {
+      cleanup();
+      resolve();
+    };
+    const timer = setTimeout(() => {
+      cleanup();
+      reject(new Error("Discord played-audio drain timed out."));
+    }, 2_000);
+    timer.unref?.();
+    audio.on("event", onEvent);
+    audio.on("stopped", onStopped);
+    try {
+      audio.send({ type: "played-flush", id });
+    } catch (error) {
+      cleanup();
+      reject(toErrorObject(error, "Discord played-audio flush failed."));
+    }
+  });
+}
diff --git a/extensions/discord/src/voice/realtime-consult-delivery.ts b/extensions/discord/src/voice/realtime-consult-delivery.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8da375cfa85108b4d637a4ab58f6132e6ac4a271
--- /dev/null
+++ b/extensions/discord/src/voice/realtime-consult-delivery.ts
@@ -0,0 +1,127 @@
+import { createDeferred } from "openclaw/plugin-sdk/extension-shared";
+import type { RealtimeVoiceBridgeSession } from "openclaw/plugin-sdk/realtime-voice";
+import type {
+  AgentProxyConsultResult,
+  AgentProxyConsultState,
+  AgentProxyProviderDelivery,
+  DiscordRealtimeConsultParams,
+} from "./realtime-consult-state.js";
+import type { DiscordRealtimePlaybackPort } from "./realtime-playback.js";
+
+export const DISCORD_REALTIME_FALLBACK_TEXT =
+  "I hit an error while checking that. Please try again.";
+
+export const CANCELLED_CONSULT_RESULT = {
+  status: "cancelled",
+  message: "OpenClaw cancelled this consult before completion. Do not restart it.",
+};
+
+export function beginAgentProxyProviderDelivery(
+  providerDeliveries: Map<AgentProxyConsultState, Set<AgentProxyProviderDelivery>>,
+  state: AgentProxyConsultState,
+): AgentProxyProviderDelivery {
+  const delivery = { ...createDeferred<void>(), submissionStarted: false };
+  const deliveries = providerDeliveries.get(state) ?? new Set<AgentProxyProviderDelivery>();
+  deliveries.add(delivery);
+  providerDeliveries.set(state, deliveries);
+  return delivery;
+}
+
+export function settleAgentProxyProviderDelivery(
+  providerDeliveries: Map<AgentProxyConsultState, Set<AgentProxyProviderDelivery>>,
+  state: AgentProxyConsultState,
+  delivery: AgentProxyProviderDelivery,
+): void {
+  delivery.resolve();
+  const deliveries = providerDeliveries.get(state);
+  deliveries?.delete(delivery);
+  if (deliveries?.size === 0) {
+    providerDeliveries.delete(state);
+  }
+}
+
+export async function submitTerminalRealtimeToolResult(
+  callId: string,
+  session: RealtimeVoiceBridgeSession,
+  result: Record<string, string>,
+): Promise<void> {
+  // Providers without suppressed results still need a terminal result; the payload tells the
+  // model not to repeat audio that Discord already played or restart cancelled work.
+  if (session.bridge.supportsToolResultSuppression === false) {
+    await session.submitToolResult(callId, result);
+    return;
+  }
+  await session.submitToolResult(callId, result, { suppressResponse: true });
+}
+
+export async function submitAgentProxyConsultResult(
+  callId: string,
+  session: RealtimeVoiceBridgeSession,
+  result: AgentProxyConsultResult,
+  alreadyDelivered = false,
+): Promise<void> {
+  if ("status" in result) {
+    await submitTerminalRealtimeToolResult(callId, session, CANCELLED_CONSULT_RESULT);
+  } else if (alreadyDelivered || ("suppressResponse" in result && result.suppressResponse)) {
+    await submitTerminalRealtimeToolResult(callId, session, {
+      status: "already_delivered",
+      message: "OpenClaw already delivered this answer to Discord voice. Do not repeat it.",
+    });
+  } else {
+    await session.submitToolResult(callId, result);
+  }
+}
+
+export function deliverDetachedAgentProxyConsultResult(
+  state: AgentProxyConsultState,
+  playback: DiscordRealtimePlaybackPort,
+): void {
+  const result = state.result;
+  if (state.delivery !== "detached" || !result) {
+    return;
+  }
+  state.delivery = "status" in result ? "retired" : "playback";
+  if (!("status" in result)) {
+    playback.deliverRetainedSpeech("text" in result ? result.text : DISCORD_REALTIME_FALLBACK_TEXT);
+  }
+}
+
+export function clearAgentProxyProviderConsultState(
+  params: Pick<DiscordRealtimeConsultParams, "harness" | "playback" | "providerEpoch">,
+  providerDeliveries: Map<AgentProxyConsultState, Set<AgentProxyProviderDelivery>>,
+  preservePendingSpeech = false,
+): void {
+  const states = new Set([
+    ...params.harness.forcedConsults
+      .handles()
+      .flatMap((handle) => (handle.context ? [handle.context] : [])),
+    ...providerDeliveries.keys(),
+  ]);
+  for (const state of states) {
+    if (state.delivery === "forced-pending" || state.delivery === "provider-pending") {
+      const submissions = providerDeliveries.get(state);
+      if (
+        preservePendingSpeech &&
+        Array.from(submissions ?? []).some((delivery) => delivery.submissionStarted)
+      ) {
+        // A submission may already have reached the old provider; replay could duplicate speech.
+        state.delivery = "provider";
+        continue;
+      }
+      state.delivery =
+        preservePendingSpeech && state.providerEpoch === params.providerEpoch()
+          ? "detached"
+          : "retired";
+      deliverDetachedAgentProxyConsultResult(state, params.playback);
+    } else if (!preservePendingSpeech && state.delivery === "detached") {
+      state.delivery = "retired";
+    }
+  }
+  for (const deliveries of providerDeliveries.values()) {
+    for (const delivery of deliveries) {
+      delivery.resolve();
+    }
+  }
+  providerDeliveries.clear();
+  params.harness.forcedConsults.clear();
+}
diff --git a/extensions/discord/src/voice/realtime-consult-state.ts b/extensions/discord/src/voice/realtime-consult-state.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c431daee8dcf153d3ebddd051ff2c47c519add97
--- /dev/null
+++ b/extensions/discord/src/voice/realtime-consult-state.ts
@@ -0,0 +1,59 @@
+import type { createDeferred } from "openclaw/plugin-sdk/extension-shared";
+import type {
+  buildRealtimeVoiceAgentErrorProviderResult,
+  RealtimeVoiceAgentConsultToolPolicy,
+  RealtimeVoiceForcedConsultHandle,
+  RealtimeVoiceSessionHarness,
+  RealtimeVoiceWakeNamePolicy,
+} from "openclaw/plugin-sdk/realtime-voice";
+import type { DiscordVoiceIngressContext } from "./ingress.js";
+import type { DiscordRealtimePlaybackPort } from "./realtime-playback.js";
+import type { DiscordRealtimeSpeakerContext, DiscordRealtimeTurns } from "./realtime-turns.js";
+import type { VoiceRealtimeAgentTurnParams, VoiceSessionEntry } from "./session.js";
+
+export type AgentProxyConsultResult =
+  | { text: string; suppressResponse?: true }
+  | ReturnType<typeof buildRealtimeVoiceAgentErrorProviderResult>;
+
+export type AgentProxyProviderDelivery = ReturnType<typeof createDeferred<void>> & {
+  submissionStarted: boolean;
+};
+
+export type AgentProxyConsultState = {
+  speaker: DiscordRealtimeSpeakerContext;
+  providerEpoch: number;
+  delivery:
+    | "provider-pending"
+    | "provider"
+    | "forced-pending"
+    | "playback"
+    | "detached"
+    | "retired";
+  promise?: Promise<AgentProxyConsultResult>;
+  result?: AgentProxyConsultResult;
+  requesterFinalAccepted?: boolean;
+};
+
+export type AgentProxyConsultHandle = RealtimeVoiceForcedConsultHandle<AgentProxyConsultState>;
+
+export type DiscordRealtimeConsultParams = {
+  accountId: string;
+  actionHandoffAllowed: () => boolean;
+  sendConversationInput: (text: string) => void;
+  consultPolicy: () => "auto" | "always";
+  consultToolPolicy: () => RealtimeVoiceAgentConsultToolPolicy;
+  consultToolsAllow: () => string[] | undefined;
+  debounceMs: () => number | undefined;
+  entry: VoiceSessionEntry;
+  harness: RealtimeVoiceSessionHarness<AgentProxyConsultState>;
+  isAgentProxy: () => boolean;
+  isWakeNameRequired: () => boolean;
+  playback: DiscordRealtimePlaybackPort;
+  providerEpoch: () => number;
+  runAgentTurn: (params: VoiceRealtimeAgentTurnParams) => Promise<string>;
+  resolveSpeakerContext: (userId: string) => Promise<DiscordVoiceIngressContext | null>;
+  stopped: () => boolean;
+  turns: DiscordRealtimeTurns;
+  usesRealtimeAgentHandoff: () => boolean;

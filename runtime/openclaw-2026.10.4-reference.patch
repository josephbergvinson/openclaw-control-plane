+function decodeBody(bytes: Buffer, encoding: string | undefined): NativeJsonValue {
+  expect(bytes.length).toBeLessThanOrEqual(MAX_BODY_BYTES);
+  const plain =
+    encoding === "zstd" ? zstdDecompressSync(bytes, { maxOutputLength: MAX_BODY_BYTES }) : bytes;
+  expect(!encoding || encoding === "identity" || encoding === "zstd").toBe(true);
+  return JSON.parse(plain.toString("utf8"));
+}

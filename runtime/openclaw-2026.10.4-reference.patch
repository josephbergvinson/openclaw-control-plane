+import { execFileSync, spawn, type ChildProcess } from "node:child_process";
+import { once } from "node:events";
+import fs from "node:fs";
+import { createRequire } from "node:module";
+import path from "node:path";
+import { describe, expect, it, vi } from "vitest";
+import { runManagedCommand } from "../../scripts/lib/managed-child-process.mts";
+import * as darwinSession from "../../scripts/lib/managed-darwin-session.mts";
+import {
+  captureManagedDarwinSession,
+  createDarwinProcessApi,
+  loadDarwinProcessApi,
+  type DarwinProcessIdentity,
+} from "../../scripts/lib/managed-darwin-session.mts";
+import { createVitestResourceOwner } from "../../scripts/lib/vitest-resource-ownership.mts";
+import { waitForFile } from "../helpers/process-wait.js";
+import { createScriptTestHarness } from "./test-helpers.js";
+
+const { createTempDir } = createScriptTestHarness();
+
+it.skipIf(process.platform !== "darwin")(
+  "uses a caller's verified native API without loading the source checkout addon",
+  async () => {
+    const api = loadDarwinProcessApi();
+    const fallback = vi.spyOn(darwinSession, "loadDarwinProcessApi").mockImplementation(() => {
+      throw new Error("source native addon must not load in a signed package proof");
+    });
+    const identity = vi.spyOn(api, "identity");
+    let output = "";
+    try {
+      const exit = await runManagedCommand({
+        bin: process.execPath,
+        args: ["-e", "process.stdout.write('caller-native-api-ready')"],
+        requireProcessTreeExit: true,
+        darwinProcessApi: api,
+        stdio: ["ignore", "pipe", "pipe"],
+        onReady(child) {
+          child.stdout?.on("data", (data) => {
+            output += data.toString();
+          });
+        },
+      });
+      expect(exit).toBe(0);
+      expect(output).toBe("caller-native-api-ready");
+      expect(identity).toHaveBeenCalled();
+      expect(fallback).not.toHaveBeenCalled();
+    } finally {
+      identity.mockRestore();
+      fallback.mockRestore();
+    }
+  },
+);
+
+const rootIdentity: DarwinProcessIdentity = {
+  pid: 200,
+  ppid: 100,
+  pgid: 200,
+  sid: 200,
+  startSec: 1000n,
+  startUsec: 123n,
+};
+const leafIdentity: DarwinProcessIdentity = {
+  pid: 300,
+  ppid: 200,
+  pgid: 300,
+  sid: 200,
+  startSec: 1000n,
+  startUsec: 124n,
+};
+
+function fakeApi() {
+  const identities = new Map([
+    [200, rootIdentity],
+    [300, leafIdentity],
+  ]);
+  return {
+    identities,
+    identity: vi.fn((pid: number) => {
+      const identity = identities.get(pid);
+      return identity ? { state: "live" as const, identity } : { state: "missing" as const };
+    }),
+    census: vi.fn(() => [...identities.keys()]),
+    signal: vi.fn((pid: number) => {
+      return identities.delete(pid);
+    }),
+  };
+}
+
+describe("owned Darwin sessions", () => {
+  it("signals a reparented same-session child in another group before certifying retirement", () => {
+    const api = fakeApi();
+    const session = captureManagedDarwinSession(api, 200, 100);
+    api.identities.delete(200);
+    api.identities.set(300, { ...leafIdentity, ppid: 1 });
+    expect(session.inspect(Date.now() + 1000)).toEqual({ state: "live", survivingPids: [300] });
+    expect(session.signal("SIGKILL", Date.now() + 1000)).toEqual({
+      state: "dead",
+      signaledPids: [300],
+    });
+    expect(api.signal).toHaveBeenCalledExactlyOnceWith(300, "SIGKILL");
+  });
+
+  it("latches an empty certificate instead of signaling a reused numeric session/group", () => {
+    const api = fakeApi();
+    const session = captureManagedDarwinSession(api, 200, 100);
+    api.identities.clear();
+    expect(session.inspect(Date.now() + 1000)).toEqual({ state: "dead" });
+    api.identities.set(200, { ...rootIdentity, startUsec: 999n });
+    expect(session.signal("SIGKILL", Date.now() + 1000)).toEqual({ state: "dead" });
+    expect(api.signal).not.toHaveBeenCalled();
+  });
+
+  it("refuses a changed root incarnation before any session signal", () => {
+    const api = fakeApi();
+    const session = captureManagedDarwinSession(api, 200, 100);
+    api.identities.set(200, { ...rootIdentity, startUsec: 999n });
+    expect(session.signal("SIGTERM", Date.now() + 1000).state).toBe("indeterminate");
+    expect(api.signal).not.toHaveBeenCalled();
+  });
+
+  it("revalidates a child incarnation immediately before its exact PID signal", () => {
+    const api = fakeApi();
+    const session = captureManagedDarwinSession(api, 200, 100);
+    let leafQueries = 0;
+    api.identity.mockImplementation((pid) => {
+      const identity = api.identities.get(pid);
+      if (pid === 300 && ++leafQueries === 2) {
+        return { state: "live", identity: { ...leafIdentity, startUsec: 999n } };
+      }
+      return identity ? { state: "live", identity } : { state: "missing" };
+    });
+    expect(session.signal("SIGKILL", Date.now() + 1000).state).toBe("indeterminate");
+    expect(api.signal).not.toHaveBeenCalled();
+  });
+
+  it("retains successful signal delivery when a later member signal fails", () => {
+    const api = fakeApi();
+    const session = captureManagedDarwinSession(api, 200, 100);
+    api.signal.mockImplementation((pid) => {
+      if (pid === 200) {
+        throw new Error("EPERM");
+      }
+      return api.identities.delete(pid);
+    });
+    expect(session.signal("SIGKILL", Date.now() + 1000)).toMatchObject({
+      state: "indeterminate",
+      signaledPids: [300],
+    });
+  });
+
+  it("retains successful signal delivery when its later census is indeterminate", () => {
+    const api = fakeApi();
+    const session = captureManagedDarwinSession(api, 200, 100);
+    api.census.mockReturnValueOnce([200, 300]).mockImplementationOnce(() => {
+      throw new Error("Transient census uncertainty");
+    });
+    expect(session.signal("SIGKILL", Date.now() + 1000)).toMatchObject({
+      state: "indeterminate",
+      signaledPids: [300, 200],
+    });
+    expect(session.inspect(Date.now() + 1000)).toEqual({ state: "dead" });
+  });
+
+  it("does not record an ESRCH signal race as successful cleanup delivery", () => {
+    const api = fakeApi();
+    const session = captureManagedDarwinSession(api, 200, 100);
+    api.signal.mockImplementation((pid) => {
+      api.identities.delete(pid);
+      return false;
+    });
+    expect(session.signal("SIGKILL", Date.now() + 1000)).toEqual({ state: "dead" });
+  });
+
+  it.each(["capture", "census", "member"])(
+    "keeps %s observation failures unverified and unsignaled",
+    (failure) => {
+      const api = fakeApi();
+      if (failure === "capture") {
+        api.identity.mockImplementation(() => {
+          throw new Error("EPERM");
+        });
+      }
+      const session = captureManagedDarwinSession(api, 200, 100);
+      if (failure === "census") {
+        api.census.mockImplementation(() => {
+          throw new Error("truncated census");
+        });
+      }
+      if (failure === "member") {
+        api.identity.mockImplementation((pid) => {
+          if (pid === 300) {
+            throw new Error("short identity query");
+          }
+          return { state: "live", identity: rootIdentity };
+        });
+      }
+      expect(session.signal("SIGKILL", Date.now() + 1000).state).toBe("indeterminate");
+      expect(api.signal).not.toHaveBeenCalled();
+    },
+  );
+
+  it("does not use members of an uncaptured exited leader as signaling authority", () => {
+    const api = fakeApi();
+    api.identities.delete(200);
+    const session = captureManagedDarwinSession(api, 200, 100);
+    expect(session.signal("SIGKILL", Date.now() + 1000).state).toBe("indeterminate");
+    expect(api.signal).not.toHaveBeenCalled();
+    api.identities.clear();
+    expect(session.inspect(Date.now() + 1000)).toEqual({ state: "dead" });
+  });
+
+  it("uses an initially terminal root birth only to reject reuse, never as live authority", () => {
+    const api = fakeApi();
+    const { sid: _sid, ...terminalIdentity } = rootIdentity;
+    const identity: Parameters<typeof captureManagedDarwinSession>[0]["identity"] = (pid) =>
+      pid === 200 ? { state: "missing", terminalIdentity } : api.identity(pid);
+    api.identities.delete(200);
+    const session = captureManagedDarwinSession({ ...api, identity }, 200, 100);
+    expect(session.signal("SIGKILL", Date.now() + 1000).state).toBe("indeterminate");
+    expect(api.signal).not.toHaveBeenCalled();
+    api.identities.clear();
+    expect(session.inspect(Date.now() + 1000)).toEqual({ state: "dead" });
+  });
+
+  it.each(["live capture", "missing capture", "terminal capture"])(
+    "refuses a new terminal root birth after %s",
+    (captureState) => {
+      const api = fakeApi();
+      const { sid: _sid, ...terminalIdentity } = rootIdentity;
+      let replacement = false;
+      const identity: Parameters<typeof captureManagedDarwinSession>[0]["identity"] = (pid) => {
+        if (pid !== 200) {
+          return api.identity(pid);
+        }
+        if (replacement) {
+          return { state: "missing", terminalIdentity: { ...terminalIdentity, startUsec: 999n } };
+        }
+        if (captureState === "missing capture") {
+          return { state: "missing" };
+        }
+        if (captureState === "terminal capture") {
+          return { state: "missing", terminalIdentity };
+        }
+        return api.identity(pid);
+      };
+      const session = captureManagedDarwinSession({ ...api, identity }, 200, 100);
+      replacement = true;
+      api.identities.clear();
+      expect(session.signal("SIGKILL", Date.now() + 1000).state).toBe("indeterminate");
+      expect(api.signal).not.toHaveBeenCalled();
+    },
+  );
+
+  it.each(["pid", "ppid", "pgid"])("rejects a terminal capture with a mismatched %s", (field) => {
+    const api = fakeApi();
+    const { sid: _sid, ...terminalIdentity } = rootIdentity;
+    const identity: Parameters<typeof captureManagedDarwinSession>[0]["identity"] = () => ({
+      state: "missing",
+      terminalIdentity: { ...terminalIdentity, [field]: 999 },
+    });
+    api.identities.clear();
+    const session = captureManagedDarwinSession({ ...api, identity }, 200, 100);
+    expect(session.inspect(Date.now() + 1000).state).toBe("indeterminate");
+    expect(api.signal).not.toHaveBeenCalled();
+  });
+
+  it("rescans an empty census so a fork during the first enumeration is not missed", () => {
+    const api = fakeApi();
+    const session = captureManagedDarwinSession(api, 200, 100);
+    api.identities.delete(200);
+    api.census.mockReturnValueOnce([]).mockReturnValueOnce([300]);
+    expect(session.inspect(Date.now() + 1000)).toEqual({ state: "live", survivingPids: [300] });
+  });
+
+  it("does not certify disappearing census candidates as an empty session", () => {
+    const api = fakeApi();
+    const session = captureManagedDarwinSession(api, 200, 100);
+    api.identities.clear();
+    api.census.mockReturnValueOnce([301]).mockReturnValueOnce([302]);
+    expect(session.inspect(Date.now() + 1000).state).toBe("indeterminate");
+    expect(session.inspect(Date.now() + 1000).state).toBe("indeterminate");
+    expect(api.signal).not.toHaveBeenCalled();
+    expect(session.inspect(Date.now() + 1000)).toEqual({ state: "dead" });
+    api.identities.set(200, { ...rootIdentity, startUsec: 999n });
+    expect(session.signal("SIGKILL", Date.now() + 1000)).toEqual({ state: "dead" });
+    expect(api.signal).not.toHaveBeenCalled();
+  });
+
+  it("does not certify a census candidate whose session changed during identity lookup", () => {
+    const api = fakeApi();
+    const session = captureManagedDarwinSession(api, 200, 100);
+    api.identities.delete(200);
+    api.identities.set(300, { ...leafIdentity, sid: 300 });
+    api.census.mockReturnValueOnce([300]);
+    expect(session.inspect(Date.now() + 1000).state).toBe("indeterminate");
+    expect(api.signal).not.toHaveBeenCalled();
+    api.census.mockReturnValue([]);
+    expect(session.inspect(Date.now() + 1000)).toEqual({ state: "dead" });
+    expect(api.signal).not.toHaveBeenCalled();
+  });
+});
+
+const kernelQuery = `import ctypes,importlib.util,json,os,sys
+s=importlib.util.spec_from_file_location('existing_identity',sys.argv[1]);m=importlib.util.module_from_spec(s);s.loader.exec_module(m)
+pid=int(sys.argv[2]);lib=ctypes.CDLL('/usr/lib/libproc.dylib',use_errno=True);q=lib.proc_pidinfo;q.argtypes=[ctypes.c_int,ctypes.c_int,ctypes.c_uint64,ctypes.c_void_p,ctypes.c_int];q.restype=ctypes.c_int
+b=m.BsdInfo();ctypes.set_errno(0);n=q(pid,3,0,ctypes.byref(b),ctypes.sizeof(b));err=ctypes.get_errno()
+if n==0 and err==3: print(json.dumps({'missing':True,'bytes':n,'errno':err}))
+else:
+ m.decode_info(pid,b,n,err)
+ print(json.dumps({'pid':pid,'ppid':b.ppid,'pgid':b.pgid,'sid':os.getsid(pid),'startSec':str(b.start_sec),'startUsec':str(b.start_usec),'bytes':n,'errno':err}))
+`;
+function queryKernel(pid: number) {
+  return JSON.parse(
+    execFileSync(
+      "/usr/bin/python3",
+      [
+        "-I",
+        "-S",
+        "-B",
+        "-c",
+        kernelQuery,
+        path.resolve("scripts/pr-lib/darwin-process-identity.py"),
+        String(pid),
+      ],
+      { encoding: "utf8", timeout: 2000 },
+    ),
+  );
+}
+
+function queryTerminalKernel(pid: number) {
+  return JSON.parse(
+    execFileSync(
+      "/usr/bin/python3",
+      [
+        "-I",
+        "-S",
+        "-B",
+        "-c",
+        `import ctypes,json,sys
+q=ctypes.CDLL('/usr/lib/libproc.dylib',use_errno=True).proc_pidinfo
+q.argtypes=[ctypes.c_int,ctypes.c_int,ctypes.c_uint64,ctypes.c_void_p,ctypes.c_int];q.restype=ctypes.c_int
+b=ctypes.create_string_buffer(136);ctypes.set_errno(0);n=q(int(sys.argv[1]),3,1,b,136);e=ctypes.get_errno()
+print(json.dumps({'bytes':n,'errno':e,**({'pid':int.from_bytes(b.raw[12:16],'little'),'ppid':int.from_bytes(b.raw[16:20],'little'),'pgid':int.from_bytes(b.raw[100:104],'little'),'status':int.from_bytes(b.raw[4:8],'little'),'startSec':str(int.from_bytes(b.raw[120:128],'little')),'startUsec':str(int.from_bytes(b.raw[128:136],'little'))} if n==136 else {})}))`,
+        String(pid),
+      ],
+      { encoding: "utf8", timeout: 2000 },
+    ),
+  );
+}
+
+async function retireOwnedFixture(leaf: DarwinProcessIdentity) {
+  const api = loadDarwinProcessApi();
+  const current = api.identity(leaf.pid);
+  if (current.state === "live") {
+    expect(current.identity.startSec).toBe(leaf.startSec);
+    expect(current.identity.startUsec).toBe(leaf.startUsec);
+    expect(current.identity.sid).toBe(leaf.sid);
+    api.signal(leaf.pid, "SIGKILL");
+    const deadline = Date.now() + 2000;
+    while (api.identity(leaf.pid).state !== "missing") {
+      if (Date.now() >= deadline) {
+        throw new Error("Owned fixture rescue did not retire");
+      }
+      await new Promise((resolve) => {
+        setTimeout(resolve, 10);
+      });
+    }
+  } else {
+    expect(current.state).toBe("missing");
+  }
+}
+
+const publicTerminalProbe = String.raw`#include <sys/types.h>
+#include <sys/proc.h>
+#include <sys/sysctl.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <errno.h>
+int main(int argc, char **argv) {
+ if (argc == 1) {
+  printf("{\"bytes\":%zu,\"startSec\":%zu,\"startUsec\":%zu,\"startSecBytes\":%zu,\"startUsecBytes\":%zu,\"status\":%zu,\"pid\":%zu,\"ppid\":%zu,\"pgid\":%zu}\n",
+   sizeof(struct kinfo_proc), offsetof(struct kinfo_proc,kp_proc.p_starttime.tv_sec), offsetof(struct kinfo_proc,kp_proc.p_starttime.tv_usec),
+   sizeof(((struct kinfo_proc *)0)->kp_proc.p_starttime.tv_sec), sizeof(((struct kinfo_proc *)0)->kp_proc.p_starttime.tv_usec),
+   offsetof(struct kinfo_proc,kp_proc.p_stat), offsetof(struct kinfo_proc,kp_proc.p_pid),
+   offsetof(struct kinfo_proc,kp_eproc.e_ppid), offsetof(struct kinfo_proc,kp_eproc.e_pgid));
+  return 0;
+ }
+ struct kinfo_proc p = {0};
+ int mib[] = {CTL_KERN,KERN_PROC,KERN_PROC_PID,atoi(argv[1])};
+ size_t bytes = sizeof(p);
+ errno = 0;
+ int result = sysctl(mib,4,&p,&bytes,NULL,0);
+ int error = errno;
+ printf("{\"result\":%d,\"errno\":%d,\"bytes\":%zu,\"pid\":%d,\"ppid\":%d,\"pgid\":%d,\"status\":%d,\"startSec\":\"%lld\",\"startUsec\":\"%d\"}\n",

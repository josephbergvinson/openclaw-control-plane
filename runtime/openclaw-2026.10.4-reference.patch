+    const response = await fixture().dispatch({ method: "POST", path: "/act", body: request });
+    expect(response.status).toBe(200);
+    expect(mocks.fill).toHaveBeenCalledWith(expect.objectContaining({ request }));
+  });
+  it("does not turn one pending credential entry into a global route lock", async () => {
+    const pending = createDeferred<{ ok: true; targetId: string; origin: string }>();
+    mocks.fill.mockReturnValueOnce(pending.promise);
+    const f = fixture();
+    const fill = f.dispatch({
+      method: "POST",
+      path: "/act",
+      body: { kind: "typeSecret", alias: "account", ref: "e17", targetId: "tab-1", submit: false },
+    });
+    try {
+      await vi.waitFor(() => expect(mocks.fill).toHaveBeenCalledOnce());
+      expect(
+        (await f.dispatch({ method: "GET", path: "/console", query: { targetId: "tab-1" } }))
+          .status,
+      ).toBe(200);
+    } finally {
+      pending.resolve({ ok: true, targetId: "tab-1", origin: "https://93.184.216.34" });
+      await fill;
+    }
+  });
+});

+    async (finalMode) => {
+      await withOpenClawTestState({ label: "discord-requester-progress" }, async (state) => {
+        const channelId = "123456789012345678";
+        const sourceMessageId = "910000000000000001";
+        const accountId = "bot";
+        const token = "synthetic-discord-progress-token";
+        const discordConfig = {

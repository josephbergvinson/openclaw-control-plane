+        finishing = input.fixture.finishDispatch();
+        const entry = loadSessionEntry(input.fixture.scope);
+        const defaults: FollowupRunnerParams = {
+          typing: {
+            onReplyStart: vi.fn(async () => {}),
+            startTypingLoop: vi.fn(async () => {}),
+            startTypingOnText: vi.fn(async () => {}),
+            refreshTypingTtl: vi.fn(),
+            isActive: vi.fn(() => false),
+            markRunComplete: vi.fn(),
+            markDispatchIdle: vi.fn(),
+            cleanup: vi.fn(),
+          },
+          typingMode: "never",
+          defaultModel: "claude",
+          sessionKey: input.fixture.scope.sessionKey,
+          storePath: input.fixture.scope.storePath,
+          sessionEntry: entry,
+          opts: {
+            dashboardReadAdmission: {
+              ...original,
+              runId: "newer-input",
+              providedUserSource: {
+                kind: "dashboard",
+                readText: () => "TOKEN: wrong-default",
+                assertCurrent: () => {
+                  throw new Error("Newer default admission must not be borrowed");
+                },
+              },
+            },
+          },
+        };
+        if (binding === "message") {
+          queued.messageId = "different-original-input";
+        }
+        if (binding === "session") {
+          queued.dashboardReadAdmission = { ...original, sessionId: "different-original-session" };
+        }
+        const outcome = await admitFollowupTurn({ queued, defaults });
+        if (outcome.kind !== "admitted") {
+          throw new Error("Expected actual native followup admission");
+        }
+        admitted = outcome.turn;
+        if (binding === "revoked") {
+          // Admin removal alone leaves dashboard read admission active. Native
+          // client invalidation closes the original queued admission itself.
+          input.fixture.client.invalidated = true;
+        }
+        let imported = false;
+        let observedToken: string | undefined;
+        let importError: unknown;
+        model.execute.mockImplementation(async (params: AgentTurnParams) => {
+          // The native runner converts model errors to terminal replies. Keep
+          // observations outside that boundary so it cannot swallow test failures.
+          try {
+            observedToken = mintReplyMessageActionTurnCapability(params, outcome.turn.runId);
+            if (observedToken) {
+              await input.importToken(observedToken, outcome.turn.runId);
+              imported = true;
+            }
+          } catch (error) {
+            importError = error;
+          }
+          return {
+            runId: outcome.turn.runId,
+            outcome: { kind: "rejected", payload: { text: "Synthetic model boundary completed." } },
+          };
+        });
+        const execute = () =>
+          executeFollowupTurn({
+            turn: outcome.turn,
+            defaults,
+            onToolResult: vi.fn(async () => {}),
+            onCompactionNoticePayload: vi.fn(async () => {}),
+          });
+        if (binding === "revoked") {
+          // Original admission revalidates before progress options/model work.

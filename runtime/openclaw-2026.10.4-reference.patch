+// Memory Core tests cover phase effort through the native dreaming hook.
+import { expectDefined } from "@openclaw/normalization-core";
+import { MEMORY_DREAMING_SYSTEM_EVENT_TEXT } from "openclaw/plugin-sdk/memory-core-host-status";
+import type { OpenClawPluginApi } from "openclaw/plugin-sdk/plugin-entry";
+import { createTestPluginApi } from "openclaw/plugin-sdk/plugin-test-api";
+import { expect, it, vi } from "vitest";
+import { registerShortTermPromotionDreaming } from "./dreaming.js";
+
+type Subagent = OpenClawPluginApi["runtime"]["subagent"];
+type CompletionRequest = Parameters<Subagent["complete"]>[0];
+
+const { runPhases, applyPromotions } = vi.hoisted(() => ({
+  runPhases: vi.fn<(typeof import("./dreaming-phases.js"))["runDreamingSweepPhases"]>(),
+  applyPromotions:
+    vi.fn<(typeof import("./short-term-promotion.js"))["applyShortTermPromotions"]>(),
+}));
+vi.mock("./dreaming-phases.js", () => ({ runDreamingSweepPhases: runPhases }));
+vi.mock("./short-term-promotion.js", () => ({
+  repairShortTermPromotionArtifacts: vi.fn(async () => ({ changed: false })),
+  rankShortTermPromotionCandidates: vi.fn(async () => []),
+  applyShortTermPromotions: applyPromotions,
+}));
+vi.mock("./dreaming-markdown.js", () => ({ writeDeepDreamingReport: vi.fn(async () => {}) }));
+
+it("preserves phase overrides and deep effort on the original completion capability", async () => {
+  const complete = vi.fn(async function (this: Subagent, _request: CompletionRequest) {
+    expect(this).toBe(subagent);
+    return { text: "completed" };
+  });
+  const unexpected = async () => {
+    throw new Error("session inference is not part of dreaming completion");
+  };
+  const subagent: Subagent = {
+    complete,
+    run: unexpected,
+    waitForRun: unexpected,
+    getSessionMessages: unexpected,
+    deleteSession: unexpected,
+  };
+  runPhases.mockImplementationOnce(async (params) => {
+    await expectDefined(params.subagent, "phase completion capability").complete({
+      agentId: expectDefined(params.agentId, "phase agent"),
+      message: "Light phase narrative",
+      model: "openai/example-model@openai:background",
+      thinking: "off",
+    });
+    return { degradedPhases: 0, pendingNarratives: 0 };
+  });
+  applyPromotions.mockImplementationOnce(async (params) => {
+    await expectDefined(params.consolidation?.subagent, "deep completion capability").complete({
+      agentId: expectDefined(params.agentId, "consolidation agent"),
+      message: "Deep durable consolidation",
+      model: params.consolidation?.model,
+    });
+    return {
+      memoryPath: "/workspace/research/MEMORY.md",
+      applied: 0,
+      appended: 0,
+      reconciledExisting: 0,
+      appliedCandidates: [],
+      rejectedCandidates: [],
+      compactedSections: 0,
+      compactedDates: [],
+    };
+  });
+  const on = vi.fn();
+  const logger = { info: vi.fn(), warn: vi.fn(), error: vi.fn(), debug: vi.fn() };
+  const api = createTestPluginApi({
+    config: {
+      agents: { defaults: { workspace: "/workspace/research" } },
+      plugins: {
+        entries: {
+          "memory-core": {
+            enabled: true,
+            config: {
+              dreaming: {
+                phases: {
+                  deep: {
+                    execution: { model: "openai/example-model@openai:background", thinking: "max" },
+                  },
+                },
+              },
+            },
+          },
+        },
+      },
+    },
+    on,
+    logger,
+  });
+  Object.assign(api.runtime, { subagent });
+  registerShortTermPromotionDreaming(api);
+  const hook = expectDefined(
+    on.mock.calls.find(([name]) => name === "before_agent_reply"),
+    "native dreaming hook",
+  )[1] as (
+    event: { cleanedBody: string },
+    context: { trigger: string; agentId: string; workspaceDir: string },
+  ) => Promise<unknown>;
+  // No service is started: domain writes are mocked and registration owns no timers.
+  const outcome = await hook(
+    { cleanedBody: MEMORY_DREAMING_SYSTEM_EVENT_TEXT },
+    { trigger: "cron", agentId: "research", workspaceDir: "/workspace/research" },
+  );
+
+  expect(outcome).toEqual({ handled: true, reason: "memory-core: short-term dreaming processed" });
+  expect(logger.error).not.toHaveBeenCalled();
+  expect(complete).toHaveBeenCalledTimes(2);
+  expect(complete).toHaveBeenNthCalledWith(1, {
+    agentId: "research",
+    message: "Light phase narrative",
+    model: "openai/example-model@openai:background",
+    thinking: "off",
+  });
+  expect(complete).toHaveBeenNthCalledWith(2, {
+    agentId: "research",
+    message: "Deep durable consolidation",
+    model: "openai/example-model@openai:background",
+    thinking: "max",
+  });
+});

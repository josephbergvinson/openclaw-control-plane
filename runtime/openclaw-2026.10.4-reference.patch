+  getAdmittedRunDelegatedAuthority,
+  type PreparedAgentRunAdmission,
+} from "../admitted-run-context.js";
+import { createAgentHarnessHostCapabilities } from "./host-capability.js";
+
+type HostAttempt = Parameters<typeof createAgentHarnessHostCapabilities>[0]["attempt"];
+
+export function registerHostAcceptedUsageTests({
+  admittedAttempt,
+}: {
+  admittedAttempt: (
+    runId?: string,
+    overrides?: Omit<Partial<HostAttempt>, "admittedRunContext" | "runId">,
+  ) => Promise<{
+    attempt: HostAttempt & { sessionId: string };
+    admission: PreparedAgentRunAdmission;
+  }>;
+}): void {
+  describe("native accepted-attempt usage host custody", () => {
+    it.each(["host-close", "source-revocation"] as const)(
+      "retains only accepted facts under %s",
+      async (retirement) => {
+        const [{ createOpenClawTestState }, accessor, goals, usage] = await Promise.all([
+          import("../../test-utils/openclaw-test-state.js"),
+          import("../../config/sessions/session-accessor.js"),
+          import("../../config/sessions/goals.js"),
+          import("../session-goal-usage.js"),
+        ]);
+        const state = await createOpenClawTestState({ label: "host-goal-usage" });
+        const { attempt, admission } = await admittedAttempt("goal-host");
+        const target = {
+          agentId: "main",
+          sessionKey: attempt.sessionKey!,
+          sessionId: attempt.sessionId,
+          storePath: path.join(state.sessionsDir(), "sessions.json"),
+          lifecycleRevision: "native-revision",
+          activeWriterRunId: attempt.runId,
+        };
+        let host: ReturnType<typeof createAgentHarnessHostCapabilities> | undefined;
+        try {
+          await accessor.upsertSessionEntryCore(target, { ...target, updatedAt: 1 });
+          await goals.createSessionGoal({ ...target, objective: "Finish the same work" });
+          const authority = getAdmittedRunDelegatedAuthority(attempt.admittedRunContext);
+          const run = usage.createSessionGoalUsageRun({
+            runId: attempt.runId,
+            admissionId: attempt.admittedRunContext.operationalRunInstance.instanceId,
+            instanceId: "accumulator",
+            operationalRunInstance: attempt.admittedRunContext.operationalRunInstance,
+            initialScope: target,
+            readTarget: () => target,
+            readRunTokens: () => 0,
+            assertCurrent: () => {
+              if (
+                !authority ||
+                getAdmittedRunDelegatedAuthority(attempt.admittedRunContext) !== authority
+              ) {
+                throw new Error("source revoked");
+              }
+            },
+          });
+          await usage.withSessionGoalUsageRun(run, async () => {
+            host = createAgentHarnessHostCapabilities({ attempt, pluginId: "codex" });
+            let accepted: { input: number; output: number; total: number } | undefined;
+            const release = host.capabilities.bindAcceptedAttemptUsage!(() => accepted);
+            expect(run.observe()?.tokens).toBe(0);
+            accepted = { input: 100, output: 10, total: 110 };
+            expect(run.observe()?.tokens).toBe(110);
+            if (retirement === "source-revocation") {
+              admission.close();
+            }
+            host.close();
+            release();
+            accepted = { input: 9000, output: 1000, total: 10000 };
+            expect(() => host!.capabilities.bindAcceptedAttemptUsage!(() => accepted)).toThrow(
+              "no longer active",
+            );
+            if (retirement === "host-close") {
+              expect(run.observe()?.tokens).toBe(110);
+            } else {
+              expect(() => run.observe()).toThrow("source revoked");
+            }
+            await usage.settleSessionGoalUsageRun(run, async () => {});
+          });
+          expect(accessor.loadSessionEntry(target)?.goal?.tokensUsed).toBe(
+            retirement === "host-close" ? 110 : 0,
+          );
+        } finally {
+          host?.close();
+          await state.cleanup();
+        }
+      },

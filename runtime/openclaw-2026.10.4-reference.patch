+import { launchOpenClawChrome, stopOpenClawChrome, type RunningChrome } from "./chrome.js";
+import { closePlaywrightBrowserConnection, getPageForTargetId } from "./pw-session.js";
+import { setHttpCredentialsViaPlaywright } from "./pw-tools-core.state.js";
+import { traceStartViaPlaywright } from "./pw-tools-core.trace.js";
+import {
+  getOrCreateProfileRuntime,
+  registerProfileHandle,
+  releaseProfileHandle,
+  withProfileOperationLease,
+} from "./server-context.lifecycle.js";
+import { makeBrowserProfile, makeBrowserServerState } from "./server-context.test-harness.js";
+import { getFreePort } from "./test-port.js";
+
+const fixturePaths = vi.hoisted(() => ({ root: "" }));
+vi.mock("openclaw/plugin-sdk/text-utility-runtime", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("openclaw/plugin-sdk/text-utility-runtime")>()),
+  get CONFIG_DIR() {
+    return fixturePaths.root;
+  },
+}));
+
+vi.mock("../browser-credential-secret.runtime.js", () => ({
+  resolveBrowserCredentialSecret: async () => "inert-fixture-password",
+}));
+
+describe.runIf(process.env.OPENCLAW_BROWSER_HTTP_AUTH_E2E === "1")(
+  "opaque HTTP credentials in Chromium",
+  () => {
+    it.each([
+      { entry: "existing public origin", firstProtected: false },
+      { entry: "first protected navigation", firstProtected: true },
+    ])(
+      "answers a real HTTPS challenge from $entry without sending credentials to another origin",
+      async ({ firstProtected }) => {
+        let profileRoot = "";
+        await withTempDir("openclaw-http-auth-", async (dir) => {
+          profileRoot = dir;
+          fixturePaths.root = profileRoot;
+          const authorizedOrigins: string[] = [];
+          const credentialOrigins: string[] = [];
+          const challengedOrigins: string[] = [];
+          const expected = `Basic ${Buffer.from("fixture-user:inert-fixture-password").toString("base64")}`;
+          const servers = [0, 1].map(() =>
+            createServer(
+              { key: PROXY_FIXTURE_KEY, cert: PROXY_FIXTURE_CERTIFICATE },
+              (request, response) => {
+                if (request.headers.authorization) {
+                  credentialOrigins.push(request.headers.host ?? "");
+                }
+                if (request.url === "/public") {
+                  response.end("Public fixture");
+                  return;
+                }
+                if (request.headers.authorization === expected) {
+                  authorizedOrigins.push(request.headers.host ?? "");
+                  response.end("Authenticated fixture");
+                  return;
+                }
+                response.writeHead(401, { "www-authenticate": 'Basic realm="inert fixture"' });
+                challengedOrigins.push(request.headers.host ?? "");
+                response.end("Authentication required");
+              },
+            ),
+          );
+          let context: BrowserContext | undefined;
+          let running: RunningChrome | undefined;
+          let releaseRunning: (() => void) | undefined;
+          const ownedProfileDirs: string[] = [];
+          try {
+            for (const server of servers) {
+              await new Promise<void>((resolve) => {
+                server.listen(0, "127.0.0.1", resolve);
+              });
+            }
+            const origins = [
+              "https://auth-fixture.example",
+              "https://foreign-fixture.example",
+            ] as const;
+            const hostRules = origins

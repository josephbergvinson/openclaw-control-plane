+  const maxTotal = limits?.maxTotalBytes ?? 5 * 1024 * 1024;
+  const maxFile = limits?.maxFileBytes ?? 1024 * 1024;
+  let total = 0;
+  const attachments: NonNullable<SpawnSubagentParams["attachments"]> = [];
+  for (const [index, fact] of facts.entries()) {
+    assertCurrent();
+    const reference = fact.path ?? fact.url;
+    if (!reference) {
+      throw new Error("An original attachment has no managed source");
+    }
+    const file = await resolveMediaReferenceLocalPath(reference);
+    assertCurrent();
+    const bytes = await readLocalMediaFile(file, [getMediaDir()], { maxBytes: maxFile });
+    assertCurrent();
+    total += bytes.byteLength;
+    if (total > maxTotal) {
+      throw new Error("Current original attachments exceed the native total limit");
+    }

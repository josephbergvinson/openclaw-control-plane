@@ -0,0 +1,370 @@
+import fs from "node:fs/promises";
+import path from "node:path";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { createDeferred } from "../../test/helpers/promise.js";
+import { useAutoCleanupTempDirTracker } from "../../test/helpers/temp-dir.js";
+import type { CliDeps } from "../cli/deps.types.js";
+import * as configRuntime from "../config/config.js";
+import * as configIO from "../config/io.js";
+import type { OpenClawConfig } from "../config/types.openclaw.js";
+import * as cronCommandRunner from "../cron/command-runner.js";
+import * as cronDelivery from "../cron/delivery.js";
+import { abortActiveCronTaskRuns } from "../cron/service/active-run-cancellation.js";
+import { resetActiveCronTaskRunsForTests } from "../cron/service/active-run-cancellation.test-support.js";
+import type { CronJobCreate } from "../cron/types.js";
+import {
+  OutboundDeliveryError,
+  PlatformMessageNotDispatchedError,
+} from "../infra/outbound/deliver-types.js";
+import { resetGatewayWorkAdmission } from "../process/gateway-work-admission.js";
+import { writeConfigMachineState } from "../state/config-machine-state-write.js";
+import { createTestGatewayScheduler } from "../test-utils/gateway-scheduler-clock.js";
+
+const mocks = vi.hoisted(() => ({
+  config: vi.fn<() => OpenClawConfig>(),
+  agent: vi.fn<typeof import("../cron/isolated-agent.js").runCronIsolatedAgentTurn>(),
+  send: vi.fn<typeof import("../cron/delivery.js").sendCronAnnouncePayloadStrict>(),
+}));
+
+vi.mock("../config/io.js", { spy: true });
+vi.mock("../config/config.js", { spy: true });
+vi.mock("../cron/delivery.js", { spy: true });
+vi.mock("../cron/isolated-agent.js", () => ({ runCronIsolatedAgentTurn: mocks.agent }));
+vi.mock("../infra/heartbeat-runner.js", () => ({
+  resolveHeartbeatAgents: () => [],
+  resolveHeartbeatSchedulerSeed: () => "command-repair-test",
+}));
+vi.mock("../plugins/hook-runner-global.js", () => ({ getGlobalHookRunner: () => undefined }));
+
+import { buildGatewayCronService } from "./server-cron.js";
+
+const tempDirs = useAutoCleanupTempDirTracker(afterEach);
+const services: ReturnType<typeof buildGatewayCronService>[] = [];
+const sent = () => ({
+  status: "sent" as const,
+  results: [{ channel: "telegram", messageId: "final-command-result" }],
+  receipt: {
+    primaryPlatformMessageId: "final-command-result",
+    platformMessageIds: ["final-command-result"],
+    parts: [{ platformMessageId: "final-command-result", kind: "text" as const, index: 0 }],
+    sentAt: 0,
+  },
+});
+
+async function fixture(
+  options: {
+    repair?: boolean;
+    initialExit?: number;
+    verifySource?: string;
+    delivery?: CronJobCreate["delivery"];
+  } = {},
+) {
+  const root = tempDirs.make("gateway-command-repair-delivery-");
+  const marker = path.join(root, "capacity-restored");
+  const config: OpenClawConfig = {
+    agents: { entries: { main: { workspace: root } } },
+    session: { mainKey: "main", store: path.join(root, "sessions.json") },
+    cron: { enabled: true },
+  };
+  const env = { ...process.env, OPENCLAW_SKIP_CRON: "0", OPENCLAW_STATE_DIR: root };
+  writeConfigMachineState("cron.store", path.join(root, "cron.json"), { env });
+  mocks.config.mockReturnValue(config);
+  // SAFETY: both consumers of CliDeps are replaced at the model/transport boundary;
+  // the actual Gateway, command runner, repair and cron settlement owners remain real.
+  const service = buildGatewayCronService({
+    cfg: config,
+    scheduler: createTestGatewayScheduler(),
+    env,
+    deps: {} as CliDeps,
+    broadcast: () => {},
+  });
+  services.push(service);
+  const source =
+    options.initialExit === undefined
+      ? "const fs = require('node:fs'); const ok = fs.existsSync(process.argv[1]); console.log(ok ? 'capacity restored' : 'capacity still low'); process.exit(ok ? 0 : 1);"
+      : `console.log('initial command result'); process.exit(${options.initialExit});`;
+  const argv = [process.execPath, "-e", source, marker];
+  const verifyArgv = options.verifySource
+    ? [process.execPath, "-e", options.verifySource, marker]
+    : argv;
+  const job = await service.cron.add({
+    name: "original capacity guard",
+    enabled: true,
+    deleteAfterRun: false,
+    schedule: { kind: "every", everyMs: 60_000, anchorMs: Date.now() },
+    sessionTarget: "isolated",
+    sessionKey: "agent:main:discord:channel:synthetic-original-task",
+    wakeMode: "next-heartbeat",
+    delivery: options.delivery ?? { mode: "announce", channel: "telegram", to: "123" },
+    payload: {
+      kind: "command",
+      argv,
+      timeoutSeconds: 30,
+      toolsAllow: ["*"],
+      ...(options.repair === false
+        ? {}
+        : {
+            repair: {
+              onExitCodes: [1],
+              agentTurn: {
+                kind: "agentTurn" as const,
+                message: "Restore the synthetic capacity marker.",
+              },
+              verify: { kind: "command" as const, argv: verifyArgv },
+            },
+          }),
+    },
+  });
+  if (!("id" in job)) {
+    throw new Error("Expected ordinary native cron job");
+  }
+  return { service, job, marker };
+}
+
+beforeEach(() => {
+  resetActiveCronTaskRunsForTests();
+  resetGatewayWorkAdmission();
+  vi.mocked(configIO.getRuntimeConfig).mockImplementation(mocks.config);
+  vi.mocked(configRuntime.getRuntimeConfig).mockImplementation(mocks.config);
+  vi.mocked(cronDelivery.sendCronAnnouncePayloadStrict).mockImplementation(mocks.send);
+  mocks.config.mockReset();
+  mocks.agent.mockReset().mockResolvedValue({ status: "ok", summary: "model reported completion" });
+  mocks.send.mockReset().mockImplementation(async () => sent());
+});
+
+afterEach(async () => {
+  for (const service of services.splice(0)) {
+    if (service.cron.stopAndDrain) {
+      await service.cron.stopAndDrain();
+    } else {
+      service.cron.stop();
+    }
+  }
+  resetActiveCronTaskRunsForTests();
+  resetGatewayWorkAdmission();
+  vi.unstubAllEnvs();
+});
+
+describe("Gateway command repair final delivery", () => {
+  it("starts the authorized repair before entering final delivery and sends only fresh verification", async () => {
+    const { service, job, marker } = await fixture();
+    const deliveryEntered = createDeferred();
+    const releaseDelivery = createDeferred();
+    let repairEntered = false;
+    mocks.agent.mockImplementation(async (params) => {
+      repairEntered = true;
+      expect(params.job.id).toBe(job.id);
+      expect(params.job.sessionKey).toBe(job.sessionKey);
+      expect(params.job.delivery).toEqual({ mode: "none" });
+      await fs.writeFile(marker, "restored");
+      return { status: "ok", summary: "model reported completion" };
+    });
+    mocks.send.mockImplementation(async () => {
+      deliveryEntered.resolve();
+      await releaseDelivery.promise;
+      return sent();
+    });
+    const running = service.cron.run(job.id, "force");
+    try {
+      await deliveryEntered.promise;
+      expect(repairEntered).toBe(true);
+      expect(await fs.readFile(marker, "utf8")).toBe("restored");
+      expect(mocks.send.mock.calls[0]?.[0].payload.text).toBe("capacity restored");
+    } finally {
+      releaseDelivery.resolve();
+      await running;
+    }
+    expect(mocks.agent).toHaveBeenCalledOnce();
+    expect(mocks.send).toHaveBeenCalledOnce();
+    expect(service.cron.getJob(job.id)?.state).toMatchObject({
+      lastRunStatus: "ok",
+      lastDeliveryStatus: "delivered",
+      lastDelivered: true,
+    });
+  });
+
+  it("announces failed fresh verification once even when the model reports success", async () => {
+    const { service, job } = await fixture();
+    await service.cron.run(job.id, "force");
+    expect(mocks.agent).toHaveBeenCalledOnce();
+    expect(mocks.send).toHaveBeenCalledOnce();
+    expect(mocks.send.mock.calls[0]?.[0].payload.text).toBe("capacity still low");
+    expect(service.cron.getJob(job.id)?.state.lastRunStatus).toBe("error");
+  });
+
+  it("announces an empty verification timeout once while labeling earlier output as pre-repair", async () => {
+    const { service, job } = await fixture();
+    const runCommand = cronCommandRunner.runCronCommandJob;
+    const commands = vi.spyOn(cronCommandRunner, "runCronCommandJob");
+    const verified = {
+      status: "error" as const,
+      error: "command timed out",
+      errorClassification: { kind: "reason" as const, reason: "timeout" as const },
+      failureNotificationDetail: { kind: "command-timeout" as const, mode: "wall-clock" as const },
+      diagnostics: {
+        entries: [
+          {
+            ts: 0,
+            source: "exec" as const,
+            severity: "error" as const,
+            message: "command error with no output",
+            exitCode: 124,
+          },
+        ],
+      },
+    };
+    commands.mockImplementation(async (params) =>
+      commands.mock.calls.length === 2 ? verified : runCommand(params),
+    );
+    try {
+      await service.cron.run(job.id, "force");
+      expect(commands).toHaveBeenCalledTimes(2);
+      expect(mocks.agent).toHaveBeenCalledOnce();
+      expect(mocks.send).toHaveBeenCalledOnce();
+      expect(mocks.send.mock.calls[0]?.[0].payload.text).toBe(
+        "The verification command timed out without a report. Before repair, the original command reported: capacity still low",
+      );
+      expect(service.cron.getJob(job.id)?.state).toMatchObject({
+        lastRunStatus: "error",
+        lastError: "command timed out",
+        lastDeliveryStatus: "delivered",
+        lastDelivered: true,
+      });
+      expect(verified).not.toHaveProperty("summary");
+    } finally {
+      commands.mockRestore();
+    }
+  });
+
+  it.each(["error", "skipped"] as const)(
+    "announces the original failure only after a %s repair settles",
+    async (status) => {
+      const { service, job } = await fixture();
+      let repairSettled = false;
+      mocks.agent.mockImplementation(async () => {
+        expect(mocks.send).not.toHaveBeenCalled();
+        repairSettled = true;
+        return { status, error: "repair unavailable" };
+      });
+      await service.cron.run(job.id, "force");
+      expect(repairSettled).toBe(true);
+      expect(mocks.send).toHaveBeenCalledOnce();
+      expect(mocks.send.mock.calls[0]?.[0].payload.text).toBe("capacity still low");
+      expect(service.cron.getJob(job.id)?.state).toMatchObject({
+        lastRunStatus: "error",
+        lastDeliveryStatus: "delivered",
+      });
+    },
+  );
+
+  it("suppresses a silent verified result without announcing the superseded initial failure", async () => {
+    const { service, job, marker } = await fixture({ verifySource: "console.log('NO_REPLY');" });
+    mocks.agent.mockImplementation(async () => {
+      await fs.writeFile(marker, "restored");
+      return { status: "ok" };
+    });
+    await service.cron.run(job.id, "force");

+import { replyRunRegistry } from "./reply-run-registry.js";
+import { testing as replyTesting } from "./reply-run-registry.test-support.js";
+import { createMockTypingController } from "./test-helpers.js";
+import { createTypingSignaler } from "./typing-mode.js";
+
+const sessionKey = "agent:main:discord:channel:direct-requester-steer";
+const sessionId = "direct-requester-session";
+const runId = "announce:requester-settle:direct-requester";
+
+afterEach(() => {
+  clearFollowupQueueForTest(sessionKey);
+  embeddedTesting.resetActiveEmbeddedRuns();
+  replyTesting.resetReplyRunRegistry();
+  vi.restoreAllMocks();
+});
+
+async function withDirectRequester(
+  run: (owner: {
+    fingerprint: string;
+    entered: Deferred;
+    release: Deferred;
+    injected: ReturnType<typeof vi.fn<ReplyBackendMessageInjectionV2["queueMessage"]>>;
+    replace: () => ReturnType<typeof vi.fn<ReplyBackendMessageInjectionV2["queueMessage"]>>;
+  }) => Promise<void>,
+) {
+  const attempt = {
+    sessionId,
+    sessionKey,
+    runId,
+    agentId: "main",
+    config: {},
+    sessionFile: "/tmp/direct-requester-session.jsonl",
+    workspaceDir: "/tmp/direct-requester-workspace",
+    provider: "openai",
+    modelId: "gpt-test",
+    sandboxSessionKey: sessionKey,
+    senderIsOwner: true,
+    messageProvider: "discord",
+    traceAuthorized: false,
+    inputProvenance: {
+      kind: "inter_session" as const,
+      sourceSessionKey: "agent:main:subagent:completed-child",
+      sourceChannel: "internal",
+      sourceTool: "subagent_settle",
+    },
+  };
+  const admission = prepareAgentRunAdmission({
+    cfg: {},
+    operationalRunInstance: createOperationalRunInstanceRef(runId),
+    facts: {
+      agentId: "main",
+      runId,
+      ingress: { kind: "system", state: "present", boundary: "direct-requester-steering-test" },
+    },
+  });
+  try {
+    await withPreparedEmbeddedRunToolAuthority(
+      { admittedRunContext: await admission.admit("embedded", "direct-requester-steering-test") },
+      attempt,
+      undefined,
+      async (prepared) => {
+        const fingerprint = prepared.toolAuthorityFingerprint;
+        if (!fingerprint) {
+          throw new Error("The real admitted attempt did not prepare tool authority");
+        }
+        const entered = createDeferred();
+        const release = createDeferred();
+        const injected = vi.fn<ReplyBackendMessageInjectionV2["queueMessage"]>(
+          async (_text, options, assertCurrent) => {
+            assertCurrent();
+            entered.resolve();
+            await release.promise;
+            assertCurrent();
+            options?.onQueueAccepted?.(true);
+          },
+        );
+        const handle = createEmbeddedRunHandle({
+          runId,
+          toolAuthorityFingerprint: fingerprint,
+          supportsTranscriptCommitWait: true,
+          abort: vi.fn(),
+        });
+        handle.messageInjectionV2 = {
+          version: 2,
+          isAvailable: () => true,
+          queueMessage: injected,
+        };
+        let current = handle;
+        setActiveEmbeddedRun(sessionId, handle, sessionKey, attempt.sessionFile);
+        try {
+          await run({
+            fingerprint,
+            entered,
+            release,
+            injected,
+            replace: () => {
+              const replacementInjected = vi.fn<ReplyBackendMessageInjectionV2["queueMessage"]>();
+              current = {
+                ...handle,
+                abort: vi.fn(),
+                messageInjectionV2: {

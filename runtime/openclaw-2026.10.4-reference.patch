+            expect(newerSettled).not.toHaveBeenCalled();
+            expect(directRoute).toHaveBeenCalledOnce();
+            expect(getActiveReplyRunCount()).toBe(0);
+          } else {
+            const active: import("../src/auto-reply/reply/followup-turn-admission.js").AdmittedFollowupTurn =
+              {
+                runId: "older-queued-run",
+                queued,
+                operation: createMockReplyOperation({
+                  sessionId: queued.run.sessionId,

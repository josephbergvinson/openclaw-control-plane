+
+  it.each([
+    "revoked",
+    "mismatched",
+    "aborted",
+    "timed out",
+    "replaced",
+    "cleanup requested",
+    "admission failed",
+  ] as const)("does not publish execution start after %s admission", async (boundary) => {
+    const { execution, controllers, instance, entry } = createStartExecution();
+    const started = vi.fn();
+    execution.params.io.emitExecutionStarted = started;
+    agentCommand.mockImplementationOnce(async (opts: AgentCommandOpts) => {
+      const admission = prepareAgentRunAdmission({
+        cfg: {},

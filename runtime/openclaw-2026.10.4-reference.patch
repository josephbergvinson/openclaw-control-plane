+type MemoryToolName = "memory_search" | "memory_get";
+export type MemoryToolTexts = Partial<Record<MemoryToolName, string>>;
+
+function formatModelVisibleMemoryEvidence(
+  toolName: MemoryToolName,
+  content: unknown,
+): { toolName: MemoryToolName; text: string } | undefined {
+  const visibleText = extractTextContent(content).trim();
+  if (!visibleText) {
+    return undefined;
+  }
+  const payload = asOptionalRecord(safeParseJson(visibleText));
+  let body = visibleText;
+  if (toolName === "memory_get") {
+    const text = normalizeOptionalString(payload?.text);
+    const source = normalizeOptionalString(payload?.path);
+    if (text) {
+      body = source ? `${text}\nSource: ${source}` : text;
+    }
+  } else if (Array.isArray(payload?.results)) {
+    const snippets = payload.results.flatMap((value) => {
+      const hit = asOptionalRecord(value);
+      const snippet = normalizeOptionalString(hit?.snippet);
+      const source = normalizeOptionalString(hit?.path);
+      return snippet ? [source ? `${snippet}\nSource: ${source}` : snippet] : [];
+    });
+    if (snippets.length) {
+      body = snippets.join("\n");
+    }
+  }
+  // This is previously permitted tool content, not a new instruction or a generated summary.
+  return { toolName, text: `Retrieved ${toolName} result:\n${body}` };
+}
+
+/** Keep completed source text ahead of search snippets within the existing transcript bound. */
+export function appendMemoryToolResultText(
+  current: MemoryToolTexts,
+  next: { toolName: MemoryToolName; text: string } | undefined,
+): MemoryToolTexts {
+  if (!next) {
+    return current;
+  }
+  const maxChars = resolveTranscriptReadLimits().maxChars;
+  const previous = current[next.toolName] ?? "";
+  const addition = truncateUtf16Safe(
+    next.text,
+    Math.max(0, maxChars - previous.length - (previous ? 1 : 0)),
+  );
+  const updated = {
+    ...current,
+    [next.toolName]: previous + (addition ? `${previous ? "\n" : ""}${addition}` : ""),

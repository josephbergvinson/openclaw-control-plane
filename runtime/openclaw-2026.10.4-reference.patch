+  authProfileId: "selected-meeting-account",
+  streamParams: { maxTokens: 6_000 },
+  prompt: "Check the recorded source and return the requested notes.",
+  systemPrompt: "Verify names against existing records; do not invent meeting decisions.",
+  timeoutMs: 900_000,
+  session: {
+    sessionId: "captured-meeting",
+    title: "Engineering review",
+    startedAt: "2026-10-18T12:00:00Z",
+    source: { providerId: "discord-voice", guildId: "guild", channelId: "room" },
+  },
+};
+
+beforeEach(() => {
+  createRuntimeAgent.mockReset().mockReturnValue(agentRuntime);
+  consultRealtimeVoiceAgent.mockReset().mockResolvedValue({
+    text: '{"overview":"Recorded notes"}',
+    provider: "observed-provider",
+    model: "observed-model",
+  });
+});
+
+it("retains the selected account and source fence through the read-only native records owner", async () => {
+  const controller = new AbortController();
+  const assertCurrent = vi.fn();
+  const first = await runTranscriptRecordConsult({
+    ...params,
+    abortSignal: controller.signal,
+    assertCurrent,
+  });
+  const second = await runTranscriptRecordConsult(params);
+  expect(first).toEqual({
+    text: '{"overview":"Recorded notes"}',
+    provider: "observed-provider",
+    model: "observed-model",
+  });
+  expect(second).toEqual(first);
+  expect(createRuntimeAgent).toHaveBeenCalledTimes(2);
+  expect(consultRealtimeVoiceAgent.mock.calls[0]![0]).toMatchObject({
+    cfg: params.config,
+    agentRuntime,
+    agentId: "resident",
+    contextMode: "isolated",
+    messageProvider: "discord",
+    lane: "transcript-summary",
+    args: { question: params.prompt },
+    provider: "requested-provider",

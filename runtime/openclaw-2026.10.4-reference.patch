@@ -0,0 +1,247 @@
+import { createHash } from "node:crypto";
+import { getRuntimeConfig } from "../../../config/config.js";
+import {
+  getAgentEventLifecycleGeneration,
+  onAgentEvent,
+  registerAgentEventLifecycleRotationHandler,
+} from "../../../infra/agent-events.js";
+import { getAgentRunContext } from "../../../infra/agent-run-registry.js";
+import { runWithGatewayIndependentRootWorkContinuation } from "../../../process/gateway-work-admission.js";
+import { resolveSendPolicy } from "../../../sessions/send-policy.js";
+import { subagentRuns } from "./subagent-registry-memory.js";
+import { createSubagentRegistryProgress } from "./subagent-registry-progress.js";
+import { subscribeSubagentRunChanges } from "./subagent-registry-publication.js";
+import type { SubagentRunRecord } from "./subagent-registry.types.js";
+
+export async function publishActiveRequesterProgress(
+  entry: SubagentRunRecord,
+  text: string,
+  assertCurrent: () => void,
+): Promise<boolean | undefined> {
+  if (entry.progressOrigin?.channel !== "discord") {
+    return undefined;
+  }
+  const context = entry.requesterTurnRunId
+    ? getAgentRunContext(entry.requesterTurnRunId)
+    : undefined;
+  const publication = context?.requesterProgress;
+  if (!publication) {
+    // A private child has no independent front-channel progress owner.
+    return entry.completionTarget === "parent" ? false : undefined;
+  }
+  const origin = entry.progressOrigin;
+  if (
+    !origin ||
+    context?.sessionKey !== entry.requesterSessionKey ||
+    context.agentId !== entry.requesterAgentId ||
+    (entry.completionRequesterSessionId !== undefined &&
+      context.sessionId !== entry.completionRequesterSessionId) ||
+    publication.source.channel !== origin?.channel ||
+    publication.source.accountId !== origin.accountId ||
+    publication.source.to !== origin.to ||
+    String(publication.source.threadId ?? "") !== String(origin.threadId ?? "")
+  ) {
+    throw new Error("Child progress does not match its admitted requester card");
+  }
+  assertCurrent();
+  const result = await publication.publish(text, assertCurrent);
+  assertCurrent();
+  return result.status === "visible" && Boolean(result.messageId);
+}
+
+export function createNativeSubagentRegistryProgress(
+  warn: (message: string, error?: unknown) => void,
+) {
+  const run = <T>(
+    entry: SubagentRunRecord,
+    work: () => Promise<T>,
+    cohort?: readonly SubagentRunRecord[],
+  ) =>
+    subagentRuns.runWithCompletionBatchAuthority(cohort ?? [entry], () =>
+      runWithGatewayIndependentRootWorkContinuation(work, "subagents:progress"),
+    );
+  async function deliveryContext(
+    entry: SubagentRunRecord,
+    assertCurrent: () => void,
+    cohort?: readonly SubagentRunRecord[],
+  ) {
+    const { loadRequesterSessionEntry } =
+      await import("../announce/subagent-announce-delivery.runtime.js");
+    assertCurrent();
+    const requester = loadRequesterSessionEntry(entry.requesterSessionKey, entry.requesterAgentId);
+    const assertDeliveryCurrent = () => {
+      assertCurrent();
+      subagentRuns.runWithCompletionBatchAuthority(cohort ?? [entry], () => {});
+      const fresh = loadRequesterSessionEntry(entry.requesterSessionKey, entry.requesterAgentId);
+      if (
+        !requester.entry?.sessionId ||
+        fresh.entry?.sessionId !== requester.entry.sessionId ||
+        fresh.agentId !== requester.agentId ||
+        fresh.storePath !== requester.storePath ||
+        resolveSendPolicy({
+          cfg: fresh.cfg,
+          entry: fresh.entry,
+          sessionKey: fresh.canonicalKey,
+          channel: entry.progressOrigin?.channel,
+        }) === "deny"
+      ) {
+        throw new Error("Subagent progress requester changed before delivery");
+      }
+    };
+    assertDeliveryCurrent();
+    return { requester, assertDeliveryCurrent };
+  }
+  const progress = createSubagentRegistryProgress({
+    runs: subagentRuns,
+    onAgentEvent,
+    onRunChanges: (observe) =>
+      subscribeSubagentRunChanges("projection", ({ runIds }) => observe(runIds)),
+    isSourceCurrent: (entry) => {
+      try {
+        subagentRuns.runWithCompletionAuthority(entry, () => {});
+        return (
+          entry.execution.lifecycleGeneration === getAgentEventLifecycleGeneration() &&
+          !subagentRuns.isCompletionAuthorityRetired(entry)
+        );
+      } catch {
+        return false;
+      }
+    },
+    publish: ({ entry, runId, cohort, source, checkpoint, signal, assertCurrent }) =>
+      run(
+        entry,
+        async () => {
+          const { requester, assertDeliveryCurrent } = await deliveryContext(
+            entry,
+            assertCurrent,
+            cohort,
+          );
+          const live = await publishActiveRequesterProgress(
+            entry,
+            checkpoint.text,
+            assertDeliveryCurrent,
+          );
+          if (live !== undefined) {
+            return live;
+          }
+          const { sendMessage } = await import("../../../infra/outbound/message.js");
+          assertDeliveryCurrent();
+          const key = createHash("sha256")
+            .update(`${runId}:${entry.generation}:${checkpoint.key}`)
+            .digest("hex");
+          const result = await sendMessage({
+            cfg: requester.cfg,
+            ...source,
+            content: checkpoint.text,
+            agentId: requester.agentId,
+            requesterSessionKey: requester.canonicalKey,
+            runId,
+            idempotencyKey: `subagent-progress:${key}`,
+            skipQueue: true,
+            gatewayOwnedDelivery: true,
+            abortSignal: signal,
+            assertDirectAdapterHandoff: assertDeliveryCurrent,
+            onPlatformSendDispatch: async () => assertDeliveryCurrent(),
+          });
+          assertDeliveryCurrent();
+          return result.deliveryStatus === "sent" && Boolean(result.result?.messageId);
+        },
+        cohort,
+      ),
+    edit: ({ entry, source, messageId, text, snapshot, signal, assertCurrent }) =>
+      run(entry, async () => {
+        const { requester, assertDeliveryCurrent } = await deliveryContext(entry, assertCurrent);
+        const [
+          { runMessageAction },
+          { resolveMessageActionOutcome, resolveMessageActionMessageId },
+        ] = await Promise.all([
+          import("../../../infra/outbound/message-action-runner.js"),
+          import("../../../infra/outbound/message-action-contracts.js"),
+        ]);
+        assertDeliveryCurrent();
+        const result = await runMessageAction({
+          cfg: requester.cfg,
+          action: "edit",
+          params: { ...source, target: source.to, messageId, message: text },
+          progressSnapshot: snapshot,
+          agentId: requester.agentId,
+          sessionKey: requester.canonicalKey,
+          sessionId: requester.entry?.sessionId,
+          gatewayOwnedDelivery: true,
+          suppressTranscriptMirror: true,
+          abortSignal: signal,
+          assertDirectAdapterHandoff: assertDeliveryCurrent,
+          onPlatformSendDispatch: async () => assertDeliveryCurrent(),
+        });
+        assertDeliveryCurrent();
+        return (
+          !result.dryRun &&
+          resolveMessageActionOutcome(result).ok &&
+          resolveMessageActionMessageId(result.payload) === messageId
+        );
+      }),
+    requestCheckpoint: ({
+      entry,
+      runId,
+      sessionKey,
+      sessionId,
+      cohort,
+      message,
+      signal,
+      queueIdentity,
+      assertCurrent,
+    }) =>
+      run(
+        entry,
+        async () => {
+          const {
+            queueGuardedEmbeddedAgentMessageWithOutcomeAsync,
+            resolveActiveEmbeddedRunOwnerByRunId,
+          } = await import("../../embedded-agent-runner/runs.js");
+          assertCurrent();
+          const selected = resolveActiveEmbeddedRunOwnerByRunId(runId);
+          if (
+            !selected ||
+            (selected.sessionKey !== undefined && selected.sessionKey !== sessionKey) ||
+            (sessionId !== undefined && selected.sessionId !== sessionId)
+          ) {
+            return false;
+          }
+          const canInject = () => {
+            assertCurrent();
+            const fresh = resolveActiveEmbeddedRunOwnerByRunId(runId);
+            return (
+              !signal.aborted &&
+              fresh?.sessionId === selected.sessionId &&
+              fresh.runId === selected.runId &&
+              fresh.sessionKey === selected.sessionKey
+            );
+          };
+          const outcome = await queueGuardedEmbeddedAgentMessageWithOutcomeAsync(
+            selected.sessionId,
+            message,
+            {
+              queueIdentity,
+              abortSignal: signal,
+              isInboundUserMessage: false,
+              deliveryBoundary: "after-tool-batch",
+              waitForTranscriptCommit: true,
+              deliveryTimeoutMs: 180_000,
+            },
+            canInject,
+          );
+          return outcome.queued;
+        },
+        cohort,
+      ),
+    warn,
+  });
+  registerAgentEventLifecycleRotationHandler("subagent-registry-progress", () => {
+    void progress.reset();
+  });
+  return {
+    ...progress,
+    prepareContinuation: (input: Parameters<typeof progress.prepareContinuation>[0]) =>
+      progress.prepareContinuation({ ...input, entry: getRuntimeConfig().channels?.discord }),
+  };
+}

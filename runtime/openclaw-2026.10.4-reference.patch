@@ -114,6 +114,53 @@ export function isProfileRestartRequiredError(err: unknown): boolean {
   return err instanceof ProfileRestartRequiredError;
 }
 
+/** Resolve the exact native handle owned by the current profile operation. */
+export function getCurrentManagedBrowserHandle(
+  cdpUrl: string,
+  options?: { required?: boolean },
+): RunningChrome | undefined {
+  const leases = profileLeaseStorage.getStore();
+  if (!leases) {
+    if (options?.required) {
+      throw new Error("Opaque HTTP credentials require an owned managed browser process");
+    }
+    return undefined;
+  }
+  let selected: RunningChrome | undefined;
+  let matched = false;
+  for (const [runtime, lease] of leases) {
+    if (runtime.profile.cdpUrl !== cdpUrl) {
+      continue;
+    }
+    matched = true;
+    lease.signal.throwIfAborted();
+    const actor = getProfileLifecycle(runtime);
+    if (actor.generation !== lease.generation || actor.terminal || actor.blockedReason) {
+      throw lifecycleError(runtime.profile.name, "operation superseded");
+    }
+    const running = runtime.running;
+    if (
+      !running ||
+      !actor.handles.has(running) ||
+      running.proc.exitCode != null ||
+      running.proc.signalCode != null
+    ) {
+      if (options?.required) {
+        throw new Error("Opaque HTTP credentials require an owned managed browser process");
+      }
+      continue;
+    }
+    if (selected && selected !== running) {
+      throw new Error("Managed browser operation has ambiguous process ownership");
+    }
+    selected = running;
+  }
+  if (options?.required && (!matched || !selected)) {
+    throw new Error("Opaque HTTP credentials require an owned managed browser process");
+  }
+  return selected;
+}
+
 export function isWithinProfileOperationLease(runtime: ProfileRuntimeState): boolean {
   return profileLeaseStorage.getStore()?.has(runtime) === true;
 }

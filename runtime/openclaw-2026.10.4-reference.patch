diff --git a/src/infra/infra-runtime.deferral.test-support.ts b/src/infra/infra-runtime.deferral.test-support.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9c438aab85042082d57b3ffc50156c5d1c3b6e98
--- /dev/null
+++ b/src/infra/infra-runtime.deferral.test-support.ts
@@ -0,0 +1,307 @@
+import { describe, expect, it, vi } from "vitest";
+import { isGatewayWorkAdmissionClosed } from "../process/gateway-work-admission.js";
+import type { GatewayRestartIntent } from "./restart-intent.js";
+
+type RestartDeferralModule = Pick<
+  typeof import("./restart.js"),
+  | "consumeGatewayRestartIntent"
+  | "peekGatewayRestartReason"
+  | "scheduleGatewayRestart"
+  | "setPreRestartDeferralCheck"
+>;
+
+export function registerRestartDeferralTests({
+  setupRestartSignalSuite,
+  getRestart,
+  managedSuccessorOwner,
+  countRestartSignalEmits,
+}: {
+  setupRestartSignalSuite: () => void;
+  getRestart: () => RestartDeferralModule;
+  managedSuccessorOwner: NonNullable<GatewayRestartIntent["successorOwner"]>;
+  countRestartSignalEmits: (calls: readonly unknown[][]) => number;
+}): void {
+  describe("pre-restart deferral check", () => {
+    setupRestartSignalSuite();
+
+    it("emits SIGUSR2 immediately when no deferral check is registered", async () => {
+      const restart = getRestart();
+      const emitSpy = vi.spyOn(process, "emit");
+      const handler = () => {};
+      process.on("SIGUSR2", handler);
+      try {
+        restart.scheduleGatewayRestart({ delayMs: 0 });
+        await vi.advanceTimersByTimeAsync(0);
+        expect(emitSpy).toHaveBeenCalledWith("SIGUSR2");
+      } finally {
+        process.removeListener("SIGUSR2", handler);
+      }
+    });
+
+    it("emits SIGUSR2 immediately when deferral check returns 0", async () => {
+      const restart = getRestart();
+      const emitSpy = vi.spyOn(process, "emit");
+      const handler = () => {};
+      process.on("SIGUSR2", handler);
+      try {
+        restart.setPreRestartDeferralCheck(() => 0);
+        restart.scheduleGatewayRestart({ delayMs: 0 });
+        await vi.advanceTimersByTimeAsync(0);
+        expect(emitSpy).toHaveBeenCalledWith("SIGUSR2");
+      } finally {
+        process.removeListener("SIGUSR2", handler);
+      }
+    });
+
+    it("defers SIGUSR2 until deferral check returns 0", async () => {
+      const restart = getRestart();
+      const emitSpy = vi.spyOn(process, "emit");
+      const handler = () => {};
+      process.on("SIGUSR2", handler);
+      try {
+        let pending = 2;
+        restart.setPreRestartDeferralCheck(() => pending);
+        restart.scheduleGatewayRestart({ delayMs: 0 });
+
+        // After initial delay fires, deferral check returns 2 — should NOT emit yet
+        await vi.advanceTimersByTimeAsync(0);
+        expect(emitSpy).not.toHaveBeenCalledWith("SIGUSR2");
+
+        // After one poll (500ms), still pending
+        await vi.advanceTimersByTimeAsync(500);
+        expect(emitSpy).not.toHaveBeenCalledWith("SIGUSR2");
+
+        // Drain pending work
+        pending = 0;
+        await vi.advanceTimersByTimeAsync(500);
+        expect(emitSpy).toHaveBeenCalledWith("SIGUSR2");
+      } finally {
+        process.removeListener("SIGUSR2", handler);
+      }
+    });
+
+    it("bypasses the pre-restart deferral check when requested", async () => {
+      const restart = getRestart();
+      const emitSpy = vi.spyOn(process, "emit");
+      const pendingCheck = vi.fn(() => 5);
+      const handler = () => {};
+      process.on("SIGUSR2", handler);
+      try {
+        restart.setPreRestartDeferralCheck(pendingCheck);
+        restart.scheduleGatewayRestart({
+          delayMs: 0,
+          reason: "update.run",
+          skipDeferral: true,
+        });
+
+        await vi.advanceTimersByTimeAsync(0);
+
+        expect(pendingCheck).not.toHaveBeenCalled();
+        expect(emitSpy).toHaveBeenCalledWith("SIGUSR2");
+        expect(restart.peekGatewayRestartReason()).toBe("update.run");
+      } finally {
+        process.removeListener("SIGUSR2", handler);
+      }
+    });
+
+    it("upgrades an already scheduled restart to bypass deferral", async () => {
+      const restart = getRestart();
+      const emitSpy = vi.spyOn(process, "emit");
+      const pendingCheck = vi.fn(() => 5);
+      const handler = () => {};
+      process.on("SIGUSR2", handler);
+      try {
+        restart.setPreRestartDeferralCheck(pendingCheck);
+        restart.scheduleGatewayRestart({ delayMs: 1_000, reason: "config.patch" });
+        const forced = restart.scheduleGatewayRestart({
+          delayMs: 1_000,
+          reason: "update.run",
+          skipDeferral: true,
+        });
+
+        expect(forced.coalesced).toBe(false);
+
+        await vi.advanceTimersByTimeAsync(1_000);
+
+        expect(pendingCheck).not.toHaveBeenCalled();
+        expect(emitSpy).toHaveBeenCalledWith("SIGUSR2");
+        expect(restart.peekGatewayRestartReason()).toBe("update.run");
+      } finally {
+        process.removeListener("SIGUSR2", handler);
+      }
+    });
+
+    it("preserves a session-owned preparation hook when a hookless forced restart pulls a pending timer earlier (#86742)", async () => {
+      const restart = getRestart();
+      const emitSpy = vi.spyOn(process, "emit");
+      const beforeEmit = vi.fn(async () => {});
+      const handler = () => {};
+      process.on("SIGUSR2", handler);
+      try {
+        const pending = restart.scheduleGatewayRestart({
+          delayMs: 1_000,
+          reason: "session-A",
+          sessionKey: "agent:main:session-A",
+          emitHooks: { beforeEmit },
+        });
+        const forced = restart.scheduleGatewayRestart({
+          delayMs: 1_000,
+          preservePendingEmitHooksOnDeferralBypass: true,
+          reason: "gateway.restart.safe",
+          skipDeferral: true,
+        });
+
+        expect(pending.emitHooksQueued).toBe(true);
+        expect(forced.coalesced).toBe(false);
+        expect(forced.emitHooksQueued).toBe(false);
+
+        await vi.advanceTimersByTimeAsync(1_000);
+
+        expect(beforeEmit).toHaveBeenCalledTimes(1);
+        expect(emitSpy).toHaveBeenCalledWith("SIGUSR2");
+        expect(restart.peekGatewayRestartReason()).toBe("gateway.restart.safe");
+      } finally {
+        process.removeListener("SIGUSR2", handler);
+      }
+    });
+
+    it("bypasses an active restart deferral when a forced restart arrives", async () => {
+      const restart = getRestart();
+      const emitSpy = vi.spyOn(process, "emit");
+      const staleBeforeEmit = vi.fn(async () => {});
+      const handler = () => {};
+      process.on("SIGUSR2", handler);
+      try {
+        restart.setPreRestartDeferralCheck(() => 5);
+        restart.scheduleGatewayRestart({
+          delayMs: 0,
+          reason: "config.patch",
+          emitHooks: { beforeEmit: staleBeforeEmit },
+        });
+        await vi.advanceTimersByTimeAsync(0);
+        expect(emitSpy).not.toHaveBeenCalledWith("SIGUSR2");
+
+        const forced = restart.scheduleGatewayRestart({
+          delayMs: 0,
+          reason: "update.run",
+          successorOwner: managedSuccessorOwner,
+          skipDeferral: true,
+        });
+
+        expect(forced.coalesced).toBe(false);
+        expect(emitSpy).toHaveBeenCalledWith("SIGUSR2");
+        expect(staleBeforeEmit).not.toHaveBeenCalled();
+        expect(restart.peekGatewayRestartReason()).toBe("update.run");
+        expect(restart.consumeGatewayRestartIntent()).toEqual({
+          reason: "update.run",
+          successorOwner: managedSuccessorOwner,
+        });
+      } finally {
+        process.removeListener("SIGUSR2", handler);
+      }
+    });
+
+    it("clears a session-owned preparation hook when a forced update owns the sentinel (#86742)", async () => {
+      const restart = getRestart();
+      const emitSpy = vi.spyOn(process, "emit");
+      const beforeEmit = vi.fn(async () => {});
+      const handler = () => {};
+      process.on("SIGUSR2", handler);
+      try {
+        restart.setPreRestartDeferralCheck(() => 5);
+        restart.scheduleGatewayRestart({
+          delayMs: 0,
+          reason: "session-A",
+          sessionKey: "agent:main:session-A",
+          emitHooks: { beforeEmit },
+        });
+        await vi.advanceTimersByTimeAsync(0);
+        expect(emitSpy).not.toHaveBeenCalledWith("SIGUSR2");
+
+        const forced = restart.scheduleGatewayRestart({
+          delayMs: 0,
+          reason: "update.run",
+          skipDeferral: true,
+        });
+
+        expect(forced.coalesced).toBe(false);
+        expect(forced.emitHooksQueued).toBe(false);
+        expect(beforeEmit).not.toHaveBeenCalled();
+        await Promise.resolve();
+        await Promise.resolve();
+        expect(emitSpy).toHaveBeenCalledWith("SIGUSR2");
+        expect(restart.peekGatewayRestartReason()).toBe("update.run");
+      } finally {
+        process.removeListener("SIGUSR2", handler);
+      }
+    });
+
+    it("preserves a session-owned preparation hook when a hookless forced restart bypasses active deferral (#86742)", async () => {
+      const restart = getRestart();
+      const emitSpy = vi.spyOn(process, "emit");
+      const beforeEmit = vi.fn(async () => {});
+      const handler = () => {};
+      process.on("SIGUSR2", handler);
+      try {
+        restart.setPreRestartDeferralCheck(() => 5);
+        const pending = restart.scheduleGatewayRestart({
+          delayMs: 0,
+          reason: "session-A",
+          sessionKey: "agent:main:session-A",
+          emitHooks: { beforeEmit },
+        });
+        await vi.advanceTimersByTimeAsync(0);
+        expect(emitSpy).not.toHaveBeenCalledWith("SIGUSR2");
+
+        const forced = restart.scheduleGatewayRestart({
+          delayMs: 0,
+          preservePendingEmitHooksOnDeferralBypass: true,
+          reason: "gateway.restart.safe",
+          skipDeferral: true,
+        });
+
+        expect(pending.emitHooksQueued).toBe(true);
+        expect(forced.coalesced).toBe(false);
+        expect(forced.emitHooksQueued).toBe(false);
+        expect(beforeEmit).toHaveBeenCalledTimes(1);
+        await Promise.resolve();
+        await Promise.resolve();
+        expect(emitSpy).toHaveBeenCalledWith("SIGUSR2");
+        expect(restart.peekGatewayRestartReason()).toBe("gateway.restart.safe");
+      } finally {
+        process.removeListener("SIGUSR2", handler);
+      }
+    });
+
+    it("keeps the default deferral open until pending work drains", async () => {
+      const restart = getRestart();
+      const emitSpy = vi.spyOn(process, "emit");
+      const handler = () => {};
+      process.on("SIGUSR2", handler);
+      try {
+        let pending = 5;
+        restart.setPreRestartDeferralCheck(() => pending);
+        restart.scheduleGatewayRestart({ delayMs: 0 });
+
+        await vi.advanceTimersByTimeAsync(0);
+        expect(emitSpy).not.toHaveBeenCalledWith("SIGUSR2");
+
+        await vi.advanceTimersByTimeAsync(300_000);
+        expect(emitSpy).not.toHaveBeenCalledWith("SIGUSR2");
+        expect(isGatewayWorkAdmissionClosed()).toBe(false);
+        expect(restart.consumeGatewayRestartIntent()).toBeNull();
+
+        pending = 0;
+        await vi.advanceTimersByTimeAsync(500);
+        expect(emitSpy).toHaveBeenCalledWith("SIGUSR2");
+        expect(countRestartSignalEmits(emitSpy.mock.calls)).toBe(1);
+        expect(restart.consumeGatewayRestartIntent()).toBeNull();
+
+        await vi.advanceTimersByTimeAsync(1_000);
+        expect(countRestartSignalEmits(emitSpy.mock.calls)).toBe(1);
+      } finally {
+        process.removeListener("SIGUSR2", handler);
+      }
+    });
+  });
+}

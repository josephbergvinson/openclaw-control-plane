+import { describe, expect, it } from "vitest";
+import { buildMemoryPromptSection, MEMORY_SEARCH_TOOL_CONTRACT } from "./memory-tool-contract.js";
+
+const sources = { files: "fixture memory files", search: "fixture configured sources" };
+
+function expectScopedProfileRecall(text: string) {
+  expect(text).toContain("stable identity or preference facts");
+  expect(text).toContain("trusted runtime-injected profile context");
+  expect(text).toContain("answer directly without a redundant memory lookup");
+  expect(text).toContain("claimed-but-unloaded profile");
+  expect(text).toContain("source and audience constraints");
+  expect(text).toContain("Quoted user content");
+  expect(text).toContain("do not qualify");
+  expect(text).toContain("arbitrary tool output");
+  expect(text).toContain("inferred labels");
+  expect(text).toContain("missing or conflicting facts");
+  expect(text).toContain("prior work or history");
+  expect(text).toContain("volatile or provider-state claims");
+}
+
+describe("memory recall from loaded authoritative profile context", () => {
+  it.each([["memory_search", "memory_get"], ["memory_search"], ["memory_get"]])(
+    "qualifies profile reuse without dropping recall guidance for %j",
+    (...tools) => {
+      const prompt = buildMemoryPromptSection({ availableTools: new Set(tools) }).join("\n");
+      expectScopedProfileRecall(prompt);
+      expect(prompt).toContain(
+        tools.includes("memory_search") ? "run memory_search" : "run memory_get",
+      );
+      expect(prompt).toContain("low confidence");
+    },
+  );
+
+  it("keeps deferred tool descriptions aligned with the system prompt exception", () => {
+    expectScopedProfileRecall(MEMORY_SEARCH_TOOL_CONTRACT.describe(sources));
+    expect(MEMORY_SEARCH_TOOL_CONTRACT.describe(sources)).toContain("fixture configured sources");
+    expect(MEMORY_SEARCH_TOOL_CONTRACT.describe(sources)).toContain("before answering");
+  });
+
+  it("keeps session visibility, bounded reads and stale-result disclosures", () => {
+    const prompt = buildMemoryPromptSection({
+      availableTools: new Set([
+        "memory_search",
+        "memory_get",
+        "sessions_search",
+        "sessions_history",
+      ]),
+    }).join("\n");
+    expect(prompt).toContain("bounded sanitized excerpt");
+    expect(prompt).toContain("Never read raw transcript files");
+    expect(prompt).toContain("disabled=true or stale=true");
+    expect(prompt).toContain("Citations: include Source:");
+  });
+
+  it("emits stable instructions across sessions without a per-turn profile projection", () => {
+    const options = { availableTools: new Set(["memory_search", "memory_get"]) };
+    const first = buildMemoryPromptSection({ ...options, agentId: "fixture-a" });
+    const second = buildMemoryPromptSection({ ...options, agentId: "fixture-b" });
+    expect(first).toEqual(second);
+    expect(first.join("\n")).not.toContain("fixture-a");
+    expect(first.join("\n")).not.toContain("fixture-b");
+  });
+
+  it("does not add memory capabilities when no memory tools are available", () => {
+    expect(buildMemoryPromptSection({ availableTools: new Set() })).toEqual([]);
+  });
+});

index 0000000000000000000000000000000000000000..ccaefffcb150b01ab432866653499fdf587a75ff
--- /dev/null
+++ b/src/agents/embedded-agent-runner/run/attempt-gateway-tools.progress.test.ts
@@ -0,0 +1,119 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { prepareSystemAgentRunAdmission } from "../../admitted-run-context.js";
+import {
+  captureGatewayToolCallerAssertion,
+  getGatewayToolCallerIdentity,
+} from "../../tools/gateway-caller-context.js";
+import { withPreparedEmbeddedGatewayTools } from "./attempt-gateway-tools.js";
+
+// Registry selection and platform edits are exercised together by the native
+// Discord composition. This boundary test observes the actual shared dispatch
+// producer without opening a process-global registry or provider connection.
+const capture = vi.hoisted(() => vi.fn());
+vi.mock("../../subagents/registry/subagent-registry.js", () => ({
+  captureSubagentRequesterProgress: capture,
+}));
+
+describe("internal requester progress at shared tool admission", () => {
+  beforeEach(() => capture.mockReset());
+
+  const base = {
+    agentId: "main",
+    sessionKey: "agent:main:discord:channel:parent",
+    sessionId: "requester-incarnation",
+    agentHarnessId: "builtin",
+    disableTools: true,
+  };
+
+  it.each(["sessions_send", "subagent_announce", "subagent_settle"] as const)(
+    "carries only captured progress for an admitted %s continuation",
+    async (sourceTool) => {
+      const progress = {
+        source: { channel: "discord", to: "channel:parent" },
+        publish: vi.fn(async () => ({ status: "visible" as const })),
+      };
+      capture.mockReturnValue(progress);
+      const admission = prepareSystemAgentRunAdmission(
+        {},
+        "parent-continuation",
+        "main",
+        "requester-progress-producer-test",
+      );
+      try {
+        const attempt = {
+          ...base,
+          admittedRunContext: await admission.admit("embedded"),
+          inputProvenance: {
+            kind: "inter_session" as const,
+            sourceChannel: "internal",
+            sourceSessionKey: "agent:main:subagent:child",
+            sourceTool,
+          },
+        };
+        const isCurrent = () => true;
+        await withPreparedEmbeddedGatewayTools(attempt, isCurrent, async () => {
+          const caller = getGatewayToolCallerIdentity();
+          const assertCurrent = captureGatewayToolCallerAssertion();
+          expect(assertCurrent).toBeTypeOf("function");
+          expect(() => assertCurrent?.()).not.toThrow();
+          expect(caller?.requesterProgress).toBe(progress);
+          expect(caller?.operationalRunInstance).toBe(
+            attempt.admittedRunContext.operationalRunInstance,
+          );
+          expect(caller?.turnSourceChannel).toBeUndefined();
+          expect(caller?.turnSourceTo).toBeUndefined();
+        });
+        expect(capture).toHaveBeenCalledExactlyOnceWith({
+          requesterSessionKey: attempt.sessionKey,
+          requesterSessionId: attempt.sessionId,
+          requesterAgentId: attempt.agentId,
+          sourceSessionKey: attempt.inputProvenance.sourceSessionKey,
+          ...(sourceTool === "subagent_settle"
+            ? { synthesisRunId: attempt.admittedRunContext.operationalRunInstance.runId }
+            : {}),
+          isCurrent,
+        });
+        expect(progress.publish).not.toHaveBeenCalled();
+      } finally {
+        admission.close();
+      }
+    },
+  );
+
+  it.each([undefined, "unknown_internal_tool"])(
+    "does not create progress authority from unrelated source tool %s",
+    async (sourceTool) => {
+      const admission = prepareSystemAgentRunAdmission(
+        {},
+        "parent-continuation",
+        "main",
+        "requester-progress-producer-test",
+      );
+      try {
+        const attempt = {
+          ...base,
+          admittedRunContext: await admission.admit("embedded"),
+          ...(sourceTool
+            ? {
+                inputProvenance: {
+                  kind: "inter_session" as const,
+                  sourceSessionKey: "agent:main:subagent:child",
+                  sourceTool,
+                },
+              }
+            : {}),
+        };
+        await withPreparedEmbeddedGatewayTools(
+          attempt,
+          () => true,
+          async () => {
+            expect(getGatewayToolCallerIdentity()?.requesterProgress).toBeUndefined();
+          },
+        );
+        expect(capture).not.toHaveBeenCalled();
+      } finally {
+        admission.close();
+      }
+    },
+  );
+});

+import fs from "node:fs/promises";
+import path from "node:path";
+import { registerAgentWorkspaceAccess } from "openclaw/plugin-sdk/agent-workspace-runtime";
+import { createDeferred } from "openclaw/plugin-sdk/extension-shared";
+import { loadUserTurnTranscriptRecorderFactoryForTest } from "openclaw/plugin-sdk/plugin-test-runtime";
+import { upsertSessionEntry } from "openclaw/plugin-sdk/session-store-runtime";
+import { describe, expect, it, vi } from "vitest";
+import {
+  loadCodexOriginalSourcePublicationTestFixture,
+  type CodexAppServerRequestParams,
+} from "../extensions/codex/test-api.js";
+import {
+  ACTIVE_EMBEDDED_RUN_REGISTRATIONS,
+  ACTIVE_EMBEDDED_RUNS,
+} from "../src/agents/embedded-agent-runner/run-state.js";
+import { createAgentHarnessHostCapabilities } from "../src/agents/harness/host-capability.js";
+import { resolveReplySteeringAuthority } from "../src/auto-reply/reply/agent-runner-fallback-authority.js";
+import {
+  runActiveReplySteer,
+  type ActiveReplySteerParams,
+} from "../src/auto-reply/reply/agent-runner-steer-adoption.js";
+import {
+  clearFollowupQueueForTest,
+  createQueueTestRun,
+} from "../src/auto-reply/reply/queue.test-helpers.js";
+import { getExistingFollowupQueue } from "../src/auto-reply/reply/queue/state.js";
+import { withQuestionCreator } from "../src/auto-reply/reply/reply-run-question.test-support.js";
+import { replyRunRegistry } from "../src/auto-reply/reply/reply-run-registry.js";
+import { getAttachedBackend } from "../src/auto-reply/reply/reply-run-registry.state.js";
+import { createMockTypingController } from "../src/auto-reply/reply/test-helpers.js";
+import { createTypingSignaler } from "../src/auto-reply/reply/typing-mode.js";
+
+const { harness: codex, readTranscriptMessagesByIdentity } =
+  await loadCodexOriginalSourcePublicationTestFixture();
+const {
+  createTestParams,
+  createStartedThreadHarness,
+  fastWait,
+  runCodexAppServerAttempt,
+  setupRunAttemptTestHooks,
+} = codex;
+type CodexTurnSteerParams = CodexAppServerRequestParams<"turn/steer"> & {
+  clientUserMessageId: string;
+};
+
+setupRunAttemptTestHooks();
+
+describe("native original-source publication through the actual Codex producer", () => {
+  it("retains dormant FIFO, media and durable raw input before sending source-scoped quote context once", async () => {
+    const params = createTestParams();
+    const key = "agent:main:discord:channel:codex-publication";
+    params.agentId = "main";
+    params.sessionKey = key;
+    params.runId = "accepted-backing-work";
+    params.messageProvider = "discord";
+    params.agentAccountId = "company";
+    params.timeoutMs = 60_000;
+    await fs.mkdir(params.workspaceDir, { recursive: true });
+    const document = path.join(params.workspaceDir, "original-document.pdf");
+    await fs.writeFile(document, "Synthetic source document.");
+    const target = {
+      agentId: "main",
+      sessionId: params.sessionId,
+      sessionKey: key,
+      storePath: path.join(codex.tempDir, "publication-source.sqlite"),
+    };
+    params.sessionTarget = target;
+    await upsertSessionEntry({
+      ...target,
+      entry: {
+        sessionId: params.sessionId,
+        sessionFile: params.sessionFile,
+        updatedAt: Date.now(),
+      },
+    });
+    const base = createQueueTestRun({
+      prompt: "original work",
+      messageId: "original",
+      originatingChannel: "discord",
+      originatingTo: "channel:codex-publication",
+      originatingAccountId: "company",
+      originatingThreadId: "original-thread",
+    });
+    Object.assign(base.run, {
+      agentId: "main",
+      agentDir: codex.tempDir,
+      config: params.config,
+      sessionId: params.sessionId,
+      sessionKey: key,
+      sessionFile: params.sessionFile,
+      workspaceDir: params.workspaceDir,
+      provider: params.provider,
+      model: params.modelId,
+      messageProvider: "discord",
+      agentAccountId: "company",
+    });
+    const createRecorder = await loadUserTurnTranscriptRecorderFactoryForTest();
+    const preparing = createDeferred<void>();
+    const release = createDeferred<void>();
+    const transfer = vi.fn();
+    const unregister = registerAgentWorkspaceAccess(params.workspaceDir, {
+      bridge: {
+        readFileWithSource: async () => {
+          throw Object.assign(new Error("No bootstrap file"), { code: "ENOENT" });
+        },
+        readFile: async () => Buffer.alloc(0),
+        writeFile: async () => {},
+        stat: async () => null,
+      },
+      prepareTurnAttachments: async (turn, assertCurrent) => {
+        if (!turn.media?.length) {
+          return undefined;
+        }
+        preparing.resolve();
+        await release.promise;
+        assertCurrent();
+        transfer(turn.media);
+        return "The original document is available.";
+      },
+    });
+    const wire: CodexTurnSteerParams[] = [];
+    const harness = createStartedThreadHarness(
+      async (method, raw) => {
+        if (method !== "turn/steer") {
+          return undefined;
+        }
+        const request = raw as CodexTurnSteerParams;
+        // This is the physical native transport boundary: original user custody
+        // must already exist in the real SQLite transcript before Codex sees it.
+        const messages = await readTranscriptMessagesByIdentity(params);
+        const rawText = request.input
+          .flatMap((item) => (item.type === "text" ? [item.text] : []))
+          .join("\n");
+        const expected = rawText.includes("source A") ? "source A" : "source B";
+        expect(messages.filter((message) => message.content === expected)).toHaveLength(1);
+        wire.push(structuredClone(request));
+        queueMicrotask(() => {
+          void harness.notify({
+            method: "item/completed",
+            params: {
+              threadId: "thread-1",
+              turnId: "turn-1",
+              item: {
+                id: `user-${wire.length}`,
+                type: "userMessage",
+                clientId: request.clientUserMessageId,
+              },
+            },
+          });
+        });
+        return { turnId: "turn-1" };
+      },
+      { persistedThreads: [] },
+    );
+    const abort = new AbortController();
+    params.abortSignal = abort.signal;
+    let run: ReturnType<typeof runCodexAppServerAttempt> | undefined;
+    let runOutcome = "not-started";
+    let closeHost: (() => void) | undefined;
+    const describeStage = (stage: string) => {
+      const operation = replyRunRegistry.get(key);
+      const backend = ACTIVE_EMBEDDED_RUNS.get(params.sessionId);
+      const registration = backend && ACTIVE_EMBEDDED_RUN_REGISTRATIONS.get(backend);
+      let registrationAuthority = "absent";
+      try {
+        if (registration?.toolAuthority) {
+          registration.toolAuthority.assertActive();
+          registrationAuthority = "current";
+        }
+      } catch (error) {
+        registrationAuthority = String(error);
+      }
+      return JSON.stringify({
+        stage,
+        runOutcome,
+        nativeRequests: harness.requests.map(({ method }) => method),
+        operationPhase: operation?.phase,
+        backendAttached: Boolean(operation && getAttachedBackend(operation)),
+        exactBackendPublished: Boolean(
+          backend && operation && getAttachedBackend(operation) === backend,
+        ),
+        registrationAuthority,
+        injectionTarget: replyRunRegistry.resolveCurrentMessageInjectionTarget(key)?.runId,
+        sources: getExistingFollowupQueue(key)?.items.map((source) => ({
+          messageId: source.messageId,
+          pending: source.steerPending?.phase,
+          retryBound: Boolean(source.retrySteer),
+          authorityMismatch: resolveReplySteeringAuthority(source, operation)
+            .shouldQueueAuthorityMismatch,
+        })),
+        transferred: transfer.mock.calls.length,
+        steered: wire.length,
+      });
+    };
+    // Bound each real producer gate independently so a rejected publication
+    // reports its actual registry/queue state instead of consuming the test deadline.
+    const waitForStage = async <T>(
+      stage: string,
+      pending: Promise<T>,
+      timeout: number = fastWait.timeout,
+    ) => {
+      let settled: { value: T } | { error: unknown } | undefined;
+      void pending.then(
+        (value) => {
+          settled = { value };
+        },
+        (error: unknown) => {
+          settled = { error };
+        },
+      );
+      await vi.waitFor(
+        () => {
+          if (settled && "error" in settled) {
+            throw new Error(describeStage(stage), { cause: settled.error });
+          }
+          expect(settled, describeStage(stage)).toBeDefined();
+        },
+        { ...fastWait, timeout },
+      );
+      if (!settled || "error" in settled) {
+        throw new Error(describeStage(stage));
+      }
+      return settled.value;
+    };
+    try {
+      await withQuestionCreator(key, base, async (operation, fingerprint, admittedRunContext) => {
+        operation.setPhase("running");
+        params.replyOperation = operation;
+        params.toolAuthorityFingerprint = fingerprint;
+        // The producer and its publication binding share one admitted execution.
+        // A fresh same-runId admission would correctly retire this source claim.
+        const host = createAgentHarnessHostCapabilities({
+          attempt: { ...params, admittedRunContext },
+          pluginId: "codex",
+          nativeModelPolicySupport: "exact",
+        });
+        params.hostCapabilities = host.capabilities;
+        closeHost = host.close;
+        const sources = ["A", "B"].map((id) => {
+          const typing = createMockTypingController();
+          const media = id === "A" ? [{ path: document, kind: "document" as const }] : undefined;
+          const recorder = createRecorder({
+            target: { ...target, cwd: params.workspaceDir, sessionEntry: undefined },
+            message: {
+              role: "user",
+              content: `source ${id}`,
+              timestamp: Date.now(),
+              idempotencyKey: `native-publication-${id}`,
+              ...(media ? { __openclaw: { media } } : {}),
+            },
+          });
+          return {
+            followupRun: {
+              ...base,
+              run: { ...base.run },
+              prompt: `source ${id}`,
+              messageId: id,
+              media,
+              userTurnTranscriptRecorder: recorder,
+              currentInboundContext: {
+                text: `quote ${id}`,
+                fragments: [
+                  { kind: "conversation-data", text: `quote ${id}` },
+                  { kind: "runtime-instruction", text: `current route ${id}` },
+                ],
+              },
+              turnAdoptionLifecycle: { onAdopted: vi.fn(async () => {}), onSettled: vi.fn() },
+            },
+            opts: { onBlockReply: vi.fn(async () => {}), onQueuedFollowupSettled: vi.fn() },
+            providedReplyOperation: operation,
+            queueKey: key,
+            sessionKey: key,
+            releaseAdmissionTicket: vi.fn(),
+            replyOperationRunState: {},
+            resolvedQueue: { mode: "steer", debounceMs: 0 },
+            restartRecoverySourceTurnId: `discord-source-${id}`,
+            runFollowup: vi.fn(async () => {}),
+            sessionCtx: { InboundEventKind: "user_request" },
+            touchActiveSessionEntry: vi.fn(async () => {}),
+            typing,
+            typingSignals: createTypingSignaler({ typing, mode: "never", isHeartbeat: false }),
+            toolAuthorityFingerprint: fingerprint,
+          } satisfies ActiveReplySteerParams;
+        });
+        for (const source of sources) {
+          await waitForStage(
+            `retain source ${source.followupRun.messageId}`,
+            runActiveReplySteer(source),
+          );
+        }
+        await new Promise<void>((resolve) => {
+          setImmediate(resolve);
+        });
+        expect(getExistingFollowupQueue(key)?.items).toEqual(
+          sources.map((source) => source.followupRun),
+        );
+        expect(sources.every((source) => source.runFollowup.mock.calls.length === 0)).toBe(true);
+        run = runCodexAppServerAttempt(params);
+        runOutcome = "pending";
+        void run.then(
+          () => {
+            runOutcome = "resolved";
+          },
+          (error: unknown) => {
+            runOutcome = `rejected: ${String(error)}`;
+          },
+        );
+        await waitForStage("native turn acceptance", run.waitForTurnAccepted(), 30_000);
+        await waitForStage(
+          "original media preparation",
+          Promise.race([
+            preparing.promise,
+            run.then(() => {
+              throw new Error("Codex attempt settled before original media preparation");
+            }),
+          ]),
+        );
+        expect(wire).toEqual([]);
+        expect(transfer).not.toHaveBeenCalled();
+        release.resolve();
+        await vi.waitFor(
+          () => expect(wire, describeStage("native FIFO consumption")).toHaveLength(2),

@@ -0,0 +1,47 @@
+import type { RequesterProgressPublication } from "../channels/progress-continuation.js";
+import {
+  getActiveAgentRunDelegatedAuthority,
+  getAgentRunContext,
+  type AgentRunDelegatedAuthority,
+} from "./agent-run-registry.js";
+
+/** Bind progress to the existing exact run owner, without another registry or lifecycle. */
+export function bindAgentRunRequesterProgress(
+  authority: AgentRunDelegatedAuthority,
+  publication: RequesterProgressPublication,
+): void {
+  const instance = authority.operationalRunInstance;
+  const context = getAgentRunContext(instance.runId);
+  const assertCurrent = () => {
+    if (
+      !context ||
+      getAgentRunContext(instance.runId) !== context ||
+      getActiveAgentRunDelegatedAuthority(instance) !== authority
+    ) {
+      throw new Error("Requester progress lost its admitted run owner");
+    }
+  };
+  assertCurrent();
+  const isProgressMessageId = publication.isProgressMessageId;
+  context!.requesterProgress = {
+    source: Object.freeze({ ...publication.source }),
+    ...(isProgressMessageId
+      ? {
+          isProgressMessageId: (messageId: string) => {
+            assertCurrent();
+            return isProgressMessageId(messageId);
+          },
+        }
+      : {}),
+    publish: async (text, assertCallerCurrent) => {
+      const assertDeliveryCurrent = () => {
+        assertCurrent();
+        assertCallerCurrent?.();
+      };
+      assertDeliveryCurrent();
+      const result = await publication.publish(text, assertDeliveryCurrent);
+      assertDeliveryCurrent();
+      return result;
+    },
+  };
+}

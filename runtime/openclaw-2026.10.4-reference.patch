+import { createDeferred } from "openclaw/plugin-sdk/extension-shared";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { createBrowserNodeSessionTabRoute } from "./browser-node-proxy.js";
+
+type Extra = Parameters<typeof import("./browser-tool.runtime.js").callGatewayTool>[3];
+const mocks = vi.hoisted(() => ({
+  gateway: vi.fn(async (_method: string, _options: unknown, _request: unknown, _extra: Extra) => ({
+    payload: { result: { ok: true } },
+  })),
+  prepare: vi.fn(async ({ body }: { body?: unknown }) => ({ body })),
+}));
+vi.mock("./browser-tool.runtime.js", () => ({
+  callGatewayTool: mocks.gateway,
+  persistBrowserProxyResultFiles: async (result: unknown) => result,
+  fetchBrowserJson: vi.fn(),
+}));
+vi.mock("./browser-proxy-upload.js", () => ({
+  isBrowserProxyUploadRequest: () => false,
+  prepareBrowserProxyUploadRequest: mocks.prepare,
+}));
+const close = (assertCurrent: () => void) =>
+  createBrowserNodeSessionTabRoute({ nodeId: "node", commands: ["browser.proxy"] }).closeTarget({
+    targetId: "owned-tab",
+    profile: "work",
+    assertCurrent,
+  });
+beforeEach(() => {
+  mocks.gateway.mockReset().mockResolvedValue({ payload: { result: { ok: true } } });
+  mocks.prepare.mockReset().mockImplementation(async ({ body }) => ({ body }));
+});
+describe("native node close dispatch authority", () => {
+  it("rejects a close whose authority expires during preparation before reaching Gateway", async () => {
+    const entered = createDeferred<void>();
+    const release = createDeferred<void>();
+    mocks.prepare.mockImplementation(async ({ body }) => {
+      entered.resolve();
+      await release.promise;
+      return { body };
+    });
+    let current = true;
+    const pending = close(() => {
+      if (!current) {
+        throw new Error("close authority revoked");
+      }
+    });
+    const rejected = expect(pending).rejects.toThrow("close authority revoked");
+    await entered.promise;
+    current = false;
+    release.resolve();
+    await rejected;
+    expect(mocks.gateway).not.toHaveBeenCalled();
+  });
+  it.each([true, false])(
+    "uses the native source-bound authority at actual Gateway dispatch (current=%s)",
+    async (currentAtDispatch) => {
+      const entered = createDeferred<void>();
+      const release = createDeferred<void>();
+      let current = true;
+      let effects = 0;
+      mocks.gateway.mockImplementation(async (_method, _options, _request, extra) => {
+        entered.resolve();
+        await release.promise;
+        if (
+          extra?.dispatchAuthority?.kind !== "source-bound" ||
+          extra.dispatchAuthority.version !== 2
+        ) {
+          throw new Error("missing native authority");
+        }
+        extra.dispatchAuthority.assertCurrent();
+        effects += 1;
+        return { payload: { result: { ok: true } } };
+      });
+      const pending = close(() => {
+        if (!current) {
+          throw new Error("close authority revoked");
+        }
+      });
+      const checked = currentAtDispatch
+        ? expect(pending).resolves.toEqual({ status: "closed" })
+        : expect(pending).rejects.toThrow("close authority revoked");
+      await entered.promise;
+      current = currentAtDispatch;
+      release.resolve();
+      await checked;
+      expect(effects).toBe(currentAtDispatch ? 1 : 0);
+      expect(JSON.stringify(mocks.gateway.mock.calls[0]?.[2])).not.toContain("assertCurrent");
+    },
+  );
+});

@@ -0,0 +1,142 @@
+import { isCronActiveJobMarkerCurrent } from "../active-jobs.js";
+import type { CronStoredJob, CronRunTelemetry } from "../types.js";
+import { abortErrorMessage } from "./execution-errors.js";
+import type { CronServiceState } from "./state.js";
+import { resolveCronJobTimeoutMs } from "./timeout-policy.js";
+import type { ExecuteJobCoreOptions } from "./timer-execution-timeout.js";
+
+/** Preserve the original scheduled requester boundary when a command needs agent repair. */
+export function resolveCronJobAdmissionSource(job: CronStoredJob) {
+  return job.owner?.sessionKey ||
+    job.owner?.accountId ||
+    job.scheduledToolPolicy?.mode === "account" ||
+    (job.payload.kind === "agentTurn" && job.payload.externalContentSource) ||
+    job.toolsAllowProvenance?.channelRequester ||
+    (job.toolsAllowProvenance && job.toolsAllowProvenance.callerOrigin?.kind !== "local")
+    ? "requester-schedule"
+    : "operator-schedule";
+}
+
+/** Await durable authority, then recheck synchronous cancellation immediately before effects. */
+export async function assertCronCommandRunCurrent(
+  options: ExecuteJobCoreOptions | undefined,
+  abortSignal: AbortSignal | undefined,
+): Promise<void> {
+  abortSignal?.throwIfAborted();
+  await options?.assertRunCurrent?.();
+  abortSignal?.throwIfAborted();
+  if (options?.activeJobMarker?.cancellation?.kind === "requested") {
+    throw new Error(options.activeJobMarker.cancellation.reason);
+  }
+  if (!isCronActiveJobMarkerCurrent(options?.activeJobMarker)) {
+    throw new Error("Gateway restarting.");
+  }
+}
+
+type CronCommandRunResult = Awaited<
+  ReturnType<NonNullable<CronServiceState["deps"]["runCommandJob"]>>
+>;
+
+/** One opt-in repair turn stays inside the original command job and its deadline. */
+export async function repairCronCommand(params: {
+  state: CronServiceState;
+  job: CronStoredJob;
+  initial: CronCommandRunResult;
+  startedAt: number;
+  abortSignal?: AbortSignal;
+  options?: ExecuteJobCoreOptions;
+}): Promise<CronCommandRunResult & CronRunTelemetry> {
+  const { state, job, initial, abortSignal, options } = params;
+  if (job.payload.kind !== "command" || !job.payload.repair || !state.deps.runCommandJob) {
+    return initial;
+  }
+  const repair = job.payload.repair;
+  const detail = initial.failureNotificationDetail;
+  if (
+    initial.status !== "error" ||
+    detail?.kind !== "command-exit" ||
+    !repair.onExitCodes.includes(detail.exitCode)
+  ) {
+    return initial;
+  }
+  const timeoutMs = resolveCronJobTimeoutMs(job);
+  if (timeoutMs === undefined) {
+    return { ...initial, error: "command repair requires a bounded original job timeout" };
+  }
+  const remainingSeconds = () =>
+    Math.floor((params.startedAt + timeoutMs - state.deps.nowMs()) / 1000);
+  const boundTimeout = (requested: number | undefined) => {
+    const remaining = remainingSeconds();
+    if (remaining < 1) {
+      throw new Error("command repair exhausted the original job deadline");
+    }
+    return requested && requested > 0 ? Math.min(requested, remaining) : remaining;
+  };
+  await assertCronCommandRunCurrent(options, abortSignal);
+  const repairJob: CronStoredJob = {
+    ...job,
+    delivery: { mode: "none" },
+    payload: {
+      ...repair.agentTurn,
+      timeoutSeconds: boundTimeout(repair.agentTurn.timeoutSeconds),
+      toolsAllow: job.payload.toolsAllow,
+      toolsAllowIsDefault: job.payload.toolsAllowIsDefault,
+    },
+  };
+  const repaired = await state.deps.runIsolatedAgentJob({
+    deliveryAttemptFence: options?.deliveryAttemptFence ?? null,
+    job: repairJob,
+    admissionSource: resolveCronJobAdmissionSource(job),
+    message: repair.agentTurn.message,
+    abortSignal,
+    onExecutionStarted: options?.onExecutionStarted,
+    onExecutionPhase: options?.onExecutionPhase,
+    onLaneWait: options?.onLaneWait,
+    executionIdentity: options?.executionIdentity,
+  });
+  if (abortSignal?.aborted) {
+    return { status: "error", error: abortErrorMessage(abortSignal) };
+  }
+  await assertCronCommandRunCurrent(options, abortSignal);
+  if (repaired.status !== "ok") {
+    return { ...initial, ...repaired, status: "error", summary: initial.summary };
+  }
+  const verified = await state.deps.runCommandJob({
+    deliveryAttemptFence: options?.deliveryAttemptFence ?? null,
+    job: {
+      ...job,
+      payload: {
+        ...repair.verify,
+        timeoutSeconds: boundTimeout(repair.verify.timeoutSeconds),
+        toolsAllow: job.payload.toolsAllow,
+        toolsAllowIsDefault: job.payload.toolsAllowIsDefault,
+      },
+    },
+    abortSignal,
+  });
+  await assertCronCommandRunCurrent(options, abortSignal);
+  // Only the fresh command owns the domain outcome; model prose is not verification.
+  const verificationTimedOutWithoutReport =
+    verified.status === "error" &&
+    verified.failureNotificationDetail?.kind === "command-timeout" &&
+    !verified.summary?.trim();
+  const priorFailure = initial.summary?.trim();
+  return {
+    ...verified,
+    // Preserve the real timeout and its empty output as verification evidence.
+    // Earlier output is labeled as pre-repair context, never a current domain result.
+    ...(verificationTimedOutWithoutReport
+      ? {
+          summary:
+            "The verification command timed out without a report." +
+            (priorFailure ? ` Before repair, the original command reported: ${priorFailure}` : ""),
+        }
+      : {}),
+    executionStarted: repaired.executionStarted,
+    sessionId: repaired.sessionId,
+    sessionKey: repaired.sessionKey,
+    model: repaired.model,
+    provider: repaired.provider,
+    usage: repaired.usage,
+  };
+}

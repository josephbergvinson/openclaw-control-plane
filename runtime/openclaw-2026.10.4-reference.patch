+  SessionMcpRequesterScope,
+} from "./agent-bundle-mcp-types.js";
+import { assertMcpRequesterScopeMatches } from "./mcp-requester-scope.js";
+import { captureAgentPluginRuntimeRefresh } from "./plugin-runtime-refresh.js";
+
+/** Refresh the native logical run only after its original account has a usable catalog. */
+export function createRequesterMcpConnectRefresh(params: {
+  requesterScope: SessionMcpRequesterScope | undefined;
+  assertCurrent: () => void;
+  acquire: () => Promise<RequesterScopedMcpRuntimeHandle | undefined>;
+  acceptsCatalog: (catalog: McpToolCatalog, serverName: string) => boolean;
+}): (serverName: string) => Promise<boolean> {
+  const refresh = captureAgentPluginRuntimeRefresh();
+  const assertCurrent = () => {
+    params.assertCurrent();
+    getSessionMcpRequestSignal()?.throwIfAborted();
+    refresh.assertCurrent();
+  };
+  return async (serverName) => {
+    assertCurrent();
+    if (!params.requesterScope) {
+      return false;
+    }
+    let lease: RequesterScopedMcpRuntimeHandle | undefined;
+    let ready = false;
+    try {
+      lease = await params.acquire();
+      assertCurrent();
+      if (lease) {
+        assertMcpRequesterScopeMatches(
+          lease.runtime.requesterScope,
+          params.requesterScope,
+          "connect-refresh",
+        );
+        const catalog = await lease.runtime.getCatalog();
+        assertCurrent();
+        lease.runtime.assertOwnerCurrent?.();
+        ready =
+          Object.hasOwn(catalog.servers, serverName) &&
+          !catalog.diagnostics?.some((diagnostic) => diagnostic.serverName === serverName) &&
+          lease.runtime.requesterConnect?.authorizedServerNames.includes(serverName) === true &&
+          params.acceptsCatalog(catalog, serverName);
+      }
+    } finally {
+      if (lease) {
+        await releaseSessionMcpRuntime(lease);
+      }
+    }
+    assertCurrent();
+    // The native refresh owner carries completed effects and delivery state into
+    // its next generation. This callback never retries a model/tool action.
+    return ready && refresh.request();
+  };
+}

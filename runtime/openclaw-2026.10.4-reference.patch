+    if (
+      path.parse(root.path).root === root.path ||
+      !path.isAbsolute(root.path) ||
+      path.normalize(root.path) !== root.path ||
+      (await fs.realpath(root.path)) !== root.path
+    ) {
+      throw new Error("Native projection root is not physical");
+    }
+    const names = new Set(root.entries.map((entry) => entry.relativePath));
+    if (names.size !== root.entries.length || !names.has("")) {
+      throw new Error("Native projection root inventory is incomplete");
+    }
+    for (const entry of root.entries) {
+      const relative = entry.relativePath;
+      if (
+        (relative &&
+          (path.isAbsolute(relative) ||
+            path.normalize(relative) !== relative ||
+            relative === "." ||
+            relative.split(path.sep).includes(".."))) ||
+        (relative === "" && entry.kind !== "directory")
+      ) {
+        throw new Error("Native projection entry escapes its root");
+      }
+      const source = path.join(root.path, relative);
+      if (
+        transientArg0Roots.some(
+          (transient) => source !== transient && isPathInside(transient, source),
+        )
+      ) {
+        throw new Error("Native projection must omit transient arg0 descendants");
+      }
+      const info = await fs.lstat(source);
+      if (
+        (await fs.realpath(source)) !== source ||
+        info.isSymbolicLink() ||
+        JSON.stringify(nativeProjectionIdentity(info)) !== JSON.stringify(entry.identity) ||
+        (info.mode & 0o7777) !== entry.mode ||
+        info.uid !== process.getuid?.() ||
+        info.mtimeMs !== entry.mtimeMs ||
+        info.ctimeMs !== entry.ctimeMs ||
+        (entry.kind === "directory"
+          ? !info.isDirectory()
+          : !info.isFile() || info.nlink !== 1 || info.size !== entry.bytes || !entry.sha256)
+      ) {
+        throw new Error("Native projection physical inventory changed");
+      }
+      if (
+        entry.kind === "directory" &&
+        !isNativeCodexTransientArg0Directory(source, projection.homes)
+      ) {
+        const expected = root.entries
+          .filter(
+            (candidate) =>
+              candidate.relativePath !== relative &&
+              path.dirname(candidate.relativePath) === (relative || "."),
+          )
+          .map((candidate) => path.basename(candidate.relativePath))

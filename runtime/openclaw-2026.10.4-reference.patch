diff --git a/src/agents/harness/host-source-preserving-context.ts b/src/agents/harness/host-source-preserving-context.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4f7136e99419944c736c7b839df274e7005f92c7
--- /dev/null
+++ b/src/agents/harness/host-source-preserving-context.ts
@@ -0,0 +1,156 @@
+import type { EmbeddedRunAttemptInternalParams } from "../embedded-agent-runner/run/internal-params.js";
+import { estimateCompactionHistoryTokens } from "../sessions/compaction/request-budget.js";
+import { estimateJsonPayloadTokenPressure } from "../sessions/context-token-pressure.js";
+import type { AgentHarnessHostCapabilities } from "./host-capability-types.js";
+import { cloneHostSnapshot as cloneSnapshot } from "./host-snapshot.js";
+
+/** Binds the admitted detached original and its existing private extraction budget owner. */
+export function bindHarnessSourcePreservingContext(
+  attempt: Partial<
+    Pick<
+      EmbeddedRunAttemptInternalParams,
+      "trigger" | "sessionManager" | "onCompactionRequestBudget"
+    >
+  >,
+  assertActive: () => void,
+): AgentHarnessHostCapabilities["sourcePreservingContext"] {
+  // Capture the detached original and the private host observer before plugin handoff.
+  // The plugin receives neither the mutable manager nor the callback itself.
+  const sourceMessages =
+    attempt.trigger === "memory" && attempt.sessionManager && attempt.onCompactionRequestBudget
+      ? cloneSnapshot(attempt.sessionManager.buildSessionContext().messages)
+      : undefined;
+  const sourceSessionId = sourceMessages ? attempt.sessionManager?.getHeader()?.id : undefined;
+  if (sourceMessages && !sourceSessionId) {
+    throw new Error("Detached extraction has no immutable original session identity.");
+  }
+  const sourceBudgetObserver = attempt.onCompactionRequestBudget;
+  const observeSourceBudget = (...args: Parameters<NonNullable<typeof sourceBudgetObserver>>) => {
+    assertActive();
+    // The existing extraction owner, not a second ledger, retains the exact
+    // pre-effect refusal and all prior-candidate effects.
+    sourceBudgetObserver?.(...args);
+  };
+  return sourceMessages && sourceSessionId
+    ? Object.freeze({
+        sessionId: sourceSessionId,
+        read: () => {
+          assertActive();
+          return structuredClone(sourceMessages);
+        },
+        assertPrepared: () => {
+          assertActive();
+          // Re-enter the private observer to recover only its exact latched
+          // pre-effect refusal after a redacted native transport failure.
+          observeSourceBudget(undefined);
+        },
+        rejectInputLimit: ({ totalChars, sourceChars, limitChars }) => {
+          assertActive();
+          if (
+            !Number.isSafeInteger(totalChars) ||
+            !Number.isSafeInteger(sourceChars) ||
+            !Number.isSafeInteger(limitChars) ||
+            sourceChars <= 0 ||
+            limitChars <= 0 ||
+            sourceChars > totalChars ||
+            totalChars <= limitChars
+          ) {
+            throw new Error("Invalid native extraction text-input refusal.");
+          }
+          const sourceTokens = estimateCompactionHistoryTokens(sourceMessages);
+          const allowance = Math.max(0, limitChars - (totalChars - sourceChars));
+          // This known protocol boundary only chooses an unsent lossless segment.
+          // Its final request still must pass the actual native model budget below.
+          const maxHistoryTokens = Math.min(
+            sourceTokens - 1,
+            Math.floor((sourceTokens * allowance) / sourceChars),
+          );
+          observeSourceBudget(
+            {
+              contextWindow: Math.max(0, maxHistoryTokens),
+              reserveTokens: 0,
+              fixedTokens: 0,
+              pendingTokens: 0,
+            },
+            sourceMessages,
+            "prepared",
+          );
+          throw new Error("Native extraction text-input refusal was not retained.");
+        },
+        checkRequest: (request) => {
+          assertActive();
+          if (request.effectsStarted) {
+            observeSourceBudget(undefined, undefined, "effects-started");
+          }
+          if (
+            !Number.isSafeInteger(request.usableContextWindow) ||
+            request.usableContextWindow <= 0 ||
+            !Number.isSafeInteger(request.estimatedRequestTokens) ||
+            request.estimatedRequestTokens < 0
+          ) {
+            throw new Error("Native extraction has no valid prepared request budget.");
+          }
+          const before = request.beforeHostAddition;
+          const final = request.finalRequest;
+          if (
+            !before ||
+            typeof before !== "object" ||
+            Array.isArray(before) ||
+            !final ||
+            typeof final !== "object" ||
+            Array.isArray(final)
+          ) {
+            throw new Error("Invalid native extraction request carrier.");
+          }
+          const nativeKeys = Object.keys(before).filter((key) => key !== "instructions");
+          const finalKeys = Object.keys(final).filter((key) => key !== "instructions");
+          if (
+            nativeKeys.length !== finalKeys.length ||
+            nativeKeys.some(
+              (key) =>
+                !Object.hasOwn(final, key) || Reflect.get(before, key) !== Reflect.get(final, key),
+            )
+          ) {
+            throw new Error(
+              "Host extraction changed native request fields outside its prepared instructions.",
+            );
+          }
+          const previousInstructions = Reflect.get(before, "instructions");
+          const finalInstructions = Reflect.get(final, "instructions");
+          if (
+            (previousInstructions !== undefined && typeof previousInstructions !== "string") ||
+            (finalInstructions !== undefined && typeof finalInstructions !== "string") ||
+            (typeof previousInstructions === "string" &&
+              (typeof finalInstructions !== "string" ||
+                !finalInstructions.startsWith(previousInstructions)))
+          ) {
+            throw new Error("Host extraction replaced native prepared instructions.");
+          }
+          const addedInstructions =
+            typeof finalInstructions === "string"
+              ? finalInstructions.slice(
+                  typeof previousInstructions === "string" ? previousInstructions.length : 0,
+                )
+              : "";
+          // Native pressure is model-facing and image-aware. Only the exact
+          // host addition is new; transport base64 must never become text cost.
+          const pressure =
+            request.estimatedRequestTokens +
+            (addedInstructions ? estimateJsonPayloadTokenPressure(addedInstructions) : 0);
+          const sourceTokens = estimateCompactionHistoryTokens(sourceMessages);
+          observeSourceBudget(
+            {
+              contextWindow: request.usableContextWindow,
+              // Native usableContextWindow has already charged native headroom.
+              reserveTokens: 0,
+              fixedTokens: Math.max(0, pressure - sourceTokens),
+              pendingTokens: 0,
+            },
+            sourceMessages,
+            "prepared",
+          );
+        },
+        markProviderStarted: () => observeSourceBudget(undefined, undefined, "provider-started"),
+      })
+    : undefined;
+}

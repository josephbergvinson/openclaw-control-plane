+#if os(macOS)
+import Testing
+@testable import OpenClawKit
+
+/// Synthetic native metadata only; no captured OS UI, AX or Keychain operations.
+struct NativeCredentialAdministratorPurposeTests {
+    private static let host = "11111111-1111-4111-8111-111111111111"
+    private static let evidence = [
+        "Synthetic Installer requests a change for fixture",
+        "Enter an administrator's name and password to allow this.",
+        "Name:", "Password:", "Cancel", "Install Software",
+    ]
+
+    @Test func `administrator request body cannot substitute for a validated selected username`() throws {
+        let binding = try NativeCredentialBinding(
+            alias: "mac.fixture.password",
+            kind: .macLogin,
+            account: "fixture",
+            hostID: Self.host,
+            bundleIDs: ["com.apple.SecurityAgent"])
+        #expect(!binding.authorizes(
+            hostID: Self.host, bundleID: "com.apple.SecurityAgent", accountEvidence: Self.evidence))
+    }
+
+    @Test(arguments: [
+        "Enter an administrator's name and password to allow this.",
+        "Enter an administrator’s name and password to allow this.",
+        "Enter your password to continue with “DevicesSystemUpdater”.",
+    ])
+    func `named administrator form authorizes the enrolled current short username`(_ instruction: String) throws {
+        let binding = try NativeCredentialBinding(
+            alias: "mac.fixture.password",
+            kind: .macLogin,
+            account: "fixture",
+            hostID: Self.host,
+            bundleIDs: ["com.apple.SecurityAgent"])
+        var evidence = Self.evidence
+        evidence[1] = instruction
+        #expect(NativeCredentialPromptPurpose.resolve(nativeEvidence: evidence) == .administratorAuthentication)
+        #expect(binding.authorizes(
+            hostID: Self.host,
+            bundleID: "com.apple.SecurityAgent",
+            accountEvidence: evidence,
+            localAccount: "fixture",
+            selectedUsername: "fixture"))
+    }
+
+    @Test(arguments: [
+        "missing",
+        "other",
+        "full-name",
+        "prefix",
+        "suffix",
+        "whitespace",
+        "host",
+        "principal",
+        "binding-account",
+        "owner",
+        "kind",
+        "purpose",
+        "incomplete",
+        "conflicting",
+        "conflicting-administrator",
+        "cancel",
+    ], [
+        "Enter an administrator's name and password to allow this.",
+        "Enter your password to continue with “DevicesSystemUpdater”.",
+    ])
+    func `administrator authority cannot borrow account text or another principal`(
+        _ change: String, _ instruction: String) throws
+    {
+        var host = Self.host
+        var account = "fixture"
+        var principal = "fixture"
+        var owner = "com.apple.SecurityAgent"
+        var kind = NativeCredentialBinding.Kind.macLogin
+        var selected: String? = "fixture"
+        var purpose: NativeCredentialPromptPurpose?
+        var evidence = Self.evidence
+        evidence[1] = instruction
+        switch change {
+        case "missing": selected = nil
+        case "other": selected = "other"
+        case "full-name": selected = "Fixture Operator"
+        case "prefix": selected = "otherfixture"
+        case "suffix": selected = "fixture.other"
+        case "whitespace": selected = " fixture "
+        case "host": host = "22222222-2222-4222-8222-222222222222"
+        case "principal": principal = "other"
+        case "binding-account": account = "other"
+        case "owner": owner = "com.apple.LocalAuthentication.UIAgent"
+        case "kind": kind = .appleAccount
+        case "purpose": purpose = .accountAuthentication
+        case "incomplete": evidence[1] = "Enter an administrator's name and password."
+        case "conflicting": evidence.append("To allow this, enter the “login” keychain password.")
+        case "conflicting-administrator": evidence.append("Enter an administrator’s name and password to allow this.")
+        case "cancel": evidence.removeAll { $0 == "Cancel" }
+        default: Issue.record("Unknown fixture")
+        }
+        let binding = try NativeCredentialBinding(
+            alias: "mac.fixture.password",
+            kind: kind,
+            account: account,
+            hostID: Self.host,
+            bundleIDs: kind == .appleAccount ? ["com.apple.systempreferences"] : [owner])
+        #expect(!binding.authorizes(
+            hostID: host,
+            bundleID: owner,
+            accountEvidence: evidence,
+            purpose: purpose,
+            localAccount: principal,
+            selectedUsername: selected))
+    }
+}
+#endif

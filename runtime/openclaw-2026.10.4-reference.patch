+import { afterEach, expect, it } from "vitest";
+import { resolveMcpRequesterScope } from "../../mcp-requester-scope.js";
+import { subagentRuns } from "../registry/subagent-registry-memory.js";
+import type { SubagentRunRecord } from "../registry/subagent-registry.types.js";
+import { captureSubagentRequesterMcpScope } from "./subagent-requester-mcp-scope.js";
+
+const scope = {
+  requesterSenderId: "original-user",
+  messageChannel: "discord",
+  agentAccountId: "sho",
+};
+const ids: string[] = [];
+afterEach(() => {
+  for (const id of ids.splice(0)) {
+    subagentRuns.delete(id);
+  }
+});
+
+function retain(id: string, requesterMcpScope = scope): SubagentRunRecord {
+  const row: SubagentRunRecord = {
+    runId: id,
+    childSessionKey: `agent:sho:subagent:${id}`,
+    requesterSessionKey: "agent:sho:main",
+    requesterDisplayKey: "owner",
+    completionRequesterSessionId: "parent-original",
+    requesterMcpScope: { ...requesterMcpScope },
+    task: "finish original task",
+    cleanup: "keep",
+    createdAt: 1,
+    execution: { status: "terminal", endedAt: 2 },
+    completion: { required: true },
+    delivery: { status: "pending" },
+  };
+  ids.push(id);
+  subagentRuns.set(id, row);
+  return row;
+}
+
+it("carries the original tuple through a retained yielded completion batch", () => {
+  const records = [retain("mcp-completion-one"), retain("mcp-completion-two")];
+  let current = true;
+  const inherited = captureSubagentRequesterMcpScope({
+    records,
+    requesterSessionKey: "agent:sho:main",
+    requesterSessionId: "parent-original",
+    assertCurrent: () => {
+      if (!current) {
+        throw new Error("yield owner retired");
+      }
+    },
+  });
+  expect(resolveMcpRequesterScope({ ...inherited, senderId: "automated-wake" })).toEqual(scope);
+  current = false;
+  expect(() => resolveMcpRequesterScope({ ...inherited, senderId: "later-user" })).toThrow(
+    "yield owner retired",
+  );
+});
+
+it.each(["other account", "other parent", "retired source"])(
+  "refuses completion identity substitution: %s",
+  (mode) => {
+    const first = retain("mcp-completion-original");
+    const second = retain(
+      "mcp-completion-other",
+      mode === "other account" ? { ...scope, agentAccountId: "other-company" } : scope,
+    );
+    if (mode === "other parent") {
+      second.completionRequesterSessionId = "different-parent";
+    }
+    if (mode === "retired source") {
+      subagentRuns.retireCompletionAuthority(first);
+    }
+    expect(() =>
+      captureSubagentRequesterMcpScope({
+        records: [first, second],
+        requesterSessionKey: "agent:sho:main",
+        requesterSessionId: "parent-original",
+        assertCurrent: () => {},
+      }),
+    ).toThrow(/identity changed|owner changed|retired/);
+  },
+);

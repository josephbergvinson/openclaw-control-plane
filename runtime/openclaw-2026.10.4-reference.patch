index 0000000000000000000000000000000000000000..aae79524f5af5c090d536b4b8463051f826b04ba
--- /dev/null
+++ b/src/agents/agent-tools.media-read-authority.test.ts
@@ -0,0 +1,199 @@
+// Registered native PDF/read authority composition; substitute only PDF provider/model I/O.
+import fs from "node:fs/promises";
+import path from "node:path";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { useAutoCleanupTempDirTracker } from "../../test/helpers/temp-dir.js";
+import type { OpenClawConfig } from "../config/config.js";
+import { createOpenClawCodingTools } from "./agent-tools.js";
+import type { OpenClawCodingToolsOptions } from "./agent-tools.options.js";
+import { createAgentToolsSandboxContext } from "./test-helpers/agent-tools-sandbox-context.js";
+import { createHostSandboxFsBridge } from "./test-helpers/host-sandbox-fs-bridge.js";
+import * as pdfNativeProviders from "./tools/pdf-native-providers.js";
+import { createPdfTool } from "./tools/pdf-tool.js";
+import {
+  createPdfToolInfraStub,
+  FAKE_PDF_MEDIA,
+  resetPdfToolAuthEnv,
+} from "./tools/pdf-tool.test-support.js";
+
+const tempDirs = useAutoCleanupTempDirTracker(afterEach);
+const { stubPdfToolInfra } = createPdfToolInfraStub(vi.fn());
+
+describe("assembled PDF tool read authority", () => {
+  beforeEach(() => resetPdfToolAuthEnv());
+  afterEach(() => {
+    vi.restoreAllMocks();
+    vi.unstubAllEnvs();
+  });
+
+  async function fixture(options?: {
+    senderId?: string;
+    permissionMode?: "full" | "workspace" | "guarded" | "read-only";
+    sandboxed?: boolean;
+    toolOptions?: Partial<OpenClawCodingToolsOptions>;
+  }) {
+    const root = tempDirs.make("openclaw-pdf-read-authority-");
+    const workspaceDir = path.join(root, "workspace");
+    const agentDir = path.join(root, "agent");
+    const projectDir = path.join(root, "project", "work-product");
+    const stateDir = path.join(root, "state");
+    const pdf = path.join(projectDir, "review.pdf");
+    await Promise.all(
+      [workspaceDir, agentDir, projectDir].map((dir) => fs.mkdir(dir, { recursive: true })),
+    );
+    await fs.writeFile(pdf, FAKE_PDF_MEDIA.buffer);
+    vi.stubEnv("OPENCLAW_STATE_DIR", stateDir);
+    const config: OpenClawConfig = {
+      agents: {
+        defaults: { workspace: workspaceDir, pdfModel: { primary: "anthropic/claude-opus-4-6" } },
+      },
+      tools: {
+        profile: "full",
+        allow: ["read", "pdf"],
+        fs: { workspaceOnly: false },
+        toolsBySender: { "id:guest": { deny: ["read"] } },
+      },
+    };
+    await stubPdfToolInfra(agentDir, { mockLoad: false });
+    const native = vi
+      .spyOn(pdfNativeProviders, "anthropicAnalyzePdf")
+      .mockResolvedValue("Reviewed PDF");
+    const tools = createOpenClawCodingTools({
+      config,
+      agentId: "main",
+      agentDir,
+      workspaceDir,
+      sessionKey: "agent:main:main",
+      senderId: options?.senderId ?? "owner",
+      messageProvider: "discord",
+      ...(options?.permissionMode
+        ? { sessionPermissionPolicy: { root: workspaceDir, mode: options.permissionMode } }
+        : {}),
+      ...(options?.sandboxed
+        ? {
+            sandbox: createAgentToolsSandboxContext({
+              workspaceDir,
+              fsBridge: createHostSandboxFsBridge(workspaceDir),
+            }),
+          }
+        : {}),
+      ...options?.toolOptions,
+    });
+    const tool = tools.find((entry) => entry.name === "pdf");
+    if (!tool) {
+      throw new Error("registered PDF tool missing");
+    }
+    return { tool, tools, pdf, native, config, agentDir, workspaceDir, stateDir, projectDir };
+  }
+
+  it("reads generated project PDFs with the same full-owner authority as the read tool", async () => {
+    const { tool, tools, pdf, native } = await fixture({ permissionMode: "full" });
+    expect(tools.some((entry) => entry.name === "read")).toBe(true);
+    const result = await tool.execute("review", { pdf, prompt: "Review this generated PDF." });
+    expect(result.content).toEqual([{ type: "text", text: "Reviewed PDF" }]);
+    expect(native.mock.calls[0]?.[0].pdfs[0]?.base64).toBe(
+      FAKE_PDF_MEDIA.buffer.toString("base64"),
+    );
+  });
+
+  it("does not inherit the owner's read authority for a sender denied read", async () => {
+    const { tool, tools, pdf, native } = await fixture({ senderId: "guest" });
+    expect(tools.some((entry) => entry.name === "read")).toBe(false);
+    await expect(tool.execute("review", { pdf, prompt: "Review" })).rejects.toThrow(
+      /allowed directory/i,
+    );
+    expect(native).not.toHaveBeenCalled();
+  });
+
+  it("keeps required workspace-only turns confined even with a surviving read tool", async () => {
+    const { tool, pdf, native } = await fixture({ toolOptions: { requireWorkspaceOnly: true } });
+    await expect(tool.execute("review", { pdf, prompt: "Review" })).rejects.toThrow(
+      /allowed directory/i,
+    );
+    expect(native).not.toHaveBeenCalled();
+  });
+
+  it.each(["workspace", "guarded", "read-only"] as const)(
+    "retains session %s confinement while allowing its own generated PDF",
+    async (permissionMode) => {
+      const { tool, pdf, native, workspaceDir } = await fixture({ permissionMode });
+      await expect(tool.execute("outside", { pdf, prompt: "Review" })).rejects.toThrow(
+        /allowed directory/i,
+      );
+      expect(native).not.toHaveBeenCalled();
+      const ownPdf = path.join(workspaceDir, "review.pdf");
+      await fs.copyFile(pdf, ownPdf);
+      await expect(tool.execute("own", { pdf: ownPdf, prompt: "Review" })).resolves.toMatchObject({
+        content: [{ type: "text", text: "Reviewed PDF" }],
+      });
+    },
+  );
+
+  it("keeps sandbox bridge confinement when global filesystem access is full", async () => {
+    const { tool, pdf, native } = await fixture({ sandboxed: true });
+    await expect(tool.execute("outside", { pdf, prompt: "Review" })).rejects.toThrow(
+      /outside|escapes|sandbox/i,
+    );
+    expect(native).not.toHaveBeenCalled();
+  });
+
+  it("does not expand media reads when construction omits the read tool", async () => {
+    const { tool, tools, pdf, native } = await fixture({
+      toolOptions: {
+        toolConstructionPlan: {
+          includeBaseCodingTools: false,
+          includeShellTools: false,
+          includeChannelTools: false,
+          includeOpenClawTools: true,
+          includePluginTools: false,
+        },
+      },
+    });
+    expect(tools.some((entry) => entry.name === "read")).toBe(false);
+    await expect(tool.execute("review", { pdf, prompt: "Review" })).rejects.toThrow(
+      /allowed directory/i,
+    );
+    expect(native).not.toHaveBeenCalled();
+  });
+
+  it.each(["direct", "directory-symlink", "file-symlink"])(
+    "does not promote a sibling sandbox through a %s source path",
+    async (kind) => {
+      const { tool, native, stateDir, projectDir } = await fixture();
+      const siblingDir = path.join(stateDir, "sandboxes", "another-session");
+      const siblingPdf = path.join(siblingDir, "private.pdf");
+      await fs.mkdir(siblingDir, { recursive: true });
+      await fs.writeFile(siblingPdf, FAKE_PDF_MEDIA.buffer);
+      let pdf = siblingPdf;
+      if (kind === "directory-symlink") {
+        const link = path.join(projectDir, "linked-directory");
+        await fs.symlink(siblingDir, link);
+        pdf = path.join(link, "private.pdf");
+      } else if (kind === "file-symlink") {
+        pdf = path.join(projectDir, "linked-file.pdf");
+        await fs.symlink(siblingPdf, pdf);
+      }
+      await expect(tool.execute("review", { pdf, prompt: "Review" })).rejects.toThrow(
+        /allowed directory|not safe to read/i,
+      );
+      expect(native).not.toHaveBeenCalled();
+    },
+  );
+
+  it("does not treat workspaceOnly=false alone as explicit read authority", async () => {
+    const { config, agentDir, workspaceDir, pdf, native } = await fixture();
+    const tool = createPdfTool({
+      config,
+      agentDir,
+      workspaceDir,
+      fsPolicy: { workspaceOnly: false },
+    });
+    if (!tool) {
+      throw new Error("PDF tool missing");
+    }
+    await expect(tool.execute("review", { pdf, prompt: "Review" })).rejects.toThrow(
+      /allowed directory/i,
+    );
+    expect(native).not.toHaveBeenCalled();
+  });
+});

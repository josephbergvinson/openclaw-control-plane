+        expression: `(() => {
+        const fields = ${JSON.stringify(confidentialObservationBindings())};
+        const marked = (doc) => {
+          const origin = doc.defaultView?.location.origin;
+          for (const input of doc.querySelectorAll('input')) {
+            if (fields.some((field) => field.allowedOrigins.includes(origin ?? '') &&
+              field.name === input.name && field.type === input.type)) {
+              input.setAttribute(${JSON.stringify(BROWSER_CONFIDENTIAL_FIELD_ATTRIBUTE)}, '');

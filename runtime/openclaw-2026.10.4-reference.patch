diff --git a/src/agents/tools/goal-tools.edit.test.ts b/src/agents/tools/goal-tools.edit.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ca1dfdc9b5024064fd6435c879b111ed0bcbed8b
--- /dev/null
+++ b/src/agents/tools/goal-tools.edit.test.ts
@@ -0,0 +1,308 @@
+import { Value } from "typebox/value";
+import { afterEach, describe, expect, it } from "vitest";
+import { createSessionGoal, updateSessionGoalObjective } from "../../config/sessions/goals.js";
+import {
+  loadSessionEntry,
+  patchSessionEntryCore,
+  upsertSessionEntryCore,
+} from "../../config/sessions/session-accessor.js";
+import {
+  runExclusiveSqliteSessionWrite,
+  resolveSqliteScope,
+} from "../../config/sessions/session-accessor.sqlite-scope.js";
+import { useTempSessionsFixture } from "../../config/sessions/test-helpers.js";
+import type { SessionGoalStatus } from "../../config/sessions/types.js";
+import { toToolDefinitions } from "../agent-tool-definition-adapter.js";
+import { applyCodeModeCatalog, createCodeModeTools } from "../code-mode.js";
+import {
+  createCodeModeHarness,
+  resetCodeModeTestState,
+  runUntilCompleted,
+} from "../code-mode.test-support.js";
+import { createSessionGoalUsageRun, withSessionGoalUsageRun } from "../session-goal-usage.js";
+import { createGetGoalTool, createCreateGoalTool, createUpdateGoalTool } from "./goal-tools.js";
+function createGoalTools(options: Parameters<typeof createGetGoalTool>[0]) {
+  return [createGetGoalTool(options), createCreateGoalTool(options), createUpdateGoalTool(options)];
+}
+
+describe("model goal objective edits", () => {
+  const fixture = useTempSessionsFixture("openclaw-model-goal-edit-");
+  afterEach(resetCodeModeTestState);
+  async function prepare(status: SessionGoalStatus = "active") {
+    const target = {
+      agentId: "main",
+      sessionKey: "agent:main:discord:channel:123",
+      storePath: fixture.storePath(),
+      sessionId: "session",
+      lifecycleRevision: "revision",
+      activeWriterRunId: "run",
+    };
+    await upsertSessionEntryCore(target, { ...target, updatedAt: 1, status: "running" });
+    const goal = await createSessionGoal({
+      ...target,
+      objective: "Finish the existing seven-part package",
+      tokenBudget: 1000,
+    });
+    await patchSessionEntryCore(target, (entry) => ({
+      goal: { ...entry.goal!, tokensUsed: 50, continuationTurns: 3, status },
+    }));
+    let current = true;
+    let tokens = 25;
+    const operationalRunInstance = Object.freeze({ runId: "run", instanceId: "native-operation" });
+    const run = createSessionGoalUsageRun({
+      operationalRunInstance,
+      runId: "run",
+      admissionId: "admission",
+      instanceId: "instance",
+      initialScope: target,
+      readTarget: () => target,
+      readRunTokens: () => tokens,
+      assertCurrent: () => {
+        if (!current) {
+          throw new Error("owner replaced");
+        }
+      },
+    });
+    const options = {
+      runId: "run",
+      operationalRunInstance,
+      runSessionKey: target.sessionKey,
+      agentSessionKey: "agent:main:discord:slash:456",
+      config: { session: { store: fixture.storePath() } },
+    };
+    const tools = await withSessionGoalUsageRun(run, async () => createGoalTools(options));
+    const get = tools.find((tool) => tool.name === "get_goal")!;
+    const edit = tools.find((tool) => tool.name === "update_goal")!;
+    return {
+      target,
+      goal,
+      run,
+      options,
+      get,
+      edit,
+      close: () => {
+        current = false;
+      },
+      setTokens: (next: number) => {
+        tokens = next;
+      },
+    };
+  }
+
+  it("persists a user-revised objective through the registered model adapter and native goal ledger", async () => {
+    const f = await prepare();
+    const before = loadSessionEntry(f.target)!;
+    const args = {
+      objective:
+        "Rework the existing package from the user-designated handoff; finish all seven parts and four recipes",
+      goal_id: f.goal.id,
+    };
+    expect(Value.Check(f.edit.parameters, args)).toBe(true);
+    const definition = toToolDefinitions([f.edit])[0]!;
+    const result = await definition.execute(
+      "edit-1",
+      args,
+      undefined,
+      undefined,
+      {} as Parameters<typeof definition.execute>[4],
+    );
+    expect(result.details).toMatchObject({
+      status: "updated",
+      action: "edit",
+      sessionId: f.target.sessionId,
+      goalId: f.goal.id,
+      goal: { objective: args.objective, status: "active" },
+    });
+    const after = loadSessionEntry(f.target)!;
+    expect(after.goal).toMatchObject({
+      id: before.goal!.id,
+      status: "active",
+      createdAt: before.goal!.createdAt,
+      tokensUsed: 75,
+      tokenBudget: 1000,
+      continuationTurns: 3,
+    });
+    expect(after).toMatchObject({
+      sessionId: before.sessionId,
+      status: "running",
+      activeWriterRunId: "run",
+      lifecycleRevision: "revision",
+    });
+    expect(after.goalUsage?.run?.tokens).toBe(25);
+    // A late replay must return its saved receipt, not overwrite a subsequent operator edit.
+    await updateSessionGoalObjective({ ...f.target, objective: "Later operator correction" });
+    f.setTokens(100);
+    const rebuilt = await withSessionGoalUsageRun(f.run, async () =>
+      createGoalTools(f.options).find((tool) => tool.name === "update_goal")!,
+    );
+    const replay = await rebuilt.execute("edit-1", args);
+    expect(replay.details).toMatchObject({
+      replayed: true,
+      nextAction: expect.stringContaining("Read get_goal for the current objective"),
+      goal: { objective: args.objective, tokensUsed: 75 },
+    });
+    expect(loadSessionEntry(f.target)?.goal?.objective).toBe("Later operator correction");
+    expect(loadSessionEntry(f.target)?.goal?.tokensUsed).toBe(75);
+    const conflict = await f.edit.execute("edit-1", { ...args, objective: "Different payload" });
+    expect(conflict.details).toMatchObject({
+      status: "error",
+      error: expect.stringContaining("different request"),
+    });
+  });
+
+  it("exposes and executes the objective edit through the Code Mode tool proxy", async () => {
+    const f = await prepare();
+    const harness = createCodeModeHarness();
+    const ctx = {
+      ...harness.ctx,
+      sessionKey: f.target.sessionKey,
+      sessionId: f.target.sessionId,
+      runId: "run",
+    };
+    const tools = createCodeModeTools(ctx);
+    applyCodeModeCatalog({ ...ctx, tools: [...tools, f.get, f.edit] });
+    const result = await runUntilCompleted({
+      execTool: tools[0]!,
+      waitTool: tools[1]!,
+      code: 'const current = await get_goal({}); return await update_goal({ goal_id: current.goal.id, objective: "Revise the same package using the new handoff" });',
+    });
+    expect(result).toMatchObject({
+      status: "completed",
+      value: {
+        action: "edit",
+        goal: { id: f.goal.id, objective: "Revise the same package using the new handoff" },
+      },
+    });
+    expect(loadSessionEntry(f.target)?.goal?.objective).toBe(
+      "Revise the same package using the new handoff",
+    );
+  });
+
+  it.each([
+    { objective: "Revise" },
+    { goal_id: "goal" },
+    { objective: "", goal_id: "goal" },
+    { objective: "Revise", goal_id: "goal", status: "complete" },
+    { objective: "Revise", goal_id: "goal", note: "mixed" },
+  ])("rejects incomplete or mixed edit input %j without a mutation", async (args) => {
+    const f = await prepare();
+    const before = loadSessionEntry(f.target);
+    await expect(f.edit.execute("invalid", args)).rejects.toThrow(
+      "Provide objective and goal_id together",
+    );
+    expect(loadSessionEntry(f.target)).toEqual(before);
+  });
+
+  it.each(["paused", "blocked", "budget_limited", "usage_limited"] as const)(
+    "revises an exact captured %s goal without resuming or charging it",
+    async (status) => {
+      const f = await prepare(status);
+      const result = await f.edit.execute("edit-inactive", {
+        objective: "Revised scope for later continuation",
+        goal_id: f.goal.id,
+      });
+      expect(result.details).toMatchObject({
+        status: "updated",
+        goal: { id: f.goal.id, status, tokensUsed: 50, tokenBudget: 1000, continuationTurns: 3 },
+      });
+      expect(loadSessionEntry(f.target)?.goalUsage?.run).toBeUndefined();
+    },
+  );
+
+  it("does not let an unbound model tool edit an existing session goal", async () => {
+    const f = await prepare();
+    const tool = createGoalTools(f.options).find((item) => item.name === "update_goal")!;
+    await expect(
+      tool.execute("unbound", { objective: "Revise", goal_id: f.goal.id }),
+    ).rejects.toThrow("current admitted goal is required");
+    expect(loadSessionEntry(f.target)?.goal?.objective).toBe(f.goal.objective);
+  });
+
+  it("does not capture an inactive goal from a different initial session incarnation", async () => {
+    const f = await prepare("paused");
+    const stale = createSessionGoalUsageRun({
+      operationalRunInstance: f.options.operationalRunInstance,
+      runId: "run",
+      admissionId: "admission",
+      instanceId: "instance",
+      initialScope: { ...f.target, sessionId: "stale-session" },
+      readTarget: () => f.target,
+      readRunTokens: () => 25,
+      assertCurrent: () => {},
+    });
+    const tool = await withSessionGoalUsageRun(stale, async () =>
+      createGoalTools(f.options).find((item) => item.name === "update_goal")!,
+    );
+    await expect(
+      tool.execute("stale-initial", { objective: "Revise", goal_id: f.goal.id }),
+    ).rejects.toThrow("current admitted goal is required");
+    expect(loadSessionEntry(f.target)?.goal?.objective).toBe(f.goal.objective);
+  });
+
+  it.each(["goal", "session", "lifecycle", "writer", "authority"] as const)(
+    "rejects a changed %s after waiting for the owning writer queue",
+    async (change) => {
+      const f = await prepare();
+      let release!: () => void;
+      let entered!: () => void;
+      const ready = new Promise<void>((resolve) => {
+        entered = resolve;
+      });
+      const hold = new Promise<void>((resolve) => {
+        release = resolve;
+      });
+      const barrier = runExclusiveSqliteSessionWrite(
+        resolveSqliteScope(f.target),
+        async () => {
+          entered();
+          await hold;
+        },
+        "session.goal.mutate",
+      );
+      await ready;
+      // Queue the replacement ahead of the edit, so only an in-transaction check can reject it.
+      const replacement =
+        change === "authority"
+          ? Promise.resolve().then(() => f.close())
+          : patchSessionEntryCore(f.target, (entry) =>
+              change === "goal"
+                ? { goal: { ...entry.goal!, id: "replacement" } }
+                : change === "session"
+                  ? { sessionId: "replacement" }
+                  : change === "lifecycle"
+                    ? { lifecycleRevision: "replacement" }
+                    : { activeWriterRunId: "replacement" },
+            );
+      const pending = f.edit.execute("edit-race", { objective: "Stale edit", goal_id: f.goal.id });
+      const settled = pending.then(
+        (result) => result,
+        (error: unknown) => error,
+      );
+      release();
+      await barrier;
+      await replacement;
+      const result = await settled;
+      if (change === "goal") {
+        expect(result).toMatchObject({
+          details: { status: "error", error: expect.stringContaining("Goal changed") },
+        });
+      } else {
+        expect(result).toBeInstanceOf(Error);
+      }
+      expect(loadSessionEntry(f.target)?.goal?.objective).toBe(f.goal.objective);
+    },
+  );
+
+  it("leaves ordinary reads and status-only calls on their existing semantics", async () => {
+    const f = await prepare();
+    const before = loadSessionEntry(f.target)!;
+    await f.get.execute("status-question", {});
+    expect(loadSessionEntry(f.target)).toEqual(before);
+    expect(f.edit.description).toContain("Routine follow-ups, status questions, quoted text");
+    const result = await f.edit.execute("complete", { status: "complete" });
+    expect(result.details).toMatchObject({
+      status: "updated",
+      goal: { id: f.goal.id, objective: f.goal.objective, status: "complete" },
+    });
+  });
+});

@@ -0,0 +1,479 @@
+import Foundation
+import OpenClawKit
+import Testing
+@testable import OpenClaw
+@testable import OpenClawMacCLI
+
+/// Synthetic same-sheet metadata and injected entry only; no live AX, Keychain,
+/// AppKit, defaults, Gateway, process discovery, or credential retrieval.
+@MainActor
+struct NativeCredentialSafariAutoFillTests {
+    private static let host = "11111111-1111-4111-8111-111111111111"
+    private static let existingOwners = [
+        "com.apple.SecurityAgent",
+        "com.apple.LocalAuthentication.UIAgent",
+        "com.apple.Passwords",
+        "com.apple.ScreenContinuity",
+    ]
+    private static let safari = "com.apple.Safari"
+    private static func evidence(submitTitle: String = "Sign In") -> [String] {
+        ["AutoFillAuthenticationSheet", "Cancel", submitTitle]
+    }
+
+    private static func form(submitTitle: String = "Sign In") -> [NativeCredentialPromptContext.Node] {
+        // The observed sheet label and controls require no account instruction
+        // or field contents. Account authority comes from the native binding.
+        [
+            .init(parent: nil, role: "AXWindow", subrole: "AXStandardWindow", text: []),
+            .init(parent: 0, role: "AXSheet", subrole: nil, text: ["AutoFillAuthenticationSheet"]),
+            .init(parent: 1, role: "AXTextField", subrole: "AXSecureTextField", text: []),
+            .init(parent: 1, role: "AXButton", subrole: nil, text: ["Cancel"], buttonTitle: "Cancel"),
+            .init(parent: 1, role: "AXButton", subrole: nil, text: [submitTitle], buttonTitle: submitTitle),
+        ]
+    }
+
+    private static func passwordsUnlockForm(account: String = "fixture") -> [NativeCredentialPromptContext.Node] {
+        // Observed native ancestry: nested sheets, a hosting group with the two
+        // buttons, then a hosting group containing the lock, instruction and field.
+        [
+            .init(parent: nil, role: "AXWindow", subrole: "AXStandardWindow", text: []),
+            .init(parent: 0, role: "AXSheet", subrole: nil, text: []),
+            .init(parent: 1, role: "AXSheet", subrole: nil, text: []),
+            .init(parent: 2, role: "AXGroup", subrole: "AXHostingView", text: []),
+            .init(parent: 3, role: "AXGroup", subrole: "AXHostingView", text: []),
+            .init(parent: 3, role: "AXButton", subrole: nil, text: ["Cancel"], buttonTitle: "Cancel"),
+            .init(parent: 3, role: "AXButton", subrole: nil, text: ["Unlock"], buttonTitle: "Unlock"),
+            .init(parent: 4, role: "AXImage", subrole: nil, text: ["Lock"], identifier: "lock.fill"),
+            .init(parent: 4, role: "AXStaticText", subrole: nil, text: ["Passwords Is Locked"]),
+            .init(
+                parent: 4,
+                role: "AXStaticText",
+                subrole: nil,
+                text: ["Enter the password for the user “\(account)” to unlock."]),
+            .init(parent: 4, role: "AXTextField", subrole: "AXSecureTextField", text: []),
+        ]
+    }
+
+    private static func binding(
+        account: String = "fixture", owners: [String]? = nil) throws -> NativeCredentialBinding
+    {
+        try .init(
+            alias: "mac.fixture.password",
+            kind: .macLogin,
+            account: account,
+            hostID: self.host,
+            bundleIDs: owners ?? self.existingOwners + [self.safari])
+    }
+
+    @Test(arguments: ["text", "identifier"], ["Sign In", "AutoFill"])
+    func `native Safari AutoFill sheet resolves without invented account body or values`(
+        _ labelSource: String, _ submitTitle: String) throws
+    {
+        var nodes = Self.form(submitTitle: submitTitle)
+        if labelSource == "identifier" {
+            nodes[1] = .init(
+                parent: 0, role: "AXSheet", subrole: nil, text: [], identifier: "AutoFillAuthenticationSheet")
+        }
+        let context = try #require(NativeCredentialPromptContext.resolve(nodes, bundleID: Self.safari))
+        #expect(context.field == 2)
+        #expect(context.context == 1)
+        #expect(context.submit == 4)
+        #expect(context.username?.field == nil)
+        #expect(context.evidence == Self.evidence(submitTitle: submitTitle).sorted())
+        let purpose = NativeCredentialPromptPurpose.resolve(nativeEvidence: context.evidence)
+        // Avoid referencing a new enum case so original unsupported production
+        // remains a compilable behavioral baseline for this fixture.
+        #expect(purpose != .accountAuthentication)
+        #expect(purpose != .loginKeychainAuthentication)
+        #expect(purpose != .administratorAuthentication)
+        let binding = try Self.binding()
+        #expect(binding.authorizes(
+            hostID: Self.host,
+            bundleID: Self.safari,
+            accountEvidence: context.evidence,
+            purpose: purpose,
+            localAccount: "fixture"))
+        let diagnostics = NativeCredentialPromptContext.diagnostics(
+            nodes, bundleID: Self.safari, resolved: true, axReadFailureCount: 0)
+        #expect(diagnostics.formContext?.purpose == purpose)
+    }
+
+    @Test(arguments: ["Sign In", "AutoFill"])
+    func `AutoFill purpose requires the exact native sheet and supported submit controls`(_ submitTitle: String) {
+        #expect(NativeCredentialPromptPurpose.resolve(
+            nativeEvidence: Self.evidence(submitTitle: submitTitle)) == .autoFillAuthentication)
+        for evidence in [
+            ["Cancel", submitTitle],
+            ["AutoFillAuthenticationSheet", submitTitle],
+            ["AutoFillAuthenticationSheet", "Cancel", "Help"],
+            ["AutoFillAuthenticationSheet", "Cancel", submitTitle.lowercased()],
+        ] {
+            #expect(NativeCredentialPromptPurpose.resolve(nativeEvidence: evidence) != .autoFillAuthentication)
+        }
+    }
+
+    @Test(arguments: ["fixture", "Fixture Operator"])
+    func `Safari embedded Passwords unlock binds its observed native account and controls`(_ account: String) throws {
+        let nodes = Self.passwordsUnlockForm(account: account)
+        let context = try #require(NativeCredentialPromptContext.resolve(nodes, bundleID: Self.safari))
+        #expect(context.field == 10)
+        #expect(context.context == 2)
+        #expect(context.submit == 6)
+        #expect(context.username?.field == nil)
+        #expect(context.evidence.contains("Passwords Is Locked"))
+        #expect(context.evidence.contains("Enter the password for the user “\(account)” to unlock."))
+        let purpose = NativeCredentialPromptPurpose.resolve(nativeEvidence: context.evidence)
+        #expect(purpose != .accountAuthentication)
+        #expect(purpose != .autoFillAuthentication)
+        let binding = try Self.binding()
+        #expect(binding.authorizes(
+            hostID: Self.host,
+            bundleID: Self.safari,
+            accountEvidence: context.evidence,
+            purpose: purpose,
+            localAccount: "fixture",
+            localAccountFullName: "Fixture Operator"))
+        let fullNameContext = try #require(NativeCredentialPromptContext.resolve(
+            Self.passwordsUnlockForm(account: "Fixture Operator"), bundleID: Self.safari))
+        for (principal, fullName) in [("other", "Fixture Operator"), ("fixture", "Other")] {
+            #expect(!binding.authorizes(
+                hostID: Self.host,
+                bundleID: Self.safari,
+                accountEvidence: fullNameContext.evidence,
+                localAccount: principal,
+                localAccountFullName: fullName))
+        }
+        #expect(!binding.authorizes(
+            hostID: Self.host,
+            bundleID: Self.safari,
+            accountEvidence: ["fixture", "Unlock", "Cancel"],
+            localAccount: "fixture"))
+        let diagnostics = NativeCredentialPromptContext.diagnostics(
+            nodes, bundleID: Self.safari, resolved: true, axReadFailureCount: 0)
+        #expect(diagnostics.formContext?.purpose == purpose)
+    }
+
+    @Test(arguments: [
+        "web-ancestor", "lock", "heading", "account-outside", "account-sibling", "cancel-role", "unlock-role",
+        "extra-editor", "second-password", "competing-account", "unlock-outside",
+    ])
+    func `Safari unlock cannot borrow native purpose account or controls from another form`(_ change: String) {
+        var nodes = Self.passwordsUnlockForm()
+        switch change {
+        case "web-ancestor": nodes[1] = .init(parent: 0, role: "AXWebArea", subrole: nil, text: [])
+        case "lock": nodes[7].identifier = "key.fill"
+        case "heading": nodes[8] = .init(parent: 4, role: "AXStaticText", subrole: nil, text: ["Edit Password"])
+        case "account-outside":
+            nodes[9] = .init(parent: 0, role: "AXStaticText", subrole: nil, text: nodes[9].text)

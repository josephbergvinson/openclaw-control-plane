+    private static func binding(owners: [String]? = nil) throws -> NativeCredentialBinding {
+        try .init(
+            alias: "mac.fixture.password",
+            kind: .macLogin,
+            account: "fixture",
+            hostID: self.host,
+            bundleIDs: owners ?? self.existingOwners + [self.helper])

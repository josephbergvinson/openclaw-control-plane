+    }
+    return null;
+  });
+  const resolutionError = options.resolutionError;
+  const resolveSecret = resolutionError
+    ? vi.fn(async () => {
+        throw resolutionError;
+      })
+    : vi.fn(async () => SENTINEL);
+
+  return {
+    close,
+    getPage,
+    page,
+    passwordDispose,
+    passwordFill,
+    passwordPress,
+    resolveElement,
+    resolveSecret,
+    submitClick,
+    submitDispose,
+    submitObservedValues,
+    setPageUrl(value: string) {
+      pageUrl = value;
+    },
+    setPasswordFrame(value: Frame) {
+      passwordFrame = value;
+    },
+    setPasswordOrigin(value: string) {
+      passwordMetadata = { ...passwordMetadata, origin: value };
+    },
+    setSubmitFrame(value: Frame) {
+      submitFrame = value;
+    },
+    setSubmitOrigin(value: string) {
+      submitMetadata = { ...submitMetadata, origin: value };
+    },
+  };
+}
+
+type CredentialHarness = ReturnType<typeof createCredentialHarness>;
+
+async function runSecureFill(
+  harness: CredentialHarness,
+  request: Omit<typeof REQUEST, "submit"> & { submit: boolean; submitRef?: string } = REQUEST,
+  assertCurrent?: () => void | Promise<void>,
+) {
+  runtimeMocks.getPage.mockImplementation(harness.getPage);
+  runtimeMocks.resolveElement.mockImplementation(harness.resolveElement);
+  runtimeMocks.resolveSecret.mockImplementation(harness.resolveSecret);
+  return await executeBrowserTypeSecret({
+    request,
+    cdpUrl: CDP_URL,
+    targetId: "tab-1",
+    assertCurrent,
+  });
+}
+
+async function readSecureFillError(
+  harness: CredentialHarness,
+  request: Omit<typeof REQUEST, "submit"> & { submit: boolean; submitRef?: string } = REQUEST,
+): Promise<string> {
+  try {
+    await runSecureFill(harness, request);
+    return "";
+  } catch (error) {
+    return String(error);
+  }
+}
+
+describe("browser credential native fill", () => {
+  beforeEach(() => {
+    runtimeMocks.pageState = runtimeMocks.createPageState();
+    resetBrowserCredentialBindingsForTests();
+    runtimeMocks.traceActive = false;
+    runtimeMocks.navigation
+      .mockReset()
+      .mockImplementation(
+        async (params: { action: () => Promise<unknown> }) => await params.action(),
+      );
+    configureBinding();
+  });
+
+  it("waits for the existing native observation owner before resolving and filling a draft", async () => {

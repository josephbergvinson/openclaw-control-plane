+import { afterEach, describe, expect, it, vi } from "vitest";
+import { createQueueTestRun } from "../../auto-reply/reply/queue.test-helpers.js";
+import { withQuestionCreator } from "../../auto-reply/reply/reply-run-question.test-support.js";
+import type { ReplyOperation } from "../../auto-reply/reply/reply-run-registry.js";
+import { createDeferredCore } from "../../shared/deferred.js";
+import { withoutGatewayToolCallerIdentity } from "../tools/gateway-caller-context.js";
+import { EMBEDDED_RUN_WAITERS } from "./run-state.js";
+import { clearActiveEmbeddedRun, setActiveEmbeddedRun } from "./runs.js";
+import { waitForEmbeddedRunPublication } from "./runs.publication-wait.js";
+import { createEmbeddedRunHandle, testing } from "./runs.test-support.js";
+
+afterEach(() => testing.resetActiveEmbeddedRuns());
+
+async function owner(
+  test: (operation: ReplyOperation, fingerprint: string, sessionFile: string) => Promise<void>,
+) {
+  const key = "agent:main:publication-owner";
+  const run = createQueueTestRun({ prompt: "existing work", messageId: "original" });
+  await withQuestionCreator(key, run, (operation, fingerprint) =>
+    test(operation, fingerprint, run.run.sessionFile),
+  );
+}
+function handle(fingerprint: string) {
+  return {
+    ...createEmbeddedRunHandle({
+      runId: "accepted-backing-work",
+      toolAuthorityFingerprint: fingerprint,
+    }),
+    kind: "embedded" as const,
+    cancel: vi.fn(),
+    messageInjectionV2: {
+      version: 2 as const,
+      isAvailable: () => true,
+      queueMessage: vi.fn(async () => {}),
+    },
+  };
+}
+
+describe("native embedded registration publication", () => {
+  it("subscribes before actual registered V2 publication and retires its native waiter", async () => {
+    await owner(async (operation, fingerprint, sessionFile) => {
+      operation.setPhase("running");
+      const published = vi.fn();
+      const pending = waitForEmbeddedRunPublication({
+        sessionId: operation.sessionId,
+        sessionKey: operation.key,
+        replyOperation: operation,
+        ownerReleased: operation.ownerSettlement!,
+        onRegistered: published,
+      });
+      expect(EMBEDDED_RUN_WAITERS.get(operation.sessionId)?.size).toBe(1);
+      const backend = handle(fingerprint);
+      operation.attachBackend(backend);
+      expect(published).not.toHaveBeenCalled();
+      setActiveEmbeddedRun(operation.sessionId, backend, operation.key, sessionFile, "main");
+      await expect(pending).resolves.toBe("registered");
+      expect(published).toHaveBeenCalledExactlyOnceWith(backend);
+      expect(EMBEDDED_RUN_WAITERS.has(operation.sessionId)).toBe(false);
+      clearActiveEmbeddedRun(operation.sessionId, backend, operation.key);
+    });
+  });
+  it.each(["wrong-key", "v1", "unbound"] as const)(
+    "refuses %s publication without borrowing its label",
+    async (mode) => {
+      await owner(async (operation, fingerprint, sessionFile) => {
+        operation.setPhase("running");
+        const published = vi.fn();
+        const pending = waitForEmbeddedRunPublication({
+          sessionId: operation.sessionId,
+          sessionKey: operation.key,
+          replyOperation: operation,
+          ownerReleased: operation.ownerSettlement!,
+          onRegistered: published,
+        });
+        const backend = handle(fingerprint);
+        if (mode === "v1") {
+          Object.assign(backend, { messageInjectionV2: undefined });
+        }
+        operation.attachBackend(backend);
+        const publish = () =>
+          setActiveEmbeddedRun(
+            operation.sessionId,
+            backend,
+            mode === "wrong-key" ? "agent:main:other" : operation.key,
+            sessionFile,
+            "main",
+          );
+        if (mode === "v1") {
+          publish();
+        } else {
+          withoutGatewayToolCallerIdentity(publish);
+        }
+        await expect(pending).resolves.toBe("invalidated");
+        expect(published).not.toHaveBeenCalled();
+        clearActiveEmbeddedRun(operation.sessionId, backend);
+      });
+    },
+  );
+  it.each(["released", "abort"] as const)(
+    "retires a %s waiter without any publication",
+    async (mode) => {
+      await owner(async (operation) => {
+        const released = createDeferredCore();
+        const abort = new AbortController();
+        const pending = waitForEmbeddedRunPublication({
+          sessionId: operation.sessionId,
+          sessionKey: operation.key,
+          replyOperation: operation,
+          ownerReleased: released.promise,
+          abortSignal: abort.signal,
+        });
+        if (mode === "released") {
+          released.resolve();
+        } else {
+          abort.abort();
+        }
+        if (mode === "released") {
+          await expect(pending).resolves.toBe("released");
+        } else {
+          await expect(pending).rejects.toThrow();
+        }
+        expect(EMBEDDED_RUN_WAITERS.has(operation.sessionId)).toBe(false);
+      });
+    },
+  );
+  it("rejects a replacement backend between publication and its continuation", async () => {
+    await owner(async (operation, fingerprint, sessionFile) => {
+      operation.setPhase("running");
+      const published = vi.fn();
+      const pending = waitForEmbeddedRunPublication({
+        sessionId: operation.sessionId,
+        sessionKey: operation.key,
+        replyOperation: operation,
+        ownerReleased: operation.ownerSettlement!,
+        onRegistered: published,
+      });
+      const first = handle(fingerprint);
+      operation.attachBackend(first);
+      setActiveEmbeddedRun(operation.sessionId, first, operation.key, sessionFile, "main");
+      operation.attachBackend(handle(fingerprint));
+      await expect(pending).resolves.toBe("invalidated");
+      expect(published).not.toHaveBeenCalled();
+      clearActiveEmbeddedRun(operation.sessionId, first, operation.key);
+    });
+  });
+});

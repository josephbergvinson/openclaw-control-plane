@@ -0,0 +1,36 @@
+import path from "node:path";
+import { describe, expect, it } from "vitest";
+import { createBackupResourcePlan } from "./backup-resource-inventory.js";
+
+describe("legacy shared plugin dependency backup policy", () => {
+  it("omits regenerable files but retains explicitly declared durable plugin data", async () => {
+    const stateDir = path.resolve("fixture-state-does-not-exist");
+    const root = path.join(stateDir, "plugin-runtime-deps");
+    const durable = path.join(root, "demo", "durable");
+    const plan = await createBackupResourcePlan({
+      stateDir,
+      configPaths: [],
+      oauthDirs: [],
+      workspaceDirs: [],
+      excludedWorkspaceDirs: [],
+      agentRoots: [],
+      pluginRoots: [],
+      pluginResources: [
+        {
+          pluginId: "demo",
+          disposition: "include",
+          scope: "state",
+          relativePath: "plugin-runtime-deps/demo/durable",
+        },
+      ],
+    });
+    expect(plan.isIncluded(path.join(root, "node_modules", "asset.sqlite"))).toBe(false);
+    expect(plan.isTraversable(root)).toBe(true);
+    expect(plan.isTraversable(path.join(root, "demo"))).toBe(true);
+    expect(plan.isIncluded(path.join(durable, "records.sqlite"))).toBe(true);
+    expect(
+      plan.isIncluded(path.join(stateDir, "plugin-runtime-deps-other", "records.sqlite")),
+    ).toBe(true);
+    expect(plan.pluginResourceRoots).toEqual([durable]);
+  });
+});

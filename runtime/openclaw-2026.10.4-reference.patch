index 0000000000000000000000000000000000000000..149f3e79ec96c9078be7c110ca55c3e853c46c2b
--- /dev/null
+++ b/src/agents/subagents/registry/subagent-registry-progress.live-requester.test.ts
@@ -0,0 +1,161 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import type { RequesterProgressPublication } from "../../../channels/progress-continuation.js";
+import {
+  claimAgentRunDelegatedAuthority,
+  getAgentRunContext,
+  registerAgentRunContext,
+  releaseAgentRunDelegatedAuthority,
+  resetAgentRunRegistryForTest,
+} from "../../../infra/agent-run-registry.js";
+import { bindAgentRunRequesterProgress } from "../../../infra/agent-run-requester-progress.js";
+import { createDeferredCore } from "../../../shared/deferred.js";
+import { publishActiveRequesterProgress } from "./subagent-registry-progress.runtime.js";
+import { drain, fixture, row } from "./subagent-registry-progress.test-support.js";
+
+beforeEach(resetAgentRunRegistryForTest);
+afterEach(resetAgentRunRegistryForTest);
+
+function bindRequester() {
+  const source = { channel: "discord", accountId: "bot", to: "channel:parent" };
+  const publish = vi.fn<RequesterProgressPublication["publish"]>(async (_text, assertCurrent) => {
+    assertCurrent?.();
+    return { status: "visible", messageId: "original-card" };
+  });
+  registerAgentRunContext("parent-run", {
+    sessionKey: "agent:main:discord:channel:parent",
+    sessionId: "requester",
+    agentId: "main",
+  });
+  const authority = claimAgentRunDelegatedAuthority({ runId: "parent-run", instanceId: "first" });
+  bindAgentRunRequesterProgress(authority, {
+    source,
+    publish,
+    isProgressMessageId: (id) => id === "original-card",
+  });
+  return { authority, source, publish };
+}
+
+describe("live requester child progress", () => {
+  it("keeps the foreground role restriction bound to its exact live authority", () => {
+    const parent = bindRequester();
+    const progress = getAgentRunContext("parent-run")!.requesterProgress!;
+    expect(progress.isProgressMessageId!("original-card")).toBe(true);
+    expect(progress.isProgressMessageId!("completed-final")).toBe(false);
+    releaseAgentRunDelegatedAuthority(parent.authority);
+    expect(() => progress.isProgressMessageId!("original-card")).toThrow(
+      "lost its admitted run owner",
+    );
+  });
+  it("routes two pre-yield child checkpoints to the same admitted requester card", async () => {
+    const parent = bindRequester();
+    const a = row({ completionTarget: "parent", completionRequesterSessionId: "requester" });
+    const b = row({ ...a, runId: "second-child", childSessionKey: "agent:main:subagent:second" });
+    await expect(publishActiveRequesterProgress(a, "First check passed.", () => {})).resolves.toBe(
+      true,
+    );
+    await expect(publishActiveRequesterProgress(b, "Second check passed.", () => {})).resolves.toBe(
+      true,
+    );
+    expect(parent.publish.mock.calls.map(([text]) => text)).toEqual([
+      "First check passed.",
+      "Second check passed.",
+    ]);
+  });
+
+  it.each(["session", "route", "agent"] as const)(
+    "refuses a mismatched %s without an ordinary POST",
+    async (mismatch) => {
+      const parent = bindRequester();
+      const child = row({ completionTarget: "parent", completionRequesterSessionId: "requester" });
+      if (mismatch === "session") {
+        child.completionRequesterSessionId = "replacement";
+      }
+      if (mismatch === "route") {
+        child.progressOrigin = { ...child.progressOrigin!, to: "channel:other" };
+      }
+      if (mismatch === "agent") {
+        child.requesterAgentId = "other";
+      }
+      await expect(
+        publishActiveRequesterProgress(child, "Must stay private.", () => {}),
+      ).rejects.toThrow("does not match");
+      expect(parent.publish).not.toHaveBeenCalled();
+    },
+  );
+
+  it("fences a dispatched update when the exact native requester is replaced", async () => {
+    const parent = bindRequester();
+    const entered = createDeferredCore();
+    const release = createDeferredCore();
+    parent.publish.mockImplementationOnce(async (_text, assertCurrent) => {
+      entered.resolve();
+      await release.promise;
+      assertCurrent?.();
+      return { status: "visible", messageId: "original-card" };
+    });
+    const publishing = publishActiveRequesterProgress(row(), "In flight.", () => {});
+    await entered.promise;
+    claimAgentRunDelegatedAuthority({ runId: "parent-run", instanceId: "replacement" });
+    release.resolve();
+    await expect(publishing).rejects.toThrow("lost its admitted run owner");
+    expect(parent.publish).toHaveBeenCalledOnce();
+  });
+
+  it("does not turn a missing private owner into a standalone message", async () => {
+    await expect(
+      publishActiveRequesterProgress(row({ completionTarget: "parent" }), "Checkpoint.", () => {}),
+    ).resolves.toBe(false);
+    await expect(
+      publishActiveRequesterProgress(row(), "Legacy public lane.", () => {}),
+    ).resolves.toBeUndefined();
+    await expect(
+      publishActiveRequesterProgress(
+        row({
+          completionTarget: "parent",
+          progressOrigin: { channel: "slack", to: "channel:other" },
+        }),
+        "Other channel owner.",
+        () => {},
+      ),
+    ).resolves.toBeUndefined();
+  });
+
+  it("transfers the same card to the existing retained cohort after live requester release", async () => {
+    const parent = bindRequester();
+    const f = fixture();
+    f.initial.completionTarget = "parent";
+    f.initial.completionRequesterSessionId = "requester";
+    f.publish.mockImplementation(
+      async ({ entry, checkpoint, assertCurrent }) =>
+        (await publishActiveRequesterProgress(entry, checkpoint.text, assertCurrent)) ?? false,
+    );
+    f.completed("before", "Source is checked; validation is next.");
+    await vi.waitFor(() => expect(parent.publish).toHaveBeenCalledOnce());
+    const continuation = f.owner.prepareContinuation({
+      requesterSessionKey: f.initial.requesterSessionKey,
+      requesterAgentId: "main",
+      requesterTurnRunId: "parent-run",
+      batchRunIds: [f.initial.runId],
+      operationId: "parent-run",
+    });
+    expect(
+      await continuation!.adopt({
+        ...parent.source,
+        messageId: "original-card",
+        text: "Source is checked; validation is next.",
+        snapshot: { lines: ["Source is checked; validation is next."] },
+      }),
+    ).toBe(true);
+    continuation!.close();
+    releaseAgentRunDelegatedAuthority(parent.authority);
+    f.completed("after", "Validation passed; final review is next.");
+    await vi.waitFor(() => expect(f.edit).toHaveBeenCalledOnce());
+    expect(f.edit.mock.calls[0]![0].messageId).toBe("original-card");
+    expect(parent.publish).toHaveBeenCalledOnce();
+    f.retire();
+    f.completed("late", "Late retired update.");
+    await drain();
+    expect(f.edit).toHaveBeenCalledOnce();
+    await f.owner.reset();
+  });
+});

index 0000000000000000000000000000000000000000..2b7098d3706c4f17d531c44c579f9bf82066d6f4
--- /dev/null
+++ b/extensions/discord/src/actions/handle-action.voice.ts
@@ -0,0 +1,64 @@
+import { jsonResult, readStringParam } from "openclaw/plugin-sdk/agent-runtime";
+import type { ChannelMessageActionContext } from "openclaw/plugin-sdk/channel-contract";
+import { resolveDiscordAccount } from "../accounts.js";
+import { resolveDiscordVoiceEnabled } from "../voice/config.js";
+import { getDiscordVoiceManager } from "../voice/transcripts-source.js";
+
+type Context = Pick<
+  ChannelMessageActionContext,
+  | "action"
+  | "params"
+  | "cfg"
+  | "accountId"
+  | "requesterAccountId"
+  | "requesterSenderId"
+  | "senderIsOwner"
+  | "toolContext"
+  | "assertDirectAdapterHandoff"
+>;
+
+export async function handleDiscordVoiceAction(ctx: Context) {
+  const account = resolveDiscordAccount({
+    cfg: ctx.cfg,
+    accountId: ctx.accountId ?? readStringParam(ctx.params, "accountId"),
+  });
+  const assertAuthority = ctx.assertDirectAdapterHandoff;
+  if (!assertAuthority) {
+    throw new Error("Discord voice controls require an active authorized request.");
+  }
+  assertAuthority();
+  const provider = ctx.toolContext?.currentChannelProvider?.trim().toLowerCase();
+  const senderId = provider === "discord" ? ctx.requesterSenderId?.trim() : undefined;
+  if (provider === "discord") {
+    if (!senderId || ctx.requesterAccountId !== account.accountId) {
+      throw new Error(
+        "Discord voice controls require the trusted sender and originating bot account.",
+      );
+    }
+  } else if (provider || ctx.senderIsOwner !== true) {
+    throw new Error("Discord voice controls require a trusted Discord sender or local owner.");
+  }
+  if (!account.enabled || !resolveDiscordVoiceEnabled(account.config.voice)) {
+    throw new Error("Discord voice is disabled for this account.");
+  }
+  const manager = getDiscordVoiceManager(account.accountId);
+  if (!manager) {
+    throw new Error("Discord voice manager is not available yet.");
+  }
+  return jsonResult(
+    await manager.controlVoice({
+      action: ctx.action === "voice-join" ? "join" : "leave",
+      guildId: readStringParam(ctx.params, "guildId", { required: true }),
+      channelId: readStringParam(ctx.params, "channelId", {
+        required: ctx.action === "voice-join",
+      }),
+      ...(senderId ? { senderId } : {}),
+      assertCurrent: () => {
+        assertAuthority();
+        if (getDiscordVoiceManager(account.accountId) !== manager) {
+          throw new Error("Discord voice manager changed. Please retry.");
+        }
+      },
+    }),
+  );
+}

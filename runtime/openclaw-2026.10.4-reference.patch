index 0000000000000000000000000000000000000000..36d9797fa4093ea51573b78ad4b986cc2c2cf1ef
--- /dev/null
+++ b/src/transcripts/configured-capture.ts
@@ -0,0 +1,131 @@
+import { resolveStateDir } from "../config/paths.js";
+import type { OpenClawConfig } from "../config/types.openclaw.js";
+import { wrapCurrentPluginInstance } from "../plugins/plugin-instance-scope.js";
+import { createTranscriptsStore, stopTranscriptCapture } from "./capture-operations.js";
+import { activeSessions } from "./capture-startup.js";
+import { startTranscripts, type TranscriptsLogger } from "./capture.js";
+import type { TranscriptSessionDescriptor, TranscriptSourceLocator } from "./provider-types.js";
+import { transcriptSessionSelector } from "./store.js";
+import type { TranscriptsSummary } from "./summary.js";
+
+/** A native lifecycle can finish only the exact capture it admitted. */
+export type ConfiguredTranscriptCapture = {
+  readonly session: TranscriptSessionDescriptor;
+  finish: (options?: {
+    /** Source release precedes potentially slow notes; it does not imply notes are saved. */
+    onCaptureStopped?: () => void;
+    stoppedAt?: string;
+  }) => Promise<TranscriptsSummary | undefined>;
+};
+
+export type ConfiguredTranscriptCaptureParams = {
+  config: OpenClawConfig;
+  source: TranscriptSourceLocator;
+  abortSignal: AbortSignal;
+  logger: TranscriptsLogger;
+  stateDir?: string;
+  title?: string;
+};
+
+/** Reuse native admission, append drainage, provider cleanup and guarded summary writes. */
+export async function startConfiguredTranscriptCapture(
+  params: ConfiguredTranscriptCaptureParams,
+): Promise<ConfiguredTranscriptCapture> {
+  const ctx = {
+    config: params.config,
+    stateDir: params.stateDir ?? resolveStateDir(),
+    logger: params.logger,
+  };
+  const store = createTranscriptsStore(ctx);
+  const lifecycleToken = Symbol("configured-transcript-capture");
+  const result = await startTranscripts({
+    ctx,
+    store,
+    rawParams: { ...params.source, title: params.title },
+    abortSignal: params.abortSignal,
+    configuredLifecycle: true,
+    lifecycleToken,
+  });
+  const candidate = activeSessions.get(result.session.sessionId);
+  const admitted = candidate?.lifecycleToken === lifecycleToken ? candidate : undefined;
+  let finishing: Promise<TranscriptsSummary | undefined> | undefined;
+  let captureStopped = false;
+  const stoppedListeners = new Set<() => void>();
+  const notify = (listener: () => void) => {
+    try {
+      listener();
+    } catch {
+      params.logger.warn("transcripts capture-stopped observer failed");
+    }
+  };
+  const notifyStopped = () => {
+    captureStopped = true;
+    for (const listener of stoppedListeners) {
+      notify(listener);
+    }
+    stoppedListeners.clear();
+  };
+  return wrapCurrentPluginInstance({
+    get session() {
+      return admitted?.session ?? result.session;
+    },
+    finish(options) {
+      const listener = options?.onCaptureStopped;
+      if (listener) {
+        if (captureStopped) {
+          notify(listener);
+        } else {
+          stoppedListeners.add(listener);
+        }
+      }
+      finishing ??= (async () => {
+        if (!admitted) {
+          notifyStopped();
+          // Inline provider termination already passed native finalization.
+          return result.status === "ended"
+            ? (await store.readSummary(result.session)).summary
+            : undefined;
+        }
+        if (admitted.finalization) {
+          notifyStopped();
+          return (await admitted.finalization.released).summary;
+        }
+        if (activeSessions.get(admitted.session.sessionId) !== admitted) {
+          notifyStopped();
+          return undefined;
+        }
+        if (options?.stoppedAt && !admitted.session.stoppedAt) {
+          admitted.session = { ...admitted.session, stoppedAt: options.stoppedAt };
+        }
+        const stopped = await stopTranscriptCapture({
+          ctx,
+          store,
+          onCaptureStopped: notifyStopped,
+          selection: {
+            session: admitted.session,
+            selector: transcriptSessionSelector(admitted.session),
+            activeCandidate: admitted,
+            selectedActive: admitted,
+            historicalRevision: undefined,
+          },
+        });
+        if (stopped.status === "skipped" && stopped.reason !== "inactive") {
+          throw new Error(
+            `Configured transcript capture is still ${stopped.reason}; retry finish after cleanup.`,
+          );
+        }
+        notifyStopped();
+        return stopped.status === "stopped" ? stopped.summary : undefined;
+      })().catch((error: unknown) => {
+        // A failed stop or canonical summary write retains the native retry owner.
+        finishing = undefined;
+        throw error;
+      });
+      return finishing.finally(() => {
+        if (listener) {
+          stoppedListeners.delete(listener);
+        }
+      });
+    },
+  });
+}

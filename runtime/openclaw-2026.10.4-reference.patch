@@ -0,0 +1,128 @@
+import { describe, expect, it } from "vitest";
+import {
+  buildSubagentRecallResult,
+  buildTimeoutRecallResult,
+  readMemoryToolResultEvidence,
+} from "./transcript-result.js";
+import {
+  appendMemoryToolResultText,
+  formatMemoryToolResultText,
+  resolveTranscriptReadLimits,
+  type MemoryToolTexts,
+} from "./transcript.js";
+
+const retrieved = "Retrieved memory_get result:\nThe preferred reminder app is Example Reminders.";
+
+describe("completed memory tool evidence", () => {
+  it("keeps only permitted model-visible content, excluding private runtime details", () => {
+    const evidence = readMemoryToolResultEvidence({
+      toolName: "memory_get",
+      toolsAllow: ["memory_get"],
+      isError: false,
+      result: {
+        content: [
+          {
+            type: "text",
+            text: JSON.stringify({ path: "memory/preferences.md", text: "Example Reminders" }),
+          },
+        ],
+        details: { text: "runtime-only-private-value", token: "runtime-only-secret" },
+      },
+    });
+    expect(evidence.hasUsableMemoryResult).toBe(true);
+    expect(evidence.modelVisibleEvidence?.text).toContain("Example Reminders");
+    expect(evidence.modelVisibleEvidence?.text).toContain("memory/preferences.md");
+    expect(evidence.modelVisibleEvidence?.text).not.toContain("runtime-only");
+  });
+
+  it.each(["disallowed", "failed", "details-only", "unavailable"] as const)(
+    "does not recover %s output",
+    (mode) => {
+      const evidence = readMemoryToolResultEvidence({
+        toolName: "memory_get",
+        toolsAllow: mode === "disallowed" ? [] : ["memory_get"],
+        isError: mode === "failed",
+        result: {
+          content:
+            mode === "details-only"
+              ? []
+              : [{ type: "text", text: JSON.stringify({ text: "fixture-record" }) }],
+          details: {
+            text: "details-only-value",
+            ...(mode === "unavailable" ? { unavailable: true } : {}),
+          },
+        },
+      });
+      expect(evidence.modelVisibleEvidence).toBeUndefined();
+    },
+  );
+
+  it("bounds all accumulated text and retains a later completed get before search snippets", () => {
+    let texts: MemoryToolTexts = {};
+    texts = appendMemoryToolResultText(texts, {
+      toolName: "memory_search",
+      text: "😀".repeat(32_000),
+    });
+    texts = appendMemoryToolResultText(texts, { toolName: "memory_get", text: retrieved });
+    const text = formatMemoryToolResultText(texts) ?? "";
+    expect(text.startsWith(retrieved)).toBe(true);
+    expect(text.length).toBeLessThanOrEqual(resolveTranscriptReadLimits().maxChars);
+    expect(text).not.toMatch(
+      /[\uD800-\uDBFF](?![\uDC00-\uDFFF])|(?<![\uD800-\uDBFF])[\uDC00-\uDFFF]/u,
+    );
+  });
+
+  it("recovers a summarizer failure from real retrieval while respecting an explicit successful NONE", () => {
+    const params = {
+      subagentResult: { rawReply: "NONE", memoryToolText: retrieved, hasUsableMemoryResult: true },
+      elapsedMs: 1,
+      maxSummaryChars: 220,
+    };
+    expect(buildSubagentRecallResult(params).status).toBe("no_relevant_memory");
+    expect(
+      buildSubagentRecallResult({
+        ...params,
+        subagentResult: { ...params.subagentResult, resultStatus: "failed" },
+      }),
+    ).toMatchObject({
+      status: "ok",
+      rawReply: retrieved,
+      summary: expect.stringContaining("Example Reminders"),
+    });
+    expect(
+      buildSubagentRecallResult({
+        ...params,
+        subagentResult: {
+          ...params.subagentResult,
+          resultStatus: "failed",
+          hasUnavailableMemorySearchResult: true,
+        },
+      }).status,
+    ).toBe("failed");
+  });
+
+  it("recovers a settled timeout without accepting failed cleanup or unavailable memory", async () => {
+    const params = {
+      elapsedMs: 10,
+      maxSummaryChars: 80,
+      transcriptSources: [],
+      toolsAllow: ["memory_get"],
+      hasUsableMemoryResult: true,
+      memoryToolText: retrieved,
+    };
+    expect(await buildTimeoutRecallResult(params)).toMatchObject({
+      status: "timeout_partial",
+      summary: expect.stringContaining("Example Reminders"),
+    });
+    for (const blocked of [
+      { cleanupFailed: true },
+      { hasUnavailableMemorySearchResult: true },
+      { hasUsableMemoryResult: false },
+    ]) {
+      expect(await buildTimeoutRecallResult({ ...params, ...blocked })).toMatchObject({
+        status: "timeout",
+        summary: null,
+      });
+    }
+  });
+});

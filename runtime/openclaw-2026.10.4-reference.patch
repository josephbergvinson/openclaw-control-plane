+import { describe, expect, it } from "vitest";
+import {
+  assertMcpRequesterScopeMatches,
+  normalizeMcpRequesterScope,
+  resolveMcpRequesterScope,
+} from "./mcp-requester-scope.js";
+
+const scope = {
+  requesterSenderId: "owner-a",
+  agentAccountId: "company-a",
+  messageChannel: "discord",
+};
+
+describe("original requester credential partition", () => {
+  it("preserves the verified original tuple instead of an automated sender", () => {
+    expect(
+      resolveMcpRequesterScope({
+        senderId: "automation",
+        agentAccountId: "other",
+        mcpRequesterScope: scope,
+        mcpRequesterScopeAssertCurrent: () => {},
+      }),
+    ).toEqual(scope);
+  });
+  it.each(["missing", "revoked", "invalid", "orphan-assert"])(
+    "never falls back after %s inherited identity",
+    (mode) => {
+      expect(() =>
+        resolveMcpRequesterScope({
+          senderId: "another-user",
+          ...(mode !== "orphan-assert"
+            ? { mcpRequesterScope: mode === "invalid" ? { ...scope, agentAccountId: " " } : scope }
+            : {}),
+          ...(mode !== "missing"
+            ? {
+                mcpRequesterScopeAssertCurrent: () => {
+                  if (mode === "revoked") {
+                    throw new Error("source retired");
+                  }
+                },
+              }
+            : {}),
+        }),
+      ).toThrow();
+    },
+  );
+  it("does not merge incomplete stored tuples with a later account", () => {
+    expect(normalizeMcpRequesterScope({ ...scope, messageChannel: " " })).toBeUndefined();
+    expect(() =>
+      assertMcpRequesterScopeMatches(scope, { ...scope, agentAccountId: "company-b" }),
+    ).toThrow("identity changed");
+  });
+
+  it.each(["requesterSenderId", "agentAccountId", "messageChannel"] as const)(
+    "reports only the changed %s field and static comparison stage",
+    (field) => {
+      expect(() =>
+        assertMcpRequesterScopeMatches(
+          { ...scope, [field]: "private-current-value" },
+          { ...scope, [field]: "private-captured-value" },
+          "completion-record",
+        ),
+      ).toThrowError(
+        new Error(`MCP requester task identity changed (stage=completion-record; fields=${field})`),
+      );
+    },
+  );
+
+  it("retains the default prefix and identifies every missing identity field without values", () => {
+    expect(() => assertMcpRequesterScopeMatches(undefined, scope)).toThrowError(
+      new Error(
+        "MCP requester task identity changed (stage=unspecified; fields=requesterSenderId,agentAccountId,messageChannel)",
+      ),
+    );
+  });
+
+  it("accepts unchanged and absent tuples at every diagnostic stage", () => {
+    for (const stage of [
+      "unspecified",
+      "completion-record",
+      "harness-source",
+      "acquired-runtime",
+      "queued",
+      "spawn",
+      "attempt",
+      "connect-refresh",
+    ] as const) {
+      expect(() => assertMcpRequesterScopeMatches(scope, { ...scope }, stage)).not.toThrow();
+      expect(() => assertMcpRequesterScopeMatches(undefined, undefined, stage)).not.toThrow();
+    }
+  });
+});
diff --git a/src/agents/mcp-requester-scope.ts b/src/agents/mcp-requester-scope.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e9d1e52f17430887c2c5e1a1b8a4464921d2dec6
--- /dev/null
+++ b/src/agents/mcp-requester-scope.ts
@@ -0,0 +1,88 @@
+import { normalizeOptionalString } from "@openclaw/normalization-core/string-coerce";
+import type { SessionMcpRequesterScope } from "./agent-bundle-mcp-types.js";
+
+/** Credential identity is independent of automated input attribution and tool permissions. */
+export type McpRequesterScopeContext = {
+  mcpRequesterScope?: SessionMcpRequesterScope;
+  mcpRequesterScopeAssertCurrent?: () => void;
+};
+
+/** A private stored/transport tuple contains identity only, never credentials or a grant. */
+export function normalizeMcpRequesterScope(
+  value: SessionMcpRequesterScope | undefined,
+): SessionMcpRequesterScope | undefined {
+  const requesterSenderId = normalizeOptionalString(value?.requesterSenderId);
+  const agentAccountId = normalizeOptionalString(value?.agentAccountId);
+  const messageChannel = normalizeOptionalString(value?.messageChannel);
+  if (
+    (value?.agentAccountId !== undefined && !agentAccountId) ||
+    (value?.messageChannel !== undefined && !messageChannel)
+  ) {
+    return undefined;
+  }
+  return requesterSenderId
+    ? {
+        requesterSenderId,
+        ...(agentAccountId ? { agentAccountId } : {}),
+        ...(messageChannel ? { messageChannel } : {}),
+      }
+    : undefined;
+}
+
+/** Never substitute a later sender when an inherited task's authority has expired. */
+export function resolveMcpRequesterScope(
+  params: McpRequesterScopeContext & {
+    senderId?: string | null;
+    agentAccountId?: string;
+    messageChannel?: string;
+    messageProvider?: string;
+  },
+): SessionMcpRequesterScope | undefined {
+  if (params.mcpRequesterScope !== undefined) {
+    const scope = normalizeMcpRequesterScope(params.mcpRequesterScope);
+    if (!scope || !params.mcpRequesterScopeAssertCurrent) {
+      throw new Error("MCP requester task authority is unavailable");
+    }
+    params.mcpRequesterScopeAssertCurrent();
+    return scope;
+  }
+  if (params.mcpRequesterScopeAssertCurrent) {
+    throw new Error("MCP requester task identity is unavailable");
+  }
+  return params.senderId
+    ? {
+        requesterSenderId: params.senderId,
+        agentAccountId: params.agentAccountId,
+        messageChannel: params.messageChannel ?? params.messageProvider,
+      }
+    : undefined;
+}
+
+export function assertMcpRequesterScopeMatches(
+  current: SessionMcpRequesterScope | undefined,
+  captured: SessionMcpRequesterScope | undefined,
+  stage:
+    | "unspecified"
+    | "completion-record"
+    | "harness-source"
+    | "acquired-runtime"
+    | "queued"
+    | "spawn"
+    | "attempt"
+    | "connect-refresh" = "unspecified",
+): void {
+  if (
+    current?.requesterSenderId !== captured?.requesterSenderId ||
+    current?.agentAccountId !== captured?.agentAccountId ||
+    current?.messageChannel !== captured?.messageChannel
+  ) {
+    const fields = [
+      current?.requesterSenderId !== captured?.requesterSenderId ? "requesterSenderId" : undefined,
+      current?.agentAccountId !== captured?.agentAccountId ? "agentAccountId" : undefined,
+      current?.messageChannel !== captured?.messageChannel ? "messageChannel" : undefined,
+    ].filter((field) => field !== undefined);
+    throw new Error(
+      `MCP requester task identity changed (stage=${stage}; fields=${fields.join(",")})`,
+    );
+  }
+}

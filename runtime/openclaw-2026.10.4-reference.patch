+async function startLocalResponses(workspace: string) {
+  const requests: RecordValue[] = [];
+  const errors: unknown[] = [];
+  const pending = new Set<Promise<void>>();
+  const server = http.createServer((req, res) => {
+    const chunks: Buffer[] = [];
+    let length = 0;
+    req.on("data", (part: Buffer) => {
+      length += part.length;
+      if (length <= MAX_BODY_BYTES) {
+        chunks.push(part);
+      }
+    });
+    req.on("end", () => {
+      const work = (async () => {
+        try {
+          expect(length).toBeLessThanOrEqual(MAX_BODY_BYTES);
+          const body: unknown = JSON.parse(Buffer.concat(chunks).toString("utf8"));
+          if (!record(body)) {
+            throw new Error("Invalid local Responses fixture request");
+          }
+          requests.push(body);
+          const source = JSON.stringify(body.input);
+          if (source.includes(SECOND)) {
+            res.writeHead(400, { "content-type": "application/json" }).end(
+              JSON.stringify({
+                error: {
+                  message: "Deliberate later native segment failure",
+                  type: "invalid_request_error",
+                  code: "native_memory_fixture_failure",
+                },
+              }),
+            );
+            return;
+          }
+          expect(source).toContain(FIRST);
+          const outputs =
+            Array.isArray(body.input) &&
+            body.input.some((item) => record(item) && item.type === "function_call_output");
+          const events: unknown[] = [
+            { type: "response.created", response: { id: `local-${requests.length}` } },
+          ];
+          if (!outputs) {
+            const selected = toolSelection(body.tools);
+            for (const [call_id, destination, content] of [
+              ["outside-call", "outside.md", "must be denied"],
+              ["save-call", "memory/native-preserved.md", NOTE],
+            ]) {
+              events.push({
+                type: "response.output_item.done",
+                item: {
+                  type: "function_call",
+                  id: call_id,
+                  call_id,
+                  ...selected,
+                  arguments: JSON.stringify({ path: destination, content }),
+                },
+              });
+            }
+          } else {
+            expect(
+              await fs.readFile(path.join(workspace, "memory/native-preserved.md"), "utf8"),
+            ).toBe(NOTE);
+            await expect(fs.stat(path.join(workspace, "outside.md"))).rejects.toMatchObject({
+              code: "ENOENT",
+            });
+            events.push({
+              type: "response.output_item.done",
+              item: {
+                type: "message",
+                role: "assistant",
+                id: "silent-result",
+                content: [{ type: "output_text", text: "NO_REPLY" }],
+              },
+            });
+          }
+          events.push({
+            type: "response.completed",
+            response: {
+              id: `local-${requests.length}`,
+              usage: { input_tokens: 10, output_tokens: 1, total_tokens: 11 },
+            },
+          });
+          res.writeHead(200, { "content-type": "text/event-stream", connection: "close" });
+          res.end(events.map((event) => `data: ${JSON.stringify(event)}\n\n`).join(""));
+        } catch (error) {
+          errors.push(error);
+          res.writeHead(500).end();
+        }
+      })();
+      pending.add(work);
+      void work.finally(() => pending.delete(work));
+    });
+  });
+  await new Promise<void>((resolve) => {
+    server.listen(0, "127.0.0.1", resolve);
+  });
+  const address = server.address();
+  if (!address || typeof address === "string") {
+    throw new Error("Missing owned Responses fixture port");
+  }
+  return {
+    requests,
+    errors,
+    url: `http://127.0.0.1:${address.port}/v1/responses`,
+    close: async () => {
+      server.closeAllConnections();
+      await Promise.all(pending);
+      await new Promise<void>((resolve) => {
+        server.close(() => resolve());
+      });
+    },
+  };
+}

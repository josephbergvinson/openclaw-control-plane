+    await expect(
+      handleDiscordAction(
+        { action: "roleDelete", guildId: "guild", roleId: "role", senderUserId: "sender" },
+        { channels: { discord: { token: "synthetic", actions: { roles: false } } } },
+      ),
+    ).rejects.toThrow("role changes are disabled");
+    expect(mocks.create).not.toHaveBeenCalled();
+    expect(mocks.remove).not.toHaveBeenCalled();
+  });
+  it("checks the sender's role hierarchy before native deletion", async () => {
+    mocks.hierarchy.mockResolvedValueOnce(false);
+    await expect(
+      handleDiscordAction(
+        { action: "roleDelete", guildId: "guild", roleId: "role", senderUserId: "sender" },
+        cfg,
+      ),
+    ).rejects.toThrow("cannot manage the requested role");
+    expect(mocks.remove).not.toHaveBeenCalled();
+    await handleDiscordAction(
+      { action: "roleDelete", guildId: "guild", roleId: "role", senderUserId: "sender" },
+      cfg,
+    );
+    expect(mocks.remove).toHaveBeenCalledOnce();
+  });

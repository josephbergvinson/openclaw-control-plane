new file mode 100644
index 0000000000000000000000000000000000000000..59cd862ff208690463eeac5fb64316f581fc5ba2
--- /dev/null
+++ b/extensions/discord/src/voice/voice-following-pending-join.test.ts
@@ -0,0 +1,179 @@
+import { createDeferred } from "openclaw/plugin-sdk/extension-shared";
+import { withinTest } from "openclaw/plugin-sdk/test-fixtures";
+import { defineDiscordVoiceTests } from "./voice-test-harness.test-support.js";
+import { voiceTestMocks } from "./voice-test-mocks.test-support.js";
+
+defineDiscordVoiceTests(
+  ({
+    expect,
+    it,
+    createConnectionMock,
+    joinVoiceChannelMock,
+    entersStateMock,
+    createClient,
+    createFollowManager,
+    expectConnectedStatus,
+    getVoiceFollowing,
+    updateVoiceState,
+  }) => {
+    const observeSecondFollow = () => {
+      const observed = createDeferred<void>();
+      const previous = voiceTestMocks.loggerInfoMock.getMockImplementation();
+      let count = 0;
+      voiceTestMocks.loggerInfoMock.mockImplementation((...args) => {
+        previous?.(...args);
+        if (args[0] === "discord voice: following user guild=g1 user=u-owner channel=1001") {
+          count += 1;
+          if (count === 2) {
+            observed.resolve();
+          }
+        }
+      });
+      return {
+        promise: observed.promise,
+        restore: () => {
+          if (previous) {
+            voiceTestMocks.loggerInfoMock.mockImplementation(previous);
+          } else {
+            voiceTestMocks.loggerInfoMock.mockReset();
+          }
+        },
+      };
+    };
+
+    it("keeps the pending followed-user join for duplicate same-room observations", async ({
+      signal,
+    }) => {
+      const connection = createConnectionMock();
+      joinVoiceChannelMock.mockReturnValueOnce(connection);
+      const entered = createDeferred<void>();
+      const ready = createDeferred<undefined>();
+      entersStateMock.mockImplementationOnce(async () => {
+        entered.resolve();
+        return await ready.promise;
+      });
+      const followed = observeSecondFollow();
+      const manager = createFollowManager();
+      let joining: Promise<void> | undefined;
+      let repeated: Promise<void> | undefined;
+      try {
+        joining = updateVoiceState(manager, "u-owner", "1001");
+        await withinTest(entered.promise, signal);
+        repeated = updateVoiceState(manager, "u-owner", "1001");
+        await withinTest(followed.promise, signal);
+        ready.resolve(undefined);
+        await withinTest(Promise.all([joining, repeated]), signal);
+        expect(joinVoiceChannelMock).toHaveBeenCalledOnce();
+        expect(connection.destroy).not.toHaveBeenCalled();
+        expectConnectedStatus(manager, "1001");
+      } finally {
+        ready.resolve(undefined);
+        try {
+          await Promise.allSettled([joining, repeated]);
+          await manager.destroy();
+        } finally {
+          followed.restore();
+        }
+      }
+    });
+
+    for (const stale of ["move", "departure"] as const) {
+      it(`drops an older REST ${stale} after a newer same-room Gateway observation`, async ({
+        signal,
+      }) => {
+        const connection = createConnectionMock();
+        joinVoiceChannelMock.mockReturnValueOnce(connection);
+        const requested = createDeferred<void>();
+        const response = createDeferred<unknown>();
+        const client = createClient();
+        const manager = createFollowManager({}, client, { guilds: { g1: {} } });
+        let polling: Promise<void> | undefined;
+        try {
+          await updateVoiceState(manager, "u-owner", "1001");
+          client.rest.get.mockImplementationOnce(() => {
+            requested.resolve();
+            return response.promise;
+          });
+          polling = manager.autoJoin();
+          await withinTest(requested.promise, signal);
+          await updateVoiceState(manager, "u-owner", "1001");
+          if (stale === "departure") {
+            response.reject(new Error("Unknown Voice State"));
+          } else {
+            response.resolve({ guild_id: "g1", user_id: "u-owner", channel_id: "1002" });
+          }
+          await withinTest(polling, signal);
+          expect(joinVoiceChannelMock).toHaveBeenCalledOnce();
+          expect(connection.destroy).not.toHaveBeenCalled();
+          expectConnectedStatus(manager, "1001");
+          expect(getVoiceFollowing(manager).followedUserChannels.get("g1:u-owner")).toEqual({
+            guildId: "g1",
+            channelId: "1001",
+          });
+        } finally {
+          response.resolve(undefined);
+          await Promise.allSettled([polling]);
+          await manager.destroy();
+        }
+      });
+    }
+
+    it("keeps the newer followed-user row when an earlier join fails before a queued retry", async ({
+      signal,
+    }) => {
+      const firstConnection = createConnectionMock();
+      const secondConnection = createConnectionMock();
+      joinVoiceChannelMock
+        .mockReturnValueOnce(firstConnection)
+        .mockReturnValueOnce(secondConnection);
+      const firstEntered = createDeferred<void>();
+      const firstReady = createDeferred<undefined>();
+      const secondEntered = createDeferred<void>();
+      const secondReady = createDeferred<undefined>();
+      entersStateMock.mockImplementationOnce(async () => {
+        firstEntered.resolve();
+        return await firstReady.promise;
+      });
+      entersStateMock.mockImplementationOnce(async () => {
+        secondEntered.resolve();
+        return await secondReady.promise;
+      });
+      const followed = observeSecondFollow();
+      const manager = createFollowManager();
+      let joining: Promise<void> | undefined;
+      let repeated: Promise<void> | undefined;
+      try {
+        joining = updateVoiceState(manager, "u-owner", "1001");
+        await withinTest(firstEntered.promise, signal);
+        repeated = updateVoiceState(manager, "u-owner", "1001");
+        await withinTest(followed.promise, signal);
+        firstReady.reject(new Error("first voice readiness failed"));
+        await withinTest(joining, signal);
+        await withinTest(secondEntered.promise, signal);
+        expect(getVoiceFollowing(manager).followedUserChannels.get("g1:u-owner")).toEqual({
+          guildId: "g1",
+          channelId: "1001",
+        });
+        secondReady.resolve(undefined);
+        await withinTest(repeated, signal);
+        expect(joinVoiceChannelMock).toHaveBeenCalledTimes(2);
+        expect(firstConnection.destroy).toHaveBeenCalledOnce();
+        expect(secondConnection.destroy).not.toHaveBeenCalled();
+        expectConnectedStatus(manager, "1001");
+        expect(getVoiceFollowing(manager).followedUserChannels.get("g1:u-owner")).toEqual({
+          guildId: "g1",
+          channelId: "1001",
+        });
+      } finally {
+        firstReady.resolve(undefined);
+        secondReady.resolve(undefined);
+        try {
+          await Promise.allSettled([joining, repeated]);
+          await manager.destroy();
+        } finally {
+          followed.restore();
+        }
+      }
+    });
+  },
+);

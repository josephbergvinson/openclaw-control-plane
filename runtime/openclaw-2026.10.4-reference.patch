+import type { RuntimeEnv } from "../runtime.js";
+
+/** Record a restoration refusal without replacing the caller's service or cleanup owner. */
+export function recordDoctorGatewayRestorationRefusal(params: {
+  error: GatewayServiceAuthorityError;
+  serviceEnv: NodeJS.ProcessEnv;
+  servicePort?: number;
+  formatInstallCommand: (env: NodeJS.ProcessEnv, port?: number) => string;
+  failureFacts: UpdateFailureFact[];
+  warnings: string[];
+  runtime: Pick<RuntimeEnv, "error">;
+}): void {
+  const { error, serviceEnv, servicePort, formatInstallCommand, failureFacts, warnings, runtime } =
+    params;
+  const outcome = error.outcome ?? "recovery-pending";
+  const recovery =
+    outcome === "unchanged"
+      ? "The previous service definition was left unchanged."
+      : outcome === "restored"
+        ? "The previous service definition was restored from its captured backup."
+        : "Restoration was not verified; inspect the current service before replacing it.";
+  const message = `Doctor could not finish Gateway installation or activation under its maintenance authority (${outcome}). ${recovery} Run \`${formatCliCommand("openclaw gateway status --deep", serviceEnv)}\`; after the active maintenance or update finishes, run \`${formatInstallCommand(serviceEnv, servicePort)}\` from the active CLI. Reason: ${error.message}`;
+  failureFacts.push(
+    createUpdateFailureFact(
+      {
+        check: "gateway-restoration",
+        code: `${error.code}-${outcome}`,
+        message,
+      },
+      serviceEnv,
+    ),
+  );
+  warnings.push(message);
+  runtime.error(message);
+  if (outcome === "recovery-pending") {
+    throw new UpdateDoctorError(message, failureFacts, { cause: error });
+  }
+}
 

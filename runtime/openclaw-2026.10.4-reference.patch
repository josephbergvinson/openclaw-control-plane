+      await entered.promise;
+      current = false;
+      pending.resolve(undefined);
+      try {
+        await rejected;
+        expect(joinVoiceChannelMock).not.toHaveBeenCalled();
+      } finally {
+        pending.resolve(undefined);
+        await f.cleanup();
+      }
+    });
+  },
+);

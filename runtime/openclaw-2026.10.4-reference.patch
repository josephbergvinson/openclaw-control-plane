+import { modelRequestBodyState, responsesPromptObserver } from "@openclaw/ai/internal/openai";
+import type { StreamFn } from "openclaw/plugin-sdk/agent-core";
+import {
+  createAssistantMessageEventStream,
+  type AssistantMessage,
+  type Context,
+  type Model,
+} from "openclaw/plugin-sdk/llm";
+import { Type } from "typebox";
+import { describe, expect, it, vi } from "vitest";
+import { createZeroUsageFixture } from "../test-helpers/usage-fixtures.js";
+import {
+  resolveMeasuredFixedPromptCoverage,
+  wrapStreamFnWithProviderPromptState,
+  type ProviderPromptState,
+} from "./provider-prompt-state.js";
+
+const model: Model = {
+  id: "measured-model",
+  provider: "openai",
+  api: "openai-chatgpt-responses",
+  baseUrl: "https://example.test",
+  name: "Measured model",
+  reasoning: false,
+  input: ["text"],
+  cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+  contextWindow: 272_000,
+  maxTokens: 8_192,
+};
+const context: Context = { systemPrompt: "current instructions", messages: [], tools: [] };
+const budget = 272_000;
+function response(stopReason: AssistantMessage["stopReason"] = "toolUse"): AssistantMessage {
+  return {
+    role: "assistant",
+    provider: model.provider,
+    api: model.api,
+    model: model.id,
+    responseId: "accepted-response",
+    timestamp: 100,
+    stopReason,
+    content: [],
+    usage: {
+      ...createZeroUsageFixture(),
+      input: 35_411,
+      cacheRead: 153_472,
+      output: 1_147,
+      totalTokens: 190_030,
+      contextUsage: { state: "available", promptTokens: 188_883, totalTokens: 190_030 },
+    },
+  };
+}
+function coverage(
+  state: ProviderPromptState,
+  message: AssistantMessage,
+  changes: Partial<Parameters<typeof resolveMeasuredFixedPromptCoverage>[0]> = {},
+) {
+  return resolveMeasuredFixedPromptCoverage({
+    state,
+    model,
+    effectiveContextTokenBudget: budget,
+    message,
+    systemPrompt: context.systemPrompt,
+    tools: context.tools,
+    ...changes,
+  });
+}
+async function accepted(
+  options: {
+    message?: AssistantMessage;
+    activeModel?: Model;
+    mutate?: NonNullable<Parameters<StreamFn>[2]>["onPayload"];
+    matching?: boolean;
+    encode?: boolean;
+    finalEncodeChanges?: Record<string, unknown>;
+  } = {},
+) {
+  const state: ProviderPromptState = {};
+  const activeModel = options.activeModel ?? model;
+  const message = options.message ?? { ...response(), api: activeModel.api };
+  const stream = createAssistantMessageEventStream();
+  const result = vi.spyOn(stream, "result");
+  const wrapped = wrapStreamFnWithProviderPromptState({
+    state,
+    effectiveContextTokenBudget: budget,
+    streamFn: async (_model, _context, streamOptions) => {
+      const payload = {
+        model: activeModel.id,
+        input: [],
+        instructions: context.systemPrompt,
+        tools: [],
+      };
+      if (options.encode && streamOptions) {
+        modelRequestBodyState(streamOptions).enabled = true;
+      }
+      const replaced = await streamOptions?.onPayload?.(payload, activeModel);
+      if (options.encode && streamOptions) {
+        const finalPayload = replaced === undefined ? payload : replaced;
+        const encode = modelRequestBodyState(streamOptions).encode;
+        if (!encode) {
+          throw new Error("Missing native final-body encoder");
+        }
+        await encode(
+          options.finalEncodeChanges
+            ? replacePayload(finalPayload, options.finalEncodeChanges)
+            : finalPayload,
+        );
+      }
+      if (streamOptions) {
+        responsesPromptObserver.get(streamOptions)?.({
+          egress: "native-codex-sse",
+          requestModel: activeModel.id,
+          payloadVariant: "initial",
+          promptSource: "instructions",
+          expectedChars: 20,
+          observedChars: 20,
+          matchesAssembledPrompt: options.matching ?? true,
+        });
+      }
+      stream.end(message);
+      return stream;
+    },
+  });
+  await wrapped(activeModel, context, { onPayload: options.mutate });
+  await Promise.resolve();
+  return { state, message, result };
+}
+
+function replacePayload(payload: unknown, changes: Record<string, unknown>) {
+  if (!payload || typeof payload !== "object" || Array.isArray(payload)) {
+    throw new Error("Expected a native record payload");
+  }
+  return { ...payload, ...changes };
+}
+
+describe("accepted provider fixed prompt costs", () => {
+  it("binds real cached and output usage without invoking result decorators or retaining content", async () => {
+    const { state, message, result } = await accepted();
+    expect(coverage(state, message)).toEqual({ systemPrompt: true, toolSchemas: true });
+    expect(result).not.toHaveBeenCalled();
+    expect(JSON.stringify(state)).not.toContain(context.systemPrompt);
+    expect(coverage(state, structuredClone(message))).toEqual({
+      systemPrompt: true,
+      toolSchemas: true,
+    });
+  });
+  it("binds only the unchanged final native worker-encoded body", async () => {
+    const acceptedBody = await accepted({ encode: true });
+    expect(coverage(acceptedBody.state, acceptedBody.message)).toEqual({
+      systemPrompt: true,
+      toolSchemas: true,
+    });
+    for (const changes of [
+      { instructions: "late replacement" },
+      { tools: [{ type: "web_search" }] },
+    ]) {
+      const changed = await accepted({ encode: true, finalEncodeChanges: changes });
+      expect(coverage(changed.state, changed.message)).toBeUndefined();
+    }
+  });
+  it("retains accepted provider identity when the consumer assigns a local tool turn id", async () => {
+    const message = response();
+    delete message.responseId;
+    const { state } = await accepted({ message });
+    const consumerMessage = { ...message, turnId: "local-tool-turn" };
+    expect(coverage(state, consumerMessage)).toEqual({ systemPrompt: true, toolSchemas: true });
+    expect(
+      coverage(state, { ...consumerMessage, responseId: "different-provider-response" }),
+    ).toBeUndefined();
+    expect(
+      coverage(state, { ...consumerMessage, timestamp: message.timestamp + 1 }),
+    ).toBeUndefined();
+    expect(
+      coverage(state, { ...consumerMessage, content: [{ type: "text", text: "changed" }] }),
+    ).toBeUndefined();
+  });
+  it("also binds the ordinary Responses API under the same egress proof", async () => {
+    const ordinary = { ...model, api: "openai-responses" as const };
+    const { state, message } = await accepted({ activeModel: ordinary });
+    expect(coverage(state, message, { model: ordinary })).toEqual({
+      systemPrompt: true,
+      toolSchemas: true,
+    });
+  });
+  it("charges changed instructions and tool definitions independently", async () => {
+    const { state, message } = await accepted();
+    expect(coverage(state, message, { systemPrompt: "new permission instructions" })).toEqual({
+      systemPrompt: false,
+      toolSchemas: true,
+    });
+    expect(
+      coverage(state, message, {
+        tools: [{ name: "new_tool", description: "new", parameters: Type.Object({}) }],
+      }),
+    ).toEqual({ systemPrompt: true, toolSchemas: false });
+  });
+  it("refuses equal usage on a different response or changed provider scope", async () => {
+    const { state, message } = await accepted();
+    expect(coverage(state, { ...message, responseId: "different-response" })).toBeUndefined();
+    expect(
+      coverage(state, { ...message, responseModel: "different-attested-model" }),
+    ).toBeUndefined();
+    for (const changes of [
+      { model: { ...model, id: "other" } },
+      { model: { ...model, provider: "other" } },
+      { model: { ...model, baseUrl: "https://other.test" } },
+      { effectiveContextTokenBudget: budget + 1 },
+    ]) {
+      expect(coverage(state, message, changes)).toBeUndefined();
+    }
+    wrapStreamFnWithProviderPromptState({

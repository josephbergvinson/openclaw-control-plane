index 0000000000000000000000000000000000000000..cd2ab89db665d28fd90103bdd15f06907dcbf480
--- /dev/null
+++ b/src/auto-reply/reply/agent-runner-continuation-settlement.ts
@@ -0,0 +1,177 @@
+import {
+  hasCommittedSourceReplyDeliveryEvidence,
+  hasCompletedSourceReplyDeliveryEvidence,
+} from "../../agents/embedded-agent-runner/delivery-evidence.js";
+import {
+  assertSubagentRegistryWriteSourceCurrent,
+  SubagentRegistryWriteError,
+} from "../../agents/subagents/registry/subagent-registry-persistence.js";
+import type { ProgressContinuationMessage } from "../../channels/progress-continuation.js";
+import type { OpenClawStateWorkerContext } from "../../state/openclaw-state-worker-context.types.js";
+import { getReplyPayloadMetadata, setReplyPayloadMetadata } from "../reply-payload.js";
+import type { ReplyPayload } from "../types.js";
+import type { AccountedAgentTurn } from "./agent-runner-result-accounting.js";
+import type { FinalizeReplyAgentRunInput } from "./agent-runner-result.types.js";
+import { replyRunRegistry } from "./reply-run-registry.js";
+
+type ReplyContinuationOwner = {
+  stateContext: OpenClawStateWorkerContext;
+  operationKey: FinalizeReplyAgentRunInput["replyOperation"]["key"];
+  operationSessionId: FinalizeReplyAgentRunInput["replyOperation"]["sessionId"];
+};
+
+/** Prepares the existing child delivery transfer under its exact captured requester. */
+export async function prepareReplyContinuationSettlement(
+  params: Pick<
+    FinalizeReplyAgentRunInput,
+    "followupRun" | "replyOperation" | "opts" | "sessionKey"
+  > &
+    Pick<AccountedAgentTurn, "runId" | "runResult"> & {
+      guardedReplyPayloads: ReplyPayload[];
+      continuationOwner: ReplyContinuationOwner;
+      /** Existing delivery decision forbids visible continuation on this source. */
+      sourceDeliverySuppressed?: boolean;
+    },
+) {
+  const {
+    followupRun,
+    replyOperation,
+    opts,
+    sessionKey,
+    runId,
+    runResult,
+    guardedReplyPayloads,
+    continuationOwner,
+  } = params;
+  const statusPayload = guardedReplyPayloads.find(
+    (payload) => getReplyPayloadMetadata(payload)?.continuationStatus === true,
+  );
+  const acceptedSessionSpawns = runResult.acceptedSessionSpawns;
+  const requesterSessionKey = sessionKey ?? followupRun.run.sessionKey;
+  if (!requesterSessionKey || !acceptedSessionSpawns?.length) {
+    throw new Error("accepted continuation status could not be prepared for delivery");
+  }
+  const { stateContext, operationKey, operationSessionId } = continuationOwner;
+  const assertRequesterCurrent = () => {
+    assertSubagentRegistryWriteSourceCurrent(stateContext);
+    // Abort can still owe non-yielded cleanup; replacement cannot inherit this cohort.
+    if (
+      replyRunRegistry.get(operationKey) !== replyOperation ||
+      replyOperation.key !== operationKey ||
+      replyOperation.sessionId !== operationSessionId
+    ) {
+      throw new Error("Requester continuation lost its original reply operation");
+    }
+  };
+  assertRequesterCurrent();
+  const { prepareSubagentProgressContinuation } =
+    await import("../../agents/subagents/registry/subagent-registry.js");
+  assertRequesterCurrent();
+  const preparedProgressContinuation = params.sourceDeliverySuppressed
+    ? undefined
+    : prepareSubagentProgressContinuation({
+        requesterSessionKey,
+        requesterAgentId: followupRun.run.agentId,
+        requesterTurnRunId: runId,
+        batchRunIds: acceptedSessionSpawns.map((spawn) => spawn.runId),
+        operationId: runId,
+      });
+  let progressAdopted = false;
+  let progressMessage: ProgressContinuationMessage | undefined;
+  const progressContinuation = preparedProgressContinuation && {
+    close: preparedProgressContinuation.close,
+    adopt: async (
+      receipt: Parameters<NonNullable<typeof preparedProgressContinuation>["adopt"]>[0],
+    ) => {
+      // Match the native owner's synchronous receipt copy, before the caller
+      // can mutate its object while this positive adoption is awaited.
+      const message = {
+        channel: receipt.channel,
+        accountId: receipt.accountId,
+        to: receipt.to,
+        threadId: receipt.threadId,
+        messageId: receipt.messageId,
+      };
+      const adopted = await preparedProgressContinuation.adopt(receipt);
+      if (adopted) {
+        progressAdopted = true;
+        progressMessage = message;
+      }
+      return adopted;
+    },
+  };
+  if (progressContinuation && statusPayload) {
+    setReplyPayloadMetadata(statusPayload, {
+      ...getReplyPayloadMetadata(statusPayload),
+      progressContinuation,
+    });
+  }
+  let settlementPromise: Promise<void> | undefined;
+  const settlement = {
+    settle: (statusDelivered = progressAdopted) =>
+      (settlementPromise ??= (async () => {
+        try {
+          assertRequesterCurrent();
+          const { settleRequesterAfterSessionSpawns } =
+            await import("../../agents/subagents/registry/subagent-registry.js");
+          assertRequesterCurrent();
+          const transferred = await settleRequesterAfterSessionSpawns({
+            requesterSessionKey,
+            requesterAgentId: followupRun.run.agentId,
+            requesterTurnRunId: runId,
+            acceptedSessionSpawns,
+            requesterYielded: statusDelivered,
+            ...(statusDelivered && progressAdopted
+              ? { progressPresentation: { operationId: runId, message: progressMessage } }
+              : {}),
+            stateContext,
+            assertCurrent: assertRequesterCurrent,
+          });
+          if (!transferred) {
+            throw new Error("accepted continuation children could not transfer terminal delivery");
+          }
+          try {
+            assertRequesterCurrent();
+          } catch (error) {
+            throw new SubagentRegistryWriteError("committed", error, "published");
+          }
+        } finally {
+          progressContinuation?.close();
+        }
+      })().catch((error: unknown) => {
+        if (!(error instanceof SubagentRegistryWriteError) || error.outcome === "not-committed") {
+          settlementPromise = undefined;
+        }
+        throw error;
+      })),
+  };
+  if (params.sourceDeliverySuppressed) {
+    await settlement.settle(false);
+  } else if (statusPayload) {
+    opts?.onPendingContinuation?.(settlement);
+  } else {
+    // Already-visible progress owes no second status. Transfer its channel-owned
+    // receipt while this exact reply operation still owns the empty outbox.
+    let adopted = false;
+    const committedSourceProgress =
+      hasCommittedSourceReplyDeliveryEvidence(runResult) &&
+      !hasCompletedSourceReplyDeliveryEvidence(runResult);
+    try {
+      opts?.onPendingContinuation?.();
+      assertRequesterCurrent();
+      opts?.abortSignal?.throwIfAborted();
+      const confirmed = progressContinuation
+        ? await opts?.adoptProgressContinuation?.(progressContinuation)
+        : false;
+      assertRequesterCurrent();
+      opts?.abortSignal?.throwIfAborted();
+      adopted = confirmed === true || committedSourceProgress;
+    } finally {
+      // Visible source progress retains the single yielded result even when
+      // this channel cannot hand over a confirmed editable card. Card ownership
+      // remains independently gated by progressAdopted above.
+      await settlement.settle(adopted);
+    }
+  }
+  return settlement;
+}

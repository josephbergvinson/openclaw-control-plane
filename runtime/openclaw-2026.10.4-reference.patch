diff --git a/extensions/browser/chrome-extension/background.native-policy-enumeration.test.ts b/extensions/browser/chrome-extension/background.native-policy-enumeration.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a4a853d6fdd34a812ab05af1db7f3b24a07eab0f
--- /dev/null
+++ b/extensions/browser/chrome-extension/background.native-policy-enumeration.test.ts
@@ -0,0 +1,76 @@
+import { createDeferred } from "openclaw/plugin-sdk/extension-shared";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { createRelayDebugger, NativeAttachPolicyDeniedError } from "./modules/relay-debugger.js";
+
+const denial = "Cannot access a chrome-extension:// URL of different extension";
+function fixture() {
+  let current = true;
+  const epoch = { revision: 1, groupRevision: 0, tabRevision: 0 };
+  const attach = vi.fn(async () => {});
+  const detach = vi.fn(async () => {});
+  const sendCommand = vi.fn(async () => ({ targetInfo: { targetId: "native-target" } }));
+  vi.stubGlobal("chrome", { debugger: { attach, detach, sendCommand } });
+  const debuggerOwner = createRelayDebugger({
+    policy: {
+      capture: () => epoch,
+      epochIsCurrent: () => current,
+      retireTabDocument: vi.fn(),
+      requireTab: async () => ({ id: 7 }),
+    },
+    requireAutomationAllowed: async () => {},
+  });
+  return {
+    owner: debuggerOwner.createOwner(() => true),
+    attach,
+    detach,
+    sendCommand,
+    revoke: () => {
+      current = false;
+    },
+  };
+}
+
+afterEach(() => vi.unstubAllGlobals());
+describe("native attach policy attestation", () => {
+  it.each([denial, "Cannot access a chrome:// URL", "The extensions gallery cannot be scripted."])(
+    "attests only the exact native attach refusal and leaves no acquired-client debt: %s",
+    async (message) => {
+      const f = fixture();
+      f.attach.mockRejectedValueOnce(new Error(message));
+      await expect(f.owner.attach(7, () => {})).rejects.toBeInstanceOf(
+        NativeAttachPolicyDeniedError,
+      );
+      expect(f.sendCommand).not.toHaveBeenCalled();
+      expect(f.detach).not.toHaveBeenCalled();
+      await expect(f.owner.attach(7, () => {})).resolves.toMatchObject({
+        targetId: "native-target",
+      });
+      await f.owner.retire();
+    },
+  );
+
+  it("never attests the same error after native acquisition and joins its actual cleanup", async () => {
+    const f = fixture();
+    f.sendCommand.mockRejectedValueOnce(new Error(denial));
+    const failure = await f.owner.attach(7, () => {}).catch((error: unknown) => error);
+    expect(failure).toBeInstanceOf(Error);
+    expect(failure).not.toBeInstanceOf(NativeAttachPolicyDeniedError);
+    expect(f.detach).toHaveBeenCalledOnce();
+    await f.owner.retire();
+  });
+
+  it("does not attest a delayed native refusal after its access epoch is revoked", async () => {
+    const pending = createDeferred<void>();
+    const f = fixture();
+    f.attach.mockReturnValueOnce(pending.promise);
+    const result = f.owner.attach(7, () => {}).catch((error: unknown) => error);
+    await vi.waitFor(() => expect(f.attach).toHaveBeenCalledOnce());
+    f.revoke();
+    pending.reject(new Error(denial));
+    const failure = await result;
+    expect(failure).toBeInstanceOf(Error);
+    expect(failure).not.toBeInstanceOf(NativeAttachPolicyDeniedError);
+    expect(f.detach).not.toHaveBeenCalled();
+    await f.owner.retire();
+  });
+});

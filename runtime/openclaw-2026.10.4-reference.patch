+describe("automation trigger save round trip", () => {
+  it.each(["edit", "clone"])("preserves a configured trigger deadline during %s", async (mode) => {
+    const job: CronJob = {
+      ...createCronJob({ id: "bounded-trigger", name: "Conditional job" }),
+      trigger: { script: "json({ fire: true })", once: false, timeoutSeconds: 120 },
+    };
+    const original = structuredClone(job);
+    const request = vi.fn(async (method: string, _payload?: unknown) => {
+      if (method === "cron.update") {
+        return job;
+      }
+      if (method === "cron.add") {
+        return { id: "cloned-trigger" };
+      }
+      if (method === "cron.list") {
+        return cronJobsListResponse([job]);
+      }
+      return { enabled: true, jobs: 1, nextWakeAtMs: null };
+    });
+    const state = createStateWithRequest(request, { cronJobs: [job] });
+    if (mode === "edit") {
+      startCronEdit(state, job);
+    } else {
+      startCronClone(state, job);
+    }
+    state.cronForm.triggerScript = "json({ fire: false })";
+    state.cronForm.triggerOnce = true;
+    expect((await addCronJob(state)).saved).toBe(true);
+    const call = request.mock.calls.find(

+
+/// Synthetic relationships only; no AX, process, Keychain, app or Gateway calls.
+@MainActor
+struct NativeCredentialPromptWindowTests {
+    private typealias Ancestor = NativeCredentialPromptWindow.Ancestor<Int>
+    private static let owner: pid_t = 42

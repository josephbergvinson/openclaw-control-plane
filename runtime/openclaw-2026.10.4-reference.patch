+/** Bound optional prompt latency while the native work owner retains any late cleanup tail. */
+export async function prepareProjectMemoryBootstrap(params: {
+  cfg: OpenClawConfig;
+  agentId: string;
+  activeProjectKeys: readonly string[];
+  context?: MemoryCallerContext;
+}): Promise<string[]> {
+  if (params.activeProjectKeys.length === 0) {
+    return [];
+  }
+  return await runWithAsyncWorkResources(async () => {
+    const deadline = new AbortController();
+    const deadlineAt = Date.now() + PROJECT_MEMORY_BOOTSTRAP_TIMEOUT_MS;
+    const parentSignal = getAsyncWorkSignal();
+    const signal = AbortSignal.any([
+      deadline.signal,
+      ...(parentSignal ? [parentSignal] : []),
+      ...(params.context?.signal ? [params.context.signal] : []),
+    ]);
+    const expire = () => deadline.abort(new Error("project memory bootstrap budget expired"));
+    const context: MemoryCallerContext = {
+      authority: params.context?.authority ?? {
+        kind: "host",
+        operation: "project-memory-bootstrap",
+      },
+      signal,
+      assertCurrent() {
+        if (Date.now() >= deadlineAt) {
+          expire();
+        }
+        signal.throwIfAborted();
+        params.context?.assertCurrent();
+      },
+    };
+    // The caller can receive [] at the deadline while this exact scope joins
+    // native provider acquisition/release. No second manager or detached index.
+    const work = trackAsyncWork(() => prepareProjectMemoryBootstrapOwned({ ...params, context }));
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    try {
+      return await Promise.race([
+        work,
+        new Promise<string[]>((resolve) => {
+          timer = setTimeout(() => {
+            expire();
+            resolve([]);
+          }, PROJECT_MEMORY_BOOTSTRAP_TIMEOUT_MS);
+          timer.unref?.();
+        }),
+      ]);
+    } catch {
+      return [];
+    } finally {
+      clearTimeout(timer);
+      deadline.abort(new Error("project memory bootstrap request ended"));
+    }
+  });
+}
+
 export function buildProjectMemoryWriteInstruction(projectKey: string | null | undefined): string {
   return projectKey && !/[\r\n<>]/u.test(projectKey)

+  await listTar({
+    file: archive,
+    onReadEntry(entry) {
+      expect(entry.path.startsWith("package/") && !entry.path.split("/").includes("..")).toBe(true);
+      expect(entry.type).toBe("File");
+      if (entry.path === "package/vendor/aarch64-apple-darwin/bin/codex") {

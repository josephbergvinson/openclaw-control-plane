+  const current = confidential
+    ? await readBrowserConfidentialSnapshotFields(scope, { ...options, ...budget.current() })
+    : [];
+  if (JSON.stringify(expected) !== JSON.stringify(current)) {
+    throw new Error(
+      "Confidential field identity changed while its browser snapshot was being captured; retry.",
+    );
+  }

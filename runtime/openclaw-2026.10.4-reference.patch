+      lastDeliveryStatus: "not-delivered",
+      deliverySuppressionReason: "silent",
+    });
+  });
+
+  it("does not announce or verify after the original repair is cancelled", async () => {
+    const { service, job } = await fixture();
+    mocks.agent.mockImplementation(async (params) => {
+      expect(mocks.send).not.toHaveBeenCalled();
+      expect(abortActiveCronTaskRuns("cancelled original repair")).toBe(1);
+      expect(params.abortSignal?.aborted).toBe(true);
+      return { status: "error", error: "cancelled original repair" };
+    });
+    await service.cron.run(job.id, "force");
+    expect(mocks.agent).toHaveBeenCalledOnce();
+    expect(mocks.send).not.toHaveBeenCalled();
+    expect(service.cron.getJob(job.id)?.state.lastRunStatus).toBe("error");
+  });
+
+  it("retains the original final-delivery cancellation signal after verification", async () => {
+    const { service, job, marker } = await fixture();
+    let originalSignal: AbortSignal | undefined;
+    mocks.agent.mockImplementation(async (params) => {

+  mocks.hierarchy.mockReset().mockResolvedValue(true);
+});
+describe("native role creation and deletion", () => {
+  it.each([8, null, "", "-1", "8.0", "0x8"])(
+    "rejects a malformed permission bitfield before a role effect: %s",
+    (permissions) => {
+      expect(() =>
+        readDiscordRoleCreateParams({ guildId: "guild", name: "role", permissions }),
+      ).toThrow("decimal bitfield string");
+      expect(mocks.create).not.toHaveBeenCalled();
+    },
+  );
+  it("preserves false presentation options and the exact decimal permission value", () => {
+    expect(
+      readDiscordRoleCreateParams({
+        guildId: "guild",
+        name: "role",
+        permissions: "0",
+        hoist: false,
+        mentionable: false,
+      }),
+    ).toMatchObject({ permissions: "0", hoist: false, mentionable: false });
+  });
+  it("executes creation through the native role gate and REST owner", async () => {
+    expect(
+      await handleDiscordAction(

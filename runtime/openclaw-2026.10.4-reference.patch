+function compilePublicTerminalProbe(directory: string) {
+  const source = path.join(directory, "public-terminal.c");
+  const binary = path.join(directory, "public-terminal");
+  fs.writeFileSync(source, publicTerminalProbe);
+  const sdk = execFileSync("/usr/bin/xcrun", ["--sdk", "macosx", "--show-sdk-path"], {
+    encoding: "utf8",
+    timeout: 2000,
+  }).trim();
+  execFileSync(
+    "/usr/bin/xcrun",
+    [
+      "--sdk",
+      "macosx",
+      "clang",
+      "-isysroot",
+      sdk,
+      "-Wall",
+      "-Wextra",
+      "-Werror",
+      source,
+      "-o",
+      binary,
+    ],
+    { timeout: 10000 },
+  );
+  expect(JSON.parse(execFileSync(binary, { encoding: "utf8", timeout: 2000 }))).toEqual({
+    bytes: 648,
+    startSec: 0,
+    startUsec: 8,
+    startSecBytes: 8,
+    startUsecBytes: 4,
+    status: 36,
+    pid: 40,
+    ppid: 560,
+    pgid: 564,
+  });
+  return binary;
+}
+
+function fakeNativeProcessApi() {
+  const state = {
+    rows: new Map<number, DarwinProcessIdentity | Omit<DarwinProcessIdentity, "sid">>([
+      [200, rootIdentity],
+    ]),
+    listed: [200],
+    count: undefined as number | undefined,
+    terminalBytes: 136,
+    terminalError: 0,
+    publicResult: -1,
+    publicError: 1,
+    publicBytes: 648,
+    publicRow: undefined as
+      | {
+          pid: number;
+          ppid: number;
+          pgid: number;
+          status: number;
+          startSec: bigint;
+          startUsec: bigint;
+        }
+      | undefined,
+    publicQueries: 0,
+    sidErrorPid: undefined as number | undefined,
+    errno: 0,
+    afterList: undefined as (() => void) | undefined,
+  };
+  const koffi = {
+    errno: (value?: number) => (value === undefined ? state.errno : (state.errno = value)),
+    load: () => ({
+      func: (name: string) => {
+        if (name === "sysctl") {
+          return (
+            mib: Buffer,
+            count: number,
+            bytes: Buffer,
+            length: Buffer,
+            newData: null,
+            newLength: number,
+          ) => {
+            expect([0, 4, 8, 12].map((offset) => mib.readInt32LE(offset))).toEqual([1, 14, 1, 300]);
+            expect([count, length.readBigUInt64LE(), newData, newLength]).toEqual([
+              4,
+              648n,
+              null,
+              0,
+            ]);
+            state.publicQueries++;
+            length.writeBigUInt64LE(BigInt(state.publicBytes));
+            const row = state.publicRow;
+            if (row) {
+              bytes.writeInt32LE(row.pid, 40);
+              bytes.writeInt32LE(row.ppid, 560);
+              bytes.writeInt32LE(row.pgid, 564);
+              bytes.writeUInt8(row.status, 36);
+              bytes.writeBigInt64LE(row.startSec, 0);
+              bytes.writeInt32LE(Number(row.startUsec), 8);
+            }
+            state.errno = state.publicError;
+            return state.publicResult;
+          };
+        }
+        if (name === "proc_pidinfo") {
+          return (pid: number, _flavor: number, arg: bigint, bytes: Buffer) => {
+            const row = state.rows.get(pid);
+            if (!row || (arg === 0n && !("sid" in row))) {
+              state.errno = 3;
+              return 0;
+            }
+            bytes.writeUInt32LE("sid" in row ? 2 : 5, 4);
+            bytes.writeUInt32LE(row.pid, 12);
+            bytes.writeUInt32LE(row.ppid, 16);
+            bytes.writeUInt32LE(row.pgid, 100);
+            bytes.writeBigUInt64LE(row.startSec, 120);
+            bytes.writeBigUInt64LE(row.startUsec, 128);
+            state.errno = arg === 1n ? state.terminalError : 0;
+            return arg === 1n ? state.terminalBytes : 136;
+          };
+        }
+        if (name === "getsid") {
+          return (pid: number) => {
+            const row = state.rows.get(pid);
+            state.errno = pid !== state.sidErrorPid && row && "sid" in row ? 0 : 3;
+            return pid !== state.sidErrorPid && row && "sid" in row ? row.sid : -1;
+          };
+        }
+        return (bytes: Buffer) => {
+          state.listed.forEach((pid, i) => bytes.writeInt32LE(pid, i * 4));
+          state.afterList?.();
+          return state.count ?? state.listed.length;
+        };
+      },
+    }),
+  } as unknown as Parameters<typeof createDarwinProcessApi>[0];
+  return { state, api: createDarwinProcessApi(koffi) };
+}

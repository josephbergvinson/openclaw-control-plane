+  snapshotUpdateCandidateState,
+} from "./update-candidate-state.js";
+
+const dirs = useAutoCleanupTempDirTracker(afterEach);
+const families = [
+  "state_5.sqlite",
+  "logs_2.sqlite",
+  "goals_1.sqlite",
+  "memories_1.sqlite",
+  "memories_v2_1.sqlite",
+  "queue_1.sqlite",
+  "thread_history_1.sqlite",
+];
+
+type NativeFixtureLayout =
+  | "shared cross-home locator"
+  | "nested cross-home locator"
+  | "equal within home";
+
+async function projectionFixture(
+  layout?: NativeFixtureLayout,
+  options: { staleArg0?: boolean; outsideArg0Symlink?: boolean } = {},
+) {
+  const root = dirs.make("candidate-native-stopped-");
+  const stateDir = path.join(root, "source");
+  const targetStateDir = path.join(root, "target");
+  await fs.mkdir(targetStateDir, { mode: 0o700 });
+  const homes: NativeCodexProjection["homes"] = [];
+  const roots: NativeCodexProjection["roots"] = [];
+  const retiredExecutable = path.join(root, "retired-native");
+  if (options.staleArg0 || options.outsideArg0Symlink) {
+    await fs.writeFile(retiredExecutable, "opaque retired executable fixture", { mode: 0o700 });
+  }
+  const homeIds =
+    layout === "equal within home"
+      ? ["first"]
+      : layout
+        ? ["first", "second"]
+        : ["first", "second", "third"];
+  for (const [index, id] of homeIds.entries()) {
+    let codexHome = path.join(stateDir, "agents", id, "agent", "codex-home");
+    let sqliteHome = path.join(codexHome, "sqlite");
+    if (layout === "shared cross-home locator" || layout === "nested cross-home locator") {
+      const firstRoot = path.join(stateDir, "native-a");
+      const secondRoot = path.join(stateDir, "native-b");
+      codexHome = index === 0 ? firstRoot : secondRoot;
+      sqliteHome =
+        layout === "shared cross-home locator"
+          ? index === 0
+            ? secondRoot
+            : path.join(secondRoot, "sqlite")
+          : path.join(secondRoot, index === 0 ? "foreign-sqlite" : "own-sqlite");
+    } else if (layout === "equal within home") {
+      sqliteHome = codexHome;
+    }
+    await fs.mkdir(codexHome, { recursive: true, mode: 0o700 });
+    await fs.mkdir(sqliteHome, { recursive: true, mode: 0o700 });
+    await fs.writeFile(path.join(codexHome, "auth.json"), '{"fixture":"opaque auth preserved"}', {
+      mode: 0o600,
+    });
+    await fs.writeFile(
+      path.join(codexHome, "models_cache.json"),
+      '{"fixture":"catalog preserved"}',
+      { mode: 0o600 },
+    );
+    if (options.staleArg0) {
+      const aliases = path.join(codexHome, "tmp", "arg0", "codex-arg0-fixture");
+      await fs.mkdir(aliases, { recursive: true, mode: 0o700 });
+      await fs.writeFile(path.join(aliases, ".lock"), "", { mode: 0o600 });
+      for (const name of ["applypatch", "apply_patch", "codex-execve-wrapper"]) {
+        await fs.symlink(retiredExecutable, path.join(aliases, name));
+      }
+    }
+    if (options.outsideArg0Symlink) {
+      const sibling = path.join(codexHome, "tmp", "arg0-other");
+      await fs.mkdir(sibling, { recursive: true, mode: 0o700 });
+      await fs.symlink(retiredExecutable, path.join(sibling, "apply_patch"));
+    }
+    const familyPresence: Record<string, boolean> = {};
+    for (const family of families) {
+      const present =
+        family !== "memories_v2_1.sqlite" && (family !== "thread_history_1.sqlite" || index === 0);
+      familyPresence[family] = present;
+      if (present) {
+        // Opaque bytes ensure this code never treats native SQLx families as
+        // OpenClaw agent databases or opens them through Node SQLite.
+        await fs.writeFile(path.join(sqliteHome, family), `${id}/${family}`, { mode: 0o600 });
+      }
+    }
+    await fs.writeFile(path.join(sqliteHome, "state_5.sqlite-wal"), `${id}/WAL`, { mode: 0o600 });
+    await fs.writeFile(path.join(sqliteHome, "state_5.sqlite-shm"), `${id}/SHM`, { mode: 0o600 });
+    homes.push({
+      id,
+      codexHome,
+      sqliteHome,
+      providerLabel: "fixture-native-provider",
+      familyPresence,
+    });
+  }
+  // Capture complete roots after all declared homes are populated. The two
+  // overlap fixtures have valid disjoint physical roots, so admission must
+  // reject their cross-home locators rather than an incomplete tree or plan.
+  for (const codexHome of new Set(homes.map((home) => home.codexHome))) {
+    const entries: NativeCodexProjection["roots"][number]["entries"] = [];
+    const walk = async (relativePath: string) => {
+      const source = path.join(codexHome, relativePath);
+      const info = await fs.lstat(source);
+      entries.push({
+        relativePath,
+        kind: info.isDirectory() ? "directory" : "file",
+        identity: { device: info.dev, inode: info.ino, ownerUid: info.uid },
+        mode: info.mode & 0o7777,
+        bytes: info.size,
+        mtimeMs: info.mtimeMs,
+        ctimeMs: info.ctimeMs,
+        ...(info.isFile()
+          ? {
+              sha256: createHash("sha256")
+                .update(await fs.readFile(source))
+                .digest("hex"),
+            }
+          : {}),
+      });
+      // Declare the stopped fixture independently of the production admission predicate.
+      if (info.isDirectory() && relativePath !== path.join("tmp", "arg0")) {
+        for (const child of await fs.readdir(source)) {
+          await walk(path.join(relativePath, child));
+        }
+      }
+    };
+    await walk("");
+    roots.push({ path: codexHome, entries });
+  }
+  const baseline = path.join(root, "sole-stopped-owner-fixture.json");
+  await fs.writeFile(baseline, '{"fixture":"existing P2 baseline owner"}', { mode: 0o400 });
+  const nativeCodexProjection: NativeCodexProjection = {
+    schemaVersion: 1,
+    baselineSnapshot: {
+      path: baseline,
+      sha256: createHash("sha256")
+        .update(await fs.readFile(baseline))
+        .digest("hex"),
+    },
+    expectedHomeIds: homes.map((home) => home.id),
+    roots,
+    homes,
+  };
+  const input = {
+    stateDir,
+    targetStateDir,
+    candidateRoot: fileURLToPath(new URL("../../", import.meta.url)),
+    config: {},
+    nativeCodexProjection,
+    env: {
+      HOME: root,
+      OPENCLAW_HOME: root,
+      OPENCLAW_STATE_DIR: stateDir,
+      OPENCLAW_DISABLE_BUNDLED_PLUGINS: "1",
+    },
+  };
+  return { input, nativeCodexProjection };
+}
+
+async function prepared(

+  if (
+    projection.homes.some((home) =>
+      transientArg0Roots.some((transient) => isPathInside(transient, home.sqliteHome)),
+    )
+  ) {
+    throw new Error("Native SQLite home overlaps transient arg0 storage");
+  }

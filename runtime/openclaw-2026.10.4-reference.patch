+                                current.submit == form.submit, current.evidence == form.evidence,
+                                self.nodes.map(\.ownerPID) == owners
+                            else { throw NativeCredentialError.stalePrompt }
+                        }, setSecret: { _ in self.entries += 1 })], diagnostics: .init(reason: .bindingUnmatched))
+                }, withSecret: { _, consume in
+                    self.secretReads += 1
+                    await self.duringResolution?()
+                    try consume("synthetic-entry-only")
+                }, now: { self.now },
+                localAccount: { self.localAccount },
+                localAccountFullName: { self.localAccountFullName }))
+        }
+
+        func call(_ params: OpenClawComputerActParams, scope: UUID? = nil, generation: UInt64 = 1) async throws
+            -> OpenClawComputerActResult
+        {
+            try await self.service.perform(params, scope: scope ?? self.scope, generation: generation) {
+                guard self.allowed else { throw CancellationError() }
+            }
+        }
+
+        func observe() async throws -> String {
+            let result = try await self.call(.init(action: .credentialPrompts))
+            let rows = try #require(result.details?["credentialPrompts"]?.value as? [[String: String]])
+            #expect(self.secretReads == 0)
+            return try #require(rows.first?["promptRef"])
+        }
+
+        func fill(_ ref: String, scope: UUID? = nil, generation: UInt64 = 1) async throws -> OpenClawComputerActResult {
+            try await self.call(
+                .init(action: .typeSecret, alias: "mac.fixture.password", promptRef: ref),
+                scope: scope,
+                generation: generation)
+        }
+    }
+
+    @Test(arguments: ["fixture", "Fixture Operator"])
+    func `hosted passkey opaque entry is single use and does not claim authentication`(_ account: String) async throws {
+        let h = try Harness()
+        h.nodes = Self.form(account: account)
+        let ref = try await h.observe()
+        let result = try await h.fill(ref)
+        #expect(h.secretReads == 1)
+        #expect(h.entries == 1)
+        #expect(result.details?["authenticationVerified"]?.value as? Bool == false)
+        let encoded = try #require(String(data: JSONEncoder().encode(result), encoding: .utf8))
+        #expect(!encoded.contains("synthetic-entry-only"))
+        await #expect(throws: NativeCredentialError.stalePrompt) { try await h.fill(ref) }
+        #expect(h.secretReads == 1)
+    }
+
+    @Test(arguments: [
+        "host", "principal", "full-name", "binding", "field-owner", "host-owner", "native-account", "scope",
+    ])
+    func `passkey revalidates both native owners and authority after resolution`(_ change: String) async throws {
+        let h = try Harness()
+        let ref = try await h.observe()
+        h.duringResolution = {
+            switch change {
+            case "host": h.host = "22222222-2222-4222-8222-222222222222"
+            case "principal": h.localAccount = "other"
+            case "full-name": h.localAccountFullName = "Other"
+            case "binding": h.bindings.removeAll()
+            case "field-owner": h.nodes[6].ownerPID = 44
+            case "host-owner":
+                for index in h.nodes.indices where index != 6 {
+                    h.nodes[index].ownerPID = 44
+                }
+            case "native-account": h.nodes = NativeCredentialPasskeyTests.form(account: "other")
+            case "scope": h.allowed = false
+            default: Issue.record("Unknown synthetic post-await variant")
+            }
+        }
+        if ["field-owner", "host-owner", "native-account"].contains(change) {
+            await #expect(throws: NativeCredentialError.stalePrompt) { try await h.fill(ref) }
+        } else if change == "scope" {
+            await #expect(throws: CancellationError.self) { try await h.fill(ref) }
+        } else {
+            await #expect(throws: NativeCredentialError.refused) { try await h.fill(ref) }
+        }
+        #expect(h.secretReads == 1)
+        #expect(h.entries == 0)
+        h.allowed = true
+        await #expect(throws: NativeCredentialError.stalePrompt) { try await h.fill(ref) }
+    }
+
+    @Test(arguments: ["scope", "generation", "expiry"])
+    func `hosted passkey unused references retain task generation and expiry fences`(_ change: String) async throws {
+        let h = try Harness()
+        let ref = try await h.observe()
+        if change == "expiry" { h.now.addTimeInterval(121) }
+        await #expect(throws: NativeCredentialError.stalePrompt) {
+            try await h.fill(ref, scope: change == "scope" ? UUID() : nil, generation: change == "generation" ? 2 : 1)
+        }
+        #expect(h.secretReads == 0)
+        #expect(h.entries == 0)
+    }
+}

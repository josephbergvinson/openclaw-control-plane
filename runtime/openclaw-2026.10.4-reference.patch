+import { createDeferred } from "openclaw/plugin-sdk/extension-shared";
+import { describe, expect, it, vi } from "vitest";
+import { installSessionTabRegistrySqliteHarness } from "./session-tab-registry.sqlite.test-harness.js";
+import { durableOwnership } from "./session-tab-registry.sqlite.test-helpers.js";
+
+describe("ordinary final cleanup uses the native durable tab owner", () => {
+  const { freshRegistry, openStore } = installSessionTabRegistrySqliteHarness();
+  it("selects only old unchanged registrations from the completed session", async () => {
+    const registry = await freshRegistry("completion-cutoff-native");
+    const track = (targetId: string, now = 10, sessionKey = "agent:main:main") =>
+      registry.trackSessionBrowserTab({
+        sessionKey,
+        targetId,
+        profile: "remote",
+        ownership: durableOwnership(targetId),
+        now,
+      });
+    await track("old");
+    await track("touched");
+    await track("new", 30);
+    await track("other", 10, "agent:other:main");
+    await registry.touchSessionBrowserTab({
+      sessionKey: "agent:main:main",
+      targetId: "touched",
+      profile: "remote",
+      now: 30,
+    });
+    const close = vi.fn(async () => {});
+    expect(
+      await registry.closeTrackedBrowserTabsForSessions({
+        sessionKeys: ["agent:main:main"],
+        completedBefore: 20,
+        closeTab: close,
+      }),
+    ).toBe(1);
+    expect(close).toHaveBeenCalledWith(expect.objectContaining({ targetId: "old" }));
+    expect(openStore().entries()).toHaveLength(3);
+  });
+  it.each(["source", "touch"] as const)(
+    "rechecks %s at the native durable dispatch effect",
+    async (change) => {
+      const registry = await freshRegistry(`completion-cutoff-${change}`);
+      const tab = { sessionKey: "agent:main:main", targetId: "old", profile: "remote" };
+      await registry.trackSessionBrowserTab({
+        ...tab,
+        ownership: durableOwnership("old"),
+        now: 10,
+      });
+      const entered = createDeferred<void>();
+      const release = createDeferred<void>();
+      let current = true;
+      let effects = 0;
+      const pending = registry.closeTrackedBrowserTabsForSessions({
+        sessionKeys: [tab.sessionKey],
+        completedBefore: 20,
+        isCurrent: () => current,
+        closeDurableTab: async (_tab, { closeIfCurrent }) => {
+          entered.resolve();
+          await release.promise;
+          return closeIfCurrent(async () => {
+            effects++;
+            return { status: "closed" };
+          });
+        },
+      });
+      await entered.promise;
+      if (change === "source") {
+        current = false;
+      } else {
+        await registry.touchSessionBrowserTab({ ...tab, now: 30 });
+      }
+      release.resolve();
+      expect(await pending).toBe(0);
+      expect(effects).toBe(0);
+      expect(openStore().entries()).toHaveLength(1);
+    },
+  );
+});

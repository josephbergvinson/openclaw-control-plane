+import { describe, expect, it, vi } from "vitest";
+import { createDeferredCore } from "../shared/deferred.js";
+import { makeRuntime } from "./agent-bundle-mcp-harness.test-support.js";
+import { mergeMcpConnectCatalog } from "./agent-bundle-mcp-requester-connect.js";
+import type { RequesterMcpConnect } from "./agent-bundle-mcp-types.js";
+import { createRequesterMcpConnectRefresh } from "./mcp-requester-connect-refresh.js";
+import {
+  captureAgentPluginRuntimeRefresh,
+  createAgentPluginRuntimeRefresh,
+} from "./plugin-runtime-refresh.js";
+
+const scope = {
+  requesterSenderId: "owner-a",
+  agentAccountId: "company-a",
+  messageChannel: "discord",
+};
+
+async function withRefresh(
+  run: (owner: ReturnType<typeof captureAgentPluginRuntimeRefresh>) => Promise<void>,
+) {
+  const lifecycle = createAgentPluginRuntimeRefresh();
+  try {
+    await lifecycle.run(async () => {
+      const owner = captureAgentPluginRuntimeRefresh();
+      owner.bindConsumer(() => true);
+      await run(owner);
+    });
+  } finally {
+    lifecycle.close();
+  }
+}
+
+function runtime() {
+  const value = makeRuntime({
+    sessionId: "original-run",
+    requesterSenderId: scope.requesterSenderId,
+  });
+  value.requesterScope = { ...scope };
+  value.requesterConnect = {
+    catalog: { version: 1, generatedAt: 0, servers: {}, tools: [] },
+    authorizedServerNames: ["user-mail"],
+    configFingerprint: "same-source",
+    createExecute: () => undefined,
+  };
+  return value;
+}
+
+describe("requester OAuth uses the native logical-run refresh owner", () => {
+  it("requests one canonical continuation after exact-account catalog discovery and lease release", async () => {
+    await withRefresh(async (owner) => {
+      const value = runtime();
+      const release = vi.fn(() => expect(owner.isPending()).toBe(false));
+      const acquire = vi.fn(async () => ({
+        runtime: value,
+        releaseLease: release,
+        advertisedCatalogConfigFingerprint: "fixture",
+      }));
+      const refresh = createRequesterMcpConnectRefresh({
+        requesterScope: scope,
+        assertCurrent: () => {},
+        acquire,
+        acceptsCatalog: (catalog) => catalog.tools.some((tool) => tool.toolName === "inbox"),
+      });
+      expect(await refresh("user-mail")).toBe(true);
+      expect(acquire).toHaveBeenCalledOnce();
+      expect(release).toHaveBeenCalledOnce();
+      expect(owner.isPending()).toBe(true);
+      await expect(refresh("user-mail")).rejects.toThrow("Plugin runtime changed");
+      expect(acquire).toHaveBeenCalledOnce();
+    });
+  });
+  it.each(["wrong-account", "denied", "missing-server"])(
+    "does not refresh a %s catalog",
+    async (mode) => {
+      await withRefresh(async (owner) => {
+        const value = runtime();
+        if (mode === "wrong-account") {
+          value.requesterScope = { ...scope, agentAccountId: "company-b" };
+        }
+        const release = vi.fn();
+        const refresh = createRequesterMcpConnectRefresh({
+          requesterScope: scope,
+          assertCurrent: () => {},
+          acquire: async () => ({
+            runtime: value,
+            releaseLease: release,
+            advertisedCatalogConfigFingerprint: "fixture",
+          }),
+          acceptsCatalog: () => mode !== "denied",
+        });
+        if (mode === "wrong-account") {
+          await expect(refresh("user-mail")).rejects.toThrow("identity changed");
+        } else {
+          expect(await refresh(mode === "missing-server" ? "absent" : "user-mail")).toBe(false);
+        }
+        expect(release).toHaveBeenCalledOnce();
+        expect(owner.isPending()).toBe(false);
+      });
+    },
+  );
+  it("joins the lease and refuses continuation when the source expires during catalog I/O", async () => {
+    await withRefresh(async (owner) => {
+      const value = runtime();
+      const pending = createDeferredCore<Awaited<ReturnType<typeof value.getCatalog>>>();
+      const entered = createDeferredCore();
+      value.getCatalog = async () => {
+        entered.resolve();
+        return await pending.promise;
+      };
+      let current = true;
+      const release = vi.fn();
+      const refresh = createRequesterMcpConnectRefresh({
+        requesterScope: scope,
+        assertCurrent: () => {
+          if (!current) {
+            throw new Error("original source revoked");
+          }
+        },
+        acquire: async () => ({
+          runtime: value,
+          releaseLease: release,
+          advertisedCatalogConfigFingerprint: "fixture",
+        }),
+        acceptsCatalog: () => true,
+      });
+      const attempt = refresh("user-mail");
+      await entered.promise;
+      current = false;
+      pending.resolve(value.peekCatalog()!);
+      await expect(attempt).rejects.toThrow("original source revoked");
+      expect(release).toHaveBeenCalledOnce();
+      expect(owner.isPending()).toBe(false);
+    });
+  });
+});
+
+describe("expired requester authorization preserves the native sign-in bootstrap", () => {
+  it.each(["inbox", "connect"])("adds one bootstrap alongside cached real %s tools", (toolName) => {
+    const live = structuredClone(runtime().peekCatalog()!);
+    live.tools[0]!.toolName = toolName;
+    const connect: RequesterMcpConnect = {
+      authorizedServerNames: [],
+      configFingerprint: "expired-source",
+      createExecute: () => undefined,
+      catalog: {
+        ...structuredClone(live),
+        generatedAt: 1,
+        tools: [{ ...live.tools[0]!, toolName: "connect", oauthConnectBootstrap: true }],
+      },
+    };
+    const merged = mergeMcpConnectCatalog(live, connect);
+    expect(merged.tools).toHaveLength(2);
+    expect(merged.tools.filter((tool) => tool.oauthConnectBootstrap === true)).toHaveLength(1);
+    expect(merged.servers["user-mail"]?.toolCount).toBe(2);
+    expect(mergeMcpConnectCatalog(merged, connect)).toBe(merged);
+    expect(live.tools).toHaveLength(1);
+    connect.authorizedServerNames = ["user-mail"];
+    expect(mergeMcpConnectCatalog(live, connect)).toBe(live);
+  });
+});

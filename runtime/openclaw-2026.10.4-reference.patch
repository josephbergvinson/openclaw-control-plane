@@ -6,3 +6,29 @@ export function resolveDiscordVoiceEnabled(voice: DiscordAccountConfig["voice"])
   }
   return voice !== undefined;
 }
+
+/** Exact guild policy overrides wildcard, which overrides account policy. */
+export function resolveDiscordGuildVoiceConfig(
+  config: DiscordAccountConfig,
+  guildId: string,
+): DiscordAccountConfig["voice"] {
+  const fallback = config.guilds?.["*"]?.voice;
+  const guild = config.guilds?.[guildId]?.voice;
+  if (!fallback && !guild) {
+    return config.voice;
+  }
+  return {
+    ...config.voice,
+    ...(fallback?.actionHandoff !== undefined ? { actionHandoff: fallback.actionHandoff } : {}),
+    ...(guild?.actionHandoff !== undefined ? { actionHandoff: guild.actionHandoff } : {}),
+    realtime: { ...config.voice?.realtime, ...fallback?.realtime, ...guild?.realtime },
+  };
+}
+
+export function resolveDiscordGuildVoiceAccountConfig(
+  config: DiscordAccountConfig,
+  guildId: string,
+): DiscordAccountConfig {
+  const voice = resolveDiscordGuildVoiceConfig(config, guildId);
+  return voice === config.voice ? config : { ...config, voice };
+}

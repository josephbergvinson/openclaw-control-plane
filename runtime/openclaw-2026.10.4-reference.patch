@@ -0,0 +1,80 @@
+import { isDeepStrictEqual } from "node:util";
+import { isSystemEventStoreCurrent } from "../../../infra/system-event-ownership.js";
+import { captureOpenClawStateWorkerContext } from "../../../state/openclaw-state-worker-context.js";
+import {
+  assertMcpRequesterScopeMatches,
+  normalizeMcpRequesterScope,
+  type McpRequesterScopeContext,
+} from "../../mcp-requester-scope.js";
+import { getCurrentSubagentRunOwner, subagentRuns } from "./subagent-registry-memory.js";
+import type { SubagentRunRecord } from "./subagent-registry.types.js";
+import { loadSubagentSessionEntry } from "./subagent-session-reconciliation.js";
+
+/** Transfer only the partition owned by this native queued registration and its incarnations. */
+export function captureQueuedSubagentMcpRequesterScope(params: {
+  entry: SubagentRunRecord;
+  runs?: Map<string, SubagentRunRecord>;
+  assertCurrent: () => void;
+}): McpRequesterScopeContext | undefined {
+  if (params.entry.requesterMcpScope === undefined) {
+    return undefined;
+  }
+  const observed = params.entry;
+  const scope = normalizeMcpRequesterScope(observed.requesterMcpScope);
+  const launch = structuredClone(observed.queuedLaunch);
+  const state = captureOpenClawStateWorkerContext();
+  const assertCurrent = () => {
+    params.assertCurrent();
+    state.admission.assertCurrent();
+    const current = getCurrentSubagentRunOwner(params.runs ?? subagentRuns, observed);
+    if (
+      !scope ||
+      !current ||
+      current.execution.status !== "queued" ||
+      current.execution.endedAt !== undefined ||
+      current.killIntent ||
+      current.killReconciliation ||
+      current.execution.restartRecovery ||
+      current.cleanupHandled ||
+      current.cleanupCompletedAt !== undefined ||
+      current.collect !== true ||
+      current.swarmLaunchPending !== true ||
+      !isSystemEventStoreCurrent(
+        current.requesterSessionKey,
+        current.requesterStorePath,
+        current.requesterAgentId,
+      ) ||
+      !isDeepStrictEqual(current.queuedLaunch, launch) ||
+      captureOpenClawStateWorkerContext().admission.identity.key !== state.admission.identity.key
+    ) {
+      throw new Error("MCP requester queued registration is no longer current");
+    }
+    assertMcpRequesterScopeMatches(
+      normalizeMcpRequesterScope(current.requesterMcpScope),
+      scope,
+      "queued",
+    );
+    const child = loadSubagentSessionEntry({
+      childSessionKey: current.childSessionKey,
+      childAgentId: current.childAgentId,
+    });
+    const parent = loadSubagentSessionEntry({
+      childSessionKey: current.requesterSessionKey,
+      childAgentId: current.requesterAgentId,
+    });
+    if (
+      !current.childSessionIdentity?.sessionId ||
+      !current.childSessionIdentity.lifecycleRevision ||
+      child?.sessionId !== current.childSessionIdentity.sessionId ||
+      child.lifecycleRevision !== current.childSessionIdentity.lifecycleRevision ||
+      !current.completionRequesterSessionId ||
+      parent?.sessionId !== current.completionRequesterSessionId ||
+      (current.completionRequesterLifecycleRevision !== undefined &&
+        parent.lifecycleRevision !== current.completionRequesterLifecycleRevision)
+    ) {
+      throw new Error("MCP requester queued session incarnation changed");
+    }
+  };
+  assertCurrent();
+  return { mcpRequesterScope: scope, mcpRequesterScopeAssertCurrent: assertCurrent };
+}

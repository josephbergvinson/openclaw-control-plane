+
+const BROWSER_CREDENTIAL_ALIAS_PATTERN = /^[a-z][a-z0-9_-]{0,63}$/;
+const BROWSER_CREDENTIAL_SECRET_INPUT_SCHEMA = buildSecretInputSchema();
+
+type BrowserConfidentialField = Readonly<{
+  name: string;
+  type: "text" | "tel" | "email" | "number";
+}>;
+
+export type BrowserCredentialBinding = Readonly<{
+  secret: SecretRef;
+  allowedOrigins: readonly string[];
+  loginHint?: string;
+  confidentialField?: BrowserConfidentialField;
+}>;
+
+type BrowserCredentialBindingMetadata = Readonly<{
+  alias: string;
+  allowedOrigins: readonly string[];
+  loginHint?: string;
+  confidentialField?: BrowserConfidentialField;
+}>;
+
+let configuredBindings = new Map<string, BrowserCredentialBinding>();
+
+function assertOnlyKeys(
+  record: Record<string, unknown>,
+  allowed: readonly string[],
+  label: string,
+) {
+  const allowedSet = new Set(allowed);
+  const unexpected = Object.keys(record)
+    .toSorted()
+    .filter((key) => !allowedSet.has(key));
+  if (unexpected.length > 0) {
+    throw new Error(`${label} contains unsupported keys: ${unexpected.join(", ")}`);
+  }
+}
+
+function normalizeStringList(value: unknown, label: string, maxItems?: number): string[] {
+  if (!Array.isArray(value) || value.length === 0) {
+    throw new Error(`${label} must be a non-empty string array`);
+  }
+  if (maxItems !== undefined && value.length > maxItems) {
+    throw new Error(`${label} must contain at most ${maxItems} entries`);
+  }
+  const normalized = value.map((entry) => {
+    if (typeof entry !== "string" || !entry || entry !== entry.trim()) {
+      throw new Error(`${label} must contain only non-empty strings`);
+    }
+    return entry;
+  });
+  if (new Set(normalized).size !== normalized.length) {
+    throw new Error(`${label} must not contain duplicates`);
+  }
+  return normalized;
+}
+
+function normalizeLoginHint(value: unknown, alias: string): string | undefined {
+  if (value === undefined) {
+    return undefined;
+  }
+  if (typeof value !== "string") {
+    throw new Error(
+      `Browser credential binding ${JSON.stringify(alias)} loginHint must be a non-empty printable string`,
+    );
+  }
+  if (
+    !value ||
+    value !== value.trim() ||
+    value.length > 320 ||
+    Array.from(value).some((character) => {
+      const codePoint = character.codePointAt(0) ?? 0;
+      return codePoint <= 0x1f || codePoint === 0x7f;
+    })
+  ) {
+    throw new Error(
+      `Browser credential binding ${JSON.stringify(alias)} loginHint must be a non-empty printable string`,
+    );
+  }
+  return value;
+}
+
+function parseBinding(alias: string, value: unknown): BrowserCredentialBinding {
+  if (!BROWSER_CREDENTIAL_ALIAS_PATTERN.test(alias)) {
+    throw new Error(`Invalid browser credential alias: ${JSON.stringify(alias)}`);
+  }
+  const record = isRecord(value) ? value : null;
+  if (!record) {
+    throw new Error(`Browser credential binding ${JSON.stringify(alias)} must be an object`);
+  }
+  assertOnlyKeys(
+    record,
+    ["secret", "allowedOrigins", "loginHint", "confidentialField"],
+    `Browser credential binding ${JSON.stringify(alias)}`,
+  );
+  if (!isRecord(record.secret)) {
+    throw new Error(
+      `Browser credential binding ${JSON.stringify(alias)} requires a SecretRef object`,
+    );
+  }
+  const parsedSecret = BROWSER_CREDENTIAL_SECRET_INPUT_SCHEMA.safeParse(record.secret);
+  if (!parsedSecret.success || typeof parsedSecret.data === "string") {
+    throw new Error(`Browser credential binding ${JSON.stringify(alias)} has an invalid SecretRef`);
+  }
+  const secret: SecretRef = parsedSecret.data;
+  const allowedOrigins = normalizeStringList(
+    record.allowedOrigins,
+    `Browser credential binding ${JSON.stringify(alias)} allowedOrigins`,
+    32,
+  ).map(normalizeBrowserCredentialExpectedOrigin);
+  const loginHint = normalizeLoginHint(record.loginHint, alias);
+  const field = record.confidentialField;
+  let confidentialField: BrowserConfidentialField | undefined;
+  if (field !== undefined) {
+    if (
+      !isRecord(field) ||
+      typeof field.name !== "string" ||
+      !/^[A-Za-z][A-Za-z0-9_:[\].-]{0,127}$/.test(field.name) ||
+      typeof field.type !== "string" ||
+      !["text", "tel", "email", "number"].includes(field.type)
+    ) {
+      throw new Error("Browser confidentialField requires an exact input name and supported type");
+    }
+    assertOnlyKeys(field, ["name", "type"], "Browser confidentialField");
+    confidentialField = Object.freeze({
+      name: field.name,
+      // SAFETY: The checks above require a string in the exact supported input-type enum.
+      type: field.type as BrowserConfidentialField["type"],
+    });
+  }
+  return Object.freeze({
+    secret: Object.freeze({ ...secret }),
+    allowedOrigins: Object.freeze(allowedOrigins),
+    ...(loginHint ? { loginHint } : {}),
+    ...(confidentialField ? { confidentialField } : {}),
+  });
+}
+
+/** Install the immutable process snapshot owned by this plugin registration. */
+export function configureBrowserCredentialBindings(pluginConfig: unknown): void {
+  const root = pluginConfig === undefined ? {} : isRecord(pluginConfig) ? pluginConfig : null;
+  if (!root) {
+    throw new Error("Browser plugin config must be an object");
+  }
+  assertOnlyKeys(root, ["credentialBindings"], "Browser plugin config");
+  const rawBindings = root.credentialBindings;
+  if (rawBindings === undefined) {
+    configuredBindings = new Map();
+    return;
+  }
+  const record = isRecord(rawBindings) ? rawBindings : null;
+  if (!record) {
+    throw new Error("browser credentialBindings must be an object");
+  }
+  const next = new Map<string, BrowserCredentialBinding>();
+  for (const alias of Object.keys(record).toSorted()) {
+    next.set(alias, parseBinding(alias, record[alias]));
+  }
+  configuredBindings = next;
+}
+
+export function getBrowserCredentialBinding(alias: string): BrowserCredentialBinding | undefined {
+  return configuredBindings.get(alias);
+}
+
+/** Return model-safe metadata only; SecretRef coordinates never cross this boundary. */
+export function listBrowserCredentialBindingMetadata(): BrowserCredentialBindingMetadata[] {
+  return Array.from(configuredBindings, ([alias, binding]) => ({
+    alias,
+    allowedOrigins: [...binding.allowedOrigins],
+    ...(binding.loginHint ? { loginHint: binding.loginHint } : {}),
+    ...(binding.confidentialField ? { confidentialField: { ...binding.confidentialField } } : {}),
+  }));
+}

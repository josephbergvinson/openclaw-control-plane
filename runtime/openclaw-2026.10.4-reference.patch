+
+export function createGoalSessionEntry(
+  status: SessionGoalStatus,
+  objective = "Publish the release evidence",
+): SessionEntry {
+  return {
+    sessionId: "goal-context-session",
+    updatedAt: 1,
+    goal: {
+      schemaVersion: 1,
+      id: "goal-context",
+      objective,
+      status,
+      createdAt: 1,
+      updatedAt: 1,
+      tokenStart: 0,
+      tokenStartFresh: true,
+      tokensUsed: 0,
+      continuationTurns: 0,
+    },
+  };
+}
+
+export function createChatWindowContext(params: {
+  chatType?: "private" | "group";
+  label?: string;
+  source?: string;
+  payload: Record<string, unknown>;
+  context?: Record<string, unknown>;
+}): TemplateContext {
+  return {
+    ...params.context,
+    ChatType: params.chatType ?? "private",
+    ChannelStructuredContext: [
+      {
+        label: params.label ?? "Current local chat window",
+        source: params.source ?? "telegram",
+        type: "chat_window",
+        payload: params.payload,
+      },
+    ],
+  } as TemplateContext;
+}
+
+type InboundConversationInfoCase = {

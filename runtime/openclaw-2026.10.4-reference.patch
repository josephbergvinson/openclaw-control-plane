+import { assert, describe, expect, it } from "vitest";
+import type { ChannelProgressDraftCompositorSnapshot } from "../../../channels/progress-draft-compositor.types.js";
+import { createDeferredCore } from "../../../shared/deferred.js";
+import { drain, fixture, row } from "./subagent-registry-progress.test-support.js";
+import type { SubagentRunRecord } from "./subagent-registry.types.js";
+import { buildRequesterSettleWakeIdentity } from "./subagent-requester-settle-identity.js";
+import { copySubagentRunRuntimeOwner } from "./subagent-run-generation.js";
+
+describe("native retained-child progress", () => {
+  it("relays only completed natural commentary once, preserving ordinary spawn ownership", async () => {
+    const f = fixture();
+    f.emit({ itemId: "note", delta: "The isolated checks passed; " });
+    expect(f.publish).not.toHaveBeenCalled();
+    f.emit({ itemId: "note", delta: "deployment is next." });
+    f.emit({ phase: "start", toolCallId: "tool", args: { secret: "private" } }, { stream: "tool" });
+    await drain();
+    expect(f.publish).toHaveBeenCalledOnce();
+    expect(f.publish.mock.calls[0]![0]).toMatchObject({
+      entry: f.initial,
+      source: { channel: "discord", accountId: "bot", to: "channel:parent" },
+      checkpoint: { text: "The isolated checks passed; deployment is next." },
+    });
+    f.completed("note", "The isolated checks passed; deployment is next.");
+    await drain();
+    expect(f.publish).toHaveBeenCalledOnce();
+    await f.owner.reset();
+  });
+  it("does not replay an uncertain send and permits later authored progress", async () => {
+    const f = fixture();
+    f.publish.mockRejectedValueOnce(new Error("platform acceptance unknown"));
+    f.completed("one", "The code is fixed; verification is next.");
+    await drain();
+    f.completed("one", "The code is fixed; verification is next.");
+    f.setClock(180_000);
+    f.owner.checkpoint();
+    await drain();
+    expect(f.publish).toHaveBeenCalledOnce();
+    f.completed("two", "Verification passed; activation is next.");
+    await drain();
+    expect(f.publish).toHaveBeenCalledTimes(2);
+    await f.owner.reset();
+  });
+  it("requests one authored checkpoint at forty-five seconds under revocable exact-run custody", async () => {
+    const f = fixture();
+    f.setClock(44_999);
+    f.owner.checkpoint();
+    await drain();
+    expect(f.requestCheckpoint).not.toHaveBeenCalled();
+    f.setClock(45_000);
+    f.owner.checkpoint();
+    f.owner.checkpoint();
+    await drain();
+    expect(f.requestCheckpoint).toHaveBeenCalledOnce();
+    const request = f.requestCheckpoint.mock.calls[0]![0];
+    expect(request).toMatchObject({
+      entry: f.initial,
+      queueIdentity: "subagent-progress:child-run:0",
+    });
+    expect(request.signal.aborted).toBe(false);
+    request.assertCurrent();
+    f.completed("reply", "The first checks passed; the release remains in progress.");
+    await drain();
+    expect(request.signal.aborted).toBe(true);
+    expect(request.assertCurrent).toThrow();
+    await f.owner.reset();
+  });
+  it("retires queued checkpoints and pending sends on row replacement or gateway teardown", async () => {
+    const f = fixture();
+    f.setClock(180_000);
+    f.owner.checkpoint();
+    await drain();
+    const request = f.requestCheckpoint.mock.calls[0]![0];
+    f.runs.set(f.initial.runId, row({ generation: 2 }));
+    f.changes();
+    expect(request.signal.aborted).toBe(true);
+    expect(request.assertCurrent).toThrow();
+    await f.owner.reset();

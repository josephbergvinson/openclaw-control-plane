+      const source = host.hostCapabilities.sourcePreservingContext!;
+      const snapshot = source.read();
+      await manager.appendMessageAsync(makeUserMessage("later unrelated turn", 2));
+      snapshot.splice(0);
+      expect(source.read()).toEqual([makeUserMessage("original durable fact", 1)]);
+      host.closeHost();
+      expect(() => source.read()).toThrow();
+    } finally {
+      host.closeHost();
+      host.closeAdmission();
+    }
+  });
+
+  it("charges the full post-injection body and never subtracts native headroom twice", async () => {
+    const manager = SessionManager.inMemory(process.cwd());
+    await manager.appendMessageAsync(makeUserMessage("original", 1));
+    const budgets: unknown[] = [];
+    const host = await createAdmittedHostCapabilityTestFixture({
+      runId: "source-pressure",
+      trigger: "memory",
+      sessionManager: manager,
+      onCompactionRequestBudget: (budget, messages) => {
+        if (!budget) {
+          return;
+        }
+        budgets.push(budget);
+        assertMemoryExtractionRequestFits(messages ?? [], budget);
+      },
+    });
+    try {
+      const before = { input: [{ role: "user", content: "original" }], instructions: "native" };
+      const final = {
+        ...before,
+        instructions: before.instructions + "\n\n" + "parent policy ".repeat(800),
+      };
+      const source = host.hostCapabilities.sourcePreservingContext!;
+      source.checkRequest({
+        usableContextWindow: 100_000,
+        estimatedRequestTokens: 400,
+        beforeHostAddition: before,
+        finalRequest: final,
+        effectsStarted: false,
+      });
+      expect(budgets).toEqual([
+        expect.objectContaining({ contextWindow: 100_000, reserveTokens: 0, pendingTokens: 0 }),
+      ]);
+      expect(() =>
+        source.checkRequest({
+          usableContextWindow: estimateJsonPayloadTokenPressure(before) + 100,
+          estimatedRequestTokens: 400,
+          beforeHostAddition: before,
+          finalRequest: final,
+          effectsStarted: false,
+        }),
+      ).toThrow(MemoryExtractionBudgetError);
+    } finally {
+      host.closeHost();
+      host.closeAdmission();
+    }
+  });
+
+  it("uses native image-aware pressure and charges only exact host text while rejecting other changes", async () => {
+    const data = Buffer.alloc(1024 * 1024, 7).toString("base64");
+    const manager = SessionManager.inMemory(process.cwd());
+    await manager.appendMessageAsync({
+      role: "user",
+      content: [{ type: "image", mimeType: "image/png", data }],
+      timestamp: 1,
+    });
+    const budgets: unknown[] = [];
+    const host = await createAdmittedHostCapabilityTestFixture({
+      runId: "source-image-pressure",
+      trigger: "memory",
+      sessionManager: manager,
+      onCompactionRequestBudget: (budget, messages) => {
+        if (!budget) {
+          return;
+        }
+        budgets.push(budget);
+        assertMemoryExtractionRequestFits(messages ?? [], budget);
+      },
+    });
+    try {
+      const source = host.hostCapabilities.sourcePreservingContext!;
+      const before = {
+        input: [{ type: "input_image", image_url: `data:image/png;base64,${data}` }],
+        instructions: "native",
+      };
+      const final = { ...before, instructions: before.instructions + "\n\nparent policy" };
+      expect(estimateJsonPayloadTokenPressure(final)).toBeGreaterThan(20_000);
+      expect(() =>
+        source.checkRequest({
+          usableContextWindow: 20_000,
+          estimatedRequestTokens: 12_000,
+          beforeHostAddition: before,
+          finalRequest: final,
+          effectsStarted: false,
+        }),
+      ).not.toThrow();
+      expect(budgets).toHaveLength(1);
+      expect(() =>
+        source.checkRequest({
+          usableContextWindow: 20_000,
+          estimatedRequestTokens: 12_000,
+          beforeHostAddition: before,
+          finalRequest: { ...final, input: [] },
+          effectsStarted: false,
+        }),
+      ).toThrow(/outside its prepared instructions/);
+    } finally {
+      host.closeHost();
+      host.closeAdmission();
+    }
+  });
+
+  it("publishes native effects before checking a rejected final request", async () => {
+    const manager = SessionManager.inMemory(process.cwd());
+    await manager.appendMessageAsync(makeUserMessage("original", 1));
+    const phases: Array<string | undefined> = [];
+    const host = await createAdmittedHostCapabilityTestFixture({
+      runId: "source-effects",
+      trigger: "memory",
+      sessionManager: manager,
+      onCompactionRequestBudget: (budget, messages, phase) => {
+        phases.push(phase);
+        if (budget) {
+          assertMemoryExtractionRequestFits(messages ?? [], budget);
+        }
+      },
+    });
+    try {
+      expect(() =>
+        host.hostCapabilities.sourcePreservingContext!.checkRequest({
+          usableContextWindow: 1,
+          estimatedRequestTokens: 1_000,
+          beforeHostAddition: {},
+          finalRequest: {},
+          effectsStarted: true,
+        }),
+      ).toThrow(MemoryExtractionBudgetError);
+      expect(phases).toEqual(["effects-started", "prepared"]);
+    } finally {
+      host.closeHost();
+      host.closeAdmission();
+    }
+  });
+});

index 0000000000000000000000000000000000000000..e3b673bae14e27c809c0833fbaad523b4b8180af
--- /dev/null
+++ b/src/agents/embedded-agent-runner/runs.publication-wait.ts
@@ -0,0 +1,150 @@
+/** Publication phase of the existing native embedded-run waiter lifecycle. */
+import { normalizeOptionalString } from "@openclaw/normalization-core/string-coerce";
+import type {
+  ReplyBackendHandle,
+  ReplyOperation,
+} from "../../auto-reply/reply/reply-run-registry.contracts.js";
+import {
+  getAttachedBackend,
+  resolveReplyRunForSessionKey,
+} from "../../auto-reply/reply/reply-run-registry.state.js";
+import {
+  getAgentEventLifecycleGeneration,
+  isAgentEventLifecycleGenerationCurrent,
+} from "../../infra/agent-events.js";
+import { createDeferredCore } from "../../shared/deferred.js";
+import { captureReplyMessageInjectionTarget } from "./message-injection-target.js";
+import {
+  ACTIVE_EMBEDDED_RUNS,
+  ACTIVE_EMBEDDED_RUN_REGISTRATIONS,
+  EMBEDDED_RUN_WAITERS,
+  type EmbeddedRunWaiter,
+} from "./run-state.js";
+
+export function notifyEmbeddedRunPublished(sessionId: string): void {
+  const waiters = EMBEDDED_RUN_WAITERS.get(sessionId);
+  if (!waiters) {
+    return;
+  }
+  const handle = ACTIVE_EMBEDDED_RUNS.get(sessionId);
+  for (const waiter of waiters) {
+    const expected = waiter.publication;
+    if (!expected) {
+      continue;
+    }
+    const operation = expected.replyOperation;
+    const current =
+      isAgentEventLifecycleGenerationCurrent(expected.lifecycleGeneration) &&
+      resolveReplyRunForSessionKey(expected.sessionKey) === operation &&
+      !operation.result &&
+      !operation.abortSignal.aborted;
+    // A predecessor registration cannot wake or invalidate the queued owner's subscription.
+    if (current && (!handle || getAttachedBackend(operation) !== handle)) {
+      continue;
+    }
+    const registration = handle && ACTIVE_EMBEDDED_RUN_REGISTRATIONS.get(handle);
+    let registrationCurrent = false;
+    if (
+      current &&
+      handle &&
+      registration?.sessionId === sessionId &&
+      registration.sessionKey === expected.sessionKey &&
+      registration.toolAuthority &&
+      handle.messageInjectionV2?.version === 2
+    ) {
+      try {
+        registration.toolAuthority.assertActive();
+        registrationCurrent = true;
+      } catch {}
+    }
+    const target =
+      current && registrationCurrent && handle?.runId && getAttachedBackend(operation) === handle
+        ? captureReplyMessageInjectionTarget({
+            normalizedSessionKey: normalizeOptionalString(expected.sessionKey),
+            operation: resolveReplyRunForSessionKey(expected.sessionKey),
+          })
+        : undefined;
+    if (current && registrationCurrent && !target?.runId) {
+      continue;
+    }
+    waiters.delete(waiter);
+    const registered = Boolean(target?.runId && target.runId === handle?.runId);
+    if (registered && handle) {
+      waiter.handle = handle;
+      expected.registration = registration;
+    }
+    waiter.resolve(registered);
+  }
+  if (waiters.size === 0) {
+    EMBEDDED_RUN_WAITERS.delete(sessionId);
+  }
+}
+
+export async function waitForEmbeddedRunPublication(params: {
+  sessionId: string;
+  sessionKey: string;
+  replyOperation: ReplyOperation;
+  ownerReleased: Promise<void>;
+  abortSignal?: AbortSignal;
+  onRegistered?: (backend: ReplyBackendHandle) => void;
+}): Promise<"registered" | "released" | "invalidated"> {
+  params.abortSignal?.throwIfAborted();
+  const lifecycleGeneration = getAgentEventLifecycleGeneration();
+  const publication = createDeferredCore<boolean>();
+  const waiter: EmbeddedRunWaiter = {
+    publication: {
+      sessionKey: params.sessionKey,
+      lifecycleGeneration,
+      replyOperation: params.replyOperation,
+    },
+    resolve: (registered) => publication.resolve(registered),
+  };
+  const waiters = EMBEDDED_RUN_WAITERS.get(params.sessionId) ?? new Set<EmbeddedRunWaiter>();
+  waiters.add(waiter);
+  EMBEDDED_RUN_WAITERS.set(params.sessionId, waiters);
+  const onAbort = () => publication.resolve(false);
+  params.abortSignal?.addEventListener("abort", onAbort, { once: true });
+  try {
+    // Subscribe before the synchronous recheck: no lost publication edge.
+    notifyEmbeddedRunPublished(params.sessionId);
+    const result = await Promise.race([
+      publication.promise.then((registered) =>
+        registered ? ("registered" as const) : ("invalidated" as const),
+      ),
+      params.ownerReleased.then(() => "released" as const),
+    ]);
+    params.abortSignal?.throwIfAborted();
+    if (!isAgentEventLifecycleGenerationCurrent(lifecycleGeneration)) {
+      return "invalidated";
+    }
+    if (result === "registered") {
+      const backend = getAttachedBackend(params.replyOperation);
+      const embedded = ACTIVE_EMBEDDED_RUNS.get(params.sessionId);
+      const registration = embedded && ACTIVE_EMBEDDED_RUN_REGISTRATIONS.get(embedded);
+      if (
+        !backend ||

@@ -0,0 +1,188 @@
+import { createDeferred } from "openclaw/plugin-sdk/extension-shared";
+import { defineDiscordVoiceTests } from "./voice-test-harness.test-support.js";
+
+defineDiscordVoiceTests(
+  ({
+    expect,
+    it,
+    vi,
+    createAgentProxyManager,
+    createJoinedBidiFixture,
+    getSessionEntry,
+    beginSpeakerTurn,
+    lastRealtimeBridge,
+    realtimeBridgeAt,
+    realtimeSessionMock,
+    createRealtimeVoiceBridgeSessionMock,
+    resolveConfiguredRealtimeVoiceProviderMock,
+    resolveRealtimeVoiceAgentContextInstructionsMock,
+    registerRealtimeVoiceSelectionMock,
+  }) => {
+    const profiles = () =>
+      resolveRealtimeVoiceAgentContextInstructionsMock.mockImplementation(async (input) => {
+        const request = input as { files?: string[]; additionalAgentIds?: string[] };
+        if (request.files?.length === 0) {
+          return "";
+        }
+        return request.additionalAgentIds
+          ? "Primary private owner record. Verified u-owner is Alice Example. Room policy."
+          : "Room record: Alice and Bob are collaborators.";
+      });
+    const voices = () =>
+      resolveConfiguredRealtimeVoiceProviderMock.mockImplementation((params) => ({
+        provider: { id: "openai" },
+        capabilities: { supportsActivationNameGating: true, voices: ["cedar", "marin"] },
+        providerConfig: {
+          model: "gpt-realtime-2",
+          voice: "cedar",
+          ...params?.providerConfigOverrides,
+        },
+      }));
+
+    it("selects from a catalog without opening a provider before speaker admission", async () => {
+      profiles();
+      voices();
+      const manager = createAgentProxyManager();
+      try {
+        expect((await manager.join({ guildId: "g1", channelId: "1001" })).ok).toBe(true);
+        const selection = registerRealtimeVoiceSelectionMock.mock.calls.at(-1)![0];
+        expect(selection.read()).toMatchObject({ voice: "cedar", canChange: true });
+        await selection.changeVoice("marin", { assertCurrent: () => {} });
+        expect(selection.read()).toMatchObject({ voice: "marin" });
+        expect(createRealtimeVoiceBridgeSessionMock).not.toHaveBeenCalled();
+        beginSpeakerTurn(getSessionEntry(manager)).close();
+        expect(lastRealtimeBridge().bridgeParams.instructions).toContain('"userId":"u-owner"');
+      } finally {
+        await manager.destroy();
+      }
+    });
+
+    it("binds the verified owner and whole composed profile before the first pre-ready audio chunk", async () => {
+      profiles();
+      const connected = createDeferred<void>();
+      realtimeSessionMock.connect.mockReturnValueOnce(connected.promise);
+      const manager = createAgentProxyManager();
+      try {
+        await manager.join({ guildId: "g1", channelId: "1001" });
+        beginSpeakerTurn(getSessionEntry(manager), { speakerLabel: "Display alias" }).close();
+        const request = lastRealtimeBridge().bridgeParams;
+        expect(request.instructions).toContain('"userId":"u-owner"');
+        expect(request.instructions).toContain('"speakerLabel":"Display alias"');
+        expect(request.instructions).toContain("Verified u-owner is Alice Example");
+        expect(realtimeSessionMock.sendAudio).toHaveBeenCalled();
+      } finally {
+        connected.resolve();
+        await manager.destroy();
+      }
+    });
+
+    it.each([false, true])(
+      "keeps private primary context off guest connections and through voice replacement (handoff=%s)",
+      async (actionHandoff) => {
+        profiles();
+        voices();
+        const style = "Speak with a male, posh southern British accent.";
+        const f = await createJoinedBidiFixture({
+          voice: { actionHandoff, realtime: { instructions: style } },
+        });
+        try {
+          const owner = lastRealtimeBridge().bridgeParams;
+          expect(owner.instructions).toContain("Primary private owner record");
+          expect(owner.instructions).toContain(style);
+          expect(owner.instructions).toContain("acknowledgment");
+          beginSpeakerTurn(f.entry, {
+            userId: "u-guest",
+            senderIsOwner: false,
+            speakerLabel: "Bob",
+          }).close();
+          const guest = lastRealtimeBridge().bridgeParams;
+          expect(guest.instructions).toContain("Room record");
+          expect(guest.instructions).not.toContain("Primary private owner record");
+          expect(guest.instructions).toContain('"userId":"u-guest"');
+          await registerRealtimeVoiceSelectionMock.mock.calls
+            .at(-1)![0]
+            .changeVoice("marin", { assertCurrent: () => {} });
+          const count = createRealtimeVoiceBridgeSessionMock.mock.calls.length;
+          const replacement: [typeof owner, typeof guest] = [
+            realtimeBridgeAt(count - 2).bridgeParams,
+            realtimeBridgeAt(count - 1).bridgeParams,
+          ];
+          expect(replacement[0].instructions).toContain("Primary private owner record");
+          expect(replacement[0].instructions).toContain('"userId":"u-owner"');
+          expect(replacement[1].instructions).not.toContain("Primary private owner record");
+          expect(replacement[1].instructions).toContain('"userId":"u-guest"');
+          expect(replacement.every((request) => request.instructions?.includes(style))).toBe(true);
+        } finally {
+          await f.manager.destroy();
+        }
+      },
+    );
+
+    it("does not silently admit room-only context after required owner context fails", async () => {
+      resolveRealtimeVoiceAgentContextInstructionsMock
+        .mockResolvedValueOnce("Room policy")
+        .mockRejectedValueOnce(new Error("Required owner profile unavailable"));
+      const manager = createAgentProxyManager();
+      try {
+        expect(await manager.join({ guildId: "g1", channelId: "1001" })).toMatchObject({
+          ok: false,
+        });
+        expect(createRealtimeVoiceBridgeSessionMock).not.toHaveBeenCalled();
+      } finally {
+        await manager.destroy();
+      }
+    });
+
+    it("respects an explicitly disabled profile without claiming a supplied private record", async () => {
+      profiles();
+      const f = await createJoinedBidiFixture({
+        voice: { realtime: { bootstrapContextFiles: [] } },
+      });
+      try {
+        expect(f.bridgeParams.instructions).not.toContain("Primary private owner record");
+        expect(f.bridgeParams.instructions).not.toContain("Room record:");
+        expect(f.bridgeParams.instructions).toContain("Check records for missing or fresh facts");
+      } finally {
+        await f.manager.destroy();
+      }
+    });
+
+    it("does not adopt an unbound voice candidate after its host authority expires", async () => {
+      profiles();
+      voices();
+      const manager = createAgentProxyManager();
+      try {
+        await manager.join({ guildId: "g1", channelId: "1001" });
+        const selection = registerRealtimeVoiceSelectionMock.mock.calls.at(-1)![0];
+        let checks = 0;
+        await expect(
+          selection.changeVoice("marin", {
+            assertCurrent: () => {
+              if (++checks > 1) {
+                throw new Error("Authority expired");
+              }
+            },
+          }),
+        ).rejects.toThrow("Authority expired");
+        expect(selection.read()).toMatchObject({ voice: "cedar" });
+        expect(createRealtimeVoiceBridgeSessionMock).not.toHaveBeenCalled();
+      } finally {
+        await manager.destroy();
+      }
+    });
+
+    it("retires an unavailable first provider instead of leaving a silent connected room", async () => {
+      profiles();
+      realtimeSessionMock.connect.mockRejectedValueOnce(new Error("provider unavailable"));
+      const manager = createAgentProxyManager();
+      try {
+        await manager.join({ guildId: "g1", channelId: "1001" });
+        beginSpeakerTurn(getSessionEntry(manager));
+        await vi.waitFor(() => expect(manager.status()).toEqual([]));
+        expect(realtimeSessionMock.close).toHaveBeenCalled();
+      } finally {
+        await manager.destroy();
+      }
+    });
+  },
+);

+        );
+        await vi.waitFor(
+          () =>
+            expect(
+              getExistingFollowupQueue(key),
+              describeStage("retained source settlement"),
+            ).toBeUndefined(),
+          fastWait,
+        );
+        if (!("writes" in harness)) {
+          throw new Error("Expected the real native client wire fixture");
+        }
+        const physicalSteers = harness.writes
+          .map((line) => JSON.parse(line) as { method?: string; params?: unknown })

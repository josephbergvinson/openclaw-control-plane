index 0000000000000000000000000000000000000000..3a83152f3e509c26a663899a7b078891925fe6ed
--- /dev/null
+++ b/apps/macos/Tests/OpenClawIPCTests/CuaDriverHostTerminationTests.swift
@@ -0,0 +1,215 @@
+import Foundation
+import OpenClawIPC
+import Testing
+@testable import OpenClaw
+
+@Suite(.serialized)
+@MainActor
+struct CuaDriverHostTerminationTests {
+    @Test func `final parent exit stops its child before a stalled worker drain resumes`() async throws {
+        let root = try ExecApprovalsSocketTestSupport.makeRoot()
+        defer { try? FileManager.default.removeItem(at: root) }
+        let drain = CuaTerminationGate()
+        let probe = CuaTerminationProbe()
+        let coordinator = self.coordinator(root: root, probe: probe, beforeStop: { await drain.wait() })
+        let siblingProbe = CuaTerminationProbe(exitsOnEOF: true)
+        let sibling = self.coordinator(root: root.appendingPathComponent("sibling"), probe: siblingProbe)
+        await sibling.setEnabled(true)
+        await coordinator.setEnabled(true)
+        #expect(coordinator.workerEndpoint != nil)
+        let shutdown = Task { await coordinator.shutdown() }
+        #expect(await self.waitUntil { drain.entered })
+        // Ordinary shutdown must still drain the worker before closing liveness.
+        #expect(probe.child.isRunning)
+        #expect(probe.child.closeLivenessCount == 0)
+
+        coordinator.prepareForApplicationTermination()
+        #expect(coordinator.workerEndpoint == nil)
+        #expect(!probe.child.isRunning)
+        #expect(probe.child.closeLivenessCount == 1)
+        #expect(probe.child.terminateCount == 1)
+        #expect(probe.child.forceKillCount == 0)
+        #expect(siblingProbe.child.isRunning)
+        #expect(sibling.workerEndpoint != nil)
+        #expect(siblingProbe.child.closeLivenessCount == 0)
+        coordinator.prepareForApplicationTermination()
+        #expect(probe.child.terminateCount == 1)
+
+        // This drain deliberately ignores cancellation, as the observed quit did.
+        drain.open()
+        await shutdown.value
+        await coordinator.setEnabled(true)
+        #expect(probe.launchCount == 1)
+        #expect(coordinator.workerEndpoint == nil)
+        #expect(probe.child.terminateCount == 1)
+        #expect(probe.child.forceKillCount == 0)
+        await sibling.shutdown()
+    }
+
+    @Test func `normal shutdown retains worker drain and EOF without unnecessary termination`() async throws {
+        let root = try ExecApprovalsSocketTestSupport.makeRoot()
+        defer { try? FileManager.default.removeItem(at: root) }
+        let probe = CuaTerminationProbe(exitsOnEOF: true)
+        let coordinator = self.coordinator(root: root, probe: probe, beforeStop: {
+            #expect(probe.child.isRunning)
+            #expect(probe.child.closeLivenessCount == 0)
+            probe.drained = true
+        })
+        await coordinator.setEnabled(true)
+        await coordinator.shutdown()
+        #expect(probe.drained)
+        #expect(!probe.child.isRunning)
+        #expect(probe.child.terminateCount == 0)
+        coordinator.prepareForApplicationTermination()
+        coordinator.prepareForApplicationTermination()
+        #expect(probe.child.terminateCount == 0)
+        #expect(probe.child.forceKillCount == 0)
+    }
+
+    @Test(arguments: [false, true])
+    func `late startup cannot publish or relaunch after final parent exit`(holdPermissions: Bool) async throws {
+        let root = try ExecApprovalsSocketTestSupport.makeRoot()
+        defer { try? FileManager.default.removeItem(at: root) }
+        let gate = CuaTerminationGate()
+        let probe = CuaTerminationProbe()
+        let coordinator = CuaDriverHostCoordinator(
+            notificationCenter: NotificationCenter(),
+            artifactURL: { root.appendingPathComponent("cua-driver") },
+            applicationSupportURL: { root },
+            bundleIdentifier: { "ai.openclaw.test" },
+            processLauncher: { _, onTermination in probe.launch(onTermination) },
+            readinessProbe: { _ in
+                if !holdPermissions { await gate.wait() }
+                return true
+            },
+            permissionSnapshot: {
+                if holdPermissions { await gate.wait() }
+                return [:]
+            })
+        let startup = Task { await coordinator.setEnabled(true) }
+        #expect(await self.waitUntil { gate.entered })
+        coordinator.prepareForApplicationTermination()
+        #expect(!probe.child.isRunning)
+        gate.open()
+        await startup.value
+        await coordinator.setEnabled(true)
+        #expect(probe.launchCount == 1)
+        #expect(coordinator.workerEndpoint == nil)
+        #expect(probe.child.terminateCount == 1)
+        #expect(probe.child.forceKillCount == 0)
+    }
+
+    @Test func `late ordinary stop cannot escalate after the final parent exit hook`() async throws {
+        let root = try ExecApprovalsSocketTestSupport.makeRoot()
+        defer { try? FileManager.default.removeItem(at: root) }
+        let probe = CuaTerminationProbe(exitsOnTerminate: false)
+        let coordinator = self.coordinator(root: root, probe: probe)
+        await coordinator.setEnabled(true)
+        let shutdown = Task { await coordinator.shutdown() }
+        #expect(await self.waitUntil { probe.child.closeLivenessCount == 1 })
+        coordinator.prepareForApplicationTermination()
+        await shutdown.value
+        #expect(coordinator.workerEndpoint == nil)
+        #expect(probe.child.terminateCount == 1)
+        #expect(probe.child.forceKillCount == 0)
+        probe.child.exit()
+    }
+
+    private func coordinator(
+        root: URL,
+        probe: CuaTerminationProbe,
+        beforeStop: @escaping @MainActor () async -> Void = {}) -> CuaDriverHostCoordinator
+    {
+        CuaDriverHostCoordinator(
+            notificationCenter: NotificationCenter(),
+            artifactURL: { root.appendingPathComponent("cua-driver") },
+            applicationSupportURL: { root },
+            bundleIdentifier: { "ai.openclaw.test" },
+            processLauncher: { _, onTermination in probe.launch(onTermination) },
+            readinessProbe: { _ in true },
+            permissionSnapshot: { [:] },
+            beforeDaemonStop: beforeStop)
+    }
+
+    private func waitUntil(_ condition: @MainActor () -> Bool) async -> Bool {
+        let deadline = ContinuousClock.now + .seconds(2)
+        while !condition(), ContinuousClock.now < deadline {
+            try? await Task.sleep(for: .milliseconds(1))
+        }
+        return condition()
+    }
+}
+
+@MainActor
+private final class CuaTerminationGate {
+    private(set) var entered = false
+    private var isOpen = false
+    private var waiter: CheckedContinuation<Void, Never>?
+
+    func wait() async {
+        self.entered = true
+        guard !self.isOpen else { return }
+        await withCheckedContinuation { self.waiter = $0 }
+    }
+
+    func open() {
+        self.isOpen = true
+        self.waiter?.resume()
+        self.waiter = nil
+    }
+}
+
+@MainActor
+private final class CuaTerminationProbe {
+    let child: CuaTerminationProcess
+    private(set) var launchCount = 0
+    var drained = false
+
+    init(exitsOnEOF: Bool = false, exitsOnTerminate: Bool = true) {
+        self.child = CuaTerminationProcess(exitsOnEOF: exitsOnEOF, exitsOnTerminate: exitsOnTerminate)
+    }
+
+    func launch(_ onTermination: @escaping @Sendable (Int32) -> Void) -> CuaTerminationProcess {
+        self.launchCount += 1
+        self.child.onTermination = onTermination
+        return self.child
+    }
+}
+
+@MainActor
+private final class CuaTerminationProcess: CuaDriverProcessControlling {
+    private(set) var isRunning = true
+    private(set) var closeLivenessCount = 0
+    private(set) var terminateCount = 0
+    private(set) var forceKillCount = 0
+    let processIdentifier: pid_t = 424_242
+    var onTermination: (@Sendable (Int32) -> Void)?
+    private let exitsOnEOF: Bool
+    private let exitsOnTerminate: Bool
+
+    init(exitsOnEOF: Bool, exitsOnTerminate: Bool) {
+        self.exitsOnEOF = exitsOnEOF
+        self.exitsOnTerminate = exitsOnTerminate
+    }
+
+    func closeLiveness() {
+        self.closeLivenessCount += 1
+        if self.exitsOnEOF { self.exit() }
+    }
+
+    func terminate() {
+        self.terminateCount += 1
+        if self.exitsOnTerminate { self.exit() }
+    }
+
+    func forceKill() {
+        self.forceKillCount += 1
+        self.exit()
+    }
+
+    func exit() {
+        guard self.isRunning else { return }
+        self.isRunning = false
+        self.onTermination?(0)
+    }
+}

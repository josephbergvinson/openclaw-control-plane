diff --git a/src/agents/tools/computer-tool.deadline.test.ts b/src/agents/tools/computer-tool.deadline.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..98743d856a21cf9823968da2d5e29d413451fa96
--- /dev/null
+++ b/src/agents/tools/computer-tool.deadline.test.ts
@@ -0,0 +1,93 @@
+import { beforeEach, describe, expect, it } from "vitest";
+import {
+  callGatewayToolMock,
+  createVisionComputerTool,
+  resetComputerToolMocks,
+  screenshotPayload,
+} from "./computer-tool.test-helpers.js";
+
+beforeEach(resetComputerToolMocks);
+
+function typeCalls() {
+  return callGatewayToolMock.mock.calls.filter(
+    ([method, , request]) =>
+      method === "node.invoke" &&
+      request.command === "computer.act" &&
+      request.params?.action === "type",
+  );
+}
+
+describe("Computer operation deadlines", () => {
+  it.each([
+    { requested: undefined, expected: 120_000 },
+    { requested: 7_000, expected: 7_000 },
+    { requested: 60_000, expected: 60_000 },
+    { requested: 180_000, expected: 120_000 },
+  ])("bounds typing at both RPC and node with $requested", async ({ requested, expected }) => {
+    const tool = createVisionComputerTool();
+    await tool.execute("type-fixture", {
+      action: "type",
+      text: "synthetic fixture",
+      timeoutMs: requested,
+    });
+    const calls = typeCalls();
+    expect(calls).toHaveLength(1);
+    expect(calls[0]?.[1]).toMatchObject({ timeoutMs: expected });
+    expect(calls[0]?.[2]).toMatchObject({ command: "computer.act", timeoutMs: expected });
+  });
+
+  it("applies each read deadline on a cached host while retaining its Gateway credentials", async () => {
+    const tool = createVisionComputerTool();
+    const gatewayUrl = "wss://deadline-fixture.example";
+    const gatewayToken = "synthetic-fixture-token";
+    await tool.execute("first-read", {
+      action: "screenshot",
+      gatewayUrl,
+      gatewayToken,
+      timeoutMs: 7_000,
+    });
+    await tool.execute("later-read", { action: "screenshot", timeoutMs: 60_000 });
+    let call = callGatewayToolMock.mock.calls.at(-1);
+    expect(call?.[1]).toEqual({ gatewayUrl, gatewayToken, timeoutMs: 60_000 });
+    expect(call?.[2]).toMatchObject({ command: "screen.snapshot", timeoutMs: 60_000 });
+    await tool.execute("default-read", { action: "screenshot" });
+    call = callGatewayToolMock.mock.calls.at(-1);
+    expect(call?.[1]).toEqual({ gatewayUrl, gatewayToken, timeoutMs: undefined });
+    expect(call?.[2]).toMatchObject({ command: "screen.snapshot", timeoutMs: undefined });
+    const count = callGatewayToolMock.mock.calls.length;
+    await expect(
+      tool.execute("changed-server", {
+        action: "screenshot",
+        gatewayUrl: "wss://different-fixture.example",
+        timeoutMs: 1_000,
+      }),
+    ).rejects.toThrow("bound to its Gateway connection");
+    expect(callGatewayToolMock.mock.calls).toHaveLength(count);
+  });
+
+  it("forwards cancellation and never repeats input after an ambiguous timeout", async () => {
+    const failure = new Error("gateway request timeout for node.invoke");
+    callGatewayToolMock.mockImplementation(async (_method, _options, request) => {
+      if (request.command === "computer.act" && request.params?.action === "type") {
+        throw failure;
+      }
+      return screenshotPayload();
+    });
+    const tool = createVisionComputerTool();
+    const signal = new AbortController().signal;
+    await expect(
+      tool.execute(
+        "uncertain-input",
+        {
+          action: "type",
+          text: "synthetic fixture",
+          timeoutMs: 7_000,
+        },
+        signal,
+      ),
+    ).rejects.toBe(failure);
+    const calls = typeCalls();
+    expect(calls).toHaveLength(1);
+    expect(calls[0]?.[3]).toEqual({ signal });
+  });
+});
diff --git a/src/agents/tools/computer-tool.native-credentials.test.ts b/src/agents/tools/computer-tool.native-credentials.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ef3f0cd87363d0304236585fdb3f51004ba3f312
--- /dev/null
+++ b/src/agents/tools/computer-tool.native-credentials.test.ts
@@ -0,0 +1,55 @@
+import { describe, expect, it } from "vitest";
+import { parseComputerActParamsJSON } from "../../plugins/computer-use-contract.js";
+import { buildComputerToolDescription } from "./computer-tool-guidance.js";
+import { buildComputerActParams } from "./computer-tool-request.js";
+import { createComputerToolSchema } from "./computer-tool-schema.js";
+
+const executionId = "11111111-1111-4111-8111-111111111111";
+describe("native opaque credential tool route", () => {
+  it("passes only host-owned prompt authority to the native action", () => {
+    const wire = buildComputerActParams({
+      action: "type_secret",
+      executionId,
+      screenIndex: 0,
+      input: { alias: "apple.fixture.password", promptRef: "native-credential:v1:fixture" },
+    });
+    expect(parseComputerActParamsJSON(JSON.stringify(wire))).toEqual({
+      action: "type_secret",
+      executionId,
+      alias: "apple.fixture.password",
+      promptRef: "native-credential:v1:fixture",
+    });
+  });
+  it.each(["text", "value", "windowRef", "elementRef", "observationId", "coordinate"])(
+    "rejects ordinary input field %s instead of dropping a potentially sensitive value",
+    (key) => {
+      expect(() =>
+        buildComputerActParams({
+          action: "type_secret",
+          executionId,
+          screenIndex: 0,
+          input: { alias: "fixture", promptRef: "fixture", [key]: "not-a-credential-route" },
+        }),
+      ).toThrow("only alias and promptRef");
+    },
+  );
+  it("advertises credential fields only on a supporting host", () => {
+    expect(createComputerToolSchema(["type"]).properties).not.toHaveProperty("alias");
+    expect(
+      createComputerToolSchema(["credential_prompts", "type_secret"]).properties,
+    ).toHaveProperty("promptRef");
+  });
+  it("describes the account-bound route without telling the agent to retrieve secrets", () => {
+    const description = buildComputerToolDescription({
+      contractVersion: 2,
+      provider: { id: "cua", label: "CUA", generation: "fixture" },
+      actions: ["credential_prompts", "type_secret"],
+      targets: ["screen"],
+      deliveryModes: ["foreground"],
+      observations: ["image"],
+      features: { recording: true, agentCursor: false, multiDisplay: true },
+    });
+    expect(description).toContain("credential_prompts");
+    expect(description).toContain("do not retrieve a password");
+  });
+});

@@ -0,0 +1,26 @@
+import type { McpOAuthIdentity } from "./mcp-oauth-identity.js";
+import type { McpOAuthStore } from "./mcp-oauth-store.types.js";
+
+export const MCP_OAUTH_TOKEN_EXPIRY_SKEW_MS = 30_000;
+
+/** Read-only admission and token resolution share the same expiry boundary. */
+export function requiresMcpOAuthReauthorization(
+  store: Pick<McpOAuthStore, "tokens" | "tokenExpiresAt" | "pendingAuthorizationChallenge">,
+): boolean {
+  return (
+    store.pendingAuthorizationChallenge?.requiresAuthorization === true ||
+    (store.tokens !== undefined &&
+      !store.tokens.refresh_token &&
+      store.tokenExpiresAt !== undefined &&
+      store.tokenExpiresAt <= Date.now() + MCP_OAUTH_TOKEN_EXPIRY_SKEW_MS)
+  );
+}
+
+/** Requesters reconnect in their conversation; operators use their CLI login. */
+export function mcpOAuthAuthorizationError(identity: McpOAuthIdentity, reason: string): Error {
+  const guidance =
+    identity.principal === "requester"
+      ? "Use this conversation's MCP connect tool to sign in again."
+      : `Run openclaw mcp login ${identity.serverName}.`;
+  return new Error(`MCP server "${identity.serverName}" ${reason}. ${guidance}`);
+}

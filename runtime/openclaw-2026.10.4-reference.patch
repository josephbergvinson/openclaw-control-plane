+}
+beforeEach(() => {
+  configureBrowserCredentialBindings({
+    credentialBindings: {
+      account: {
+        secret: { source: "exec", provider: "synthetic", id: "secret-id" },
+        allowedOrigins: ["https://93.184.216.34"],
+      },
+    },
+  });
+  mocks.fill.mockClear();
+  mocks.console.mockReset().mockResolvedValue([{ type: "log", text: "ordinary console output" }]);
+});
+afterEach(() => configureBrowserCredentialBindings({}));
+describe("existing Browser routes retain ordinary behavior around opaque entry", () => {
+  it("keeps ordinary reads available while redacting only registered values at the response boundary", async () => {
+    const sentinel = "synthetic-route-confidential-value";
+    registerSecretValueForRedaction(sentinel);
+    mocks.console.mockResolvedValueOnce([
+      { text: `value=${sentinel}` },
+      { text: "ordinary console output" },
+    ]);
+    const f = fixture();
+    const response = await f.dispatch({
+      method: "GET",
+      path: "/console",
+      query: { targetId: "tab-1" },
+    });
+    expect(response.status).toBe(200);
+    expect(JSON.stringify(response.body)).toContain("[REDACTED]");
+    expect(JSON.stringify(response.body)).toContain("ordinary console output");
+    expect(JSON.stringify(response.body)).not.toContain(sentinel);
+    expect((await f.dispatch({ method: "GET", path: "/tabs" })).status).toBe(200);
+  });
+  it("preserves native JSON semantics for dates, buffers and custom toJSON values", async () => {
+    mocks.console.mockResolvedValueOnce([
+      {
+        at: new Date("2026-10-06T00:00:00Z"),
+        bytes: Buffer.from([1, 2]),
+        custom: { toJSON: () => ({ label: "ordinary" }) },
+      },
+    ]);
+    const response = await fixture().dispatch({
+      method: "GET",
+      path: "/console",
+      query: { targetId: "tab-1" },
+    });
+    expect(response.status).toBe(200);
+    const json = JSON.stringify(response.body);
+    expect(json).toContain('"at":"2026-10-06T00:00:00.000Z"');
+    expect(json).toContain('"bytes":{"type":"Buffer","data":[1,2]}');
+    expect(json).toContain('"custom":{"label":"ordinary"}');

+
+/** Keep each continuous output's capture epochs and played-PCM drain together. */
+export function createDiscordRealtimePlaybackRecordings(params: {
+  id: number;
+  recordingCredit: Int32Array;
+  playback: Pick<DiscordRealtimePlaybackParams<unknown>, "bindCaptureReceipts">;
+  playbackRecording: DiscordVoicePlaybackRecording | undefined;
+  beforeFinish: () => Promise<void>;
+}) {
+  const recordings = new Map<bigint, ReturnType<DiscordVoicePlaybackRecording["create"]>>();
+  const recordingReceipts = params.playback.bindCaptureReceipts?.((capture) => {
+    for (const [epoch, recording] of recordings) {
+      if (epoch !== capture?.recordingEpoch) {
+        void recording.finish().finally(() => {
+          if (recordings.get(epoch) === recording) {
+            recordings.delete(epoch);
+          }
+        });
+      }
+    }
+    if (!capture?.recordingEpoch || recordings.has(capture.recordingEpoch)) {
+      return;
+    }
+    const recording = params.playbackRecording?.create({
+      capture,
+      beforeFinish: params.beforeFinish,
+    });
+    if (recording) {
+      recordings.set(capture.recordingEpoch, recording);
+    }
+  });
+  const finishRecordings = (retainUntilDrained = false) => {
+    const admitted = [...recordings.values()];
+    if (!retainUntilDrained) {
+      recordings.clear();
+    }
+    const finished = Promise.all(admitted.map((recording) => recording.finish())).then(
+      () => undefined,
+    );
+    if (retainUntilDrained) {
+      void finished.finally(() => recordings.clear());
+    }
+    return finished;
+  };
+  const onPlayed = (event: DiscordAudioEvent) => {
+    if (!("id" in event) || event.id !== params.id) {
+      return;
+    }
+    if (event.type === "output-played") {
+      try {
+        let recording = recordings.get(event.recordingEpoch);
+        if (!recording) {
+          const capture = recordingReceipts?.resolve(event.recordingEpoch);
+          if (capture) {
+            recording = params.playbackRecording?.create({
+              capture,
+              beforeFinish: params.beforeFinish,
+            });
+            if (recording) {
+              recordings.set(event.recordingEpoch, recording);
+            }
+          }
+        }
+        recording?.onPlayedPcm(Buffer.from(event.pcm), event.playedAt);
+      } finally {
+        Atomics.sub(params.recordingCredit, 0, event.pcm.byteLength);
+      }
+    }
+  };
+  return { recordingReceipts, finishRecordings, onPlayed };
+}

+  const expectedIds = projection.expectedHomeIds;
+  if (
+    new Set(homeIds).size !== homeIds.length ||
+    new Set(expectedIds).size !== expectedIds.length ||
+    JSON.stringify([...homeIds].toSorted()) !== JSON.stringify([...expectedIds].toSorted())
+  ) {
+    throw new Error("Native projection does not match the complete admitted home set");
+  }

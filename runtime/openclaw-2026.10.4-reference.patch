+++ b/apps/macos/Tests/OpenClawIPCTests/LocalGatewayAuthParentTests.swift
@@ -0,0 +1,60 @@
+import Foundation
+import Testing
+@testable import OpenClawMacCLI
+
+/// Synthetic kernel/signature facts only; never reads a live process or Keychain.
+@MainActor
+struct LocalGatewayAuthParentTests {
+    enum Scenario: CaseIterable {
+        case app, probe, legacyNode, externalBun, unrelatedOwner, changedRuntimePath,
+             changedRuntimeStart, changedOwnerStart, changedParent,
+             invalidSeal, invalidRuntimeSignature, invalidOwnerSignature
+    }
+
+    @Test(arguments: Scenario.allCases)
+    func `local auth requires the sealed Bun and its current signed owner`(_ scenario: Scenario) {
+        let bundle = URL(fileURLWithPath: "/fixture/OpenClaw.app")
+        let bun = bundle.appendingPathComponent("Contents/Resources/runtime/bin/bun").path
+        let app = bundle.appendingPathComponent("Contents/MacOS/OpenClaw").path
+        let probe = bundle.appendingPathComponent("Contents/MacOS/openclaw-mac").path
+        let owner = scenario == .probe ? probe : app
+        var reads: [Int32: Int] = [:]
+        let environment = LocalGatewayAuthIPC.ParentEnvironment(
+            bundle: { bundle },
+            parentPID: { scenario == .changedParent && reads[101, default: 0] > 0 ? 202 : 101 },
+            process: { pid in
+                reads[pid, default: 0] += 1
+                let later = reads[pid, default: 0] > 1
+                let path: String = if pid == 101 {
+                    switch scenario {
+                    case .legacyNode: bundle.appendingPathComponent("Contents/Resources/node-worker/arm64/bin/node")
+                        .path
+                    case .externalBun: "/opt/bun/bin/bun"
+                    case .changedRuntimePath where later: "/bin/zsh"
+                    default: bun
+                    }
+                } else {
+                    scenario == .unrelatedOwner ? "/bin/zsh" : owner
+                }
+                let changed = later && (pid == 101 && scenario == .changedRuntimeStart ||
+                    pid == 201 && scenario == .changedOwnerStart)
+                return .init(
+                    pid: pid,
+                    parent: pid == 101 ? 201 : 1,
+                    startedSeconds: changed ? 20 : 10,
+                    startedMicroseconds: 5,
+                    path: path)
+            },
+            sealedBundle: { $0 == bundle && scenario != .invalidSeal },
+            signedHash: { pid, path in
+                guard path.path == (pid == 101 ? bun : owner),
+                      !(pid == 101 && scenario == .invalidRuntimeSignature),
+                      !(pid == 201 && scenario == .invalidOwnerSignature)
+                else { return nil }
+                return Data(repeating: 1, count: 20)
+            })
+        let result = LocalGatewayAuthIPC.parentIdentity(environment: environment)
+        let expected = "201:10:5:" + String(repeating: "01", count: 20)
+        #expect(scenario == .app || scenario == .probe ? result == expected : result == nil)
+    }
+}

+  });
+
+  it("never retries an accepted verified announcement after a partial-delivery failure", async () => {
+    vi.stubEnv("OPENCLAW_TEST_FAST", "1");
+    const { service, job, marker } = await fixture();
+    mocks.agent.mockImplementation(async () => {
+      await fs.writeFile(marker, "restored");
+      return { status: "ok" };
+    });
+    mocks.send.mockImplementation(async (params) => {
+      expect(params.payload.text).toBe("capacity restored");
+      params.onDeliveryAttempt?.(true);
+      throw new OutboundDeliveryError("later chunk failed", {
+        cause: new PlatformMessageNotDispatchedError("later chunk not dispatched", {
+          cause: new Error("later chunk rejected before dispatch"),
+        }),
+        results: [{ channel: "telegram", messageId: "accepted-final-result" }],
+        stage: "platform_send",
+      });
+    });
+    await service.cron.run(job.id, "force");
+    expect(mocks.send).toHaveBeenCalledOnce();
+    expect(service.cron.getJob(job.id)?.state).toMatchObject({
+      lastRunStatus: "ok",
+      lastDeliveryStatus: "not-delivered",
+      lastDeliveryError: expect.stringContaining("later chunk failed"),
+    });
+  });
+
+  it.each([
+    { name: "successful initial command", initialExit: 0, repair: true, status: "ok" },
+    { name: "unselected initial exit", initialExit: 2, repair: true, status: "error" },
+    { name: "ordinary unrepaired failure", initialExit: 1, repair: false, status: "error" },
+  ] as const)("keeps $name reporting unchanged", async ({ initialExit, repair, status }) => {
+    const { service, job } = await fixture({ initialExit, repair });
+    await service.cron.run(job.id, "force");
+    expect(mocks.agent).not.toHaveBeenCalled();
+    expect(mocks.send).toHaveBeenCalledOnce();
+    expect(mocks.send.mock.calls[0]?.[0].payload.text).toBe("initial command result");
+    expect(service.cron.getJob(job.id)?.state).toMatchObject({
+      lastRunStatus: status,
+      lastDeliveryStatus: "delivered",
+    });
+  });
+
+  it("keeps an opted-in repair with delivery:none private", async () => {
+    const { service, job, marker } = await fixture({ delivery: { mode: "none" } });
+    mocks.agent.mockImplementation(async () => {
+      await fs.writeFile(marker, "restored");
+      return { status: "ok" };
+    });
+    await service.cron.run(job.id, "force");
+    expect(mocks.agent).toHaveBeenCalledOnce();
+    expect(mocks.send).not.toHaveBeenCalled();
+    expect(service.cron.getJob(job.id)?.state).toMatchObject({
+      lastRunStatus: "ok",
+      lastDeliveryStatus: "not-requested",
+    });
+  });
+});

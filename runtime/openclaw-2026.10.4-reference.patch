@@ -0,0 +1,466 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { createDeferred } from "../../../test/helpers/promise.js";
+import { registerAgentSessionLoopTestLifecycle } from "../../agents/sessions/agent-session-loop-correctness.test-support.js";
+import { createSecretsTool } from "../../agents/tools/secrets-tool.js";
+import type { dispatchInboundMessage } from "../../auto-reply/dispatch.js";
+import type { AgentTurnParams } from "../../auto-reply/reply/agent-runner-execution.types.js";
+import { mintReplyMessageActionTurnCapability } from "../../auto-reply/reply/agent-runner-utils.js";
+import {
+  admitFollowupTurn,
+  type AdmittedFollowupTurn,
+  type FollowupRunnerParams,
+} from "../../auto-reply/reply/followup-turn-admission.js";
+import { executeFollowupTurn } from "../../auto-reply/reply/followup-turn-execution.js";
+import type { FollowupRun } from "../../auto-reply/reply/queue.js";
+import {
+  listSessionPendingInputs,
+  loadSessionEntry,
+  loadTranscriptEventsSync,
+  patchSessionEntryCore,
+} from "../../config/sessions/session-accessor.js";
+import { initializeGlobalHookRunner } from "../../plugins/hook-runner-global.js";
+import { readSecretStoreValue } from "../../secrets/store/secret-store.js";
+import { refusePendingInputCommit } from "../pending-input-commit.test-support.js";
+import { dispatchInboundMessageMock, installGatewayTestHooks } from "../test-helpers.js";
+import { getTestPluginRegistry } from "../test-helpers.plugin-registry.js";
+import { handleDirectExternalChatSend } from "./chat-send-external-entry.js";
+import { useBrowserFollowupFixture } from "./chat-send-pending-inputs.test-support.js";
+import { createProvidedInputStore } from "./secrets.provided-input.test-support.js";
+import type { RespondFn } from "./types.js";
+
+const model = vi.hoisted(() => ({ execute: vi.fn() }));
+vi.mock("../../auto-reply/reply/agent-runner-execution.js", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("../../auto-reply/reply/agent-runner-execution.js")>()),
+  executeAgentTurn: (...args: unknown[]) => model.execute(...args),
+}));
+vi.mock("../../auto-reply/reply/agent-runner-utils.js", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("../../auto-reply/reply/agent-runner-utils.js")>()),
+  // Admission/bootstrap secret resolution is outside this store-source fixture.
+  resolveQueuedReplyExecutionConfig: async (config: unknown) => config,
+}));
+
+installGatewayTestHooks();
+registerAgentSessionLoopTestLifecycle();
+const createBrowserFollowupFixture = useBrowserFollowupFixture();
+type Dispatch = Parameters<typeof dispatchInboundMessage>[0];
+const storeScope = { kind: "team" } as const;
+const storeName = "CUI_PROVIDED_INPUT_TEST";
+
+afterEach(() => {
+  model.execute.mockReset();
+});
+
+async function createAdmittedInput(options: { rewrite?: boolean } = {}) {
+  const fixture = await createBrowserFollowupFixture({
+    preserveContent: options.rewrite !== true,
+  });
+  fixture.client.internal = { authenticatedControlUi: true };
+  fixture.params.message = "TOKEN: native-approved dummy !;";
+  const captured = createDeferred<Dispatch>();
+  const originalDispatch = dispatchInboundMessageMock.getMockImplementation();
+  if (!originalDispatch) {
+    throw new Error("Expected the existing native followup fixture execution pause");
+  }
+  dispatchInboundMessageMock.mockImplementation(async (...args) => {
+    // SAFETY: The native chat.send entry calls this spy with dispatchInboundMessage's input.
+    captured.resolve(args[0] as Dispatch);
+    return await originalDispatch(...args);
+  });
+  const send = async () => {
+    const respond = vi.fn<RespondFn>();
+    await handleDirectExternalChatSend({
+      req: { type: "req", id: fixture.params.idempotencyKey, method: "chat.send" },
+      params: fixture.params,
+      client: fixture.client,
+      context: fixture.context,
+      respond,
+      isWebchatConnect: () => true,
+    });
+    return respond;
+  };
+  const run: FollowupRun["run"] = {
+    agentId: fixture.scope.agentId,
+    agentDir: "/tmp/provided-source-agent",
+    sessionId: fixture.scope.sessionId,
+    sessionKey: fixture.scope.sessionKey,
+    sessionFile: "/tmp/provided-source-session.jsonl",
+    workspaceDir: "/tmp",
+    config: fixture.context.getRuntimeConfig(),
+    provider: "anthropic",
+    model: "claude",
+    messageProvider: "webchat",
+    timeoutMs: 1_000,
+    blockReplyBreak: "message_end",
+  };
+  const queuedFor = (dispatch: Dispatch): FollowupRun => ({
+    prompt: "Native model stand-in: import the supplied field.",
+    transcriptPrompt: "Native model stand-in: import the supplied field.",
+    enqueuedAt: Date.now(),
+    messageId: fixture.params.idempotencyKey,
+    originatingChannel: "webchat",
+    originatingChatType: "direct",
+    run,
+    userTurnTranscriptRecorder: dispatch.replyOptions?.userTurnTranscriptRecorder,
+    dashboardReadAdmission: dispatch.replyOptions?.dashboardReadAdmission,
+    turnAdoptionLifecycle: dispatch.replyOptions?.turnAdoptionLifecycle,
+    disableCollectBatching: true,
+  });
+  const mint = (dispatch: Dispatch) =>
+    mintReplyMessageActionTurnCapability(
+      {
+        followupRun: queuedFor(dispatch),
+        sessionCtx: dispatch.ctx,
+        opts: dispatch.replyOptions,
+        isHeartbeat: false,
+      },
+      fixture.params.idempotencyKey,
+    );
+  const importToken = async (token: string | undefined, runId = fixture.params.idempotencyKey) => {
+    if (!token) {
+      throw new Error("Expected native authenticated input capability");
+    }
+    const store = createProvidedInputStore({
+      token,
+      runId,
+      sessionId: fixture.scope.sessionId,
+      sessionKey: fixture.scope.sessionKey,
+    });
+    try {
+      const tool = createSecretsTool({ gatewayCall: store.gatewayCall });
+      const result = await tool.execute("native-cui-import", {
+        action: "import",
+        name: storeName,
+        field: "TOKEN",
+      });
+      expect(JSON.stringify(result)).not.toContain("native-approved dummy");
+      expect(JSON.stringify(store.requests)).not.toContain("native-approved dummy");
+      return result;
+    } finally {
+      store.close();
+    }
+  };
+  return { fixture, captured: captured.promise, send, run, queuedFor, mint, importToken };
+}
+
+describe("approved native CUI input supplies private secret source", () => {
+  it("uses the real approved SQLite custody before ACK, not an input callback populated by the test", async () => {
+    const input = await createAdmittedInput();
+    try {
+      const response = await input.send();
+      expect(response).toHaveBeenCalledWith(
+        true,
+        expect.objectContaining({ status: "started" }),
+        undefined,
+        expect.anything(),
+      );
+      const dispatch = await input.captured;
+      expect(input.fixture.beforeApprove).toHaveBeenCalled();
+      const pending = await listSessionPendingInputs(input.fixture.scope);
+      expect(pending).toMatchObject({
+        total: 1,
+        items: [
+          {
+            message: {
+              role: "user",
+              content: expect.any(String),
+              idempotencyKey: input.fixture.params.idempotencyKey + ":user",
+            },
+          },
+        ],
+      });
+      // SQLite custody keeps a masked projection; the original remains only
+      // behind the approved native getter exercised by the actual import below.
+      expect(JSON.stringify(pending)).not.toContain("native-approved dummy !;");
+      expect(loadTranscriptEventsSync(input.fixture.scope)).toEqual(input.fixture.activeTranscript);
+      const result = await input.importToken(input.mint(dispatch));
+      expect(result.details).toMatchObject({ status: "stored", kind: "secret" });
+      expect(await readSecretStoreValue({ scope: storeScope, name: storeName })).toEqual({
+        ok: true,
+        value: "native-approved dummy !;",
+      });
+    } finally {
+      await input.fixture.cleanup();
+    }
+  });
+
+  it("never resurrects the submitted bytes after the real before-write hook rewrites custody", async () => {
+    const input = await createAdmittedInput({ rewrite: true });
+    try {
+      await input.send();
+      const dispatch = await input.captured;
+      expect(await listSessionPendingInputs(input.fixture.scope)).toMatchObject({
+        total: 1,
+        items: [{ message: { content: input.fixture.approvedContent } }],
+      });
+      await expect(input.importToken(input.mint(dispatch))).rejects.toThrow(
+        "Approved original source is unavailable",
+      );
+      expect((await readSecretStoreValue({ scope: storeScope, name: storeName })).ok).toBe(false);
+    } finally {
+      await input.fixture.cleanup();
+    }
+  });
+
+  it.each([false, true])(
+    "keeps the accepted source separate from a changed same-id body (lost identity=%s)",
+    async (lostIdentity) => {
+      const input = await createAdmittedInput();
+      try {
+        await input.send();
+        const dispatch = await input.captured;
+        input.fixture.params.message = "TOKEN: unrelated-replay-value";
+        if (lostIdentity) {
+          // Native in-flight fallback acknowledges existing work after RAM loss;
+          // that response must neither dispatch nor adopt the replacement body.
+          input.fixture.context.dedupe.clear();
+        }
+        dispatchInboundMessageMock.mockClear();
+        const replay = await input.send();
+        if (lostIdentity) {
+          expect(replay).toHaveBeenCalledWith(
+            true,
+            { runId: input.fixture.params.idempotencyKey, status: "in_flight" },
+            undefined,
+            expect.objectContaining({ cached: true }),
+          );
+        } else {
+          expect(replay).toHaveBeenCalledWith(
+            false,
+            undefined,
+            expect.objectContaining({ details: { reason: "chat-request-conflict" } }),
+          );
+        }
+        expect(dispatchInboundMessageMock).not.toHaveBeenCalled();
+        await input.importToken(input.mint(dispatch));
+        expect(await readSecretStoreValue({ scope: storeScope, name: storeName })).toEqual({
+          ok: true,
+          value: "native-approved dummy !;",
+        });
+      } finally {
+        await input.fixture.cleanup();
+      }
+    },
+  );
+
+  it("does not capture a rejected native hook body or dispatch it", async () => {
+    const input = await createAdmittedInput();
+    const registry = getTestPluginRegistry();
+    registry.typedHooks.length = 0;
+    registry.typedHooks.push({
+      pluginId: "provided-source-rejection",
+      hookName: "before_message_write",
+      source: "test",
+      handler: () => ({ block: true }),
+    });
+    initializeGlobalHookRunner(registry);
+    try {
+      const response = await input.send();
+      expect(response.mock.calls.some(([ok]) => ok)).toBe(false);
+      expect(dispatchInboundMessageMock).not.toHaveBeenCalled();
+      expect(await listSessionPendingInputs(input.fixture.scope)).toEqual({ total: 0, items: [] });
+      expect((await readSecretStoreValue({ scope: storeScope, name: storeName })).ok).toBe(false);
+    } finally {
+      await input.fixture.cleanup();
+    }
+  });
+
+  it("does not grant source custody on native pending worker commit failure, then accepts the actual same-id retry", async () => {
+    const input = await createAdmittedInput();
+    const refusal = refusePendingInputCommit({
+      operation: "stage",
+      message: "custody unavailable",
+      sessionId: input.fixture.scope.sessionId,
+      runId: input.fixture.params.idempotencyKey,
+    });
+    try {
+      const response = await input.send();
+      expect(response.mock.calls.some(([ok]) => ok)).toBe(false);
+      expect(dispatchInboundMessageMock).not.toHaveBeenCalled();
+      expect(await listSessionPendingInputs(input.fixture.scope)).toEqual({ total: 0, items: [] });
+      expect(loadTranscriptEventsSync(input.fixture.scope)).toEqual(input.fixture.activeTranscript);
+      refusal.mockRestore();
+      await input.send();
+      const dispatch = await input.captured;
+      await input.importToken(input.mint(dispatch));
+      expect(await readSecretStoreValue({ scope: storeScope, name: storeName })).toEqual({
+        ok: true,
+        value: "native-approved dummy !;",
+      });
+    } finally {
+      refusal.mockRestore();
+      await input.fixture.cleanup();
+    }
+  });
+
+  it.each(["admin", "session", "client"] as const)(
+    "rechecks native %s after approval before the store write",
+    async (change) => {
+      const input = await createAdmittedInput();
+      try {
+        await input.send();
+        const dispatch = await input.captured;
+        const token = input.mint(dispatch);
+        if (change === "admin") {
+          input.fixture.client.connect.scopes = ["operator.read", "operator.write"];
+        } else if (change === "client") {
+          input.fixture.client.invalidated = true;
+        } else {
+          await patchSessionEntryCore(input.fixture.scope, () => ({
+            sessionId: "replacement-session",
+          }));
+        }
+        await expect(input.importToken(token)).rejects.toThrow();
+        expect((await readSecretStoreValue({ scope: storeScope, name: storeName })).ok).toBe(false);
+      } finally {
+        await input.fixture.cleanup();
+      }
+    },
+  );
+
+  it("keeps source unavailable for a writable CUI caller without native admin authority", async () => {
+    const input = await createAdmittedInput();
+    input.fixture.client.connect.scopes = ["operator.read", "operator.write"];
+    try {
+      await input.send();
+      const dispatch = await input.captured;
+      expect(dispatch.replyOptions?.dashboardReadAdmission?.providedUserSource).toBeUndefined();
+      await expect(input.importToken(input.mint(dispatch))).rejects.toThrow();
+      expect((await readSecretStoreValue({ scope: storeScope, name: storeName })).ok).toBe(false);
+    } finally {
+      await input.fixture.cleanup();
+    }
+  });
+
+  it.each(["same", "message", "session", "revoked"] as const)(

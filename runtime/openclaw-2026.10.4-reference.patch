+  }
+  if (context.guildLifecycles.get(guildId) !== lifecycle) {
+    return { ok: false, message: "The voice session changed. Please retry leaving it." };
+  }
+  if (
+    lifecycle &&
+    (lifecycle.status === "starting" || lifecycle.status === "active") &&
+    lifecycle.instance.channelId !== channelId
+  ) {
+    return { ok: false, message: "Not connected to that voice channel." };
+  }
+  return await context.leave({ guildId, channelId });
+}

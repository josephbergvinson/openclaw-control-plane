+    onRegistered: (published) => {
+      backend = published;
+    },
+  })
+    .then(async (result) => {
+      if (result === "registered" && backend) {
+        await retryRetainedFollowupSteers(operation, backend);
+      }
+    })
+    .catch((error: unknown) => {
+      if (!operation.abortSignal.aborted) {
+        logVerbose(`queue: retained steer publication failed: ${formatErrorMessage(error)}`);
+      }
+    });
+}
+
+/** Retain delivery and admission on the queue's original row, never a later message's dispatcher. */
+export function bindRetainedReplySteerSource(params: ActiveReplySteerParams): void {
+  const { followupRun, opts } = params;
+  if (followupRun.retrySteer) {
+    return;
+  }
+  const originalOperation = params.providedReplyOperation;
+  const disposition = followupRun.queuedFollowupReplyDisposition;
+  const deliver = disposition?.kind === "deliver" ? disposition.deliver : undefined;
+  const blockReply = disposition === undefined ? opts?.onBlockReply : undefined;
+  const settle = opts?.onQueuedFollowupSettled;
+  if (
+    !originalOperation ||
+    originalOperation.key !== params.queueKey ||
+    params.sessionCtx.InboundEventKind === "room_event" ||
+    (followupRun.run.inputProvenance?.kind !== undefined &&
+      followupRun.run.inputProvenance.kind !== "external_user") ||
+    (!deliver && !blockReply)
+  ) {
+    return;
+  }
+  let sourceTurnId: string;
+  try {
+    sourceTurnId = resolveAcceptedSteerRunId(params);
+  } catch {
+    return;
+  }
+  followupRun.retrySteer = async (operation, reservation) => {
+    const authority = resolveReplySteeringAuthority(followupRun, operation);
+    if (operation !== originalOperation || authority.shouldQueueAuthorityMismatch) {
+      reservation.fallback();
+      return "deferred";
+    }
+    const result = await runActiveReplySteer({
+      ...params,
+      providedReplyOperation: operation,
+      releaseAdmissionTicket: () => {},
+      touchActiveSessionEntry: async () => {},
+      ...authority,
+      retainedReservation: reservation,
+    });
+    if (result !== "handled") {
+      if (deliver) {
+        await deliver({
+          kind: "queued-followup",
+          runId: sourceTurnId,
+          originatingChannel: followupRun.originatingChannel,
+          payloads: [result],
+          completion: {
+            kind: "failed",
+            error: result.text ?? "Input delivery could not be confirmed.",
+          },
+        });
+      } else if (blockReply) {
+        let failed = false;
+        let deliveryError: unknown;
+        try {
+          await blockReply(result);
+        } catch (error) {
+          failed = true;
+          deliveryError = error;
+        }
+        try {
+          await settle?.();
+        } catch (error) {
+          if (!failed) {
+            throw error;
+          }
+          logVerbose(
+            `queue: retained source cleanup failed; preserving delivery error: ${formatErrorMessage(error)}`,
+          );
+        }
+        if (failed) {
+          throw deliveryError;
+        }
+      }
+    }
+    return getExistingFollowupQueue(params.queueKey)?.items.includes(followupRun)
+      ? "deferred"
+      : "consumed";
+  };
+}
+
+export function wakeRetainedReplySteerSource(
+  source: FollowupRun,
+  operation?: ReplyOperation,
+): void {
+  if (source.retrySteer && operation) {
+    retryRetainedFollowupSteersAfterPublication(operation);
+  }
+}

+  it.each(["outside", "foreign-old"] as const)(
+    "materializes Goal tools under captured host usage from %s context",
+    async (context) => {
+      const [{ createOpenClawTestState }, accessor, goals, usage] = await Promise.all([
+        import("../../test-utils/openclaw-test-state.js"),
+        import("../../config/sessions/session-accessor.js"),
+        import("../../config/sessions/goals.js"),
+        import("../session-goal-usage.js"),
+      ]);
+      const state = await createOpenClawTestState({ label: "host-goal-retained-context" });
+      const { attempt } = await admittedAttempt("goal-retained-host", {
+        workspaceDir: state.workspaceDir,
+        cwd: state.workspaceDir,
+      });
+      const target = {
+        agentId: "main",
+        sessionKey: attempt.sessionKey!,
+        sessionId: attempt.sessionId,
+        storePath: path.join(state.sessionsDir(), "sessions.json"),
+        lifecycleRevision: "native-revision",
+        activeWriterRunId: attempt.runId,
+      };
+      const config = {
+        session: { store: target.storePath },
+        tools: { web: { search: { enabled: false } } },
+      };
+      const authority = getAdmittedRunDelegatedAuthority(attempt.admittedRunContext);
+      const createRun = (instanceId: string, tokens: number) =>
+        usage.createSessionGoalUsageRun({
+          runId: attempt.runId,
+          admissionId: attempt.admittedRunContext.operationalRunInstance.instanceId,
+          instanceId,
+          operationalRunInstance: attempt.admittedRunContext.operationalRunInstance,
+          initialScope: target,
+          readTarget: () => target,
+          readRunTokens: () => tokens,
+          assertCurrent: () => {
+            if (
+              !authority ||
+              getAdmittedRunDelegatedAuthority(attempt.admittedRunContext) !== authority
+            ) {
+              throw new Error("source revoked");
+            }
+          },
+        });
+      let host: ReturnType<typeof createAgentHarnessHostCapabilities> | undefined;
+      let current: ReturnType<typeof createRun> | undefined;
+      let older: ReturnType<typeof createRun> | undefined;
+      try {
+        await accessor.upsertSessionEntryCore(target, { ...target, updatedAt: 1 });
+        const goal = await goals.createSessionGoal({
+          ...target,
+          objective: "Finish the original work",
+        });
+        // A prior fallback may share textual run/admission labels and the same
+        // operational object. Its different accumulator must never seed this host.
+        older = createRun("older-accumulator", 9000);
+        current = createRun("current-accumulator", 0);
+        host = usage.withSessionGoalUsageRun(current, () =>
+          createAgentHarnessHostCapabilities({ attempt, pluginId: "codex" }),
+        );
+        host.capabilities.bindAcceptedAttemptUsage!(() => ({ input: 100, output: 10, total: 110 }));
+        const options = {
+          config,
+          agentSessionKey: target.sessionKey,
+          runSessionKey: target.sessionKey,
+          runId: attempt.runId,
+          workspaceDir: state.workspaceDir,
+        };
+        const materialize = () => host!.capabilities.createToolSurface!(options);
+        const tools =
+          context === "foreign-old"
+            ? usage.withSessionGoalUsageRun(older, materialize)
+            : materialize();
+        const get = tools.find((tool) => tool.name === "get_goal");
+        const edit = tools.find((tool) => tool.name === "update_goal");
+        expect(get).toBeDefined();
+        expect(edit).toBeDefined();
+        expect((await get!.execute("read-current", {})).details).toMatchObject({
+          goal: { id: goal.id, tokensUsed: 110 },
+        });
+        expect(
+          (
+            await edit!.execute("human-edit", {
+              objective: "Finish the revised work",
+              goal_id: goal.id,
+            })
+          ).details,
+        ).toMatchObject({
+          goal: { id: goal.id, objective: "Finish the revised work", tokensUsed: 110 },
+        });
+        expect(accessor.loadSessionEntry(target)?.goalUsage?.run?.instanceId).toBe(
+          "current-accumulator",
+        );
+        expect(older.observe()?.tokens).toBe(9000);
+        await usage.settleSessionGoalUsageRun(current, async () => {});
+        expect(accessor.loadSessionEntry(target)?.goal?.tokensUsed).toBe(110);
+        host.close();
+        expect(materialize).toThrow("no longer active");
+        await expect(get!.execute("closed-read", {})).rejects.toThrow("no longer active");
+      } finally {
+        host?.close();
+        current?.close();
+        older?.close();
+        await state.cleanup();
+      }
+    },
+  );
+}

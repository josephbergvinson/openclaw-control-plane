+import { createDeferred } from "openclaw/plugin-sdk/extension-shared";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import {
+  closeTrackedBrowserTabsForSessions,
+  trackSessionBrowserTab,
+  touchSessionBrowserTab,
+  untrackSessionBrowserTab,
+} from "./session-tab-registry.js";
+
+const keys = new Set<string>();
+const track = async (sessionKey: string, targetId: string) => {
+  keys.add(sessionKey);
+  await trackSessionBrowserTab({ sessionKey, targetId, now: 1_000 });
+};
+afterEach(async () => {
+  await closeTrackedBrowserTabsForSessions({ sessionKeys: [...keys], closeTab: async () => {} });
+  keys.clear();
+});
+describe("native cleanup retains registration and source authority until actual dispatch", () => {
+  it("selects only the completed session's tracked tabs and never adopts unknown user tabs", async () => {
+    await track("agent:main:completed", "completed-tab");
+    await track("agent:main:other", "other-tab");
+    const close = vi.fn(async () => {});
+    expect(
+      await closeTrackedBrowserTabsForSessions({
+        sessionKeys: ["agent:main:completed"],
+        closeTab: close,
+      }),
+    ).toBe(1);
+    expect(close).toHaveBeenCalledOnce();
+    expect(close).toHaveBeenCalledWith(expect.objectContaining({ targetId: "completed-tab" }));
+    expect(
+      await closeTrackedBrowserTabsForSessions({
+        sessionKeys: ["agent:main:other"],
+        closeTab: close,
+      }),
+    ).toBe(1);
+  });
+
+  it.each(["source", "registration"] as const)(
+    "revokes a delayed close at actual effect when its %s changes",
+    async (revocation) => {
+      const sessionKey = "agent:main:delayed-completion";
+      const targetId = "owned-tab";
+      await track(sessionKey, targetId);
+      const entered = createDeferred<void>();
+      const release = createDeferred<void>();
+      let current = true;
+      let effects = 0;
+      const pending = closeTrackedBrowserTabsForSessions({
+        sessionKeys: [sessionKey],
+        isCurrent: () => current,
+        closeTab: async ({ assertCurrent }) => {
+          entered.resolve();
+          await release.promise;
+          assertCurrent?.();
+          effects += 1;
+        },
+      });
+      await entered.promise;
+      if (revocation === "source") {
+        current = false;
+      } else {
+        await untrackSessionBrowserTab({ sessionKey, targetId });
+        await track(sessionKey, targetId);
+      }
+      release.resolve();
+      expect(await pending).toBe(0);
+      expect(effects).toBe(0);
+      current = true;
+      expect(
+        await closeTrackedBrowserTabsForSessions({
+          sessionKeys: [sessionKey],
+          closeTab: async ({ assertCurrent }) => {
+            assertCurrent?.();
+            effects += 1;
+          },
+        }),
+      ).toBe(1);
+      expect(effects).toBe(1);
+    },
+  );
+});
+
+describe("ordinary completion cutoff on volatile registrations", () => {
+  it("preserves newly created and recently touched tabs", async () => {
+    const sessionKey = "agent:main:completion-cutoff";
+    await track(sessionKey, "old");
+    await track(sessionKey, "reused");
+    await touchSessionBrowserTab({ sessionKey, targetId: "reused", now: 3_000 });
+    await trackSessionBrowserTab({ sessionKey, targetId: "new", now: 3_000 });
+    const close = vi.fn(async () => {});
+    expect(
+      await closeTrackedBrowserTabsForSessions({
+        sessionKeys: [sessionKey],
+        completedBefore: 2_000,
+        closeTab: close,
+      }),
+    ).toBe(1);
+    expect(close).toHaveBeenCalledWith(expect.objectContaining({ targetId: "old" }));
+  });
+  it("revokes the same registration if it is touched while its close awaits", async () => {
+    const sessionKey = "agent:main:completion-delayed-touch";
+    await track(sessionKey, "reused");
+    const entered = createDeferred<void>();
+    const release = createDeferred<void>();
+    let effects = 0;
+    const pending = closeTrackedBrowserTabsForSessions({
+      sessionKeys: [sessionKey],
+      completedBefore: 2_000,
+      closeTab: async ({ assertCurrent }) => {
+        entered.resolve();
+        await release.promise;
+        assertCurrent?.();
+        effects++;
+      },
+    });
+    await entered.promise;
+    await touchSessionBrowserTab({ sessionKey, targetId: "reused", now: 3_000 });
+    release.resolve();
+    expect(await pending).toBe(0);
+    expect(effects).toBe(0);
+  });
+});

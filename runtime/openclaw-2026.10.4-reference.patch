+    snapshot: ChannelProgressDraftCompositorSnapshot;
+    signal: AbortSignal;
+    assertCurrent: () => void;
+  }) => Promise<boolean>;
+}) {
+  let closed = false;
+  let sealed = false;
+  let receipt: ProgressContinuationReceipt | undefined;
+  let compositor: ReturnType<typeof createChannelProgressDraftCompositor> | undefined;
+  let serial = Promise.resolve();
+  const controller = new AbortController();
+  const assertCurrent = () => {
+    controller.signal.throwIfAborted();
+    if (closed || sealed || !params.isCurrent()) {
+      throw new Error("Retained progress presentation no longer owns its child cohort");
+    }
+  };
+  const close = () => {
+    if (closed) {
+      return;
+    }
+    closed = true;
+    controller.abort();
+    compositor?.cancel();
+    receipt = undefined;
+  };
+  const capability: ProgressContinuationCapability = {
+    adopt: async (candidate) => {
+      assertCurrent();
+      const source = params.source;
+      if (
+        receipt ||
+        !candidate.messageId ||
+        !candidate.text ||
+        candidate.channel !== source.channel ||
+        candidate.accountId !== source.accountId ||
+        candidate.to !== source.to ||
+        String(candidate.threadId ?? "") !== String(source.threadId ?? "")
+      ) {
+        return false;
+      }
+      receipt = { ...candidate, snapshot: structuredClone(candidate.snapshot) };
+      compositor = createChannelProgressDraftCompositor({
+        entry: params.entry,
+        mode: "progress",
+        active: true,
+        preparedItems: true,
+        seed: `${candidate.accountId ?? ""}:${candidate.to}`,
+        // Authored checkpoints replace the current status. Historical commentary
+        // is display data; approvals, tool rows and the plan keep their native lanes.
+        initialSnapshot: {
+          ...receipt.snapshot,
+          lines: receipt.snapshot.lines.filter(
+            (line) => typeof line === "string" || !line.id?.startsWith("commentary:"),
+          ),
+        },
+        commentaryItalics: false,
+        update: async (text, { snapshot }) => {
+          assertCurrent();
+          const visible = receipt;
+          if (!visible) {
+            return false;
+          }
+          return params.update({
+            receipt: visible,
+            text,
+            snapshot,
+            signal: controller.signal,
+            assertCurrent,
+          });
+        },
+      });
+      return true;
+    },
+    // Dispatch owns the provisional handoff only. An adopted card is retired by
+    // the native child cohort, not by the originating requester's return.
+    close: () => {
+      if (!receipt) {
+        close();
+      }
+    },
+  };
+  return {
+    capability,
+    get adopted() {
+      return Boolean(receipt);
+    },
+    close,
+    get sealed() {
+      return sealed;
+    },
+    async sealAndDrain(assertFinalCurrent: () => void) {
+      if (!sealed) {
+        assertCurrent();
+        assertFinalCurrent();
+        sealed = true;
+        compositor?.cancel();
+        // Keep the dispatched request alive through its real transport result.
+        // The existing tail retains this validated handoff outcome for a later
+        // terminal-producer join, including after the final receipt retires us.
+        serial = serial
+          .then(() => {
+            controller.signal.throwIfAborted();
+            assertFinalCurrent();
+          })
+          .finally(() => controller.abort());
+      }
+      await serial;
+    },
+    get messageId() {
+      return receipt?.messageId;
+    },
+    publish(text: string): Promise<"visible" | "unbound" | "unconfirmed"> {
+      if (sealed) {
+        return Promise.reject(
+          new Error("Retained progress presentation is sealed for final delivery"),
+        );
+      }
+      if (!receipt || !compositor) {
+        return Promise.resolve("unbound");
+      }
+      const work = serial.then(async () => {
+        assertCurrent();
+        // Narration is the compositor's replaceable status slot, independent of
+        // commentary display opt-in. It also retires the adopted old headline.
+        const alreadyStarted = compositor!.hasStarted;
+        const updated = await compositor!.pushNarrationProgress(text);
+        // A started compositor already attempted this edit. An unconfirmed
+        // result must not become an immediate retry through the startup path.
+        const visible = alreadyStarted
+          ? updated
+          : await compositor!.noteActivity({ startImmediately: true });
+        return visible ? ("visible" as const) : ("unconfirmed" as const);
+      });
+      // An uncertain edit is never retried. A new authored item may still publish.
+      serial = work.then(
+        () => {},
+        () => {},
+      );
+      return work;
+    },
+  };
+}

+    return BROWSER_CONFIDENTIAL_FIELD_SELECTOR;
+  }
+  // HTML normalizes absent/invalid input types to text, matching the secure fill owner.
+  const nonTextTypes = [
+    "button",
+    "checkbox",
+    "color",
+    "date",
+    "datetime-local",
+    "email",
+    "file",
+    "hidden",
+    "image",
+    "month",
+    "number",
+    "password",
+    "radio",
+    "range",
+    "reset",
+    "search",
+    "submit",
+    "tel",
+    "time",
+    "url",
+    "week",
+  ];

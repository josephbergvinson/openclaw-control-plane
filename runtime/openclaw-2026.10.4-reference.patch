@@ -0,0 +1,56 @@
+import { afterEach, describe, expect, it } from "vitest";
+import { configureAiTransportHost, getAiTransportHost } from "../host.js";
+import {
+  responsesPromptObserver,
+  type ResponsesPromptObservation,
+} from "./openai-responses-contracts.js";
+import { createResponsesPromptEgressObserver } from "./openai-responses-prompt-observer-internal.js";
+
+const initialHost = getAiTransportHost();
+afterEach(() => configureAiTransportHost(initialHost));
+
+function observe(request: { instructions?: unknown; model?: unknown; reasoning?: unknown }) {
+  const options = {};
+  const results: ResponsesPromptObservation[] = [];
+  responsesPromptObserver.set(options, (entry) => results.push(entry));
+  createResponsesPromptEgressObserver(options, "Private system context")?.(request, {
+    egress: "responses-sdk",
+    payloadVariant: "initial",
+  });
+  return results[0];
+}
+
+describe("bounded final provider metadata", () => {
+  it("observes actual final request model/effort without retaining prompt bytes", () => {
+    const result = observe({
+      instructions: "Private system context",
+      model: "gpt-6-astra",
+      reasoning: { effort: "xhigh" },
+    });
+    expect(result).toMatchObject({
+      requestModel: "gpt-6-astra",
+      reasoningEffort: "xhigh",
+      matchesAssembledPrompt: true,
+    });
+    expect(JSON.stringify(result)).not.toContain("Private system context");
+  });
+
+  it.each([
+    undefined,
+    null,
+    {},
+    "private body with spaces",
+    "x".repeat(129),
+    "sk-synthetic-secret",
+  ])("does not emit unsafe model metadata %j", (model) => {
+    configureAiTransportHost({
+      ...initialHost,
+      redactToolPayloadText: (text) => (text.startsWith("sk-") ? "[REDACTED]" : text),
+    });
+    const result = observe({ model, reasoning: { effort: "PRIVATE-EFFORT-MARKER" } });
+    expect(result?.requestModel).toBeUndefined();
+    expect(result?.reasoningEffort).toBeUndefined();
+    expect(JSON.stringify(result)).not.toContain("PRIVATE-EFFORT-MARKER");
+    expect(JSON.stringify(result)).not.toContain("sk-synthetic-secret");
+  });
+});

+type NativeFact = NonNullable<
+  ReturnType<typeof metadata.readCodexInferenceMetadata>["preparedInput"]
+>;
+type NativeRequest = { fact: NativeFact; threadId: string; generation: string; input: string };
+type HostCheck = {
+  sourceId: string;
+  pressure: number;
+  window: number;
+  effects: boolean;
+  policy: boolean;
+  refused: boolean;
+};
+type WriterCall = { callId: string; path: unknown; succeeded: boolean };

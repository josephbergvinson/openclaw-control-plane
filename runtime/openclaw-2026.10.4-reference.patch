+} from "./agent-runner-execution.test-support.js";
+
+const state = await setupAgentRunnerExecutionTestState();
+
+describe("requester presentation admission", () => {
+  it("binds the native requester sink before the first admitted runtime tool can publish", async () => {
+    const publish = vi.fn<RequesterProgressPublication["publish"]>(async (_text, assertCurrent) => {
+      assertCurrent?.();
+      return { status: "visible", messageId: "original-card" };
+    });
+    const source = { channel: "discord", accountId: "bot", to: "channel:parent" };
+    let bound: RequesterProgressPublication | undefined;
+    state.runEmbeddedAgentMock.mockImplementationOnce(async (params: EmbeddedAgentParams) => {
+      const admission = (
+        params as EmbeddedAgentParams & {
+          preparedRunAdmission: { admit: (kind: "embedded") => Promise<unknown> };
+        }
+      ).preparedRunAdmission;
+      await admission.admit("embedded");
+      bound = getAgentRunContext(params.runId)?.requesterProgress;
+      expect(bound?.source).toEqual(source);
+      await expect(bound?.publish("First tool checkpoint.")).resolves.toMatchObject({
+        status: "visible",
+      });
+      return { payloads: [{ text: "Verified result." }], meta: {} };
+    });
+    const execute = await getExecuteAgentTurnForTest();
+    await execute({
+      ...createMinimalRunAgentTurnParams({
+        opts: { requesterProgress: () => ({ source, publish }) },
+      }),
+      sessionKey: "agent:main:discord:channel:parent",
+    });
+    expect(publish).toHaveBeenCalledOnce();
+    await expect(bound!.publish("Retired native owner.")).rejects.toThrow(
+      "lost its admitted run owner",
+    );
+    expect(publish).toHaveBeenCalledOnce();
+  });
+});

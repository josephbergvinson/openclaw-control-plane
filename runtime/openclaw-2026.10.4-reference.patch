+      } else if (request.params?.name === "start_session") {
+        starts += 1;
+        ended = false;
+        fake.respond(request, sessionState("desktop"));
+      } else if (request.params?.name === "list_windows") {
+        fake.respond(
+          request,
+          ended
+            ? endedSessionResult(request)

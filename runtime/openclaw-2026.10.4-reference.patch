+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { createDeferred } from "../../test/helpers/promise.js";
+import type { McpOAuthStore } from "./mcp-oauth-store.types.js";
+
+const mocks = vi.hoisted(() => ({
+  store: {} as McpOAuthStore,
+  read: vi.fn<() => Promise<McpOAuthStore>>(),
+  lease: vi.fn(),
+  auth: vi.fn(),
+  admission: vi.fn(),
+}));
+
+vi.mock("@modelcontextprotocol/sdk/client/auth.js", () => ({ auth: mocks.auth }));
+vi.mock("../state/openclaw-state-worker-context.js", () => ({
+  captureOpenClawStateWorkerContext: () => ({ admission: { assertCurrent: mocks.admission } }),
+}));
+vi.mock("../state/openclaw-state-lease.js", () => ({
+  withOpenClawStateLeaseAsync: mocks.lease,
+}));
+vi.mock("./mcp-oauth-store.js", () => ({
+  readMcpOAuthStore: mocks.read,
+  mutateMcpOAuthStore: vi.fn(async () => ({ applied: true })),
+}));
+vi.mock("./mcp-oauth-provider.js", () => ({
+  createMcpOAuthClientProvider: async () => ({ tokens: async () => mocks.store.tokens }),
+  withMcpOAuthLeaseSignal: (fetchFn: unknown) => fetchFn,
+}));
+
+import { operatorMcpOAuthIdentity } from "./mcp-oauth-identity.js";
+import { resolveMcpOAuthAccessToken } from "./mcp-oauth.js";
+
+const identity = operatorMcpOAuthIdentity("fixture", "https://mcp.example.test/rpc");
+const fetchFn = vi.fn();
+const fresh = (): McpOAuthStore => ({
+  tokens: {
+    access_token: "fixture-current",
+    refresh_token: "fixture-refresh",
+    token_type: "Bearer",
+  },
+  tokenExpiresAt: Date.now() + 60_000,
+});
+
+beforeEach(() => {
+  vi.clearAllMocks();
+  mocks.store = fresh();
+  mocks.read.mockImplementation(async () => mocks.store);
+  mocks.lease.mockImplementation(async (_options, context, operation) =>
+    operation({ assertOwned: async () => {}, signal: new AbortController().signal }, context),
+  );
+  mocks.auth.mockImplementation(async () => {
+    mocks.store = fresh();
+    mocks.store.tokens = {
+      access_token: "fixture-rotated",
+      refresh_token: "fixture-refresh",
+      token_type: "Bearer",
+    };
+    return "AUTHORIZED";
+  });
+});
+
+describe("current MCP OAuth bearer admission", () => {
+  it("returns a fresh bearer while another flow owns the lease", async () => {
+    mocks.lease.mockRejectedValue(new Error("fixture flow lease is busy"));
+    await expect(resolveMcpOAuthAccessToken({ identity })).resolves.toBe("fixture-current");
+    expect(mocks.lease).not.toHaveBeenCalled();
+    expect(mocks.auth).not.toHaveBeenCalled();
+  });
+
+  it.each([29_999, 30_000])("renews at the expiry skew boundary (%i ms)", async (remainingMs) => {
+    mocks.store.tokenExpiresAt = Date.now() + remainingMs;
+    await expect(resolveMcpOAuthAccessToken({ identity, fetchFn })).resolves.toBe(
+      "fixture-rotated",
+    );
+    expect(mocks.lease).toHaveBeenCalledOnce();
+    expect(mocks.auth).toHaveBeenCalledOnce();
+  });
+
+  it("renews a rejected bearer even if its recorded expiry is fresh", async () => {
+    await expect(
+      resolveMcpOAuthAccessToken({
+        identity,
+        fetchFn,
+        rejectedAccessToken: "fixture-current",
+        authorizationChallenge: true,
+      }),
+    ).resolves.toBe("fixture-rotated");
+    expect(mocks.lease).toHaveBeenCalledOnce();
+    expect(mocks.auth).toHaveBeenCalledOnce();
+  });
+
+  it("uses a newer bearer instead of refreshing the one another request rejected", async () => {
+    await expect(
+      resolveMcpOAuthAccessToken({
+        identity,
+        rejectedAccessToken: "fixture-older",
+        authorizationChallenge: true,
+      }),
+    ).resolves.toBe("fixture-current");
+    expect(mocks.lease).not.toHaveBeenCalled();
+  });
+
+  it("does not return a fresh bearer with a persisted consent requirement", async () => {
+    mocks.store.pendingAuthorizationChallenge = { requiresAuthorization: true };
+    await expect(resolveMcpOAuthAccessToken({ identity })).rejects.toThrow(
+      "requires additional OAuth authorization",
+    );
+    expect(mocks.auth).not.toHaveBeenCalled();
+  });
+
+  it("rereads after lease admission and consumes a concurrently renewed bearer", async () => {
+    mocks.store.tokenExpiresAt = 0;
+    mocks.lease.mockImplementationOnce(async (_options, context, operation) => {
+      mocks.store = fresh();
+      return operation(
+        { assertOwned: async () => {}, signal: new AbortController().signal },
+        context,
+      );
+    });
+    await expect(resolveMcpOAuthAccessToken({ identity, fetchFn })).resolves.toBe(
+      "fixture-current",
+    );
+    expect(mocks.read).toHaveBeenCalledTimes(2);
+    expect(mocks.auth).not.toHaveBeenCalled();
+  });
+
+  it.each([true, false])(
+    "preserves unknown-expiry live versus projection semantics (%s)",
+    async (acceptUnknownExpiry) => {
+      delete mocks.store.tokenExpiresAt;
+      await expect(
+        resolveMcpOAuthAccessToken({ identity, fetchFn, acceptUnknownExpiry }),
+      ).resolves.toBe(acceptUnknownExpiry ? "fixture-current" : "fixture-rotated");
+      expect(mocks.lease).toHaveBeenCalledTimes(acceptUnknownExpiry ? 0 : 1);
+    },
+  );
+
+  it("does not retain an earlier bearer across the awaited current read", async () => {
+    const read = createDeferred<McpOAuthStore>();
+    mocks.read.mockReturnValueOnce(read.promise);
+    const resolving = resolveMcpOAuthAccessToken({ identity });
+    read.resolve({ ...fresh(), pendingAuthorizationChallenge: { requiresAuthorization: true } });
+    mocks.store.pendingAuthorizationChallenge = { requiresAuthorization: true };
+    await expect(resolving).rejects.toThrow("requires additional OAuth authorization");
+  });
+
+  it("rejects cancellation during the current read before returning credentials", async () => {
+    const controller = new AbortController();
+    const read = createDeferred<McpOAuthStore>();
+    mocks.read.mockReturnValueOnce(read.promise);
+    const resolving = resolveMcpOAuthAccessToken({ identity, signal: controller.signal });
+    controller.abort(new Error("fixture request closed"));
+    read.resolve(fresh());
+    await expect(resolving).rejects.toThrow("fixture request closed");
+    expect(mocks.lease).not.toHaveBeenCalled();
+  });
+  it("rejects a retired database admission after the current read", async () => {
+    mocks.admission.mockImplementationOnce(() => {
+      throw new Error("fixture database retired");
+    });
+    await expect(resolveMcpOAuthAccessToken({ identity })).rejects.toThrow(
+      "fixture database retired",
+    );
+    expect(mocks.lease).not.toHaveBeenCalled();
+  });
+
+  it("serializes concurrent renewal and rereads the winner's token", async () => {
+    mocks.store.tokenExpiresAt = 0;
+    const renewing = createDeferred();
+    const finishRenewal = createDeferred();
+    let tail = Promise.resolve();
+    mocks.lease.mockImplementation((_options, context, operation) => {
+      const current = tail.then(() =>
+        operation({ assertOwned: async () => {}, signal: new AbortController().signal }, context),
+      );
+      tail = current.then(() => undefined);
+      return current;
+    });
+    mocks.auth.mockImplementationOnce(async () => {
+      renewing.resolve();
+      await finishRenewal.promise;
+      mocks.store = fresh();
+      mocks.store.tokens = { access_token: "fixture-rotated", token_type: "Bearer" };
+      return "AUTHORIZED";
+    });
+    const first = resolveMcpOAuthAccessToken({ identity, fetchFn });
+    await renewing.promise;
+    const second = resolveMcpOAuthAccessToken({ identity, fetchFn });
+    finishRenewal.resolve();
+    await expect(Promise.all([first, second])).resolves.toEqual([
+      "fixture-rotated",
+      "fixture-rotated",
+    ]);
+    expect(mocks.auth).toHaveBeenCalledOnce();
+  });
+});

+          expect(newerProgress).not.toHaveBeenCalled();
+          if (scope === "execution") {
+            if (queued.queuedFollowupReplyDisposition?.kind !== "deliver") {
+              throw new Error("Actual prepared source dispatcher missing");
+            }
+            await queued.queuedFollowupReplyDisposition.deliver({
+              kind: "queued-followup",
+              runId: "older-queued-run",
+              originatingChannel: "discord",

+import { beforeAll, beforeEach, describe, expect, it, vi } from "vitest";
+import type { RealtimeVoiceSelectionHandle } from "../src/plugin-sdk/realtime-voice.js";
+import {
+  GatewayDrainingError,
+  getActiveGatewayRootWorkCount,
+  markGatewayRestartDraining,
+  resetGatewayWorkAdmission,
+  tryBeginGatewaySuspendAdmission,
+} from "../src/process/gateway-work-admission.js";
+import {
+  AsyncWorkScope,
+  captureAsyncWorkTracker,
+  getAsyncWorkSignal,
+} from "../src/shared/async-work-scope.js";
+import { createDeferred } from "./helpers/promise.js";
+
+type MockIngressInput = {
+  accountId?: string;
+  message?: string;
+  sessionKey?: string;
+  runId?: string;
+  senderIsOwner?: boolean;
+  abortSignal?: AbortSignal;
+};
+const mocks = vi.hoisted(() => ({
+  agentCommandFromIngress: vi.fn(async (_input: MockIngressInput) => ({
+    payloads: [{ text: "spoken" }],
+  })),
+}));
+vi.mock("../extensions/discord/src/runtime.js", () => ({
+  getDiscordRuntime: () => ({
+    agent: { runCommandFromIngress: mocks.agentCommandFromIngress },
+  }),
+}));
+
+let voiceIngress: Awaited<
+  ReturnType<typeof import("../extensions/discord/test-api.js").loadDiscordVoiceIngress>
+>;
+beforeAll(async () => {
+  const { loadDiscordVoiceIngress } = await import("../extensions/discord/test-api.js");
+  voiceIngress = await loadDiscordVoiceIngress();
+});
+
+describe("Discord late voice consult native admission", () => {
+  beforeEach(() => {
+    mocks.agentCommandFromIngress.mockReset().mockResolvedValue({ payloads: [{ text: "spoken" }] });
+  });
+  function fixture(senderIsOwner = false) {
+    const entry = {
+      guildId: "guild-1",
+      channelId: "channel-1",
+      captureOnly: false,
+      sessionLifecycle: { status: "active" },
+      route: { agentId: "main", sessionKey: "agent:main:discord:channel:channel-1" },
+    };
+    return {
+      entry,
+      run: (overrides: Partial<Parameters<typeof voiceIngress.runDiscordVoiceAgentTurn>[0]> = {}) =>
+        voiceIngress.runDiscordVoiceAgentTurn({
+          entry: entry as Parameters<typeof voiceIngress.runDiscordVoiceAgentTurn>[0]["entry"],
+          accountId: "work",
+          userId: senderIsOwner ? "owner" : "guest",
+          message: "Change your voice",
+          discordConfig: {},
+          runtime: { log: vi.fn(), error: vi.fn(), exit: vi.fn() },
+          context: { senderIsOwner, speakerLabel: senderIsOwner ? "Owner" : "Guest" },
+          ...overrides,
+        }),
+    };
+  }
+
+  it("owns a late authenticated consult after its trigger scope has closed", async () => {
+    const trigger = new AsyncWorkScope();
+    const releaseTrigger = createDeferred();
+    const cancellation = new AbortController();
+    const bindingRelease = vi.fn();
+    const bindRun = vi.fn<RealtimeVoiceSelectionHandle["bindRun"]>(() => bindingRelease);
+    const activeBefore = getActiveGatewayRootWorkCount();
+    const { run } = fixture(true);
+    let turn: Promise<string | null> | undefined;
+    mocks.agentCommandFromIngress.mockImplementationOnce(async (input) =>
+      // The native agent generation captures this tracker before preparing its model.
+      captureAsyncWorkTracker()(async () => {
+        expect(getAsyncWorkSignal()?.aborted).toBe(false);
+        expect(getActiveGatewayRootWorkCount()).toBe(activeBefore + 1);
+        expect(input.senderIsOwner).toBe(true);
+        expect(input.abortSignal).toBe(cancellation.signal);
+        expect(input.runId).toEqual(expect.any(String));
+        return { payloads: [{ text: "Current call verified." }] };
+      }),
+    );
+    try {
+      await trigger.track(() => {
+        // A retained provider callback keeps the async context of its trigger.
+        turn = releaseTrigger.promise.then(() =>
+          run({
+            signal: cancellation.signal,
+            voiceSelection: { bindRun, unregister: vi.fn() },
+          }),
+        );
+      });
+      await trigger.drain();
+      releaseTrigger.resolve();
+      await expect(turn).resolves.toBe("Current call verified.");
+      expect(mocks.agentCommandFromIngress).toHaveBeenCalledOnce();
+      expect(bindingRelease).toHaveBeenCalledOnce();
+      // The old trigger remains closed: this is not a global scope bypass.
+      await expect(trigger.track(() => undefined)).rejects.toThrow("Async work scope is closed");
+    } finally {
+      cancellation.abort();
+      releaseTrigger.resolve();
+      await Promise.allSettled([turn]);
+      await trigger.drain();
+    }
+  });
+
+  it.each(["policy", "call", "abort"] as const)(
+    "rechecks %s authority after waiting for reversible Gateway maintenance",
+    async (revoked) => {
+      const suspension = tryBeginGatewaySuspendAdmission(() => {});
+      expect(suspension?.commit()).toBe(true);
+      const cancellation = new AbortController();
+      const { entry, run } = fixture(true);
+      let current = true;
+      const turn = run({
+        signal: cancellation.signal,
+        context: { senderIsOwner: true, speakerLabel: "Owner", isCurrent: () => current },
+      });
+      try {
+        expect(mocks.agentCommandFromIngress).not.toHaveBeenCalled();
+        if (revoked === "abort") {
+          cancellation.abort(new Error("Original voice call ended"));
+          await expect(turn).rejects.toMatchObject({ name: "AbortError" });
+          expect(cancellation.signal.reason).toEqual(new Error("Original voice call ended"));
+        } else {
+          if (revoked === "policy") {
+            current = false;
+          } else {
+            entry.sessionLifecycle.status = "stopped";
+          }
+          suspension?.release();
+          await expect(turn).resolves.toBeNull();
+        }
+        expect(mocks.agentCommandFromIngress).not.toHaveBeenCalled();
+      } finally {
+        cancellation.abort();
+        suspension?.rollback();
+        suspension?.release();
+        await Promise.allSettled([turn]);
+      }
+    },
+  );
+
+  it("keeps restart admission closed to a late voice consult", async () => {
+    const { run } = fixture(true);
+    markGatewayRestartDraining();
+    try {
+      await expect(run()).rejects.toBeInstanceOf(GatewayDrainingError);
+      expect(mocks.agentCommandFromIngress).not.toHaveBeenCalled();
+    } finally {
+      resetGatewayWorkAdmission();
+    }
+  });
+});

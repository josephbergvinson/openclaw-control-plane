+import { describe, expect, it, vi } from "vitest";
+import { DiscordRealtimeConsults } from "./realtime-consults.js";
+import type { VoiceRequesterFinalBinding, VoiceRealtimeAgentTurnParams } from "./session.js";
+
+function fixture() {
+  let current = true;
+  let providerEpoch = 1;
+  let owner = true;
+  let binding: VoiceRequesterFinalBinding | undefined;
+  const speaker = {
+    userId: "verified-speaker",
+    speakerLabel: "Alice",
+    senderIsOwner: true,
+    actionHandoff: true,
+  };
+  const revoke = vi.fn();
+  const enqueueExactSpeechMessage = vi.fn();
+  const deliverRetainedSpeech = vi.fn();
+  const params = {
+    accountId: "account",
+    actionHandoffAllowed: () => true,
+    sendConversationInput: vi.fn(),
+    consultPolicy: () => "auto",
+    consultToolPolicy: () => "owner",
+    consultToolsAllow: () => undefined,
+    debounceMs: () => 0,
+    entry: { sessionLifecycle: { status: "active" }, captureOnly: false },
+    harness: { forcedConsults: { handles: () => [], clear: vi.fn() } },
+    isAgentProxy: () => false,
+    isWakeNameRequired: () => true,
+    playback: { enqueueExactSpeechMessage, deliverRetainedSpeech },
+    providerEpoch: () => providerEpoch,
+    runAgentTurn: vi.fn(async (turn: VoiceRealtimeAgentTurnParams) => {
+      binding = turn.requesterFinal;
+      binding?.onRegistration?.({ revoke });
+      return "I am checking the records.";
+    }),
+    resolveSpeakerContext: vi.fn(async () => ({
+      ...speaker,
+      senderIsOwner: owner,
+      isCurrent: () => current,
+    })),
+    stopped: () => !current,
+    turns: { consumePendingSpeakerContext: () => speaker },
+    usesRealtimeAgentHandoff: () => true,
+    wakeNamePolicy: () => "always",
+  } as unknown as ConstructorParameters<typeof DiscordRealtimeConsults>[0];
+  const consults = new DiscordRealtimeConsults(params);
+  return {
+    consults,
+    params,
+    revoke,
+    enqueueExactSpeechMessage,
+    deliverRetainedSpeech,
+    binding: () => binding!,
+    changeOwner: () => {
+      owner = false;
+    },
+    replaceProvider: () => {
+      providerEpoch += 1;
+    },
+    stop: () => {
+      current = false;
+    },
+  };
+}
+
+describe("native requester final delivery to Discord voice", () => {
+  it("retains admitted task custody after an acknowledgment and speaks its final once", async () => {
+    const f = fixture();
+    expect(await f.consults.runAgentConsult({ prompt: "Delegate the records check" })).toEqual({
+      text: "I am checking the records.",
+    });
+    expect(f.consults.isIdle()).toBe(false);
+    expect(f.binding().append("The recorded revision is abc123.")).toBe(true);
+    expect(f.binding().append("Duplicate final")).toBe(false);
+    await vi.waitFor(() =>
+      expect(f.enqueueExactSpeechMessage).toHaveBeenCalledWith("The recorded revision is abc123."),
+    );
+    expect(f.params.resolveSpeakerContext).toHaveBeenCalledWith("verified-speaker");
+    f.binding().onSettled?.();
+    await vi.waitFor(() => expect(f.consults.isIdle()).toBe(true));
+    f.consults.close();
+  });
+
+  it.each(["authorization", "provider", "closed"] as const)(
+    "does not speak a final after %s changes",
+    async (change) => {
+      const f = fixture();
+      await f.consults.runAgentConsult({ prompt: "Delegate the records check" });
+      if (change === "authorization") {
+        f.changeOwner();
+      } else if (change === "provider") {
+        f.replaceProvider();
+      } else {
+        f.consults.close();
+      }
+      const accepted = f.binding().append("Private result");
+      if (change === "authorization") {
+        expect(accepted).toBe(true);
+      } else {
+        expect(accepted).toBe(false);
+      }
+      await new Promise<void>((resolve) => {
+        setImmediate(resolve);
+      });
+      expect(f.enqueueExactSpeechMessage).not.toHaveBeenCalled();
+      expect(f.deliverRetainedSpeech).not.toHaveBeenCalled();
+      if (change === "closed") {
+        expect(f.revoke).toHaveBeenCalledOnce();
+      }
+      f.binding().onSettled?.();
+      f.consults.close();
+    },
+  );
+});

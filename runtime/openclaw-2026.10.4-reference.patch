+          expect(observedToken).toBeUndefined();
+          expect(importError).toBeUndefined();
+        } else {
+          expect(observedToken).toBeTypeOf("string");
+          expect(importError).toBeUndefined();
+        }
+        expect(imported).toBe(binding === "same");
+        expect((await readSecretStoreValue({ scope: storeScope, name: storeName })).ok).toBe(
+          binding === "same",
+        );
+        if (binding === "same") {
+          expect(await readSecretStoreValue({ scope: storeScope, name: storeName })).toEqual({
+            ok: true,
+            value: "native-approved dummy !;",
+          });
+        }
+      } finally {
+        admitted?.operation.complete();
+        capturedDispatch?.replyOptions?.turnAdoptionLifecycle?.onSettled?.();
+        if (finishing) {
+          await finishing;
+        }
+        await input.fixture.cleanup();
+      }
+    },
+  );
+});

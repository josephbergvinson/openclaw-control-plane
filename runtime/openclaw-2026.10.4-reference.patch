+  expect(await fs.readFile(path.join(ROOT, "pnpm-workspace.yaml"), "utf8")).toContain(
+    `native-package-artifacts/${ARCHIVE}`,
+  );
+  const executable = path.join(
+    path.dirname(platformPackage),
+    "vendor/aarch64-apple-darwin/bin/codex",
+  );
+  const vendor = JSON.parse(
+    await fs.readFile(
+      path.join(path.dirname(platformPackage), "vendor/aarch64-apple-darwin/codex-package.json"),
+      "utf8",
+    ),
+  );
+  expect(vendor).toMatchObject({
+    version: VERSION,
+    variant: "codex",
+    target: "aarch64-apple-darwin",
+  });

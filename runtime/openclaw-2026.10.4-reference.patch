+    } as unknown as Parameters<typeof startAgentRunExecution>[0],
+  };
+}
+
+/** Supplies real request-context wiring for captured operator continuations. */
+export function createFullExecutionContext({
+  chatAbortControllers,
+  dedupe,
+}: Pick<GatewayRequestContext, "chatAbortControllers" | "dedupe">) {
+  const context = createGatewayRequestContext(
+    makeContextParams({
+      chatAbortControllers,
+      dedupe,
+      getAttachedGatewayMethodRegistry: createRequestGatewayMethodRegistry,
+    }),
+  );
+  context.resolveGatewayContext = () => context;
+  return context;
+}

+/** Transfer identity facts under the already selected native input owner, never model params. */
+export function resolveAgentRunMcpRequesterScope(params: {
+  client: AgentTurnPrincipal | null;
+  context: Pick<AgentTurnContext, "validateAgentRuntimeApprovalAuthority">;
+  sessionKey?: string;
+  sessionId: string;
+  expectedExistingSessionId?: string;
+  trustedInternalHandoff?: TrustedSubagentCompletionHandoff;
+  assertCurrent: () => void;
+}) {
+  params.assertCurrent();
+  const identity = params.client?.internal?.agentRuntimeIdentity;
+  const spawnScope = identity?.sessionSpawnContext?.mcpRequesterScope;
+  const queued = params.client?.internal?.mcpRequesterScopeContext;
+  const handoff = params.trustedInternalHandoff?.mcpRequesterScope;
+  if (
+    [spawnScope !== undefined, queued !== undefined, handoff !== undefined].filter(Boolean).length >
+    1
+  ) {
+    throw new Error("MCP requester admission has competing owners");
+  }
+  if (spawnScope !== undefined) {
+    return resolveMcpRequesterScope({
+      mcpRequesterScope: spawnScope,
+      mcpRequesterScopeAssertCurrent: () => {
+        params.assertCurrent();
+        if (
+          !identity ||
+          params.context.validateAgentRuntimeApprovalAuthority?.(identity) !== true
+        ) {
+          throw new Error("MCP requester child authority is no longer current");
+        }
+      },
+    });
+  }
+  if (queued !== undefined) {
+    if (
+      params.client?.internal?.syntheticClient !== true ||
+      !params.sessionKey ||
+      params.expectedExistingSessionId !== params.sessionId
+    ) {
+      throw new Error("MCP requester queued target incarnation does not match");
+    }
+    return resolveMcpRequesterScope(queued);
+  }
+  if (handoff !== undefined) {
+    const scope = normalizeMcpRequesterScope(handoff);
+    if (!scope) {
+      throw new Error("MCP requester completion partition is invalid");
+    }
+    // The one-use handoff was checked before any producer could retire it. The
+    // accepted input now owns the transferred fact and its own execution guard.
+    return scope;
+  }
+  return undefined;
+}

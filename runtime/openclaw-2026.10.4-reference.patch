--- /dev/null
+++ b/apps/macos/Sources/OpenClawMacCLI/LocalGatewayAuthIPC.swift
@@ -0,0 +1,269 @@
+import Darwin
+import Foundation
+import Security
+import Subprocess
+
+@_silgen_name("csops")
+private func localAuthCSOps(
+    _ pid: pid_t,
+    _ operation: UInt32,
+    _ address: UnsafeMutableRawPointer?,
+    _ size: Int) -> Int32
+
+/// Only a matching signed app (or this boolean-only diagnostic) may own the auth helper.
+/// Process paths, ancestry and code hashes come from the kernel, never request arguments.
+enum LocalGatewayAuthIPC {
+    struct ProcessIdentity {
+        let pid: pid_t
+        let parent: pid_t
+        let startedSeconds: UInt64
+        let startedMicroseconds: UInt64
+        let path: String
+    }
+
+    private static func process(_ pid: pid_t) -> ProcessIdentity? {
+        var info = proc_bsdinfo()
+        let size = Int32(MemoryLayout<proc_bsdinfo>.size)
+        guard proc_pidinfo(pid, PROC_PIDTBSDINFO, 0, &info, size) == size,
+              info.pbi_uid == geteuid()
+        else { return nil }
+        var bytes = [UInt8](repeating: 0, count: 4096)
+        guard proc_pidpath(pid, &bytes, UInt32(bytes.count)) > 0 else { return nil }
+        guard let path = String(bytes: bytes.prefix { $0 != 0 }, encoding: .utf8) else { return nil }
+        return ProcessIdentity(
+            pid: pid,
+            parent: pid_t(info.pbi_ppid),
+            startedSeconds: info.pbi_start_tvsec,
+            startedMicroseconds: info.pbi_start_tvusec,
+            path: path)
+    }
+
+    private static func bundle() -> URL? {
+        guard let own = self.process(getpid()) else { return nil }
+        let executable = URL(fileURLWithPath: own.path).resolvingSymlinksInPath()
+        let bundle = executable.deletingLastPathComponent().deletingLastPathComponent().deletingLastPathComponent()
+        guard executable.lastPathComponent == "openclaw-mac",
+              executable.deletingLastPathComponent().lastPathComponent == "MacOS",
+              bundle.pathExtension == "app"
+        else { return nil }
+        return bundle
+    }
+
+    private static func signedHash(pid: pid_t, expected: URL) -> Data? {
+        var own: SecCode?
+        var ownStatic: SecStaticCode?
+        var ownInformation: CFDictionary?
+        guard SecCodeCopySelf(SecCSFlags(), &own) == errSecSuccess, let own,
+              SecCodeCheckValidity(own, SecCSFlags(), nil) == errSecSuccess,
+              SecCodeCopyStaticCode(own, SecCSFlags(), &ownStatic) == errSecSuccess, let ownStatic,
+              SecCodeCopySigningInformation(ownStatic, SecCSFlags(rawValue: kSecCSSigningInformation), &ownInformation)
+              == errSecSuccess,
+              let ownInformation,
+              let ownTeam = (ownInformation as NSDictionary)[kSecCodeInfoTeamIdentifier] as? String,
+              !ownTeam.isEmpty,
+              let ownCertificates = (ownInformation as NSDictionary)[kSecCodeInfoCertificates] as? [SecCertificate],
+              let ownCertificate = ownCertificates.first
+        else { return nil }
+        var expectedCode: SecStaticCode?
+        var requirement: SecRequirement?
+        var information: CFDictionary?
+        guard SecStaticCodeCreateWithPath(expected as CFURL, SecCSFlags(), &expectedCode) == errSecSuccess,
+              let expectedCode,
+              SecStaticCodeCheckValidity(expectedCode, SecCSFlags(), nil) == errSecSuccess,
+              SecCodeCopyDesignatedRequirement(expectedCode, SecCSFlags(), &requirement) == errSecSuccess,
+              let requirement,
+              SecCodeCopySigningInformation(expectedCode, SecCSFlags(rawValue: kSecCSSigningInformation), &information)
+              == errSecSuccess,
+              let information,
+              (information as NSDictionary)[kSecCodeInfoTeamIdentifier] as? String == ownTeam,
+              let certificates = (information as NSDictionary)[kSecCodeInfoCertificates] as? [SecCertificate],
+              let certificate = certificates.first,
+              SecCertificateCopyData(certificate) as Data == SecCertificateCopyData(ownCertificate) as Data,
+              let identifier = (information as NSDictionary)[kSecCodeInfoIdentifier] as? String,
+              expected.lastPathComponent == "OpenClaw"
+              ? (identifier == "ai.openclaw.mac" || identifier.hasPrefix("ai.openclaw.mac."))
+              : expected.lastPathComponent == "bun"
+              // The sealed runtime resource's actual designated requirement and cdhash
+              // below bind Bun's identity; do not assume an upstream signing label.
+              ? !identifier.isEmpty
+              : identifier == (ownInformation as NSDictionary)[kSecCodeInfoIdentifier] as? String,
+              let expectedHash = (information as NSDictionary)[kSecCodeInfoUnique] as? Data
+        else { return nil }
+        var guest: SecCode?
+        let attributes = [kSecGuestAttributePid as String: NSNumber(value: pid)] as CFDictionary
+        guard SecCodeCopyGuestWithAttributes(nil, attributes, SecCSFlags(), &guest) == errSecSuccess,
+              let guest,
+              SecCodeCheckValidity(guest, SecCSFlags(), requirement) == errSecSuccess
+        else { return nil }
+        // Same requirement alone could admit a replaced bundle's old mapped executable.
+        var hash = [UInt8](repeating: 0, count: 20)
+        guard hash.withUnsafeMutableBytes({ localAuthCSOps(pid, 5, $0.baseAddress, $0.count) }) == 0,
+              Data(hash) == expectedHash
+        else { return nil }
+        return expectedHash
+    }
+
+    private static func sealedBundle(_ bundle: URL) -> Bool {
+        // A signed interpreter alone does not authenticate the JavaScript it executes.
+        // Validate the containing app's resource seal and bind its signer to this running verifier.
+        var own: SecCode?
+        var ownStatic: SecStaticCode?
+        var ownInformation: CFDictionary?
+        var app: SecStaticCode?
+        var appInformation: CFDictionary?
+        let flags = SecCSFlags(rawValue: kSecCSStrictValidate | kSecCSCheckNestedCode | kSecCSCheckAllArchitectures)
+        guard SecCodeCopySelf(SecCSFlags(), &own) == errSecSuccess, let own,
+              SecCodeCheckValidity(own, SecCSFlags(), nil) == errSecSuccess,
+              SecCodeCopyStaticCode(own, SecCSFlags(), &ownStatic) == errSecSuccess, let ownStatic,
+              SecCodeCopySigningInformation(ownStatic, SecCSFlags(rawValue: kSecCSSigningInformation), &ownInformation)
+              == errSecSuccess,
+              let ownInformation,
+              let ownTeam = (ownInformation as NSDictionary)[kSecCodeInfoTeamIdentifier] as? String,
+              !ownTeam.isEmpty,
+              let ownCertificates = (ownInformation as NSDictionary)[kSecCodeInfoCertificates] as? [SecCertificate],
+              let ownCertificate = ownCertificates.first,
+              SecStaticCodeCreateWithPath(bundle as CFURL, SecCSFlags(), &app) == errSecSuccess, let app,
+              SecStaticCodeCheckValidity(app, flags, nil) == errSecSuccess,
+              SecCodeCopySigningInformation(app, SecCSFlags(rawValue: kSecCSSigningInformation), &appInformation)
+              == errSecSuccess,
+              let appInformation,
+              (appInformation as NSDictionary)[kSecCodeInfoTeamIdentifier] as? String == ownTeam,
+              let certificates = (appInformation as NSDictionary)[kSecCodeInfoCertificates] as? [SecCertificate],
+              let certificate = certificates.first,
+              SecCertificateCopyData(certificate) as Data == SecCertificateCopyData(ownCertificate) as Data,
+              let identifier = (appInformation as NSDictionary)[kSecCodeInfoIdentifier] as? String,
+              identifier == "ai.openclaw.mac" || identifier.hasPrefix("ai.openclaw.mac.")
+        else { return false }
+        return true
+    }
+
+    struct ParentEnvironment {
+        var bundle: () -> URL?
+        var parentPID: () -> pid_t
+        var process: (pid_t) -> ProcessIdentity?
+        var sealedBundle: (URL) -> Bool
+        var signedHash: (pid_t, URL) -> Data?
+    }
+
+    /// Unlike the Gateway's Bun/probe chain, a credential pipe belongs only to
+    /// the actual app that created it. Nothing supplied on stdin grants access.
+    static func directAppParentIdentity() -> String? {
+        self.directAppParentIdentity(environment: .init(
+            bundle: self.bundle,
+            parentPID: { getppid() },
+            process: self.process,
+            sealedBundle: self.sealedBundle,
+            signedHash: { self.signedHash(pid: $0, expected: $1) }))
+    }
+
+    static func directAppParentIdentity(environment: ParentEnvironment) -> String? {
+        guard let bundle = environment.bundle(),
+              let owner = environment.process(environment.parentPID())
+        else { return nil }
+        let app = bundle.appendingPathComponent("Contents/MacOS/OpenClaw")
+        guard owner.path == app.path,
+              environment.sealedBundle(bundle),
+              let hash = environment.signedHash(owner.pid, app),
+              environment.parentPID() == owner.pid,
+              let current = environment.process(owner.pid),
+              current.path == owner.path,
+              current.startedSeconds == owner.startedSeconds,
+              current.startedMicroseconds == owner.startedMicroseconds
+        else { return nil }
+        return "\(owner.pid):\(owner.startedSeconds):\(owner.startedMicroseconds):" +
+            hash.map { String(format: "%02x", $0) }.joined()
+    }
+
+    static func parentIdentity() -> String? {
+        self.parentIdentity(environment: .init(
+            bundle: self.bundle,
+            parentPID: { getppid() },
+            process: self.process,
+            sealedBundle: self.sealedBundle,
+            signedHash: { self.signedHash(pid: $0, expected: $1) }))
+    }
+
+    static func parentIdentity(environment: ParentEnvironment) -> String? {
+        guard let bundle = environment.bundle(),
+              environment.sealedBundle(bundle),
+              let helper = environment.process(environment.parentPID()),
+              let owner = environment.process(helper.parent)
+        else { return nil }
+        let bun = bundle.appendingPathComponent("Contents/Resources/runtime/bin/bun").resolvingSymlinksInPath()
+        let app = bundle.appendingPathComponent("Contents/MacOS/OpenClaw")
+        let probe = bundle.appendingPathComponent("Contents/MacOS/openclaw-mac")
+        guard helper.path == bun.path,
+              environment.signedHash(helper.pid, bun) != nil,
+              owner.path == app.path || owner.path == probe.path,
+              let hash = environment.signedHash(owner.pid, URL(fileURLWithPath: owner.path)),
+              environment.parentPID() == helper.pid,
+              let current = environment.process(helper.pid), current.path == helper.path,
+              current.parent == owner.pid,
+              current.startedSeconds == helper.startedSeconds,
+              current.startedMicroseconds == helper.startedMicroseconds,
+              let currentOwner = environment.process(owner.pid), currentOwner.path == owner.path,
+              currentOwner.startedSeconds == owner.startedSeconds,
+              currentOwner.startedMicroseconds == owner.startedMicroseconds
+        else { return nil }
+        return "\(owner.pid):\(owner.startedSeconds):\(owner.startedMicroseconds):" +
+            hash.map { String(format: "%02x", $0) }.joined()
+    }
+
+    static func probe() async {
+        var tokenPresent = false
+        var passwordPresent = false
+        do {
+            guard let bundle = self.bundle(), self.sealedBundle(bundle), isatty(STDIN_FILENO) == 0
+            else { throw ProbeError.unavailable }
+            var input = Data()
+            while let chunk = try FileHandle.standardInput.read(upToCount: 4096), !chunk.isEmpty {
+                input.append(chunk)
+                guard input.count <= 32 * 1024 else { throw ProbeError.unavailable }
+            }
+            let root = bundle.appendingPathComponent("Contents/Resources/runtime")
+            var options = PlatformOptions()
+            options.createSession = true
+            options.teardownSequence = [.send(signal: .kill, toProcessGroup: true, allowedDurationToNextStep: .zero)]
+            var environment: [Environment.Key: String] = [:]
+            for (key, value) in ProcessInfo.processInfo.environment {
+                guard key != "NODE_OPTIONS", key != "NODE_PATH", key != "BUN_OPTIONS", key != "LD_PRELOAD",
+                      !key.hasPrefix("DYLD_"), let name = Environment.Key(rawValue: key) else { continue }
+                environment[name] = value
+            }
+            environment["OPENCLAW_NO_RESPAWN"] = "1"
+            environment["OPENCLAW_SQLITE_LIBRARY"] = root.appendingPathComponent("lib/libsqlite3.dylib").path
+            let configuration = Configuration(
+                executable: .path(.init(root.appendingPathComponent("bin/bun").path)),
+                arguments: Arguments([
+                    root.appendingPathComponent("lib/node_modules/openclaw/dist/mac-node-worker.js").path,
+                    "node", "worker", "--resolve-local-auth",
+                ]),
+                environment: .custom(environment),
+                platformOptions: options)
+            let request = Array(input)
+            let data = try await withThrowingTaskGroup(of: Data.self) { group in
+                group.addTask {
+                    let result = try await Subprocess.run(
+                        configuration, input: .array(request), output: .bytes(limit: 32 * 1024), error: .discarded)
+                    guard result.terminationStatus.isSuccess else { throw ProbeError.unavailable }
+                    return Data(result.standardOutput)
+                }
+                group.addTask {
+                    try await Task.sleep(for: .seconds(60))
+                    throw ProbeError.unavailable
+                }
+                defer { group.cancelAll() }
+                guard let data = try await group.next() else { throw ProbeError.unavailable }
+                return data
+            }
+            let result = try JSONSerialization.jsonObject(with: data) as? [String: Any]
+            tokenPresent = (result?["token"] as? String)?.isEmpty == false
+            passwordPresent = (result?["password"] as? String)?.isEmpty == false
+        } catch {}
+        let ok = tokenPresent || passwordPresent
+        print("{\"ok\":\(ok),\"tokenPresent\":\(tokenPresent),\"passwordPresent\":\(passwordPresent)}")
+        if !ok { exit(1) }
+    }
+
+    private enum ProbeError: Error { case unavailable }
+}

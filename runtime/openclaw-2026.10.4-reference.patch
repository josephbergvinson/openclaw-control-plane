+import { describe, expect, it } from "vitest";
+import { drain, fixture } from "./subagent-registry-progress.test-support.js";
+import type { SubagentRunRecord } from "./subagent-registry.types.js";
+import { buildRequesterSettleWakeIdentity } from "./subagent-requester-settle-identity.js";
+
+describe("native private parent synthesis progress", () => {
+  function synthesisFixture() {
+    const f = fixture();
+    f.initial.completionTarget = "parent";
+    f.initial.completionRequesterSessionId = "requester-session";
+    f.initial.execution = { status: "terminal", lifecycleGeneration: "current", endedAt: 1 };
+    f.changes();
+    let cohortCurrent = true;
+    const input = {
+      requesterSessionKey: f.initial.requesterSessionKey,
+      requesterSessionId: "requester-session",
+      requesterAgentId: "main",
+      runId: "private-parent-synthesis",
+      batchRunIds: [f.initial.runId],
+      isCurrent: () => cohortCurrent,
+    };
+    const parentFields = {
+      runId: input.runId,
+      sessionKey: input.requesterSessionKey,
+      agentId: "main",
+    };
+    return {
+      ...f,
+      input,
+      parentFields,
+      revoke: () => {
+        cohortCurrent = false;
+        f.changes();
+      },
+      parent: (id: string, text: string) => f.completed(id, text, parentFields),
+    };
+  }
+
+  function nativeWakeFixture() {
+    const f = synthesisFixture();
+    delete f.initial.requesterTurnRunId;
+    f.initial.expectsCompletionMessage = true;
+    f.initial.requesterSettleWake = {
+      status: "dispatching",
+      attemptCount: 1,
+      requesterYieldBatch: true,
+      rearmGeneration: 1,
+      batchRunIds: [f.initial.runId],
+    };
+    f.input.runId = buildRequesterSettleWakeIdentity({
+      ...f.input,
+      rearmGeneration: 1,
+      sharedAttemptKey: true,
+    }).runId;
+    f.parentFields.runId = f.input.runId;
+    return f;
+  }
+
+  it("binds native wake-owned progress without borrowing an original requester turn", async () => {
+    const f = nativeWakeFixture();
+    const owner = f.owner.prepareSynthesis(f.input);
+    expect(owner).toBeDefined();
+    owner!.start();
+    f.parent("native-wake", "Checking the delegated findings before the final answer.");
+    await drain();
+    expect(f.publish).toHaveBeenCalledOnce();
+    expect(f.publish.mock.calls[0]?.[0]).toMatchObject({
+      runId: f.input.runId,
+      cohort: [f.initial],
+    });
+    f.setClock(180_000);
+    f.owner.checkpoint();
+    await drain();
+    const checkpoint = f.requestCheckpoint.mock.calls[0]![0];
+    checkpoint.assertCurrent();
+    f.initial.requesterSettleWake!.rearmGeneration = 2;
+    f.changes();
+    expect(checkpoint.assertCurrent).toThrow();
+    expect(checkpoint.signal.aborted).toBe(true);
+    f.parent("old-generation", "Do not publish retired native wake work.");
+    await drain();
+    expect(f.publish).toHaveBeenCalledOnce();
+    await f.owner.reset();
+  });
+
+  it.each(["missing-wake", "unadmitted-wake", "wrong-run", "missing-incarnation"] as const)(
+    "rejects an absent-turn source without actual native wake custody: %s",
+    async (mode) => {
+      const f = nativeWakeFixture();
+      if (mode === "missing-wake") {
+        delete f.initial.requesterSettleWake;
+      } else if (mode === "unadmitted-wake") {
+        f.initial.requesterSettleWake!.status = "pending";
+      } else if (mode === "missing-incarnation") {
+        delete f.initial.completionRequesterSessionId;
+      } else {
+        f.input.runId = "unrelated-parent";
+      }
+      expect(f.owner.prepareSynthesis(f.input)).toBeUndefined();
+      f.parent("unowned", "Do not publish an unowned synthesis.");
+      await drain();
+      expect(f.publish).not.toHaveBeenCalled();
+      expect(f.requestCheckpoint).not.toHaveBeenCalled();
+      await f.owner.reset();
+    },
+  );
+
+  it("rejects mixed original sources even inside an admitted native wake cohort", async () => {
+    const f = nativeWakeFixture();
+    const other = {
+      ...f.initial,
+      runId: "other-native-child",
+      progressOrigin: { ...f.initial.progressOrigin!, messageId: "different-original-message" },
+    };
+    f.runs.set(other.runId, other);
+    f.input.batchRunIds = [f.initial.runId, other.runId];
+    f.initial.requesterSettleWake!.batchRunIds = [...f.input.batchRunIds];
+    f.input.runId = buildRequesterSettleWakeIdentity({
+      ...f.input,
+      rearmGeneration: 1,
+      sharedAttemptKey: true,
+    }).runId;
+    f.parentFields.runId = f.input.runId;
+    expect(f.owner.prepareSynthesis(f.input)).toBeUndefined();
+    f.parent("mixed-native-wake", "Do not combine unrelated source presentations.");
+    await drain();
+    expect(f.publish).not.toHaveBeenCalled();
+    await f.owner.reset();
+  });
+
+  it("admits only actual parent execution, then requests tool-only progress at the native safe boundary", async () => {
+    const f = synthesisFixture();
+    const owner = f.owner.prepareSynthesis(f.input);
+    expect(owner).toBeDefined();
+    f.parent("before-start", "This execution has not been admitted yet.");
+    f.setClock(180_000);
+    f.owner.checkpoint();
+    await drain();
+    expect(f.publish).not.toHaveBeenCalled();
+    expect(f.requestCheckpoint).not.toHaveBeenCalled();
+    owner!.start();
+    f.emit(
+      { phase: "start", toolCallId: "private-inspection" },
+      {
+        ...f.parentFields,
+        stream: "tool",
+      },
+    );
+    f.setClock(360_000);
+    f.owner.checkpoint();
+    f.owner.checkpoint();
+    await drain();
+    expect(f.requestCheckpoint).toHaveBeenCalledOnce();
+    const request = f.requestCheckpoint.mock.calls[0]![0];
+    expect(request).toMatchObject({
+      runId: f.input.runId,
+      sessionKey: f.input.requesterSessionKey,
+      sessionId: f.input.requesterSessionId,
+      cohort: [f.initial],
+      queueIdentity: "subagent-progress:private-parent-synthesis:180000",
+    });
+    request.assertCurrent();
+    f.parent("checkpoint", "The delegated results agree; checking the release evidence now.");
+    await drain();
+    expect(f.publish).toHaveBeenCalledOnce();
+    expect(f.publish.mock.calls[0]![0]).toMatchObject({
+      runId: f.input.runId,
+      cohort: [f.initial],
+      source: { channel: "discord", accountId: "bot", to: "channel:parent" },
+    });
+    expect(request.signal.aborted).toBe(true);
+    await f.owner.reset();
+  });
+
+  it("keeps one parent presentation across repeated observation and uncertain sends, then retires at actual terminal", async () => {
+    const f = synthesisFixture();
+    const first = f.owner.prepareSynthesis(f.input);
+    const concurrent = f.owner.prepareSynthesis(f.input);
+    first!.start();
+    concurrent!.start();
+    f.owner.prepareSynthesis(f.input)!.start();
+    f.publish.mockRejectedValueOnce(new Error("platform acceptance unknown"));
+    f.parent("one", "The original work is ready; checking the final result.");
+    await drain();
+    f.parent("one", "The original work is ready; checking the final result.");
+    f.parent("two", "The final checks passed; preparing the response.");
+    await drain();
+    expect(f.publish).toHaveBeenCalledTimes(2);
+    f.emit(
+      { phase: "final", text: "Final belongs to the native parent reply owner." },
+      f.parentFields,
+    );
+    f.emit({ phase: "end" }, { ...f.parentFields, stream: "lifecycle" });
+    f.parent("late", "Do not deliver after terminal.");
+    f.setClock(1_000_000);
+    f.owner.checkpoint();
+    await drain();
+    expect(f.publish).toHaveBeenCalledTimes(2);
+    expect(f.requestCheckpoint).not.toHaveBeenCalled();
+    await f.owner.reset();
+  });
+
+  it("cannot start a prepared presentation after its native registry observer was reset", async () => {
+    const f = synthesisFixture();
+    const prepared = f.owner.prepareSynthesis(f.input);
+    await f.owner.reset();
+    expect(prepared!.start).toThrow("presentation was retired");
+    f.parent("late", "This observer has already been retired.");
+    await drain();
+    expect(f.publish).not.toHaveBeenCalled();
+    expect(f.requestCheckpoint).not.toHaveBeenCalled();
+  });
+
+  it("revalidates prepared-but-unstarted input without reserving another parent cohort", async () => {
+    const f = synthesisFixture();
+    const stale = f.owner.prepareSynthesis(f.input);
+    f.revoke();
+    expect(stale!.start).toThrow("lost its original cohort");
+    const current = f.owner.prepareSynthesis({ ...f.input, isCurrent: () => true });
+    current!.start();
+    f.parent("admitted", "The current native parent owns this update.");
+    await drain();
+    expect(f.publish).toHaveBeenCalledOnce();
+    await f.owner.reset();
+  });
+
+  it.each(["cohort", "row", "incarnation"] as const)(
+    "revokes pending parent work with the exact %s owner",
+    async (mode) => {
+      const f = synthesisFixture();
+      f.owner.prepareSynthesis(f.input)!.start();
+      f.setClock(180_000);
+      f.owner.checkpoint();
+      await drain();
+      const request = f.requestCheckpoint.mock.calls[0]![0];
+      if (mode === "cohort") {
+        f.revoke();
+      } else {
+        f.runs.set(f.initial.runId, {
+          ...f.initial,
+          ...(mode === "row" ? { generation: 2 } : { completionRequesterSessionId: "replacement" }),
+        });
+        f.changes();
+      }
+      expect(request.assertCurrent).toThrow();
+      expect(request.signal.aborted).toBe(true);
+      f.parent("late", "This result lost its original owner.");
+      await drain();
+      expect(f.publish).not.toHaveBeenCalled();
+      await f.owner.reset();
+    },
+  );
+
+  it.each([
+    { requesterTurnRunId: "another-turn" },
+    { completionRequesterSessionId: "another-incarnation" },
+    {
+      progressOrigin: {
+        channel: "discord",
+        to: "channel:parent",
+        accountId: "other",
+        messageId: "original",
+      },
+    },
+    {
+      progressOrigin: {
+        channel: "discord",
+        to: "channel:parent",
+        accountId: "bot",
+        messageId: "other",
+      },
+    },
+    {
+      progressOrigin: {
+        channel: "discord",
+        to: "channel:parent",
+        accountId: "bot",
+        messageId: "original",
+        threadId: "other",
+      },
+    },
+  ] satisfies Partial<SubagentRunRecord>[])(
+    "rejects a mixed original source/cohort %j",
+    async (patch) => {
+      const f = synthesisFixture();
+      const other = { ...f.initial, runId: "other-child", ...patch };
+      f.runs.set(other.runId, other);
+      expect(
+        f.owner.prepareSynthesis({ ...f.input, batchRunIds: [f.initial.runId, other.runId] }),
+      ).toBeUndefined();
+      f.parent("mixed", "Do not mix unrelated work.");
+      await drain();
+      expect(f.publish).not.toHaveBeenCalled();
+      await f.owner.reset();
+    },
+  );
+});

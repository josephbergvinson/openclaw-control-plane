+vi.mock("../plugins/runtime/runtime-agent.js", () => ({ createRuntimeAgent }));
+vi.mock("../talk/agent-consult-runtime.js", () => ({ consultRealtimeVoiceAgent }));
+
+const params: Parameters<typeof runTranscriptRecordConsult>[0] = {
+  config: { agents: { entries: { resident: {} } } },
+  agentId: "resident",
+  provider: "requested-provider",

+def checkout_protocol_comparison_base():
+    base = os.environ.get("CHECKOUT_PROTOCOL_SINCE_BASE_SHA", "")
+    if not base:
+        return
+    head = resolve_ref("HEAD")
+    if (kind != "preflight" or os.environ.get("GITHUB_EVENT_NAME") != "workflow_dispatch"
+            or os.environ.get("CHECKOUT_PRIVATE_QUALIFICATION") != "true"

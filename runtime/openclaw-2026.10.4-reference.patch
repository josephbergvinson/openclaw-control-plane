+  it.each([
+    { builder: "host", unrestricted: false },
+    { builder: "raw", unrestricted: false },
+    { builder: "retired", unrestricted: false },
+    { builder: "host", unrestricted: true },
+  ] as const)(
+    "keeps only the current $builder Gateway through the ordinary producer (unrestricted=$unrestricted)",
+    async ({ builder, unrestricted }) => {
+      const { loadDiscordIngressContextFixture } =
+        await import("../extensions/discord/test-api.js");
+      const fixture = await loadDiscordIngressContextFixture();
+      await withOpenClawTestState({ label: "discord-preflight-native-owner" }, async (state) => {
+        const channelId = "channel-native-boundary";
+        const guildId = "guild-native-boundary";
+        const senderId = "123456789012345678";
+        const agentId = unrestricted ? "coordination" : "main";
+        const guildEntries = {
+          [guildId]: {
+            ...(unrestricted ? {} : { users: [senderId] }),
+            requireMention: false,
+            channels: { [channelId]: { enabled: true } },
+          },
+        };
+        const discordConfig = { groupPolicy: "allowlist" as const, guilds: guildEntries };
+        const cfg: OpenClawConfig = {
+          ...(unrestricted
+            ? {
+                agents: { entries: { main: {}, coordination: { workspace: state.stateDir } } },
+                bindings: [{ agentId, match: { channel: "discord", guildId } }],
+              }
+            : {}),
+          session: { store: path.join(state.stateDir, "sessions.json") },
+          channels: { discord: discordConfig },
+        };
+        await state.writeConfig(cfg);
+        await withRegisteredChannelIngress(
+          { plugin: fixture.discordPlugin, config: cfg, setRuntime: fixture.setDiscordRuntime },
+          async (runtime, retire) => {
+            const text = "Check the project access.";
+            const message = fixture.createDiscordMessage({
+              id: "message-native-boundary",
+              channelId,
+              content: text,
+              author: { id: senderId, bot: false, username: "operator" },
+            });
+            const preflight = await fixture.preflightDiscordMessage({
+              ...fixture.createDiscordPreflightArgs({
+                cfg,
+                discordConfig,
+                data: fixture.createGuildEvent({
+                  channelId,
+                  guildId,
+                  author: message.author,
+                  message,
+                }),
+                client: fixture.createGuildTextClient(channelId),
+              }),
+              guildEntries,
+              buildContext:
+                builder === "raw"
+                  ? buildChannelInboundEventContext
+                  : runtime.channel.inbound.buildContext,
+            });
+            expect(preflight).not.toBeNull();
+            if (!preflight) {
+              throw new Error("Expected an admitted ordinary Discord source");
+            }
+            if (builder === "retired") {
+              retire();
+            }
+            let processed: Awaited<ReturnType<typeof fixture.buildDiscordMessageProcessContext>>;
+            try {
+              processed = await fixture.buildDiscordMessageProcessContext({

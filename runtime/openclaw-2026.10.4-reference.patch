+
+function resolveEmbeddedRunAccountingTarget(input: {
+  session: Pick<SessionPromptState, "committedCompactionSuccessor" | "sessionWriterFence">;
+  originalTarget: NonNullable<SessionPromptState["sessionTarget"]>;
+  durable: boolean;

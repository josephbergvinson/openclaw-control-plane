+import { describe, expect, it, vi } from "vitest";
+import { getReplyPayloadMetadata } from "../reply-payload.js";
+import { createReplyTurnLedger } from "./dispatch-from-config.turn-ledger.js";
+import { createReplyDispatcher } from "./reply-dispatcher.js";
+import { buildWaitingStatusPayload } from "./waiting-status.js";
+
+describe("continuation status presentation", () => {
+  it.each([undefined, "Source verified; the final review is running."])(
+    "preserves authored acknowledgment and dispatches its typed status (%s)",
+    async (acknowledgment) => {
+      const payload = buildWaitingStatusPayload({
+        completion: { expectation: "required", outcome: "pending" },
+        yielded: true,
+        hasVisibleMessageDelivery: false,
+        yieldAcknowledgment: acknowledgment,
+      })!;
+      expect(payload.text).toBe(
+        acknowledgment ?? "I’m continuing this work and will send the result when it is ready.",
+      );
+      expect(getReplyPayloadMetadata(payload)?.continuationStatus).toBe(true);
+      expect(getReplyPayloadMetadata(payload)?.continuationStatusAuthored === true).toBe(
+        Boolean(acknowledgment),
+      );
+      type Options = Parameters<typeof createReplyDispatcher>[0];
+      const deliver = vi.fn<Options["deliver"]>(async () => ({ visibleReplySent: true }));
+      const beforeDeliver = vi.fn<NonNullable<Options["beforeDeliver"]>>((current) => current);
+      const dispatcher = createReplyDispatcher({ deliver, beforeDeliver });
+      dispatcher.sendFinalReply(payload);
+      dispatcher.markComplete();
+      await dispatcher.waitForIdle();
+      expect(beforeDeliver.mock.calls[0]?.[1]).toMatchObject({
+        continuationStatus: { authored: Boolean(acknowledgment) },
+      });
+      expect(deliver.mock.calls[0]?.[1]).toMatchObject({
+        continuationStatus: { authored: Boolean(acknowledgment) },
+      });
+    },
+  );
+  it("records a committed continuation as visibility without settling the owed final result", async () => {
+    const deliver = vi.fn<Parameters<typeof createReplyDispatcher>[0]["deliver"]>(async () => ({
+      visibleReplySent: true,
+    }));
+    const dispatcher = createReplyDispatcher({ deliver });
+    const ledger = createReplyTurnLedger(dispatcher);
+    const status = buildWaitingStatusPayload({
+      completion: { expectation: "required", outcome: "pending" },
+      yielded: true,
+      hasVisibleMessageDelivery: false,
+      yieldAcknowledgment: "Validation is running.",
+    })!;
+    const checkpoint = ledger.sendQueued("final", status);
+    expect(await checkpoint.outcome).toBe("delivered");
+    expect(ledger.hasObservedDelivery()).toBe(true);
+    expect(ledger.resolveTerminalDelivery()).toBe("missing");
+    ledger.sendQueued("final", { text: "The verified result." });
+    dispatcher.markComplete();
+    expect(await ledger.settleQueued()).toBe("settled");
+    expect(ledger.resolveTerminalDelivery()).toBe("delivered");
+    expect(deliver.mock.calls.map(([payload]) => payload.text)).toEqual([
+      "Validation is running.",
+      "The verified result.",
+    ]);
+  });
+});

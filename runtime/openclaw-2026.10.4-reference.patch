+++ b/apps/shared/OpenClawKit/Tests/OpenClawKitTests/NativeCredentialKeychainPurposeTests.swift
@@ -0,0 +1,181 @@
+#if os(macOS)
+import Foundation
+import Testing
+@testable import OpenClawKit
+
+/// Synthetic metadata only: no Keychain, AX, preferences, or live services.
+struct NativeCredentialKeychainPurposeTests {
+    private static let host = "11111111-1111-4111-8111-111111111111"
+
+    private static func accessEvidence(item: String) -> [String] {
+        [
+            "security wants to use your confidential information stored in “\(item)” in your keychain.",
+            "To allow this, enter the “login” keychain password.",
+            "Always Allow", "Deny", "Allow",
+        ]
+    }
+
+    @Test(arguments: ["com.openclaw.browser-credentials.v1", "example.other.service"])
+    func `login Keychain access authorizes the enrolled current local principal without visible account`(
+        _ item: String) throws
+    {
+        let binding = try NativeCredentialBinding(
+            alias: "mac.fixture.password",
+            kind: .macLogin,
+            account: NSUserName(),
+            hostID: Self.host,
+            bundleIDs: ["com.apple.SecurityAgent"])
+        #expect(binding.authorizes(
+            hostID: Self.host,
+            bundleID: "com.apple.SecurityAgent",
+            accountEvidence: Self.accessEvidence(item: item)))
+    }
+
+    @Test(arguments: [
+        "codesign wants to sign using key “Developer ID Application: Example” in your keychain.",
+        "",
+        "fixture requests authorization for a private key operation.",
+    ])
+    func `login Keychain authority does not require a generic password item sentence`(_ body: String) throws {
+        let host = "11111111-1111-4111-8111-111111111111"
+        let binding = try NativeCredentialBinding(
+            alias: "mac.fixture.password",
+            kind: .macLogin,
+            account: "fixture",
+            hostID: host,
+            bundleIDs: ["com.apple.SecurityAgent"])
+        let evidence = [body, "To allow this, enter the “login” keychain password.", "Always Allow", "Deny", "Allow"]
+        #expect(binding.authorizes(
+            hostID: host,
+            bundleID: "com.apple.SecurityAgent",
+            accountEvidence: evidence,
+            localAccount: "fixture"))
+    }
+
+    @Test(arguments: ["instruction", "keychain", "control", "conflict"])
+    func `signing body account text cannot replace the Keychain instruction and controls`(_ change: String) throws {
+        let binding = try NativeCredentialBinding(
+            alias: "mac.fixture.password",
+            kind: .macLogin,
+            account: "fixture",
+            hostID: Self.host,
+            bundleIDs: ["com.apple.SecurityAgent"])
+        var evidence = [
+            "fixture requests authorization for a private key operation.",
+            "To allow this, enter the “login” keychain password.",
+            "Always Allow",
+            "Deny",
+            "Allow",
+        ]
+        switch change {
+        case "instruction": evidence.remove(at: 1)
+        case "keychain": evidence[1] = "To allow this, enter the “other” keychain password."
+        case "control": evidence.removeLast()
+        case "conflict": evidence.append("To allow this, enter the “other” keychain password.")
+        default: Issue.record("Unknown fixture")
+        }
+        #expect(NativeCredentialPromptPurpose.resolve(nativeEvidence: evidence) == .unsupportedKeychainAccess)
+        #expect(!binding.authorizes(
+            hostID: Self.host,
+            bundleID: "com.apple.SecurityAgent",
+            accountEvidence: evidence,
+            localAccount: "fixture"))
+    }
+
+    @Test(arguments: [
+        "host",
+        "principal",
+        "owner",
+        "keychain",
+        "instruction",
+        "control",
+        "ambiguous",
+        "web",
+    ])
+    func `Keychain purpose does not replace host principal owner or exact form authority`(_ change: String) throws {
+        let binding = try NativeCredentialBinding(
+            alias: "mac.fixture.password",
+            kind: .macLogin,
+            account: "fixture",
+            hostID: Self.host,
+            bundleIDs: ["com.apple.SecurityAgent", "com.apple.ScreenContinuity"])
+        var evidence = Self.accessEvidence(item: "example.service")
+        var host = Self.host
+        var owner = "com.apple.SecurityAgent"
+        var principal = "fixture"
+        switch change {
+        case "host": host = "22222222-2222-4222-8222-222222222222"
+        case "principal": principal = "other"
+        case "owner": owner = "com.apple.ScreenContinuity"
+        case "keychain": evidence[1] = "To allow this, enter the “other” keychain password."
+        case "instruction": evidence[1] = "Enter your provider password."
+        case "control": evidence.removeLast()
+        case "ambiguous":
+            evidence.append("To allow this, enter the “other” keychain password.")
+        case "web": owner = "com.apple.Safari"
+        default: Issue.record("Unknown fixture")
+        }
+        #expect(!binding.authorizes(
+            hostID: host, bundleID: owner, accountEvidence: evidence, localAccount: principal))
+    }
+
+    @Test(arguments: ["keychain", "instruction", "control", "ambiguous"])
+    func `unrecognized Keychain form never uses its item as account evidence`(_ change: String) throws {
+        let binding = try NativeCredentialBinding(
+            alias: "mac.fixture.password",
+            kind: .macLogin,
+            account: "fixture",
+            hostID: Self.host,
+            bundleIDs: ["com.apple.SecurityAgent"])
+        var evidence = Self.accessEvidence(item: "fixture")
+        switch change {
+        case "keychain": evidence[1] = "To allow this, enter the “other” keychain password."
+        case "instruction": evidence[1] = "Enter your provider password."
+        case "control": evidence.removeLast()
+        case "ambiguous":
+            evidence.append("To allow this, enter the “other” keychain password.")
+        default: Issue.record("Unknown fixture")
+        }
+        #expect(NativeCredentialPromptPurpose.resolve(nativeEvidence: evidence) == .unsupportedKeychainAccess)
+        #expect(!binding.authorizes(
+            hostID: Self.host, bundleID: "com.apple.SecurityAgent", accountEvidence: evidence, localAccount: "fixture"))
+    }
+
+    @Test func `purpose is observed authentication but never binding metadata migration`() throws {
+        let evidence = Self.accessEvidence(item: "example.service")
+        let binding = try NativeCredentialBinding(
+            alias: "mac.fixture.password",
+            kind: .macLogin,
+            account: "fixture",
+            hostID: Self.host,
+            bundleIDs: ["com.apple.SecurityAgent"])
+        #expect(NativeCredentialPromptPurpose.resolve(nativeEvidence: evidence) ==
+            .loginKeychainAuthentication)
+        #expect(!binding.authorizes(
+            hostID: Self.host,
+            bundleID: "com.apple.SecurityAgent",
+            accountEvidence: evidence,
+            purpose: .accountAuthentication,
+            localAccount: "fixture"))
+        #expect(!binding.authorizes(
+            hostID: Self.host,
+            bundleID: "com.apple.SecurityAgent",
+            accountEvidence: Self.accessEvidence(item: "fixture"),
+            purpose: .accountAuthentication,
+            localAccount: "other"))
+        let decoded = try JSONDecoder().decode(NativeCredentialBinding.self, from: JSONEncoder().encode(binding))
+        #expect(decoded == binding)
+        #expect(decoded.version == 1)
+        #expect(binding.authorizes(
+            hostID: Self.host,
+            bundleID: "com.apple.SecurityAgent",
+            accountEvidence: ["Authenticate as fixture"],
+            localAccount: "other"))
+        #expect(!binding.authorizes(
+            hostID: Self.host,
+            bundleID: "com.apple.SecurityAgent",
+            accountEvidence: ["Authenticate as other"],
+            localAccount: "fixture"))
+    }
+}
+#endif

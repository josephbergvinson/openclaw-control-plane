+import { SessionManager } from "../sessions/session-manager.js";
+import { createAdmittedHostCapabilityTestFixture } from "./host-capability.test-support.js";
+
+describe("captured source-preserving harness context", () => {
+  it("retains the detached original independently of later manager and plugin mutations", async () => {
+    const manager = SessionManager.inMemory(process.cwd());
+    await manager.appendMessageAsync(makeUserMessage("original durable fact", 1));
+    const observer = vi.fn();
+    const host = await createAdmittedHostCapabilityTestFixture({

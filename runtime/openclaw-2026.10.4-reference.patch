diff --git a/apps/shared/OpenClawKit/Sources/OpenClawKit/NativeCredentialBinding.swift b/apps/shared/OpenClawKit/Sources/OpenClawKit/NativeCredentialBinding.swift
new file mode 100644
index 0000000000000000000000000000000000000000..626dc13335fde9e81a49b0ebd2ff1118c177ec3f
--- /dev/null
+++ b/apps/shared/OpenClawKit/Sources/OpenClawKit/NativeCredentialBinding.swift
@@ -0,0 +1,340 @@
+#if os(macOS)
+import Foundation
+import IOKit
+import LocalAuthentication
+import Security
+
+/// Purpose comes from the captured native form, never tool-supplied text.
+public enum NativeCredentialPromptPurpose: Equatable, Sendable {
+    case accountAuthentication
+    case administratorAuthentication
+    case unsupportedAdministratorAuthentication
+    case unsupportedKeychainAccess
+    case loginKeychainAuthentication
+    case autoFillAuthentication
+    case passwordsUnlockAuthentication
+    case localPasskeyAuthentication
+
+    public static func localPasskeyAccount(nativeEvidence: [String]) -> String? {
+        let prefix = "Enter the computer account password for the user “"
+        let suffix = "”."
+        let instructions = Set(nativeEvidence.filter { $0.hasPrefix("Enter the computer account password") })
+        guard instructions.count == 1, let instruction = instructions.first,
+              instruction.hasPrefix(prefix), instruction.hasSuffix(suffix)
+        else { return nil }
+        let account = String(instruction.dropFirst(prefix.count).dropLast(suffix.count))
+        guard !account.isEmpty, account.count <= 320,
+              account == account.trimmingCharacters(in: .whitespacesAndNewlines),
+              !account.contains("“"), !account.contains("”"),
+              !account.unicodeScalars.contains(where: CharacterSet.controlCharacters.contains)
+        else { return nil }
+        return account
+    }
+
+    public static func passwordsUnlockAccount(nativeEvidence: [String]) -> String? {
+        let prefix = "Enter the password for the user “"
+        let suffix = "” to unlock."
+        let accounts = Set(nativeEvidence.compactMap { label -> String? in
+            guard label.hasPrefix(prefix), label.hasSuffix(suffix) else { return nil }
+            let account = String(label.dropFirst(prefix.count).dropLast(suffix.count))
+            guard !account.isEmpty, !account.contains("“"), !account.contains("”") else { return nil }
+            return account
+        })
+        return accounts.count == 1 ? accounts.first : nil
+    }
+
+    public static func resolve(nativeEvidence: [String]) -> Self {
+        let evidence = Set(nativeEvidence)
+        let instructions = evidence.filter {
+            $0.hasPrefix("To allow this, enter the ") && $0.hasSuffix(" keychain password.")
+        }
+        // This exact native installer instruction still enters the same strict
+        // labelled-username administrator form and current-local-account guard.
+        let updaterInstruction = "Enter your password to continue with “DevicesSystemUpdater”."
+        let administratorInstructions = evidence.filter {
+            ($0.hasPrefix("Enter ") && $0.contains("administrator") && $0.contains("password")) ||
+                $0 == updaterInstruction
+        }
+        if !administratorInstructions.isEmpty {
+            let supported: Set = [
+                "Enter an administrator’s name and password to allow this.",
+                "Enter an administrator's name and password to allow this.",
+                updaterInstruction,
+            ]
+            guard administratorInstructions.count == 1,
+                  administratorInstructions.allSatisfy(supported.contains),
+                  evidence.contains("Cancel"), !evidence.contains("Always Allow"), instructions.isEmpty
+            else { return .unsupportedAdministratorAuthentication }
+            return .administratorAuthentication
+        }
+        // An incomplete or different Keychain form must not borrow an account
+        // token from its item/requester text through the legacy account route.
+        let fallback: Self = evidence.contains("Always Allow") || !instructions.isEmpty || evidence.contains {
+            $0.contains(" wants to use your confidential information stored in ") &&
+                $0.hasSuffix(" in your keychain.")
+        } ? .unsupportedKeychainAccess : .accountAuthentication
+        if fallback == .accountAuthentication, evidence.isSuperset(of: ["Unlock", "Cancel"]),
+           self.localPasskeyAccount(nativeEvidence: nativeEvidence) != nil
+        {
+            return .localPasskeyAuthentication
+        }
+        if fallback == .accountAuthentication, evidence.isSuperset(of: ["AutoFillAuthenticationSheet", "Cancel"]),
+           evidence.contains("Sign In") || evidence.contains("AutoFill")
+        {
+            return .autoFillAuthentication
+        }
+        if fallback == .accountAuthentication,
+           evidence.isSuperset(of: ["Passwords Is Locked", "Unlock", "Cancel"]),
+           self.passwordsUnlockAccount(nativeEvidence: nativeEvidence) != nil
+        {
+            return .passwordsUnlockAuthentication
+        }
+        let loginInstructions: Set = [
+            "To allow this, enter the “login” keychain password.",
+            "To allow this, enter the \"login\" keychain password.",
+        ]
+        guard evidence.isSuperset(of: ["Always Allow", "Deny", "Allow"]),
+              !instructions.isEmpty, instructions.allSatisfy(loginInstructions.contains)
+        else { return fallback }
+        // Signing, private-key and password-item bodies differ. The native
+        // password instruction identifies the Keychain authentication purpose;
+        // the complete body remains captured evidence for entry revalidation.
+        return .loginKeychainAuthentication
+    }
+}
+
+/// Non-secret authority attached to an existing generic-password item. A copied
+/// item does not authorize another Mac: the binding is checked against its host.
+public struct NativeCredentialBinding: Codable, Equatable, Sendable {
+    public enum Kind: String, Codable, Sendable { case appleAccount, macLogin }
+    /// These owners present OS/account authentication UI. Safari is supported
+    /// only for its native AutoFill and locked Passwords sheets, never web fields.
+    public static func supportedBundleIDs(for kind: Kind) -> Set<String> {
+        switch kind {
+        case .appleAccount:
+            ["com.apple.systempreferences"]
+        case .macLogin:
+            [
+                "com.apple.SecurityAgent",
+                "com.apple.LocalAuthentication.UIAgent",
+                "com.apple.Passwords",
+                "com.apple.ScreenContinuity",
+                "com.apple.Safari",
+                "com.apple.AuthenticationServices.Helper",
+            ]
+        }
+    }
+
+    public let version: Int
+    public let alias: String
+    public let kind: Kind
+    public let account: String
+    public let hostID: String
+    public let bundleIDs: [String]
+
+    public init(alias: String, kind: Kind, account: String, hostID: String, bundleIDs: [String]) throws {
+        self.version = 1
+        self.alias = alias
+        self.kind = kind
+        self.account = account
+        self.hostID = hostID
+        self.bundleIDs = bundleIDs
+        try self.validate()
+    }
+
+    public func validate() throws {
+        guard self.version == 1,
+              self.alias.range(of: #"^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"#, options: .regularExpression) != nil,
+              !self.account.isEmpty, self.account.count <= 320,
+              self.account == self.account.trimmingCharacters(in: .whitespacesAndNewlines),
+              !self.account.unicodeScalars.contains(where: CharacterSet.controlCharacters.contains),
+              UUID(uuidString: self.hostID) != nil,
+              !self.bundleIDs.isEmpty, self.bundleIDs.count <= 16,
+              self.bundleIDs.allSatisfy({
+                  Self.supportedBundleIDs(for: self.kind).contains($0)
+              })
+        else { throw NativeCredentialError.invalidBinding }
+    }
+
+    public func authorizes(
+        hostID: String,
+        bundleID: String,
+        accountEvidence: [String],
+        purpose: NativeCredentialPromptPurpose? = nil,
+        localAccount: String = NSUserName(),
+        localAccountFullName: String = "",
+        selectedUsername: String? = nil) -> Bool
+    {
+        guard (try? self.validate()) != nil,
+              self.hostID.caseInsensitiveCompare(hostID) == .orderedSame,
+              self.bundleIDs.contains(bundleID)
+        else { return false }
+        let observedPurpose = NativeCredentialPromptPurpose.resolve(nativeEvidence: accountEvidence)
+        let purpose = purpose ?? observedPurpose
+        guard purpose == observedPurpose,
+              purpose != .unsupportedKeychainAccess, purpose != .unsupportedAdministratorAuthentication
+        else { return false }
+        // The native owner supplies the current OS short/full-name pair. A
+        // display name identifies this recipient only when the saved binding
+        // still belongs to the current short-name principal.
+        let matchesLocalRecipient: (String?) -> Bool = { recipient in
+            guard self.kind == .macLogin, !localAccount.isEmpty,
+                  self.account.caseInsensitiveCompare(localAccount) == .orderedSame,
+                  let recipient
+            else { return false }
+            return recipient.caseInsensitiveCompare(self.account) == .orderedSame ||
+                (!localAccountFullName.isEmpty && recipient == localAccountFullName)
+        }
+        if bundleID == "com.apple.AuthenticationServices.Helper" {
+            // The provider account names a passkey requester, not the recipient
+            // of the Mac password. Only the complete local-user instruction does.
+            return purpose == .localPasskeyAuthentication && matchesLocalRecipient(
+                NativeCredentialPromptPurpose.localPasskeyAccount(nativeEvidence: accountEvidence))
+        }
+        if purpose == .localPasskeyAuthentication { return false }
+        if bundleID == "com.apple.Safari" {
+            // Native AutoFill authenticates the current Mac user even when its
+            // account instruction is absent from AX. Provider account text is
+            // not authority for the local password.
+            guard self.kind == .macLogin, !localAccount.isEmpty,
+                  self.account.caseInsensitiveCompare(localAccount) == .orderedSame
+            else { return false }
+            if purpose == .autoFillAuthentication { return true }
+            return purpose == .passwordsUnlockAuthentication && matchesLocalRecipient(
+                NativeCredentialPromptPurpose.passwordsUnlockAccount(nativeEvidence: accountEvidence))
+        }
+        if purpose == .autoFillAuthentication || purpose == .passwordsUnlockAuthentication { return false }
+        if case .administratorAuthentication = purpose {
+            // Only the native owner supplies the separately observed username.
+            // A display name or account mentioned in the request body cannot
+            // identify the local principal whose saved password we hold.
+            return self.kind == .macLogin && bundleID == "com.apple.SecurityAgent" && !localAccount.isEmpty &&
+                self.account.caseInsensitiveCompare(localAccount) == .orderedSame &&
+                selectedUsername?.caseInsensitiveCompare(localAccount) == .orderedSame
+        }
+        if case .loginKeychainAuthentication = purpose {
+            // A login-Keychain access form identifies the local Keychain rather
+            // than repeating its account. Keep authority on this enrolled Mac
+            // and its current principal; never use this for a provider password.
+            return self.kind == .macLogin &&
+                bundleID == "com.apple.SecurityAgent" && !localAccount.isEmpty &&
+                self.account.caseInsensitiveCompare(localAccount) == .orderedSame
+        }
+        if bundleID == "com.apple.Passwords" {
+            // The locked view supplies the complete account from its native
+            // instruction, not surrounding text that might name another user.
+            return purpose == .accountAuthentication && accountEvidence.count == 1 &&
+                matchesLocalRecipient(accountEvidence.first)
+        }
+        // Exact token boundaries prevent another account's suffix/display name
+        // from authorizing this credential. Evidence comes from native AX only.
+        let expected = NSRegularExpression.escapedPattern(for: self.account)
+        let pattern = #"(?<![\p{L}\p{N}_.@+-])"# + expected + #"(?![\p{L}\p{N}_.@+-])"#
+        return accountEvidence
+            .contains { $0.range(of: pattern, options: [.regularExpression, .caseInsensitive]) != nil }
+    }
+}
+
+public enum NativeCredentialError: String, LocalizedError, Sendable {
+    case invalidBinding = "NATIVE_CREDENTIAL_INVALID_BINDING"
+    case unavailable = "NATIVE_CREDENTIAL_UNAVAILABLE"
+    case stalePrompt = "NATIVE_CREDENTIAL_STALE_PROMPT"
+    case refused = "NATIVE_CREDENTIAL_PROMPT_NOT_AUTHORIZED"
+    case entryFailed = "NATIVE_CREDENTIAL_ENTRY_FAILED"
+    public var errorDescription: String? {
+        self.rawValue
+    }
+}
+
+public enum NativeCredentialKeychain {
+    /// Shares the existing alias namespace; never migrates or changes passwords.
+    public static let service = "com.openclaw.browser-credentials.v1"
+
+    public static func bindings() throws -> [NativeCredentialBinding] {
+        var query = self.query()
+        query[kSecReturnAttributes as String] = true
+        query[kSecMatchLimit as String] = kSecMatchLimitAll
+        var result: CFTypeRef?
+        let status = SecItemCopyMatching(query as CFDictionary, &result)
+        if status == errSecItemNotFound { return [] }
+        guard status == errSecSuccess, let rows = result as? [[String: Any]] else {
+            throw NativeCredentialError.unavailable
+        }
+        return rows.compactMap { row in
+            guard let data = row[kSecAttrGeneric as String] as? Data,
+                  let binding = try? JSONDecoder().decode(NativeCredentialBinding.self, from: data),
+                  binding.alias == row[kSecAttrAccount as String] as? String,
+                  (try? binding.validate()) != nil else { return nil }
+            return binding
+        }
+    }
+
+    /// Local operator enrollment updates only non-secret metadata, on an existing
+    /// item. It never creates an item, changes its password, or replaces its ACL.
+    public static func bind(_ binding: NativeCredentialBinding) throws {
+        try binding.validate()
+        let data = try self.metadata(binding)
+        let status = SecItemUpdate(
+            self.query(alias: binding.alias) as CFDictionary,
+            [kSecAttrGeneric as String: data] as CFDictionary)
+        guard status == errSecSuccess else { throw NativeCredentialError.unavailable }
+    }
+
+    /// The credential exists only inside this native callback. Query failures do
+    /// not open a new Keychain prompt or send Security framework text to a model.
+    public static func withSecret(
+        binding: NativeCredentialBinding,
+        _ consume: (String) throws -> Void) throws
+    {
+        guard try self.bindings().contains(binding) else { throw NativeCredentialError.refused }
+        var query = self.query(alias: binding.alias)
+        // A matching alias in another searched Keychain must not substitute a
+        // password whose item carries different account/host authority.
+        query[kSecAttrGeneric as String] = try self.metadata(binding)
+        query[kSecReturnData as String] = true
+        query[kSecMatchLimit as String] = kSecMatchLimitOne
+        var result: CFTypeRef?
+        guard SecItemCopyMatching(query as CFDictionary, &result) == errSecSuccess,
+              var data = result as? Data else { throw NativeCredentialError.unavailable }
+        defer { data.resetBytes(in: data.startIndex..<data.endIndex) }
+        guard let value = String(data: data, encoding: .utf8), !value.isEmpty, value.utf8.count <= 8192,
+              !value.unicodeScalars.contains(where: CharacterSet.controlCharacters.contains)
+        else { throw NativeCredentialError.unavailable }
+        try consume(value)
+    }
+
+    private static func metadata(_ binding: NativeCredentialBinding) throws -> Data {
+        let encoder = JSONEncoder()
+        encoder.outputFormatting = [.sortedKeys]
+        return try encoder.encode(binding)
+    }
+
+    private static func query(alias: String? = nil) -> [String: Any] {
+        let context = LAContext()
+        context.interactionNotAllowed = true
+        var query: [String: Any] = [
+            kSecClass as String: kSecClassGenericPassword,
+            kSecAttrService as String: self.service,
+            kSecUseAuthenticationContext as String: context,
+        ]
+        if let alias { query[kSecAttrAccount as String] = alias }
+        return query
+    }
+}
+
+public enum NativeCredentialHost {
+    public static func identity() throws -> String {
+        let service = IOServiceGetMatchingService(kIOMainPortDefault, IOServiceMatching("IOPlatformExpertDevice"))
+        guard service != 0 else { throw NativeCredentialError.unavailable }
+        defer { IOObjectRelease(service) }
+        guard let value = IORegistryEntryCreateCFProperty(
+            service,
+            "IOPlatformUUID" as CFString,
+            kCFAllocatorDefault,
+            0)?.takeRetainedValue() as? String,
+            UUID(uuidString: value) != nil else { throw NativeCredentialError.unavailable }
+        return value
+    }
+}
+
+#endif

+import { resetPluginRuntimeStateForTest, setActivePluginRegistry } from "../../plugins/runtime.js";
+import { getAsyncWorkSignal } from "../../shared/async-work-scope.js";
+import { createOutboundTestPlugin, createTestRegistry } from "../../test-utils/channel-plugins.js";
+import { registerChatAbortController, type ChatAbortControllerEntry } from "../chat-abort.js";
+import { runComposedRequesterFinalization } from "./agent-run-execution-phase.finalization.test-support.js";
+import { startAgentRunExecution } from "./agent-run-execution-phase.js";
+import { createExecution } from "./agent-run-execution-phase.test-support.js";
+
+const { dispatchAgentRunFromGateway, agentCommand } = vi.hoisted(() => ({
+  dispatchAgentRunFromGateway: vi.fn(),
+  agentCommand: vi.fn(),
+}));
+vi.mock("../../commands/agent.js", () => ({ agentCommandFromGatewayIngress: agentCommand }));
+vi.mock("./agent-run-dispatch.js", () => ({ dispatchAgentRunFromGateway }));
+
+function createStartExecution(runId?: string) {
+  const execution = createExecution();
+  if (runId) {
+    execution.params.runId = runId;
+  }
+  const controllers = new Map<string, ChatAbortControllerEntry>();
+  const instance = createOperationalRunInstanceRef(execution.params.runId);
+  const registration = registerChatAbortController({
+    chatAbortControllers: controllers,
+    runId: execution.params.runId,
+    sessionKey: "agent:main:requester-synthesis",
+    sessionId: "requester-synthesis",
+    operationalRunInstance: instance,
+    kind: "agent",
+    timeoutMs: 60_000,
+  });
+  const entry = expectDefined(registration.entry, "requester synthesis registration");
+  execution.params.prepared.activeRunAbort = registration;
+  execution.params.prepared.operationalRunInstance = instance;
+  execution.params.lifecycleGeneration = expectDefined(entry.lifecycleGeneration, "run generation");
+  execution.params.context.chatAbortControllers = controllers;
+  execution.params.prepared.activeGatewayWorkAdmission.isActive = () => true;
+  return { execution, controllers, instance, registration, entry };
+}
+
+describe("Gateway execution-start admission", () => {
+  beforeEach(() => {
+    dispatchAgentRunFromGateway.mockReset();
+    agentCommand.mockReset();
+  });
+
+  it.each(["runner-first", "admission-first"] as const)(
+    "attaches requester synthesis to its canonical producer after %s admission",
+    async (order) => {
+      const { execution, instance, entry } = createStartExecution();
+      const observations: string[] = [];
+      const saved = vi.fn();
+      const started = vi.fn(() => {
+        observations.push("started");
+        const producer = entry.resolveTerminalProducer?.();
+        if (
+          !producer ||
+          producer.sessionId !== entry.sessionId ||
+          producer.sessionKey !== entry.sessionKey ||
+          !producer.handoff(async (completed) => {
+            await completed;
+            saved();
+          })
+        ) {
+          throw new Error("Requester synthesis lost its canonical final producer");
+        }
+      });
+      execution.params.io.emitExecutionStarted = started;
+      agentCommand.mockImplementationOnce(async (opts: AgentCommandOpts) => {
+        const admission = prepareAgentRunAdmission({
+          cfg: {},
+          operationalRunInstance: instance,
+          facts: {
+            runId: execution.params.runId,
+            agentId: "main",
+            ingress: { kind: "system", boundary: "requester-synthesis-test", state: "present" },
+          },
+          onAdmitted: opts.onAdmittedRunContext,
+        });
+        try {
+          if (order === "runner-first") {
+            // The real embedded orchestrator awaits this before runtime selection admits.
+            await opts.onExecutionStarted?.();
+            observations.push("runner-entered");
+            expect(started).not.toHaveBeenCalled();
+            // Cached acceptance uses this same owner flag to notify duplicate observers.
+            expect(entry.executionStarted).toBe(false);
+          }

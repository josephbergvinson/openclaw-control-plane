+        let task = Task {
+            try await NativeCredentialIPC.withSecret(
+                binding: binding,
+                parent: "owner",
+                environment: .init(
+                    parentIdentity: { "owner" },
+                    direct: { _ in throw NativeCredentialError.unavailable },
+                    preflight: { _ in try self.admission(binding) },
+                    read: { _ in await withCheckedContinuation { entered.continuation.yield($0) } }),
+                consume: { _ in Issue.record("cancelled value consumed") })
+        }
+        var iterator = entered.stream.makeAsyncIterator()
+        let release = try #require(await iterator.next())
+        task.cancel()
+        release.resume(returning: Data("synthetic".utf8))
+        await #expect(throws: CancellationError.self) { try await task.value }
+        entered.continuation.finish()
+    }
+}

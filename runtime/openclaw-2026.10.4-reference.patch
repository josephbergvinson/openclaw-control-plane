+            sessionId: "original-child",
+            lifecycleRevision: "original-child-v1",
+            runId: "queued-original-run",
+          },
+        );
+        if (mode === "replaced target") {
+          params.expectedExistingSessionId = "replacement-child";
+        }
+        let sourceCurrent = true;
+        const createFacade = vi.fn(context.createAgentTurnFacade!);
+        context.createAgentTurnFacade = createFacade;
+        startTurn.mockImplementation(async ({ io }) =>
+          io.emitAcceptance([true, { status: "accepted", runId: "queued-original-run" }]),
+        );
+        const options = withInProcessMcpRequesterScope(
+          {
+            forceSyntheticClient: true,
+            agentRunTracking: "native_subagent" as const,
+            prepareDispatchCurrent: async () => {
+              if (mode === "revoked source") {
+                sourceCurrent = false;
+              }
+            },
+          },
+          {
+            mcpRequesterScope: scope,
+            mcpRequesterScopeAssertCurrent: () => {
+              if (!sourceCurrent) {
+                throw new Error("queued original source retired");
+              }
+            },
+          },
+        );
+        const pending = withPluginRuntimeGatewayRequestScope(
+          { context, client, isWebchatConnect: () => false },
+          () => dispatchGatewayMethodInProcess("agent", params, options),
+        );
+        if (mode === "current") {
+          await expect(pending).resolves.toEqual({
+            status: "accepted",
+            runId: "queued-original-run",
+          });

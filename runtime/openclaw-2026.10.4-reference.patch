index 0000000000000000000000000000000000000000..a552b7453a1805a87e99a3b6f42a20c0a197bbbc
--- /dev/null
+++ b/apps/macos/Sources/OpenClawMacCLI/NativeCredentialIPC.swift
@@ -0,0 +1,143 @@
+import Darwin
+import Foundation
+import OpenClawKit
+import OSLog
+import Security
+
+/// A private pipe to the signed app, not an operator credential-export command.
+enum NativeCredentialIPC {
+    enum Diagnostic: String, Sendable {
+        case entryAdmission = "entry_admission"
+        case requestBinding = "request_binding"
+        case parentAdmission = "parent_admission"
+        case directRead = "direct_read"
+        case fallbackAdmission = "fallback_admission"
+        case parentBeforeFallback = "parent_before_fallback"
+        case fallbackRead = "fallback_read"
+        case parentAfterFallback = "parent_after_fallback"
+        case fallbackRevalidation = "fallback_revalidation"
+        case parentBeforeConsume = "parent_before_consume"
+        case delivering
+        case finished
+        case refused
+        case unavailable
+        case cancelled
+        case failed
+    }
+
+    private static let logger = Logger(subsystem: "ai.openclaw.mac", category: "native-credential")
+
+    private static func record(_ diagnostic: Diagnostic) {
+        // Only fixed stages leave this helper; stdout remains the private pipe.
+        self.logger.info("native credential helper: \(diagnostic.rawValue, privacy: .public)")
+    }
+
+    @MainActor
+    struct Environment {
+        var parentIdentity: () -> String?
+        var direct: (NativeCredentialBinding) throws -> Data
+        var preflight: (NativeCredentialBinding) throws -> NativeCredentialSecurityTool.Admission
+        var read: (NativeCredentialSecurityTool.Admission) async throws -> Data
+
+        static let live = Environment(
+            parentIdentity: { LocalGatewayAuthIPC.directAppParentIdentity() },
+            direct: { binding in
+                var value = Data()
+                try NativeCredentialKeychain.withSecret(binding: binding) { value = Data($0.utf8) }
+                return value
+            },
+            preflight: { try NativeCredentialSecurityTool.preflight($0) },
+            read: NativeCredentialSecurityTool.read)
+    }
+
+    static func binding(request: Data, hostID: String) throws -> NativeCredentialBinding {
+        guard request.count <= 4096,
+              let binding = try? JSONDecoder().decode(NativeCredentialBinding.self, from: request)
+        else { throw NativeCredentialError.invalidBinding }
+        try binding.validate()
+        guard binding.hostID.caseInsensitiveCompare(hostID) == .orderedSame else {
+            throw NativeCredentialError.refused
+        }
+        return binding
+    }
+
+    private static func isPipe(_ descriptor: Int32) -> Bool {
+        var info = stat()
+        return fstat(descriptor, &info) == 0 && info.st_mode & S_IFMT == S_IFIFO
+    }
+
+    @MainActor
+    static func withSecret(
+        binding: NativeCredentialBinding,
+        parent: String,
+        environment: Environment = .live,
+        record: (Diagnostic) -> Void = Self.record,
+        consume: (Data) throws -> Void) async throws
+    {
+        record(.parentAdmission)
+        guard environment.parentIdentity() == parent else { throw NativeCredentialError.refused }
+        var value: Data
+        do {
+            record(.directRead)
+            value = try environment.direct(binding)
+        } catch NativeCredentialError.unavailable {
+            record(.fallbackAdmission)
+            let admission = try environment.preflight(binding)
+            record(.parentBeforeFallback)
+            guard environment.parentIdentity() == parent else { throw NativeCredentialError.refused }
+            record(.fallbackRead)
+            value = try await environment.read(admission)
+            do {
+                try Task.checkCancellation()
+                record(.parentAfterFallback)
+                guard environment.parentIdentity() == parent else { throw NativeCredentialError.refused }
+                record(.fallbackRevalidation)
+                guard try environment.preflight(binding) == admission else { throw NativeCredentialError.refused }
+            } catch {
+                value.resetBytes(in: value.startIndex..<value.endIndex)
+                throw error
+            }
+        }
+        defer { value.resetBytes(in: value.startIndex..<value.endIndex) }
+        try Task.checkCancellation()
+        record(.parentBeforeConsume)
+        guard environment.parentIdentity() == parent else { throw NativeCredentialError.refused }
+        record(.delivering)
+        try consume(value)
+    }
+
+    @MainActor
+    static func run() async {
+        do {
+            self.record(.entryAdmission)
+            guard self.isPipe(STDIN_FILENO), self.isPipe(STDOUT_FILENO),
+                  let parent = LocalGatewayAuthIPC.directAppParentIdentity(),
+                  getpgrp() == getpid(), getsid(0) == getpid(),
+                  SecKeychainSetUserInteractionAllowed(false) == errSecSuccess
+            else { throw NativeCredentialError.refused }
+            // The legacy policy is process-wide. This short-lived child has no
+            // concurrent app Keychain operations and never enables UI again.
+            var input = Data()
+            while let chunk = try FileHandle.standardInput.read(upToCount: 4096), !chunk.isEmpty {
+                input.append(chunk)
+                guard input.count <= 4096 else { throw NativeCredentialError.invalidBinding }
+            }
+            self.record(.requestBinding)
+            let binding = try self.binding(request: input, hostID: NativeCredentialHost.identity())
+            try await self.withSecret(binding: binding, parent: parent) { output in
+                try FileHandle.standardOutput.write(contentsOf: output)
+            }
+            self.record(.finished)
+        } catch {
+            // Framework errors and process output must never become model data.
+            if error is CancellationError {
+                self.record(.cancelled)
+            } else if let credentialError = error as? NativeCredentialError {
+                self.record(credentialError == .unavailable ? .unavailable : .refused)
+            } else {
+                self.record(.failed)
+            }
+            exit(1)
+        }
+    }
+}

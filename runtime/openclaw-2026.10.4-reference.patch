@@ -0,0 +1,147 @@
+import type { DatabaseSync } from "node:sqlite";
+import { expect, it } from "vitest";
+import { runOpenClawStateWriteTransaction } from "../state/openclaw-state-db.js";
+import { withOpenClawTestState } from "../test-utils/openclaw-test-state.js";
+import { projectCronRunHistoryPage } from "./run-history.js";
+import { cronStoreKey } from "./store/key.js";
+import { readCronRunRecords } from "./store/read-only.js";
+import { recordCronRunInDatabase } from "./store/run-history.kernel.js";
+import type { CronRunHistoryWrite } from "./store/run-history.types.js";
+import { ensureCronRunReceiptSchema } from "./store/run-receipt-store.js";
+
+function uuid(index: number) {
+  return `00000000-0000-4000-8000-${index.toString(16).padStart(12, "0")}`;
+}
+
+function record(
+  storeKey: string,
+  discriminator: string,
+  overrides: Partial<CronRunHistoryWrite> = {},
+) {
+  return {
+    storeKey,
+    jobId: "job",
+    runId: `cron:job:10:${discriminator}`,
+    startedAt: 10,
+    endedAt: 20,
+    status: "succeeded",
+    detail: {
+      kind: "cron-run",
+      storeKey,
+      runAtMs: 10,
+      runId: discriminator,
+      status: "ok",
+      configRevision: "forged-stored-detail",
+    },
+    ...overrides,
+  } satisfies CronRunHistoryWrite;
+}
+
+function receipt(db: DatabaseSync, storeKey: string, id: string, revision: string, startedAt = 10) {
+  db.prepare(
+    `INSERT INTO cron_run_receipts
+     (receipt_id, store_key, job_id, config_revision, agent_id, status, owner_pid,
+      started_at_ms, finished_at_ms)
+     VALUES (?, ?, 'job', ?, 'main', 'ok', 1, ?, 20)`,
+  ).run(id, storeKey, revision, startedAt);
+}
+
+it("enriches exact historical receipts in the real read worker without changing paging or totals", async () => {
+  await withOpenClawTestState(
+    { layout: "state-only", prefix: "cron-history-revision-" },
+    async (state) => {
+      const storeKey = cronStoreKey(state.statePath("cron/jobs.json"));
+      runOpenClawStateWriteTransaction(({ db }) => {
+        ensureCronRunReceiptSchema(db);
+        for (let index = 1; index <= 201; index++) {
+          recordCronRunInDatabase(db, record(storeKey, uuid(index)));
+          receipt(db, storeKey, uuid(index), `source-revision-${index}`);
+        }
+        recordCronRunInDatabase(db, record(storeKey + "-other", uuid(202)));
+        receipt(db, storeKey + "-other", uuid(202), "other-store-revision");
+      });
+
+      const records = await readCronRunRecords(storeKey, "job");
+      const page = projectCronRunHistoryPage(records, { storeKey, jobId: "job", limit: 200 });
+      expect(page).toMatchObject({ total: 201, limit: 200, hasMore: true, nextOffset: 200 });
+      expect(page.entries).toHaveLength(200);
+      for (const entry of page.entries) {
+        const index = Number.parseInt(entry.runId!.slice(-12), 16);
+        expect(entry.configRevision).toBe(`source-revision-${index}`);
+      }
+      expect(
+        projectCronRunHistoryPage(records, { storeKey, offset: 200, limit: 200 }),
+      ).toMatchObject({
+        total: 201,
+        hasMore: false,
+        nextOffset: null,
+        entries: [
+          expect.objectContaining({ configRevision: expect.stringContaining("source-revision-") }),
+        ],
+      });
+      const other = projectCronRunHistoryPage(await readCronRunRecords(storeKey + "-other"), {
+        storeKey: storeKey + "-other",
+      });
+      expect(other.entries).toEqual([
+        expect.objectContaining({ configRevision: "other-store-revision" }),
+      ]);
+    },
+  );
+});
+
+it("leaves ambiguous, missing, legacy and forged evidence unknown without current-definition inference", async () => {
+  await withOpenClawTestState(
+    { layout: "state-only", prefix: "cron-history-unknown-" },
+    async (state) => {
+      const storeKey = cronStoreKey(state.statePath("cron/jobs.json"));
+      runOpenClawStateWriteTransaction(({ db }) => {
+        ensureCronRunReceiptSchema(db);
+        receipt(db, storeKey, uuid(1), "first-source");
+        receipt(db, storeKey, uuid(2), "second-source");
+        receipt(db, storeKey + "-other", uuid(3), "other-store-source");
+        recordCronRunInDatabase(db, record(storeKey, uuid(1)));
+        recordCronRunInDatabase(db, record(storeKey, uuid(2) + ":manual:public-id"));
+        recordCronRunInDatabase(db, record(storeKey, "ambiguous", { runId: "cron:job:10" }));
+        recordCronRunInDatabase(db, record(storeKey, uuid(999)));
+        recordCronRunInDatabase(db, record(storeKey, "legacy-random"));
+        recordCronRunInDatabase(db, record(storeKey, uuid(3)));
+        // A detail runAtMs/receipt discriminator cannot replace the physical row's start identity.
+        recordCronRunInDatabase(db, record(storeKey, uuid(4), { startedAt: 11 }));
+        receipt(db, storeKey, uuid(4), "wrong-physical-start");
+      });
+      const page = projectCronRunHistoryPage(await readCronRunRecords(storeKey), { storeKey });
+      expect(page.total).toBe(7);
+      expect(page.entries.find((entry) => entry.runId === uuid(1))?.configRevision).toBe(
+        "first-source",
+      );
+      expect(
+        page.entries.find((entry) => entry.runId === uuid(2) + ":manual:public-id")?.configRevision,
+      ).toBe("second-source");
+      expect(page.entries.filter((entry) => entry.configRevision !== undefined)).toHaveLength(2);
+      expect(page.entries.some((entry) => entry.configRevision === "forged-stored-detail")).toBe(
+        false,
+      );
+    },
+  );
+});
+
+it("does not create missing receipt storage during a legacy history read", async () => {
+  await withOpenClawTestState(
+    { layout: "state-only", prefix: "cron-history-no-receipts-" },
+    async (state) => {
+      const storeKey = cronStoreKey(state.statePath("cron/jobs.json"));
+      runOpenClawStateWriteTransaction(({ db }) => {
+        recordCronRunInDatabase(db, record(storeKey, uuid(1)));
+        db.exec("DROP TABLE IF EXISTS cron_run_receipts");
+      });
+      const page = projectCronRunHistoryPage(await readCronRunRecords(storeKey), { storeKey });
+      expect(page.entries).toEqual([expect.objectContaining({ runId: uuid(1) })]);
+      expect(page.entries[0]?.configRevision).toBeUndefined();
+      runOpenClawStateWriteTransaction(({ db }) => {
+        expect(
+          db.prepare("SELECT name FROM sqlite_schema WHERE name='cron_run_receipts'").all(),
+        ).toEqual([]);
+      });
+    },
+  );
+});

@@ -0,0 +1,164 @@
+import { spawnSync } from "node:child_process";
+import { existsSync, mkdirSync, readFileSync, writeFileSync } from "node:fs";
+import path from "node:path";
+import { afterEach, describe, expect, it } from "vitest";
+import { parse } from "yaml";
+import { useAutoCleanupTempDirTracker } from "../helpers/temp-dir.js";
+
+type Step = {
+  name?: string;
+  if?: string;
+  run?: string;
+  uses?: string;
+  with?: Record<string, unknown>;
+};
+const action = parse(readFileSync(".github/actions/setup-node-env/action.yml", "utf8"));
+const steps = action.runs.steps as Step[];
+const workflow = parse(readFileSync(".github/workflows/ci.yml", "utf8"));
+const temps = useAutoCleanupTempDirTracker(afterEach);
+const matchingRunner =
+  "runner.os == 'macOS' && runner.arch == 'ARM64' && env.OPENCLAW_NATIVE_RESOURCE_REF != ''";
+const pin = "a".repeat(40);
+
+function step(name: string) {
+  const selected = steps.find((candidate) => candidate.name === name);
+  if (!selected) {
+    throw new Error("Missing setup step: " + name);
+  }
+  return selected;
+}
+
+describe("existing setup owner native resource hydration", () => {
+  it("hydrates the matching platform before generic installation and before the explicit Mac asset install", () => {
+    const validate = step("Validate native resource pin");
+    const checkout = step("Checkout native resource owner");
+    const hydrate = step("Hydrate native runtime dependency");
+    for (const selected of [validate, checkout, hydrate]) {
+      expect(selected.if).toBe(matchingRunner);
+    }
+    expect(steps.indexOf(validate)).toBeLessThan(steps.indexOf(checkout));
+    expect(steps.indexOf(checkout)).toBeLessThan(steps.indexOf(hydrate));
+    expect(steps.indexOf(hydrate)).toBeLessThan(
+      steps.indexOf(step("Resolve dependency cache key")),
+    );
+    expect(steps.indexOf(hydrate)).toBeLessThan(steps.indexOf(step("Install dependencies")));
+    expect(checkout.with).toMatchObject({
+      repository: "josephbergvinson/openclaw-control-plane",
+      path: ".ci-harness/native-resource",
+      "persist-credentials": false,
+      "sparse-checkout-cone-mode": false,
+    });
+    expect(checkout.with?.ref).toBe("${{ env.OPENCLAW_NATIVE_RESOURCE_REF }}");
+    const macSteps = workflow.jobs["macos-swift"].steps as Step[];
+    const setupIndex = macSteps.findIndex(
+      (candidate) => candidate.name === "Setup Node environment for Apple assets",
+    );
+    const installIndex = macSteps.findIndex(
+      (candidate) => candidate.name === "Install native asset dependencies",
+    );
+    expect(setupIndex).toBeGreaterThanOrEqual(0);
+    expect(installIndex).toBeGreaterThan(setupIndex);
+    expect(macSteps[setupIndex]?.with?.["install-deps"]).toBe("false");
+    // CI requires the reviewed immutable resource commit.
+    expect(workflow.env.OPENCLAW_NATIVE_RESOURCE_REF).toMatch(/^[0-9a-f]{40}$/u);
+  });
+
+  it
+    .skipIf(process.platform === "win32")
+    .each([
+      "main",
+      "a".repeat(39),
+      "A".repeat(40),
+      pin + "\n",
+      "ROOT_FILL_EXACT_RESOURCE_P2_COMMIT",
+    ])("refuses the unbound resource ref %j before checkout", (ref) => {
+    const result = spawnSync("/bin/bash", ["-c", step("Validate native resource pin").run!], {
+      env: { ...process.env, NATIVE_RESOURCE_REF: ref },
+      encoding: "utf8",
+      timeout: 5_000,
+    });
+    expect(result.error).toBeUndefined();
+    expect(result.status).toBe(1);
+    expect(result.stderr).toContain("requires a reviewed full commit SHA");
+  });
+
+  it.skipIf(process.platform === "win32").each([
+    { matches: true, gitExitCode: 0 },
+    { matches: false, gitExitCode: 0 },
+    { matches: true, gitExitCode: 7 },
+  ])(
+    "invokes the sole provision owner only after matching its actual checkout: $matches (Git exit $gitExitCode)",
+    ({ matches, gitExitCode }) => {
+      const root = temps.make("native-resource-bootstrap-");
+      const bin = path.join(root, "bin");
+      const workspace = path.join(root, "workspace");
+      const log = path.join(root, "python-args.json");
+      const gitLog = path.join(root, "git-args.json");
+      const actualHead = matches ? pin : "b".repeat(40);
+      const shouldProvision = matches && gitExitCode === 0;
+      mkdirSync(bin);
+      mkdirSync(workspace);
+      writeFileSync(
+        path.join(bin, "git"),
+        "#!" +
+          process.execPath +
+          '\nrequire("node:fs").writeFileSync(process.env.FIXTURE_RESOURCE_GIT_LOG, JSON.stringify({\n' +
+          "  args: process.argv.slice(2), head: process.env.FIXTURE_RESOURCE_HEAD,\n" +
+          "  expectedPin: process.env.NATIVE_RESOURCE_REF, exitCode: Number(process.env.FIXTURE_RESOURCE_GIT_EXIT_CODE),\n" +
+          '}));\nprocess.stdout.write(process.env.FIXTURE_RESOURCE_HEAD + "\\n");\n' +
+          "process.exitCode = Number(process.env.FIXTURE_RESOURCE_GIT_EXIT_CODE);\n",
+        { mode: 0o755 },
+      );
+      writeFileSync(
+        path.join(bin, "python3"),
+        "#!" +
+          process.execPath +
+          '\nrequire("node:fs").writeFileSync(process.env.FIXTURE_RESOURCE_LOG, JSON.stringify(process.argv.slice(2)));\n',
+        { mode: 0o755 },
+      );
+      const result = spawnSync(
+        "/bin/bash",
+        ["-c", step("Hydrate native runtime dependency").run!],
+        {
+          env: {
+            ...process.env,
+            PATH: bin + ":/usr/bin:/bin",
+            GITHUB_WORKSPACE: workspace,
+            NATIVE_RESOURCE_REF: pin,
+            FIXTURE_RESOURCE_HEAD: actualHead,
+            FIXTURE_RESOURCE_GIT_EXIT_CODE: String(gitExitCode),
+            FIXTURE_RESOURCE_GIT_LOG: gitLog,
+            FIXTURE_RESOURCE_LOG: log,
+          },
+          encoding: "utf8",
+          timeout: 5_000,
+        },
+      );
+      const resource = path.join(workspace, ".ci-harness/native-resource");
+      expect(result.error).toBeUndefined();
+      expect(result.signal).toBeNull();
+      expect(JSON.parse(readFileSync(gitLog, "utf8"))).toEqual({
+        args: ["-C", resource, "rev-parse", "HEAD"],
+        head: actualHead,
+        expectedPin: pin,
+        exitCode: gitExitCode,
+      });
+      expect(existsSync(log)).toBe(shouldProvision);
+      expect(result.status, result.stderr).toBe(shouldProvision ? 0 : 1);
+      if (gitExitCode !== 0) {
+        expect(result.stderr).toContain("Unable to read native resource checkout identity");
+      } else if (!matches) {
+        expect(result.stderr).toContain("does not match the reviewed commit");
+      }
+      if (shouldProvision) {
+        expect(JSON.parse(readFileSync(log, "utf8"))).toEqual([
+          "-B",
+          path.join(resource, "scripts/reconstruct_runtime.py"),
+          workspace,
+          "--native-artifact-provenance",
+          path.join(resource, "runtime/native160/native160-provenance.json"),
+        ]);
+      }
+    },
+  );

+        signal: controller.signal,
+        assertCurrent: () => controller.signal.throwIfAborted(),
+        release: () => {},
+        run: (run) => run(),
+      },
+    });
+    owners.push(owner);
+    owner.markAccepted("original-run");
+    const children: ReturnType<typeof cohort>[] = [];
+    const wakings: Promise<boolean>[] = [];
+    try {
+      for (const generation of [1, 2]) {
+        const child = cohort(generation);
+        children.push(child);
+        registryRuntimeMock.listSubagentRunsForRequester.mockReturnValue([...children]);
+        owner.promoteYield("original-run", [child], generation);
+        await owner.settle("original-run", { status: "ok", yielded: true });
+        owner.finishExecution("original-run");
+        const waking = maybeWakeRequesterAfterAllChildrenSettled(
+          wakeParams({ requesterSessionKey: key, settledEntry: child }),
+        );

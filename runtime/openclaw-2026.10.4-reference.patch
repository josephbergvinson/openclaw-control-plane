diff --git a/src/agents/embedded-agent-runner/run.compaction-delivery.integration.test.ts b/src/agents/embedded-agent-runner/run.compaction-delivery.integration.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d1ff40226426a13accdb8b9f4efd18d0eca3bbb3
--- /dev/null
+++ b/src/agents/embedded-agent-runner/run.compaction-delivery.integration.test.ts
@@ -0,0 +1,284 @@
+import { afterAll, afterEach, beforeAll, beforeEach, describe, expect, it } from "vitest";
+import { createReplyOperation } from "../../auto-reply/reply/reply-run-registry.js";
+import { buildWaitingStatusPayload } from "../../auto-reply/reply/waiting-status.js";
+import { MAX_MESSAGING_HISTORY_ENTRIES } from "../embedded-agent-messaging-history.js";
+import { captureAgentPluginRuntimeRefresh } from "../plugin-runtime-refresh.js";
+import { resolveReplyCompletion } from "../reply-completion.js";
+import { buildEmbeddedRunnerAssistant } from "../test-helpers/embedded-agent-runner-e2e-fixtures.js";
+import {
+  hasVisibleCommittedMessagingToolDeliveryEvidence,
+  resolveSourceReplyDelivery,
+} from "./delivery-evidence.js";
+import { makeCompactionSuccess, makeOverflowError } from "./run.overflow-compaction.fixture.js";
+import {
+  mockedCompactDirect,
+  mockedRunEmbeddedAttempt,
+  resetSharedRunIntegrationHarnessMocks,
+} from "./run.overflow-compaction.harness.js";
+import {
+  cleanupSharedRunIntegrationSessions,
+  createSharedRunIntegrationSession,
+  loadSharedRunIntegrationHarness,
+} from "./run.shared-integration-harness.test-support.js";
+import { createAttemptCarryover } from "./run/attempt-result.js";
+import { shouldContinueInteractiveAcceptedSessionSpawns } from "./run/attempt-terminal-evidence.js";
+import type { EmbeddedRunAttemptResult } from "./run/types.js";
+
+let runEmbeddedAgent: Awaited<ReturnType<typeof loadSharedRunIntegrationHarness>>;
+let session: Awaited<ReturnType<typeof createSharedRunIntegrationSession>>;
+let operation: ReturnType<typeof createReplyOperation>;
+let childRunIds: string[];
+
+function progress(text: string): Partial<EmbeddedRunAttemptResult> {
+  const assistant = buildEmbeddedRunnerAssistant({
+    stopReason: "toolUse",
+    content: [
+      { type: "toolCall", id: "progress-send", name: "message", arguments: { final: false } },
+    ],
+  });
+  return {
+    assistantTexts: [],
+    didSendViaMessagingTool: true,
+    sourceReplyDelivered: true,
+    didDeliverSourceReplyViaMessageTool: true,
+    sourceReplyDeliveryState: "missing",
+    messagingToolSentTexts: [text],
+    messagingToolSentTargets: [
+      { tool: "message", provider: "discord", to: "channel:source", text, sourceReplyFinal: false },
+    ],
+    messagingToolSourceReplyPayloads: [{ text, sourceReplyFinal: false }],
+    toolMetas: [{ toolName: "message", toolCallId: "progress-send", isError: false }],
+    itemLifecycle: { startedCount: 1, completedCount: 1, activeCount: 0 },
+    messagesSnapshot: [
+      assistant,
+      {
+        role: "toolResult",
+        toolCallId: "progress-send",
+        toolName: "message",
+        isError: false,
+        timestamp: 1,
+        content: [{ type: "text", text: "Progress delivered." }],
+      },
+    ],
+  };
+}
+
+async function yieldedChild(parentRunId: string): Promise<Partial<EmbeddedRunAttemptResult>> {
+  const { createSubagentRunRecord } = await import("../subagent-test-fixtures.test-helpers.js");
+  const { addSubagentRunForTests } =
+    await import("../subagents/registry/subagent-registry.test-helpers.js");
+  const child = createSubagentRunRecord({
+    runId: `${parentRunId}-child`,
+    childSessionKey: `agent:main:subagent:${parentRunId}-child`,
+    requesterSessionKey: session.runParams.sessionKey,
+    requesterAgentId: "main",
+    requesterTurnRunId: parentRunId,
+    expectsCompletionMessage: true,
+    completion: { required: true },
+    delivery: { status: "pending" },
+  });
+  await addSubagentRunForTests(child);
+  childRunIds.push(child.runId);
+  return {
+    assistantTexts: [],
+    terminal: { kind: "aborted", source: "yield_cleanup" },
+    yieldDetected: true,
+    acceptedSessionSpawns: [
+      {
+        runId: child.runId,
+        childSessionKey: child.childSessionKey,
+        expectsCompletionMessage: true,
+      },
+    ],
+  };
+}
+
+beforeAll(async () => {
+  runEmbeddedAgent = await loadSharedRunIntegrationHarness();
+});
+
+beforeEach(async () => {
+  resetSharedRunIntegrationHarnessMocks();
+  childRunIds = [];
+  session = await createSharedRunIntegrationSession();
+  operation = createReplyOperation({
+    sessionId: session.runParams.sessionId,
+    sessionKey: session.runParams.sessionKey,
+    resetTriggered: false,
+    turnKind: "visible",
+  });
+});
+
+afterEach(async () => {
+  try {
+    const { mutateSubagentRuns } =
+      await import("../subagents/registry/subagent-registry-persistence.js");
+    await mutateSubagentRuns(childRunIds, () => ({
+      value: undefined,
+      postimages: new Map(childRunIds.map((id) => [id, null])),
+    }));
+  } finally {
+    operation?.complete();
+    await session?.cleanup();
+  }
+});
+
+afterAll(cleanupSharedRunIntegrationSessions);
+
+describe("committed progress across compaction recovery", () => {
+  it.each([false, true])(
+    "keeps one progress card and an owed child final across two attempts (plugin refresh: %s)",
+    async (refreshFirst) => {
+      const firstText = "I am checking the requested source.";
+      const secondText = "The source check is underway.";
+      if (refreshFirst) {
+        mockedRunEmbeddedAttempt.mockImplementationOnce(async (params) => {
+          params.registerPluginRuntimeRefreshConsumer?.(() => true);
+          expect(captureAgentPluginRuntimeRefresh().request()).toBe(true);
+          return session.makeAttemptResult(progress(firstText));
+        });
+      }
+      mockedRunEmbeddedAttempt.mockResolvedValueOnce(
+        session.makeAttemptResult({
+          ...progress(refreshFirst ? secondText : firstText),
+          terminal: { kind: "failed", source: "prompt", error: makeOverflowError() },
+        }),
+      );
+      mockedCompactDirect.mockResolvedValueOnce(
+        makeCompactionSuccess({
+          summary: "The source check is still in progress.",
+          tokensBefore: 150000,
+        }),
+      );
+      mockedRunEmbeddedAttempt.mockResolvedValueOnce(
+        session.makeAttemptResult(await yieldedChild(session.runParams.runId)),
+      );
+
+      const result = await runEmbeddedAgent({ ...session.runParams, replyOperation: operation });
+
+      expect(mockedCompactDirect).toHaveBeenCalledOnce();
+      expect(mockedRunEmbeddedAttempt).toHaveBeenCalledTimes(refreshFirst ? 3 : 2);
+      expect(result.messagingToolSentTexts).toEqual(
+        refreshFirst ? [firstText, secondText] : [firstText],
+      );
+      expect(result.messagingToolSentTargets).toHaveLength(refreshFirst ? 2 : 1);
+      expect(result.messagingToolSourceReplyPayloads).toHaveLength(refreshFirst ? 2 : 1);
+      expect(result.acceptedSessionSpawns).toHaveLength(1);
+      expect(result.meta.error).toBeUndefined();
+      expect(result.meta.continuationPending).toBe(true);
+      expect(result.sourceReplyDelivered).toBe(true);
+      expect(result.didDeliverSourceReplyViaMessageTool).toBe(true);
+      expect(resolveSourceReplyDelivery(result)).toBe("missing");
+      expect(
+        buildWaitingStatusPayload({
+          completion: resolveReplyCompletion("required", "pending"),
+          continuationPending: result.meta.continuationPending,
+          yielded: result.meta.yielded,
+          hasVisibleMessageDelivery: hasVisibleCommittedMessagingToolDeliveryEvidence(result),
+        }),
+      ).toBeUndefined();
+
+      // A different logical run cannot borrow the old card or suppress its own waiting status.
+      const freshRunId = `${session.runParams.runId}-fresh`;
+      mockedRunEmbeddedAttempt.mockResolvedValueOnce(
+        session.makeAttemptResult(await yieldedChild(freshRunId)),
+      );
+      const fresh = await runEmbeddedAgent({
+        ...session.runParams,
+        runId: freshRunId,
+        replyOperation: operation,
+      });
+      expect(fresh.messagingToolSentTexts).toEqual([]);
+      expect(fresh.messagingToolSentTargets).toEqual([]);
+      expect(fresh.meta.continuationPending).toBe(true);
+      expect(
+        buildWaitingStatusPayload({
+          completion: resolveReplyCompletion("required", "pending"),
+          continuationPending: fresh.meta.continuationPending,
+          yielded: fresh.meta.yielded,
+          hasVisibleMessageDelivery: hasVisibleCommittedMessagingToolDeliveryEvidence(fresh),
+        }),
+      ).toBeDefined();
+    },
+  );
+
+  it.each([
+    {
+      label: "unaccounted text",
+      fields: { messagingToolSentTexts: ["Checking.", "Another send."] },
+    },
+    {
+      label: "unmarked wrong target",
+      fields: {
+        messagingToolSentTargets: [
+          { tool: "message", provider: "discord", to: "channel:other", text: "Checking." },
+        ],
+      },
+    },
+    { label: "aggregate-only send", fields: { messagingToolSentTargets: [] } },
+    {
+      label: "unmarked source payload",
+      fields: { messagingToolSourceReplyPayloads: [{ text: "Checking." }] },
+    },
+    {
+      label: "completed source payload",
+      fields: { messagingToolSourceReplyPayloads: [{ text: "Done.", sourceReplyFinal: true }] },
+    },
+    { label: "delivered source", fields: { sourceReplyDeliveryState: "delivered" } },
+    {
+      label: "unaccounted terminal message delivery",
+      fields: {
+        didDeliverSourceReplyViaMessageTool: true,
+        messagingToolSentTexts: [],
+        messagingToolSentTargets: [],
+        messagingToolSourceReplyPayloads: [],
+      },
+    },
+    {
+      label: "unrelated async work",
+      fields: { toolMetas: [{ toolName: "exec", asyncStarted: true }] },
+    },
+    {
+      label: "external cancellation",
+      fields: { terminal: { kind: "aborted", source: "external" } },
+    },
+  ] satisfies { label: string; fields: Partial<EmbeddedRunAttemptResult> }[])(
+    "does not erase $label when accounting for progress",
+    ({ fields }) => {
+      const attempt = session.makeAttemptResult({
+        ...progress("Checking."),
+        terminal: { kind: "aborted", source: "yield_cleanup" },
+        yieldDetected: true,
+        acceptedSessionSpawns: [
+          {
+            runId: "child",
+            childSessionKey: "agent:main:subagent:child",
+            expectsCompletionMessage: true,
+          },
+        ],
+        ...fields,
+      });
+      expect(
+        shouldContinueInteractiveAcceptedSessionSpawns({
+          attempt,
+          run: { replyOperation: operation },
+        }),
+      ).toBe(false);
+    },
+  );
+
+  it("retains a completed final when later progress fills the bounded delivery history", () => {
+    const carryover = createAttemptCarryover();
+    carryover.apply(session.makeAttemptResult({ sourceReplyDeliveryState: "delivered" }));
+    let latest = session.makeAttemptResult();
+    for (let i = 0; i <= MAX_MESSAGING_HISTORY_ENTRIES; i += 1) {
+      latest = session.makeAttemptResult(progress(`Progress ${i}.`));
+      carryover.apply(latest);
+    }
+    expect(latest.messagingToolSentTargets).toHaveLength(MAX_MESSAGING_HISTORY_ENTRIES);
+    expect(
+      latest.messagingToolSentTargets.every((target) => target.sourceReplyFinal === false),
+    ).toBe(true);
+    expect(resolveSourceReplyDelivery(latest)).toBe("delivered");
+  });
+});

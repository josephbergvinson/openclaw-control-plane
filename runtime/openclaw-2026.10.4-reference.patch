+
+    @Test(arguments: ["host", "principal", "native-account", "provider-only", "enrollment", "owner", "purpose"])
+    func `local passkey authority stays on the enrolled host principal recipient and purpose`(_ change: String) throws {
+        let form = try #require(NativeCredentialPromptContext.resolve(
+            Self.form(account: change == "native-account" ? "fixture@example.com" : "fixture"),
+            bundleID: Self.helper))
+        let binding = try Self.binding(owners: change == "enrollment" ? Self.existingOwners : nil)
+        let evidence = change == "provider-only" ? ["Sign in with “fixture”.", "Unlock", "Cancel"] : form.evidence
+        #expect(!binding.authorizes(
+            hostID: change == "host" ? "22222222-2222-4222-8222-222222222222" : Self.host,
+            bundleID: change == "owner" ? "com.apple.SecurityAgent" : Self.helper,
+            accountEvidence: evidence,
+            purpose: change == "purpose" ? .accountAuthentication : nil,
+            localAccount: change == "principal" ? "other" : "fixture"))
+    }
+
+    @Test func `helper enrollment preserves all prior explicitly bound owners`() throws {
+        var args = ["--alias", "mac.fixture.password", "--kind", "macLogin", "--account", "fixture"]
+        for owner in Self.existingOwners + [Self.helper] {
+            args += ["--bundle", owner]
+        }
+        let binding = try parseNativeCredentialBinding(args, hostID: Self.host)
+        #expect(binding.bundleIDs == Self.existingOwners + [Self.helper])
+        #expect(binding.account == "fixture")
+        #expect(binding.hostID == Self.host)
+        let form = try #require(NativeCredentialPromptContext.resolve(Self.form(), bundleID: Self.helper))
+        #expect(try !(Self.binding(owners: Self.existingOwners)).authorizes(
+            hostID: Self.host, bundleID: Self.helper, accountEvidence: form.evidence, localAccount: "fixture"))
+        #expect(throws: NativeCredentialError.invalidBinding) {
+            try NativeCredentialBinding(
+                alias: "apple.fixture.password",
+                kind: .appleAccount,
+                account: "fixture",
+                hostID: Self.host,
+                bundleIDs: [Self.helper])
+        }
+    }
+
+    @MainActor
+    private final class Harness {
+        let scope = UUID()
+        var host = NativeCredentialPasskeyTests.host
+        var localAccount = "fixture"
+        var localAccountFullName = "Fixture Operator"
+        var allowed = true
+        var now = Date(timeIntervalSince1970: 100)
+        var secretReads = 0
+        var entries = 0
+        var duringResolution: (() async -> Void)?
+        var nodes = NativeCredentialPasskeyTests.form()
+        var bindings: [NativeCredentialBinding]
+        lazy var service = self.makeService()
+
+        init() throws {
+            self.bindings = try [NativeCredentialPasskeyTests.binding()]
+        }
+
+        private func makeService() -> NativeCredentialEntryService {

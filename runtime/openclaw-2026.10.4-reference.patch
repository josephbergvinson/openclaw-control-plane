index 0000000000000000000000000000000000000000..622b7aec9e5af588084b0e0f1a209a19af4edbbf
--- /dev/null
+++ b/extensions/discord/src/voice/realtime-consults.yielded.test.ts
@@ -0,0 +1,118 @@
+import type { PluginRuntime } from "openclaw/plugin-sdk/channel-core";
+import { defineDiscordVoiceTests } from "./voice-test-harness.test-support.js";
+
+type RequesterFinal = NonNullable<
+  NonNullable<Parameters<PluginRuntime["agent"]["runCommandFromIngress"]>[2]>["requesterFinal"]
+>;
+
+defineDiscordVoiceTests(
+  ({
+    expect,
+    it,
+    vi,
+    agentCommandMock,
+    realtimeSessionMock,
+    beginSpeakerTurn,
+    createJoinedAgentProxyFixture,
+    createJoinedBidiFixture,
+    emitFinalRealtimeUserTranscript,
+    sentUserMessages,
+  }) => {
+    const acknowledgment = "I am checking the current records.";
+    const finalText = "The original records confirm the requested change is complete.";
+
+    async function yielded(options: { early?: boolean; forced?: boolean } = {}) {
+      let final: RequesterFinal | undefined;
+      const revoke = vi.fn();
+      agentCommandMock.mockImplementationOnce(async (_input, _runtime, delivery) => {
+        final = delivery?.requesterFinal;
+        if (!final) {
+          throw new Error("Expected the admitted native requester completion binding");
+        }
+        final.onRegistration?.({ revoke });
+        if (options.early) {
+          expect(final.append(finalText)).toBe(true);
+          final.onSettled?.();
+        }
+        return { payloads: [], meta: { yielded: true, yieldAcknowledgment: acknowledgment } };
+      });
+      const fixture = options.forced
+        ? await createJoinedAgentProxyFixture()
+        : await createJoinedBidiFixture();
+      beginSpeakerTurn(fixture.entry).close();
+      if (options.forced) {
+        await emitFinalRealtimeUserTranscript(fixture.bridgeParams, "Check the current records");
+      } else {
+        await fixture.bridgeParams.onToolCall?.(
+          {
+            callId: "original-call",
+            itemId: "original-item",
+            name: "openclaw_agent_consult",
+            args: { question: "Check the current records" },
+          },
+          realtimeSessionMock,
+        );
+      }
+      await vi.waitFor(() => expect(final).toBeDefined());
+      return { ...fixture, final: final!, revoke };
+    }
+
+    it("keeps the native launch acknowledgment and delivers its eventual final exactly once without rerunning work", async () => {
+      const f = await yielded();
+      try {
+        expect(realtimeSessionMock.submitToolResult).toHaveBeenCalledWith("original-call", {
+          text: acknowledgment,
+        });
+        expect(f.final.append(finalText)).toBe(true);
+        f.final.onSettled?.();
+        expect(f.final.append(finalText)).toBe(false);
+        await vi.waitFor(() =>
+          expect(sentUserMessages().filter((text) => text.includes(finalText))).toHaveLength(1),
+        );
+        expect(agentCommandMock).toHaveBeenCalledOnce();
+      } finally {
+        await f.manager.destroy();
+      }
+    });
+
+    it("suppresses the stale native acknowledgment when the committed final wins the return race", async () => {
+      const f = await yielded({ early: true });
+      try {
+        expect(realtimeSessionMock.submitToolResult).toHaveBeenCalledWith(
+          "original-call",
+          expect.objectContaining({ status: "already_delivered" }),
+          { suppressResponse: true },
+        );
+        await vi.waitFor(() =>
+          expect(sentUserMessages().filter((text) => text.includes(finalText))).toHaveLength(1),
+        );
+        expect(sentUserMessages().some((text) => text.includes(acknowledgment))).toBe(false);
+        expect(agentCommandMock).toHaveBeenCalledOnce();
+      } finally {
+        await f.manager.destroy();
+      }
+    });
+
+    it("does not enqueue a forced acknowledgment after accepting the actual native final", async () => {
+      const f = await yielded({ early: true, forced: true });
+      try {
+        await vi.waitFor(() =>
+          expect(sentUserMessages().filter((text) => text.includes(finalText))).toHaveLength(1),
+        );
+        expect(sentUserMessages().some((text) => text.includes(acknowledgment))).toBe(false);
+        expect(agentCommandMock).toHaveBeenCalledOnce();
+      } finally {
+        await f.manager.destroy();
+      }
+    });
+
+    it("revokes the call's completion binding and rejects its retained callback after call end", async () => {
+      const f = await yielded();
+      await f.manager.destroy();
+      expect(f.revoke).toHaveBeenCalledOnce();
+      expect(f.final.append(finalText)).toBe(false);
+      expect(sentUserMessages().some((text) => text.includes(finalText))).toBe(false);
+      expect(agentCommandMock).toHaveBeenCalledOnce();
+    });
+  },
+);

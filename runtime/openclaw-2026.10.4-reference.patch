+import { afterEach, describe, expect, it, vi } from "vitest";
+import { startProcessWatchdogFixture } from "./process-watchdog.js";
+
+afterEach(() => {
+  vi.restoreAllMocks();
+  vi.useRealTimers();
+});
+
+describe("process watchdog fixture", () => {
+  it("preserves the synchronous first-watchdog contract", async () => {
+    vi.useFakeTimers();
+    const nativeSchedule = globalThis.setTimeout;
+    let completed = false;
+    const releaseAndWait = startProcessWatchdogFixture(
+      () =>
+        new Promise<void>((resolve) => {
+          setTimeout(() => {
+            completed = true;
+            resolve();
+          }, 100);
+        }),
+    );
+    expect(globalThis.setTimeout).toBe(nativeSchedule);
+    vi.advanceTimersByTime(100);
+    expect(completed).toBe(false);
+    await releaseAndWait();
+    expect(completed).toBe(true);
+  });
+
+  it("gates an asynchronous watchdog while preserving readiness polling", async () => {
+    vi.useFakeTimers();
+    const nativeSchedule = globalThis.setTimeout;
+    const polling = vi.fn();
+    let completed = false;
+    const releaseAndWait = startProcessWatchdogFixture(async () => {
+      await Promise.resolve();
+      return await new Promise<string>((resolve) => {
+        setTimeout(() => {
+          completed = true;
+          resolve("timeout");
+        }, 100);
+      });
+    }, 100);
+    setTimeout(polling, 5);
+    await Promise.resolve();
+    expect(globalThis.setTimeout).toBe(nativeSchedule);
+    vi.advanceTimersByTime(100);
+    expect(polling).toHaveBeenCalledOnce();
+    expect(completed).toBe(false);
+    await expect(releaseAndWait()).resolves.toBe("timeout");
+  });
+
+  it("preserves a later timer spy when the first watchdog completes", async () => {
+    vi.useFakeTimers();
+    const releaseAndWait = startProcessWatchdogFixture(
+      () =>
+        new Promise<void>((resolve) => {
+          setTimeout(resolve, 100);
+        }),
+      100,
+    );
+    const laterSpy = vi.spyOn(globalThis, "setTimeout");
+    vi.advanceTimersByTime(100);
+    await releaseAndWait();
+    expect(globalThis.setTimeout).toBe(laterSpy);
+  });
+
+  it("restores the scheduler when asynchronous startup fails before registration", async () => {
+    vi.useFakeTimers();
+    const nativeSchedule = globalThis.setTimeout;
+    const failure = new Error("startup failed");
+    const releaseAndWait = startProcessWatchdogFixture(async () => {
+      throw failure;
+    }, 100);
+    await expect(releaseAndWait()).rejects.toBe(failure);
+    expect(globalThis.setTimeout).toBe(nativeSchedule);
+  });
+
+  it("restores the scheduler when synchronous startup throws", () => {
+    vi.useFakeTimers();
+    const nativeSchedule = globalThis.setTimeout;
+    expect(() =>
+      startProcessWatchdogFixture(() => {
+        throw new Error("startup failed");
+      }, 100),
+    ).toThrow("startup failed");
+    expect(globalThis.setTimeout).toBe(nativeSchedule);
+  });
+});

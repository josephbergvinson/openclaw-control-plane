index 0000000000000000000000000000000000000000..fd79b8f98e7ff865ac9d57c7bacbb1bbce5ed20f
--- /dev/null
+++ b/src/infra/host-env-security.ca-selection.test.ts
@@ -0,0 +1,100 @@
+import { describe, expect, it } from "vitest";
+import { buildNodeServiceEnvironment, buildServiceEnvironment } from "../daemon/service-env.js";
+import { snapshotNodeWorkerEnv } from "../node-host/node-worker-environment.js";
+import {
+  sanitizeHostExecEnvWithDiagnostics,
+  withHostExecInheritedEnvOmitted,
+} from "./host-env-security.js";
+
+const managed = {
+  SSL_CERT_FILE: "/fixture/managed-ca.pem",
+  NODE_USE_SYSTEM_CA: "0",
+  NODE_EXTRA_CA_CERTS: "/fixture/company-ca.pem",
+  NODE_OPTIONS: "--require=/fixture/hostile.cjs --inspect=9229",
+};
+
+describe("configured CA selection at filtered process boundaries", () => {
+  it("reconstructs only the CA selector and rejects hostile runtime and CA overrides", () => {
+    const { env, rejectedOverrideBlockedKeys } = sanitizeHostExecEnvWithDiagnostics({
+      baseEnv: managed,
+      overrides: {
+        NODE_OPTIONS: "--require=/fixture/request.cjs",
+        SSL_CERT_FILE: "/fixture/request-ca.pem",
+        NODE_EXTRA_CA_CERTS: "/fixture/request-extra-ca.pem",
+        NODE_USE_SYSTEM_CA: "1",
+      },
+    });
+    expect(env.NODE_OPTIONS).toBe("--use-openssl-ca");
+    expect(env.SSL_CERT_FILE).toBe(managed.SSL_CERT_FILE);
+    expect(env.NODE_EXTRA_CA_CERTS).toBe(managed.NODE_EXTRA_CA_CERTS);
+    expect(env.NODE_USE_SYSTEM_CA).toBe("0");
+    expect(rejectedOverrideBlockedKeys).toEqual(
+      expect.arrayContaining(["NODE_OPTIONS", "SSL_CERT_FILE", "NODE_EXTRA_CA_CERTS"]),
+    );
+  });
+
+  it.each(["NODE_OPTIONS", "NODE_USE_SYSTEM_CA", "SSL_CERT_FILE"])(
+    "does not restore scoped-omitted CA selector %s",
+    (omitted) => {
+      const result = withHostExecInheritedEnvOmitted(
+        [omitted],
+        () => sanitizeHostExecEnvWithDiagnostics({ baseEnv: managed }).env,
+      );
+      expect(result[omitted]).toBeUndefined();
+      expect(result.NODE_OPTIONS).toBeUndefined();
+    },
+  );
+
+  it.each([
+    {},
+    { SSL_CERT_FILE: "relative.pem", NODE_USE_SYSTEM_CA: "0" },
+    { SSL_CERT_FILE: "/fixture/ca.pem", NODE_USE_SYSTEM_CA: "1" },
+    { SSL_CERT_FILE: "/fixture/ca.pem\n", NODE_USE_SYSTEM_CA: "0" },
+  ])("keeps unconfigured or invalid CA selection on the existing defaults", (source) => {
+    const result = sanitizeHostExecEnvWithDiagnostics({
+      baseEnv: { ...source, NODE_OPTIONS: "--require=/fixture/x.cjs" },
+    }).env;
+    expect(result.NODE_OPTIONS).toBeUndefined();
+  });
+
+  it("preserves CA selection and company roots through a delegated worker snapshot", () => {
+    const worker = snapshotNodeWorkerEnv({ ...managed, SUPPLIED_SECRET: "synthetic-not-a-secret" });
+    expect(worker).toMatchObject({
+      SSL_CERT_FILE: managed.SSL_CERT_FILE,
+      NODE_USE_SYSTEM_CA: "0",
+      NODE_EXTRA_CA_CERTS: managed.NODE_EXTRA_CA_CERTS,
+      NODE_OPTIONS: "--use-openssl-ca",
+    });
+    expect(worker.SUPPLIED_SECRET).toBeUndefined();
+  });
+
+  it("exclusive CA selection does not silently add the system bundle as extra roots", () => {
+    const exclusive = { SSL_CERT_FILE: managed.SSL_CERT_FILE, NODE_USE_SYSTEM_CA: "0" };
+    for (const service of [
+      buildServiceEnvironment({ env: exclusive, port: 18789, platform: "darwin" }),
+      buildNodeServiceEnvironment({ env: exclusive, platform: "darwin" }),
+    ]) {
+      expect(service.SSL_CERT_FILE).toBe(exclusive.SSL_CERT_FILE);
+      expect(service.NODE_USE_SYSTEM_CA).toBe("0");
+      expect(service.NODE_EXTRA_CA_CERTS).toBeUndefined();
+    }
+  });
+
+  it("keeps service reinstalls on managed CAs without forwarding ambient preloads", () => {
+    for (const service of [
+      buildServiceEnvironment({
+        env: managed,
+        port: 18789,
+        platform: "darwin",
+        existingNodeOptions: "--max-old-space-size=2048 --require=/fixture/prior.cjs",
+      }),
+      buildNodeServiceEnvironment({ env: managed, platform: "darwin" }),
+    ]) {
+      expect(service.SSL_CERT_FILE).toBe(managed.SSL_CERT_FILE);
+      expect(service.NODE_EXTRA_CA_CERTS).toBe(managed.NODE_EXTRA_CA_CERTS);
+      expect(service.NODE_USE_SYSTEM_CA).toBe("0");
+      expect(service.NODE_OPTIONS).toContain("--use-openssl-ca");
+      expect(service.NODE_OPTIONS).not.toMatch(/--require|--inspect/u);
+    }
+  });
+});

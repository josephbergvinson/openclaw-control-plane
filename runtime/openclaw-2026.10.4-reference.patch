+    async (binding) => {
+      const input = await createAdmittedInput();
+      let finishing: Promise<void> | undefined;
+      let admitted: AdmittedFollowupTurn | undefined;
+      let capturedDispatch: Dispatch | undefined;
+      try {
+        await input.send();
+        const dispatch = await input.captured;
+        capturedDispatch = dispatch;

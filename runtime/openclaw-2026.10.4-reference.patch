+      const { timeoutMs } = budget.current();
+      // Native AI snapshots can replace frame refs, so await their bounded write-capable work.
+      const identity = readRoleSnapshotFieldIdentity(
+        await control.ariaSnapshot({
+          ...(options.ai ? { mode: "ai" as const } : {}),
+          ...(timeoutMs === undefined ? {} : { timeout: timeoutMs }),

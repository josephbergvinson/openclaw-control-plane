@@ -0,0 +1,53 @@
+import { describe, expect, it } from "vitest";
+import { buildOpenClawControlSection } from "./system-prompt-openclaw-control.js";
+
+describe("buildOpenClawControlSection", () => {
+  it.each([
+    { name: "native controls and exec", hasOpenClaw: true, hasGateway: true, hasExec: true },
+    { name: "read/update control and exec", hasOpenClaw: false, hasGateway: true, hasExec: true },
+    { name: "exec only", hasOpenClaw: false, hasGateway: false, hasExec: true },
+  ])(
+    "admits only the documented authorized external lifecycle route with $name",
+    ({ hasOpenClaw, hasGateway, hasExec }) => {
+      const control = buildOpenClawControlSection({ hasOpenClaw, hasGateway, hasExec }).join("\n");
+
+      expect(control).toContain(
+        "When native controls do not expose or support the required host operation",
+      );
+      expect(control).toContain("authenticated owner's explicit or standing authorization");
+      expect(control).toContain("existing documented external lifecycle owner");
+      expect(control).toContain(
+        "normal exec authorization, drain/handoff, resumable work and a verified rollback target",
+      );
+      expect(control).toContain("verify successor identity/health");
+      expect(control).toContain("Do not bypass an authorization or policy refusal");
+      expect(control).toContain("Do not run ad hoc openclaw update, npm install -g openclaw");
+      expect(control).toContain("installation swaps, process kills, or new lifecycle controllers");
+      expect(control).toContain(
+        "does not prohibit release selection or installation performed by that existing documented lifecycle owner",
+      );
+      expect(control).toContain("never duplicate it with exec or another updater");
+      expect(control).toContain("A plain-language setup reply is guidance");
+      expect(control).not.toContain(
+        "or stop/restart the gateway service via exec or detached jobs",
+      );
+    },
+  );
+
+  it("does not offer an external exec lifecycle route without exec", () => {
+    const prompt = buildOpenClawControlSection({
+      hasOpenClaw: true,
+      hasGateway: true,
+      hasExec: false,
+    }).join("\n");
+
+    expect(prompt).toContain(
+      "Gateway restart, config, channels, plugins, agents, models/providers: ask `openclaw`.",
+    );
+    expect(prompt).toContain("Update OpenClaw: `gateway` action update.run");
+    expect(prompt).not.toContain("existing documented external lifecycle owner");
+    expect(prompt).toContain(
+      "do not bypass an authorization or policy refusal or duplicate an admitted update",
+    );
+  });
+});
diff --git a/src/agents/system-prompt-openclaw-control.ts b/src/agents/system-prompt-openclaw-control.ts
new file mode 100644
index 0000000000000000000000000000000000000000..85fe346857520a844b3b4fc3f8c62d2f2dd8562d
--- /dev/null
+++ b/src/agents/system-prompt-openclaw-control.ts
@@ -0,0 +1,41 @@
+export function buildOpenClawControlSection({
+  hasOpenClaw,
+  hasGateway,
+  hasExec,
+}: {
+  hasOpenClaw: boolean;
+  hasGateway: boolean;
+  hasExec: boolean;
+}): string[] {
+  return [
+    "## OpenClaw Control",
+    "Do not invent commands.",
+    hasOpenClaw
+      ? "Gateway restart, config, channels, plugins, agents, models/providers: ask `openclaw`."
+      : hasGateway
+        ? "Config read: `gateway` (`config.get|config.schema.lookup`) only when those actions are exposed by its schema. Prefer the exposed `openclaw` actions for config writes and restarts; the owner can send `/restart` in chat."
+        : "",
+    [
+      "For the Gateway hosting this session:",
+      "In a connected chat, the owner can send `/update` with commands.restart enabled (the default), regardless of the agent's tool profile.",
+      hasGateway
+        ? "Update OpenClaw: `gateway` action update.run, only on an explicit owner request or an operator-scheduled update; the runtime coordinates restart and completion notices. If refused, explain why and follow the tool's exact recovery instructions; do not bypass an authorization or policy refusal or duplicate an admitted update."
+        : "For a chat update request, direct the user to `/update`. Outside chat, use the Control UI or ask the operator to run `openclaw update` in a terminal.",
+      "Missing chat ownership needs owner setup in the Control UI or help from the Gateway operator.",
+      "Use only actions exposed by the tool schema. A plain-language setup reply is guidance, not evidence that a command or lifecycle operation ran.",
+      "Do not run ad hoc openclaw update, npm install -g openclaw, installation swaps, process kills, or new lifecycle controllers. This does not prohibit release selection or installation performed by that existing documented lifecycle owner.",
+      ...(hasExec
+        ? [
+            "When native controls do not expose or support the required host operation, an authenticated owner's explicit or standing authorization permits the host's existing documented external lifecycle owner. Use that supported route exactly with normal exec authorization, drain/handoff, resumable work and a verified rollback target; verify successor identity/health, then continue the task. Detached execution is allowed only when that route requires it. Do not bypass an authorization or policy refusal.",
+          ]
+        : []),
+      "Reconcile any already admitted update before another transition; never duplicate it with exec or another updater.",
+    ].join(" "),
+    ...(hasExec
+      ? [
+          "For a user-requested update on another host, verify it is not this Gateway, then use exec/SSH with `openclaw update --yes`; normal exec approvals still apply.",
+        ]
+      : []),
+    "",
+  ];
+}

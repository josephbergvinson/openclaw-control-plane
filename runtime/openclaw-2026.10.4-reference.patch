+} from "./agent-command.compaction.test-support.js";
+import { logAgentCommandPostRunFailure } from "./command/ingress-diagnostics.js";
+
+const { commandWarning } = vi.hoisted(() => ({
+  commandWarning: vi.fn<(message: string, meta?: Record<string, unknown>) => void>(),
+}));
+vi.mock("../logging/subsystem.js", async () => {
+  const actual =
+    await vi.importActual<typeof import("../logging/subsystem.js")>("../logging/subsystem.js");
+  return {
+    ...actual,
+    createSubsystemLogger: (subsystem: string) => {
+      const logger = actual.createSubsystemLogger(subsystem);
+      return subsystem === "agents/agent-command" ? { ...logger, warn: commandWarning } : logger;
+    },
+  };
+});
+
+registerAgentCommandCompactionTestHooks();
+beforeEach(() => commandWarning.mockReset());
+
+describe("agent command primary failure custody", () => {
+  it("classifies diagnostic properties once without exposing changing getter content", () => {
+    const name = vi.fn().mockReturnValueOnce("Error").mockReturnValue("private error name");
+    const code = vi.fn().mockReturnValueOnce("ABORT_ERR").mockReturnValue("private error code");
+    const failure = new Error("private error message");
+    Object.defineProperties(failure, { name: { get: name }, code: { get: code } });
+    logAgentCommandPostRunFailure(failure, {
+      stage: "delivery",
+      commandAborted: false,
+      deferredAborted: false,
+      resultAborted: false,
+      terminalProducerBound: true,
+    });
+    expect(name).toHaveBeenCalledOnce();
+    expect(code).toHaveBeenCalledOnce();
+    expect(commandWarning).toHaveBeenCalledWith(
+      "Agent command post-run failed",
+      expect.objectContaining({ errorName: "Error", errorCode: "ABORT_ERR" }),
+    );
+    expect(JSON.stringify(commandWarning.mock.calls)).not.toContain("private");
+  });
+
+  it.each([
+    "delivery",
+    "undefined",
+    "false",
+    "source cancellation",
+    "cleanup only",
+    "diagnostic logger",
+    "diagnostic getter",
+  ] as const)("preserves the first failure while joining terminal cleanup: %s", async (mode) => {
+    const sessionId = `first-failure-${mode.replaceAll(" ", "-")}`;
+    const sessionKey = `agent:main:explicit:${sessionId}`;
+    const primary =
+      mode === "undefined" ? undefined : mode === "false" ? false : new Error("first failure");
+    const secondary = new Error("terminal cleanup failure");
+    const diagnosticFailure = new Error("diagnostic failure");
+    if (mode === "diagnostic logger") {
+      commandWarning.mockImplementation((message) => {
+        if (
+          message === "Agent command post-run failed" ||
+          message === "Agent command cleanup also failed; preserving primary failure"
+        ) {
+          throw diagnosticFailure;
+        }
+      });
+    } else if (mode === "diagnostic getter") {
+      const readCode = vi
+        .fn<() => undefined>(() => undefined)
+        .mockImplementationOnce(() => {
+          throw diagnosticFailure;
+        });
+      Object.defineProperty(primary, "code", {
+        get: readCode,
+      });
+    }
+    const source = new AbortController();
+    const beforeTerminalDelivery = vi
+      .fn<() => Promise<void>>()
+      .mockResolvedValueOnce(undefined)
+      .mockRejectedValue(secondary);
+    state.runAgentAttemptMock.mockResolvedValueOnce(
+      makeCompactionResult({
+        sessionId,
+        text: "The delegated result is ready.",
+        runner: "embedded",
+        agentHarnessId: "openclaw",
+      }),
+    );
+    if (mode === "source cancellation") {
+      state.deliverAgentCommandResultMock.mockImplementationOnce(
+        async (params: { assertDeliveryCurrent?: () => void }) => {
+          source.abort(primary);
+          params.assertDeliveryCurrent?.();
+          throw new Error("Cancelled source unexpectedly crossed final delivery");
+        },
+      );
+    } else if (mode !== "cleanup only") {
+      state.deliverAgentCommandResultMock.mockRejectedValueOnce(primary);
+    }
+
+    await expect(
+      agentCommandFromGatewayIngress(
+        {
+          message: "Report the delegated result.",
+          sessionId,
+          sessionKey,
+          allowModelOverride: false,
+          abortSignal: source.signal,
+          beforeTerminalDelivery,
+        },
+        ...GATEWAY_INGRESS_ARGS,
+      ),
+    ).rejects.toBe(mode === "cleanup only" ? secondary : primary);
+
+    expect(beforeTerminalDelivery).toHaveBeenCalledTimes(2);
+    expect(state.deliverAgentCommandResultMock).toHaveBeenCalledOnce();
+    expect(source.signal.aborted).toBe(mode === "source cancellation");
+    expect(state.runMemoryFlushIfNeededMock).not.toHaveBeenCalled();
+    expect(state.runSessionCompactionIfNeededMock).not.toHaveBeenCalled();
+    if (mode === "delivery") {
+      expect(commandWarning).toHaveBeenCalledWith("Agent command post-run failed", {
+        stage: "delivery",
+        errorName: "Error",
+        errorCode: "unclassified",
+        commandAborted: false,
+        deferredAborted: false,
+        resultAborted: false,
+        terminalProducerBound: true,
+      });
+      expect(JSON.stringify(commandWarning.mock.calls)).not.toContain("first failure");
+    }
+  });
+});

--- /dev/null
+++ b/src/agents/subagents/registry/subagent-progress-checkpoint.ts
@@ -0,0 +1,122 @@
+import { normalizeOptionalString } from "@openclaw/normalization-core/string-coerce";
+import { isCompleteAgentPreamble } from "../../agent-activity-presentation.js";
+
+const MAX_CHECKPOINT_CHARS = 1_600;
+export type SubagentProgressCheckpoint = { key: string; text: string };
+
+type SubagentProgressEvent = {
+  seq: number;
+  stream: string;
+  data: Record<string, unknown>;
+};
+
+type ActiveCommentary =
+  | { kind: "item"; itemId: string }
+  | { kind: "unkeyed_snapshot"; text: string };
+
+function boundedNaturalCheckpointText(value: unknown): string | undefined {
+  const text = normalizeOptionalString(value)?.replace(/\s+/gu, " ");
+  if (!text || /^(?:checking|working|thinking|looking|on it)[.!…]*$/iu.test(text)) {
+    return undefined;
+  }
+  return text.length <= MAX_CHECKPOINT_CHARS ? text : `${text.slice(0, MAX_CHECKPOINT_CHARS - 1)}…`;
+}
+
+export class SubagentProgressCheckpointProjector {
+  private lastEventSeq = 0;
+  private readonly commentaryTextByItem = new Map<string, string>();
+  private readonly completedCommentaryItems = new Set<string>();
+  private readonly completedToolBoundaries = new Set<string>();
+  private activeCommentary?: ActiveCommentary;
+
+  private completeItem(itemId: string): SubagentProgressCheckpoint | undefined {
+    if (this.completedCommentaryItems.has(itemId)) {
+      return undefined;
+    }
+    this.completedCommentaryItems.add(itemId);
+    if (this.activeCommentary?.kind === "item" && this.activeCommentary.itemId === itemId) {
+      this.activeCommentary = undefined;
+    }
+    const text = boundedNaturalCheckpointText(this.commentaryTextByItem.get(itemId));
+    this.commentaryTextByItem.delete(itemId);
+    return text ? { key: `commentary:${itemId}:completed`, text } : undefined;
+  }
+
+  private completeActiveCommentary(
+    toolCallId: string | undefined,
+  ): SubagentProgressCheckpoint | undefined {
+    const active = this.activeCommentary;
+    if (!active) {
+      return undefined;
+    }
+    if (active.kind === "item") {
+      return this.completeItem(active.itemId);
+    }
+    if (!toolCallId || this.completedToolBoundaries.has(toolCallId)) {
+      return undefined;
+    }
+    this.completedToolBoundaries.add(toolCallId);
+    this.activeCommentary = undefined;
+    const text = boundedNaturalCheckpointText(active.text);
+    return text ? { key: `commentary:tool:${toolCallId}:completed`, text } : undefined;
+  }
+
+  projectCheckpoint(event: SubagentProgressEvent): SubagentProgressCheckpoint | undefined {
+    // Agent sequence numbers are run-global; replayed deltas must not be
+    // appended twice to the item-keyed commentary accumulator.
+    if (event.seq <= this.lastEventSeq) {
+      return undefined;
+    }
+    this.lastEventSeq = event.seq;
+
+    if (event.stream === "tool") {
+      if (normalizeOptionalString(event.data.phase) !== "start") {
+        return undefined;
+      }
+      return this.completeActiveCommentary(normalizeOptionalString(event.data.toolCallId));
+    }
+
+    let itemId: string | undefined;
+    let accumulatedText: string | undefined;
+    let completed = event.data.completed === true;
+    if (event.stream === "item") {
+      if (normalizeOptionalString(event.data.kind) !== "preamble") {
+        return undefined;
+      }
+      itemId = normalizeOptionalString(event.data.itemId) ?? `item:${event.seq}`;
+      accumulatedText = normalizeOptionalString(event.data.progressText);
+      completed ||= isCompleteAgentPreamble({
+        phase: normalizeOptionalString(event.data.phase),
+        progressText: accumulatedText,
+      });
+    } else if (event.stream === "assistant") {
+      if (normalizeOptionalString(event.data.phase) !== "commentary") {
+        return undefined;
+      }
+      itemId = normalizeOptionalString(event.data.itemId);
+      if (!itemId) {
+        if (event.data.replace === true && typeof event.data.text === "string") {
+          this.activeCommentary = { kind: "unkeyed_snapshot", text: event.data.text };
+        }
+        return undefined;
+      }
+      if (event.data.replace === true || (completed && typeof event.data.text === "string")) {
+        accumulatedText = typeof event.data.text === "string" ? event.data.text : undefined;
+      } else if (typeof event.data.delta === "string" && event.data.delta.length > 0) {
+        accumulatedText = `${this.commentaryTextByItem.get(itemId) ?? ""}${event.data.delta}`;
+      }
+    }
+    if (!itemId || accumulatedText === undefined) {
+      return undefined;
+    }
+    if (this.completedCommentaryItems.has(itemId)) {
+      return undefined;
+    }
+    this.commentaryTextByItem.set(itemId, accumulatedText);
+    this.activeCommentary = { kind: "item", itemId };
+    if (!completed) {
+      return undefined;
+    }
+    return this.completeItem(itemId);
+  }
+}
diff --git a/src/agents/subagents/registry/subagent-registry-progress-projection.ts b/src/agents/subagents/registry/subagent-registry-progress-projection.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b46ad63d894a466c27464f59cf08128099f32c0d
--- /dev/null
+++ b/src/agents/subagents/registry/subagent-registry-progress-projection.ts
@@ -0,0 +1,351 @@
+import type {
+  createProgressContinuationOwner,
+  RequesterProgressPublication,
+} from "../../../channels/progress-continuation.js";
+import type { ChannelProgressDraftCompositorSnapshot } from "../../../channels/progress-draft-compositor.types.js";
+import type { AgentEventPayload } from "../../../infra/agent-events.js";
+import type {
+  SubagentProgressCheckpointProjector,
+  SubagentProgressCheckpoint,
+} from "./subagent-progress-checkpoint.js";
+import type { SubagentRunRecord } from "./subagent-registry.types.js";
+import { isSameSubagentRunOwner } from "./subagent-run-generation.js";
+
+export type ProgressSource = {
+  channel: string;
+  to: string;
+  accountId?: string;
+  threadId?: string | number;
+};
+export type Lane = {
+  runId: string;
+  sessionKey: string;
+  agentId?: string;
+  entry: SubagentRunRecord;
+  source: ProgressSource;
+  sourceKey: string;
+  projector: SubagentProgressCheckpointProjector;
+  abort: AbortController;
+  checkpoint?: AbortController;
+  lastProgressAt: number;
+  nextCheckpointAt: number;
+  pending?: SubagentProgressCheckpoint;
+  publishing?: Promise<void>;
+  synthesis?: {
+    entries: readonly SubagentRunRecord[];
+    sessionId: string;
+    isCurrent: () => boolean;
+    started: boolean;
+  };
+};
+export type Presentation = {
+  entries: readonly SubagentRunRecord[];
+  requesterTurnRunId: string;
+  operationId: string;
+  owner: ReturnType<typeof createProgressContinuationOwner>;
+};
+
+export function source(entry: SubagentRunRecord, synthesis = false): ProgressSource | undefined {
+  const origin = entry.progressOrigin;
+  if (
+    origin?.channel !== "discord" ||
+    !origin.to?.trim() ||
+    !origin.messageId ||
+    (!synthesis && entry.collect) ||
+    entry.killIntent ||
+    entry.killReconciliation ||
+    entry.execution.suppressSessionEffects ||
+    entry.delivery?.requesterVisibleFinal !== undefined ||
+    (synthesis
+      ? entry.execution.status !== "terminal" ||
+        typeof entry.execution.endedAt !== "number" ||
+        !Number.isFinite(entry.execution.endedAt)
+      : entry.execution.status !== "running" && entry.execution.status !== "queued")
+  ) {
+    return undefined;
+  }
+  return {
+    channel: origin.channel,
+    to: origin.to,
+    accountId: origin.accountId,
+    threadId: origin.threadId,
+  };
+}
+export function sourceKey(entry: SubagentRunRecord): string {
+  return JSON.stringify([
+    entry.requesterSessionKey,
+    entry.requesterAgentId,
+    entry.requesterTurnRunId ?? entry.requesterSettleWake?.progressOperationId,
+    entry.progressOrigin?.channel,
+    entry.progressOrigin?.accountId,
+    entry.progressOrigin?.to,
+    String(entry.progressOrigin?.threadId ?? ""),
+    String(entry.progressOrigin?.messageId ?? ""),
+  ]);
+}
+
+export type SubagentRegistryProgressParams = {
+  runs: ReadonlyMap<string, SubagentRunRecord>;
+  onAgentEvent: (listener: (event: AgentEventPayload) => void) => () => void;
+  onRunChanges: (listener: (runIds?: readonly string[]) => void) => () => void;
+  isSourceCurrent: (entry: SubagentRunRecord) => boolean;
+  publish: (input: {
+    runId: string;
+    cohort?: readonly SubagentRunRecord[];
+    entry: SubagentRunRecord;
+    source: ProgressSource;
+    checkpoint: SubagentProgressCheckpoint;
+    signal: AbortSignal;
+    assertCurrent: () => void;
+  }) => Promise<boolean>;
+  edit: (input: {
+    entry: SubagentRunRecord;
+    source: ProgressSource;
+    messageId: string;
+    text: string;
+    snapshot: ChannelProgressDraftCompositorSnapshot;
+    signal: AbortSignal;
+    assertCurrent: () => void;
+  }) => Promise<boolean>;
+  requestCheckpoint: (input: {
+    runId: string;
+    sessionKey: string;
+    sessionId?: string;
+    cohort?: readonly SubagentRunRecord[];
+    entry: SubagentRunRecord;
+    message: string;
+    signal: AbortSignal;
+    queueIdentity: string;
+    assertCurrent: () => void;
+  }) => Promise<boolean>;
+  now?: () => number;
+  warn: (message: string, error?: unknown) => void;
+};
+
+// A native yield replaces the turn claim with its acknowledged operation
+// reference. Completion remains owned while its exact frozen cohort settles.
+export function currentPresentation(
+  presentation: Presentation,
+  params: Pick<SubagentRegistryProgressParams, "runs" | "isSourceCurrent">,
+): SubagentRunRecord[] | undefined {
+  const rows = presentation.entries.map((entry) => params.runs.get(entry.runId));
+  if (rows.some((entry) => !entry)) {
+    return undefined;
+  }
+  const currentRows = rows.filter((entry): entry is SubagentRunRecord => Boolean(entry));
+  const batch = presentation.entries.map((entry) => entry.runId).toSorted();
+  const yielded = currentRows.every((entry) => !entry.requesterTurnRunId);
+  const wake = currentRows[0]?.requesterSettleWake;
+  if (
+    yielded &&
+    (!wake ||
+      wake.progressOperationId !== presentation.operationId ||
+      !Number.isSafeInteger(wake.rearmGeneration) ||
+      (wake.rearmGeneration ?? 0) < 1)
+  ) {
+    return undefined;
+  }
+  try {
+    if (
+      currentRows.some((fresh, index) => {
+        const original = presentation.entries[index];
+        if (!original) {
+          return true;
+        }
+        const pending = fresh.requesterSettleWake;
+        return (
+          !isSameSubagentRunOwner(fresh, original) ||
+          sourceKey(fresh) !== sourceKey(original) ||
+          fresh.completionRequesterSessionId !== original.completionRequesterSessionId ||
+          fresh.completionRequesterLifecycleRevision !==
+            original.completionRequesterLifecycleRevision ||
+          fresh.collect === true ||
+          fresh.suppressCompletionDelivery === true ||
+          fresh.delivery?.requesterVisibleFinal !== undefined ||
+          fresh.delivery?.status === "suspended" ||
+          fresh.delivery?.status === "discarded" ||
+          fresh.delivery?.disposition === "permanent_failure" ||
+          !source(fresh, fresh.execution.status === "terminal") ||
+          !params.isSourceCurrent(fresh) ||
+          (fresh.execution.status === "terminal" && fresh.expectsCompletionMessage !== true) ||
+          (yielded
+            ? fresh.expectsCompletionMessage !== true ||
+              !pending?.requesterYieldBatch ||
+              pending.progressOperationId !== presentation.operationId ||
+              pending.rearmGeneration !== wake?.rearmGeneration ||
+              !pending.batchRunIds ||
+              JSON.stringify(pending.batchRunIds.toSorted()) !== JSON.stringify(batch)
+            : fresh.requesterTurnRunId !== presentation.requesterTurnRunId)
+        );
+      })
+    ) {
+      return undefined;
+    }
+  } catch {
+    return undefined;
+  }
+  return currentRows;
+}
+
+/** Keep a known but non-publishable card's restriction without inventing a receipt. */
+export function withheldRequesterProgress(params: {
+  prior: readonly SubagentRunRecord[];
+  isProgressMessageId: (messageId: string) => boolean;
+}): RequesterProgressPublication | undefined {
+  const route = params.prior[0]?.progressOrigin;
+  if (
+    !route?.channel ||
+    !route.to ||
+    params.prior.some(
+      (entry) =>
+        entry.progressOrigin?.channel !== route.channel ||
+        entry.progressOrigin?.accountId !== route.accountId ||
+        entry.progressOrigin?.to !== route.to ||
+        String(entry.progressOrigin?.threadId ?? "") !== String(route.threadId ?? "") ||
+        entry.progressOrigin?.messageId !== route.messageId,
+    )
+  ) {
+    return undefined;
+  }
+  return {
+    source: Object.freeze({
+      channel: route.channel,
+      accountId: route.accountId,
+      to: route.to,
+      threadId: route.threadId,
+    }),
+    isProgressMessageId: params.isProgressMessageId,
+    publish: async () => {
+      throw new Error("Requester progress has no current adopted presentation");
+    },
+  };
+}
+
+/** Capture only branded platform receipts, retaining the native source/version fence. */
+export function captureRequesterProgressRole(params: {
+  prior: readonly SubagentRunRecord[];
+  receiptIds: readonly (string | undefined)[];
+  runs: ReadonlyMap<string, SubagentRunRecord>;
+  isCurrent: () => boolean;
+  isSourceCurrent: (entry: SubagentRunRecord) => boolean;
+}): (messageId: string) => boolean {
+  const messageIds = new Set(params.receiptIds.filter((id): id is string => Boolean(id)));
+  const currentEntries = params.prior.map((entry) => params.runs.get(entry.runId) ?? entry);
+  const entries = new Map(currentEntries.map((entry) => [entry.runId, entry]));
+  let inconsistentCohort = false;
+  const messageKey = (entry: SubagentRunRecord) => {
+    const message = entry.requesterSettleWake?.progressMessage;
+    return JSON.stringify(
+      message && [
+        message.channel,
+        message.accountId,
+        message.to,
+        String(message.threadId ?? ""),
+        message.messageId,
+      ],
+    );
+  };
+  for (const entry of currentEntries) {
+    const wake = entry.requesterSettleWake;
+    const message = wake?.progressMessage;
+    const origin = entry.progressOrigin;
+    if (
+      wake?.progressOperationId &&
+      wake.requesterYieldBatch === true &&
+      Number.isSafeInteger(wake.rearmGeneration) &&
+      (wake.rearmGeneration ?? 0) >= 1 &&
+      wake.batchRunIds?.includes(entry.runId) &&
+      origin?.channel &&
+      origin.to &&
+      message &&
+      typeof message.messageId === "string" &&
+      message.messageId.trim() &&
+      message.channel === origin.channel &&
+      message.accountId === origin.accountId &&
+      message.to === origin.to &&
+      String(message.threadId ?? "") === String(origin.threadId ?? "")
+    ) {
+      const batch = wake.batchRunIds.toSorted();
+      const cohort = batch.map((runId) => params.runs.get(runId));
+      if (
+        new Set(batch).size !== batch.length ||
+        cohort.some((member) => {
+          const pending = member?.requesterSettleWake;
+          return (
+            !member ||
+            sourceKey(member) !== sourceKey(entry) ||
+            member.completionRequesterSessionId !== entry.completionRequesterSessionId ||
+            member.completionRequesterLifecycleRevision !==
+              entry.completionRequesterLifecycleRevision ||
+            member.expectsCompletionMessage !== true ||
+            pending?.requesterYieldBatch !== true ||
+            pending.progressOperationId !== wake.progressOperationId ||
+            pending.rearmGeneration !== wake.rearmGeneration ||
+            JSON.stringify(pending.batchRunIds?.toSorted()) !== JSON.stringify(batch) ||
+            messageKey(member) !== messageKey(entry)
+          );
+        })
+      ) {
+        inconsistentCohort = true;
+        continue;
+      }
+      for (const member of cohort) {
+        if (member) {
+          entries.set(member.runId, member);
+        }
+      }
+      messageIds.add(message.messageId);
+    }
+  }
+  const sources = [...entries.values()].map((entry) => ({
+    entry,
+    key: sourceKey(entry),
+    rearmGeneration: entry.requesterSettleWake?.rearmGeneration,
+    batchKey: JSON.stringify(entry.requesterSettleWake?.batchRunIds?.toSorted()),
+    messageKey: messageKey(entry),
+    requesterSessionId: entry.completionRequesterSessionId,
+    lifecycleRevision: entry.completionRequesterLifecycleRevision,
+  }));
+  return (messageId) => {
+    if (
+      !params.isCurrent() ||
+      inconsistentCohort ||
+      sources.some(
+        ({
+          entry,
+          key,
+          rearmGeneration,
+          batchKey,
+          messageKey: capturedMessageKey,
+          requesterSessionId,
+          lifecycleRevision,
+        }) => {
+          const fresh = params.runs.get(entry.runId);
+          return (
+            !fresh ||
+            !isSameSubagentRunOwner(fresh, entry) ||
+            sourceKey(fresh) !== key ||
+            fresh.requesterSettleWake?.rearmGeneration !== rearmGeneration ||
+            JSON.stringify(fresh.requesterSettleWake?.batchRunIds?.toSorted()) !== batchKey ||
+            messageKey(fresh) !== capturedMessageKey ||
+            fresh.completionRequesterSessionId !== requesterSessionId ||
+            fresh.completionRequesterLifecycleRevision !== lifecycleRevision ||
+            fresh.killIntent ||
+            fresh.killReconciliation ||
+            fresh.collect === true ||
+            fresh.suppressCompletionDelivery === true ||
+            fresh.delivery?.requesterVisibleFinal !== undefined ||
+            fresh.delivery?.status === "suspended" ||
+            fresh.delivery?.status === "discarded" ||
+            fresh.delivery?.disposition === "permanent_failure" ||
+            fresh.execution.suppressSessionEffects ||
+            !params.isSourceCurrent(fresh)
+          );
+        },
+      )
+    ) {
+      throw new Error("Requester progress role lost its source");
+    }
+    return messageIds.has(messageId);
+  };
+}
diff --git a/src/agents/subagents/registry/subagent-registry-progress.live-requester.test.ts b/src/agents/subagents/registry/subagent-registry-progress.live-requester.test.ts

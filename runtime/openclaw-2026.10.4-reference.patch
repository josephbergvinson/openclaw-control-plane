+import { vi } from "vitest";
+import type { AgentEventPayload } from "../../../infra/agent-events.js";
+import { createSubagentRegistryProgress } from "./subagent-registry-progress.js";
+import type { SubagentRunRecord } from "./subagent-registry.types.js";
+
+export const row = (overrides: Partial<SubagentRunRecord> = {}): SubagentRunRecord => ({
+  runId: "child-run",
+  childSessionKey: "agent:main:subagent:child",
+  childAgentId: "main",
+  requesterSessionKey: "agent:main:discord:channel:parent",
+  requesterAgentId: "main",
+  requesterTurnRunId: "parent-run",
+  requesterDisplayKey: "parent",
+  task: "repair",
+  cleanup: "keep",
+  createdAt: 1,
+  execution: { status: "running", lifecycleGeneration: "current" },
+  progressOrigin: {
+    channel: "discord",
+    accountId: "bot",
+    to: "channel:parent",
+    messageId: "original",
+  },
+  ...overrides,
+});
+export function fixture() {
+  const initial = row();
+  const runs = new Map([[initial.runId, initial]]);
+  let clock = 0;
+  let live = true;
+  let events: ((event: AgentEventPayload) => void) | undefined;
+  let changes: ((runIds?: readonly string[]) => void) | undefined;
+  const stopEvents = vi.fn();
+  const stopChanges = vi.fn();
+  const publish = vi.fn<Parameters<typeof createSubagentRegistryProgress>[0]["publish"]>(
+    async () => true,
+  );
+  const edit = vi.fn<Parameters<typeof createSubagentRegistryProgress>[0]["edit"]>(
+    async () => true,
+  );
+  const requestCheckpoint = vi.fn<
+    Parameters<typeof createSubagentRegistryProgress>[0]["requestCheckpoint"]
+  >(async () => true);
+  const owner = createSubagentRegistryProgress({
+    runs,
+    onAgentEvent: (observe) => {
+      events = observe;
+      return stopEvents;
+    },
+    onRunChanges: (observe) => {
+      changes = observe;
+      return stopChanges;
+    },
+    isSourceCurrent: () => live,
+    publish,
+    edit,
+    requestCheckpoint,
+    now: () => clock,
+    warn: vi.fn(),
+  });
+  owner.ensure();
+  let seq = 0;
+  const emit = (data: Record<string, unknown>, fields: Partial<AgentEventPayload> = {}) =>
+    events?.({
+      runId: initial.runId,
+      seq: ++seq,
+      stream: "assistant",
+      ts: clock,
+      sessionKey: initial.childSessionKey,
+      agentId: initial.childAgentId,
+      lifecycleGeneration: "current",
+      data: { phase: "commentary", ...data },
+      ...fields,
+    });
+  const completed = (itemId: string, text: string, fields?: Partial<AgentEventPayload>) =>
+    emit({ itemId, text, completed: true, replace: true }, fields);
+  return {
+    owner,
+    initial,
+    runs,
+    publish,
+    edit,
+    requestCheckpoint,
+    emit,
+    completed,
+    changes: () => changes?.(),
+    setClock: (at: number) => {
+      clock = at;
+    },
+    retire: () => {
+      live = false;
+      changes?.();
+    },
+    stopEvents,
+    stopChanges,
+  };
+}
+export const drain = async () => {
+  for (let i = 0; i < 12; i++) {
+    await Promise.resolve();
+  }
+};

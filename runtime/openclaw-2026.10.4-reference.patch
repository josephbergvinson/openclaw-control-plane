@@ -213,6 +213,53 @@ runs:
           echo "toolchain-populated=true" >> "$GITHUB_OUTPUT"
         fi
 
+    # The optional platform package is hydrated only where pnpm will install it.
+    # The resource packet is the one normative version/hash/URL declaration.
+    - name: Validate native resource pin
+      if: runner.os == 'macOS' && runner.arch == 'ARM64' && env.OPENCLAW_NATIVE_RESOURCE_REF != ''
+      shell: bash
+      env:
+        NATIVE_RESOURCE_REF: ${{ env.OPENCLAW_NATIVE_RESOURCE_REF }}
+      run: |
+        set -euo pipefail
+        [[ "$NATIVE_RESOURCE_REF" =~ ^[0-9a-f]{40}$ ]] || {
+          echo "::error::Native resource owner requires a reviewed full commit SHA" >&2
+          exit 1
+        }
+
+    - name: Checkout native resource owner
+      if: runner.os == 'macOS' && runner.arch == 'ARM64' && env.OPENCLAW_NATIVE_RESOURCE_REF != ''
+      uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+      with:
+        repository: josephbergvinson/openclaw-control-plane
+        ref: ${{ env.OPENCLAW_NATIVE_RESOURCE_REF }}
+        path: .ci-harness/native-resource
+        persist-credentials: false
+        sparse-checkout: |
+          /scripts/reconstruct_runtime.py
+          /runtime/native160/native160-provenance.json
+        sparse-checkout-cone-mode: false
+
+    - name: Hydrate native runtime dependency
+      if: runner.os == 'macOS' && runner.arch == 'ARM64' && env.OPENCLAW_NATIVE_RESOURCE_REF != ''
+      shell: bash
+      env:
+        NATIVE_RESOURCE_REF: ${{ env.OPENCLAW_NATIVE_RESOURCE_REF }}
+      run: |
+        set -euo pipefail
+        native_resource_root="$GITHUB_WORKSPACE/.ci-harness/native-resource"
+        if ! native_resource_head="$(git -C "$native_resource_root" rev-parse HEAD)"; then
+          echo "::error::Unable to read native resource checkout identity" >&2
+          exit 1
+        fi
+        if [[ "$native_resource_head" != "$NATIVE_RESOURCE_REF" ]]; then
+          echo "::error::Native resource checkout does not match the reviewed commit" >&2
+          exit 1
+        fi
+        python3 -B "$native_resource_root/scripts/reconstruct_runtime.py" \
+          "$GITHUB_WORKSPACE" --native-artifact-provenance \
+          "$native_resource_root/runtime/native160/native160-provenance.json"
+
     - name: Configure dependency cache store
       if: inputs.cache-mode != 'off' && (runner.os != 'Windows' || inputs.dependency-cache == 'true')
       shell: bash

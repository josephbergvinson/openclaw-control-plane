+            nodes[5] = .init(parent: 9, role: "AXStaticText", subrole: nil, text: nodes[5].text, ownerPID: 43)
+        case "cancel-role":
+            nodes[8] = .init(parent: 1, role: "AXStaticText", subrole: nil, text: ["Cancel"], ownerPID: 43)
+        case "unlock-role":
+            nodes[7] = .init(parent: 1, role: "AXStaticText", subrole: nil, text: ["Unlock"], ownerPID: 43)
+        case "unlock-outside":
+            nodes[7] = .init(
+                parent: nil,
+                role: "AXButton",
+                subrole: nil,
+                text: ["Unlock"],
+                buttonTitle: "Unlock",
+                ownerPID: 43)
+        case "extra-button": nodes.append(nodes[8])
+        case "extra-editor": nodes.append(.init(parent: 1, role: "AXTextField", subrole: nil, text: [], ownerPID: 43))
+        case "second-secure": nodes.append(nodes[6])
+        case "competing-account":
+            nodes.append(.init(
+                parent: 1,
+                role: "AXStaticText",
+                subrole: nil,
+                text: ["Enter the computer account password for the user “other”."],
+                ownerPID: 43))
+        default: Issue.record("Unknown synthetic passkey variant")
+        }
+        #expect(NativeCredentialPromptContext.resolve(nodes, bundleID: Self.helper) == nil)
+    }
+
+    @Test(arguments: [
+        "Enter an administrator's name and password to allow this.",
+        "To allow this, enter the “login” keychain password.",
+        "Enter the computer account password for another user.",
+    ])
+    func `passkey evidence rejects competing or unsupported instructions`(_ instruction: String) throws {
+        var nodes = Self.form()
+        nodes.append(.init(parent: 1, role: "AXStaticText", subrole: nil, text: [instruction], ownerPID: 43))
+        #expect(NativeCredentialPromptContext.resolve(nodes, bundleID: Self.helper) == nil)
+        let valid = try #require(NativeCredentialPromptContext.resolve(Self.form(), bundleID: Self.helper))
+        #expect(try !(Self.binding()).authorizes(
+            hostID: Self.host,
+            bundleID: Self.helper,

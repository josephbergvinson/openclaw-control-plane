+function inspectHostChecks(
+  checks: HostCheck[],
+  starts: { count: number },
+  writes: WriterCall[],
+  workspaceDir: string,
+) {
+  const create = hostOwner.createAgentHarnessHostCapabilities;
+  vi.spyOn(hostOwner, "createAgentHarnessHostCapabilities").mockImplementation((params) => {
+    const host = create(params);
+    const source = host.capabilities.sourcePreservingContext;
+    if (!source) {
+      return host;
+    }
+    return {
+      ...host,
+      capabilities: {
+        ...host.capabilities,
+        createToolSurface(options, bindingOptions) {
+          const tools = host.capabilities.createToolSurface!(options, bindingOptions);
+          for (const tool of tools) {
+            if (tool.name !== "write") {
+              continue;
+            }
+            const execute = tool.execute;
+            // Observe the actual host-created append-only writer. The exact
+            // bound tool, its source guard, path confinement and implementation
+            // remain authoritative; no replacement tool or result is supplied.
+            vi.spyOn(tool, "execute").mockImplementation(async (...args) => {
+              const call: WriterCall = {
+                callId: args[0],
+                path: record(args[1]) ? args[1].path : undefined,
+                succeeded: false,
+              };
+              writes.push(call);
+              const result = await execute(...args);
+              call.succeeded = record(result.details) && result.details.changed === true;
+              return result;
+            });
+          }
+          return tools;
+        },
+        sourcePreservingContext: {
+          ...source,
+          checkRequest(request) {
+            const body = request.finalRequest as RecordValue;
+            expect(Buffer.byteLength(JSON.stringify(body))).toBeLessThanOrEqual(MAX_BODY_BYTES);
+            const check: HostCheck = {
+              sourceId: source.sessionId,
+              pressure: request.estimatedRequestTokens,
+              window: request.usableContextWindow,
+              effects: request.effectsStarted,
+              // Source-preserving turns disable native project docs. The shared
+              // bounded root AGENTS snapshot must reach the developer carrier.
+              policy:
+                Array.isArray(body.input) &&
+                body.input.some(
+                  (item) =>
+                    record(item) &&
+                    item.type === "message" &&
+                    item.role === "developer" &&
+                    Array.isArray(item.content) &&
+                    item.content.some(
+                      (content) =>
+                        record(content) &&
+                        content.type === "input_text" &&
+                        typeof content.text === "string" &&
+                        content.text.includes("## OpenClaw Agent Workspace Instructions\n\n") &&
+                        content.text.includes(
+                          `### ${path.join(workspaceDir, "AGENTS.md")}\n\n${PARENT_POLICY}\nKeep native extraction evidence complete.`,
+                        ),
+                    ),
+                ),
+              refused: false,
+            };
+            checks.push(check);
+            try {
+              source.checkRequest(request);
+            } catch (error) {
+              check.refused =
+                error instanceof Error && error.name === "MemoryExtractionBudgetError";
+              throw error;
+            }
+          },
+          markProviderStarted() {
+            starts.count++;
+            source.markProviderStarted();
+          },
+        },
+      },
+    };
+  });
+}

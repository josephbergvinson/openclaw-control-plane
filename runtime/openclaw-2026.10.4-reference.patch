+import { captureGatewayToolCallerAssertion } from "./gateway-caller-context.js";
+
+/** Select one exact active child on the original human's native conversation route. */
+export function selectCurrentInputChild(params: {
+  runs: Iterable<SubagentRunRecord>;
+  requesterAgentId: string;
+  requesterSessionKey: string;
+  targetAgentId: string;
+  targetSessionKey: string;
+  source: { provider?: string; to?: string; accountId?: string; threadId?: string | number };
+}): SubagentRunRecord | undefined {
+  const same = (a: string | number | undefined, b: string | number | undefined) =>
+    String(a ?? "") === String(b ?? "");
+  const matches = [...params.runs].filter(
+    (entry) =>
+      entry.requesterAgentId === params.requesterAgentId &&
+      entry.requesterSessionKey === params.requesterSessionKey &&
+      entry.execution.status === "running" &&
+      !entry.execution.suppressSessionEffects &&
+      !entry.killIntent &&
+      !entry.killReconciliation &&
+      !entry.collect &&
+      same(entry.progressOrigin?.channel, params.source.provider) &&
+      same(entry.progressOrigin?.to, params.source.to) &&
+      same(entry.progressOrigin?.accountId, params.source.accountId) &&
+      same(entry.progressOrigin?.threadId, params.source.threadId),
+  );
+  return matches.length === 1 &&
+    matches[0]!.childSessionKey === params.targetSessionKey &&
+    matches[0]!.childAgentId === params.targetAgentId
+    ? matches[0]
+    : undefined;
+}
+
+/** Redeem the same original-input owner used by secrets, then use native staging/steering. */
+export async function steerSessionsSendCurrentInput(params: {

+import { createDeferred } from "openclaw/plugin-sdk/extension-shared";
+
+/** Cancellation owns only adapters captured by this read, never a later connection. */
+export type PlaywrightReadGuard = {
+  signal: AbortSignal;
+  capture: (retire: () => void) => void;
+};
+
+export type PlaywrightReadOptions = {
+  timeoutMs?: number;
+  signal?: AbortSignal;
+};
+
+/** Bound read-only dependency work without abandoning a write-capable profile lease. */
+export async function withPlaywrightRead<T>(
+  opts: PlaywrightReadOptions,
+  run: (guard: PlaywrightReadGuard) => Promise<T>,
+): Promise<T> {
+  opts.signal?.throwIfAborted();
+  const controller = new AbortController();
+  const cancelled = createDeferred<never>();
+  const captured = new Set<() => void>();
+  const onCancelled = () => {
+    for (const retire of captured) {
+      retire();
+    }
+    cancelled.reject(controller.signal.reason);
+  };
+  controller.signal.addEventListener("abort", onCancelled, { once: true });
+  const onAbort = () => controller.abort(opts.signal?.reason);
+  opts.signal?.addEventListener("abort", onAbort, { once: true });
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  if (opts.signal?.aborted) {
+    onAbort();
+  }
+  if (typeof opts.timeoutMs === "number" && Number.isFinite(opts.timeoutMs)) {
+    timer = setTimeout(
+      () => controller.abort(new DOMException("Playwright read timed out.", "TimeoutError")),
+      Math.max(1, Math.floor(opts.timeoutMs)),
+    );
+    timer.unref?.();
+  }
+  try {
+    controller.signal.throwIfAborted();
+    return await Promise.race([
+      run({
+        signal: controller.signal,
+        capture: (retire) => {
+          if (controller.signal.aborted) {
+            retire();
+            controller.signal.throwIfAborted();
+          }
+          captured.add(retire);
+        },
+      }),
+      cancelled.promise,
+    ]);
+  } finally {
+    if (timer) {
+      clearTimeout(timer);
+    }
+    opts.signal?.removeEventListener("abort", onAbort);
+    controller.signal.removeEventListener("abort", onCancelled);
+  }
+}

+import { afterEach, describe, expect, it, vi } from "vitest";
+import { getAgentEventLifecycleGeneration } from "../infra/agent-events.js";
+import {
+  prepareAgentCommandExecutionIdentity,
+  sanitizePublicAgentCommandIngressOpts,
+} from "./agent-command-execution-identity.js";
+import type { AgentCommandOpts, AgentCommandRequesterFinalBinding } from "./command/types.js";
+import {
+  consumeRequesterFinalAttachment,
+  promoteRequesterFinalAttachment,
+  transferRequesterFinalAttachment,
+} from "./subagents/requester-final-attachment.js";
+
+const requester = {
+  requesterAgentId: "main",
+  requesterSessionKey: "agent:main:discord:channel:requester-final-proof",
+  requesterSessionId: "compacted-session",
+};
+const batch = { batchRunIds: ["child-a"], rearmGeneration: 1 };
+const admissions: ReturnType<typeof prepareAgentCommandExecutionIdentity>[] = [];
+
+function prepare(binding: AgentCommandRequesterFinalBinding, opts: Partial<AgentCommandOpts> = {}) {
+  const admission = prepareAgentCommandExecutionIdentity({
+    opts: {
+      message: "research this",
+      sessionId: "pre-compaction-session",
+      requesterFinalBinding: binding,
+      ...opts,
+    },
+    prepared: {
+      cfg: { logging: { audit: { enabled: false, executionIdentity: false } } },
+      runId: "voice-requester-run",
+      sessionAgentId: requester.requesterAgentId,
+      sessionId: requester.requesterSessionId,
+      sessionKey: requester.requesterSessionKey,
+      timeoutMs: 60_000,
+    },
+    ingress: { kind: "api", boundary: "agent-command.from-ingress", state: "unknown" },
+    lifecycleGeneration: getAgentEventLifecycleGeneration(),
+  });
+  admissions.push(admission);
+  return admission;
+}
+
+function promote(runId = "voice-requester-run") {
+  return promoteRequesterFinalAttachment({
+    ...requester,
+    ...batch,
+    requesterTurnRunId: runId,
+  });
+}
+
+afterEach(() => {
+  for (const admission of admissions.splice(0)) {
+    admission.close();
+  }
+});
+
+describe("admitted requester final delivery", () => {
+  it("rejects a requester-final binding supplied through public ingress options", () => {
+    const append = vi.fn(() => true);
+    const forged = {
+      message: "untrusted ingress",
+      allowModelOverride: false,
+      requesterFinalBinding: { append },
+    };
+    expect(sanitizePublicAgentCommandIngressOpts(forged).requesterFinalBinding).toBeUndefined();
+    expect(append).not.toHaveBeenCalled();
+  });
+
+  it("uses the actual post-preparation successor session and survives yield until one final", async () => {
+    const append = vi.fn(() => true);
+    const onSettled = vi.fn();
+    const onRegistration = vi.fn();
+    const admission = prepare({ append, onSettled, onRegistration });
+
+    expect(promote()).toBe(false);
+    await admission.admit("embedded");
+    await admission.admit("embedded");
+    expect(onRegistration).toHaveBeenCalledTimes(1);
+    expect(Object.keys(onRegistration.mock.calls[0]?.[0] ?? {})).toEqual(["revoke"]);
+    expect(promote()).toBe(true);
+    await admission.finish();
+    expect(onSettled).not.toHaveBeenCalled();
+
+    expect(
+      consumeRequesterFinalAttachment({
+        ...requester,
+        ...batch,
+        requesterSessionId: "pre-compaction-session",
+        text: "stale",
+      }),
+    ).toBe("missing");
+    expect(
+      transferRequesterFinalAttachment({
+        ...requester,
+        ...batch,
+        requesterTurnRunId: "announce:requester-settle:successor",
+      }),
+    ).toBe(true);
+    expect(consumeRequesterFinalAttachment({ ...requester, ...batch, text: "actual final" })).toBe(
+      "appended",
+    );
+    expect(consumeRequesterFinalAttachment({ ...requester, ...batch, text: "replay" })).toBe(
+      "missing",
+    );
+    expect(append).toHaveBeenCalledExactlyOnceWith("actual final");
+    expect(onSettled).toHaveBeenCalledTimes(1);
+  });
+
+  it.each(["abort", "call-end", "close"])("revokes a promoted owner on %s", async (reason) => {
+    const controller = new AbortController();
+    const append = vi.fn(() => true);
+    const onSettled = vi.fn();
+    let handle: { revoke: () => void } | undefined;
+    const admission = prepare(
+      {
+        append,
+        onSettled,
+        onRegistration: (value) => {
+          handle = value;
+        },
+      },
+      {
+        abortSignal: controller.signal,
+      },
+    );
+    await admission.admit("embedded");
+    expect(promote()).toBe(true);
+    await admission.finish();
+    if (reason === "abort") {
+      controller.abort();
+    } else if (reason === "call-end") {
+      handle?.revoke();
+    } else {
+      admission.close();
+    }
+    expect(consumeRequesterFinalAttachment({ ...requester, ...batch, text: "late" })).toBe(
+      "missing",
+    );
+    expect(append).not.toHaveBeenCalled();
+    expect(onSettled).toHaveBeenCalledTimes(1);
+  });
+
+  it("releases ordinary runs without keeping an attachment or abort listener", async () => {
+    const controller = new AbortController();
+    const remove = vi.spyOn(controller.signal, "removeEventListener");
+    const onSettled = vi.fn();
+    const admission = prepare(
+      { append: () => true, onSettled },
+      { abortSignal: controller.signal },
+    );
+    await admission.admit("embedded");
+    await admission.finish();
+    expect(promote()).toBe(false);
+    expect(onSettled).toHaveBeenCalledTimes(1);
+    expect(remove).toHaveBeenCalledWith("abort", expect.any(Function));
+    controller.abort();
+    expect(onSettled).toHaveBeenCalledTimes(1);
+  });
+
+  it("settles a replaced owner without letting its old handle revoke the replacement", async () => {
+    let oldHandle: { revoke: () => void } | undefined;
+    const oldSettled = vi.fn();
+    const old = prepare({
+      append: () => true,
+      onSettled: oldSettled,
+      onRegistration: (value) => {
+        oldHandle = value;
+      },
+    });
+    await old.admit("embedded");
+    expect(promote()).toBe(true);
+    await old.finish();
+    const append = vi.fn(() => true);
+    const replacement = prepare({ append });
+    await replacement.admit("embedded");
+    expect(oldSettled).toHaveBeenCalledTimes(1);
+    oldHandle?.revoke();
+    expect(promote()).toBe(true);
+    expect(consumeRequesterFinalAttachment({ ...requester, ...batch, text: "replacement" })).toBe(
+      "appended",
+    );
+    expect(append).toHaveBeenCalledExactlyOnceWith("replacement");
+  });
+
+  it("revokes if registration itself fails", async () => {
+    const onSettled = vi.fn();
+    const admission = prepare({
+      append: () => true,
+      onSettled,
+      onRegistration: () => {
+        throw new Error("call retired during registration");
+      },
+    });
+    await expect(admission.admit("embedded")).rejects.toThrow("call retired");
+    expect(promote()).toBe(false);
+    expect(onSettled).toHaveBeenCalledTimes(1);
+  });
+});

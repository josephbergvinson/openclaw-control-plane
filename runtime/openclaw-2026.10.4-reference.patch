+          observations.push("admitted");
+          if (order === "admission-first") {
+            expect(started).not.toHaveBeenCalled();
+            await opts.onExecutionStarted?.();
+          }
+          expect(entry.executionStarted).toBe(true);
+          expect(started).toHaveBeenCalledOnce();
+          await admission.admit("embedded");
+          await opts.onExecutionStarted?.();
+          expect(started).toHaveBeenCalledOnce();
+          expect(saved).not.toHaveBeenCalled();
+          await opts.beforeTerminalDelivery?.();
+          expect(saved).toHaveBeenCalledOnce();
+          return { payloads: [], meta: {} };
+        } finally {
+          admission.close();
+        }
+      });
+      const actualDispatch =
+        await vi.importActual<typeof import("./agent-run-dispatch.js")>("./agent-run-dispatch.js");
+      dispatchAgentRunFromGateway.mockImplementationOnce(
+        actualDispatch.dispatchAgentRunFromGateway,
+      );
+
+      await startAgentRunExecution(execution.params);
+
+      expect(execution.params.io.emitFinal).toHaveBeenCalledWith(
+        [true, expect.objectContaining({ status: "ok" }), undefined],
+        expect.anything(),
+      );
+      expect(started).toHaveBeenCalledOnce();
+      expect(saved).toHaveBeenCalledOnce();
+      expect(observations).toEqual(
+        order === "runner-first"
+          ? ["runner-entered", "started", "admitted"]
+          : ["admitted", "started"],
+      );
+    },
+  );
+
+  it.each([false, true])(
+    "joins real command finalization after a child finishes before requester yield (captured operator: %s)",
+    async (withOperator) => {
+      await runComposedRequesterFinalization({
+        withOperator,
+        createStartExecution,
+        agentCommand: (run) => {
+          agentCommand.mockImplementationOnce(run);
+        },
+        dispatchAgentRunFromGateway: (run) => {
+          dispatchAgentRunFromGateway.mockImplementationOnce(run);
+        },
+      });
+    },
+  );
+
+  it("delivers the composed synthesis through native final custody before settling its child", async () => {
+    await withAdminIngress(async ({ state, cfg, admins, context }) => {
+      const sessionKey = "agent:main:requester-synthesis";
+      const target = {
+        agentId: "main",
+        sessionKey,
+        storePath: path.join(state.sessionsDir(), "sessions.json"),
+      };
+      const sessionEntry = {
+        sessionId: "requester-synthesis",
+        lifecycleRevision: "fixture-revision",
+        status: "running" as const,
+        updatedAt: Date.now(),
+      };
+      await replaceSessionEntry(target, sessionEntry);
+      const assertSourceCurrent = expectDefined(
+        captureCommandOwnerAssertion(await context(admins[0]!.identity.senderId)),
+        "requester synthesis owner assertion",
+      );
+      const writes: string[] = [];
+      const plugin: ChannelPlugin = {
+        ...createOutboundTestPlugin({
+          id: "matrix",
+          outbound: {
+            deliveryMode: "direct",
+            sendText: async () => {
+              throw new Error("recording message adapter owns the send");
+            },
+          },
+        }),
+        message: {
+          id: "matrix",
+          durableFinal: { capabilities: { text: true } },
+          send: {
+            text: async ({ text, onPlatformSendDispatch, assertDirectAdapterHandoff }) => {
+              await onPlatformSendDispatch?.();
+              assertDirectAdapterHandoff?.();
+              expect(getAsyncWorkSignal()?.aborted).toBe(false);
+              expect(
+                loadExactSessionEntry({ ...target, readConsistency: "latest" })?.entry
+                  .pendingFinalDelivery?.intentId,
+              ).toBeTruthy();
+              writes.push(text);
+              return {
+                messageId: "recorded-synthesis-final",
+                receipt: createMessageReceiptFromOutboundResults({
+                  results: [{ channel: "matrix", messageId: "recorded-synthesis-final" }],
+                  kind: "text",
+                }),
+              };
+            },
+          },
+        },
+      };
+      setActivePluginRegistry(createTestRegistry([{ pluginId: "matrix", source: "test", plugin }]));
+      try {
+        await runComposedRequesterFinalization({
+          withOperator: true,
+          createStartExecution,
+          agentCommand: (run) => {
+            agentCommand.mockImplementationOnce(run);
+          },
+          dispatchAgentRunFromGateway: (run) => {
+            dispatchAgentRunFromGateway.mockImplementationOnce(run);
+          },
+          delivery: {
+            cfg,
+            sessionEntry,
+            storePath: target.storePath,
+            workspaceDir: state.workspaceDir,
+            agentDir: state.agentDir(),
+            assertSourceCurrent,
+            afterCommand: async (child) => {
+              expect(writes).toEqual([

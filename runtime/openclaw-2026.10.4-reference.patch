+import { createHash } from "node:crypto";
+import { constants as fsConstants } from "node:fs";
+import fs from "node:fs/promises";
+import path from "node:path";
+import { z } from "zod";
+import { isPathInside } from "./path-guards.js";
+import { resolveUpdateCandidateStatePath } from "./update-candidate-paths.js";
+
+const NativeProjectionIdentitySchema = z.object({
+  device: z.number().int().safe(),
+  inode: z.number().int().safe(),
+  ownerUid: z.number().int().safe(),
+});
+const NativeProjectionEntrySchema = z.object({
+  relativePath: z.string(),
+  kind: z.enum(["directory", "file"]),
+  identity: NativeProjectionIdentitySchema,
+  mode: z.number().int().min(0).max(0o7777),
+  bytes: z.number().int().safe().nonnegative(),
+  mtimeMs: z.number().finite(),
+  ctimeMs: z.number().finite(),
+  sha256: z
+    .string()
+    .regex(/^[a-f0-9]{64}$/)
+    .optional(),
+});
+export const NativeCodexProjectionSchema = z.object({
+  schemaVersion: z.literal(1),
+  // This is invocation data from the existing stopped snapshot owner, not an
+  // account/config registry or authority to stop the user's Desktop process.
+  baselineSnapshot: z.object({ path: z.string(), sha256: z.string().regex(/^[a-f0-9]{64}$/) }),
+  // The same stopped owner supplies this complete set; it is not discovered here.
+  expectedHomeIds: z.array(z.string().min(1)).min(1),
+  roots: z
+    .array(z.object({ path: z.string(), entries: z.array(NativeProjectionEntrySchema).min(1) }))
+    .min(1),
+  homes: z
+    .array(
+      z.object({
+        id: z.string().min(1),
+        codexHome: z.string(),
+        sqliteHome: z.string(),
+        providerLabel: z.string(),
+        familyPresence: z.record(z.string(), z.boolean()),
+      }),
+    )
+    .min(1),
+});
+export type NativeCodexProjection = z.infer<typeof NativeCodexProjectionSchema>;
+export type NativeCodexProjectionHome = NativeCodexProjection["homes"][number];
+
+function nativeCodexArg0Directory(home: Pick<NativeCodexProjectionHome, "codexHome">) {
+  return path.join(home.codexHome, "tmp", "arg0");
+}
+
+/** Native arg0 owns per-process executable aliases here; project only the physical container. */
+function isNativeCodexTransientArg0Directory(
+  source: string,
+  homes: readonly Pick<NativeCodexProjectionHome, "codexHome">[],
+): boolean {
+  return homes.some((home) => source === nativeCodexArg0Directory(home));
+}
+const NATIVE_CODEX_SQLITE_FAMILIES = [
+  "state_5.sqlite",
+  "logs_2.sqlite",
+  "goals_1.sqlite",
+  "memories_1.sqlite",
+  "memories_v2_1.sqlite",
+  "queue_1.sqlite",
+  "thread_history_1.sqlite",
+] as const;
+
+function nativeProjectionIdentity(info: import("node:fs").Stats) {
+  return { device: info.dev, inode: info.ino, ownerUid: info.uid };
+}
+
+export async function validateNativeCodexProjection(
+  value: NativeCodexProjection | undefined,
+  targetStateDir: string,
+) {
+  if (!value) {
+    return undefined;
+  }
+  const projection = NativeCodexProjectionSchema.parse(value);
+  const targetRoot = path.resolve(targetStateDir);
+  if (
+    targetRoot !== targetStateDir ||
+    (await fs.realpath(targetRoot)) !== targetRoot ||
+    projection.roots.some(
+      (root) => isPathInside(root.path, targetRoot) || isPathInside(targetRoot, root.path),
+    )
+  ) {

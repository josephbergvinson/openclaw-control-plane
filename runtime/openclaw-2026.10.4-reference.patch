index 0000000000000000000000000000000000000000..e94185bf2584306f57d2c687e6c27513de890a57
--- /dev/null
+++ b/extensions/browser/src/browser/extension-relay/relay-cdp-presentation.ts
@@ -0,0 +1,72 @@
+import type { RelayTabInfo } from "./relay-protocol.js";
+
+type RelayTargetProjection = {
+  info: RelayTabInfo;
+  target?: { id: string; sessionId?: string };
+};
+
+/** Playwright requires every attached page target to identify its browser context. */
+const BROWSER_CONTEXT_ID = "openclaw-extension-context";
+
+// Diagnostics retain known categories, never native error strings, URLs, values,
+// parameters, document ids or child session ids. They grant no attach authority.
+export function nativeFailureCategory(error: unknown): string {
+  const message = error instanceof Error ? error.message : "";
+  return (
+    (
+      [
+        ["chrome-extension:// URL of different extension", "native-extension-url-denied"],
+        ["chrome:// URL", "native-internal-url-denied"],
+        ["Cannot access contents of url", "native-document-url-denied"],
+        ["extensions gallery cannot be scripted", "native-gallery-denied"],
+        ["Another debugger is already attached", "native-debugger-in-use"],
+        ["Host access is restricted by policy", "native-host-policy-denied"],
+        ["Cannot attach to this target", "native-target-denied"],
+        ["Not allowed", "native-command-denied"],
+        ["native target identity", "native-identity-unavailable"],
+        ["Debugger target identity unavailable", "native-identity-unavailable"],
+        ["extension relay command timed out", "extension-command-timeout"],
+        ["cleanup incomplete", "native-cleanup-incomplete"],
+      ] as const
+    ).find(([fragment]) => message.includes(fragment))?.[1] ?? "native-rejection"
+  );
+}
+
+export function toErrorPayload(
+  id: number | null,
+  sessionId: string | undefined,
+  message: string,
+  code = -32000,
+): string {
+  return JSON.stringify({ id, ...(sessionId ? { sessionId } : {}), error: { code, message } });
+}
+
+export function targetInfoForTab(
+  tab: RelayTargetProjection,
+  targetId: string,
+): Record<string, unknown> {
+  return {
+    targetId,
+    type: "page",
+    title: tab.info.title,
+    url: tab.info.url,
+    // connectOverCDP owns this as a persistent default context, but still
+    // asserts that attached page events carry a non-empty context id.
+    browserContextId: BROWSER_CONTEXT_ID,
+    attached: Boolean(tab.target?.sessionId),
+    canAccessOpener: false,
+  };
+}
+
+export function toDevtoolsTargetDescriptor(
+  tab: RelayTargetProjection,
+): RelayTabInfo & { id: string; type: string } {
+  return {
+    tabId: tab.info.tabId,
+    url: tab.info.url,
+    title: tab.info.title,
+    active: tab.info.active,
+    id: tab.target?.id ?? `tab-${tab.info.tabId}`,
+    type: "page",
+  };
+}

+/** Preserve received MCP output before the shared persistence/context cap can truncate it. */
+export async function preserveMcpToolOutput(
+  result: AgentToolResult<unknown>,
+  options: {
+    workspaceDir: string;
+    assertCurrent: () => void;
+    loggingConfig?: OpenClawConfig["logging"];
+    budget?: ToolResultBudget;
+  },
+): Promise<AgentToolResult<unknown>> {
+  const text = result.content
+    .flatMap((block) => (block.type === "text" ? [block.text] : []))
+    .join("\n");
+  // Only the prepared native budget can establish that no preservation is needed.
+  // An unavailable budget never implies that the downstream cap is large enough.
+  if (options.budget && toolResultFitsBudget(text, options.budget)) {
+    return result;
+  }
+  const [
+    { isAbsolute, relative },
+    { removePathWithinRoot },
+    { writePrivateTempFile },
+    { formatFullOutputFooter },
+    { redactToolPayloadTextWithConfig },
+    { wrapExternalContent },
+  ] = await Promise.all([
+    import("node:path"),
+    import("../infra/fs-safe-remove.js"),
+    import("./sessions/tools/private-temp-file.js"),
+    import("./sessions/tools/tool-contracts.js"),
+    import("../logging/redact.js"),
+    import("../security/external-content.js"),
+  ]);
+  options.assertCurrent();
+  if (!options.workspaceDir || !isAbsolute(options.workspaceDir)) {
+    throw new Error("Oversized MCP output requires the admitted absolute workspace.");
+  }
+  const value = toToolSearchJsonSafe(
+    mcpCodeModeGuestResults.get(result) ?? { content: result.content },
+  );
+  if (isRecord(value)) {
+    delete value._meta;
+  }
+  const json = redactToolPayloadTextWithConfig(
+    JSON.stringify(
+      value,
+      (_key, child: unknown) =>
+        typeof child === "string"
+          ? redactToolPayloadTextWithConfig(child, options.loggingConfig)
+          : child,
+      2,
+    ),
+    options.loggingConfig,
+  );
+  const content = wrapExternalContent(json, { source: "api" });
+  let outputPath: string | undefined;
+  try {
+    outputPath = await writePrivateTempFile("openclaw-mcp-output", content, {
+      rootDir: options.workspaceDir,
+      assertBeforeMutation: options.assertCurrent,
+    });
+    options.assertCurrent();
+    const preserved: AgentToolResult<unknown> = {
+      ...result,
+      content: [
+        ...result.content,
+        {
+          type: "text",
+          text: `${formatFullOutputFooter(outputPath)}\nRead with offset/limit or cursor to continue. This is the received MCP snapshot; source coverage limits still apply.`,
+        },
+      ],
+      details: {
+        ...(isRecord(result.details) ? result.details : {}),
+        fullOutputPath: outputPath,
+        spilledChars: content.length,
+        spillTruncated: false,
+      },
+    };
+    return transferMcpCodeModeGuestResult(result, preserved);
+  } catch (error) {
+    if (outputPath) {
+      await removePathWithinRoot({
+        rootDir: options.workspaceDir,
+        relativePath: relative(options.workspaceDir, outputPath),
+        force: true,
+      });
+    }
+    throw error;
+  }
+}

-      await progress.publish(text);
-    } catch {
-      // A missing, replaced, or uncertain card cannot authorize a POST or replay
-      // the already-consumed model input. The original child wake still owns final delivery.
-      return delivery;
-    }
-  }
-  return delivery;
-}

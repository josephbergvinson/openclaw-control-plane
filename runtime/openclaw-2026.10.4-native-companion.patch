-/** The native pause owner may borrow its existing card, never the cohort's final. */
-export type RequesterPausePresentation = { progress?: RequesterProgressPublication };
-
-/** Keep synthesis presentation and its final producer on the same native handoff. */
-export function prepareRequesterSynthesisStart(params: {
-  prepare: RequesterSettleWakeBatchCallbacks["prepareSynthesisProgress"];
-  pause: boolean;
-  parentOnly: boolean;
-  progressOperationId?: string;
-  requesterSessionKey: string;
-  requesterSessionId: string;
-  requesterAgentId?: string;
-  runId: string;
-  batchRunIds: readonly string[];
-  isCurrent: () => boolean;
-  resolveGatewayContext?: GatewayContextResolver;
-}): (() => void) | undefined {
-  const progress =
-    !params.pause && (params.parentOnly || params.progressOperationId)
-      ? params.prepare?.({
-          requesterSessionKey: params.requesterSessionKey,
-          requesterSessionId: params.requesterSessionId,
-          requesterAgentId: params.requesterAgentId,
-          runId: params.runId,
-          batchRunIds: params.batchRunIds,
-          isCurrent: params.isCurrent,
-        })
-      : undefined;
-  return progress
-    ? () => {
-        progress.start();
-        const beforeFinalDelivery = progress.beforeFinalDelivery;
-        if (!beforeFinalDelivery) {
-          return;
-        }
-        const producer = params
-          .resolveGatewayContext?.()
-          ?.chatAbortControllers.get(params.runId)
-          ?.resolveTerminalProducer?.();
-        if (
-          !producer ||
-          producer.sessionId !== params.requesterSessionId ||
-          producer.sessionKey !== params.requesterSessionKey ||
-          !producer.handoff(async (producerCompleted) => {
-            // The producer invokes its factory eagerly; seal only at final delivery.
-            await producerCompleted;
-            await beforeFinalDelivery();
-          })
-        ) {
-          throw new Error("Requester synthesis lost its canonical final producer");
-        }
-      }
-    : undefined;
-}
-
-function checkpointText(response: unknown): string | undefined {
-  const result = getGatewayAgentResult(response);
-  if (
-    !result ||
-    result.meta?.error ||
-    result.meta?.aborted ||
-    result.meta?.yielded ||
-    result.meta?.continuationPending ||
-    normalizeAgentRunTerminalReplySnapshot(result.meta?.terminalReply)?.disposition !== "visible" ||
-    result.didSendDeterministicApprovalPrompt === true ||
-    hasCompletedSourceReplyDeliveryEvidence(result) ||
-    hasMessagingToolDeliveryEvidence(result) ||
-    !Array.isArray(result.payloads) ||
-    result.payloads.length !== 1 ||
-    !hasVisibleAgentPayload(result, {
-      includeErrorPayloads: false,
-      includeReasoningPayloads: false,
-      includeSilentReplyPayloads: false,
-      requireTerminalContent: true,
-    })
-  ) {
-    return undefined;
-  }
-  const payload = asOptionalRecord(result.payloads[0]);
-  if (
-    !payload ||
-    typeof payload.text !== "string" ||
-    payload.audioAsVoice ||
-    payload.presentation ||
-    payload.interactive ||
-    payload.channelData ||
-    payload.location ||
-    payload.delivery
-  ) {
-    return undefined;
-  }
-  const media = new Set<string>();
-  collectMediaUrlsFromRecord(payload, media);
-  return media.size ? undefined : sanitizeAgentRunTerminalReplyText(payload.text) || undefined;
-}
-
-/** Consume the exact successful input even when its optional card edit is withheld. */
-export async function settleRequesterPausePresentation(params: {
-  response: unknown;
-  presentation: RequesterPausePresentation;
-  parentOnly: boolean;
-}) {
-  const delivery = resolvePrivateCompletionDeliveryResult(asOptionalRecord(params.response));
-  const progress = !params.parentOnly && delivery.delivered && params.presentation.progress;

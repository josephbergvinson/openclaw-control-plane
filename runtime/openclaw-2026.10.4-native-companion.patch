@@ -0,0 +1,217 @@
+import ConcurrencyExtras
+import Foundation
+import Testing
+@testable import OpenClaw
+@testable import OpenClawKit
+
+@MainActor
+struct DashboardLocalCredentialTests {
+    @Test(arguments: ["token", "password"])
+    func `primary dashboard uses resolved endpoint instead of stale local config`(_ kind: String) async throws {
+        try await self.withGateway(kind: kind, mode: "local") { _ in
+            #expect(DashboardManager.immediateDashboardEndpoint(mode: .local) == nil)
+            let source = GatewayEndpointStore.SourceSnapshot(
+                routingGeneration: nil,
+                mode: .local,
+                token: kind == "token" ? "resolved-token" : nil,
+                password: kind == "password" ? "resolved-password" : nil,
+                deviceAuthGatewayID: "resolved-local-gateway",
+                localPort: 18789,
+                localHost: "127.0.0.1",
+                scheme: "ws",
+                bindMode: "loopback",
+                remoteTransport: .ssh,
+                directRemoteURL: nil,
+                remoteTLSFingerprint: nil,
+                sshRouteIdentity: nil)
+            let store = GatewayEndpointStore(deps: .init(
+                token: { "stale-token" },
+                password: { "stale-password" },
+                localPort: { 18789 },
+                localUnavailableReason: { nil },
+                remoteRouteIfRunning: { nil },
+                remoteRouteIsCurrent: { _ in false },
+                canStartRemoteTunnel: { false },
+                ensureRemoteTunnel: { throw CancellationError() },
+                liveSourceIsCurrent: { _ in true },
+                sourceSnapshot: { source }))
+            // Exercise the production selector, not DashboardManager's test endpoint override.
+            let endpoint = try await DashboardManager.resolvePrimaryEndpoint(mode: .local, endpointStore: store)
+            let nativeEndpoint = try await store.requireEndpoint()
+            #expect(endpoint.config.token == source.token)
+            #expect(endpoint.config.password == source.password)
+            #expect(endpoint.deviceAuthGatewayID == nativeEndpoint.deviceAuthGatewayID)
+            #expect(endpoint.revision == nativeEndpoint.revision)
+        }
+    }
+
+    @Test(arguments: ["literal-token", "${DASHBOARD_TEST_AUTH}"])
+    func `literal and environment local auth retain synchronous preload`(_ token: String) async throws {
+        try await self.withGateway(kind: "token", mode: "local", literal: token, staleAmbient: false) { _ in
+            let endpoint = try #require(DashboardManager.immediateDashboardEndpoint(mode: .local))
+            #expect(endpoint.config.token == (token == "literal-token" ? token : "environment-token"))
+            #expect(endpoint.config.password == nil)
+            #expect(endpoint.config.url.port == 18789)
+        }
+    }
+
+    @Test(arguments: ["token", "password"])
+    func `auxiliary local endpoint resolves its reference without borrowing remote or ambient credentials`(
+        _ kind: String) async throws
+    {
+        try await self.withGateway(kind: kind, mode: "remote") { _ in
+            let endpoint = try await GatewayEndpointStore.resolvedLocalEndpoint(
+                hostingBesideRemotePrimary: true,
+                resolveCredentials: { request, ownerKey, env in
+                    let payload = try #require(try JSONSerialization.jsonObject(with: request) as? [String: Any])
+                    let auth = try #require(payload["auth"] as? [String: Any])
+                    #expect((auth[kind] as? [String: String])?["id"] == "LOCAL_AUTH")
+                    let owner = try #require(try JSONSerialization.jsonObject(with: ownerKey) as? [String: Any])
+                    #expect((owner["gateway"] as? [String: Any])?["mode"] as? String == "remote")
+                    #expect(env["OPENCLAW_GATEWAY_TOKEN"] == "stale-token")
+                    #expect(env["OPENCLAW_GATEWAY_PASSWORD"] == "stale-password")
+                    return .init(
+                        version: 1,
+                        token: kind == "token" ? "resolved-token" : nil,
+                        password: kind == "password" ? "resolved-password" : nil)
+                })
+            #expect(endpoint.config.url.port == 18789)
+            #expect(endpoint.config.token == (kind == "token" ? "resolved-token" : nil))
+            #expect(endpoint.config.password == (kind == "password" ? "resolved-password" : nil))
+        }
+    }
+
+    @Test func `auxiliary local credentials cannot publish after config changes during resolution`() async throws {
+        try await self.withGateway(kind: "token", mode: "remote") { configPath in
+            await #expect(throws: CancellationError.self) {
+                try await GatewayEndpointStore.resolvedLocalEndpoint(
+                    hostingBesideRemotePrimary: true,
+                    resolveCredentials: { _, _, _ in
+                        try Data(#"{"gateway":{"mode":"local","auth":{"mode":"none"}}}"#.utf8)
+                            .write(to: URL(fileURLWithPath: configPath))
+                        return .init(version: 1, token: "retired-token", password: nil)
+                    })
+            }
+        }
+    }
+
+    @Test(arguments: ["disconnect", "shutdown"])
+    func `auxiliary local connection refreshes unchanged references after retirement`(
+        _ retirement: String) async throws
+    {
+        try await self.withGateway(kind: "token", mode: "remote") { _ in
+            let cache = GatewayLocalAuthResolver.ConnectionCache()
+            let resolutions = LockIsolated(0)
+            let resolve: @Sendable () async throws -> GatewayConnection.EndpointSnapshot = {
+                try await GatewayEndpointStore.resolvedLocalEndpoint(
+                    hostingBesideRemotePrimary: true,
+                    invalidateCredentials: { cache.invalidate(ownerKey: $0) },
+                    resolveCredentials: { _, key, _ in
+                        try await cache.resolve(key: key) {
+                            let revision = resolutions.withValue { $0 += 1
+                                return $0
+                            }
+                            return .init(version: 1, token: "resolved-\(revision)", password: nil)
+                        }
+                    })
+            }
+            let connection = GatewayConnection(
+                testEndpointProvider: resolve,
+                sessionBox: WebSocketSessionBox(session: self.successfulSession()))
+            let remote = try DashboardIdentityFixture(announcement: nil)
+            do {
+                // refresh configures a channel; a health request completes its fake-socket handshake.
+                _ = try await connection.requestRaw(method: .health)
+                #expect(try await resolve().config.token == "resolved-1")
+                _ = try await remote.connection.requestRaw(method: .health)
+                let remoteSocket = try #require(await remote.connection._test_activeSocketGeneration())
+                await remote.connection._test_handleDisconnect(socketGeneration: remoteSocket)
+                await remote.connection.shutdown()
+                #expect(try await resolve().config.token == "resolved-1")
+                #expect(resolutions.value == 1)
+
+                let originalRoute = await connection._test_routeGeneration()
+                let originalSocket = try #require(await connection._test_activeSocketGeneration())
+                if retirement == "disconnect" {
+                    await connection._test_handleDisconnect(socketGeneration: originalSocket)
+                } else {
+                    await connection.shutdown()
+                }
+                _ = try await connection.requestRaw(method: .health)
+                await connection._test_handleDisconnect(
+                    routeGeneration: originalRoute, socketGeneration: originalSocket)
+                #expect(try await resolve().config.token == "resolved-2")
+                #expect(resolutions.value == 2)
+                await connection.shutdown()
+            } catch {
+                await connection.shutdown()
+                await remote.connection.shutdown()
+                throw error
+            }
+        }
+    }
+
+    @Test func `retired local credential owner cannot invalidate a replacement config`() async throws {
+        let cache = GatewayLocalAuthResolver.ConnectionCache()
+        _ = try await cache.resolve(key: Data([1])) { .init(version: 1, token: "retired", password: nil) }
+        _ = try await cache.resolve(key: Data([2])) { .init(version: 1, token: "current", password: nil) }
+        cache.invalidate(ownerKey: Data([1]))
+        let current = try await cache.resolve(key: Data([2])) {
+            Issue.record("Retired owner invalidated its replacement")
+            return .init(version: 1, token: "unexpected", password: nil)
+        }
+        #expect(current.token == "current")
+    }
+
+    private func successfulSession() -> GatewayTestWebSocketSession {
+        GatewayTestWebSocketSession(taskFactory: {
+            GatewayTestWebSocketTask(sendHook: { socket, message, index in
+                guard index > 0, let id = GatewayWebSocketTestSupport.requestID(from: message) else { return }
+                socket.emitReceiveSuccess(.data(GatewayWebSocketTestSupport.okResponseData(id: id)))
+            }, receiveHook: { socket, index in
+                if index == 0 { return .data(GatewayWebSocketTestSupport.connectChallengeData()) }
+                return .data(GatewayWebSocketTestSupport
+                    .connectOkData(id: socket.snapshotConnectRequestID() ?? "connect"))
+            })
+        })
+    }
+
+    private func withGateway(
+        kind: String,
+        mode: String,
+        literal: String? = nil,
+        staleAmbient: Bool = true,
+        _ body: (String) async throws -> Void) async throws
+    {
+        let temporaryRoot = try #require(ProcessInfo.processInfo.environment["TMPDIR"])
+        let directory = URL(fileURLWithPath: temporaryRoot, isDirectory: true)
+            .appendingPathComponent(UUID().uuidString, isDirectory: true)
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        defer { try? FileManager.default.removeItem(at: directory) }
+        let config = directory.appendingPathComponent("openclaw.json")
+        let credential: Any = literal.map { $0 as Any } ??
+            ["source": "store", "provider": "default", "id": "LOCAL_AUTH"]
+        let root: [String: Any] = ["gateway": [
+            "mode": mode,
+            "port": 18789,
+            "bind": "loopback",
+            "auth": ["mode": kind, kind: credential],
+            "remote": ["url": "ws://127.0.0.1:18889", "token": "remote-only-token"],
+        ]]
+        try JSONSerialization.data(withJSONObject: root).write(to: config)
+        try await TestIsolation.withIsolatedState(
+            launchAgentHomeDirectory: directory,
+            env: [
+                "OPENCLAW_CONFIG_PATH": config.path,
+                "OPENCLAW_STATE_DIR": directory.appendingPathComponent("state", isDirectory: true).path,
+                "OPENCLAW_GATEWAY_TOKEN": staleAmbient ? "stale-token" : nil,
+                "OPENCLAW_GATEWAY_PASSWORD": staleAmbient ? "stale-password" : nil,
+                "DASHBOARD_TEST_AUTH": "environment-token",
+                "OPENCLAW_GATEWAY_PORT": nil,
+            ],
+            defaults: [connectionModeKey: mode, "gatewayPort": nil])
+        {
+            try await body(config.path)
+        }
+    }
+}

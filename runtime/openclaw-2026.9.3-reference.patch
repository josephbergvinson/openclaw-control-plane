@@ -0,0 +1,406 @@
+import type { ElementHandle, Frame, Page } from "playwright-core";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { configureBrowserCredentialBindings } from "../browser-credential-config.js";
+import { executeBrowserTypeSecret } from "../browser-credential-fill.js";
+import { resetBrowserCredentialBindingsForTests } from "../browser-credential.test-support.js";
+
+const runtimeMocks = vi.hoisted(() => ({
+  traceActive: false,
+  navigation: vi.fn(),
+  getPage: vi.fn(),
+  resolveElement: vi.fn(),
+  resolveSecret: vi.fn(),
+}));
+
+vi.mock("./pw-session.js", () => ({
+  ensureContextState: () => ({ traceActive: runtimeMocks.traceActive }),
+  refLocator: (page: Page, ref: string) => ({
+    elementHandle: ({ timeout }: { timeout: number }) =>
+      runtimeMocks.resolveElement(page, ref, timeout),
+  }),
+}));
+vi.mock("./pw-tools-core.interactions.navigation.js", () => ({
+  awaitNavigationGuardedInteraction: runtimeMocks.navigation,
+  getRestoredPageForTarget: runtimeMocks.getPage,
+}));
+vi.mock("../browser-credential-secret.runtime.js", () => ({
+  resolveBrowserCredentialSecret: runtimeMocks.resolveSecret,
+}));
+
+const CDP_URL = "http://127.0.0.1:18800";
+const ORIGIN = "https://auth.example.test";
+const SENTINEL = "opaque-sentinel-must-not-escape";
+const REQUEST = {
+  kind: "typeSecret" as const,
+  alias: "account",
+  ref: "e17",
+  targetId: "tab-1",
+  submit: true as const,
+};
+
+type ElementMetadata = {
+  connected: boolean;
+  origin: string | null;
+  role: string;
+  tagName: string;
+  type: string;
+};
+
+type HarnessOptions = {
+  pageUrl?: string;
+  passwordMetadata?: Partial<ElementMetadata>;
+  submitMetadata?: Partial<ElementMetadata>;
+  fillError?: Error;
+  pressError?: Error;
+  clickError?: Error;
+  clearError?: Error;
+  resolutionError?: Error;
+};
+
+function configureBinding() {
+  configureBrowserCredentialBindings({
+    credentialBindings: {
+      account: {
+        secret: { source: "exec", provider: "test-provider", id: "test-secret-id" },
+        allowedOrigins: [ORIGIN],
+      },
+    },
+  });
+}
+
+function createCredentialHarness(options: HarnessOptions = {}) {
+  let pageUrl = options.pageUrl ?? `${ORIGIN}/login`;
+  let closed = false;
+  let passwordValue = "";
+  let passwordMetadata: ElementMetadata = {
+    connected: true,
+    origin: ORIGIN,
+    role: "",
+    tagName: "input",
+    type: "password",
+    ...options.passwordMetadata,
+  };
+  let submitMetadata: ElementMetadata = {
+    connected: true,
+    origin: ORIGIN,
+    role: "",
+    tagName: "button",
+    type: "submit",
+    ...options.submitMetadata,
+  };
+  const ownerFrame = {} as Frame;
+  let passwordFrame = ownerFrame;
+  let submitFrame = ownerFrame;
+
+  const passwordFill = vi.fn(async (value: string) => {
+    if (value === "") {
+      if (options.clearError) {
+        throw options.clearError;
+      }
+      passwordValue = "";
+      return;
+    }
+    passwordValue = value;
+    if (options.fillError) {
+      throw options.fillError;
+    }
+  });
+  const passwordPress = vi.fn(async () => {
+    if (options.pressError) {
+      throw options.pressError;
+    }
+  });
+  const passwordDispose = vi.fn(async () => {});
+  const passwordElement = {
+    evaluate: vi.fn(async () => passwordMetadata),
+    fill: passwordFill,
+    press: passwordPress,
+    ownerFrame: vi.fn(async () => passwordFrame),
+    dispose: passwordDispose,
+  } as unknown as ElementHandle<HTMLInputElement>;
+
+  const submitObservedValues: string[] = [];
+  const submitClick = vi.fn(async () => {
+    submitObservedValues.push(passwordValue);
+    if (options.clickError) {
+      throw options.clickError;
+    }
+  });
+  const submitDispose = vi.fn(async () => {});
+  const submitElement = {
+    evaluate: vi.fn(async () => submitMetadata),
+    click: submitClick,
+    ownerFrame: vi.fn(async () => submitFrame),
+    dispose: submitDispose,
+  } as unknown as ElementHandle<HTMLElement | SVGElement>;
+
+  const close = vi.fn(async () => {
+    closed = true;
+  });
+  const page = {
+    context: () => ({}),
+    url: () => pageUrl,
+    isClosed: () => closed,
+    close,
+  } as unknown as Page;
+  const getPage = vi.fn(async () => page);
+  const resolveElement = vi.fn(async (_page: Page, ref: string) => {
+    if (ref === "e17") {
+      return passwordElement;
+    }
+    if (ref === "e22") {
+      return submitElement;
+    }
+    return null;
+  });
+  const resolutionError = options.resolutionError;
+  const resolveSecret = resolutionError
+    ? vi.fn(async () => {
+        throw resolutionError;
+      })
+    : vi.fn(async () => SENTINEL);
+
+  return {
+    close,
+    getPage,
+    page,
+    passwordDispose,
+    passwordFill,
+    passwordPress,
+    resolveElement,
+    resolveSecret,
+    submitClick,
+    submitDispose,
+    submitObservedValues,
+    setPageUrl(value: string) {
+      pageUrl = value;
+    },
+    setPasswordFrame(value: Frame) {
+      passwordFrame = value;
+    },
+    setPasswordOrigin(value: string) {
+      passwordMetadata = { ...passwordMetadata, origin: value };
+    },
+    setSubmitFrame(value: Frame) {
+      submitFrame = value;
+    },
+    setSubmitOrigin(value: string) {
+      submitMetadata = { ...submitMetadata, origin: value };
+    },
+  };
+}
+
+type CredentialHarness = ReturnType<typeof createCredentialHarness>;
+
+async function runSecureFill(
+  harness: CredentialHarness,
+  request: typeof REQUEST & { submitRef?: string } = REQUEST,
+) {
+  runtimeMocks.getPage.mockImplementation(harness.getPage);
+  runtimeMocks.resolveElement.mockImplementation(harness.resolveElement);
+  runtimeMocks.resolveSecret.mockImplementation(harness.resolveSecret);
+  return await executeBrowserTypeSecret({
+    request,
+    cdpUrl: CDP_URL,
+    targetId: "tab-1",
+  });
+}
+
+async function readSecureFillError(
+  harness: CredentialHarness,
+  request: typeof REQUEST & { submitRef?: string } = REQUEST,
+): Promise<string> {
+  try {
+    await runSecureFill(harness, request);
+    return "";
+  } catch (error) {
+    return String(error);
+  }
+}
+
+describe("browser credential native fill", () => {
+  beforeEach(() => {
+    resetBrowserCredentialBindingsForTests();
+    runtimeMocks.traceActive = false;
+    runtimeMocks.navigation
+      .mockReset()
+      .mockImplementation(
+        async (params: { action: () => Promise<unknown> }) => await params.action(),
+      );
+    configureBinding();
+  });
+
+  it("fills and submits with Enter without post-success cleanup", async () => {
+    const harness = createCredentialHarness();
+
+    const result = await runSecureFill(harness);
+
+    expect(result).toEqual({ ok: true, targetId: "tab-1", origin: ORIGIN });
+    expect(harness.passwordFill).toHaveBeenCalledOnce();
+    expect(harness.passwordFill).toHaveBeenCalledWith(SENTINEL, expect.any(Object));
+    expect(harness.passwordPress).toHaveBeenCalledWith("Enter", expect.any(Object));
+    expect(harness.passwordDispose).toHaveBeenCalledOnce();
+    expect(harness.close).not.toHaveBeenCalled();
+    expect(JSON.stringify(result)).not.toContain(SENTINEL);
+  });
+
+  it("resolves submitRef before the secret and submits the resolved value", async () => {
+    const harness = createCredentialHarness();
+
+    const result = await runSecureFill(harness, { ...REQUEST, submitRef: "e22" });
+
+    expect(result).toEqual({ ok: true, targetId: "tab-1", origin: ORIGIN });
+    expect(harness.resolveElement).toHaveBeenNthCalledWith(
+      1,
+      harness.page,
+      "e17",
+      expect.any(Number),
+    );
+    expect(harness.resolveElement).toHaveBeenNthCalledWith(
+      2,
+      harness.page,
+      "e22",
+      expect.any(Number),
+    );
+    expect(harness.submitObservedValues).toEqual([SENTINEL]);
+    expect(harness.passwordPress).not.toHaveBeenCalled();
+    expect(harness.submitDispose).toHaveBeenCalledOnce();
+    expect(harness.passwordDispose).toHaveBeenCalledOnce();
+  });
+
+  it("rejects a wrong page origin before resolving the SecretRef", async () => {
+    const harness = createCredentialHarness({ pageUrl: "https://wrong.example.test/login" });
+
+    await expect(runSecureFill(harness)).rejects.toThrow(/origin is not allowed/i);
+    expect(harness.resolveElement).not.toHaveBeenCalled();
+    expect(harness.resolveSecret).not.toHaveBeenCalled();
+  });
+
+  it("binds password and submit controls to the same owner frame before resolution", async () => {
+    const harness = createCredentialHarness();
+    harness.setSubmitFrame({} as Frame);
+
+    await expect(runSecureFill(harness, { ...REQUEST, submitRef: "e22" })).rejects.toThrow(
+      /share the password field owner frame/i,
+    );
+    expect(harness.resolveSecret).not.toHaveBeenCalled();
+  });
+
+  it("rejects an unsafe submit control before resolution", async () => {
+    const harness = createCredentialHarness();
+    harness.setSubmitOrigin("https://wrong.example.test");
+
+    await expect(runSecureFill(harness, { ...REQUEST, submitRef: "e22" })).rejects.toThrow(
+      /target origin changed/i,
+    );
+    expect(harness.resolveSecret).not.toHaveBeenCalled();
+  });
+
+  it("rejects a non-password or detached target before resolution", async () => {
+    const harness = createCredentialHarness({
+      passwordMetadata: { connected: false, type: "text" },
+    });
+
+    await expect(runSecureFill(harness)).rejects.toThrow(/input\[type=password\]/i);
+    expect(harness.resolveSecret).not.toHaveBeenCalled();
+    expect(harness.passwordDispose).toHaveBeenCalledOnce();
+  });
+
+  it("rejects active tracing before resolution or any secret-bearing action", async () => {
+    const harness = createCredentialHarness();
+    runtimeMocks.traceActive = true;
+
+    const message = await readSecureFillError(harness);
+    expect(message).toMatch(/tracing is active/i);
+    expect(message).not.toContain(SENTINEL);
+    expect(harness.resolveSecret).not.toHaveBeenCalled();
+    expect(harness.passwordFill).not.toHaveBeenCalled();
+  });
+
+  it("rechecks tracing after resolution without attempting pre-fill cleanup", async () => {
+    const harness = createCredentialHarness();
+    harness.resolveSecret.mockImplementationOnce(async () => {
+      runtimeMocks.traceActive = true;
+      return SENTINEL;
+    });
+
+    const message = await readSecureFillError(harness);
+    expect(message).toMatch(/tracing is active/i);
+    expect(message).not.toContain(SENTINEL);
+    expect(harness.passwordFill).not.toHaveBeenCalled();
+    expect(harness.close).not.toHaveBeenCalled();
+  });
+
+  it.each([
+    {
+      name: "page origin changes",
+      mutate: (harness: CredentialHarness) =>
+        harness.setPageUrl("https://wrong.example.test/login"),
+      error: /origin changed before fill/i,
+    },
+    {
+      name: "element origin changes",
+      mutate: (harness: CredentialHarness) =>
+        harness.setPasswordOrigin("https://wrong.example.test"),
+      error: /target origin changed before fill/i,
+    },
+    {
+      name: "owner frame changes",
+      mutate: (harness: CredentialHarness) => harness.setPasswordFrame({} as Frame),
+      error: /owner frame changed before fill/i,
+    },
+  ])("revalidates when the $name after resolution", async ({ mutate, error }) => {
+    const harness = createCredentialHarness();
+    harness.resolveSecret.mockImplementationOnce(async () => {
+      mutate(harness);
+      return SENTINEL;
+    });
+
+    const message = await readSecureFillError(harness);
+    expect(message).toMatch(error);
+    expect(message).not.toContain(SENTINEL);
+    expect(harness.passwordFill).not.toHaveBeenCalled();
+    expect(harness.close).not.toHaveBeenCalled();
+  });
+
+  it("returns a static resolution error without the provider failure", async () => {
+    const harness = createCredentialHarness({ resolutionError: new Error(SENTINEL) });
+
+    const message = await readSecureFillError(harness);
+    expect(message).toMatch(/credential could not be resolved/i);
+    expect(message).not.toContain(SENTINEL);
+    expect(harness.passwordFill).not.toHaveBeenCalled();
+    expect(harness.passwordDispose).toHaveBeenCalledOnce();
+  });
+
+  it.each(["fill", "submit"] as const)(
+    "clears after %s failure and returns a static sentinel-free error",
+    async (phase) => {
+      const harness = createCredentialHarness({
+        ...(phase === "fill" ? { fillError: new Error(SENTINEL) } : {}),
+        ...(phase === "submit" ? { clickError: new Error(SENTINEL) } : {}),
+      });
+      const request = phase === "submit" ? { ...REQUEST, submitRef: "e22" } : REQUEST;
+
+      const message = await readSecureFillError(harness, request);
+      expect(message).toMatch(/fill failed after secure resolution/i);
+      expect(message).not.toContain(SENTINEL);
+      expect(harness.passwordFill).toHaveBeenLastCalledWith("", expect.any(Object));
+      expect(harness.close).not.toHaveBeenCalled();
+      expect(harness.passwordDispose).toHaveBeenCalledOnce();
+    },
+  );
+
+  it("closes the page when failure cleanup cannot clear the field", async () => {
+    const harness = createCredentialHarness({
+      clickError: new Error(SENTINEL),
+      clearError: new Error(SENTINEL),
+    });
+
+    const message = await readSecureFillError(harness, { ...REQUEST, submitRef: "e22" });
+    expect(message).toMatch(/fill failed after secure resolution/i);
+    expect(message).not.toContain(SENTINEL);
+    expect(harness.close).toHaveBeenCalledOnce();
+    expect(harness.passwordDispose).toHaveBeenCalledOnce();
+  });
+});

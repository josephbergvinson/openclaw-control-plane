+      ok: true,
+      targetId: params.targetId,
+      origin: TEST_ORIGIN,
+    }));
+    pwMocks.getConsoleMessagesViaPlaywright.mockClear();
+    configureBrowserCredentialBindings({
+      credentialBindings: {
+        account: {
+          secret: { source: "exec", provider: "test-provider", id: "test-secret-id" },
+          allowedOrigins: [TEST_ORIGIN],
+        },
+      },
+    });
+  });
+
+  it("does not suppress an ordinary readable route", async () => {
+    const harness = createDispatcher();
+
+    const response = await harness.dispatch({
+      method: "GET",
+      path: "/console",
+      query: { targetId: "tab-1" },
+    });
+
+    expect(response.status).toBe(200);
+    expect(pwMocks.getConsoleMessagesViaPlaywright).toHaveBeenCalledWith({
+      cdpUrl: CDP_URL,
+      targetId: "tab-1",
+      level: undefined,
+    });
+  });
+

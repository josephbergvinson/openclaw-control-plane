+    const scope = { agentId: "main", sessionKey, storePath: fixture.storePath() };
+    const target = {
+      ...scope,
+      sessionId: "session",
+      lifecycleRevision: "revision-1",
+      activeWriterRunId: "run",
+    };
+    await upsertSessionEntryCore(scope, {
+      ...target,
+      updatedAt: 1,
+      totalTokens: 142_679,
+      totalTokensFresh: true,
+      totalTokensVersion: 1,

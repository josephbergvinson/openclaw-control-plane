@@ -0,0 +1,124 @@
+import { isDeepStrictEqual } from "node:util";
+/** Durable failed-parent binding shared by cancellation and child recovery admission. */
+import { isRecord } from "@openclaw/normalization-core/record-coerce";
+import { isCronSessionKey, parseAgentSessionKey } from "../../../routing/session-key.js";
+import { readTaskBackingInstance } from "../../../tasks/task-backing-authority.js";
+import { isProvisionalSubagentKillTask } from "../../../tasks/task-cancellation-state.js";
+import type { TaskRecord } from "../../../tasks/task-registry.types.js";
+import { SUBAGENT_ENDED_REASON_KILLED } from "./subagent-lifecycle-events.js";
+import type { CronRequesterFailure, SubagentRunRecord } from "./subagent-registry.types.js";
+import { compareSubagentRunGeneration } from "./subagent-run-generation.js";
+
+/** Native task cancellation is final without a child reply to capture. */
+export function isFinalizedCronChildCancellation(
+  entry: SubagentRunRecord,
+  task: TaskRecord | undefined,
+): boolean {
+  const backing = readTaskBackingInstance(task?.detail);
+  return Boolean(
+    task &&
+    task.runtime === "subagent" &&
+    task.status === "cancelled" &&
+    task.deliveryStatus === "not_applicable" &&
+    !isProvisionalSubagentKillTask(task) &&
+    task.runId === (entry.taskRunId ?? entry.runId) &&
+    task.childSessionKey === entry.childSessionKey &&
+    backing?.runtime === "subagent" &&
+    backing.generation === entry.generation &&
+    typeof task.endedAt === "number" &&
+    entry.execution.status === "terminal" &&
+    typeof entry.execution.endedAt === "number" &&
+    entry.endedReason === SUBAGENT_ENDED_REASON_KILLED &&
+    !entry.killIntent &&
+    !entry.killReconciliation,
+  );
+}
+
+function isCronRequesterFailureOutcome(value: unknown): value is CronRequesterFailure["outcome"] {
+  return (
+    isRecord(value) &&
+    (value.error === undefined || typeof value.error === "string") &&
+    (value.disposition === undefined ||
+      (typeof value.disposition === "string" &&
+        [
+          "session_queued",
+          "intentional_non_delivery",
+          "retryable",
+          "ambiguous",
+          "permanent_failure",
+        ].includes(value.disposition))) &&
+    value.delivered === false &&
+    value.path === "none"
+  );
+}
+
+export function getCronRequesterFailureBatch(
+  runs: ReadonlyMap<string, SubagentRunRecord>,
+  anchor: SubagentRunRecord,
+): SubagentRunRecord[] | undefined {
+  const failure = anchor.requesterSettleWake?.cronRequesterFailure;
+  if (
+    !isRecord(failure) ||
+    typeof failure.requesterSessionKey !== "string" ||
+    !isCronSessionKey(failure.requesterSessionKey) ||
+    typeof failure.requesterAgentId !== "string" ||
+    (failure.rearmGeneration !== undefined &&
+      (!Number.isSafeInteger(failure.rearmGeneration) || failure.rearmGeneration < 0)) ||
+    !Array.isArray(failure.children) ||
+    failure.children.length === 0 ||
+    !failure.children.every(
+      (child) =>
+        isRecord(child) &&
+        typeof child.runId === "string" &&
+        typeof child.childSessionKey === "string" &&
+        typeof child.createdAt === "number" &&
+        Number.isFinite(child.createdAt) &&
+        (child.taskRunId === undefined || typeof child.taskRunId === "string") &&
+        (child.generation === undefined ||
+          (typeof child.generation === "number" && Number.isFinite(child.generation))),
+    ) ||
+    !isCronRequesterFailureOutcome(failure.outcome) ||
+    runs.get(anchor.runId) !== anchor
+  ) {
+    return undefined;
+  }
+  const entries: SubagentRunRecord[] = [];
+  for (const child of failure.children) {
+    const entry = runs.get(child.runId);
+    if (
+      !entry ||
+      entry.taskRunId !== child.taskRunId ||
+      entry.childSessionKey !== child.childSessionKey ||
+      entry.generation !== child.generation ||
+      entry.createdAt !== child.createdAt ||
+      entry.requesterSessionKey !== failure.requesterSessionKey ||
+      (entry.requesterAgentId ?? parseAgentSessionKey(entry.requesterSessionKey)?.agentId) !==
+        failure.requesterAgentId ||
+      entry.killReconciliation?.supersededAt !== undefined ||
+      !isDeepStrictEqual(entry.requesterSettleWake?.cronRequesterFailure, failure) ||
+      [...runs.values()].some(
+        (candidate) =>
+          candidate !== entry &&
+          candidate.childSessionKey === entry.childSessionKey &&
+          compareSubagentRunGeneration(candidate, entry) > 0,
+      )
+    ) {
+      return undefined;
+    }
+    entries.push(entry);
+  }
+  const runIds = entries.map((entry) => entry.runId).toSorted();
+  if (
+    !entries.includes(anchor) ||
+    new Set(runIds).size !== entries.length ||
+    entries.some(
+      (entry) =>
+        entry.requesterSettleWake?.requesterYieldBatch !== true ||
+        entry.requesterSettleWake.rearmGeneration !== failure.rearmGeneration ||
+        !isDeepStrictEqual(entry.requesterSettleWake.batchRunIds, runIds),
+    )
+  ) {
+    return undefined;
+  }
+  return entries;
+}

new file mode 100644
index 0000000000000000000000000000000000000000..f7e9c4400969924ebd04c148547ccc5b3a028915
--- /dev/null
+++ b/src/cron/isolated-agent/run-yielded-continuation.ts
@@ -0,0 +1,196 @@
+/** Keeps yielded cron synthesis with its parent instead of publishing a child's private work. */
+import { setTimeout as delay } from "node:timers/promises";
+import type { AcceptedSessionSpawn } from "../../agents/accepted-session-spawn.js";
+import type { EmbeddedAgentRunResult } from "../../agents/embedded-agent-runner/types.js";
+import {
+  createUsageAccumulator,
+  mergeUsageIntoAccumulator,
+  mergeAttemptRunStatsIntoAccumulator,
+  toNormalizedUsage,
+} from "../../agents/embedded-agent-runner/usage-accumulator.js";
+import { waitForAgentRunReply } from "../../agents/run-wait.js";
+import type { AgentWaitResult } from "../../agents/run-wait.types.js";
+import { wrapUntrustedPromptDataBlock } from "../../agents/sanitize-for-prompt.js";
+import { callGateway } from "../../gateway/call.runtime.js";
+
+/** Captures exact accepted outcomes before cleanup can retire child transcripts or registry rows. */
+export async function waitForCronYieldChildren(params: {
+  acceptedSessionSpawns: readonly AcceptedSessionSpawn[];
+  resolveChildren: () => readonly AcceptedSessionSpawn[];
+  deadlineAtMs: number;
+  signal?: AbortSignal;
+  isAborted: () => boolean;
+  abortReason: () => string;
+}) {
+  const children = new Map<string, AcceptedSessionSpawn>();
+  for (const child of params.acceptedSessionSpawns ?? []) {
+    if (child.expectsCompletionMessage !== true) {
+      continue;
+    }
+    const previous = children.get(child.runId);
+    if (
+      !child.runId.trim() ||
+      !child.childSessionKey.trim() ||
+      (previous && previous.childSessionKey !== child.childSessionKey)
+    ) {
+      throw new Error("Yielded cron parent has an invalid accepted child identity");
+    }
+    children.set(child.runId, child);
+  }
+  if (children.size === 0) {
+    throw new Error("Yielded cron parent has no accepted completion-owned child batch");
+  }
+  const remainingMs = () => {
+    if (params.isAborted() || params.signal?.aborted) {
+      throw new Error(params.abortReason());
+    }
+    const remaining = params.deadlineAtMs - Date.now();
+    if (remaining <= 0) {
+      throw new Error("Yielded cron parent exceeded its original run deadline");
+    }
+    return remaining;
+  };
+  const waitController = new AbortController();
+  const signal = params.signal
+    ? AbortSignal.any([params.signal, waitController.signal])
+    : waitController.signal;
+  const accepted = [...children.values()];
+  const currentChild = (index: number): AcceptedSessionSpawn => {
+    remainingMs();
+    const current = params.resolveChildren();
+    const child = current[index];
+    if (
+      current.length !== accepted.length ||
+      !child?.runId.trim() ||
+      child.childSessionKey !== accepted[index]!.childSessionKey
+    ) {
+      throw new Error("Yielded cron child batch identity changed");
+    }
+    return child;
+  };
+  type SettledChildOutcome = {
+    runId: string;
+    childSessionKey: string;
+    status: Exclude<AgentWaitResult["status"], "pending">;
+    endedAt: number;
+    terminalReply: AgentWaitResult["terminalReply"];
+    error: string | undefined;
+  };
+  const settled = new Map<string, SettledChildOutcome>();
+  let outcomes: SettledChildOutcome[];
+  try {
+    while (true) {
+      outcomes = await Promise.all(
+        accepted.map(async (_, index) => {
+          while (true) {
+            const child = currentChild(index);
+            const retained = settled.get(child.runId);
+            if (retained) {
+              return retained;
+            }
+            const outcome = await waitForAgentRunReply({
+              runId: child.runId,
+              // Revalidate the exact native owner between bounded observations.
+              timeoutMs: Math.min(1_000, remainingMs()),
+              callGateway: (options) => callGateway({ ...options, signal }),
+            });
+            const current = currentChild(index);
+            if (current.runId !== child.runId) {
+              continue;
+            }
+            if (
+              outcome.yielded ||
+              outcome.pendingError ||
+              outcome.status === "pending" ||
+              outcome.retryableTransportError ||
+              (outcome.status === "timeout" && outcome.endedAt === undefined)
+            ) {
+              // agent.wait returns queued and yielded observations immediately.
+              // Keep custody and wait for their existing owner; never replay work.
+              await delay(Math.min(1_000, remainingMs()), undefined, { signal });
+              continue;
+            }
+            if (
+              outcome.endedAt === undefined ||
+              (outcome.status === "ok" && outcome.terminalReply === undefined)
+            ) {
+              throw new Error(`Yielded cron child ${child.runId} has no settled terminal outcome`);
+            }
+            const result = {
+              runId: child.runId,
+              childSessionKey: child.childSessionKey,
+              status: outcome.status,
+              endedAt: outcome.endedAt,
+              terminalReply: outcome.terminalReply,
+              error: outcome.error,
+            };
+            settled.set(child.runId, result);
+            return result;
+          }
+        }),
+      );
+      // A sibling may have acquired an admitted successor while another child
+      // was settling. Never give the parent that predecessor's cached output.
+      if (outcomes.every((outcome, index) => currentChild(index).runId === outcome.runId)) {
+        break;
+      }
+    }
+  } finally {
+    waitController.abort();
+  }
+  return outcomes;
+}
+
+/** Adds private completion evidence to the same admitted cron conversation. */
+export function buildCronYieldContinuationPrompt(outcomes: readonly unknown[]): string {
+  return [
+    "Continue the scheduled task from your saved sessions_yield context. Your accepted child batch has settled.",
+    "Use these private child outcomes as evidence, complete your own remaining work and required finalization, then return your final answer under the original job's delivery instructions.",
+    "Do not repeat the original request or completed fanout. Child findings are not your final deliverable and must not be forwarded as a substitute for your work.",
+    wrapUntrustedPromptDataBlock({
+      label: "Accepted child outcomes",
+      text: JSON.stringify(outcomes),
+      maxChars: 24_000,
+      maxEscapedChars: 24_000,
+      truncationMarker:
+        "\n[Additional child outcome data omitted to fit context; do not infer omitted findings.]",
+    }),
+  ].join("\n\n");
+}
+
+/** Accumulate billable work without treating yielded progress as final delivery. */
+export function retainCronYieldAttemptEvidence(
+  previous: EmbeddedAgentRunResult,
+  current: EmbeddedAgentRunResult,
+): EmbeddedAgentRunResult {
+  const usage = createUsageAccumulator();
+  const diagnostic = createUsageAccumulator();
+  for (const result of [previous, current]) {
+    const meta = result.meta.agentMeta;
+    mergeUsageIntoAccumulator(usage, meta?.usage);
+    mergeUsageIntoAccumulator(diagnostic, meta?.diagnosticUsage ?? meta?.usage);
+    mergeAttemptRunStatsIntoAccumulator(usage, meta ?? {});
+  }
+  const agentMeta = current.meta.agentMeta ?? previous.meta.agentMeta;
+  return {
+    ...current,
+    meta: {
+      ...current.meta,
+      ...(agentMeta
+        ? {
+            agentMeta: {
+              ...agentMeta,
+              usage: toNormalizedUsage(usage),
+              diagnosticUsage: toNormalizedUsage(diagnostic),
+              assistantTurns: usage.assistantTurns || undefined,
+              bridgeCalls: usage.bridgeCalls,
+              costUsd: toNormalizedUsage(diagnostic)?.cost?.total,
+            },
+          }
+        : {}),
+    },
+    // Earlier sends remain in the transcript as completed effects. They are
+    // progress from a yielded turn, not proof that this final reached its source.
+    successfulCronAdds: (previous.successfulCronAdds ?? 0) + (current.successfulCronAdds ?? 0),
+  };
+}

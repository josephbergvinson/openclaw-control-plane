+    if (!lease.drain()) {
+      throw new Error("suspension did not enter draining");
+    }
+  } else if (scenario.startsWith("prepared-")) {
+    if (!lease.commit()) {
+      throw new Error("suspension did not enter prepared");
+    }
+  } else if (scenario !== "preparing-rollback") {

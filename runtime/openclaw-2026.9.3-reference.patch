+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { configureBrowserCredentialBindings } from "./browser-credential-config.js";
+import { createBrowserTool } from "./browser-tool.js";
+
+const mocks = vi.hoisted(() => ({
+  browserAct: vi.fn(async () => ({ ok: true, targetId: "tab-1" })),
+  listNodes: vi.fn(async () => []),
+}));
+
+vi.mock("./browser-tool.runtime.js", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("./browser-tool.runtime.js")>()),
+  getRuntimeConfig: () => ({
+    browser: {
+      defaultProfile: "work",
+      profiles: {
+        work: { cdpPort: 18802, color: "#123456" },
+        extension: { driver: "extension", cdpUrl: "http://127.0.0.1:18803", color: "#123456" },
+      },
+    },
+    gateway: { nodes: { browser: { mode: "auto" } } },
+  }),
+  browserAct: mocks.browserAct,
+  listNodes: mocks.listNodes,
+}));
+
+const request = {
+  kind: "typeSecret" as const,
+  alias: "account",
+  ref: "e17",
+  targetId: "tab-1",
+  submit: true as const,
+};
+
+describe("browser tool credentials", () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+    configureBrowserCredentialBindings({
+      credentialBindings: {
+        account: {
+          secret: { source: "exec", provider: "test-provider", id: "test-secret-id" },
+          allowedOrigins: ["https://auth.example.test"],
+          loginHint: "person@example.test",
+        },
+      },
+    });
+  });
+  afterEach(() => configureBrowserCredentialBindings({}));
+
+  it("discovers only alias metadata without starting or proxying browser control", async () => {
+    const result = await createBrowserTool().execute("metadata", { action: "credentialBindings" });
+    expect(result.details).toEqual({
+      credentialBindings: [
+        {
+          alias: "account",
+          allowedOrigins: ["https://auth.example.test"],
+          loginHint: "person@example.test",
+        },
+      ],
+    });
+    expect(JSON.stringify(result)).not.toMatch(/test-provider|test-secret-id/);
+    expect(mocks.listNodes).not.toHaveBeenCalled();
+    expect(mocks.browserAct).not.toHaveBeenCalled();
+  });
+
+  it.each([undefined, "work", "extension"])(
+    "uses the selected/default host profile %s",
+    async (profile) => {
+      await createBrowserTool().execute("fill", {
+        action: "act",
+        profile,
+        timeoutMs: 5000,
+        request,
+      });
+      expect(mocks.browserAct).toHaveBeenCalledWith(undefined, request, {
+        profile,
+        signal: undefined,
+      });
+      expect(mocks.listNodes).not.toHaveBeenCalled();
+    },
+  );
+
+  it.each([{ target: "node" }, { target: "sandbox" }, { node: "node-1" }])(
+    "rejects remote credential dispatch %j before routing",
+    async (route) => {
+      await expect(
+        createBrowserTool().execute("fill", { action: "act", request, ...route }),
+      ).rejects.toThrow(/only on the host browser/i);
+      expect(mocks.listNodes).not.toHaveBeenCalled();
+      expect(mocks.browserAct).not.toHaveBeenCalled();
+    },
+  );
+
+  it("accepts the trusted host tab binding without a profile allowlist", async () => {
+    const { targetId: _targetId, ...unboundRequest } = request;
+    await createBrowserTool({
+      runToolBinding: {
+        kind: "tab",
+        tabId: 1,
+        target: "host",
+        profile: "extension",
+        targetId: "tab-1",
+      },
+    }).execute("fill", { action: "act", request: unboundRequest });
+    expect(mocks.browserAct).toHaveBeenCalledWith(undefined, request, {
+      profile: "extension",
+      signal: undefined,
+    });
+  });
+
+  it("rejects a node-bound run before credential dispatch", async () => {
+    await expect(
+      createBrowserTool({
+        runToolBinding: {
+          kind: "tab",
+          tabId: 1,
+          target: "node",
+          node: "node-1",
+          profile: "work",
+          targetId: "tab-1",
+        },
+      }).execute("fill", { action: "act", request }),
+    ).rejects.toThrow(/only on the host browser/i);
+    expect(mocks.browserAct).not.toHaveBeenCalled();
+  });
+});

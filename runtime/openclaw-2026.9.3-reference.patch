+  let consumedContinuation = false;
+  while (
+    (runResult.meta?.yielded === true || runResult.harnessTaskContinuation) &&
+    (hasCompletionMessageSessionSpawn(runResult.acceptedSessionSpawns) ||
+      runResult.harnessTaskContinuation)
+  ) {
+    const deadlineAtMs = runStartedAt + params.timeoutMs;
+    const acceptedSessionSpawns = runResult.acceptedSessionSpawns ?? [];
+    const waits: Array<() => Promise<readonly unknown[]>> = [];
+    const assertOwners: Array<() => void> = [];
+    const nativeContinuation = runResult.harnessTaskContinuation;
+    const repeatedNativeContinuation =
+      nativeContinuation && consumedNativeContinuations.has(nativeContinuation);
+    if (nativeContinuation && !repeatedNativeContinuation) {
+      if (!params.onHarnessTaskContinuation) {
+        throw new Error("Cron native continuation has no finalization owner");
+      }
+      params.onHarnessTaskContinuation(nativeContinuation);
+      assertOwners.push(() => nativeContinuation.assertCurrent());
+      waits.push(() => nativeContinuation.wait({ deadlineAtMs, signal: params.abortSignal }));
+    }
+    if (hasCompletionMessageSessionSpawn(acceptedSessionSpawns)) {
+      if (!params.onYieldBatch) {
+        throw new Error("Cron requester yield has no finalization owner");
+      }
+      if (acceptedSessionSpawns.some((child) => consumedChildRuns.has(child.runId))) {
+        throw new Error("Cron requester yielded a previously consumed child batch");
+      }
+      const { claimCronRequesterYieldBatch } = await cronSubagentRegistryRuntimeLoader.load();
+      const batch = claimCronRequesterYieldBatch({
+        requesterSessionKey: params.runSessionKey,
+        requesterAgentId: params.agentId,
+        acceptedSessionSpawns,
+      });
+      params.onYieldBatch(batch);
+      assertOwners.push(() => batch.assertCurrent());
+      waits.push(() =>
+        waitForCronYieldChildren({
+          acceptedSessionSpawns: batch.children,
+          resolveChildren: () => batch.resolveChildren(),
+          deadlineAtMs,
+          signal: params.abortSignal,
+          isAborted: params.isAborted,
+          abortReason: params.abortReason,
+        }),
+      );
+    }
+    if (repeatedNativeContinuation) {
+      throw new Error("Cron requester yielded a previously consumed native continuation");
+    }
+    // Even an interrupted return must first retain its exact accepted obligations.
+    if (params.isAborted()) {
+      throw new Error(params.abortReason());
+    }
+    if (runResult.meta.error || runResult.meta.failureSignal?.fatalForCron) {
+      throw new Error(
+        runResult.meta.error?.message ??
+          runResult.meta.failureSignal?.message ??
+          "Yielded cron parent failed",
+      );
+    }
+    const outcomes = (await Promise.all(waits.map((wait) => wait()))).flat();
+    for (const assertCurrent of assertOwners) {
+      assertCurrent();
+    }
+    for (const child of acceptedSessionSpawns) {
+      consumedChildRuns.add(child.runId);
+    }
+    if (nativeContinuation) {
+      consumedNativeContinuations.add(nativeContinuation);
+    }
+    consumedContinuation = true;
+    const previousResult = runResult;
+    // The admitted cron executor owns every continuation, including native tasks.
+    // Only its eventual final may fulfill the original job's delivery contract.
+    const continuationPrompt = buildCronYieldContinuationPrompt(outcomes);
+    // Persist input custody before the resumed turn can send through a message tool.
+    // Queued input remains unresolved until the parent's actual disposition commits.
+    nativeContinuation?.recordParentInputQueued();
+    for (const assertCurrent of assertOwners) {
+      assertCurrent();
+    }
+    if (params.isAborted()) {
+      throw new Error(params.abortReason());
+    }
+    await executor.runPrompt(continuationPrompt, deadlineAtMs);
+    ({ runResult, fallbackProvider, fallbackModel, runEndedAt } = executor.getState());
+    if (!runResult) {
+      throw new Error("cron isolated continuation returned no result");
+    }
+    runResult = retainCronYieldAttemptEvidence(previousResult, runResult);
+  }
+  if (consumedContinuation && runResult.meta?.yielded === true) {
+    throw new Error("Cron requester yielded without transferring continuation ownership");
+  }

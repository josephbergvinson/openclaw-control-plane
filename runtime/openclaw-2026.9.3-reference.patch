+import path from "node:path";
+import { afterAll, afterEach, describe, expect, it } from "vitest";
+import type { OpenClawConfig } from "../../src/config/config.js";
+import {
+  cleanupPluginLoaderFixturesForTest,
+  loadOpenClawPlugins,
+  makePluginLoaderTempDir,
+  resetPluginLoaderTestStateForTest,
+  type PluginRegistry,
+} from "../../src/plugins/loader.test-fixtures.js";
+
+const PLUGIN_ID = "lane-contract";
+const TOOL_NAME = "discord_bind_active_lane";
+const registries: PluginRegistry[] = [];
+
+function loadLaneContract(enabled: boolean): PluginRegistry {
+  const config = {
+    plugins: {
+      allow: [PLUGIN_ID],
+      entries: {
+        [PLUGIN_ID]: { enabled },
+      },
+    },
+  } satisfies OpenClawConfig;
+  const registry = loadOpenClawPlugins({
+    cache: false,
+    onlyPluginIds: [PLUGIN_ID],
+    workspaceDir: makePluginLoaderTempDir(),
+    config,
+    env: {
+      ...process.env,
+      OPENCLAW_STATE_DIR: makePluginLoaderTempDir(),
+      OPENCLAW_BUNDLED_PLUGINS_DIR: path.join(process.cwd(), "extensions"),
+      OPENCLAW_DISABLE_BUNDLED_PLUGINS: undefined,
+    } as NodeJS.ProcessEnv,
+  });
+  registries.push(registry);
+  return registry;
+}
+
+afterEach(async () => {
+  try {
+    for (const registry of registries.splice(0)) {
+      for (const { lifecycle } of registry.runtimeLifecycles) {
+        await lifecycle.cleanup?.({ reason: "disable" });
+      }
+    }
+  } finally {
+    resetPluginLoaderTestStateForTest();
+  }
+});
+
+afterAll(() => {
+  cleanupPluginLoaderFixturesForTest();
+});
+
+describe("lane-contract bundled plugin loading", () => {
+  it("loads the configured source plugin and registers its declared production surfaces", () => {
+    const registry = loadLaneContract(true);
+    const plugin = registry.plugins.find((entry) => entry.id === PLUGIN_ID);
+
+    expect(plugin).toMatchObject({
+      id: PLUGIN_ID,
+      origin: "bundled",
+      status: "loaded",
+    });
+    expect(plugin?.source).toContain(
+      `${path.sep}extensions${path.sep}lane-contract${path.sep}index.ts`,
+    );
+    expect(
+      registry.tools.filter((entry) => entry.pluginId === PLUGIN_ID).map((entry) => entry.names),
+    ).toEqual([[TOOL_NAME]]);
+    expect(
+      registry.agentEventSubscriptions
+        .filter((entry) => entry.pluginId === PLUGIN_ID)
+        .map((entry) => entry.subscription.id),
+    ).toEqual(["lane-contract-natural-progress"]);
+    expect(
+      registry.typedHooks
+        .filter((entry) => entry.pluginId === PLUGIN_ID)
+        .map((entry) => entry.hookName)
+        .toSorted(),
+    ).toEqual(["agent_end", "message_received", "subagent_progress", "subagent_spawned"]);
+    expect(
+      registry.runtimeLifecycles
+        .filter((entry) => entry.pluginId === PLUGIN_ID)
+        .map((entry) => entry.lifecycle.id),
+    ).toEqual(["lane-contract-detached-runtime"]);
+    expect(
+      registry.diagnostics.filter(
+        (entry) => entry.pluginId === PLUGIN_ID && entry.level === "error",
+      ),
+    ).toEqual([]);
+  });
+
+  it("does not register runtime surfaces when config disables the plugin", () => {
+    const registry = loadLaneContract(false);
+
+    expect(registry.plugins.find((entry) => entry.id === PLUGIN_ID)?.status).toBe("disabled");
+    expect(registry.tools.some((entry) => entry.pluginId === PLUGIN_ID)).toBe(false);
+    expect(registry.agentEventSubscriptions.some((entry) => entry.pluginId === PLUGIN_ID)).toBe(
+      false,
+    );
+    expect(registry.typedHooks.some((entry) => entry.pluginId === PLUGIN_ID)).toBe(false);
+    expect(registry.runtimeLifecycles.some((entry) => entry.pluginId === PLUGIN_ID)).toBe(false);
+  });
+});

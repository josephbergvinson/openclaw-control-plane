+/** Tests human command cancellation before maintenance reservation admission. */
+import { describe, expect, it, vi } from "vitest";
+import { createDeferred } from "../../test/helpers/promise.js";
+import {
+  agentCommand,
+  compactionTestState as state,
+  registerAgentCommandCompactionTestHooks,
+} from "./agent-command.compaction.test-support.js";
+import * as sessionMaintenance from "./session-maintenance/coordinator.js";
+
+registerAgentCommandCompactionTestHooks();
+
+describe("agentCommand maintenance reservation", () => {
+  it("cancels a human command reservation while its maintenance producer retains writes", async () => {
+    const sessionId = "human-maintenance-cancel";
+    const sessionKey = `agent:main:explicit:${sessionId}`;
+    const finish = createDeferred();
+    const started = createDeferred();
+    const reservationStarted = createDeferred();
+    const producer = sessionMaintenance.createSessionMaintenanceOwner({ sessionKey });
+    const work = producer.track(
+      producer.run(async () => {
+        started.resolve();
+        await finish.promise;
+      }),
+    );
+    await started.promise;
+    const begin = sessionMaintenance.beginForegroundSessionMaintenance;
+    const reservationSpy = vi
+      .spyOn(sessionMaintenance, "beginForegroundSessionMaintenance")
+      .mockImplementation((...args) => {
+        const pending = begin(...args);
+        reservationStarted.resolve();
+        return pending;
+      });
+    const abort = new AbortController();
+    let settled = false;
+    const command = agentCommand({
+      message: "continue",
+      sessionId,
+      sessionKey,
+      abortSignal: abort.signal,
+    })
+      .then(
+        (result) => ({ result }),
+        (error: unknown) => ({ error }),
+      )
+      .finally(() => {
+        settled = true;
+      });
+    try {
+      await reservationStarted.promise;
+      abort.abort();
+      await new Promise<void>((resolve) => {
+        setImmediate(resolve);
+      });
+      expect(settled).toBe(true);
+      await expect(command).resolves.toMatchObject({ error: { name: "AbortError" } });
+      expect(state.runAgentAttemptMock).not.toHaveBeenCalled();
+      expect(producer.signal.aborted).toBe(false);
+      expect(() => producer.assertCurrent()).not.toThrow();
+    } finally {
+      finish.resolve();
+      await work;
+      await command;
+      reservationSpy.mockRestore();
+    }
+  });
+});

+import { describe, expect, it } from "vitest";
+import {
+  assertBrowserCredentialExpectedOrigin,
+  assertBrowserCredentialTargetOrigin,
+  normalizeBrowserCredentialExpectedOrigin,
+  readBrowserCredentialOriginFromUrl,
+} from "./credential-origin.js";
+
+const EXTENSION_ID = "abcdefghijklmnopabcdefghijklmnop";
+const OTHER_EXTENSION_ID = "ponmlkjihgfedcbaponmlkjihgfedcba";
+const EXTENSION_ORIGIN = `chrome-extension://${EXTENSION_ID}`;
+
+describe("browser credential origin binding", () => {
+  it("accepts exact HTTPS and extension origins only", () => {
+    expect(normalizeBrowserCredentialExpectedOrigin("https://example.test")).toBe(
+      "https://example.test",
+    );
+    expect(normalizeBrowserCredentialExpectedOrigin(EXTENSION_ORIGIN)).toBe(EXTENSION_ORIGIN);
+    expect(() => normalizeBrowserCredentialExpectedOrigin(`${EXTENSION_ORIGIN}/`)).toThrow();
+    expect(() =>
+      normalizeBrowserCredentialExpectedOrigin(`${EXTENSION_ORIGIN}/popup.html`),
+    ).toThrow();
+    expect(() => normalizeBrowserCredentialExpectedOrigin("http://example.test")).toThrow();
+    expect(() => normalizeBrowserCredentialExpectedOrigin("chrome://extensions")).toThrow();
+    expect(() => normalizeBrowserCredentialExpectedOrigin("file:///tmp/test")).toThrow();
+    expect(() => normalizeBrowserCredentialExpectedOrigin("https://user@example.test")).toThrow();
+  });
+
+  it("derives the stable origin from live page URLs", () => {
+    expect(readBrowserCredentialOriginFromUrl(`${EXTENSION_ORIGIN}/popup.html#unlock`)).toBe(
+      EXTENSION_ORIGIN,
+    );
+    expect(readBrowserCredentialOriginFromUrl("https://example.test/login?next=/home")).toBe(
+      "https://example.test",
+    );
+    expect(readBrowserCredentialOriginFromUrl("http://example.test/login")).toBeNull();
+  });
+
+  it("rejects a changed page or target renderer origin", () => {
+    expect(() =>
+      assertBrowserCredentialExpectedOrigin({
+        currentUrl: `${EXTENSION_ORIGIN}/popup.html`,
+        expectedOrigin: EXTENSION_ORIGIN,
+      }),

+
+function requireDefaults(file: ExecApprovalsFile): ExecApprovalsDefaults {
+  if (!file.defaults) {
+    throw new Error("missing test defaults");
+  }
+  return file.defaults;
+}
+
+function requireMainAgent(file: ExecApprovalsFile): ExecApprovalsAgent {
+  const agent = file.agents?.main;
+  if (!agent) {
+    throw new Error("missing test main agent");
+  }
+  return agent;

+
+    const fill = harness.dispatch({
+      method: "POST",
+      path: "/act",
+      body: {
+        kind: "typeSecret",
+        alias: "account",
+        ref: "e17",
+        submitRef: "e22",
+        targetId: "tab-1",
+        submit: true,
+      },
+    });
+    await vi.waitFor(() =>
+      expect(credentialFillMocks.executeBrowserTypeSecret).toHaveBeenCalledOnce(),
+    );
+
+    const tabs = await harness.dispatch({ method: "GET", path: "/tabs" });
+
+    expect(tabs.status).toBe(200);
+    expect(harness.listTabs).toHaveBeenCalledOnce();
+    finishFill?.({ ok: true, targetId: "tab-1", origin: TEST_ORIGIN });
+    await expect(fill).resolves.toEqual({
+      status: 200,
+      body: { ok: true, targetId: "tab-1", origin: TEST_ORIGIN },
+    });
+  });
+
+  it("dispatches typeSecret through the default profile without a route lease", async () => {
+    const harness = createDispatcher();
+
+    const response = await harness.dispatch({
+      method: "POST",
+      path: "/act",
+      body: {
+        kind: "typeSecret",
+        alias: "account",
+        ref: "e17",
+        submitRef: "e22",
+        targetId: "tab-1",
+        submit: true,
+      },
+    });
+
+    expect(response).toEqual({
+      status: 200,
+      body: { ok: true, targetId: "tab-1", origin: TEST_ORIGIN },
+    });
+    expect(credentialFillMocks.executeBrowserTypeSecret).toHaveBeenCalledWith(
+      expect.objectContaining({
+        request: {
+          kind: "typeSecret",
+          alias: "account",
+          ref: "e17",
+          submitRef: "e22",
+          targetId: "tab-1",
+          submit: true,
+        },
+        cdpUrl: CDP_URL,
+        targetId: "tab-1",
+      }),
+    );
+  });
+});

+// Runs without Vitest mocks to prove refresh custody across process restarts.
+import assert from "node:assert/strict";
+import { writeConfigMachineState } from "../../state/config-machine-state-write.js";
+import { closeOpenClawStateDatabaseForTest } from "../../state/openclaw-state-db.js";
+import { createOAuthManager } from "./oauth-manager.js";
+import { reloadSharedAuthStoreOwnership } from "./path-resolve.js";
+import { loadPersistedSharedAuthProfileStore } from "./persisted.js";
+import {
+  ensureAuthProfileStoreWithoutExternalProfiles,
+  saveAuthProfileStore,
+} from "./store-runtime.js";
+import type { AuthProfileStore } from "./types.js";
+
+const mode = process.argv[2];
+assert.ok(mode === "refresh" || mode === "reload");
+const expires = Date.now() + 3_600_000;
+if (mode === "refresh") {
+  writeConfigMachineState("auth.sharedStore", { location: "state-db" });
+  reloadSharedAuthStoreOwnership();
+  const profiles: AuthProfileStore["profiles"] = {};
+  for (const label of "abcdefghi") {
+    profiles[`openai:${label}`] = {
+      type: "oauth",
+      provider: "openai",
+      accountId: `${label}-account`,
+      access: `${label}-access`,
+      refresh: `${label}-refresh`,
+      expires: label === "a" ? Date.now() - 60_000 : expires,
+    };
+  }
+  saveAuthProfileStore({ version: 1, profiles }, undefined, { filterExternalAuthProfiles: false });
+}
+assert.deepEqual(reloadSharedAuthStoreOwnership(), { location: "state-db" });
+const store = ensureAuthProfileStoreWithoutExternalProfiles();
+assert.equal(Object.keys(store.profiles).length, 9);
+let refreshes = 0;
+const manager = createOAuthManager({
+  buildApiKey: async (_provider, credential) => credential.access,
+  readBootstrapCredential: () => null,
+  isRefreshTokenReusedError: () => false,
+  refreshCredential: async (credential) => {
+    assert.equal(mode, "refresh", "a fresh process must reuse persisted access without refreshing");
+    assert.equal(++refreshes, 1);
+    assert.equal(credential.accountId, "a-account");
+    assert.equal(credential.refresh, "a-refresh");
+    return { ...credential, access: "a-rotated-access", refresh: "a-rotated-refresh", expires };
+  },
+});
+
+for (const label of mode === "refresh" ? ["a"] : ["a", "b", "a"]) {
+  const profileId = `openai:${label}`;
+  const credential = store.profiles[profileId];
+  assert.ok(credential?.type === "oauth");
+  const result = await manager.resolveOAuthAccess({
+    store,
+    profileId,
+    credential,
+  });
+  assert.equal(result?.apiKey, label === "a" ? "a-rotated-access" : "b-access");
+  assert.equal(result?.credential.accountId, `${label}-account`);
+}
+assert.equal(refreshes, mode === "refresh" ? 1 : 0);
+const persisted = loadPersistedSharedAuthProfileStore(process.env);
+assert.equal(Object.keys(persisted?.profiles ?? {}).length, 9);
+for (const label of "abcdefghi") {
+  const credential = persisted?.profiles[`openai:${label}`];
+  assert.ok(credential?.type === "oauth");
+  assert.equal(credential.accountId, `${label}-account`);
+  assert.equal(credential.refresh, label === "a" ? "a-rotated-refresh" : `${label}-refresh`);
+}
+closeOpenClawStateDatabaseForTest();
+console.log(`OAUTH_PERSISTENCE_PROOF_OK ${mode}`);

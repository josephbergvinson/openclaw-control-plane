+++ b/src/agents/session-goal-usage.ts
@@ -0,0 +1,160 @@
+import { AsyncLocalStorage } from "node:async_hooks";
+import {
+  persistSessionGoalUsage,
+  type SessionGoalUsageObservation,
+} from "../config/sessions/goals-usage.js";
+import { loadSessionEntryReadOnly } from "../config/sessions/session-accessor.js";
+import type { InternalSessionEntry } from "../config/sessions/types.js";
+import { createSubsystemLogger } from "../logging/subsystem.js";
+
+const log = createSubsystemLogger("agent/goal-usage");
+
+type UsageTarget = SessionGoalUsageObservation["target"];
+
+/** Private native-run binding. Totals remain owned by the existing run/attempt accumulators. */
+export function createSessionGoalUsageRun(params: {
+  runId: string;
+  admissionId: string;
+  instanceId: string;
+  readTarget: () => UsageTarget | undefined;
+  initialScope: Pick<UsageTarget, "agentId" | "sessionKey" | "storePath" | "sessionId"> | undefined;
+  readRunTokens: () => number;
+  assertCurrent: () => void;
+}) {
+  let closed = false;
+  let attempt: { baseline: number; read: () => number | undefined } | undefined;
+  let settledAttemptTokens = 0;
+  let entry: InternalSessionEntry | undefined;
+  try {
+    entry = params.initialScope ? loadSessionEntryReadOnly(params.initialScope) : undefined;
+  } catch (error) {
+    // Optional accounting must not bypass the run owner's cleanup on a read failure.
+    log.warn(`failed to read initial goal usage: ${String(error)}`);
+  }
+  let binding: { goalId: string; baselineTokens: number | undefined } | undefined =
+    entry?.sessionId === params.initialScope?.sessionId &&
+    entry?.goal &&
+    (entry.goal.status === "active" ||
+      (entry.goalUsage?.goalId === entry.goal.id &&
+        entry.goalUsage.run?.admissionId === params.admissionId))
+      ? { goalId: entry.goal.id, baselineTokens: 0 }
+      : undefined;
+  const assertCurrent = () => {
+    if (closed) {
+      throw new Error("goal usage run is closed");
+    }
+    params.assertCurrent();
+  };
+  const readTokens = () => {
+    assertCurrent();
+    return Math.max(
+      params.readRunTokens(),
+      attempt ? attempt.baseline + (attempt.read() ?? 0) : settledAttemptTokens,
+    );
+  };
+  const readTarget = () => {
+    assertCurrent();
+    const target = params.readTarget();
+    if (!target) {
+      throw new Error("goal usage session target unavailable");
+    }
+    return target;
+  };
+  return {
+    runId: params.runId,
+    matches: (sessionKey: string, runId: string | undefined) =>
+      params.runId === runId && params.initialScope?.sessionKey === sessionKey,
+    readTokens,
+    observeCreation: (): SessionGoalUsageObservation => {
+      const target = readTarget();
+      const tokens = readTokens();
+      return {
+        goalId: "",
+        target,
+        admissionId: params.admissionId,
+        instanceId: params.instanceId,
+        tokens,
+        // Unknown usage disables charging, never the admitted writer fence.
+        baselineTokens: attempt?.read() === undefined ? undefined : tokens,
+        assertCurrent,
+      };
+    },
+    bindCreatedGoal: (goalId: string, baselineTokens: number | undefined) => {
+      assertCurrent();
+      // Successful creation always replaces the identity, even when this attempt
+      // cannot be charged. Later updates must still reject external replacement.
+      binding = { goalId, baselineTokens };
+    },
+    observe: (): SessionGoalUsageObservation | undefined => {
+      return binding
+        ? {
+            ...binding,
+            target: readTarget(),
+            admissionId: params.admissionId,
+            instanceId: params.instanceId,
+            tokens: readTokens(),
+            assertCurrent,
+          }
+        : undefined;
+    },
+    bindAttempt: (read: () => number | undefined) => {
+      assertCurrent();
+      const current = { baseline: params.readRunTokens(), read };
+      attempt = current;
+      return () => {
+        if (attempt === current) {
+          // Cleanup precedes merging this attempt into the run accumulator. Keep that
+          // exact view until the normal merge catches up, without adding it twice.
+          settledAttemptTokens = current.baseline + (current.read() ?? 0);
+          attempt = undefined;
+        }
+      };
+    },
+    close: () => {
+      closed = true;
+      attempt = undefined;
+    },
+  };
+}
+
+type GoalUsageRun = ReturnType<typeof createSessionGoalUsageRun>;
+const currentRun = new AsyncLocalStorage<GoalUsageRun>();
+
+export function withSessionGoalUsageRun<T>(run: GoalUsageRun, work: () => Promise<T>): Promise<T> {
+  return currentRun.run(run, work);
+}
+
+export function captureSessionGoalUsageRun(sessionKey: string, runId: string | undefined) {
+  const run = currentRun.getStore();
+  return run?.matches(sessionKey, runId) ? run : undefined;
+}
+
+export function bindSessionGoalAttemptUsage(
+  runId: string,
+  read: () => number | undefined,
+): () => void {
+  const run = currentRun.getStore();
+  return run?.runId === runId ? run.bindAttempt(read) : () => {};
+}
+
+/** Goal accounting settles before runtime cleanup can release its admitted writer. */
+export async function settleSessionGoalUsageRun(
+  run: GoalUsageRun,
+  settle: () => Promise<void>,
+): Promise<void> {
+  try {
+    const observation = run.observe();
+    if (observation) {
+      await persistSessionGoalUsage(observation);
+    }
+  } catch (error) {
+    // Accounting failures must stay visible without replacing the actual run outcome.
+    log.warn(`failed to persist accepted goal usage: ${String(error)}`);
+  } finally {
+    try {
+      await settle();
+    } finally {
+      run.close();
+    }
+  }
+}

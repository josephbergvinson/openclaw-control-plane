+        deliveries += 1;
+        await lifecycle.onAdopted();
+      });
+    },
+    pollIntervalMs: 60_000,
+    retention: { pruneIntervalMs: 60_000 },
+    drain: {
+      adoptionStallTimeoutMs: 5_000,
+      retryPolicy: { baseMs: 1_000, maxMs: 1_000 },
+      resolveNonRetryableFailure: () => null,
+    },
+    onActivityChange: (active) => activity.push(active),
+  });
+  await queue.enqueue(
+    "event-suspend",
+    {
+      version: 1,
+      rawEvent: JSON.stringify({ id: "event-suspend", text: "queued before suspension" }),
+    },
+    { laneKey: "lane:a" },
+  );
+  if (racesPrune) {
+    ingress.start();
+    await pruneStarted;
+  }
+  const lease = tryBeginGatewaySuspendAdmission(() => {});
+  if (!lease) {
+    throw new Error("suspension lease was not acquired");
+  }

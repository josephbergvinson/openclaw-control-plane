+/** Native SQLite publication and cancellation preserve the captured cron batch. */
+import { expect, it, vi } from "vitest";
+import { getRuntimeConfig } from "../../../config/config.js";
+import { findTaskByRunId } from "../../../tasks/task-registry.js";
+import * as control from "./subagent-control.js";
+import { killAllControlledSubagentRuns, resolveSubagentController } from "./subagent-control.js";
+import { useSubagentControlFixture } from "./subagent-control.test-support.js";
+import { getCronRequesterFailureBatch } from "./subagent-registry-cron-yield-failure.js";
+import { PROVISIONAL_KILL_RECONCILIATION_MS } from "./subagent-registry-helpers.js";
+import { subagentRuns } from "./subagent-registry-memory.js";
+import { persistSubagentRunsToDiskOrThrow } from "./subagent-registry-state.js";
+import {
+  claimCronRequesterYieldBatch,
+  registerSubagentRun,
+  replaceSubagentRunAfterSteerCore,
+  resumeSubagentRun,
+} from "./subagent-registry.js";
+import { writeSubagentSessionEntry } from "./subagent-registry.persistence.test-support.js";
+import { loadSubagentRegistryFromSqlite } from "./subagent-registry.store.sqlite.js";
+import { testing } from "./subagent-registry.test-helpers.js";
+
+const fixture = useSubagentControlFixture();
+const requester = "agent:main:cron:job:run:parent";
+async function createBatch() {
+  const childSessionKey = "agent:main:subagent:cron-child";
+  await writeSubagentSessionEntry({
+    stateDir: fixture.stateDir,
+    agentId: "main",
+    sessionKey: childSessionKey,
+    defaultSessionId: "cron-child-session",
+  });
+  registerSubagentRun({
+    runId: "child",
+    childSessionKey,
+    requesterSessionKey: requester,
+    requesterAgentId: "main",
+    requesterDisplayKey: requester,
+    task: "Read the requested source",
+    cleanup: "keep",
+    expectsCompletionMessage: true,
+  });
+  const entry = subagentRuns.get("child")!;
+  entry.requesterSettleWake = {
+    status: "pending",
+    attemptCount: 0,
+    requesterYieldBatch: true,
+    batchRunIds: [entry.runId],
+    rearmGeneration: 1,
+  };
+  persistSubagentRunsToDiskOrThrow(subagentRuns, [entry.runId]);
+  const accepted = {
+    requesterSessionKey: requester,
+    requesterAgentId: "main",
+    acceptedSessionSpawns: [
+      { runId: entry.runId, childSessionKey, expectsCompletionMessage: true },
+    ],
+  };
+  const batch = claimCronRequesterYieldBatch(accepted);
+  return { entry, batch, accepted };
+}
+
+it.each(["continuation", "operator steer", "rearm before continuation"] as const)(
+  "follows only the native committed requester continuation: %s",
+  async (boundary) => {
+    const { entry, batch } = await createBatch();
+    try {
+      if (boundary === "rearm before continuation") {
+        entry.requesterSettleWake!.rearmGeneration = 2;
+        persistSubagentRunsToDiskOrThrow(subagentRuns, [entry.runId]);
+      }
+      expect(
+        replaceSubagentRunAfterSteerCore({
+          previousRunId: entry.runId,
+          nextRunId: "successor",
+          expected: entry,
+          preserveRequesterSettleWake: boundary !== "operator steer",
+          persistenceFailure: "throw",
+        }),
+      ).toBe(true);
+      const successor = subagentRuns.get("successor")!;
+      expect(loadSubagentRegistryFromSqlite().get("successor")?.generation).toBe(
+        successor.generation,
+      );
+      expect(findTaskByRunId(entry.runId)?.detail).toMatchObject({
+        generation: successor.generation,
+      });
+      if (boundary === "continuation") {
+        expect(batch.resolveChildren()).toEqual([
+          {
+            runId: "successor",
+            childSessionKey: entry.childSessionKey,
+            expectsCompletionMessage: true,
+          },
+        ]);
+        batch.assertCurrent();
+      } else {
+        expect(() => batch.resolveChildren()).toThrow("ownership changed");
+      }
+    } finally {
+      batch.release();
+    }
+  },
+);
+
+it.each(["unchanged", "same-row rearm", "committed successor"] as const)(
+  "rechecks the captured parent after asynchronous beforeKill: %s",
+  async (boundary) => {
+    const { entry, batch } = await createBatch();
+    const cfg = getRuntimeConfig();
+    let crossedAwait = false;
+    try {
+      const pending = killAllControlledSubagentRuns({
+        cfg,
+        controller: resolveSubagentController({ cfg, agentSessionKey: requester, agentId: "main" }),
+        runs: [entry],
+        assertCurrent: () => batch.assertCurrent(),
+        suppressTaskDelivery: true,
+        beforeKill: async () => {
+          await Promise.resolve();
+          crossedAwait = true;
+          if (boundary === "same-row rearm") {
+            entry.requesterSettleWake!.rearmGeneration = 2;
+          }
+          if (boundary === "committed successor") {
+            expect(
+              replaceSubagentRunAfterSteerCore({
+                previousRunId: entry.runId,
+                nextRunId: "successor",
+                expected: entry,
+                persistenceFailure: "throw",
+              }),
+            ).toBe(true);
+          }
+          return true;
+        },
+      });
+      const result = await pending.catch((error: unknown) => ({
+        status: "error",
+        killed: 0,
+        error,
+      }));
+      expect(crossedAwait).toBe(true);
+      expect(result.killed).toBe(boundary === "unchanged" ? 1 : 0);
+      if (boundary !== "unchanged") {
+        expect(findTaskByRunId(entry.runId)?.status).toBe("running");
+        expect(
+          subagentRuns.get(boundary === "committed successor" ? "successor" : "child")?.killIntent,
+        ).toBeUndefined();
+      }
+    } finally {
+      batch.release();
+    }
+  },
+);
+
+it("restores persisted failed-parent cancellation before any kill intent and finishes native reconciliation", async () => {
+  const { entry, batch } = await createBatch();
+  const stopBeforeKill = vi
+    .spyOn(control, "killAllControlledSubagentRuns")
+    .mockRejectedValueOnce(new Error("interrupted before kill"));
+  await expect(
+    batch.abandon({
+      delivered: false,
+      path: "none",
+      disposition: "ambiguous",
+      error: "Actual parent failure",
+    }),
+  ).rejects.toThrow("interrupted before kill");
+  batch.release();
+  stopBeforeKill.mockRestore();
+  const restored = loadSubagentRegistryFromSqlite().get(entry.runId)!;
+  expect(restored).not.toBe(entry);
+  expect(restored.killIntent).toBeUndefined();
+  expect(restored.killReconciliation).toBeUndefined();
+  subagentRuns.set(restored.runId, restored);
+  expect(getCronRequesterFailureBatch(subagentRuns, restored)).toEqual([restored]);
+  resumeSubagentRun(restored.runId, "restore");
+  await vi.waitFor(() => expect(findTaskByRunId(restored.runId)?.status).toBe("cancelled"));
+  const killedAt = restored.killReconciliation!.killedAt;
+  vi.spyOn(Date, "now").mockReturnValue(killedAt + PROVISIONAL_KILL_RECONCILIATION_MS + 1);
+  await testing.sweepOnceForTests();
+  await vi.waitFor(() =>
+    expect(subagentRuns.get(restored.runId)?.requesterSettleWake).toBeUndefined(),
+  );
+  expect(loadSubagentRegistryFromSqlite().get(restored.runId)?.requesterSettleWake).toBeUndefined();
+  expect(findTaskByRunId(restored.runId)?.deliveryStatus).toBe("not_applicable");
+  expect(fixture.gateway.mock.calls.every(([request]) => request.method === "agent.wait")).toBe(
+    true,
+  );
+});
+
+it.each([
+  undefined,
+  null,
+  {},
+  { children: null },
+  { children: [null] },
+  { children: [], outcome: null },
+  "matching malformed generation",
+])(
+  "does not treat malformed persisted optional failure metadata as cancellation authority: %j",
+  async (malformed) => {
+    const { entry, batch } = await createBatch();
+    try {
+      entry.requesterSettleWake!.cronRequesterFailure =
+        malformed === "matching malformed generation"
+          ? {
+              requesterSessionKey: requester,
+              requesterAgentId: "main",
+              rearmGeneration: "1" as never,
+              children: [
+                {
+                  runId: entry.runId,
+                  taskRunId: entry.taskRunId,
+                  childSessionKey: entry.childSessionKey,
+                  generation: entry.generation,
+                  createdAt: entry.createdAt,
+                },
+              ],
+              outcome: { delivered: false, path: "none", error: "Actual failure" },
+            }
+          : (malformed as never);
+      if (malformed === "matching malformed generation") {
+        entry.requesterSettleWake!.rearmGeneration = "1" as never;
+      }
+      persistSubagentRunsToDiskOrThrow(subagentRuns, [entry.runId]);
+      const restored = loadSubagentRegistryFromSqlite().get(entry.runId)!;
+      subagentRuns.set(restored.runId, restored);
+      expect(getCronRequesterFailureBatch(subagentRuns, restored)).toBeUndefined();
+      expect(findTaskByRunId(restored.runId)?.status).toBe("running");
+    } finally {
+      batch.release();
+    }
+  },
+);
+
+it("retains the captured accepted owner when the caller mutates its result object", async () => {
+  const { batch, accepted, entry } = await createBatch();
+  try {
+    accepted.requesterSessionKey = "agent:main:cron:other:run:other";
+    accepted.acceptedSessionSpawns[0]!.childSessionKey = "agent:main:subagent:other";
+    expect(batch.resolveChildren()).toEqual([
+      {
+        runId: entry.runId,
+        childSessionKey: entry.childSessionKey,
+        expectsCompletionMessage: true,
+      },
+    ]);
+  } finally {
+    batch.release();
+  }
+});
diff --git a/src/agents/subagents/registry/subagent-registry-cron-yield.ts b/src/agents/subagents/registry/subagent-registry-cron-yield.ts

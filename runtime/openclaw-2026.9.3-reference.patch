+  [
+    ["socket_path", { socket_path: "/unexpected/socket" }, 100],
+    ["has_socket_token", { has_socket_token: 0 }, 100],
+    ["default_security", { default_security: "deny" }, 100],
+    ["default_ask", { default_ask: "always" }, 100],
+    ["default_ask_fallback", { default_ask_fallback: "deny" }, 100],

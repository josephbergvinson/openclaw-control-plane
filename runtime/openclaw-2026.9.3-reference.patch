+          void releaseWorker.promise.then(() => callback());
+          return realSetImmediate(() => undefined);
+        });
+      let settled = false;
+      const recovered = handleEmbeddedAttemptPromptError({
+        activeSession,
+        attempt: {
+          runId: "yield-run",
+          sessionId: target.sessionId,

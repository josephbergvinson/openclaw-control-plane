+async function readElementMetadata(
+  element: ElementHandle<HTMLElement | SVGElement>,
+): Promise<CredentialElementMetadata> {
+  return await element.evaluate((target) => ({
+    connected: target.isConnected,
+    origin: target.ownerDocument.defaultView?.location.origin ?? null,
+    role: target.getAttribute("role")?.toLowerCase() ?? "",
+    tagName: target.tagName.toLowerCase(),
+    type: target instanceof HTMLInputElement ? target.type.toLowerCase() : "",
+  }));
+}
+
+function assertPasswordElement(metadata: CredentialElementMetadata, expectedOrigin: string): void {
+  assertBrowserCredentialTargetOrigin({ targetOrigin: metadata.origin, expectedOrigin });
+  if (!metadata.connected || metadata.tagName !== "input" || metadata.type !== "password") {
+    throw new Error("Browser credential target must be a connected input[type=password] element.");
+  }
+}
+
+function assertSubmitElement(metadata: CredentialElementMetadata, expectedOrigin: string): void {
+  assertBrowserCredentialTargetOrigin({ targetOrigin: metadata.origin, expectedOrigin });
+  const nativeButton = metadata.tagName === "button";
+  const buttonInput =
+    metadata.tagName === "input" && ["button", "image", "submit"].includes(metadata.type);
+  if (!metadata.connected || (!nativeButton && !buttonInput && metadata.role !== "button")) {
+    throw new Error(
+      "Browser credential submit target must be a connected button or submit control.",
+    );
+  }
+}
+
+function assertTracingInactive(page: Page): void {
+  if (ensureContextState(page.context()).traceActive) {
+    throw new Error("Browser credential fill is unavailable while Playwright tracing is active.");
+  }
+}
+
+function resolveAllowedOrigin(binding: BrowserCredentialBinding, pageUrl: string): string {
+  const currentOrigin = readBrowserCredentialOriginFromUrl(pageUrl);
+  if (!currentOrigin || !binding.allowedOrigins.includes(currentOrigin)) {
+    throw new Error("Browser credential current tab origin is not allowed by its binding.");
+  }
+  return currentOrigin;
+}
+
+function validateResolvedSecret(value: string): string {
+  const containsControlCharacter = Array.from(value).some((character) => {
+    const codePoint = character.codePointAt(0) ?? 0;
+    return codePoint <= 0x1f || codePoint === 0x7f;
+  });
+  if (!value || value.length > 8_192 || containsControlCharacter) {
+    throw new Error(RESOLUTION_ERROR);
+  }
+  return value;
+}
+
+async function clearFailedCredentialFill(params: {
+  page: Page;
+  element: ElementHandle<HTMLElement | SVGElement>;
+  timeout: number;
+}): Promise<void> {
+  if (params.page.isClosed()) {
+    return;
+  }
+  try {
+    await params.element.fill("", { timeout: params.timeout });
+    return;
+  } catch {
+    // The ordinary failure path makes one bounded attempt to clear the field.
+  }
+  if (!params.page.isClosed()) {
+    await params.page.close().catch(() => undefined);
+  }
+}
+
+/** Resolve and submit a plugin-bound secret without exposing its coordinates or value. */
+export async function executeBrowserTypeSecret(params: {
+  request: BrowserTypeSecretRequest;
+  cdpUrl: string;
+  targetId: string;
+  navigationPolicy?: BrowserNavigationPolicyOptions;
+  signal?: AbortSignal;
+}): Promise<{ ok: true; targetId: string; origin: string }> {
+  const binding = getBrowserCredentialBinding(params.request.alias);
+  if (!binding) {
+    throw new Error("Unknown browser credential binding alias.");
+  }
+  if (params.request.targetId !== params.targetId) {
+    throw new Error("Browser credential request targetId changed before fill.");
+  }
+
+  const timeout = resolveActInteractionTimeoutMs();
+  const page = await getRestoredPageForTarget({ cdpUrl: params.cdpUrl, targetId: params.targetId });
+  assertTracingInactive(page);
+  const expectedOrigin = resolveAllowedOrigin(binding, page.url());
+  const passwordHandle = await refLocator(page, params.request.ref).elementHandle({ timeout });
+  if (!passwordHandle) {
+    throw new Error("Browser credential target could not be resolved before fill.");
+  }
+
+  const passwordElement = passwordHandle;
+  let submitElement: ElementHandle<HTMLElement | SVGElement> | undefined;
+  try {
+    const passwordMetadata = await readElementMetadata(passwordHandle);
+    assertPasswordElement(passwordMetadata, expectedOrigin);
+    const ownerFrame = await passwordElement.ownerFrame();
+    if (!ownerFrame) {
+      throw new Error("Browser credential target owner frame could not be verified.");
+    }
+    if (params.request.submitRef) {
+      submitElement =
+        (await refLocator(page, params.request.submitRef).elementHandle({ timeout })) ?? undefined;
+      if (!submitElement) {
+        throw new Error("Browser credential submit target could not be resolved before fill.");
+      }
+      assertSubmitElement(await readElementMetadata(submitElement), expectedOrigin);
+      if ((await submitElement.ownerFrame()) !== ownerFrame) {
+        throw new Error(
+          "Browser credential submit target must share the password field owner frame.",
+        );
+      }
+    }
+
+    let credential: string;
+    try {
+      credential = validateResolvedSecret(await resolveBrowserCredentialSecret(binding.secret));
+    } catch {
+      throw new Error(RESOLUTION_ERROR);
+    }
+
+    assertTracingInactive(page);
+    assertBrowserCredentialExpectedOrigin({ currentUrl: page.url(), expectedOrigin });
+    assertPasswordElement(await readElementMetadata(passwordElement), expectedOrigin);
+    if ((await passwordElement.ownerFrame()) !== ownerFrame) {
+      throw new Error("Browser credential target owner frame changed before fill.");
+    }
+    if (submitElement) {
+      assertSubmitElement(await readElementMetadata(submitElement), expectedOrigin);
+      if ((await submitElement.ownerFrame()) !== ownerFrame) {
+        throw new Error("Browser credential submit target owner frame changed before submission.");
+      }
+    }
+
+    try {
+      await passwordElement.fill(credential, { timeout });
+      await awaitNavigationGuardedInteraction(
+        {
+          action: async () => {
+            assertBrowserCredentialExpectedOrigin({ currentUrl: page.url(), expectedOrigin });
+            if (submitElement) {
+              assertSubmitElement(await readElementMetadata(submitElement), expectedOrigin);
+              if ((await submitElement.ownerFrame()) !== ownerFrame) {
+                throw new Error(
+                  "Browser credential submit target owner frame changed before submission.",
+                );
+              }
+              await submitElement.click({ timeout });
+            } else {
+              assertPasswordElement(await readElementMetadata(passwordElement), expectedOrigin);
+              if ((await passwordElement.ownerFrame()) !== ownerFrame) {
+                throw new Error("Browser credential target owner frame changed before submission.");
+              }
+              await passwordElement.press("Enter", { timeout });
+            }
+          },
+          cdpUrl: params.cdpUrl,
+          page,
+          targetId: params.targetId,
+          ...params.navigationPolicy,
+        },
+        undefined,
+        params.signal,
+      );
+    } catch {
+      await clearFailedCredentialFill({ page, element: passwordElement, timeout });
+      throw new Error(FILL_ERROR);
+    }
+
+    return { ok: true, targetId: params.targetId, origin: expectedOrigin };
+  } finally {
+    await submitElement?.dispose().catch(() => undefined);
+    await passwordElement.dispose().catch(() => undefined);
+  }
+}

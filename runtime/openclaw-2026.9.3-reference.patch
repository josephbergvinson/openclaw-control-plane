index 0000000000000000000000000000000000000000..cf43758b8cd6c3c9319fe6a17d1d974af2445f22
--- /dev/null
+++ b/src/agents/subagents/registry/subagent-registry-cron-yield.ts
@@ -0,0 +1,197 @@
+import { isCronSessionKey } from "../../../routing/session-key.js";
+/** Captures the native child batch owned by one still-admitted cron parent. */
+import type { AcceptedSessionSpawn } from "../../accepted-session-spawn.js";
+import { resolveSubagentRequesterAgentId } from "../../subagent-requester-owner.js";
+import type { SubagentAnnounceDeliveryResult } from "../announce/subagent-announce-dispatch.js";
+import type { SubagentLifecycleWakeContext } from "./subagent-registry-lifecycle-context.js";
+import {
+  completeRequesterSettleWakeBatch,
+  isCurrentRequesterSettleWakeBatch,
+  resumeCronRequesterFailure,
+} from "./subagent-registry-lifecycle-wake.js";
+import { subagentRuns } from "./subagent-registry-memory.js";
+import type { CronRequesterFailure } from "./subagent-registry.types.js";
+
+export type CronRequesterYieldBatch = {
+  children: readonly AcceptedSessionSpawn[];
+  assertCurrent(): void;
+  resolveChildren(): readonly AcceptedSessionSpawn[];
+  release(): void;
+  settle(outcome: SubagentAnnounceDeliveryResult): void;
+  abandon(outcome: SubagentAnnounceDeliveryResult): Promise<void>;
+};
+
+export type ClaimCronRequesterYieldBatchParams = {
+  requesterSessionKey: string;
+  requesterAgentId: string;
+  acceptedSessionSpawns: readonly AcceptedSessionSpawn[];
+};
+
+export function claimCronRequesterYieldBatch(
+  context: SubagentLifecycleWakeContext,
+  params: ClaimCronRequesterYieldBatchParams,
+): CronRequesterYieldBatch {
+  const { requesterSessionKey, requesterAgentId } = params;
+  const children = params.acceptedSessionSpawns
+    .filter((child) => child.expectsCompletionMessage === true)
+    .map(({ runId, childSessionKey }) => ({
+      runId,
+      childSessionKey,
+      expectsCompletionMessage: true,
+    }));
+  if (
+    !isCronSessionKey(requesterSessionKey) ||
+    children.length === 0 ||
+    new Set(children.map((child) => child.runId)).size !== children.length
+  ) {
+    throw new Error("Invalid cron requester yield batch");
+  }
+  const cfg = context.options.getRuntimeConfig();
+  const entries = children.map((child) => {
+    const matches = [...context.options.runs.values()].filter(
+      (entry) =>
+        (entry.runId === child.runId || entry.taskRunId === child.runId) &&
+        entry.childSessionKey === child.childSessionKey &&
+        entry.requesterSessionKey === requesterSessionKey &&
+        resolveSubagentRequesterAgentId(cfg, entry) === requesterAgentId &&
+        entry.expectsCompletionMessage === true,
+    );
+    if (matches.length !== 1) {
+      throw new Error("Cron requester yield child owner is missing or ambiguous");
+    }
+    return matches[0]!;
+  });
+  if (entries.some((entry) => entry.requesterSettleWake?.cronRequesterFailure)) {
+    throw new Error("Cron requester batch already has a failed owner");
+  }
+  const capturedRunIds = entries.map((entry) => entry.runId);
+  const capturedTaskRunIds = entries.map((entry) => entry.taskRunId);
+  const capturedGenerations = entries.map((entry) => entry.generation);
+  const capturedCreatedAt = entries.map((entry) => entry.createdAt);
+  let runIds = capturedRunIds.toSorted();
+  const continuations = entries.map((entry) =>
+    subagentRuns.captureRequesterYieldContinuation(entry),
+  );
+  const release = () => continuations.forEach((scope) => scope.release());
+  const generation = entries[0]?.requesterSettleWake?.rearmGeneration;
+  let settled = false;
+  const assertCurrent = (visibleFinalDelivered = false) => {
+    for (const [index, scope] of continuations.entries()) {
+      const current = scope.observation.entry;
+      if (!current) {
+        release();
+        throw new Error("Cron requester yield continuation ownership changed");
+      }
+      if (current !== entries[index]) {
+        entries[index] = current;
+        capturedRunIds[index] = current.runId;
+        capturedTaskRunIds[index] = current.taskRunId;
+        capturedGenerations[index] = scope.observation.generation;
+        capturedCreatedAt[index] = scope.observation.createdAt;
+      }
+    }
+    runIds = capturedRunIds.toSorted();
+    if (
+      settled ||
+      !isCurrentRequesterSettleWakeBatch(context, entries, generation, visibleFinalDelivered) ||
+      entries.some((entry, index) => {
+        const state = entry.requesterSettleWake;
+        return (
+          entry.runId !== capturedRunIds[index] ||
+          entry.taskRunId !== capturedTaskRunIds[index] ||
+          entry.generation !== capturedGenerations[index] ||
+          entry.createdAt !== capturedCreatedAt[index] ||
+          context.newerGenerationOwnsSession(entry) ||
+          entry.childSessionKey !== children[index]!.childSessionKey ||
+          entry.requesterSessionKey !== requesterSessionKey ||
+          resolveSubagentRequesterAgentId(cfg, entry) !== requesterAgentId ||
+          state?.requesterYieldBatch !== true ||
+          state.batchRunIds?.length !== runIds.length ||
+          !state.batchRunIds.every((runId, i) => runId === runIds[i])
+        );
+      })
+    ) {
+      release();
+      throw new Error("Cron requester yield batch ownership changed");
+    }
+  };
+  assertCurrent();
+  const batch: CronRequesterYieldBatch = {
+    // Each slot follows only the native committed requester-yield continuation.
+    children: entries.map((entry) => ({
+      runId: entry.runId,
+      childSessionKey: entry.childSessionKey,
+      expectsCompletionMessage: true,
+    })),
+    assertCurrent: () => assertCurrent(),
+    resolveChildren: () => {
+      assertCurrent();
+      return entries.map((entry) => ({
+        runId: entry.runId,
+        childSessionKey: entry.childSessionKey,
+        expectsCompletionMessage: true,
+      }));
+    },
+    release,
+    settle(outcome) {
+      assertCurrent(outcome.delivered && outcome.requesterVisibleFinalDelivered === true);
+      if (
+        entries.some(
+          (entry) => entry.execution.status !== "terminal" || entry.execution.endedAt === undefined,

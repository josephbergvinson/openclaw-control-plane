{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/openclaw-reference/schemas/retention-manifest.schema.json",
  "title": "Artifact retention manifest",
  "description": "The inventory of retained artifacts with the metadata that binds each one to a claim, plus the pruning policy that acts on it. Retention class records storage intent only; it never grants source authority and never overrides the current registry.",
  "type": "object",
  "required": ["schema", "artifact_root", "retention_classes", "policy", "artifacts"],
  "properties": {
    "schema": { "type": "string" },
    "artifact_root": { "type": "string" },
    "generated_at": { "type": "string" },
    "retention_classes": {
      "type": "array",
      "description": "The four named classes, declared in the manifest so a reader never has to infer them.",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "meaning"],
        "properties": {
          "id": {
            "enum": [
              "retain_long_term",
              "retain_until_manual_archive_window",
              "safe_to_prune_now",
              "optional_cold_archive_only"
            ]
          },
          "meaning": { "type": "string" }
        }
      }
    },
    "policy": {
      "type": "object",
      "description": "Pruning is deliberately timid: dry-run by default, bounded to admitted producer families, and never able to remove something still referenced as rollback.",
      "required": [
        "dry_run_by_default",
        "keep_newest",
        "minimum_age_days",
        "protected_when_referenced_as_rollback",
        "never_deletes_outside_artifact_root"
      ],
      "properties": {
        "dry_run_by_default": { "const": true },
        "apply_requires_explicit_flag": { "type": "boolean" },
        "keep_newest": { "type": "integer", "minimum": 1 },
        "minimum_age_days": { "type": "integer", "minimum": 1 },
        "protected_when_referenced_as_rollback": { "const": true },
        "never_deletes_outside_artifact_root": { "const": true },
        "never_restarts_services": { "type": "boolean" },
        "admitted_producer_families_only": { "type": "boolean" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "path",
          "producer",
          "target_identity",
          "evidence_freshness",
          "acceptance_predicate",
          "authority_class",
          "retention_class"
        ],
        "properties": {
          "artifact_id": { "type": "string" },
          "path": { "type": "string" },
          "run_id": { "type": "string" },
          "producer": {
            "type": "string",
            "description": "Which entrypoint, job, or lane wrote it. Without it the artifact can be neither refreshed nor falsified."
          },
          "source_identity": {
            "type": "object",
            "properties": {
              "surface_slug": { "type": "string" },
              "canonical_root": { "type": "string" },
              "branch": { "type": "string" },
              "commit": { "type": "string" }
            }
          },
          "target_identity": {
            "type": "string",
            "description": "What the artifact describes or was written against. Without it, evidence is read against the wrong system and looks like agreement."
          },
          "evidence_freshness": {
            "type": "object",
            "required": ["observed_at", "freshness_class"],
            "properties": {
              "observed_at": { "type": "string" },
              "freshness_class": {
                "enum": ["stable", "volatile", "reprobe-before-use", "reprobe-before-write"]
              }
            }
          },
          "acceptance_predicate": {
            "type": "string",
            "description": "The exact condition the artifact is claimed to satisfy, stated before execution rather than chosen afterwards to match what happened."
          },
          "authority_class": {
            "enum": ["authoritative", "generated", "historical"],
            "description": "Keeps artifacts from drifting into policy. Only what a contract declares authoritative is authoritative."
          },
          "retention_class": {
            "enum": [
              "retain_long_term",
              "retain_until_manual_archive_window",
              "safe_to_prune_now",
              "optional_cold_archive_only"
            ]
          },
          "referenced_as_rollback": { "type": "boolean" }
        }
      }
    },
    "note": { "type": "string" }
  }
}

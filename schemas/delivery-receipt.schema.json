{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/openclaw-reference/schemas/delivery-receipt.schema.json",
  "title": "Terminal delivery receipt",
  "description": "Proof that exactly one logical terminal message became visible on its destination. A receipt without a provider message id proves nothing: completion is asserted by the provider, not by the sender.",
  "type": "object",
  "required": [
    "schema",
    "delivery_class",
    "idempotency_key",
    "chunk",
    "reservation",
    "provider_receipt",
    "origin",
    "completed_at"
  ],
  "properties": {
    "schema": { "type": "string" },
    "delivery_class": {
      "enum": ["final", "completion", "blocker", "checkpoint", "acknowledgement"],
      "description": "Only terminal classes may reserve terminal ownership."
    },
    "idempotency_key": {
      "type": "string",
      "description": "Canonical key over provider, account route, a hash of the visible target, a hash of the thread slot, a hash of the origin, the delivery class, and chunk coordinates."
    },
    "key_inputs": {
      "type": "object",
      "required": ["provider", "account_route", "visible_target_hash", "message_text_included"],
      "properties": {
        "provider": { "type": "string" },
        "account_route": { "type": "string" },
        "visible_target_hash": { "type": "string" },
        "thread_slot_hash": { "type": "string" },
        "origin_hash": { "type": "string" },
        "message_text_included": {
          "const": false,
          "description": "Message text is excluded by design, so a partial final that is later corrected cannot become a second visible final."
        },
        "note": { "type": "string" }
      }
    },
    "chunk": {
      "type": "object",
      "description": "Chunk coordinates are part of the key, so an intentionally multi-part final stays multi-part.",
      "required": ["index", "count"],
      "properties": {
        "index": { "type": "integer", "minimum": 1 },
        "count": { "type": "integer", "minimum": 1 }
      }
    },
    "reservation": {
      "type": "object",
      "description": "Two-tier reservation: an in-process map with a short lifetime, then a persistent claim file created with exclusive-create.",
      "required": ["claim_file", "claim_create_mode"],
      "properties": {
        "in_process_reserved_at": { "type": "string" },
        "in_process_lease_minutes": { "type": "number", "minimum": 0 },
        "claim_file": { "type": "string" },
        "claim_create_mode": { "const": "exclusive-create" },
        "claim_file_mode": { "type": "string" },
        "claim_directory_mode": { "type": "string" },
        "retention_ttl_hours": { "type": "number", "minimum": 0 }
      }
    },
    "provider_receipt": {
      "type": "object",
      "description": "The external proof. Without provider_message_id the claim is in flight, not complete.",
      "required": ["provider", "visible_target", "provider_message_id", "visible_delivery_confirmed"],
      "properties": {
        "provider": { "type": "string" },
        "account_route": { "type": "string" },
        "visible_target": {
          "type": "string",
          "description": "Canonicalized to the destination the operator actually sees."
        },
        "provider_message_id": { "type": "string" },
        "sent_at": { "type": "string" },
        "confirmed_at": { "type": "string" },
        "visible_delivery_confirmed": { "const": true },
        "attachments": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1,
          "description": "One logical final is one message with at most one attachment. If the attachment cannot be prepared, nothing partial is sent."
        }
      }
    },
    "origin": {
      "type": "object",
      "required": ["run_id", "status_artifact_ref", "terminal_state_before_send"],
      "properties": {
        "lane_id": { "type": "string" },
        "run_id": { "type": "string" },
        "origin_message_id": { "type": "string" },
        "status_artifact_ref": { "type": "string" },
        "terminal_state_before_send": {
          "enum": ["complete", "completed", "blocked", "failed", "preserve"],
          "description": "Terminal-before-final ordering: the status artifact reaches a terminal state before the visible final is sent."
        }
      }
    },
    "arbitration": {
      "type": "object",
      "required": ["suppressed_duplicates", "claim_store_readable"],
      "properties": {
        "prior_claim_found": { "type": "boolean" },
        "suppressed_duplicates": { "type": "integer", "minimum": 0 },
        "reclaimed_as_crashed": { "type": "boolean" },
        "claim_store_readable": {
          "type": "boolean",
          "description": "When false the path fails open, which is the one deliberate exception to fail-closed in this architecture."
        },
        "note": { "type": "string" }
      }
    },
    "obligation": {
      "type": "object",
      "required": ["opened_at", "cleared_by"],
      "properties": {
        "opened_at": { "type": "string" },
        "cleared_at": { "type": ["string", "null"] },
        "cleared_by": { "enum": ["visible-final-delivered", "explicit-cancellation"] }
      }
    },
    "completed_at": { "type": "string" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Illustrative subset of the pinned native TaskRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "taskId",
    "runtime",
    "requesterSessionKey",
    "ownerKey",
    "scopeKind",
    "task",
    "status",
    "deliveryStatus",
    "notifyPolicy",
    "createdAt"
  ],
  "properties": {
    "taskId": {
      "type": "string"
    },
    "runtime": {
      "type": "string",
      "enum": [
        "subagent",
        "acp",
        "cron",
        "cli"
      ]
    },
    "taskKind": {
      "type": "string"
    },
    "requesterSessionKey": {
      "type": "string"
    },
    "ownerKey": {
      "type": "string"
    },
    "scopeKind": {
      "type": "string",
      "enum": [
        "session",
        "system"
      ]
    },
    "childSessionKey": {
      "type": "string"
    },
    "task": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "timed_out",
        "cancelled",
        "lost"
      ]
    },
    "deliveryStatus": {
      "type": "string",
      "enum": [
        "pending",
        "delivered",
        "session_queued",
        "failed",
        "dismissed",
        "parent_missing",
        "not_applicable"
      ]
    },
    "notifyPolicy": {
      "type": "string",
      "enum": [
        "done_only",
        "state_changes",
        "silent"
      ]
    },
    "createdAt": {
      "type": "integer"
    },
    "startedAt": {
      "type": "integer"
    },
    "endedAt": {
      "type": "integer"
    },
    "terminalSummary": {
      "type": "string"
    },
    "terminalOutcome": {
      "type": "string",
      "enum": [
        "succeeded",
        "blocked"
      ]
    }
  }
}

{
  "schema": "durable-lane-status/v1",
  "lane_id": "lane-0000",
  "runtime_run_id": "runtime-run-0000",
  "child_session_key": "<session-key>",
  "origin_message_id": "<origin-message-id>",
  "delivery_target": "<channel-id>",
  "state": "complete",
  "health": "healthy",
  "acceptance_level": "verified-live",
  "scope": "add a validation step to the build script of example-project; publication held at its own approval boundary",
  "single_worker_reason": "one write set in one repository; no independent read-only partition to split",
  "write_boundaries": {
    "allowed": [
      "<worktree-root>/scripts/",
      "<worktree-root>/tests/",
      "<worktree-root>/docs/build.md"
    ],
    "forbidden": [
      "<project-root>/",
      "<workspace-root>/status/",
      "<releases-root>/",
      "any deploy or publication path"
    ]
  },
  "phases": [
    { "name": "accepted", "state": "complete" },
    { "name": "implementation-started", "state": "complete" },
    { "name": "tests-started", "state": "complete" },
    { "name": "tests-passed", "state": "complete" },
    { "name": "commit-and-normalize", "state": "complete" },
    { "name": "closeout", "state": "complete" },
    { "name": "blocker", "state": "not-entered" }
  ],
  "checkpoint_due_within_minutes": 5,
  "checkpoint_delivery_strategy": "phase-boundary",
  "owed_final_type": "durable-lane-final",
  "blockers": [],
  "diagram_artifact": "<artifact-root>/lane-0000/lane-diagram.mmd",
  "delivery_state": "final-delivered",
  "delivery_message_id": "<message-id-final>",
  "updated_at": "<t5>"
}

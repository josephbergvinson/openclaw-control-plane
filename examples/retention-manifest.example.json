{
  "schema": "retention-manifest/v1",
  "artifact_root": "<artifact-root>",
  "generated_at": "<timestamp-utc>",
  "retention_classes": [
    { "id": "retain_long_term", "meaning": "keep indefinitely" },
    { "id": "retain_until_manual_archive_window", "meaning": "keep until an operator-run archive pass" },
    { "id": "safe_to_prune_now", "meaning": "no remaining obligation" },
    { "id": "optional_cold_archive_only", "meaning": "not needed live; archive if convenient" }
  ],
  "policy": {
    "dry_run_by_default": true,
    "apply_requires_explicit_flag": true,
    "keep_newest": 5,
    "minimum_age_days": 14,
    "protected_when_referenced_as_rollback": true,
    "never_deletes_outside_artifact_root": true,
    "never_restarts_services": true,
    "admitted_producer_families_only": true
  },
  "artifacts": [

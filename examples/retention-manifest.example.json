      "acceptance_predicate": "the validation step fails the build on a missing required field and passes when it is present",
      "authority_class": "authoritative",
      "retention_class": "retain_long_term",
      "referenced_as_rollback": false
    },
    {
      "artifact_id": "artifact-0001",
      "path": "<artifact-root>/promotions/op-0000/",

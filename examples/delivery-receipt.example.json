{
  "schema": "delivery-receipt/v1",
  "delivery_class": "final",
  "idempotency_key": "terminal-dispatch:<provider>:<account-route>:<hash-target>:<hash-thread-slot>:<hash-origin>:final:1of1",
  "key_inputs": {
    "provider": "<provider>",
    "account_route": "<account-route>",
    "visible_target_hash": "a1b2c3d4",
    "thread_slot_hash": "b2c3d4e5",
    "origin_hash": "c3d4e5f6",
    "message_text_included": false,
    "note": "The target is canonicalized to the visible destination so a parent-surface send and a direct thread send collapse into one slot. Message text is excluded so a corrected final cannot become a second visible final. Chunk coordinates are included so an intentionally multi-part final stays multi-part."
  },
  "chunk": { "index": 1, "count": 1 },
  "reservation": {
    "in_process_reserved_at": "<t4>",
    "in_process_lease_minutes": 2,
    "claim_file": "<runtime-dir>/cache/terminal-dispatch-claims/claim-0000.json",
    "claim_create_mode": "exclusive-create",
    "claim_file_mode": "0600",
    "claim_directory_mode": "0700",
    "retention_ttl_hours": 6
  },
  "provider_receipt": {
    "provider": "<provider>",
    "account_route": "<account-route>",
    "visible_target": "<channel-id>",
    "provider_message_id": "<message-id-final>",
    "sent_at": "<t4>",
    "confirmed_at": "<t5>",
    "visible_delivery_confirmed": true,
    "attachments": 1
  },
  "origin": {
    "lane_id": "lane-0000",
    "run_id": "run-0000",
    "origin_message_id": "<origin-message-id>",
    "status_artifact_ref": "<artifact-root>/run-0000/status.json",
    "terminal_state_before_send": "complete"
  },
  "arbitration": {
    "prior_claim_found": false,
    "suppressed_duplicates": 0,
    "reclaimed_as_crashed": false,
    "claim_store_readable": true,
    "note": "A claim carrying a completion time and a provider message id suppresses for the retention window. A claim younger than the in-flight lease suppresses. An older claim with no receipt is reclaimed as crashed. If the claim store cannot be read the path fails open, on the judgment that a dropped real final is worse than a rare duplicate."
  },
  "obligation": {
    "opened_at": "<t1>",
    "cleared_at": "<t5>",
    "cleared_by": "visible-final-delivered"
  },
  "completed_at": "<t5>"
}

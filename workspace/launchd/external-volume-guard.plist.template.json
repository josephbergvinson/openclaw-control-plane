{
  "Label": "com.openclaw.external-volume-guard",
  "ProgramArguments": [
    "${operator:paths.node_binary}",
    "${operator:paths.volume_guard_launcher}",
    "${operator:paths.volume_guard_helper}",
    "--contract",
    "${operator:paths.volume_guard_contract}",
    "observe",
    "--state-file",
    "${operator:paths.volume_guard_state}",
    "--incident-dir",
    "${operator:paths.volume_guard_incidents}"
  ],
  "EnvironmentVariables": {
    "NODE_OPTIONS": "",
    "OPENCLAW_INTERNAL_PYTHON": "${operator:paths.python_binary}"
  },
  "Disabled": true,
  "ThrottleInterval": 15,
  "ExitTimeOut": 5,
  "AbandonProcessGroup": false,
  "StandardOutPath": "${operator:paths.volume_guard_stdout}",
  "StandardErrorPath": "${operator:paths.volume_guard_stderr}"
}

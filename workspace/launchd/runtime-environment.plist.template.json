{
  "Label": "com.openclaw.runtime-environment",
  "ProgramArguments": [
    "/bin/zsh",
    "${operator:paths.runtime_environment_helper}"
  ],
  "WorkingDirectory": "${operator:paths.host_home}",
  "Disabled": true,
  "RunAtLoad": false,
  "EnvironmentVariables": {
    "PATH": "/usr/bin:/bin:/usr/sbin:/sbin",
    "CLAUDE_CODE_TMPDIR": "${operator:paths.temp_root}",
    "OPENCLAW_STATE_DIR": "${operator:paths.state_root}",
    "PYTEST_DEBUG_TEMPROOT": "${operator:paths.pytest_temp_root}",
    "NODE_COMPILE_CACHE": "${operator:paths.node_compile_cache}",
    "PYTHONPYCACHEPREFIX": "${operator:paths.python_cache_root}",
    "OPENCLAW_GATEWAY_KEYCHAIN_ACCOUNT": "${operator:credentials.gateway_keychain_account}",
    "OPENCLAW_GATEWAY_KEYCHAIN_SERVICE": "${operator:credentials.gateway_keychain_service}",
    "OPENCLAW_RUNTIME_APP": "${operator:paths.runtime_desktop_app}"
  },
  "StandardOutPath": "${operator:paths.runtime_environment_stdout}",
  "StandardErrorPath": "${operator:paths.runtime_environment_stderr}"
}

{
  "Label": "${operator:services.backblaze.watchdog_label}",
  "ProgramArguments": [
    "${operator:paths.python_binary}",
    "${operator:paths.backblaze_watchdog_helper}"
  ],
  "WorkingDirectory": "${operator:paths.internal_control_root}",
  "EnvironmentVariables": {
    "PATH": "/usr/bin:/bin:/usr/sbin:/sbin",
    "PYTHONDONTWRITEBYTECODE": "1",
    "OPENCLAW_OPERATOR_CONFIG": "${operator:paths.internal_operator_config}"
  },
  "Disabled": true,
  "RunAtLoad": false,
  "StartInterval": 120,
  "StandardOutPath": "${operator:paths.backblaze_watchdog_stdout}",
  "StandardErrorPath": "${operator:paths.backblaze_watchdog_stderr}"
}

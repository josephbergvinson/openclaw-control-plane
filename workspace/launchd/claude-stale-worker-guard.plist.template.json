{
  "Label": "com.openclaw.claude-stale-worker-guard",
  "ProgramArguments": [
    "/bin/zsh",
    "${operator:paths.claude_worker_guard_helper}"
  ],
  "EnvironmentVariables": {
    "OPENCLAW_CLAUDE_CODE_ROOT": "${operator:paths.claude_code_root}",
    "OPENCLAW_CLAUDE_WORKER_RECEIPTS": "${operator:paths.claude_worker_receipts}"
  },
  "Disabled": true,
  "RunAtLoad": false,
  "StartInterval": 300,
  "WatchPaths": [
    "${operator:paths.claude_code_root}"
  ],
  "ThrottleInterval": 10,
  "ProcessType": "Background",
  "StandardOutPath": "${operator:paths.claude_worker_stdout}",
  "StandardErrorPath": "${operator:paths.claude_worker_stderr}"
}

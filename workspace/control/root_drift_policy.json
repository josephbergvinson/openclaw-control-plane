{
  "version": 9,
  "rootCheckout": {
    "path": "${operator:paths.workspace}",
    "role": "clean integration checkout",
    "nonTrivialWorkPolicy": "task-worktree-only"
  },
  "classes": [
    {
      "class": "safe-remove",
      "paths": [
        "Users/**",
        "audit/root-cleanup-closeout.md",
        "audit/root-cleanup-closeout.json"
      ],
      "reason": "generated residue or misplaced path artifact"
    },
    {
      "class": "root-local",
      "paths": [
        "scripts/openclaw_archive_v3_retention.py",
        "scripts/openclaw_backup_retention_cleanup.py",
        "scripts/openclaw_daily_backup_cron.py",
        "scripts/openclaw_weekly_archive_backup.py",
        "scripts/workspace_integrity_guard.py"
      ],
      "reason": "root-local wrapper or shim"
    },
    {
      "class": "retained-state",
      "paths": [
        "audit/**",
        "memory/**",
        "DREAMS.md",
        "operator.json",
        "installation-manifest.json",
        "artifacts/**",
        "MEMORY.md",
        "config/openclaw.json",
        "status/capability_status.json"
      ],
      "reason": "retained operational state and durable memory kept outside source normalization"
    },
    {
      "class": "normalize-to-root",
      "paths": [
        "AGENTS.md",
        "TOOLS.md",
        "SOUL.md",
        "WRITING.md",
        "USER.md",
        "BOOTSTRAP.md",
        "HEARTBEAT.md",
        "IDENTITY.md",
        "POLICY_CHANGELOG.md",
        "capabilities.md",
        "runbooks/**",
        "control/**",
        "registry/**",
        "policy_manifest.json",
        "policy_bootstrap_manifest.json",
        "tests/**",
        ".gitignore",
        "REFERENCE.md",
        "LICENSE",
        "SECURITY.md",
        "CONTRIBUTING.md",
        "docs/**",
        "diagrams/**",
        "runtime/**",
        "config/**",
        "examples/**",
        "schemas/**",
        "templates/**",
        "launchd/**",
        "scheduler/**",
        "host-templates.json",
        "scripts/ROUTING.md",
        "scripts/__init__.py",
        "scripts/apple_calendar_common.py",
        "scripts/apple_calendar_create_event.py",
        "scripts/apple_calendar_find_event.py",
        "scripts/apple_calendar_probe.py",
        "scripts/backblaze_health.py",
        "scripts/backblaze_resource_watchdog.py",
        "scripts/backblaze_resources.py",
        "scripts/capability_registry_contract.py",
        "scripts/claude-stale-worker-guard.zsh",
        "scripts/cloudflare_capability_probe.py",
        "scripts/company_alpha_docs_mcp_adapter.py",
        "scripts/company_alpha_gigabrain_capability_probe.py",
        "scripts/company_alpha_walletconnect_agent.mjs",
        "scripts/cron_private_output.py",
        "scripts/cron_python_entrypoint.py",
        "scripts/external_volume_guard.py",
        "scripts/external_volume_guard_launcher.js",
        "scripts/gateway_autoheal_cron.py",
        "scripts/google_search_console_probe.py",
        "scripts/hedera_mainnet_test_signer_probe.mjs",
        "scripts/hedera_testnet_test_signer_probe.mjs",
        "scripts/jira_company_alpha_capability_probe.py",
        "scripts/jira_company_alpha_read.py",
        "scripts/local_whisper_capability_probe.py",
        "scripts/materialize_host.py",
        "scripts/node_compile_cache.py",
        "scripts/notion_capability_probe.py",
        "scripts/notion_read.py",
        "scripts/openclaw_approval_a_retention.py",
        "scripts/openclaw_archive_v3_retention.py",
        "scripts/openclaw_backup_retention_cleanup.py",
        "scripts/openclaw_cli_common.py",
        "scripts/openclaw_daily_backup_cron.py",
        "scripts/openclaw_health_audit_cron.py",
        "scripts/openclaw_independent_backup_receipt.py",
        "scripts/openclaw_launchagent_integrity_guard.py",
        "scripts/openclaw_retention_cleanup_cron.py",
        "scripts/openclaw_runtime_activate.py",
        "scripts/openclaw_runtime_promotion_retention.py",
        "scripts/openclaw_runtime_release_retention.py",
        "scripts/openclaw_runtime_retention_metadata.py",
        "scripts/openclaw_storage_prune.py",
        "scripts/openclaw_weekly_archive_backup.py",
        "scripts/openclaw_weekly_backup_integration_proof.py",
        "scripts/openclaw_weekly_backup_reconcile.py",
        "scripts/operation_effect_predicate.py",
        "scripts/operator_contract.py",
        "scripts/personal_data_neon_readonly_capability_probe.py",
        "scripts/reconstruct_runtime.py",
        "scripts/resolve_capability.py",
        "scripts/root_drift_state.py",
        "scripts/routing_operator_bindings.mjs",
        "scripts/routing_operator_bindings.py",
        "scripts/runtime-environment.zsh",
        "scripts/storage_headroom_guard.py",
        "scripts/stage_runtime_release.py",
        "scripts/trello_capability_probe.py",
        "scripts/trello_common.py",
        "scripts/trello_task_sync.py",
        "scripts/workspace_integrity_guard.py",
        "dependencies/**",
        "walletconnect/package.json",
        "walletconnect/package-lock.json",
        "skills/**",
        "scripts/lib/company_alpha_walletconnect_hedera_adapter.mjs",
        "scripts/trello_inspect.py"
      ],
      "reason": "root-authoritative control-plane source"
    }
  ],
  "protectedLanes": [],
  "normalization": {
    "allowTrackedOnlyWhenClassified": true,
    "unmatchedDefaultClass": "blocker",
    "failClosedOnAmbiguous": true,
    "closeoutArtifact": "audit/root-cleanup-closeout.md",
    "closeoutJson": "audit/root-cleanup-closeout.json"
  },
  "validators": [
    "python3 -m pytest -q tests/test_root_drift_control_plane.py"
  ]
}

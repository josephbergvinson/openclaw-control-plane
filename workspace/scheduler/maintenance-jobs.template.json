[
  {
    "name": "External-volume Backblaze Weekly Backup",
    "enabled": false,
    "agentId": "main",
    "schedule": {
      "kind": "cron",
      "expr": "40 23 * * 0",
      "tz": "${operator:scheduler.timezone}",
      "staggerMs": 0
    },
    "sessionTarget": "isolated",
    "payload": {
      "kind": "command",
      "cwd": "${operator:paths.workspace}",
      "env": {
        "OPENCLAW_OPERATOR_CONFIG": "${operator:paths.operator_config}",
        "OPENCLAW_STATE_DIR": "${operator:paths.state_root}"
      },
      "timeoutSeconds": 360,
      "argv": [
        "${operator:paths.python_binary}",
        "${operator:paths.cron_entrypoint}",
        "--receipt-dir",
        "${operator:scheduler.receipt_directories.backblaze-health-weekly}",
        "--script",
        "${operator:scheduler.helper_paths.backblaze-health-weekly}",
        "--what",
        "External-volume Backblaze Weekly Backup",
        "--",
        "--start"
      ]
    },
    "delivery": {
      "mode": "announce",
      "channel": "${operator:scheduler.delivery_channel}",
      "to": "${operator:scheduler.delivery_target}"
    },
    "wakeMode": "now"
  },

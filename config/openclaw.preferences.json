{
  "agents": {
    "defaults": {
      "model": {
        "primary": "openai/gpt-6-astra",
        "fallbacks": []
      },
      "modelPolicy": {
        "allow": [
          "openai/gpt-6.1-sol",
          "openai/gpt-6-astra"
        ]
      },
      "thinkingDefault": "xhigh",
      "bootstrapMaxChars": 180000,
      "bootstrapTotalMaxChars": 400000,
      "compaction": {
        "identifierPolicy": "strict",
        "keepRecentTokens": 48000,
        "memoryFlush": {
          "enabled": true,
          "forceFlushTranscriptBytes": "8mb"
        },
        "mode": "safeguard",
        "notifyUser": false,
        "qualityGuard": {
          "enabled": true,
          "maxRetries": 1
        },
        "recentTurnsPreserve": 6,
        "timeoutSeconds": 300,
        "midTurnPrecheck": {
          "enabled": true
        },
        "thinkingLevel": "low"
      },
      "maxConcurrent": 4,
      "subagents": {
        "maxConcurrent": 8,
        "runTimeoutSeconds": 0,
        "delegationMode": "suggest",
        "model": "openai/gpt-6-astra",
        "thinking": "xhigh"
      },
      "imageModel": {
        "primary": "openai/gpt-6-astra",
        "fallbacks": []
      },
      "mediaModels": {
        "image": {
          "primary": "openai/gpt-image-2.5-flare",
          "fallbacks": []
        }
      },
      "systemAgent": {
        "agentId": "main"
      },
      "utilityModel": "openai/gpt-6-astra",
      "verboseDefault": "off",
      "workspace": "${operator:paths.workspace}",
      "models": {
        "openai/gpt-6-astra": {
          "agentRuntime": {
            "id": "openclaw"
          },
          "params": {
            "thinking": "xhigh",
            "transport": "websocket"
          }
        }
      },
      "fastModeDefault": false,
      "ownerPermissionMode": "full",
      "elevatedDefault": "full",
      "sandbox": {
        "mode": "off"
      },
      "heartbeat": {
        "model": "openai/gpt-6-astra",
        "isolatedSession": true,
        "thinking": "xhigh"
      }
    }
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto"
  },
  "session": {
    "dmScope": "per-channel-peer",
    "resetByType": {
      "group": {
        "idleMinutes": 10080,
        "mode": "idle"
      },
      "thread": {
        "idleMinutes": 10080,
        "mode": "idle"
      }
    },
    "threadBindings": {
      "idleHours": 24,
      "maxAgeHours": 168
    },
    "resetByChannel": {
      "discord": {
        "mode": "idle",
        "idleMinutes": 10080
      }
    }
  },
  "memory": {
    "search": {
      "enabled": true,
      "fallback": "none",
      "local": {
        "modelPath": "hf:ggml-org/embeddinggemma-300m-qat-q8_0-GGUF/embeddinggemma-300m-qat-Q8_0.gguf"
      },
      "provider": "local",
      "cache": {}
    },
    "citations": "off"
  },
  "auth": {},
  "skills": {
    "entries": {
      "goplaces": {
        "enabled": false
      }
    }
  },
  "plugins": {
    "entries": {
      "acpx": {
        "enabled": true
      },
      "brave": {
        "enabled": true
      },
      "browser": {
        "enabled": true
      },
      "codex": {
        "enabled": true
      },
      "discord": {
        "enabled": true
      },
      "memory-core": {
        "enabled": true,
        "subagent": {
          "allowModelOverride": true
        },
        "config": {
          "dreaming": {
            "model": "openai/gpt-6-astra",
            "phases": {
              "light": {
                "execution": {
                  "thinking": "xhigh"
                }
              },
              "deep": {
                "execution": {
                  "thinking": "xhigh"
                }
              },
              "rem": {
                "execution": {
                  "thinking": "xhigh"
                }
              }
            }
          }
        }
      },
      "llama-cpp": {
        "enabled": true
      },
      "openai": {
        "enabled": true
      },
      "telegram": {
        "enabled": true
      },
      "google-meet": {
        "enabled": true
      },
      "teams-meetings": {
        "enabled": true
      },
      "zoom-meetings": {
        "enabled": true
      },
      "active-memory": {
        "enabled": true,
        "config": {
          "model": "openai/gpt-6-astra",
          "thinking": "xhigh"
        }
      }
    },
    "load": {
      "paths": []
    }
  },
  "tools": {
    "profile": "full",
    "exec": {
      "mode": "full",
      "applyPatch": {
        "workspaceOnly": false
      }
    },
    "fs": {
      "workspaceOnly": false
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "openai": {
        "baseUrl": "https://chatgpt.com/backend-api",
        "api": "openai-chatgpt-responses",
        "models": [
          {
            "id": "gpt-6.1-sol",
            "name": "GPT-6.1 Sol",
            "api": "openai-chatgpt-responses",
            "reasoning": true,
            "input": [
              "text",
              "image"
            ],
            "cost": {
              "input": 2,
              "output": 10,
              "cacheRead": 0.1,
              "cacheWrite": 2.5
            },
            "contextWindow": 872000,
            "contextTokens": 272000,
            "maxTokens": 128000,
            "compat": {
              "supportedReasoningEfforts": [
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ],
              "supportsTemperature": false
            }
          }
        ]
      }
    }
  }
}

{
  "agents": {
    "defaults": {
      "model": {
        "primary": "openai/gpt-6-astra",
        "fallbacks": []
      },
      "modelPolicy": {
        "allow": [
          "openai/gpt-5.6-sol",
          "openai/gpt-5.5",
          "openai/gpt-6-astra",
          "openai/gpt-6-sol"
        ]
      },
      "thinkingDefault": "max",
      "bootstrapMaxChars": 180000,
      "bootstrapTotalMaxChars": 400000,
      "compaction": {
        "identifierPolicy": "strict",
        "keepRecentTokens": 120000,
        "memoryFlush": {
          "enabled": true,
          "forceFlushTranscriptBytes": "8mb"
        },
        "mode": "safeguard",
        "notifyUser": true,
        "qualityGuard": {
          "enabled": true,
          "maxRetries": 1
        },
        "recentTurnsPreserve": 6,
        "timeoutSeconds": 1800
      },
      "maxConcurrent": 4,
      "subagents": {
        "maxConcurrent": 8,
        "runTimeoutSeconds": 0
      },
      "imageModel": {
        "primary": "openai/gpt-6-astra",
        "fallbacks": []
      },
      "mediaModels": {
        "image": {
          "primary": "openai/gpt-image-2.5-flare",
          "fallbacks": []
        }
      },
      "systemAgent": {
        "agentId": "main"
      },
      "utilityModel": "openai/gpt-6-sol",
      "verboseDefault": "off",
      "workspace": "${operator:paths.workspace}",
      "models": {
        "openai/gpt-5.6-sol": {
          "agentRuntime": {
            "id": "codex"
          }
        },
        "openai/gpt-6-astra": {
          "agentRuntime": {
            "id": "openclaw"
          }
        },
        "openai/gpt-6-sol": {
          "agentRuntime": {
            "id": "openclaw"
          },
          "params": {
            "thinking": "high"
          }
        }
      },
      "fastModeDefault": false,
      "ownerPermissionMode": "full",
      "elevatedDefault": "full",
      "sandbox": {
        "mode": "off"
      },
      "heartbeat": {
        "model": "openai/gpt-6-sol",
        "thinking": "high"
      }
    }
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto"
  },
  "session": {
    "dmScope": "per-channel-peer",
    "resetByType": {
      "group": {
        "idleMinutes": 10080,
        "mode": "idle"
      },
      "thread": {
        "idleMinutes": 10080,
        "mode": "idle"
      }
    },
    "threadBindings": {
      "idleHours": 24,
      "maxAgeHours": 168
    },
    "resetByChannel": {
      "discord": {
        "mode": "idle",
        "idleMinutes": 52596000
      }
    }
  },
  "memory": {
    "search": {
      "enabled": true,
      "fallback": "none",
      "local": {
        "modelPath": "hf:ggml-org/embeddinggemma-300m-qat-q8_0-GGUF/embeddinggemma-300m-qat-Q8_0.gguf"
      },
      "provider": "local",
      "cache": {}
    },
    "citations": "off"
  },
  "auth": {},
  "skills": {
    "entries": {
      "goplaces": {
        "enabled": false
      }
    }
  },
  "plugins": {
    "entries": {
      "acpx": {
        "enabled": true
      },
      "brave": {
        "enabled": true
      },
      "browser": {
        "enabled": true
      },
      "codex": {
        "enabled": true
      },
      "discord": {
        "enabled": true
      },
      "memory-core": {
        "enabled": true,
        "subagent": {
          "allowModelOverride": true
        },
        "config": {
          "dreaming": {
            "model": "openai/gpt-6-sol",
            "execution": {
              "defaults": {
                "model": "openai/gpt-6-sol",
                "thinking": "high"
              }
            },
            "phases": {
              "light": {
                "execution": {
                  "thinking": "high"
                }
              },
              "deep": {
                "execution": {
                  "thinking": "high"
                }
              },
              "rem": {
                "execution": {
                  "thinking": "high"
                }
              }
            }
          }
        }
      },
      "llama-cpp": {
        "enabled": true
      },
      "openai": {
        "enabled": true
      },
      "telegram": {
        "enabled": true
      },
      "lane-contract": {
        "enabled": true
      },
      "google-meet": {
        "enabled": true
      },
      "teams-meetings": {
        "enabled": true
      },
      "zoom-meetings": {
        "enabled": true
      },
      "active-memory": {
        "enabled": true,
        "config": {
          "model": "openai/gpt-6-sol",
          "thinking": "high"
        }
      }
    },
    "load": {
      "paths": []
    }
  },
  "tools": {
    "profile": "full",
    "exec": {
      "mode": "full",
      "applyPatch": {
        "workspaceOnly": false
      }
    },
    "fs": {
      "workspaceOnly": false
    }
  }
}
